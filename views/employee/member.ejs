<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/member.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745', // สีเขียวสำหรับความสำเร็จ
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>
    <div id="ShowAddFamilyForm" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden overflow-y-scroll">
        <div class="container mx-auto p-6 my-auto">
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h1 class="text-2xl font-bold mb-6">สมัครเข้าร่วมกองทุนขยะรีไซเคิล</h1>
                
                <!-- ฟอร์มลงทะเบียนครัวเรือน -->
                <form action="/employee/memberRegister" method="POST" class="space-y-6">
                    
                    <!-- ส่วนที่ 1: ข้อมูลครัวเรือน -->
                    <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                        <h2 class="text-lg font-semibold mb-4 text-green-700">1. ข้อมูลครัวเรือน</h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-gray-700 mb-2">ชื่อครัวเรือน</label>
                                <input type="text" name="familyName" class="w-full p-2 border rounded" required>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">ประเภทครัวเรือน</label>
                                <select name="Type" class="w-full p-2 border rounded" required>
                                    <option value="household">บ้านเรือน</option>
                                    <option value="school">โรงเรียน</option>
                                    <option value="municipality">อปท.</option>
                                    <option value="community">ชุมชน</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-gray-700 mb-2">ชื่อผู้ใช้ (Username)</label>
                                <input type="text" name="username" class="w-full p-2 border rounded" required>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">รหัสผ่าน</label>
                                <input type="password" name="password" class="w-full p-2 border rounded" required>
                            </div>
                        </div>
                        
                        <h3 class="font-medium text-gray-700 mt-4 mb-2">ที่อยู่</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-gray-700 mb-2">บ้านเลขที่</label>
                                <input type="text" name="houseNumber" class="w-full p-2 border rounded">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">หมู่บ้าน</label>
                                <select name="village" class="w-full p-2 border rounded">
                                    <% villages.forEach(village => { %>
                                        <option value="<%= village._id %>">หมู่ <%= village.villageNumber %> - <%= village.villageName %></option>
                                    <% }); %>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">ถนน</label>
                                <input type="text" name="road" class="w-full p-2 border rounded">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                            <div>
                                <label class="block text-gray-700 mb-2">ตำบล</label>
                                <input type="text" name="subdistrict" class="w-full p-2 border rounded" required>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">อำเภอ</label>
                                <input type="text" name="district" class="w-full p-2 border rounded" required>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">จังหวัด</label>
                                <input type="text" name="province" class="w-full p-2 border rounded" value="ขอนแก่น" required>
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <label class="block text-gray-700 mb-2">รหัสไปรษณีย์</label>
                            <input type="text" name="postalCode" class="w-full md:w-1/3 p-2 border rounded">
                        </div>
                    </div>
                    
                    <!-- ส่วนที่ 2: ข้อมูลสมาชิก (ตัวแทนครอบครัว) -->
                    <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                        <h2 class="text-lg font-semibold mb-4 text-green-700">2. ข้อมูลสมาชิก (ตัวแทนครอบครัว)</h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-gray-700 mb-2">ชื่อ-สกุล</label>
                                <input type="text" name="name" class="w-full p-2 border rounded" required>
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">เลขบัตรประชาชน</label>
                                <input type="text" name="idCardNumber" class="w-full p-2 border rounded" maxlength="13">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">วัน/เดือน/ปีเกิด</label>
                                <input type="date" name="birthDate" class="w-full p-2 border rounded">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-gray-700 mb-2">อาชีพ</label>
                                <input type="text" name="occupation" class="w-full p-2 border rounded">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">อายุ (ปี)</label>
                                <input type="text" name="age" class="w-full p-2 border rounded">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">สัญชาติ</label>
                                <input type="text" name="nationality" class="w-full p-2 border rounded" value="ไทย">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-gray-700 mb-2">เชื้อชาติ</label>
                                <input type="text" name="ethnicity" class="w-full p-2 border rounded" value="ไทย">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">ศาสนา</label>
                                <input type="text" name="religion" class="w-full p-2 border rounded" value="พุทธ">
                            </div>
                            
                            <div>
                                <label class="block text-gray-700 mb-2">เบอร์โทรศัพท์</label>
                                <input type="tel" name="phone" class="w-full p-2 border rounded">
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-gray-700 mb-2">อีเมล</label>
                            <input type="email" name="email" class="w-full md:w-1/2 p-2 border rounded">
                        </div>
                    </div>
                    
                    <!-- ส่วนที่ 3: ผู้รับผลประโยชน์ -->
                    <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                        <h2 class="text-lg font-semibold mb-4 text-green-700">3. เงื่อนไขการรับสวัสดิการ</h2>
                        
                        <div id="beneficiaries-container">
                            <div class="beneficiary-item border-b pb-4 mb-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">ชื่อ-สกุล ผู้รับผลประโยชน์</label>
                                        <input type="text" name="beneficiaries[0][name]" class="w-full p-2 border rounded">
                                    </div>
                                    
                                    <div>
                                        <label class="block text-gray-700 mb-2">ความสัมพันธ์</label>
                                        <input type="text" name="beneficiaries[0][relation]" class="w-full p-2 border rounded">
                                    </div>
                                </div>
                                
                                <div class="mb-4 text-start">
                                    <label class="block text-gray-700 mb-2">เงื่อนไขการรับเงิน</label>
                                    <div class="flex flex-col space-y-3">
                                        <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                            <input type="radio" name="beneficiaries[0][distributionType]" value="full" class="mt-0.5" checked>
                                            <label class="text-gray-700">ให้ได้รับเต็มจำนวน</label>
                                        </div>
                                        
                                        <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                            <input type="radio" name="beneficiaries[0][distributionType]" value="equal" class="mt-0.5">
                                            <label class="text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</label>
                                        </div>
                                        
                                        <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                            <input type="radio" name="beneficiaries[0][distributionType]" value="other" class="mt-0.5">
                                            <label class="text-gray-700">อื่นๆ</label>
                                        </div>
                                        
                                        <div class="pl-[24px]">
                                            <input type="text" name="beneficiaries[0][distributionDetail]" class="p-2 border rounded w-full md:w-1/2" placeholder="โปรดระบุ">
                                        </div>
                                    </div>                                
                                </div>
                            </div>
                        </div>
                        
                        <button type="button" id="add-beneficiary" class="text-blue-500 hover:text-blue-700 font-medium flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                            </svg>
                            เพิ่มผู้รับผลประโยชน์
                        </button>
                        
                        <div class="mt-6">
                            <label class="block text-gray-700 mb-2">จำนวนคนที่อาศัยในครัวเรือน (คน)</label>
                            <input type="number" name="NumFamilyMembers" class="w-full md:w-1/4 p-2 border rounded">
                        </div>
                    </div>
                    
                    <div class="p-4 bg-gray-100 rounded-md border border-gray-200">
                        <p class="mb-4">ข้าพเจ้าได้อ่านเข้าใจในเงื่อนไขและระเบียบกองทุนขยะรีไซเคิลแล้ว ยินดีปฏิบัติตามทุกประการ</p>
                        <p class="text-gray-600 text-sm mb-4"><strong>หมายเหตุ:</strong> ผู้ที่เข้าร่วมกองทุนฯ ต้องดำเนินการคัดแยกขยะตามประเภท เพื่อเป็นการลดขยะตั้งแต่ต้นทาง</p>
                    </div>
                    
                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded font-medium w-full">ลงทะเบียน</button>
                    <button type="button" class="bg-gray-500 text-white hover:bg-gray-700 px-6 py-3 rounded font-medium w-full" onclick="closeAddFamilyForm()">ปิด</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="container mx-auto p-6 bg-white my-2 rounded-lg">
        <div class="w-full flex items-center justify-between">
            <h1 class="text-2xl">จำนวนสมาชิก (<%= allFamilies.length %>)</h1>
            <div class="flex items-center">
                <form action="" method="GET" class="search-form flex gap-1">
                    <input type="text" name="familyName" value="<%= query.familyName || '' %>" placeholder="ชื่อครัวเรือน" class="search-input">
                    <input type="text" name="AccountName" value="<%= query.AccountName || '' %>" placeholder="ชื่อบัญชีครัวเรือน" class="search-input">
                
                    <select name="village" class="search-input text-black">
                        <option value="">-- เลือกหมู่บ้าน --</option>
                        <% villages.forEach(v => { %>
                            <option value="<%= v._id %>" <%= query.village == v._id ? 'selected' : '' %>><%= v.villageName %></option>
                        <% }) %>
                    </select>
                
                    <select name="Type" class="search-input">
                        <option value="">-- เลือกประเภท --</option>
                        <option value="household" <%= query.Type === 'household' ? 'selected' : '' %>>บ้าน</option>
                        <option value="school" <%= query.Type === 'school' ? 'selected' : '' %>>โรงเรียน</option>
                        <option value="municipality" <%= query.Type === 'municipality' ? 'selected' : '' %>>อปท.</option>
                        <option value="community" <%= query.Type === 'community' ? 'selected' : '' %>>ชุมชน</option>
                    </select>
                
                    <button type="submit" class="search-button main-bg-color">ค้นหา</button>
                </form>
                
                
                <div>
                    <button type="button" class="main-bg-color text-white p-2 shadow rounded-lg ml-2" onclick="ShowAddFamilyForm()">เพิ่มครัวเรือน</button>
                </div>
            </div>
        </div>
        <table class="min-w-full divide-y divide-gray-200 mt-4 p-4">
            <thead class="main-bg-color">
                <tr>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">ลำดับที่</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-left text-white uppercase">ชื่อครัวเรือน</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">ชื่อบัญชีครัวเรือน</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">ที่อยู่</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">หมู่บ้าน</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">จำนวนสมาชิก</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">ประเภท</th>
                    <th class="px-6 py-3 text-lg font-medium tracking-wider text-center text-white uppercase">จัดการ</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% allFamilies.forEach((family, index) => { %>
                <tr>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center"><%= index + 1 %></td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-left"><%= family.familyName %></td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center"><%= family.username %></td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center text-blue-500 hover:underline">
                        <a href="#" onclick='ShowLocation(<%= JSON.stringify(family) %>)'>ข้อมูลที่อยู่ของครัวเรือน</a>
                    </td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center"><%= family.village.villageName %></td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center"><%= family.NumFamilyMembers %></td>
                    <td class="px-6 py-4 text-xl whitespace-nowrap text-center"><%= family.Type %></td>
                    <td class="whitespace-nowrap text-center">
                        <button class="bg-blue-500 p-3 rounded text-white"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="bg-red-500 p-3 rounded text-white"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <div id="ShowLocationModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
            <div class="bg-white p-6 w-1/2 rounded-lg relative">
                <h3 class="text-xl font-medium leading-6 text-gray-800">ข้อมูลที่อยู่ของครัวเรือน</h3>
                <hr class="my-3">
                <div class="bg-gray-50 p-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 mb-2">ชื่อครัวเรือน</label>
                            <input type="text" name="familyName" class="w-full p-2 border rounded" disabled>
                        </div>
        
                        <div>
                            <label class="block text-gray-700 mb-2">ประเภทครัวเรือน</label>
                            <select name="Type" class="w-full p-2 border rounded" disabled>
                                <option value="household">บ้านเรือน</option>
                                <option value="school">โรงเรียน</option>
                                <option value="municipality">อปท.</option>
                                <option value="community">ชุมชน</option>
                            </select>
                        </div>
                    </div>
                    <h3 class="font-medium text-gray-700 mt-4 mb-2">ที่อยู่</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-gray-700 mb-2">บ้านเลขที่</label>
                            <input type="text" name="houseNumber" class="w-full p-2 border rounded" disabled>
                        </div>
        
                        <div>
                            <label class="block text-gray-700 mb-2">ถนน</label>
                            <input type="text" name="road" class="w-full p-2 border rounded" disabled>
                        </div>
        
                        <div>
                            <label class="block text-gray-700 mb-2">ตำบล</label>
                            <input type="text" name="subdistrict" class="w-full p-2 border rounded" disabled>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <div>
                            <label class="block text-gray-700 mb-2">อำเภอ</label>
                            <input type="text" name="district" class="w-full p-2 border rounded" disabled>
                        </div>
                        <div>
                            <label class="block text-gray-700 mb-2">จังหวัด</label>
                            <input type="text" name="province" class="w-full p-2 border rounded" value="ขอนแก่น" disabled>
                        </div>
                        <div>
                            <label class="block text-gray-700 mb-2">รหัสไปรษณีย์</label>
                            <input type="text" name="postalCode" class="w-full md:w-1/3 p-2 border rounded" disabled>
                        </div>
                    </div>
                    <hr class="my-6">
                    <div class="mt-4 flex justify-end">
                        <button class="bg-red-500 text-white px-4 py-2 rounded" onclick="CloseLocationModal()">ปิด</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>
</body>
<script>
    // JavaScript สำหรับเพิ่มผู้รับผลประโยชน์
    document.getElementById('add-beneficiary').addEventListener('click', function() {
        const container = document.getElementById('beneficiaries-container');
        const beneficiaryCount = container.getElementsByClassName('beneficiary-item').length;
        const index = beneficiaryCount;
        
        const newBeneficiary = document.createElement('div');
        newBeneficiary.className = 'beneficiary-item border-b pb-4 mb-4';
        newBeneficiary.innerHTML = `
            <div class="flex justify-between items-center mb-2">
                <h3 class="font-medium">ผู้รับผลประโยชน์ ${index + 1}</h3>
                <button type="button" class="text-red-500 hover:text-red-700 remove-beneficiary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 mb-2">ชื่อ-สกุล ผู้รับผลประโยชน์</label>
                    <input type="text" name="beneficiaries[${index}][name]" class="w-full p-2 border rounded">
                </div>
                
                <div>
                    <label class="block text-gray-700 mb-2">ความสัมพันธ์</label>
                    <input type="text" name="beneficiaries[${index}][relation]" class="w-full p-2 border rounded">
                </div>
            </div>
            
            <div class="mb-4 text-start">
                <label class="block text-gray-700 mb-2">เงื่อนไขการรับเงิน</label>
                <div class="flex flex-col space-y-3">
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="full" class="mt-0.5" checked>
                        <label class="text-gray-700">ให้ได้รับเต็มจำนวน</label>
                    </div>
                                        
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="equal" class="mt-0.5">
                        <label class="text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</label>
                    </div>
                                        
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="other" class="mt-0.5">
                        <label class="text-gray-700">อื่นๆ</label>
                    </div>
                                        
                    <div class="pl-[24px]">
                        <input type="text" name="beneficiaries[${index}][distributionType]" class="p-2 border rounded w-full md:w-1/2" placeholder="โปรดระบุ">
                    </div>
                </div>                                
            </div>
        `;
        
        container.appendChild(newBeneficiary);
        
        // เพิ่ม event listener สำหรับปุ่มลบ
        const removeButtons = document.getElementsByClassName('remove-beneficiary');
        for (let btn of removeButtons) {
            btn.addEventListener('click', function() {
                this.closest('.beneficiary-item').remove();
                // อัพเดต index สำหรับผู้รับผลประโยชน์ที่เหลือ
                updateBeneficiaryIndexes();
            });
        }
    });
    
    // ฟังก์ชันอัพเดต index ของผู้รับผลประโยชน์
    function updateBeneficiaryIndexes() {
        const beneficiaryItems = document.getElementsByClassName('beneficiary-item');
        for (let i = 0; i < beneficiaryItems.length; i++) {
            const inputs = beneficiaryItems[i].querySelectorAll('input[name^="beneficiaries"]');
            for (let input of inputs) {
                const name = input.getAttribute('name');
                input.setAttribute('name', name.replace(/beneficiaries\[\d+\]/, `beneficiaries[${i}]`));
            }
            
            const title = beneficiaryItems[i].querySelector('h3');
            if (title && i > 0) { // ไม่อัพเดตชื่อผู้รับผลประโยชน์คนแรก
                title.textContent = `ผู้รับผลประโยชน์ ${i + 1}`;
            }
        }
    }
    function ShowAddFamilyForm() {
        document.getElementById('ShowAddFamilyForm').classList.remove("hidden");
    }
    function closeAddFamilyForm() {
        Swal.fire({
        title: "คุณต้องการจะปิดฟอร์มนี้ใช่หรือไม่",
        text: "หากปิดแล้วจะข้อมูลที่กรอกจะหายไป",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#00923f",
        cancelButtonColor: "#d33",
        confirmButtonText: "ยืนยัน",
        cancelButtonText: "ยกเลิก"
        }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('ShowAddFamilyForm').classList.add("hidden");
        }
        });
    }
    function ShowLocation(family) {
        const ShowLocationModal = document.getElementById('ShowLocationModal');
        ShowLocationModal.classList.remove("hidden");

        document.querySelector("#ShowLocationModal input[name='familyName']").value = family.familyName;
        document.querySelector("#ShowLocationModal input[name='houseNumber']").value = family.address.houseNumber;
        document.querySelector("#ShowLocationModal input[name='road']").value = family.address.road;
        document.querySelector("#ShowLocationModal input[name='subdistrict']").value = family.address.subdistrict;
        document.querySelector("#ShowLocationModal input[name='district']").value = family.address.district;
        document.querySelector("#ShowLocationModal input[name='province']").value = family.address.province;
        document.querySelector("#ShowLocationModal input[name='postalCode']").value = family.address.postalCode;
    }
    function CloseLocationModal() {
        document.getElementById('ShowLocationModal').classList.add("hidden");
    }
</script>
</html>