    async function showEditModal(familyId) {
        try {
            const response = await fetch(`/employee/member/${familyId}/edit`);
            const result = await response.json();

            if (!result.success) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: result.error || 'ไม่สามารถดึงข้อมูลได้',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            const { family, member } = result.data;
            const modal = document.getElementById('editFamilyModal');
            modal.classList.remove('hidden');

            // เติมข้อมูลครัวเรือน
            document.querySelector('#editFamilyModal input[name="familyName"]').value = family.familyName || '';
            document.querySelector('#editFamilyModal select[name="Type"]').value = family.Type || 'household';
            document.querySelector('#editFamilyModal input[name="username"]').value = family.username || '';
            document.querySelector('#editFamilyModal input[name="password"]').value = '';

            // เติมข้อมูลที่อยู่
            document.querySelector('#editFamilyModal input[name="houseNumber"]').value = family.address?.houseNumber || '';
            document.querySelector('#editFamilyModal select[name="village"]').value = family.village?._id || '';
            document.querySelector('#editFamilyModal input[name="road"]').value = family.address?.road || '';
            document.querySelector('#editFamilyModal input[name="subdistrict"]').value = family.address?.subdistrict || '';
            document.querySelector('#editFamilyModal input[name="district"]').value = family.address?.district || '';
            document.querySelector('#editFamilyModal input[name="province"]').value = family.address?.province || '';
            document.querySelector('#editFamilyModal input[name="postalCode"]').value = family.address?.postalCode || '';

            // เติมข้อมูลสมาชิกตัวแทน
            document.querySelector('#editFamilyModal input[name="name"]').value = member.name || '';
            document.querySelector('#editFamilyModal #editIdCard').value = formatThaiID(member.idCardNumber || '');
            document.querySelector('#editFamilyModal input[name="birthDate"]').value = member.birthDate ? member.birthDate.split('T')[0] : '';
            document.querySelector('#editFamilyModal input[name="occupation"]').value = member.occupation || '';
            document.querySelector('#editFamilyModal input[name="age"]').value = member.age || '';
            document.querySelector('#editFamilyModal input[name="nationality"]').value = member.nationality || '';
            document.querySelector('#editFamilyModal input[name="ethnicity"]').value = member.ethnicity || '';
            document.querySelector('#editFamilyModal input[name="religion"]').value = member.religion || '';
            document.querySelector('#editFamilyModal #editPhone').value = formatPhoneNumber(member.phone || '');

            // ⭐ เติมข้อมูลสมาชิกอื่นๆ ในครัวเรือน (จาก beneficiaries ที่ backend แปลงมาจาก householdMembers)
            const beneficiariesContainer = document.getElementById('edit-beneficiaries-container');
            beneficiariesContainer.innerHTML = '';

            if (member.beneficiaries && member.beneficiaries.length > 0) {
                member.beneficiaries.forEach((beneficiary, index) => {
                    addEditBeneficiary(index, beneficiary);
                });
            } else {
                addEditBeneficiary(0, {});
            }

            document.querySelector('#editFamilyModal input[name="NumFamilyMembers"]').value = family.NumFamilyMembers || '';
            document.getElementById('editFamilyForm').action = `/employee/memberUpdate/${family._id}`;

            setupAutoFormatListeners('#editFamilyModal');

            const editBirthDate = document.querySelector('#editFamilyModal input[name="birthDate"]');
            const editAgeInput = document.querySelector('#editFamilyModal input[name="age"]');
            if (editBirthDate && editAgeInput) {
                const newBirthDate = editBirthDate.cloneNode(true);
                editBirthDate.parentNode.replaceChild(newBirthDate, editBirthDate);
                
                newBirthDate.addEventListener('change', function() {
                    editAgeInput.value = calculateAge(this.value);
                });
            }

        } catch (error) {
            console.error('Error loading member data:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: 'ไม่สามารถโหลดข้อมูลได้',
                confirmButtonColor: '#d33'
            });
        }
    }

