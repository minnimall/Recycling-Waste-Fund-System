            <%- include('../partials/employeePartials/empFooter.ejs') %>
</body>
<script>
    // JavaScript สำหรับเพิ่มผู้รับผลประโยชน์
    document.getElementById('add-beneficiary').addEventListener('click', function () {
        const container = document.getElementById('beneficiaries-container');
        const beneficiaryCount = container.getElementsByClassName('beneficiary-item').length;
        const index = beneficiaryCount;

        const newBeneficiary = document.createElement('div');
        newBeneficiary.className = 'beneficiary-item border-b pb-4 mb-4';
        newBeneficiary.innerHTML = `
            <div class="flex justify-between items-center mb-2">
                <h3 class="font-medium">ผู้รับผลประโยชน์ ${index + 1}</h3>
                <button type="button" class="text-red-500 hover:text-red-700 remove-beneficiary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 mb-2">ชื่อ-สกุล ผู้รับผลประโยชน์</label>
                    <input type="text" name="beneficiaries[${index}][name]" class="w-full p-2 border rounded">
                </div>
                
                <div>
                    <label class="block text-gray-700 mb-2">ความสัมพันธ์</label>
                    <input type="text" name="beneficiaries[${index}][relation]" class="w-full p-2 border rounded">
                </div>
            </div>
            
            <div class="mb-4 text-start">
                <label class="block text-gray-700 mb-2">เงื่อนไขการรับเงิน</label>
                <div class="flex flex-col space-y-3">
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="full" class="mt-0.5" checked>
                        <label class="text-gray-700">ให้ได้รับเต็มจำนวน</label>
                    </div>
                                        
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="equal" class="mt-0.5">
                        <label class="text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</label>
                    </div>
                                        
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="other" class="mt-0.5">
                        <label class="text-gray-700">อื่นๆ</label>
                    </div>
                                        
                    <div class="pl-[24px]">
                        <input type="text" name="beneficiaries[${index}][distributionType]" class="p-2 border rounded w-full md:w-1/2" placeholder="โปรดระบุ">
                    </div>
                </div>                                
            </div>
        `;

        container.appendChild(newBeneficiary);

        // เพิ่ม event listener สำหรับปุ่มลบ
        const removeButtons = document.getElementsByClassName('remove-beneficiary');
        for (let btn of removeButtons) {
            btn.addEventListener('click', function () {
                this.closest('.beneficiary-item').remove();
                // อัพเดต index สำหรับผู้รับผลประโยชน์ที่เหลือ
                updateBeneficiaryIndexes();
            });
        }
    });

    // ฟังก์ชันอัพเดต index ของผู้รับผลประโยชน์
    function updateBeneficiaryIndexes() {
        const beneficiaryItems = document.getElementsByClassName('beneficiary-item');
        for (let i = 0; i < beneficiaryItems.length; i++) {
            const inputs = beneficiaryItems[i].querySelectorAll('input[name^="beneficiaries"]');
            for (let input of inputs) {
                const name = input.getAttribute('name');
                input.setAttribute('name', name.replace(/beneficiaries\[\d+\]/, `beneficiaries[${i}]`));
            }

            const title = beneficiaryItems[i].querySelector('h3');
            if (title && i > 0) { // ไม่อัพเดตชื่อผู้รับผลประโยชน์คนแรก
                title.textContent = `ผู้รับผลประโยชน์ ${i + 1}`;
            }
        }
    }
    function ShowAddFamilyForm() {
        const modal = document.getElementById('ShowAddFamilyForm');
        modal.classList.remove("hidden");
        modal.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function closeAddFamilyForm() {
        Swal.fire({
            title: "คุณต้องการจะปิดฟอร์มนี้ใช่หรือไม่",
            text: "หากปิดแล้วจะข้อมูลที่กรอกจะหายไป",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#00923f",
            cancelButtonColor: "#d33",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก"
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('ShowAddFamilyForm').classList.add("hidden");
            }
        });
    }
    function ShowLocation(family) {
        const ShowLocationModal = document.getElementById('ShowLocationModal');
        ShowLocationModal.classList.remove("hidden");

        document.querySelector("#ShowLocationModal input[name='familyName']").value = family.familyName;
        document.querySelector("#ShowLocationModal input[name='houseNumber']").value = family.address.houseNumber;
        document.querySelector("#ShowLocationModal input[name='road']").value = family.address.road;
        document.querySelector("#ShowLocationModal input[name='subdistrict']").value = family.address.subdistrict;
        document.querySelector("#ShowLocationModal input[name='district']").value = family.address.district;
        document.querySelector("#ShowLocationModal input[name='province']").value = family.address.province;
        document.querySelector("#ShowLocationModal input[name='postalCode']").value = family.address.postalCode;
    }
    function CloseLocationModal() {
        document.getElementById('ShowLocationModal').classList.add("hidden");
    }

    // ลบสมัครกองทุน
    function showModalDelete(index, familyId, familyAccountNumber, familyName) {
        Swal.fire({
            title: `ลบสมาชิก "${familyName}" หรือไม่?`,
            html: `
                <p class="text-gray-600 mb-2">เลขบัญชี ${familyAccountNumber}</p>
            `,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6b7280",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ยืนยัน"
        }).then((result) => {
            if (result.isConfirmed) {
                // แสดง Loading
                Swal.fire({
                    title: 'กำลังลบข้อมูล...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // ส่ง Request ไปยัง Backend
                fetch(`/employee/memberDelete/${familyId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบข้อมูลสำเร็จ',
                            text: data.message || 'ข้อมูลสมาชิกถูกลบเรียบร้อยแล้ว',
                            confirmButtonColor: '#28a745',
                            timer: 2000
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'ลบข้อมูลไม่สำเร็จ',
                            text: data.message || 'เกิดข้อผิดพลาดในการลบข้อมูล',
                            confirmButtonColor: '#d33'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้',
                        confirmButtonColor: '#d33'
                    });
                });
            }
        });
    }

    // ฟังก์ชันเปิด Modal แก้ไขข้อมูล
    async function showEditModal(familyId) {
        try {
            // ดึงข้อมูลจาก API
            const response = await fetch(`/employee/member/${familyId}/edit`);
            const result = await response.json();

            if (!result.success) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: result.error || 'ไม่สามารถดึงข้อมูลได้',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            const { family, member, account } = result.data;

            // แสดง Modal
            const modal = document.getElementById('editFamilyModal');
            modal.classList.remove('hidden');

            // เติมข้อมูลครัวเรือน
            document.querySelector('#editFamilyModal input[name="familyName"]').value = family.familyName || '';
            document.querySelector('#editFamilyModal select[name="Type"]').value = family.Type || 'household';
            document.querySelector('#editFamilyModal input[name="username"]').value = family.username || '';
            document.querySelector('#editFamilyModal input[name="password"]').value = ''; // ไม่แสดงรหัสผ่านเดิม

            // เติมข้อมูลที่อยู่
            document.querySelector('#editFamilyModal input[name="houseNumber"]').value = family.address?.houseNumber || '';
            document.querySelector('#editFamilyModal select[name="village"]').value = family.village?._id || '';
            document.querySelector('#editFamilyModal input[name="road"]').value = family.address?.road || '';
            document.querySelector('#editFamilyModal input[name="subdistrict"]').value = family.address?.subdistrict || '';
            document.querySelector('#editFamilyModal input[name="district"]').value = family.address?.district || '';
            document.querySelector('#editFamilyModal input[name="province"]').value = family.address?.province || '';
            document.querySelector('#editFamilyModal input[name="postalCode"]').value = family.address?.postalCode || '';

            // เติมข้อมูลสมาชิก
            document.querySelector('#editFamilyModal input[name="name"]').value = member.name || '';
            document.querySelector('#editFamilyModal input[name="idCardNumber"]').value = member.idCardNumber || '';
            document.querySelector('#editFamilyModal input[name="birthDate"]').value = member.birthDate ? member.birthDate.split('T')[0] : '';
            document.querySelector('#editFamilyModal input[name="occupation"]').value = member.occupation || '';
            document.querySelector('#editFamilyModal input[name="age"]').value = member.age || '';
            document.querySelector('#editFamilyModal input[name="nationality"]').value = member.nationality || '';
            document.querySelector('#editFamilyModal input[name="ethnicity"]').value = member.ethnicity || '';
            document.querySelector('#editFamilyModal input[name="religion"]').value = member.religion || '';
            document.querySelector('#editFamilyModal input[name="phone"]').value = member.phone || '';
            document.querySelector('#editFamilyModal input[name="email"]').value = member.email || '';

            // เติมข้อมูลผู้รับผลประโยชน์
            const beneficiariesContainer = document.getElementById('edit-beneficiaries-container');
            beneficiariesContainer.innerHTML = ''; // ล้างข้อมูลเดิม

            if (member.beneficiaries && member.beneficiaries.length > 0) {
                member.beneficiaries.forEach((beneficiary, index) => {
                    addEditBeneficiary(index, beneficiary);
                });
            } else {
                // เพิ่มผู้รับผลประโยชน์คนแรกเปล่าๆ
                addEditBeneficiary(0, {});
            }

            // เติมจำนวนสมาชิกในครัวเรือน
            document.querySelector('#editFamilyModal input[name="NumFamilyMembers"]').value = family.NumFamilyMembers || '';

            // เก็บ familyId ไว้ใน form action
            document.getElementById('editFamilyForm').action = `/employee/memberUpdate/${family._id}`;

        } catch (error) {
            console.error('Error loading member data:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: 'ไม่สามารถโหลดข้อมูลได้',
                confirmButtonColor: '#d33'
            });
        }
    }

    // ฟังก์ชันเพิ่มผู้รับผลประโยชน์ใน Modal แก้ไข
    function addEditBeneficiary(index, data = {}) {
        const container = document.getElementById('edit-beneficiaries-container');

        const beneficiaryItem = document.createElement('div');
        beneficiaryItem.className = 'beneficiary-item border-b pb-4 mb-4';
        beneficiaryItem.innerHTML = `
            ${index > 0 ? `
            <div class="flex justify-between items-center mb-2">
                <h3 class="font-medium">ผู้รับผลประโยชน์ ${index + 1}</h3>
                <button type="button" class="text-red-500 hover:text-red-700 remove-edit-beneficiary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            ` : ''}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 mb-2">ชื่อ-สกุล ผู้รับผลประโยชน์</label>
                    <input type="text" name="beneficiaries[${index}][name]" value="${data.name || ''}" class="w-full p-2 border rounded">
                </div>
                <div>
                    <label class="block text-gray-700 mb-2">ความสัมพันธ์</label>
                    <input type="text" name="beneficiaries[${index}][relation]" value="${data.relation || ''}" class="w-full p-2 border rounded">
                </div>
            </div>
            <div class="mb-4 text-start">
                <label class="block text-gray-700 mb-2">เงื่อนไขการรับเงิน</label>
                <div class="flex flex-col space-y-3">
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="full" ${data.distributionType === 'full' ? 'checked' : ''} class="mt-0.5">
                        <label class="text-gray-700">ให้ได้รับเต็มจำนวน</label>
                    </div>
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="equal" ${!data.distributionType || data.distributionType === 'equal' ? 'checked' : ''} class="mt-0.5">
                        <label class="text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</label>
                    </div>
                    <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="other" ${data.distributionType === 'other' ? 'checked' : ''} class="mt-0.5">
                        <label class="text-gray-700">อื่นๆ</label>
                    </div>
                    <div class="pl-[24px]">
                        <input type="text" name="beneficiaries[${index}][distributionDetail]" value="${data.distributionDetail || ''}" class="p-2 border rounded w-full md:w-1/2" placeholder="โปรดระบุ">
                    </div>
                </div>
            </div>
        `;

        container.appendChild(beneficiaryItem);

        // เพิ่ม event listener สำหรับปุ่มลบ
        if (index > 0) {
            const removeBtn = beneficiaryItem.querySelector('.remove-edit-beneficiary');
            removeBtn.addEventListener('click', function () {
                this.closest('.beneficiary-item').remove();
                updateEditBeneficiaryIndexes();
            });
        }
    }

    // ฟังก์ชันอัปเดต index ของผู้รับผลประโยชน์ใน Modal แก้ไข
    function updateEditBeneficiaryIndexes() {
        const beneficiaryItems = document.querySelectorAll('#edit-beneficiaries-container .beneficiary-item');
        beneficiaryItems.forEach((item, i) => {
            const inputs = item.querySelectorAll('input[name^="beneficiaries"]');
            inputs.forEach(input => {
                const name = input.getAttribute('name');
                input.setAttribute('name', name.replace(/beneficiaries\[\d+\]/, `beneficiaries[${i}]`));
            });

            const title = item.querySelector('h3');
            if (title && i > 0) {
                title.textContent = `ผู้รับผลประโยชน์ ${i + 1}`;
            }
        });
    }

    // Event listener สำหรับปุ่มเพิ่มผู้รับผลประโยชน์ใน Modal แก้ไข
    document.getElementById('add-edit-beneficiary')?.addEventListener('click', function () {
        const container = document.getElementById('edit-beneficiaries-container');
        const beneficiaryCount = container.getElementsByClassName('beneficiary-item').length;
        addEditBeneficiary(beneficiaryCount, {});
    });

    // ฟังก์ชันปิด Modal แก้ไข
    function closeEditModal() {
        Swal.fire({
            title: "คุณต้องการปิดฟอร์มนี้ใช่หรือไม่",
            text: "หากปิดแล้วข้อมูลที่แก้ไขจะไม่ถูกบันทึก",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#00923f",
            cancelButtonColor: "#d33",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก"
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('editFamilyModal').classList.add("hidden");
            }
        });
    }

    // ตรวจสอบรหัสผ่านก่อนส่งฟอร์ม
    document.addEventListener("DOMContentLoaded", () => {
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const passwordError = document.getElementById("passwordError");
    const form = document.querySelector("form");

    // ฟังก์ชันตรวจสอบความตรงกัน
    function checkPasswordMatch() {
        if (confirmPassword.value === "") {
        confirmPassword.classList.remove("border-red-500", "focus:ring-red-300");
        passwordError.classList.add("hidden");
        return true;
        }

        if (password.value !== confirmPassword.value) {
        confirmPassword.classList.add("border-red-500", "focus:ring-red-300");
        passwordError.classList.remove("hidden");
        return false;
        } else {
        confirmPassword.classList.remove("border-red-500", "focus:ring-red-300");
        passwordError.classList.add("hidden");
        return true;
        }
    }

    // ตรวจสอบแบบ real-time
    confirmPassword.addEventListener("input", checkPasswordMatch);
    password.addEventListener("input", checkPasswordMatch);

    // ตรวจสอบตอนส่งฟอร์ม
    form.addEventListener("submit", (e) => {
        if (!checkPasswordMatch()) {
        e.preventDefault();
        Swal.fire({
            icon: "error",
            title: "รหัสผ่านไม่ตรงกัน",
            text: "กรุณากรอกให้ตรงกันทั้งสองช่อง",
            confirmButtonColor: "#ef4444"
        });
        }
    });
    });

    // Format IDCard ให้เป็น Pattern ไทย
    const idInput = document.getElementById("idCardNumber");
    const idError = document.getElementById("idCardError");

    // ฟังก์ชันฟอร์แมตเลขบัตรประชาชนไทย
    function formatThaiID(value) {
    // เอาเฉพาะตัวเลข
    let numbers = value.replace(/\D/g, '').slice(0, 13);

    // ใส่ขีดตามตำแหน่ง 1-4-5-2-1
    let formatted = '';
    if(numbers.length > 0) formatted += numbers.substr(0,1);
    if(numbers.length > 1) formatted += '-' + numbers.substr(1,4);
    if(numbers.length > 5) formatted += '-' + numbers.substr(5,5);
    if(numbers.length > 10) formatted += '-' + numbers.substr(10,2);
    if(numbers.length > 12) formatted += '-' + numbers.substr(12,1);

    return formatted;
    }

    // ฟอร์แมตแบบ real-time
    idInput.addEventListener('input', (e) => {
    e.target.value = formatThaiID(e.target.value);
    });

    // ตรวจสอบตอน submit
    document.getElementById("ShowAddFamilyForm").addEventListener("submit", function(e) {
        // เอาเฉพาะตัวเลขมาลอง validate
        const numbersOnly = idInput.value.replace(/\D/g, '');
        if(numbersOnly.length !== 13) {
            e.preventDefault();
            idError.classList.remove('hidden');
            idInput.classList.add('border-red-500', 'focus:ring-red-300');
            Swal.fire({
                icon: 'error',
                title: 'เลขบัตรประชาชนไม่ถูกต้อง',
                text: 'กรุณากรอกเลขบัตรประชาชนให้ครบ 13 หลัก',
                confirmButtonColor: '#ef4444'
            });
        } else {
            idInput.value = numbersOnly;

            idError.classList.add('hidden');
            idInput.classList.remove('border-red-500', 'focus:ring-red-300');
        }
    });
</script>

</html>