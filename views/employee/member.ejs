<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_employee/member.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>
            <script>
                // เช็คข้อความที่ส่งมาจาก URL
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745', // สีเขียวสำหรับความสำเร็จ
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด!',
                        text: errorMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#d33',
                        timer: 3000
                    });
                }
            </script>

            <div class="content bg-gray-50 min-screen">
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                            สมาชิกกองทุนขยะรีไซเคิล</h1>
                        <p class="text-gray-600">ข้อมูลสมาชิกกองทุนขยะรีไซเคิลทั้งหมด</p>
                    </div>

                    <div>
                        <button type="button"
                            class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300"
                            onclick="ShowAddFamilyForm()">เพิ่มสมาชิก</button>
                    </div>
                </div>


                <!-- Search and Filter Section -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <form action="" method="GET">
                        <div class="flex flex-col md:flex-row gap-4">
                            <div class="flex-1">
                                <div class="relative">
                                    <input type="text" id="search" name="familyName"
                                        value="<%= query.familyName || '' %>" placeholder="ชื่อครัวเรือน..."
                                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <div class="absolute left-3 top-2.5 text-gray-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1 md:flex-1">
                                <div class="relative">
                                    <input type="text" id="searchAccountNumber" name="AccountNumber"
                                        value="<%= query.AccountNumber || '' %>" placeholder="เลขบัญชี..."
                                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <div class="absolute left-3 top-2.5 text-gray-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="md:w-64">
                                <select name="village"
                                    class="w-full py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <option value="">เลือกหมู่บ้าน</option>
                                    <% villages.forEach(v=> { %>
                                        <option value="<%= v._id %>" <%=query.village==v._id ? 'selected' : '' %>><%=
                                                v.villageName %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <div class="md:w-64">
                                <select name="Type"
                                    class="w-full py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <option value="">เลือกประเภท</option>
                                    <option value="household" <%=query.Type==='household' ? 'selected' : '' %>>บ้าน
                                    </option>
                                    <option value="school" <%=query.Type==='school' ? 'selected' : '' %>>โรงเรียน
                                    </option>
                                    <option value="municipality" <%=query.Type==='municipality' ? 'selected' : '' %>
                                        >อปท.</option>
                                    <option value="community" <%=query.Type==='community' ? 'selected' : '' %>>ชุมชน
                                    </option>>
                                    <option value="temple" <%=query.Type==='temple' ? 'selected' : '' %>>วัด</option>>
                                </select>
                            </div>
                            <div>
                                <button
                                    class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                    <i class="fas fa-search mr-2"></i>ค้นหา
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                        <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                            จำนวนสมาชิกทั้งหมด <span class="text-blue-600 text-base font-normal">
                                <%= allFamilies.length %> รายการ
                            </span>
                        </h2>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        ลำดับที่</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        เลขบัญชี</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ชื่อครัวเรือน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ชื่อบัญชีครัวเรือน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ที่อยู่</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        หมู่บ้าน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        จำนวนสมาชิก</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ประเภท</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        จัดการ</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (allFamilies.length> 0) { %>
                                    <% allFamilies.forEach((family, index)=> { %>
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-4 py-3 text-sm whitespace-nowrap text-center">
                                                <%= index + 1 %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.AccountNumber %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.familyName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.AccountName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <a href="#" onclick='ShowLocation(<%= JSON.stringify(family) %>)'
                                                    class="text-blue-500 hover:text-blue-700 hover:underline transition-colors">
                                                    ข้อมูลที่อยู่ของครัวเรือน
                                                </a>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.village.villageName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap text-center">
                                                <%= family.NumFamilyMembers %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <span class="px-2 py-1 rounded-full text-sm font-medium">
                                                    <%= family.typeThai %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 whitespace-nowrap text-center">
                                                <button onclick="showEditModal('<%= family._id %>')" class="edit-btn">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <button onclick="showModalDelete('<%= index + 1 %>', '<%= family._id %>','<%= family.AccountNumber %>','<%= family.familyName %>')" class="delete-btn">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center py-4 text-gray-500">
                                                        -ไม่พบข้อมูลสมาชิก -</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- modal ฟอร์มลงทะเบียนครัวเรือน -->
            <div id="ShowAddFamilyForm"
                class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden overflow-y-scroll">
                <div class="container mx-auto p-6 my-auto">
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h1 class="text-2xl font-bold mb-6">สมัครเข้าร่วมกองทุนขยะรีไซเคิล</h1>

                        <form action="/employee/memberRegister" method="POST" class="space-y-6">

                            <!-- ส่วนที่ 1: ข้อมูลครัวเรือน -->
                            <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                                <h2 class="text-lg font-semibold mb-4 text-green-700">1. ข้อมูลครัวเรือน</h2>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">ชื่อครัวเรือน <span class="text-red-500">*</span></label>
                                        <input type="text" name="familyName" class="w-full p-2 border rounded" required>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">ประเภทครัวเรือน <span class="text-red-500">*</span></label>
                                        <select name="Type" class="w-full p-2 border rounded" required>
                                            <option value="household">บ้านเรือน</option>
                                            <option value="school">โรงเรียน</option>
                                            <option value="municipality">อปท.</option>
                                            <option value="community">ชุมชน</option>
                                            <option value="temple">วัด</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">ชื่อผู้ใช้ (Username) ชื่อผู้ใช้ต้องมี 5-20 ตัวอักษร และไม่มีอักขระพิเศษ <span class="text-red-500">*</span></label>
                                        <input type="text" name="username" class="w-full p-2 border rounded" required>
                                    </div>

                                    <div class="mb-4">
                                        <label for="password" class="block text-gray-700 mb-2">รหัสผ่าน (ตัวเลข 6-8 หลัก) <span class="text-red-500">*</span></label>
                                        <input type="password" name="password" id="password"
                                            class="w-full p-2 border border-gray-300 rounded focus:ring focus:ring-blue-200" placeholder="กรอกรหัสผ่าน"
                                            required>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label for="confirmPassword" class="block text-gray-700 mb-2">ยืนยันรหัสผ่าน <span class="text-red-500">*</span></label>
                                        <input type="password" name="confirmPassword" id="confirmPassword"
                                            class="w-full p-2 border border-gray-300 rounded focus:ring focus:ring-blue-200"
                                            placeholder="กรอกรหัสผ่านอีกครั้ง" required>
                                        <p id="passwordError" class="text-red-500 text-sm mt-1 hidden">รหัสผ่านไม่ตรงกัน</p>
                                    </div>
                                </div>

                                <h3 class="font-medium text-gray-700 mt-4 mb-2">ที่อยู่ <span class="text-red-500">*</span></h3>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">บ้านเลขที่ <span class="text-red-500">*</span></label>
                                        <input type="text" name="houseNumber" class="w-full p-2 border rounded"
                                            required>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">หมู่บ้าน <span class="text-red-500">*</span></label>
                                        <select name="village" class="w-full p-2 border rounded">
                                            <% villages.forEach(village=> { %>
                                                <option value="<%= village._id %>">หมู่ <%= village.villageNumber %> -
                                                        <%= village.villageName %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">ถนน <span class="text-red-500">*</span></label>
                                        <input type="text" name="road" class="w-full p-2 border rounded">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">ตำบล <span class="text-red-500">*</span></label>
                                        <input type="text" name="subdistrict" class="w-full p-2 border rounded"
                                            value="ขามป้อม" required>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">อำเภอ <span class="text-red-500">*</span></label>
                                        <input type="text" name="district" class="w-full p-2 border rounded"
                                            value="เปือยน้อย" required>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">จังหวัด <span class="text-red-500">*</span></label>
                                        <input type="text" name="province" class="w-full p-2 border rounded"
                                            value="ขอนแก่น" required>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <label class="block text-gray-700 mb-2">รหัสไปรษณีย์ <span class="text-red-500">*</span></label>
                                    <input type="text" name="postalCode" class="w-full md:w-1/3 p-2 border rounded "
                                        value="40340" required>
                                </div>
                            </div>

                            <!-- ส่วนที่ 2: ข้อมูลสมาชิก (ตัวแทนครอบครัว) -->
                            <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                                <h2 class="text-lg font-semibold mb-4 text-green-700">2. ข้อมูลสมาชิก (ตัวแทนครอบครัว)
                                </h2>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">ชื่อ-สกุล <span class="text-red-500">*</span></label>
                                        <input type="text" name="name" class="w-full p-2 border rounded" required>
                                    </div>


                                    <div class="mb-4">
                                        <label for="idCardNumber" class="block font-medium mb-1">เลขบัตรประชาชน <span class="text-red-500">*</span></label>
                                        <input type="text" name="idCardNumber" id="idCardNumber"
                                            class="w-full p-2 border border-gray-300 rounded focus:ring focus:ring-blue-200"
                                            placeholder="กรอกเลขบัตรประชาชน 13 หลัก เช่น X-XXXX-XXXXX-XX-X" required>
                                        <p id="idCardError" class="text-red-500 text-sm mt-1 hidden">เลขบัตรประชาชนไม่ถูกต้อง</p>
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">วัน/เดือน/ปีเกิด <span class="text-red-500">*</span></label>
                                        <input type="date" name="birthDate" class="w-full p-2 border rounded">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">อาชีพ <span class="text-red-500">*</span></label>
                                        <input type="text" name="occupation" class="w-full p-2 border rounded">
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">อายุ (ปี) <span class="text-red-500">*</span></label>
                                        <input type="text" name="age" class="w-full p-2 border rounded">
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">สัญชาติ <span class="text-red-500">*</span></label>
                                        <input type="text" name="nationality" class="w-full p-2 border rounded"
                                            value="ไทย">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                                    <div>
                                        <label class="block text-gray-700 mb-2">เชื้อชาติ <span class="text-red-500">*</span></label>
                                        <input type="text" name="ethnicity" class="w-full p-2 border rounded"
                                            value="ไทย">
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">ศาสนา <span class="text-red-500">*</span></label>
                                        <input type="text" name="religion" class="w-full p-2 border rounded"
                                            value="พุทธ">
                                    </div>

                                    <div>
                                        <label class="block text-gray-700 mb-2">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
                                        <input type="tel" name="phone" class="w-full p-2 border rounded">
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="block text-gray-700 mb-2">อีเมล <span class="text-red-500">*</span></label>
                                    <input type="email" name="email" class="w-full md:w-1/2 p-2 border rounded">
                                </div>
                            </div>

                            <!-- ส่วนที่ 3: ผู้รับผลประโยชน์ -->
                            <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
                                <h2 class="text-lg font-semibold mb-4 text-green-700">3. เงื่อนไขการรับสวัสดิการ</h2>

                                <div id="beneficiaries-container">
                                    <div class="beneficiary-item border-b pb-4 mb-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                            <div>
                                                <label class="block text-gray-700 mb-2">ชื่อ-สกุล
                                                    ผู้รับผลประโยชน์ <span class="text-red-500">*</span></label>
                                                <input type="text" name="beneficiaries[0][name]"
                                                    class="w-full p-2 border rounded">
                                            </div>

                                            <div>
                                                <label class="block text-gray-700 mb-2">ความสัมพันธ์ <span class="text-red-500">*</span></label>
                                                <input type="text" name="beneficiaries[0][relation]"
                                                    class="w-full p-2 border rounded">
                                            </div>
                                        </div>

                                        <div class="mb-4 text-start">
                                            <label class="block text-gray-700 mb-2">เงื่อนไขการรับเงิน <span class="text-red-500">*</span></label>
                                            <div class="flex flex-col space-y-3">
                                                <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                                    <input type="radio" name="beneficiaries[0][distributionType]"
                                                        value="full" class="mt-0.5" checked>
                                                    <label class="text-gray-700">ให้ได้รับเต็มจำนวน</label>
                                                </div>

                                                <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                                    <input type="radio" name="beneficiaries[0][distributionType]"
                                                        value="equal" class="mt-0.5">
                                                    <label class="text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</label>
                                                </div>

                                                <div class="grid grid-cols-[24px_1fr] items-start gap-2">
                                                    <input type="radio" name="beneficiaries[0][distributionType]"
                                                        value="other" class="mt-0.5">
                                                    <label class="text-gray-700">อื่นๆ</label>
                                                </div>

                                                <div class="pl-[24px]">
                                                    <input type="text" name="beneficiaries[0][distributionDetail]"
                                                        class="p-2 border rounded w-full md:w-1/2"
                                                        placeholder="โปรดระบุ">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button type="button" id="add-beneficiary"
                                    class="text-blue-500 hover:text-blue-700 font-medium flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20"
                                        fill="currentColor">
                                        <path fill-rule="evenodd"
                                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z"
                                            clip-rule="evenodd" />
                                    </svg>
                                    เพิ่มผู้รับผลประโยชน์
                                </button>

                                <div class="mt-6">
                                    <label class="block text-gray-700 mb-2">จำนวนคนที่อาศัยในครัวเรือน (คน) <span class="text-red-500">*</span></label>
                                    <input type="number" name="NumFamilyMembers"
