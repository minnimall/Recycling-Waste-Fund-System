<script>
    // ============================================
    // 1. ฟังก์ชัน Format ข้อมูล
    // ============================================

    function formatThaiID(value) {
        let numbers = value.replace(/\D/g, '').slice(0, 13);
        let formatted = '';
        if(numbers.length > 0) formatted += numbers.substr(0, 1);
        if(numbers.length > 1) formatted += '-' + numbers.substr(1, 4);
        if(numbers.length > 5) formatted += '-' + numbers.substr(5, 5);
        if(numbers.length > 10) formatted += '-' + numbers.substr(10, 2);
        if(numbers.length > 12) formatted += '-' + numbers.substr(12, 1);
        return formatted;
    }

    function formatPhoneNumber(value) {
        let numbers = value.replace(/\D/g, '').slice(0, 10);
        let formatted = '';
        if (numbers.length > 0) {
            if(numbers.length > 0) formatted += numbers.substr(0, 3);
            if(numbers.length > 3) formatted += '-' + numbers.substr(3);
        }
        return formatted;
    }

    function removeFormat(value) {
        return value.replace(/\D/g, '');
    }

    function calculateAge(birthDateValue) {
        if (!birthDateValue) return '';
        const today = new Date();
        const birth = new Date(birthDateValue);
        if (isNaN(birth.getTime())) return '';
        let age = today.getFullYear() - birth.getFullYear();
        const monthDiff = today.getMonth() - birth.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
            age--;
        }
        return age >= 0 ? age : '';
    }

    // ============================================
    // 2. Setup Auto-format Listeners
    // ============================================

    function setupAutoFormatListeners(modalSelector) {
        const idCardInput = document.querySelector(`${modalSelector} input[name="idCardNumber"]`);
        if (idCardInput) {
            idCardInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatThaiID(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        }

        const phoneInput = document.querySelector(`${modalSelector} input[name="phone"]`);
        if (phoneInput) {
            phoneInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatPhoneNumber(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        }
    }

    // ⭐ ฟังก์ชัน auto-format สำหรับ household members (ID Card และ Phone)
    function setupHouseholdAutoFormat() {
        // Format ID Card สำหรับ household members
        const householdIdCards = document.querySelectorAll('.household-id-card');
        householdIdCards.forEach(input => {
            // Remove old listeners
            const newInput = input.cloneNode(true);
            input.parentNode.replaceChild(newInput, input);
            
            newInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatThaiID(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        });

        // Format Phone สำหรับ household members
        const householdPhones = document.querySelectorAll('.household-phone');
        householdPhones.forEach(input => {
            // Remove old listeners
            const newInput = input.cloneNode(true);
            input.parentNode.replaceChild(newInput, input);
            
            newInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatPhoneNumber(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        });
    }

    // ⭐ ฟังก์ชัน auto-format สำหรับ household members ใน Modal แก้ไข
    function setupEditHouseholdAutoFormat() {
        // Format ID Card สำหรับ edit household members
        const editHouseholdIdCards = document.querySelectorAll('.edit-household-id-card');
        editHouseholdIdCards.forEach(input => {
            const newInput = input.cloneNode(true);
            input.parentNode.replaceChild(newInput, input);
            
            newInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatThaiID(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        });

        // Format Phone สำหรับ edit household members
        const editHouseholdPhones = document.querySelectorAll('.edit-household-phone');
        editHouseholdPhones.forEach(input => {
            const newInput = input.cloneNode(true);
            input.parentNode.replaceChild(newInput, input);
            
            newInput.addEventListener('input', function(e) {
                const cursorPosition = e.target.selectionStart;
                const oldLength = e.target.value.length;
                e.target.value = formatPhoneNumber(e.target.value);
                const newLength = e.target.value.length;
                const diff = newLength - oldLength;
                e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
            });
        });
    }

    // ============================================
    // 3. Modal Management
    // ============================================

    function ShowAddFamilyForm() {
        const modal = document.getElementById('ShowAddFamilyForm');
        modal.classList.remove("hidden");
        modal.scrollTo({ top: 0, behavior: 'smooth' });
        setupAutoFormatListeners('#ShowAddFamilyForm');
        setupHouseholdAutoFormat();
    }

    function closeAddFamilyForm() {
        Swal.fire({
            title: "คุณต้องการปิดฟอร์มนี้ใช่หรือไม่",
            text: "หากปิดแล้วข้อมูลที่กรอกจะหายไป",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#00923f",
            cancelButtonColor: "#BEBEBE",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('ShowAddFamilyForm').classList.add("hidden");
                document.getElementById('registerForm').reset();
            }
        });
    }

    function closeEditModal() {
        Swal.fire({
            title: "คุณต้องการปิดฟอร์มนี้ใช่หรือไม่",
            text: "หากปิดแล้วข้อมูลที่แก้ไขจะไม่ถูกบันทึก",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#00923f",
            cancelButtonColor: "#BEBEBE",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก",
