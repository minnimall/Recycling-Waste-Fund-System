                        <option value="บุตร" ${data.relation === 'บุตร' ? 'selected' : ''}>บุตร</option>
                        <option value="บิดา/มารดา" ${data.relation === 'บิดา/มารดา' ? 'selected' : ''}>บิดา/มารดา</option>
                        <option value="ญาติ" ${data.relation === 'ญาติ' ? 'selected' : ''}>ญาติ</option>
                        <option value="อื่นๆ" ${data.relation === 'อื่นๆ' ? 'selected' : ''}>อื่นๆ</option>
                    </select>
                </div>
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-3">เงื่อนไขการรับเงินฌาปนกิจ</label>
                <div class="space-y-2">
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="full" ${data.distributionType === 'full' ? 'checked' : ''} class="w-4 h-4 text-green-500">
                        <span class="text-sm text-gray-700">ให้ได้รับเต็มจำนวน</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="equal" ${!data.distributionType || data.distributionType === 'equal' ? 'checked' : ''} class="w-4 h-4 text-green-500">
                        <span class="text-sm text-gray-700">ให้ได้รับส่วนแบ่งเท่ากัน</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="radio" name="beneficiaries[${index}][distributionType]" value="other" ${data.distributionType === 'other' ? 'checked' : ''} class="w-4 h-4 text-green-500">
                        <span class="text-sm text-gray-700">อื่นๆ</span>
                    </label>
                    <div class="pl-7">
                        <input type="text" name="beneficiaries[${index}][distributionDetail]" value="${data.distributionDetail || ''}" 
                            class="px-4 py-3 border border-gray-300 rounded-lg w-full md:w-1/2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition" 
                            placeholder="โปรดระบุ">
                    </div>
                </div>
            </div>
        `;

        container.appendChild(beneficiaryItem);

        if (index > 0) {
            const removeBtn = beneficiaryItem.querySelector('.remove-edit-beneficiary');
            removeBtn.addEventListener('click', function () {
                this.closest('.beneficiary-item').remove();
                updateEditBeneficiaryIndexes();
            });
        }
        
        setupEditHouseholdAutoFormat();
        
        const rawBirthInput = beneficiaryItem.querySelector(`input[name="beneficiaries[${index}][birthDate]"]`);
        const ageInput = beneficiaryItem.querySelector(`input[name="beneficiaries[${index}][age]"]`);
        if (rawBirthInput && ageInput) {
            const newBirthInput = rawBirthInput.cloneNode(true);
            rawBirthInput.parentNode.replaceChild(newBirthInput, rawBirthInput);
            
            newBirthInput.addEventListener('change', function() {
                ageInput.value = calculateAge(this.value);
            });
        }
    }

    function updateEditBeneficiaryIndexes() {
        const beneficiaryItems = document.querySelectorAll('#edit-beneficiaries-container .beneficiary-item');
        beneficiaryItems.forEach((item, i) => {
            const inputs = item.querySelectorAll('input[name^="beneficiaries"], select[name^="beneficiaries"]');
            inputs.forEach(input => {
                const name = input.getAttribute('name');
                input.setAttribute('name', name.replace(/beneficiaries\[\d+\]/, `beneficiaries[${i}]`));
            });

            const title = item.querySelector('h3');
            if (title) {
                title.textContent = `สมาชิกในครัวเรือน ${i + 1}`;
            }
        });
    }

    document.getElementById('add-edit-beneficiary')?.addEventListener('click', function () {
        const container = document.getElementById('edit-beneficiaries-container');
        const beneficiaryCount = container.getElementsByClassName('beneficiary-item').length;
        addEditBeneficiary(beneficiaryCount, {});
    });

    // ============================================
    // 6. ฟังก์ชันลบข้อมูล
    // ============================================

    function showModalDelete(index, familyId, familyAccountNumber, familyName) {
        Swal.fire({
            title: `ลบสมาชิก "${familyName}" หรือไม่?`,
            html: `<p class="text-gray-600 mb-2">เลขบัญชี ${familyAccountNumber}</p>`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6b7280",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ยืนยัน"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'กำลังลบข้อมูล...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                fetch(`/employee/memberDelete/${familyId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบข้อมูลสำเร็จ',
                            text: data.message || 'ข้อมูลสมาชิกถูกลบเรียบร้อยแล้ว',
                            confirmButtonColor: '#28a745',
                            timer: 2000
                        }).then(() => { window.location.reload(); });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'ลบข้อมูลไม่สำเร็จ',
                            text: data.message || 'เกิดข้อผิดพลาดในการลบข้อมูล',
                            confirmButtonColor: '#d33'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้',
                        confirmButtonColor: '#d33'
                    });
                });
            }
        });
    }

    // ============================================
    // 7. ⭐ ฟังก์ชันเปลี่ยนตัวแทนครัวเรือน - รองรับ Schema ใหม่
    // ============================================

    async function showChangeRepresentativeModal(familyId) {
        try {
            Swal.fire({
                title: 'กำลังโหลดข้อมูล...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            const response = await fetch(`/employee/member/${familyId}/representatives`);
            const result = await response.json();
            Swal.close();

            if (!result.success) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: result.error || 'ไม่สามารถดึงข้อมูลได้',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            const { currentRepresentative, householdMembers, formerRepresentatives } = result.data;

            const modal = document.getElementById('changeRepresentativeModal');
            modal.classList.remove('hidden');

            // แสดงข้อมูลตัวแทนปัจจุบัน
            document.getElementById('currentRepInfo').innerHTML = `
                <div>
                    <label class="block text-gray-600 text-sm">ชื่อ-สกุล</label>
                    <p class="font-medium">${currentRepresentative.name}</p>
                </div>
                <div>
                    <label class="block text-gray-600 text-sm">เลขบัตรประชาชน</label>
                    <p class="font-medium">${formatThaiID(currentRepresentative.idCardNumber)}</p>
                </div>
                <div>
                    <label class="block text-gray-600 text-sm">เบอร์โทร</label>
                    <p class="font-medium">${currentRepresentative.phone ? formatPhoneNumber(currentRepresentative.phone) : '-'}</p>
                </div>
            `;

            // ประกาศ membersData ก่อนใช้งาน
            const membersData = {};

            const beneficiarySelect = document.getElementById('beneficiarySelect');
            beneficiarySelect.innerHTML = '<option value="">-- เลือกสมาชิกหรือกรอกข้อมูลใหม่ --</option>';

            // กลุ่มที่ 1 — สมาชิกที่มีชีวิต
            if (householdMembers.length > 0) {
                householdMembers.forEach((member) => {
                    const option = document.createElement('option');
                    option.value = member.index;
                    option.dataset.type = 'household';
                    option.textContent = `${member.name}`;
                    beneficiarySelect.appendChild(option); // append ตรงๆ ไม่ผ่าน group
                    membersData[member.index] = member;
                });
            }

            // กลุ่มที่ 2 — อดีตตัวแทน
            if (formerRepresentatives && formerRepresentatives.length > 0) {
                const formerGroup = document.createElement('optgroup');
                formerGroup.label = '🔄 อดีตตัวแทนครัวเรือน';
                formerRepresentatives.forEach((member, i) => {
                    const option = document.createElement('option');
                    option.value = `former_${i}`;
                    option.dataset.type = 'former';
                    option.textContent = `${member.name} (อดีตตัวแทน)`;
                    formerGroup.appendChild(option);
                    membersData[`former_${i}`] = member; // เก็บข้อมูล
                });
                beneficiarySelect.appendChild(formerGroup);
            }

            document.getElementById('changeFamilyId').value = familyId;

            // ลบ event listener เก่าออกก่อน ป้องกัน listener ซ้อนกัน
            const newSelect = beneficiarySelect.cloneNode(true);
            beneficiarySelect.parentNode.replaceChild(newSelect, beneficiarySelect);

            newSelect.addEventListener('change', function () {
                const selectedValue = this.value;

                if (selectedValue !== '') {
                    const member = membersData[selectedValue];

                    document.getElementById('newRepName').value = member.name || '';
                    document.getElementById('newRepIdCard').value = formatThaiID(member.idCardNumber || '');
                    document.getElementById('newRepPhone').value = formatPhoneNumber(member.phone || '');
                    document.getElementById('newRepBirthDate').value = member.birthDate
                        ? new Date(member.birthDate).toISOString().split('T')[0]
                        : '';
                    document.getElementById('newRepAge').value = member.age || '';
                    document.getElementById('newRepOccupation').value = member.occupation || '';
                    document.getElementById('newRepNationality').value = member.nationality || 'ไทย';
                    document.getElementById('newRepEthnicity').value = member.ethnicity || 'ไทย';
                    document.getElementById('newRepReligion').value = member.religion || 'พุทธ';

                    // เก็บทั้ง value และ type แยกกัน
                    document.getElementById('selectedBeneficiaryIndex').value = selectedValue;
                    document.getElementById('selectedBeneficiaryType').value = this.options[this.selectedIndex].dataset.type;
                } else {
                    document.getElementById('newRepName').value = '';
                    document.getElementById('newRepIdCard').value = '';
                    document.getElementById('newRepPhone').value = '';
                    document.getElementById('newRepBirthDate').value = '';
                    document.getElementById('newRepAge').value = '';
                    document.getElementById('newRepOccupation').value = '';
                    document.getElementById('newRepNationality').value = 'ไทย';
                    document.getElementById('newRepEthnicity').value = 'ไทย';
                    document.getElementById('newRepReligion').value = 'พุทธ';

                    document.getElementById('selectedBeneficiaryIndex').value = '';
                    document.getElementById('selectedBeneficiaryType').value = '';
                }
            });

            setupAutoFormatListeners('#changeRepresentativeModal');

        } catch (error) {
            console.error('Error loading representatives:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: 'ไม่สามารถโหลดข้อมูลได้',
                confirmButtonColor: '#d33'
            });
        }
    }

    // Submit Form เปลี่ยนตัวแทน
    document.getElementById('changeRepresentativeForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const familyId = document.getElementById('changeFamilyId').value;
        const beneficiaryIndex = document.getElementById('selectedBeneficiaryIndex').value;
        const beneficiaryType = document.getElementById('selectedBeneficiaryType').value;

        const idCardValue = removeFormat(document.getElementById('newRepIdCard').value);
        const phoneValue = removeFormat(document.getElementById('newRepPhone').value);

        const formData = {
            memberIndex: beneficiaryType === 'household' ? parseInt(beneficiaryIndex) : null,
            beneficiaryType: beneficiaryType,
            newRepresentativeData: {
                name: document.getElementById('newRepName').value,
                idCardNumber: idCardValue,
                phone: phoneValue,
                birthDate: document.getElementById('newRepBirthDate').value,
                age: document.getElementById('newRepAge').value,
                occupation: document.getElementById('newRepOccupation').value,
                nationality: document.getElementById('newRepNationality').value,
                ethnicity: document.getElementById('newRepEthnicity').value,
                religion: document.getElementById('newRepReligion').value
            }
        };

        const result = await Swal.fire({
            title: 'ยืนยันการเปลี่ยนตัวแทน?',
            html: `
                <p class="text-gray-700 mb-2">ระบบจะดำเนินการ:</p>
                <ul class="text-left text-sm text-gray-700 space-y-1 ml-6">
                    <li>• แต่งตั้งตัวแทนครัวเรือนคนใหม่</li>
                    <li>• ตัวแทนเดิมจะถูกย้ายเป็นสมาชิกในครัวเรือน</li>
                </ul>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก',
            reverseButtons: true
        });

        if (!result.isConfirmed) return;

        Swal.fire({
            title: 'กำลังดำเนินการ...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        try {
            const response = await fetch(`/employee/member/${familyId}/change-representative`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'เปลี่ยนตัวแทนสำเร็จ',
                    text: data.message,
                    confirmButtonColor: '#28a745',
                    timer: 2000
                }).then(() => { window.location.reload(); });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: data.message || 'ไม่สามารถเปลี่ยนตัวแทนได้',
                    confirmButtonColor: '#d33'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้',
                confirmButtonColor: '#d33'
            });
        }
    });

    // ============================================
    // 8. Form Validation
    // ============================================

    document.addEventListener("DOMContentLoaded", () => {
        const password = document.getElementById("password");
        const confirmPassword = document.getElementById("confirmPassword");
        const passwordError = document.getElementById("passwordError");
        const registerForm = document.querySelector("#registerForm");

        if (password && confirmPassword && registerForm) {
            function checkPasswordMatch() {
                if (confirmPassword.value === "") {
                    confirmPassword.classList.remove("border-red-500", "focus:ring-red-300");
                    passwordError.classList.add("hidden");
                    return true;
                }
                if (password.value !== confirmPassword.value) {
                    confirmPassword.classList.add("border-red-500", "focus:ring-red-300");
                    passwordError.classList.remove("hidden");
                    return false;
                } else {
                    confirmPassword.classList.remove("border-red-500", "focus:ring-red-300");
                    passwordError.classList.add("hidden");
                    return true;
                }
            }

            confirmPassword.addEventListener("input", checkPasswordMatch);
            password.addEventListener("input", checkPasswordMatch);

            registerForm.addEventListener("submit", (e) => {
                if (!checkPasswordMatch()) {
                    e.preventDefault();
                    Swal.fire({
                        icon: "error",
                        title: "รหัสผ่านไม่ตรงกัน",
                        text: "กรุณากรอกให้ตรงกันทั้งสองช่อง",
                        confirmButtonColor: "#ef4444"
                    });
                } else {
                    // เอา Format ออกก่อนส่งฟอร์ม - สมาชิกตัวแทน
                    const idCardInput = document.getElementById('idCardNumber');
                    const phoneInput = document.getElementById('registerPhone');
                    
                    if (idCardInput) {
                        idCardInput.value = removeFormat(idCardInput.value);
                    }
                    if (phoneInput) {
                        phoneInput.value = removeFormat(phoneInput.value);
                    }
                    
                    // ⭐ เอา Format ออกจาก household members ทั้งหมด
                    const householdIdCards = document.querySelectorAll('.household-id-card');
                    householdIdCards.forEach(input => {
                        if (input.value) {
                            input.value = removeFormat(input.value);
                        }
                    });
                    
                    const householdPhones = document.querySelectorAll('.household-phone');
                    householdPhones.forEach(input => {
                        if (input.value) {
                            input.value = removeFormat(input.value);
                        }
                    });
                }
            });
        }

        // เอา Format ออกก่อนส่งฟอร์มแก้ไข
        const editForm = document.getElementById('editFamilyForm');
        if (editForm) {
            editForm.addEventListener('submit', function(e) {
                const idCardInput = document.getElementById('editIdCard');
                const phoneInput = document.getElementById('editPhone');
                
                if (idCardInput) {
                    idCardInput.value = removeFormat(idCardInput.value);
                }
                if (phoneInput) {
                    phoneInput.value = removeFormat(phoneInput.value);
                }
                
                // ⭐ เอา Format ออกจาก household members ทั้งหมด
                const editHouseholdIdCards = document.querySelectorAll('.edit-household-id-card');
                editHouseholdIdCards.forEach(input => {
                    if (input.value) {
                        input.value = removeFormat(input.value);
                    }
                });
                
                const editHouseholdPhones = document.querySelectorAll('.edit-household-phone');
                editHouseholdPhones.forEach(input => {
                    if (input.value) {
                        input.value = removeFormat(input.value);
                    }
                });
            });
        }

        // Setup auto-format สำหรับ ID Card และ Phone ในฟอร์มลงทะเบียน
        const idInput = document.getElementById("idCardNumber");
        if (idInput) {
            idInput.addEventListener('input', (e) => {
                e.target.value = formatThaiID(e.target.value);
            });
        }

        const registerPhone = document.getElementById("registerPhone");
        if (registerPhone) {
            registerPhone.addEventListener('input', (e) => {
                e.target.value = formatPhoneNumber(e.target.value);
            });
        }

        // คำนวณอายุ — ตัวแทนครัวเรือน (ฟอร์มลงทะเบียน)
        const registerBirthDate = document.querySelector('#registerForm input[name="birthDate"]');
        const registerAge = document.querySelector('#registerForm input[name="age"]');
        if (registerBirthDate && registerAge) {
            registerBirthDate.addEventListener('change', function() {
                registerAge.value = calculateAge(this.value);
            });
        }

        // คำนวณอายุ — สมาชิกคนแรก (index 0) ในฟอร์มลงทะเบียน
        const firstMemberBirth = document.querySelector('input[name="beneficiaries[0][birthDate]"]');
        const firstMemberAge = document.querySelector('input[name="beneficiaries[0][age]"]');
        if (firstMemberBirth && firstMemberAge) {
            firstMemberBirth.addEventListener('change', function() {
                firstMemberAge.value = calculateAge(this.value);
            });
        }
    });
</script>

</html>