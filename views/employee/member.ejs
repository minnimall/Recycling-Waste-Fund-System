<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/member.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="container mx-auto p-6">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h1 class="text-2xl font-bold mb-4">ลงทะเบียนครัวเรือนและสมาชิก</h1>
            
            <!-- ฟอร์มลงทะเบียนครัวเรือน -->
            <form action="/employee/household/register" method="POST" class="space-y-4">
                <!-- ข้อมูลตัวแทนครัวเรือน -->
                <div>
                    <label class="block font-medium">ชื่อ-สกุล ตัวแทน</label>
                    <input type="text" name="representativeName" required class="w-full p-2 border rounded">
                </div>
                <div>
                    <label class="block font-medium">บัตรประชาชน</label>
                    <input type="text" name="idCard" required class="w-full p-2 border rounded">
                </div>
                
                <!-- ข้อมูลครัวเรือน -->
                <div>
                    <label class="block font-medium">ชื่อครัวเรือน</label>
                    <input type="text" name="householdName" required class="w-full p-2 border rounded">
                </div>
                <div>
                    <label class="block font-medium">ที่อยู่</label>
                    <input type="text" name="address" required class="w-full p-2 border rounded">
                </div>
                <div>
                    <label class="block font-medium">หมู่บ้าน</label>
                    <select name="village" required class="w-full p-2 border rounded">
                        <option value="">เลือกหมู่บ้าน</option>
                        <option value="1">หมู่ที่ 1</option>
                        <option value="2">หมู่ที่ 2</option>
                    </select>
                </div>
                <div>
                    <label class="block font-medium">ประเภทครัวเรือน</label>
                    <select name="householdType" required class="w-full p-2 border rounded">
                        <option value="household">บ้าน</option>
                        <option value="school">โรงเรียน</option>
                        <option value="municipality">อปท.</option>
                        <option value="community">ชุมชน</option>
                    </select>
                </div>

                <div>
                    <label class="block font-medium">เงื่อนไขการรับเงินสวัสดิการขยะประกันชีวิต (หากข้าพเจ้าถึงแก่กรรม) ขอมอบให้</label>
                    
                </div>
                
                <!-- เพิ่มสมาชิกในครัวเรือน -->
                <div id="members">
                    <h2 class="text-lg font-bold">สมาชิกในครัวเรือน</h2>
                    <div class="member-entry space-y-2">
                        <input type="text" name="members[]" placeholder="ชื่อ-สกุล" class="w-full p-2 border rounded">
                    </div>
                </div>
                <button type="button" id="addMember" class="bg-blue-500 text-white px-4 py-2 rounded">เพิ่มสมาชิก</button>
                
                <!-- เงื่อนไขการรับเงิน -->
                <div>
                    <select name="paymentCondition" required class="w-full p-2 border rounded">
                        <option value="full">ได้รับเงินเต็มจำนวน</option>
                        <option value="shared">ได้รับส่วนแบ่งเท่ากัน</option>
                        <option value="other">อื่นๆ</option>
                    </select>
                </div>
                
                <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded w-full">ลงทะเบียน</button>
            </form>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>
</body>
<script>
    document.getElementById('addMember').addEventListener('click', function() {
        const memberDiv = document.createElement('div');
        memberDiv.classList.add('member-entry', 'space-y-2');
        memberDiv.innerHTML = `<input type="text" name="members[]" placeholder="ชื่อ-สกุล" class="w-full p-2 border rounded">`;
        document.getElementById('members').appendChild(memberDiv);
    });
</script>
</html>
