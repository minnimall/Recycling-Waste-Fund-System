<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/member.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="content">
        <div class="content-header">
            <h1 class="text-2xl font-bold">สมาชิกกองทุนขยะรีไซเคิล</h1>
            <div class="add-media" onclick="openModal()">เพิ่มสมาชิกกองทุนขยะ</div>
        </div>
        <div class="emp-container">
            <div class="table-con">
                <div class="flex items-center gap-4 p-2 rounded-lg w-full max-w-2xl">
                    <!-- ช่องค้นหา -->
                    <div class="flex items-center bg-white p-2 rounded-lg shadow-sm w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 ml-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm6.707 10.293a1 1 0 0 1-1.414 0l-2.827-2.828A6 6 0 1 1 8 2a6 6 0 0 1 4.293 10.293l2.828 2.828a1 1 0 0 1 0 1.414z" clip-rule="evenodd"/>
                        </svg>
                        <input type="text" name="search" placeholder="ค้นหาสมาชิก" 
                            class="bg-transparent w-full p-2 outline-none text-gray-700">
                    </div>
                
                    <!-- ตัวกรองหมู่บ้าน -->
                    <select class="bg-white p-2 rounded-lg shadow-sm border border-gray-300 text-gray-700">
                        <option value="">เลือกหมู่บ้าน</option>
                        <option value="village1">หมู่ 1</option>
                        <option value="village2">หมู่ 2</option>
                        <option value="village3">หมู่ 3</option>
                        <option value="village4">หมู่ 4</option>
                        <option value="village5">หมู่ 5</option>
                        <option value="village6">หมู่ 6</option>
                        <option value="village7">หมู่ 7</option>
                        <option value="village8">หมู่ 8</option>
                        <option value="village9">หมู่ 9</option>
                        <option value="village10">หมู่ 10</option>
                    </select>
                </div>                                
                <table class="table-auto">
                    <thead>
                        <tr>
                            <th class="table-emp-id">บ้านเลขที่</th>
                            <th class="table-emp-village">หมู่ที่</th>
                            <th class="table-emp-firstname">ชื่อจริง</th>
                            <th class="table-emp-lastname">นามสกุล</th>
                            <th class="table-emp-tel">เบอร์โทรศัพท์</th>
                            <th class="table-emp-delete">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="table-emp-id">t</td>
                            <td class="table-emp-village">t</td>
                            <td class="table-emp-firstname">t</td>
                            <td class="table-emp-lastname">t</td>
                            <td class="table-emp-tel">t</td>
                            <td>
                                <button type="button" class="edit-btn">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="delete-btn">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>                    
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>
</body>
</html>
