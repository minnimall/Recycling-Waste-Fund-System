<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_employee/member.css">
        <link rel="stylesheet" href="/style_employee/res_req.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>
            <script>
                // เช็คข้อความที่ส่งมาจาก URL
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745', // สีเขียวสำหรับความสำเร็จ
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด!',
                        text: errorMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#d33',
                        timer: 3000
                    });
                }
            </script>

            <div class="content bg-gray-50 min-screen">
                <div class="mt-4 mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                            สมาชิกกองทุนขยะรีไซเคิล</h1>
                        <p class="text-gray-600">ข้อมูลสมาชิกกองทุนขยะรีไซเคิลทั้งหมด</p>
                    </div>

                    <div>
                        <button type="button"
                            class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300"
                            onclick="ShowAddFamilyForm()">เพิ่มสมาชิก</button>
                    </div>
                </div>


                <!-- Search and Filter Section -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <form action="" method="GET">
                        <div class="flex flex-col md:flex-row gap-4">
                            <div class="flex-1">
                                <div class="relative">
                                    <input type="text" id="search" name="familyName"
                                        value="<%= query.familyName || '' %>" placeholder="ชื่อครัวเรือน..."
                                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <div class="absolute left-3 top-2.5 text-gray-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-1 md:flex-1">
                                <div class="relative">
                                    <input type="text" id="searchAccountNumber" name="AccountNumber"
                                        value="<%= query.AccountNumber || '' %>" placeholder="เลขบัญชี..."
                                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <div class="absolute left-3 top-2.5 text-gray-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="md:w-64">
                                <select name="village"
                                    class="w-full py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <option value="">เลือกหมู่บ้าน</option>
                                    <% villages.forEach(v=> { %>
                                        <option value="<%= v._id %>" <%=query.village==v._id ? 'selected' : '' %>><%=
                                                v.villageName %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <div class="md:w-64">
                                <select name="Type"
                                    class="w-full py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                                    <option value="">เลือกประเภท</option>
                                    <option value="household" <%=query.Type==='household' ? 'selected' : '' %>>บ้าน
                                    </option>
                                    <option value="school" <%=query.Type==='school' ? 'selected' : '' %>>โรงเรียน
                                    </option>
                                    <option value="municipality" <%=query.Type==='municipality' ? 'selected' : '' %>
                                        >อปท.</option>
                                    <option value="community" <%=query.Type==='community' ? 'selected' : '' %>>ชุมชน
                                    </option>>
                                    <option value="temple" <%=query.Type==='temple' ? 'selected' : '' %>>วัด</option>>
                                </select>
                            </div>
                            <div>
                                <button
                                    class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                    <i class="fas fa-search mr-2"></i>ค้นหา
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                        <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                            จำนวนสมาชิกทั้งหมด <span class="text-blue-600 text-base font-normal">
                                <%= totalFamilies %> รายการ
                            </span>
                        </h2>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        ลำดับที่</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        เลขบัญชี</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ชื่อครัวเรือน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ชื่อบัญชีครัวเรือน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ที่อยู่</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        หมู่บ้าน</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        จำนวนสมาชิก</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ประเภท</th>
                                    <th
                                        class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                        จัดการ</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (allFamilies.length> 0) { %>
                                    <% allFamilies.forEach((family, index)=> { %>
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-4 py-3 text-sm whitespace-nowrap text-center">
                                                <%= ((pagination.currentPage - 1) * pagination.itemsPerPage) + index + 1 %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.AccountNumber %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.familyName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.AccountName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <a href="#" onclick='ShowLocation(<%= JSON.stringify(family) %>)'
                                                    class="text-blue-500 hover:text-blue-700 hover:underline transition-colors">
                                                    ข้อมูลที่อยู่ของครัวเรือน
                                                </a>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <%= family.village.villageName %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap text-center">
                                                <%= family.NumFamilyMembers %>
                                            </td>
                                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                                <span class="px-2 py-1 rounded-full text-sm font-medium">
                                                    <%= family.typeThai %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 whitespace-nowrap text-center">
                                                <div class="flex items-center justify-center gap-2"> <button onclick="showEditModal('<%= family._id %>')" 
                                                        class="h-8 w-8 rounded bg-blue-500 text-white hover:bg-blue-600 transition-colors flex items-center justify-center"
                                                        title="แก้ไข">
                                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                    </button>

                                                    <button onclick="showChangeRepresentativeModal('<%= family._id %>')" 
                                                        class="h-8 w-8 rounded bg-purple-500 text-white hover:bg-purple-600 transition-colors flex items-center justify-center"
                                                        title="เปลี่ยนตัวแทนครัวเรือน">
                                                        <i class="fa-solid fa-user-check text-xs"></i>
                                                    </button>

                                                    <button onclick="showModalDelete('<%= ((pagination.currentPage - 1) * pagination.itemsPerPage) + index + 1 %>', '<%= family._id %>','<%= family.AccountNumber %>','<%= family.familyName %>')" 
                                                        class="h-8 w-8 rounded bg-red-500 text-white hover:bg-red-600 transition-colors flex items-center justify-center"
                                                        title="ลบ">
                                                        <i class="fa-solid fa-trash text-xs"></i>
                                                    </button>
                                                    
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center py-4 text-gray-500">
                                                        -ไม่พบข้อมูลสมาชิก -</td>
                                                </tr>
                                            <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination Controls -->
                    <% if (pagination) { %>
                    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t pt-4">
                        <div class="text-sm text-gray-700">
                            แสดง <%= ((pagination.currentPage - 1) * pagination.itemsPerPage) + 1 %>
                            ถึง <%= Math.min(pagination.currentPage * pagination.itemsPerPage, pagination.totalItems) %>
                            จาก <%= pagination.totalItems %> รายการ
                        </div>

                        <div class="flex items-center gap-2">
                            <!-- ปุ่มหน้าแรก -->
                            <% if (pagination.currentPage > 1) { %>
                            <a href="?<%= new URLSearchParams({...query, page: 1}).toString() %>"
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                «
                            </a>
                            <% } %>

                            <!-- ปุ่มหน้าก่อนหน้า -->
                            <% if (pagination.hasPrevPage) { %>
                            <a href="?<%= new URLSearchParams({...query, page: pagination.currentPage - 1}).toString() %>"
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                ‹
                            </a>
                            <% } else { %>
                            <button disabled class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">‹</button>
                            <% } %>

                            <!-- เลขหน้า -->
                            <%
                            const maxPagesToShow = 5;
                            let startPage = Math.max(1, pagination.currentPage - Math.floor(maxPagesToShow / 2));
                            let endPage = Math.min(pagination.totalPages, startPage + maxPagesToShow - 1);
                            if (endPage - startPage < maxPagesToShow - 1) {
                                startPage = Math.max(1, endPage - maxPagesToShow + 1);
                            }
                            if (startPage > 1) { %>
                                <span class="px-2 text-gray-500">...</span>
                            <% }
                            for (let i = startPage; i <= endPage; i++) { %>
                                <% if (i === pagination.currentPage) { %>
                                <button class="px-4 py-2 rounded-md bg-green-600 text-white text-sm font-medium"><%= i %></button>
                                <% } else { %>
                                <a href="?<%= new URLSearchParams({...query, page: i}).toString() %>"
                                    class="px-4 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                    <%= i %>
                                </a>
                                <% } %>
                            <% }
                            if (endPage < pagination.totalPages) { %>
                                <span class="px-2 text-gray-500">...</span>
                            <% } %>

                            <!-- ปุ่มหน้าถัดไป -->
                            <% if (pagination.hasNextPage) { %>
                            <a href="?<%= new URLSearchParams({...query, page: pagination.currentPage + 1}).toString() %>"
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                ›
                            </a>
                            <% } else { %>
                            <button disabled class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">›</button>
                            <% } %>

                            <!-- ปุ่มหน้าสุดท้าย -->
                            <% if (pagination.currentPage < pagination.totalPages) { %>
                            <a href="?<%= new URLSearchParams({...query, page: pagination.totalPages}).toString() %>"
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                »
                            </a>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- modal ฟอร์มลงทะเบียนครัวเรือน -->
            <div id="ShowAddFamilyForm" class="hidden fixed inset-0 z-50 bg-black bg-opacity-30">
                <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl px-4 max-h-[90vh] overflow-y-auto">
                    <div class="bg-white rounded-xl shadow-lg p-8 space-y-6">
                        
                        <div class="flex items-center justify-between border-b pb-4">
                            <div class="flex items-center space-x-3">
                                <ion-icon name="document-text-outline" class="text-green-500 text-2xl"></ion-icon>
                                <span class="text-xl font-semibold text-gray-800">สมัครเข้าร่วมกองทุนขยะรีไซเคิล</span>
                            </div>
                            <button type="button" onclick="closeAddFamilyForm()" class="text-gray-400 hover:text-gray-600 transition">
                                <ion-icon name="close-outline" class="text-2xl"></ion-icon>
                            </button>
                        </div>

                        <form action="/employee/memberRegister" method="POST" class="space-y-6" id="registerForm">

                            <!-- ส่วนที่ 1: ข้อมูลครัวเรือน -->
                            <div class="bg-gray-50 p-5 rounded-lg border border-gray-200">
                                <h2 class="text-base font-semibold mb-4 flex items-center space-x-2">
                                    <span>1. ข้อมูลครัวเรือน</span>
                                </h2>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ชื่อครัวเรือน <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="familyName" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition" 
                                            required>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ประเภทครัวเรือน <span class="text-red-500">*</span>
                                        </label>
                                        <select name="Type" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition" 
                                            required>
                                            <option value="household">บ้านเรือน</option>
                                            <option value="school">โรงเรียน</option>
                                            <option value="municipality">อปท.</option>
                                            <option value="community">ชุมชน</option>
                                            <option value="temple">วัด</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ชื่อผู้ใช้ (Username) <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="username" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition" 
                                            required>
                                        <p class="text-xs text-gray-500 mt-1">ชื่อผู้ใช้ต้องมี 5-20 ตัวอักษร และไม่มีอักขระพิเศษ</p>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            รหัสผ่าน (ตัวเลข 6-8 หลัก) <span class="text-red-500">*</span>
                                        </label>
                                        <input type="password" name="password" id="password"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition" 
                                            placeholder="กรอกรหัสผ่าน"
                                            required>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ยืนยันรหัสผ่าน <span class="text-red-500">*</span>
                                        </label>
                                        <input type="password" name="confirmPassword" id="confirmPassword"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                            placeholder="กรอกรหัสผ่านอีกครั้ง" required>
                                        <p id="passwordError" class="text-red-500 text-xs mt-1 hidden">รหัสผ่านไม่ตรงกัน</p>
                                    </div>
                                </div>

                                <h3 class="text-sm font-medium text-gray-700 mt-6 mb-3 flex items-center space-x-2">
                                    <ion-icon name="location-outline" class="text-base"></ion-icon>
                                    <span>ที่อยู่ <span class="text-red-500">*</span></span>
                                </h3>
                                
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            บ้านเลขที่ <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="houseNumber" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                            required>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            หมู่บ้าน <span class="text-red-500">*</span>
                                        </label>
                                        <select name="village" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition">
                                            <% villages.forEach(village => { %>
                                                <option value="<%= village._id %>">หมู่ <%= village.villageNumber %> - <%= village.villageName %></option>
                                            <% }); %>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ถนน
                                        </label>
                                        <input type="text" name="road" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            ตำบล <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="subdistrict" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                            value="ขามป้อม" required>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            อำเภอ <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="district" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                            value="เปือยน้อย" required>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            จังหวัด <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" name="province" 
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                            value="ขอนแก่น" required>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        รหัสไปรษณีย์ <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" name="postalCode" 
                                        class="w-full md:w-1/3 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500 transition"
                                        value="40340" required>
                                </div>
                            </div>

                            <!-- ส่วนที่ 2: ข้อมูลสมาชิก (ตัวแทนครอบครัว) -->
                            <div class="bg-gray-50 p-5 rounded-lg border border-gray-200">
                                <h2 class="text-base font-semibold mb-4 flex items-center space-x-2">
