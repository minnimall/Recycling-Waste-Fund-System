<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_employee/funeral-assistance.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
        <!-- Leaflet -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

        <!-- Leaflet Control Geocoder -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
        <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

        <style>
            .leaflet-container {
                height: 400px;
                border-radius: 0.5rem;
            }
            
            @media (min-width: 768px) {
                .leaflet-container {
                    height: 500px;
                }
            }
        </style>
</head>

<body class="bg-gray-50">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>

            <script>
                // แสดง popup message จาก query string
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <div class="content bg-gray-50 min-screen">
                <!-- Page Header -->
                <div class="mx-4 mb-3 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                                การจัดการจุดรับซื้อขยะ
                            </h1>
                            <p class="text-gray-600 mt-2">ระบบจัดการจุดรับซื้อขยะสำหรับครัวเรือนในชุมชน</p>
                        </div>
                        <a href="/employee/wastePoint/create" onclick="" class="bg-green-700 text-white px-4 py-2 rounded-md hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200 flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            เพิ่มจุดรับซื้อ
                        </a>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="flex-1 overflow-auto p-6">
                    <div class="mx-auto space-y-6">
                        <!-- Map -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">แผนที่จุดรับซื้อขยะ</h3>
                            <div id="map" class="leaflet-container z-10"></div>
                        </div>

                        <!-- Points List -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800 mb-2 sm:mb-0">รายการจุดรับซื้อขยะ</h3>
                                <div class="flex items-center space-x-2">
                                    <span class="text-sm text-gray-600">ทั้งหมด:</span>
                                    <span id="total-points"
                                        class="bg-primary-100 text-primary-800 px-2 py-1 rounded-full text-sm font-medium">0</span>
                                </div>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                ชื่อจุดรับซื้อ</th>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">
                                                ผู้รับผิดชอบ</th>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                ประเภท</th>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                เวลาทำการ</th>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                สถานะ</th>
                                            <th
                                                class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                จัดการ</th>
                                        </tr>
                                    </thead>
                                    <tbody id="points-table-body" class="bg-white divide-y divide-gray-200">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


</body>
<script>
    let map;
    let markers = [];
    const wastePoints = <%- JSON.stringify(wastePoints) %>; // โหลดข้อมูลจาก MongoDB

    function initMap() {
        map = L.map("map").setView([13.7563, 100.5018], 10);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "© OpenStreetMap contributors",
        }).addTo(map);
    }

    function updatePointsList() {
        const tbody = document.getElementById("points-table-body");
        const totalPoints = document.getElementById("total-points");
        tbody.innerHTML = "";
        totalPoints.textContent = wastePoints.length;

        wastePoints.forEach((point, index) => {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td class="px-4 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">${point.wastePointName}</div>
                    <div class="text-sm text-gray-500 md:hidden">${point.type || "-"}</div>
                </td>

                <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                    <div class="text-sm text-gray-900">${point.responsible}</div>
                    <div class="text-sm text-gray-500">${point.phone}</div>
                </td>
                
                <td class="px-4 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900">
                        ${
                        point.type === 'bank' ? 'ธนาคารขยะ' :
                        point.type === 'center' ? 'ศูนย์รับซื้อขยะรีไซเคิล' :
                        point.type === 'community' ? 'จุดรับซื้อชุมชน' :
                        point.type === 'mobile' ? 'รถรับซื้อเคลื่อนที่' : 'ไม่ระบุ' }
                    </div>
                    <div class="text-sm text-gray-500">${point.type}</div>
                </td>

                <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                    <div class="text-sm text-gray-900">${point.openTime} น. - ${point.closeTime} น.</div>
                </td>

                <td class="px-4 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                        point.isOpen ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
                    }">
                        ${point.isOpen ? "เปิดบริการ" : "ปิดชั่วคราว"}
                    </span>
                </td>

                <td class="px-4 py-4 whitespace-nowrap text-sm font-medium">
                    <button onclick="toggleStatus('${point._id}', ${!point.isOpen})" class="px-2 py-1 rounded ${point.isOpen ? "bg-red-600" : "bg-green-600"} text-white mr-2">
                        ${point.isOpen ? "ปิดบริการ" : "เปิดบริการ"}
                    </button>
                    <a href="/employee/wastePoint/edit/${point._id}" class="px-2 py-1 rounded bg-blue-600 hover:bg-blue-900 text-white mr-2"><i class="fa fa-edit"></i></a>
                    <button onclick="deletePoint('${point._id}')" class="px-2 py-1 rounded bg-red-600 hover:bg-red-900 text-white"><i class="fa fa-trash"></i></button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    // แสดง marker บนแผนที่
    function updateMap() {
        markers.forEach(m => map.removeLayer(m));
        markers = [];

        wastePoints.forEach((point) => {
            if (!point.latitude || !point.longitude) return;
            const marker = L.marker([point.latitude, point.longitude])
                .addTo(map)
                .bindPopup(`
                    <div class="p-2">
                        <h3 class="font-semibold text-primary-700">${point.wastePointName}</h3>
                        <p class="text-sm text-gray-600">ประเภท: ${point.type || "-"}</p>
                        <p class="text-sm text-gray-600">ผู้รับผิดชอบ: ${point.responsible || "-"}</p>
                        <p class="text-sm text-gray-600">โทร: ${point.phone || "-"}</p>
                        <p class="text-sm text-gray-600">เวลา: ${point.openTime || "-"} - ${point.closeTime || "-"}</p>
                        <span class="inline-block mt-2 px-2 py-1 text-xs rounded-full ${
                            point.isOpen ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
                        }">
                            ${point.isOpen ? "เปิดบริการ" : "ปิดชั่วคราว"}
                        </span>
                    </div>
                `);
            markers.push(marker);
        });

        if (markers.length > 0) {
            const group = new L.featureGroup(markers);
            map.fitBounds(group.getBounds().pad(0.1));
        }
    }

    // เปลี่ยนสถานะเปิด/ปิด
    async function toggleStatus(id, newStatus) {
        const result = await Swal.fire({
            title: "ยืนยันการเปลี่ยนสถานะ?",
            text: newStatus ? "เปิดให้บริการอีกครั้ง" : "ปิดให้บริการชั่วคราว",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก",
        });

        if (result.isConfirmed) {
            window.location.href = `/employee/wastePoint/toggle/${id}?isOpen=${newStatus}`;
        }
    }

    // ลบจุดรับซื้อ
    async function deletePoint(id) {
        const result = await Swal.fire({
            title: "ยืนยันการลบ?",
            text: "คุณต้องการลบจุดรับซื้อขยะนี้หรือไม่",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ลบ",
        });

        if (result.isConfirmed) {
            window.location.href = `/employee/wastePoint/delete/${id}`;
        }
    }

    initMap();
    updatePointsList();
    updateMap();
    
</script>

</html>