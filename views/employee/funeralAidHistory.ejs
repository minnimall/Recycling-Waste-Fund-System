                console.error('Error loading detail:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message,
                    confirmButtonColor: '#3b82f6'
                });
                closeDetailModal();
            }
        }

