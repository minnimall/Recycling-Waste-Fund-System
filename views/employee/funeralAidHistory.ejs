    <script>
        // Fixed Frontend JavaScript with proper year handling
        let currentPage = 1;
        let currentLimit = 10;
        let currentFilters = {
            search: '',
            // year: new Date().getFullYear() + 543, // ปีปัจจุบัน เป็น พ.ศ.
            year: '',
            status: 'completed'
        };
        let allRecords = [];

        // สร้างตัวเลือกปีแบบอัตโนมัติ
        function generateYearOptions() {
            const currentYear = new Date().getFullYear() + 543; // ปีปัจจุบัน พ.ศ.
            const yearFilter = document.getElementById('yearFilter');
            
            // ล้าง options เดิม
            yearFilter.innerHTML = '<option value="">ทั้งหมด</option>';
            
            // สร้าง options ย้อนหลัง 5 ปี
            for (let i = 0; i < 5; i++) {
                const year = currentYear - i;
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                // if (i === 0) option.selected = true; // เลือกปีปัจจุบัน
                yearFilter.appendChild(option);
            }
            
            // Update current filter
            // currentFilters.year = currentYear.toString();

            // ตั้งค่า value ของ select ให้เป็นค่าว่างเพื่อให้ตรงกับ "ทั้งหมด"
            yearFilter.value = ""; 
            currentFilters.year = "";
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Page loaded, initializing...'); // Debug log
            
            // สร้างตัวเลือกปี
            generateYearOptions();
            
            // โหลดข้อมูล
            loadFuneralRecords();

            // Search with debounce
            let searchTimeout;
            document.getElementById('searchInput').addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentFilters.search = e.target.value;
                    currentPage = 1;
                    console.log('Search filter:', currentFilters.search);
                    loadFuneralRecords();
                }, 500);
            });

            // Filter listeners
            document.getElementById('yearFilter').addEventListener('change', function(e) {
                currentFilters.year = e.target.value;
                currentPage = 1;
                console.log('Year filter:', currentFilters.year);
                loadFuneralRecords();
            });

            document.getElementById('statusFilter').addEventListener('change', function(e) {
                currentFilters.status = e.target.value;
                currentPage = 1;
                console.log('Status filter:', currentFilters.status);
                loadFuneralRecords();
            });

            document.getElementById('limitFilter').addEventListener('change', function(e) {
                currentLimit = parseInt(e.target.value);
                currentPage = 1;
                console.log('Limit:', currentLimit);
                loadFuneralRecords();
            });

            document.getElementById('resetFilters').addEventListener('click', function() {
                document.getElementById('searchInput').value = '';
                document.getElementById('yearFilter').value = ''; // เปลี่ยนจาก currentYear เป็น ''
                
                // หากมี statusFilter ให้รีเซ็ตด้วย
                if(document.getElementById('statusFilter')) {
                    document.getElementById('statusFilter').value = 'completed';
                }

                currentFilters = { 
                    search: '', 
                    year: '', // เปลี่ยนเป็นค่าว่าง
                    status: 'completed' 
                };
                currentPage = 1;
                loadFuneralRecords();
            });
        });

        // Load Records
        async function loadFuneralRecords() {
            try {
                showLoadingState();

                // สร้าง query parameters
                const params = new URLSearchParams({
                    page: currentPage,
                    limit: currentLimit
                });

                // เพิ่ม filters ที่มีค่า
                if (currentFilters.year && currentFilters.year !== '') {
                    params.append('year', currentFilters.year);
                }
                if (currentFilters.status && currentFilters.status !== '') {
                    params.append('status', currentFilters.status);
                }
                if (currentFilters.search && currentFilters.search.trim() !== '') {
                    params.append('search', currentFilters.search);
                }

                const url = `/employee/funeral-assistance/history?${params}`;
                console.log('Fetching from:', url);

                const response = await fetch(url);
                
                // ตรวจสอบ response status
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Response error:', errorText);
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                console.log('API Response:', result);

                if (result.success) {
                    allRecords = result.data.records;
                    displayRecords(result.data);
                    updateSummaryCards(result.data);
                } else {
                    showError(result.message || 'ไม่สามารถโหลดข้อมูลได้');
                }
            } catch (error) {
                console.error('Error loading funeral records:', error);
                showError('เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error.message);
                
                // แสดง empty state แทน loading
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('emptyState').classList.remove('hidden');
                document.getElementById('recordsContainer').classList.add('hidden');
            }
        }

        // Display Functions
        function showLoadingState() {
            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('recordsContainer').classList.add('hidden');
            document.getElementById('emptyState').classList.add('hidden');
        }

        function displayRecords(data) {
            const { records, pagination } = data;

            console.log('Displaying records:', records.length);

            document.getElementById('loadingState').classList.add('hidden');

            if (!records || records.length === 0) {
                document.getElementById('emptyState').classList.remove('hidden');
                document.getElementById('recordsContainer').classList.add('hidden');
                return;
            }

            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('recordsContainer').classList.remove('hidden');

            document.getElementById('recordsList').innerHTML = records.map(record => createRecordCard(record)).join('');
            updatePagination(pagination);
        }

        function createRecordCard(record) {
            const statusInfo = getStatusInfo(record.status);
            
            // ตรวจสอบและจัดการ date ที่อาจเป็น null
            const dateOfDeath = record.deceasedInfo?.dateOfDeath;
            const dateStr = dateOfDeath ? new Date(dateOfDeath).toLocaleDateString('th-TH', {
                year: 'numeric', month: 'long', day: 'numeric'
            }) : 'ไม่ระบุ';
            
            const createdAt = record.createdAt;
            const createdStr = createdAt ? new Date(createdAt).toLocaleDateString('th-TH', {
                year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
            }) : 'ไม่ระบุ';

            const familyName = record.familyID?.familyName || 'ไม่ระบุ';
            const deceasedName = record.deceasedInfo?.name || 'ไม่ระบุ';
            const beneficiaryName = record.beneficiaryInfo?.name || 'ไม่ระบุ';
            const beneficiaryRel = record.beneficiaryInfo?.relationship || '';
            const totalAmount = record.financialInfo?.totalAmount || 0;
            const totalDeductedAccounts = record.financialInfo?.totalDeductedAccounts || 0;
            const disqualifiedCount = record.disqualifiedAccounts?.length || 0;

            return `
                <div class="record-card p-6 hover:bg-gray-50 cursor-pointer transition-all" onclick="viewDetail('${record._id}')">
                    <div class="flex flex-col md:flex-row justify-between">
                        <div class="flex-1">
                            <div class="flex items-start justify-between mb-3">
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-800 flex items-center flex-wrap gap-2">
                                        ${deceasedName}
                                    </h3>
                                    <p class="text-sm text-gray-500 mt-1">
                                        <span class="font-medium">ครัวเรือน:</span> ${familyName}
                                    </p>
                                </div class="items-center">
                                    <span class="px-3 py-1 text-xs font-medium rounded-full ${statusInfo.class}">
                                            ${statusInfo.text}
                                    </span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <p class="text-xs text-gray-500 mb-1">วันที่เสียชีวิต</p>
