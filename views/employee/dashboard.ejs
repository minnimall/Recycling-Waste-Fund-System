<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/dashboard.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chart.js plugins -->
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-gray-100">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');
        const serverError = '<%= typeof errorMessage !== "undefined" ? errorMessage : "" %>';

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

        if (serverError && serverError.trim() !== '') {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: serverError,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33'
            });
        }
    </script>

    <!-- Main content -->
    <div class="content bg-gray-50 min-h-screen">
        <!-- Header with Filters -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h1 class="text-2xl font-semibold text-gray-800">แดชบอร์ด</h1>
                    <p class="text-gray-500">ข้อมูลสรุปและการวิเคราะห์ระบบธนาคารขยะ</p>
                </div>
                <!-- <div class="flex space-x-2">
                    <button id="refreshData" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors">
                        <i class="fas fa-sync-alt mr-2"></i>รีเฟรช
                    </button>
                </div> -->
            </div>

            <!-- Filter Form -->
            <form method="GET" action="/employee" class="bg-gray-50 p-4 rounded-lg">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <!-- Date Range Selection -->
                    <div>
                        <label for="dateRange" class="block text-sm font-medium text-gray-700 mb-1">ช่วงเวลา</label>
                        <select name="dateRange" id="dateRange" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="all" <%= currentFilters.dateRange === 'all' ? 'selected' : '' %>>ทั้งหมด</option>
                            <option value="today" <%= currentFilters.dateRange === 'today' ? 'selected' : '' %>>วันนี้</option>
                            <option value="yesterday" <%= currentFilters.dateRange === 'yesterday' ? 'selected' : '' %>>เมื่อวาน</option>
                            <option value="thisMonth" <%= currentFilters.dateRange === 'thisMonth' ? 'selected' : '' %>>เดือนนี้</option>
                            <option value="lastMonth" <%= currentFilters.dateRange === 'lastMonth' ? 'selected' : '' %>>เดือนที่แล้ว</option>
                            <% 
                                // สร้างตัวเลือกเดือน 12 เดือนย้อนหลัง
                                const now = new Date();
                                for (let i = 2; i <= 12; i++) {
                                    const monthDate = new Date(now.getFullYear(), now.getMonth() - i, 1);
                                    const monthValue = `month-${i}`;
                                    const monthNames = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                                                        'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
                                    const monthName = monthNames[monthDate.getMonth()];
                                    const year = monthDate.getFullYear() + 543; // แปลงเป็น พ.ศ.
                            %>
                                <option value="<%= monthValue %>" <%= currentFilters.dateRange === monthValue ? 'selected' : '' %>>
                                    <%= monthName %> <%= year %>
                                </option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Single Date Selection -->
                    <div>
                        <label for="selectedDate" class="block text-sm font-medium text-gray-700 mb-1">เลือกวันที่</label>
                        <input type="date" name="selectedDate" id="selectedDate" value="<%= currentFilters.startDate %>" 
                            class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="เลือกวันที่เฉพาะ">
                    </div>

                    <!-- Village Filter -->
                    <div>
                        <label for="village" class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                        <select name="village" id="village" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">ทุกหมู่บ้าน</option>
                            <% if (allVillages && allVillages.length > 0) { %>
                                <% allVillages.forEach(village => { %>
                                    <option value="<%= village._id %>" <%= currentFilters.village === village._id.toString() ? 'selected' : '' %>>
                                        <%= village.villageName || `หมู่บ้านที่ ${village.villageNumber}` %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <div>
                        <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors">
                            <i class="fas fa-search mr-2"></i>ค้นหา
                        </button>
                    </div>
                </div>

                <!-- Current Filter Display -->
                <% if (filterInfo && (filterInfo.dateRange !== 'all' || filterInfo.village)) { %>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <span class="text-sm text-gray-600">ตัวกรองปัจจุบัน:</span>
                        
                        <% if (filterInfo.dateRange !== 'all') { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                <i class="fas fa-calendar mr-1"></i>
                                <% if (filterInfo.dateRange === 'today') { %>วันนี้
                                <% } else if (filterInfo.dateRange === 'yesterday') { %>เมื่อวาน
                                <% } else if (filterInfo.dateRange === 'thisMonth') { %>เดือนนี้
                                <% } else if (filterInfo.dateRange === 'lastMonth') { %>เดือนที่แล้ว
                                <% } else if (filterInfo.dateRange && filterInfo.dateRange.startsWith('month-')) { %>
                                    <% 
                                        const monthIndex = parseInt(filterInfo.dateRange.replace('month-', ''));
                                        const monthDate = new Date();
                                        monthDate.setMonth(monthDate.getMonth() - monthIndex);
                                        const monthNames = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                                                            'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
                                        const monthName = monthNames[monthDate.getMonth()];
                                        const year = monthDate.getFullYear() + 543;
                                    %>
                                    <%= monthName %> <%= year %>
                                <% } else if (filterInfo.startDate) { %>
                                    วันที่ <%= filterInfo.startDate %>
                                <% } %>
                            </span>
                        <% } %>
                        
                        <% if (filterInfo.village && filterInfo.villageName) { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <i class="fas fa-map-marker-alt mr-1"></i><%= filterInfo.villageName %>
                            </span>
                        <% } %>

                        <a href="/employee" class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
                            <i class="fas fa-times mr-1"></i>ล้างตัวกรอง
                        </a>
                    </div>
                <% } %>
            </form>
        </div>

        <!-- Stats cards -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <!-- Card 1: ปริมาณขยะทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-blue-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ปริมาณขยะทั้งหมด</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            <%= totalQuantity.toLocaleString() %> <span class="text-sm font-normal">กก.</span>
                        </h2>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <i class="fas fa-weight-hanging text-blue-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">ปริมาณขยะที่รับซื้อทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 2: ยอดเงินทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-green-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ยอดเงินทั้งหมด</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            ฿<%= totalAmount.toLocaleString() %>
                        </h2>
                    </div>
                    <div class="p-3 bg-green-100 rounded-full">
                        <i class="fas fa-money-bill-wave text-green-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">มูลค่าการรับซื้อขยะทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 3: จำนวนธุรกรรมทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-purple-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">จำนวนธุรกรรม</p>
                        <h2 class="text-3xl font-bold text-gray-800"><%= totalTransactions.toLocaleString() %></h2>
                    </div>
                    <div class="p-3 bg-purple-100 rounded-full">
                        <i class="fas fa-exchange-alt text-purple-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">ธุรกรรมการรับซื้อขยะทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 4: ยอดรับซื้อวันนี้ vs เมื่อวาน -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-yellow-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ยอดรับซื้อวันนี้</p>
                        <h2 class="text-2xl font-bold text-gray-800">
                            ฿<%= todayTotal.toLocaleString() %>
                        </h2>
                    </div>
                    <div class="p-3 bg-yellow-100 rounded-full">
                        <i class="fas fa-chart-line text-yellow-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (todayPercentChange >= 0) { %>
                        <span class="text-green-500 flex items-center text-sm">
                            <i class="fas fa-arrow-up mr-1"></i> <%= todayPercentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center text-sm">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(todayPercentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2 text-sm">จากเมื่อวาน</span>
                </div>
            </div>
        </div>

        <!-- Main dashboard sections -->
        <div class="mx-4 grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Section 1: Village Data Chart -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">ข้อมูลแต่ละหมู่บ้าน</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-chart-pie mr-1"></i>ตามตัวกรอง
                    </div>
                </div>
                <div class="h-80 flex items-center justify-center">
                    <% if (villageData && villageData.length > 0) { %>
                        <canvas id="villageWasteChart"></canvas>
                    <% } else { %>
                        <div class="text-center text-gray-500">
                            <i class="fas fa-chart-pie text-6xl mb-4"></i>
                            <p>ไม่มีข้อมูลหมู่บ้าน</p>
                        </div>
                    <% } %>
                </div>
                <% if (villageData && villageData.length > 0) { %>
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <% const maxQuantityVillage = villageData.reduce((max, village) => village.totalQuantity > max.totalQuantity ? village : max); %>
                        <% const maxAmountVillage = villageData.reduce((max, village) => village.totalAmount > max.totalAmount ? village : max); %>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีปริมาณขยะมากที่สุด</p>
                            <p class="font-semibold text-blue-600">
                                <%= maxQuantityVillage.villageName || `หมู่บ้านที่ ${maxQuantityVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600"><%= Math.round(maxQuantityVillage.totalQuantity) %> กก.</p>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีมูลค่าขยะมากที่สุด</p>
                            <p class="font-semibold text-green-600">
                                <%= maxAmountVillage.villageName || `หมู่บ้านที่ ${maxAmountVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600">฿<%= Math.round(maxAmountVillage.totalAmount).toLocaleString() %></p>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Section 2: Waste Type Summary -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">สรุปตามประเภทขยะ</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-list mr-1"></i>10 อันดับแรก
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ประเภทขยะ</th>
                                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ปริมาณ (กก.)</th>
                                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ราคาเฉลี่ย</th>
                                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">มูลค่ารวม</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (wasteSummary && wasteSummary.length > 0) { %>
                                <% const colors = ['blue', 'green', 'yellow', 'red', 'purple', 'indigo', 'pink', 'gray', 'orange', 'teal']; %>
                                <% wasteSummary.forEach((waste, index) => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="h-3 w-3 rounded-full bg-<%= colors[index % colors.length] %>-500 mr-2"></div>
                                                <div class="text-sm font-medium text-gray-900"><%= waste._id %></div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                                            <%= Math.round(waste.totalQuantity).toLocaleString() %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                                            ฿<%= Math.round(waste.avgPrice).toLocaleString() %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            ฿<%= Math.round(waste.totalAmount).toLocaleString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="px-4 py-8 text-center text-gray-500">
                                        <i class="fas fa-inbox text-4xl mb-2"></i>
                                        <p>ไม่มีข้อมูลการรับซื้อ</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Price Trends Section -->
        <!-- <% if (priceTrends && priceTrends.length > 0) { %>
            <div class="mx-4 bg-white rounded-lg shadow p-6 mb-8">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">แนวโน้มราคาขยะ</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-chart-line mr-1"></i>3 เดือนย้อนหลัง
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2">
                        <div class="h-80">
                            <canvas id="priceTrendChart"></canvas>
                        </div>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <h3 class="font-semibold text-gray-800 mb-4">แนวโน้มราคา</h3>
                        <div class="space-y-3">
                            <% priceTrends.slice(0, 5).forEach((trend, index) => { %>
                                <% const colors = ['blue', 'green', 'yellow', 'red', 'purple']; %>
                                <% 
                                    const sortedData = trend.monthlyData.sort((a, b) => a.month.localeCompare(b.month));
                                    const firstPrice = sortedData[0]?.avgPrice || 0;
                                    const lastPrice = sortedData[sortedData.length - 1]?.avgPrice || 0;
                                    const percentChange = firstPrice > 0 ? ((lastPrice - firstPrice) / firstPrice * 100).toFixed(1) : 0;
                                %>
                                <div class="flex justify-between items-center p-2 bg-white rounded border">
                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-<%= colors[index] %>-500 mr-3"></div>
                                        <div>
                                            <p class="text-sm font-medium text-gray-900"><%= trend._id %></p>
                                            <p class="text-xs text-gray-500">฿<%= Math.round(lastPrice) %>/กก.</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center <%= percentChange >= 0 ? 'text-green-600' : 'text-red-600' %>">
                                        <i class="fas fa-arrow-<%= percentChange >= 0 ? 'up' : 'down' %> mr-1"></i>
                                        <span class="text-sm font-medium"><%= Math.abs(percentChange) %>%</span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        <% } %> -->

        <!-- Additional Stats Section -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-orange-100 rounded-full">
                        <i class="fas fa-crown text-orange-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">ขยะมูลค่าสูงสุด</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= highestWaste && highestWaste._id ? highestWaste._id.wasteName : 'ไม่มีข้อมูล' %>
                        </p>
                        <p class="text-sm text-orange-600">฿<%= highestWaste ? highestWaste.pricePerUnit : 0 %> / กก.</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-teal-100 rounded-full">
                        <i class="fas fa-calendar-day text-teal-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">ธุรกรรมวันนี้</p>
                        <p class="text-lg font-semibold text-gray-800"><%= transactionToday %></p>
                        <p class="text-sm text-teal-600">
                            <% if (transactionPercentChange >= 0) { %>
                                <i class="fas fa-arrow-up"></i> <%= transactionPercentChange %>%
                            <% } else { %>
                                <i class="fas fa-arrow-down"></i> <%= Math.abs(transactionPercentChange) %>%
                            <% } %>
                            จากเมื่อวาน
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-pink-100 rounded-full">
                        <i class="fas fa-balance-scale text-pink-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">เดือนที่แล้ว</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= lastMonthQuantity.toLocaleString() %> กก.
                        </p>
                        <p class="text-sm text-pink-600">฿<%= lastMonthTotal.toLocaleString() %></p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-indigo-100 rounded-full">
                        <i class="fas fa-home text-indigo-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">จำนวนหมู่บ้าน</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= villageData ? villageData.length : 0 %> หมู่บ้าน
                        </p>
                        <p class="text-sm text-indigo-600">ที่มีการรับซื้อขยะ</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ข้อมูลจากเซิร์ฟเวอร์
            const villageData = <%- JSON.stringify(villageData || []) %>;
            const wasteSummary = <%- JSON.stringify(wasteSummary || []) %>;
            const priceTrends = <%- JSON.stringify(priceTrends || []) %>;

            console.log('Village Data:', villageData);
            console.log('Waste Summary:', wasteSummary);
            console.log('Price Trends:', priceTrends);

            // Village Waste Chart
            const villageCtx = document.getElementById('villageWasteChart');
            if (villageCtx && villageData.length > 0) {
                const villageLabels = villageData.map(village => 
                    village.villageName || `หมู่บ้านที่ ${village.villageNumber}`
                );
                const villageQuantities = villageData.map(village => Math.round(village.totalQuantity));
                const villageColors = [
                    'rgba(255, 99, 132, 0.8)', 'rgba(54, 162, 235, 0.8)', 'rgba(255, 206, 86, 0.8)',
                    'rgba(75, 192, 192, 0.8)', 'rgba(153, 102, 255, 0.8)', 'rgba(255, 159, 64, 0.8)',
                    'rgba(199, 199, 199, 0.8)', 'rgba(83, 102, 255, 0.8)', 'rgba(40, 159, 64, 0.8)',
                    'rgba(210, 99, 132, 0.8)'
                ];

                const villageWasteChart = new Chart(villageCtx, {
                    type: 'pie',
                    data: {
                        labels: villageLabels,
                        datasets: [{
                            data: villageQuantities,
                            backgroundColor: villageColors.slice(0, villageData.length),
                            borderColor: villageColors.slice(0, villageData.length).map(color => color.replace('0.8', '1')),
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 15,
                                    padding: 15,
                                    font: { size: 12 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                        const villageInfo = villageData[context.dataIndex];
                                        const amount = villageInfo ? Math.round(villageInfo.totalAmount) : 0;
                                        return [
                                            `${label}`,
                                            `ปริมาณ: ${value.toLocaleString()} กก. (${percentage}%)`,
                                            `มูลค่า: ฿${amount.toLocaleString()}`
                                        ];
                                    }
                                }
                            }
                        },
                        animation: {
                            animateRotate: true,
                            animateScale: true
                        }
                    }
                });
            }

            // Price Trend Chart
            const priceTrendCtx = document.getElementById('priceTrendChart');
            if (priceTrendCtx && priceTrends.length > 0) {
                const months = [];
                const datasets = [];
                
                // สร้างรายการเดือนที่ไม่ซ้ำ
                priceTrends.forEach(trend => {
                    trend.monthlyData.forEach(data => {
                        if (!months.includes(data.month)) {
                            months.push(data.month);
                        }
                    });
                });
                months.sort();

                // สร้าง datasets สำหรับแต่ละประเภทขยะ
                const trendColors = [
                    'rgba(54, 162, 235, 1)', 'rgba(75, 192, 192, 1)', 'rgba(255, 206, 86, 1)',
                    'rgba(255, 99, 132, 1)', 'rgba(153, 102, 255, 1)', 'rgba(255, 159, 64, 1)',
                    'rgba(199, 199, 199, 1)'
                ];

                priceTrends.slice(0, 5).forEach((trend, index) => {
                    const data = months.map(month => {
                        const monthData = trend.monthlyData.find(d => d.month === month);
                        return monthData ? Math.round(monthData.avgPrice * 100) / 100 : null;
                    });

                    datasets.push({
                        label: trend._id,
                        data: data,
                        borderColor: trendColors[index],
                        backgroundColor: trendColors[index].replace('1)', '0.1)'),
                        tension: 0.4,
                        fill: false,
                        pointBackgroundColor: trendColors[index],
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    });
                });

                new Chart(priceTrendCtx, {
                    type: 'line',
                    data: {
                        labels: months.map(month => {
                            const [year, monthNum] = month.split('-');
                            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
                                                'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                            return monthNames[parseInt(monthNum) - 1] + ' ' + year.slice(-2);
                        }),
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            y: {
                                beginAtZero: false,
                                title: {
                                    display: true,
                                    text: 'ราคา (บาท/กก.)',
                                    font: { size: 12 }
                                },
                                grid: { color: 'rgba(0, 0, 0, 0.1)' }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'เดือน',
                                    font: { size: 12 }
                                },
                                grid: { color: 'rgba(0, 0, 0, 0.1)' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 15,
                                    padding: 15,
                                    font: { size: 12 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.dataset.label || '';
                                        const value = context.raw || 0;
                                        return `${label}: ฿${value} ต่อกิโลกรัม`;
                                    }
                                },
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff'
                            }
                        },
                        animation: { duration: 2000, easing: 'easeOutQuart' }
                    }
                });
            }

            // Event listeners
            document.getElementById('refreshData').addEventListener('click', function() {
                const originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>กำลังโหลด...';
                this.disabled = true;
                
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            });

            // Filter form enhancements
            const dateRangeSelect = document.getElementById('dateRange');
            const selectedDateInput = document.getElementById('selectedDate');

            dateRangeSelect.addEventListener('change', function() {
                if (this.value !== 'all') {
                    selectedDateInput.value = '';
                    selectedDateInput.disabled = true;
                } else {
                    selectedDateInput.disabled = false;
                }
            });

            // Initialize form state
            if (dateRangeSelect.value !== 'all') {
                selectedDateInput.disabled = true;
            }

            // Auto refresh every 5 minutes (if on 'all' filter)
            const currentFilters = {
                dateRange: '<%= currentFilters.dateRange %>',
                village: '<%= currentFilters.village %>',
                selectedDate: '<%= currentFilters.startDate %>'
            };

            if (currentFilters.dateRange === 'all' && !currentFilters.village) {
                setInterval(function() {
                    console.log('Auto refreshing dashboard data...');
                    Swal.fire({
                        title: 'อัพเดทข้อมูล',
                        text: 'กำลังรีเฟรชข้อมูลอัตโนมัติ...',
                        icon: 'info',
                        timer: 2000,
                        timerProgressBar: true,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    }).then(() => {
                        window.location.reload();
                    });
                }, 300000); // 5 นาที
            }

            // Animation for cards on load
            const cards = document.querySelectorAll('.hover\\:scale-105');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 150);
            });

            // Hover effect for table rows
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.01)';
                    this.style.transition = 'transform 0.2s ease';
                });
                
                row.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                });
            });

            // Keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Ctrl/Cmd + R สำหรับ refresh
                if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
                    e.preventDefault();
                    document.getElementById('refreshData').click();
                }
            });

            console.log('Dashboard initialized successfully');
        });

        // Utility functions
        function formatNumber(num) {
            return new Intl.NumberFormat('th-TH').format(num);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('th-TH', { 
                style: 'currency', 
                currency: 'THB' 
            }).format(amount);
        }

        window.dashboardUtils = {
            formatNumber,
            formatCurrency
        };
    </script>

    <style>
        /* Custom CSS สำหรับ Dashboard */
        .content {
            transition: margin-left 0.3s ease;
        }
        
        .hover\:scale-105:hover {
            transform: scale(1.05);
        }
        
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
        
        /* Custom scrollbar */
        .overflow-x-auto::-webkit-scrollbar {
            height: 6px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-thumb:hover {
            background: #a1a1a1;
        }
        
        /* Chart container styling */
        canvas {
            max-height: 100% !important;
        }
        
        /* Responsive table */
        @media (max-width: 768px) {
            .overflow-x-auto table {
                min-width: 600px;
            }
        }
        
        /* Loading animation */
        .fa-spinner {
            animation: fa-spin 1s infinite linear;
        }
        
        @keyframes fa-spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Card hover effects */
        .transition-transform {
            transition: transform 0.3s ease;
        }
        
        /* Toast notifications positioning */
        .swal2-top-end {
            top: 20px !important;
            right: 20px !important;
        }

        /* Filter form styling */
        .filter-form {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        /* Disabled input styling */
        input:disabled {
            background-color: #f9fafb;
            cursor: not-allowed;
        }

        /* Filter badges */
        .filter-badge {
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Table hover effect enhancement */
        tbody tr:hover {
            background-color: #f8fafc;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        /* Chart loading placeholder */
        .chart-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 320px;
            background: #f9fafb;
            border-radius: 8px;
            border: 2px dashed #d1d5db;
        }

        /* Responsive adjustments */
        @media (max-width: 640px) {
            .content {
                padding: 0 16px;
            }
            
            .mx-4 {
                margin-left: 0;
                margin-right: 0;
            }
            
            .grid-cols-1 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</body>
</html>