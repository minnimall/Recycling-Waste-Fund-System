                                <span class="text-sm">อื่นๆ</span>
                            </div>
                            <div class="flex items-center text-red-500">
                                <i class="fas fa-arrow-down mr-1"></i>
                                <span>-1%</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-6 p-3 bg-white rounded border border-gray-200">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">ข้อแนะนำ</h4>
                        <p class="text-sm text-gray-600">ควรเพิ่มการรับซื้อ <span class="font-medium">พลาสติก PET</span> และ <span class="font-medium">โลหะ</span> เนื่องจากมีแนวโน้มราคาที่สูงขึ้นในอนาคต</p>
                    </div>
                </div>
            </div>
        </div> -->
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // Village Waste Chart (3D Pie)
            const villageCtx = document.getElementById('villageWasteChart').getContext('2d');
            const villageWasteChart = new Chart(villageCtx, {
                type: 'pie',
                data: {
                    labels: ['หมู่บ้านที่ 1', 'หมู่บ้านที่ 2', 'หมู่บ้านที่ 3', 'หมู่บ้านที่ 4', 'หมู่บ้านที่ 5', 
                             'หมู่บ้านที่ 6', 'หมู่บ้านที่ 7', 'หมู่บ้านที่ 8', 'หมู่บ้านที่ 9', 'หมู่บ้านที่ 10'],
                    datasets: [{
                        data: [250, 320, 450, 180, 380, 220, 150, 290, 120, 180],
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)',
                            'rgba(199, 199, 199, 0.7)',
                            'rgba(83, 102, 255, 0.7)',
                            'rgba(40, 159, 64, 0.7)',
                            'rgba(210, 99, 132, 0.7)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(199, 199, 199, 1)',
                            'rgba(83, 102, 255, 1)',
                            'rgba(40, 159, 64, 1)',
                            'rgba(210, 99, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 15,
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    const price = value * 15; // สมมติว่าราคาเฉลี่ยต่อกิโลกรัมคือ 15 บาท
                                    return `${label}: ${value} กก. (${percentage}%) - ฿${price.toLocaleString()}`;
                                }
                            }
                        }
                    }
                }
            });

            // Price Prediction Chart (Line)
            const predictionCtx = document.getElementById('pricePredictionChart').getContext('2d');
            const pricePredictionChart = new Chart(predictionCtx, {
                type: 'line',
                data: {
                    labels: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'],
                    datasets: [
                        {
                            label: 'พลาสติก PET',
                            data: [22, 23, 24, 24, 25, 25, 26, 26, 27, 28, 29, 30],
                            borderColor: 'rgba(54, 162, 235, 1)',
                            backgroundColor: 'rgba(54, 162, 235, 0.1)',
                            tension: 0.4,
                            fill: false
                        },
                        {
                            label: 'กระดาษ',
                            data: [5.5, 5.4, 5.3, 5.2, 5.0, 4.9, 4.8, 4.7, 4.6, 4.5, 4.4, 4.3],
                            borderColor: 'rgba(75, 192, 192, 1)',
                            backgroundColor: 'rgba(75, 192, 192, 0.1)',
                            tension: 0.4,
                            fill: false
                        },
                        {
                            label: 'โลหะ',
                            data: [12, 12.5, 13, 13.5, 14, 14.5, 15, 15.5, 16, 16.5, 17, 18],
                            borderColor: 'rgba(255, 206, 86, 1)',
                            backgroundColor: 'rgba(255, 206, 86, 0.1)',
                            tension: 0.4,
                            fill: false
                        },
                        {
                            label: 'แก้ว',
                            data: [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3],
                            borderColor: 'rgba(255, 99, 132, 1)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            tension: 0.4,
                            fill: false
                        },
                        {
                            label: 'อื่นๆ',
                            data: [1.2, 1.1, 1.1, 1.0, 1.0, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9],
                            borderColor: 'rgba(153, 102, 255, 1)',
                            backgroundColor: 'rgba(153, 102, 255, 0.1)',
                            tension: 0.4,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false,
                            title: {
                                display: true,
                                text: 'ราคา (บาท/กก.)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'เดือน'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.dataset.label || '';
                                    const value = context.raw || 0;
                                    return `${label}: ฿${value} ต่อกิโลกรัม`;
                                }
                            }
                        }
                    }
                }
            });

            // Event listener for time range selector
            document.getElementById('timeRange').addEventListener('change', function() {
                // ในสถานการณ์จริง คุณจะต้องเรียก API เพื่อดึงข้อมูลตามช่วงเวลาที่เลือก
                // แต่ในตัวอย่างนี้เราจะแค่แสดง alert
                alert(`กำลังโหลดข้อมูลสำหรับ: ${this.options[this.selectedIndex].text}`);
            });

            // Event listener for refresh button
            document.getElementById('refreshData').addEventListener('click', function() {
                window.location.reload()
            });
        });
    </script>
</body>
</html>