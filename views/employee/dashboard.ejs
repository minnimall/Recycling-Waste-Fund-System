                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (transactionPercentChange >= 0) { %>
                        <span class="text-green-500 flex items-center">
                            <i class="fas fa-arrow-up mr-1"></i> <%= transactionPercentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(transactionPercentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2">จากเมื่อวาน (<%= transactionYesterday %>)</span>
                </div>
            </div>
            
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-yellow-500 transition-transform hover:scale-105">
