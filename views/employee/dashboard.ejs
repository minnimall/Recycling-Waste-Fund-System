<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/dashboard.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chart.js plugins -->
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-gray-100">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');
        const serverError = '<%= typeof errorMessage !== "undefined" ? errorMessage : "" %>';

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

        if (serverError && serverError.trim() !== '') {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: serverError,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33'
            });
        }
    </script>

    <!-- Main content -->
    <div class="content bg-gray-50 min-h-screen">
        <!-- Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-semibold text-gray-800">แดชบอร์ด</h1>
                <p class="text-gray-500">ข้อมูลสรุปและการวิเคราะห์ระบบธนาคารขยะ</p>
            </div>
            <div class="flex space-x-2">
                <button id="exportReport" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    <i class="fas fa-file-export mr-2"></i>ส่งออกรายงาน
                </button>
                <button id="refreshData" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors">
                    <i class="fas fa-sync-alt mr-2"></i>รีเฟรช
                </button>
            </div>
        </div>

        <!-- Stats cards -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <!-- Card 1: ปริมาณขยะทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-blue-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ปริมาณขยะทั้งหมด (เดือนที่แล้ว)</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            <%= totalWaste.toLocaleString() %> <span class="text-sm font-normal">กก.</span>
                        </h2>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <i class="fas fa-trash text-blue-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (percentChange >= 0) { %>
                        <span class="text-green-500 flex items-center text-sm">
                            <i class="fas fa-arrow-up mr-1"></i> <%= percentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center text-sm">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(percentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2 text-sm">เทียบกับเดือนก่อนหน้า</span>
                </div>
            </div>
            
            <!-- Card 2: ยอดรับซื้อวันนี้ -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-green-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ยอดรับซื้อวันนี้</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            ฿<%= todayTotal.toLocaleString() %>
                        </h2>
                    </div>
                    <div class="p-3 bg-green-100 rounded-full">
                        <i class="fas fa-money-bill-wave text-green-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (todayPercentChange >= 0) { %>
                        <span class="text-green-500 flex items-center text-sm">
                            <i class="fas fa-arrow-up mr-1"></i> <%= todayPercentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center text-sm">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(todayPercentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2 text-sm">จากเมื่อวาน</span>
                </div>
            </div>
            
            <!-- Card 3: จำนวนธุรกรรมวันนี้ -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-purple-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">จำนวนธุรกรรมวันนี้</p>
                        <h2 class="text-3xl font-bold text-gray-800"><%= transactionToday %></h2>
                    </div>
                    <div class="p-3 bg-purple-100 rounded-full">
                        <i class="fas fa-exchange-alt text-purple-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (transactionPercentChange >= 0) { %>
                        <span class="text-green-500 flex items-center text-sm">
                            <i class="fas fa-arrow-up mr-1"></i> <%= transactionPercentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center text-sm">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(transactionPercentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2 text-sm">จากเมื่อวาน (<%= transactionYesterday %>)</span>
                </div>
            </div>
            
            <!-- Card 4: ขยะมูลค่าสูงสุด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-yellow-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ขยะมูลค่าสูงสุด</p>
                        <h2 class="text-lg font-bold text-gray-800">
                            <%= highestWaste && highestWaste.wasteId ? highestWaste.wasteId.wasteName : 'ไม่มีข้อมูล' %>
                        </h2>
                    </div>
                    <div class="p-3 bg-yellow-100 rounded-full">
                        <i class="fas fa-crown text-yellow-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-800 font-semibold">฿<%= highestWaste ? highestWaste.pricePerUnit : 0 %> / กก.</span>
                    <span class="text-gray-400 ml-2 text-sm">ราคาปัจจุบัน</span>
                </div>
            </div>
        </div>

        <!-- Main dashboard sections -->
        <div class="mx-4 grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Section 1: 3D Pie Chart for Village Waste -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">ปริมาณขยะแต่ละหมู่บ้าน</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-calendar-alt mr-1"></i>เดือนที่แล้ว
                    </div>
                </div>
                <div class="h-80 flex items-center justify-center">
                    <% if (villageData && villageData.length > 0) { %>
                        <canvas id="villageWasteChart"></canvas>
                    <% } else { %>
                        <div class="text-center text-gray-500">
                            <i class="fas fa-chart-pie text-6xl mb-4"></i>
                            <p>ไม่มีข้อมูลหมู่บ้าน</p>
                        </div>
                    <% } %>
                </div>
                <div class="mt-4 grid grid-cols-2 gap-4">
                    <% if (villageData && villageData.length > 0) { %>
                        <% const maxQuantityVillage = villageData.reduce((max, village) => village.totalQuantity > max.totalQuantity ? village : max); %>
                        <% const maxAmountVillage = villageData.reduce((max, village) => village.totalAmount > max.totalAmount ? village : max); %>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีปริมาณขยะมากที่สุด</p>
                            <p class="font-semibold text-blue-600">
                                <%= maxQuantityVillage.villageName || `หมู่บ้านที่ ${maxQuantityVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600"><%= Math.round(maxQuantityVillage.totalQuantity) %> กก.</p>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีมูลค่าขยะมากที่สุด</p>
                            <p class="font-semibold text-green-600">
                                <%= maxAmountVillage.villageName || `หมู่บ้านที่ ${maxAmountVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600">฿<%= Math.round(maxAmountVillage.totalAmount).toLocaleString() %></p>
                        </div>
                    <% } else { %>
                        <div class="bg-gray-50 p-3 rounded-lg col-span-2">
                            <p class="text-gray-500 text-center">ไม่มีข้อมูลหมู่บ้าน</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Section 2: Daily Purchase Summary -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">สรุปการรับซื้อประจำวัน</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-calendar-day mr-1"></i>วันนี้
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ประเภทขยะ</th>
                                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ปริมาณ (กก.)</th>
                                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ราคา/หน่วย</th>
                                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">ยอดรวม</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (dailyWasteSummary && dailyWasteSummary.length > 0) { %>
                                <% const colors = ['blue', 'green', 'yellow', 'red', 'purple', 'indigo', 'pink', 'gray', 'orange', 'teal']; %>
                                <% dailyWasteSummary.forEach((waste, index) => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="h-3 w-3 rounded-full bg-<%= colors[index % colors.length] %>-500 mr-2"></div>
                                                <div class="text-sm font-medium text-gray-900"><%= waste._id %></div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                                            <%= Math.round(waste.totalQuantity) %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                                            ฿<%= Math.round(waste.avgPrice) %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            ฿<%= Math.round(waste.totalAmount).toLocaleString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="px-4 py-8 text-center text-gray-500">
                                        <i class="fas fa-inbox text-4xl mb-2"></i>
                                        <p>ไม่มีข้อมูลการรับซื้อในวันนี้</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                        <% if (dailyWasteSummary && dailyWasteSummary.length > 0) { %>
                            <tfoot class="bg-gray-50">
                                <tr>
                                    <% const totalQty = dailyWasteSummary.reduce((sum, waste) => sum + waste.totalQuantity, 0); %>
                                    <% const totalAmt = dailyWasteSummary.reduce((sum, waste) => sum + waste.totalAmount, 0); %>
                                    <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900">รวมทั้งหมด</td>
                                    <td class="px-4 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">
                                        <%= Math.round(totalQty) %> กก.
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">-</td>
                                    <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium text-green-600">
                                        ฿<%= Math.round(totalAmt).toLocaleString() %>
                                    </td>
                                </tr>
                            </tfoot>
                        <% } %>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section 3: Price Trends (ถ้ามีข้อมูล) -->
        <% if (priceTrends && priceTrends.length > 0) { %>
            <div class="mx-4 bg-white rounded-lg shadow p-6 mb-8">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">แนวโน้มราคาขยะ</h2>
                    <div class="text-sm text-gray-500">
                        <i class="fas fa-chart-line mr-1"></i>3 เดือนย้อนหลัง
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2">
                        <div class="h-80">
                            <canvas id="priceTrendChart"></canvas>
                        </div>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <h3 class="font-semibold text-gray-800 mb-4">แนวโน้มราคาขยะ</h3>
                        <div class="space-y-3">
                            <% priceTrends.slice(0, 5).forEach((trend, index) => { %>
                                <% const colors = ['blue', 'green', 'yellow', 'red', 'purple']; %>
                                <% 
                                    // คำนวณแนวโน้ม (เปรียบเทียบราคาเดือนแรกและเดือนล่าสุด)
                                    const sortedData = trend.monthlyData.sort((a, b) => a.month.localeCompare(b.month));
                                    const firstPrice = sortedData[0]?.avgPrice || 0;
                                    const lastPrice = sortedData[sortedData.length - 1]?.avgPrice || 0;
                                    const percentChange = firstPrice > 0 ? ((lastPrice - firstPrice) / firstPrice * 100).toFixed(1) : 0;
                                %>
                                <div class="flex justify-between items-center p-2 bg-white rounded border">
                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-<%= colors[index] %>-500 mr-3"></div>
                                        <div>
                                            <p class="text-sm font-medium text-gray-900"><%= trend._id %></p>
                                            <p class="text-xs text-gray-500">฿<%= Math.round(lastPrice) %>/กก.</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center <%= percentChange >= 0 ? 'text-green-600' : 'text-red-600' %>">
                                        <i class="fas fa-arrow-<%= percentChange >= 0 ? 'up' : 'down' %> mr-1"></i>
                                        <span class="text-sm font-medium"><%= Math.abs(percentChange) %>%</span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div class="mt-4 p-3 bg-white rounded border border-blue-200">
                            <h4 class="text-sm font-medium text-blue-800 mb-2">
                                <i class="fas fa-lightbulb mr-1"></i>ข้อแนะนำ
                            </h4>
                            <p class="text-sm text-blue-600">แนวโน้มราคาอาจเปลี่ยนแปลงตามสภาวะตลาด ควรติดตามราคาขยะอย่างสม่ำเสมอเพื่อการตัดสินใจที่ดีที่สุด</p>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Section 4: Quick Actions -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-blue-100 rounded-full mr-3">
                        <i class="fas fa-plus text-blue-500"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800">รับซื้อขยะ</h3>
                </div>
                <p class="text-gray-600 text-sm mb-4">เพิ่มข้อมูลการรับซื้อขยะใหม่</p>
                <a href="/employee/waste-purchase" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors text-sm">
                    เริ่มรับซื้อ
                </a>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-green-100 rounded-full mr-3">
                        <i class="fas fa-warehouse text-green-500"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800">จัดการสต๊อก</h3>
                </div>
                <p class="text-gray-600 text-sm mb-4">ตรวจสอบและจัดการสต๊อกขยะ</p>
                <a href="/employee/waste-stock" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600 transition-colors text-sm">
                    ดูสต๊อก
                </a>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-purple-100 rounded-full mr-3">
                        <i class="fas fa-chart-bar text-purple-500"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800">รายงาน</h3>
                </div>
                <p class="text-gray-600 text-sm mb-4">ดูรายงานและสถิติต่างๆ</p>
                <a href="/employee/reports" class="bg-purple-500 text-white px-4 py-2 rounded hover:bg-purple-600 transition-colors text-sm">
                    ดูรายงาน
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ข้อมูลจากเซิร์ฟเวอร์
            const villageData = <%- JSON.stringify(villageData || []) %>;
            const dailyWasteSummary = <%- JSON.stringify(dailyWasteSummary || []) %>;
            const priceTrends = <%- JSON.stringify(priceTrends || []) %>;

            console.log('Village Data:', villageData);
            console.log('Daily Waste Summary:', dailyWasteSummary);
            console.log('Price Trends:', priceTrends);

            // Village Waste Chart (3D Pie)
            const villageCtx = document.getElementById('villageWasteChart');
            if (villageCtx && villageData.length > 0) {
                // เตรียมข้อมูลสำหรับกราฟหมู่บ้าน
                const villageLabels = villageData.map(village => 
                    village.villageName || `หมู่บ้านที่ ${village.villageNumber}`
                );
                const villageQuantities = villageData.map(village => Math.round(village.totalQuantity));
                const villageColors = [
                    'rgba(255, 99, 132, 0.8)',
                    'rgba(54, 162, 235, 0.8)',
                    'rgba(255, 206, 86, 0.8)',
                    'rgba(75, 192, 192, 0.8)',
                    'rgba(153, 102, 255, 0.8)',
                    'rgba(255, 159, 64, 0.8)',
                    'rgba(199, 199, 199, 0.8)',
                    'rgba(83, 102, 255, 0.8)',
                    'rgba(40, 159, 64, 0.8)',
                    'rgba(210, 99, 132, 0.8)'
                ];

                const villageWasteChart = new Chart(villageCtx, {
                    type: 'pie',
                    data: {
                        labels: villageLabels,
                        datasets: [{
                            data: villageQuantities,
                            backgroundColor: villageColors.slice(0, villageData.length),
                            borderColor: villageColors.slice(0, villageData.length).map(color => color.replace('0.8', '1')),
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 15,
                                    padding: 15,
                                    font: {
                                        size: 12
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                        const villageInfo = villageData[context.dataIndex];
                                        const amount = villageInfo ? Math.round(villageInfo.totalAmount) : 0;
                                        return [
                                            `${label}`,
                                            `ปริมาณ: ${value} กก. (${percentage}%)`,
                                            `มูลค่า: ฿${amount.toLocaleString()}`
                                        ];
                                    }
                                }
                            }
                        },
                        animation: {
                            animateRotate: true,
                            animateScale: true
                        }
                    }
                });
            }

            // Price Trend Chart (ถ้ามีข้อมูล)
            const priceTrendCtx = document.getElementById('priceTrendChart');
            if (priceTrendCtx && priceTrends.length > 0) {
                // เตรียมข้อมูลสำหรับกราฟแนวโน้มราคา
                const months = [];
                const datasets = [];
                
                // สร้างรายการเดือนที่ไม่ซ้ำ
                priceTrends.forEach(trend => {
                    trend.monthlyData.forEach(data => {
                        if (!months.includes(data.month)) {
                            months.push(data.month);
                        }
                    });
                });
                months.sort();

                // สร้าง datasets สำหรับแต่ละประเภทขยะ
                const trendColors = [
                    'rgba(54, 162, 235, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(255, 99, 132, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    'rgba(199, 199, 199, 1)'
                ];

                priceTrends.slice(0, 5).forEach((trend, index) => {
                    const data = months.map(month => {
                        const monthData = trend.monthlyData.find(d => d.month === month);
                        return monthData ? Math.round(monthData.avgPrice * 100) / 100 : null;
                    });

                    datasets.push({
                        label: trend._id,
                        data: data,
                        borderColor: trendColors[index],
                        backgroundColor: trendColors[index].replace('1)', '0.1)'),
                        tension: 0.4,
                        fill: false,
                        pointBackgroundColor: trendColors[index],
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    });
                });

                new Chart(priceTrendCtx, {
                    type: 'line',
                    data: {
                        labels: months.map(month => {
                            const [year, monthNum] = month.split('-');
                            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
                                              'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                            return monthNames[parseInt(monthNum) - 1] + ' ' + year.slice(-2);
                        }),
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: false,
                                title: {
                                    display: true,
                                    text: 'ราคา (บาท/กก.)',
                                    font: {
                                        size: 12
                                    }
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'เดือน',
                                    font: {
                                        size: 12
                                    }
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 15,
                                    padding: 15,
                                    font: {
                                        size: 12
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.dataset.label || '';
                                        const value = context.raw || 0;
                                        return `${label}: ฿${value} ต่อกิโลกรัม`;
                                    }
                                },
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff'
                            }
                        },
                        animation: {
                            duration: 2000,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            }

            // Event listener for export report button
            document.getElementById('exportReport').addEventListener('click', function() {
                Swal.fire({
                    title: 'ส่งออกรายงาน',
                    text: 'เลือกรูปแบบรายงานที่ต้องการ',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'PDF',
                    cancelButtonText: 'Excel',
                    showDenyButton: true,
                    denyButtonText: 'ยกเลิก',
                    denyButtonColor: '#6c757d'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/employee/dashboard/export/pdf';
                    } else if (result.isDismissed && result.dismiss === Swal.DismissReason.cancel) {
                        window.location.href = '/employee/dashboard/export/excel';
                    }
                });
            });

            // Event listener for refresh button
            document.getElementById('refreshData').addEventListener('click', function() {
                // แสดง loading
                const originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>กำลังโหลด...';
                this.disabled = true;
                
                // รีเฟรชหน้า
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            });

            // Auto refresh every 5 minutes
            setInterval(function() {
                console.log('Auto refreshing dashboard data...');
                // แสดง toast notification
                Swal.fire({
                    title: 'อัพเดทข้อมูล',
                    text: 'กำลังรีเฟรชข้อมูลอัตโนมัติ...',
                    icon: 'info',
                    timer: 2000,
                    timerProgressBar: true,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                }).then(() => {
                    window.location.reload();
                });
            }, 300000); // 5 นาที

            // เพิ่ม animation เมื่อโหลดหน้า
            const cards = document.querySelectorAll('.hover\\:scale-105');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 150);
            });

            // เพิ่ม hover effect สำหรับ table rows
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.01)';
                    this.style.transition = 'transform 0.2s ease';
                });
                
                row.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                });
            });

            // เพิ่ม loading skeleton effect
            function showLoadingSkeleton() {
                const skeletonHTML = `
                    <div class="animate-pulse">
                        <div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div>
                        <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                    </div>
                `;
                // แทนที่ content ด้วย skeleton (ถ้าต้องการ)
            }

            // Real-time clock
            function updateClock() {
                const now = new Date();
                const timeString = now.toLocaleTimeString('th-TH');
                const dateString = now.toLocaleDateString('th-TH', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                
                // อัพเดท clock ถ้ามี element
                const clockElement = document.getElementById('realTimeClock');
                if (clockElement) {
                    clockElement.innerHTML = `${dateString} ${timeString}`;
                }
            }

            // อัพเดท clock ทุกวินาที
            setInterval(updateClock, 1000);
            updateClock(); // เรียกครั้งแรกทันที

            // เพิ่ม real-time notifications (ถ้าต้องการ)
            function checkForUpdates() {
                // ตรวจสอบการอัพเดทใหม่จาก server
                // และแสดง notification ถ้ามีข้อมูลใหม่
            }

            // ตรวจสอบการอัพเดททุก 30 วินาที
            setInterval(checkForUpdates, 30000);

            // เพิ่ม smooth scrolling สำหรับ anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Ctrl/Cmd + R สำหรับ refresh
                if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
                    e.preventDefault();
                    document.getElementById('refreshData').click();
                }
                
                // Ctrl/Cmd + E สำหรับ export
                if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
                    e.preventDefault();
                    document.getElementById('exportReport').click();
                }
            });

            // เพิ่ม error handling สำหรับ charts
            Chart.defaults.plugins.legend.onError = function(error) {
                console.error('Chart error:', error);
                Swal.fire({
                    icon: 'warning',
                    title: 'เกิดปัญหาในการแสดงกราฟ',
                    text: 'กรุณารีเฟรชหน้าเว็บ',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            };

            console.log('Dashboard initialized successfully');
        });

        // เพิ่มฟังก์ชัน utility
        function formatNumber(num) {
            return new Intl.NumberFormat('th-TH').format(num);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('th-TH', { 
                style: 'currency', 
                currency: 'THB' 
            }).format(amount);
        }

        function getPercentageColor(percentage) {
            if (percentage > 0) return 'text-green-500';
            if (percentage < 0) return 'text-red-500';
            return 'text-gray-500';
        }

        // Export functions สำหรับใช้ในส่วนอื่นๆ
        window.dashboardUtils = {
            formatNumber,
            formatCurrency,
            getPercentageColor
        };
    </script>

    <style>
        /* Custom CSS สำหรับ Dashboard */
        .content {
            transition: margin-left 0.3s ease;
        }
        
        .hover\:scale-105:hover {
            transform: scale(1.05);
        }
        
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        
        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: .5;
            }
        }
        
        /* Custom scrollbar */
        .overflow-x-auto::-webkit-scrollbar {
            height: 6px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }
        
        .overflow-x-auto::-webkit-scrollbar-thumb:hover {
            background: #a1a1a1;
        }
        
        /* Chart container styling */
        canvas {
            max-height: 100% !important;
        }
        
        /* Responsive table */
        @media (max-width: 768px) {
            .overflow-x-auto table {
                min-width: 600px;
            }
        }
        
        /* Loading animation */
        .fa-spinner {
            animation: fa-spin 1s infinite linear;
        }
        
        @keyframes fa-spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
        
        /* Card hover effects */
        .transition-transform {
            transition: transform 0.3s ease;
        }
        
        /* Toast notifications positioning */
        .swal2-top-end {
            top: 20px !important;
            right: 20px !important;
        }
    </style>
</body>
</html>