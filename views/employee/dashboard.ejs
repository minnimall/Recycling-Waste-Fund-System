                            </div>
                            <div class="flex items-center text-gray-500">
                                <i class="fas fa-equals mr-1"></i>
                                <span>0%</span>
                            </div>
                        </div>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center">
