                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-green-500 mr-2"></div>
                                        <div class="text-sm font-medium text-gray-900">กระดาษ</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">450</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">฿5</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">฿2,250</td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-yellow-500 mr-2"></div>
                                        <div class="text-sm font-medium text-gray-900">โลหะ</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">120</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">฿15</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">฿1,800</td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-red-500 mr-2"></div>
                                        <div class="text-sm font-medium text-gray-900">แก้ว</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">80</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">฿3</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">฿240</td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="h-3 w-3 rounded-full bg-purple-500 mr-2"></div>
                                        <div class="text-sm font-medium text-gray-900">อื่นๆ</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">60</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">฿1</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">฿60</td>
                            </tr>
                        </tbody>
                        <tfoot class="bg-gray-50">
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">รวมทั้งหมด</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">1,030 กก.</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium text-green-600">฿12,350</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section 3: Price Prediction -->
        <!-- <div class="mx-4 bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">การพยากรณ์ราคาขยะในอนาคต</h2>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2">
                    <div class="h-80">
                        <canvas id="pricePredictionChart"></canvas>
                    </div>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <h3 class="font-semibold text-gray-800 mb-3">แนวโน้มราคาขยะ</h3>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <div class="flex items-center">
                                <div class="h-3 w-3 rounded-full bg-blue-500 mr-2"></div>
                                <span class="text-sm">พลาสติก PET</span>
                            </div>
