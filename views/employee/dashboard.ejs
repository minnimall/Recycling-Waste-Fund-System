<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/dashboard.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chart.js 3D plugin -->
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-3d@1.0.0/dist/chartjs-plugin-3d.min.js"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745', // สีเขียวสำหรับความสำเร็จ
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <!-- Main content -->
    <div class="content bg-gray-50 min-screen">
        <!-- Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-semibold text-gray-800">แดชบอร์ด</h1>
                <p class="text-gray-500">ข้อมูลสรุปและการวิเคราะห์</p>
            </div>
            <div class="flex space-x-2">
                <!-- <select id="timeRange" class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                    <option value="today">วันนี้</option>
                    <option value="week">สัปดาห์นี้</option>
                    <option value="month">เดือนนี้</option>
                    <option value="year">ปีนี้</option>
                </select> -->
                <button id="refreshData" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors">
                    <i class="fas fa-sync-alt mr-2"></i>รีเฟรช
                </button>
            </div>
        </div>

        <!-- Stats cards -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-blue-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ปริมาณขยะทั้งหมด (เดือนที่แล้ว)</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            <%= totalWaste %> <span class="text-sm font-normal">กก.</span>
                        </h2>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <i class="fas fa-trash text-blue-500"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <% if (percentChange >= 0) { %>
                        <span class="text-green-500 flex items-center">
                            <i class="fas fa-arrow-up mr-1"></i> <%= percentChange %>%
                        </span>
                    <% } else { %>
                        <span class="text-red-500 flex items-center">
                            <i class="fas fa-arrow-down mr-1"></i> <%= Math.abs(percentChange) %>%
                        </span>
                    <% } %>
                    <span class="text-gray-400 ml-2">เทียบกับเดือนก่อนหน้า</span>
                </div>
            </div>
            
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-green-500 transition-transform hover:scale-105">
            <div class="flex justify-between items-start">
                <div>
                <p class="text-gray-500 mb-1">ยอดรับซื้อวันนี้</p>
                <h2 class="text-3xl font-bold text-gray-800">
                    ฿<%= todayTotal.toLocaleString() %>
                </h2>
                </div>
                <div class="p-3 bg-green-100 rounded-full">
                <i class="fas fa-money-bill-wave text-green-500"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center">
