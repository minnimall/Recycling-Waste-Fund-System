<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
        <style>
            .content {
                margin-left: 0;
                padding: 20px;
            }

            .route-card {
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .route-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            }
        </style>
</head>

<body>

    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>

            <script>
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <main class="content bg-gray-50 min-screen">
                <!-- Page Header -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                                เส้นทางที่บันทึกไว้ทั้งหมด
                            </h1>
                            <p class="text-gray-600 mt-2">จัดการและดูเส้นทางที่คุณบันทึกไว้</p>
                        </div>
                        <div class="mt-4 md:mt-0">
                            <a href="/employee/map"
                                class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition shadow-md">
                                สร้างเส้นทางใหม่
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="mx-4 bg-blue-50 rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium text-blue-600">จำนวนเส้นทางทั้งหมด</p>
                                <p class="text-2xl font-bold text-blue-900">
                                    <%= routes.length %>
                                </p>
                            </div>
                            <ion-icon name="map" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-green-100 text-sm">ระยะทางรวม</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.totalDistance, 0).toFixed(2) %> กม.
                                </p>
                            </div>
                            <ion-icon name="speedometer" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-purple-100 text-sm">จุดทั้งหมด</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.numberOfPoints, 0) %> จุด
                                </p>
                            </div>
                            <ion-icon name="location" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>
                </div> -->

                <!-- Filter and Search -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <input type="text" id="searchInput" placeholder="ค้นหาชื่อเส้นทางหรือหมายเหตุ..."
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        <div>
                            <select id="sortSelect"
                                class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="newest">ล่าสุด</option>
                                <option value="oldest">เก่าสุด</option>
                                <option value="distance-desc">ระยะทางมาก-น้อย</option>
                                <option value="distance-asc">ระยะทางน้อย-มาก</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Routes List -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="mx-4 mb-6">
                    <% if (routes.length===0) { %>
                        <!-- Empty State -->
                        <div class="bg-white rounded-lg shadow-lg p-12 text-center">
                            <ion-icon name="map-outline" class="text-gray-300 text-8xl mb-4"></ion-icon>
                            <h3 class="text-2xl font-semibold text-gray-700 mb-2">ยังไม่มีเส้นทางที่บันทึก</h3>
                            <p class="text-gray-500 mb-6">เริ่มต้นสร้างเส้นทางแรกของคุณตอนนี้</p>
                            <!-- <a href="/employee/map"
                                class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
                                <ion-icon name="add-circle-outline" class="mr-2"></ion-icon>
                                สร้างเส้นทางใหม่
                            </a> -->
                        </div>
                        <% } else { %>
                            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                                    <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                                        จำนวนเส้นทางทั้งหมด <span class="text-blue-600 text-base font-normal">
                                            <%= routes.length %> รายการ
                                        </span>
                                    </h2>
                                </div>
                            <!-- Routes Grid -->
                            <div id="routesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                <% routes.forEach(route => { %>
                                    <div class="rounded-lg border  
                                        <%= route.isAllComplete
                                            ? 'border-green-400 bg-green-50'
                                            : 'border-gray-200 bg-white'
                                        %>"
                                    
                                        data-name="<%= route.routeName.toLowerCase() %>"
                                        data-date="<%= new Date(route.createdAt).getTime() %>"
                                        data-distance="<%= route.totalDistance %>">
                                        
                                        <!-- Card Header -->
                                        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50
                                            <%= route.isAllComplete
                                                ? 'border-green-400 bg-green-50'
                                                : 'border-gray-200 bg-white'
                                            %>"
                                        ">
                                            <h3 class="font-semibold text-lg text-gray-900 truncate mb-1" title="<%= route.routeName %>">
                                                <%= route.routeName %>
                                            </h3>
                                            <div class="flex items-center text-gray-500 text-xs">
                                                <span>วันที่ <%= new Date(route.createdAt).toLocaleDateString('th-TH', {
                                                    year: 'numeric', month: 'long', day: 'numeric'
                                                }) %></span>
                                            </div>
                                        </div>

                                        <!-- Card Body -->
                                        <div class="p-6">
                                            <!-- Route Statistics -->
                                            <div class="space-y-3 mb-5">
                                                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                                                    <div class="flex items-center text-gray-600 text-sm">
                                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                                                        </svg>
                                                        <span>ระยะทาง</span>
                                                    </div>
                                                    <span class="font-semibold text-gray-900"><%= route.totalDistance.toFixed(2) %> กม.</span>
                                                </div>
                                                
                                                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                                                    <div class="flex items-center text-gray-600 text-sm">
                                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        </svg>
                                                        <span>เวลา</span>
                                                    </div>
                                                    <span class="font-semibold text-gray-900"><%= Math.round(route.totalDuration) %> นาที</span>
                                                </div>
                                                
                                                <div class="flex items-center justify-between py-2">
                                                    <div class="flex items-center text-gray-600 text-sm">
                                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                        </svg>
                                                        <span>จำนวนจุดหมาย</span>
                                                    </div>
                                                    <span class="font-semibold text-gray-900"><%= route.numberOfPoints %> จุด</span>
                                                </div>
                                            </div>

                                            <!-- Note Section -->
                                                <div class="bg-gray-50 border border-gray-200 p-3 mb-5 rounded">
                                                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">หมายเหตุ</p>
                                                    <p class="text-sm text-gray-700 leading-relaxed line-clamp-2">
                                                        <%= route.note || 'ไม่ระบุ' %>
                                                    </p>
                                                </div>

                                            <!-- Action Buttons -->
                                            <div class="flex gap-2 pt-2">
                                                <a href="/employee/routeList/<%= route._id %>"
                                                    class="flex-1 bg-gray-700 hover:bg-gray-800 text-white text-center py-2.5 px-4 rounded transition-colors duration-150 text-sm font-medium flex items-center justify-center gap-2">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                    </svg>
                                                    <span>ดูรายละเอียด</span>
                                                </a>
                                                <button
                                                    onclick="deleteRoute('<%= route._id %>', '<%= route.routeName %>')"
                                                    class="bg-white hover:bg-red-50 text-red-600 border border-red-200 hover:border-red-300 py-2.5 px-4 rounded transition-colors duration-150">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                    </svg>
                                                </button>
                                            </div>
                                            <div class="flex gap-2 pt-2">
                                                <button 
                                                    onclick="completeAllPoints('<%= route._id %>')"
                                                    class="w-full bg-green-600 hover:bg-green-700 text-white border border-green-700 hover:border-green-800 py-2.5 px-4 rounded transition-colors duration-150">
                                                    เสร็จสิ้น
                                                </button> 
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>

            <script>

                async function completeAllPoints(routeId) {
                    // แสดงกล่องยืนยันก่อนทำรายการ
                    const result = await Swal.fire({
                        title: 'ยืนยันเสร็จสิ้นทั้งหมด?',
                        text: "คุณต้องการเปลี่ยนสถานะทุกจุดให้เป็น 'เสร็จสิ้น' ใช่หรือไม่?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#ef4444',
                        confirmButtonText: 'ใช่, เสร็จสิ้นทั้งหมด!',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (result.isConfirmed) {
                        try {
                            Swal.showLoading();
                            
                            const response = await fetch(`/employee/routeList/${routeId}/complete-all`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' }
                            });

                            const data = await response.json();

                            if (data.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: 'เรียบร้อย!',
                                    text: 'อัปเดตสถานะทุกจุดในเส้นทางแล้ว',
                                    timer: 1500
                                });
                                // รีโหลดหน้าเพื่อให้ UI อัปเดตทั้งหมด
                                window.location.reload();
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            Swal.fire('ผิดพลาด', 'ไม่สามารถอัปเดตสถานะได้', 'error');
                        }
                    }
                }
                // Search functionality
                document.getElementById('searchInput').addEventListener('input', function (e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const cards = document.querySelectorAll('.route-card');

                    cards.forEach(card => {
                        const name = card.dataset.name;
                        if (name.includes(searchTerm)) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });

                // Sort functionality
                document.getElementById('sortSelect').addEventListener('change', function (e) {
                    const sortType = e.target.value;
                    const grid = document.getElementById('routesGrid');
                    const cards = Array.from(document.querySelectorAll('.route-card'));

                    cards.sort((a, b) => {
                        switch (sortType) {
                            case 'newest':
                                return parseInt(b.dataset.date) - parseInt(a.dataset.date);
                            case 'oldest':
                                return parseInt(a.dataset.date) - parseInt(b.dataset.date);
                            case 'distance-desc':
                                return parseFloat(b.dataset.distance) - parseFloat(a.dataset.distance);
                            case 'distance-asc':
                                return parseFloat(a.dataset.distance) - parseFloat(b.dataset.distance);
                            default:
                                return 0;
                        }
                    });

                    // Re-append sorted cards
                    cards.forEach(card => grid.appendChild(card));
                });

                // Delete route function
                async function deleteRoute(routeId, routeName) {
                    const result = await Swal.fire({
                        title: 'ยืนยันการลบ?',
                        html: `ต้องการลบเส้นทาง <strong>"${routeName}"</strong> หรือไม่?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#EF4444',
                        cancelButtonColor: '#6B7280',
                        confirmButtonText: 'ยืนยัน',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/employee/routeList/${routeId}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ!',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'ไม่สามารถลบเส้นทางได้',
                                confirmButtonText: 'ตกลง'
                            });
                        }
                    }
                }
            </script>
</body>

</html>