        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
        <style>
            .content {
                margin-left: 0;
                padding: 20px;
            }

            .route-card {
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .route-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            }
        </style>
</head>

<body>

    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>

            <script>
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <main class="content bg-gray-50 min-screen">
                <!-- Page Header -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                                เส้นทางที่บันทึกไว้ทั้งหมด
                            </h1>
                            <p class="text-gray-600 mt-2">จัดการและดูเส้นทางที่คุณบันทึกไว้</p>
                        </div>
                        <div class="mt-4 md:mt-0">
                            <a href="/employee/map"
                                class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition shadow-md">
                                <ion-icon name="add-circle-outline" class="mr-2 text-xl"></ion-icon>
                                สร้างเส้นทางใหม่
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="mx-4 bg-blue-50 rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium text-blue-600">จำนวนเส้นทางทั้งหมด</p>
                                <p class="text-2xl font-bold text-blue-900">
                                    <%= routes.length %>
                                </p>
                            </div>
                            <ion-icon name="map" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-green-100 text-sm">ระยะทางรวม</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.totalDistance, 0).toFixed(2) %> กม.
                                </p>
                            </div>
                            <ion-icon name="speedometer" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-purple-100 text-sm">จุดทั้งหมด</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.numberOfPoints, 0) %> จุด
                                </p>
                            </div>
                            <ion-icon name="location" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>
                </div> -->

                <!-- Filter and Search -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <input type="text" id="searchInput" placeholder="ค้นหาชื่อเส้นทางหรือหมายเหตุ..."
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        <div>
                            <select id="sortSelect"
                                class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="newest">ล่าสุด</option>
                                <option value="oldest">เก่าสุด</option>
                                <option value="distance-desc">ระยะทางมาก-น้อย</option>
                                <option value="distance-asc">ระยะทางน้อย-มาก</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Routes List -->
                <div class="mx-4 mb-6">
                    <% if (routes.length===0) { %>
                        <!-- Empty State -->
                        <div class="bg-white rounded-lg shadow-lg p-12 text-center">
                            <ion-icon name="map-outline" class="text-gray-300 text-8xl mb-4"></ion-icon>
                            <h3 class="text-2xl font-semibold text-gray-700 mb-2">ยังไม่มีเส้นทางที่บันทึก</h3>
                            <p class="text-gray-500 mb-6">เริ่มต้นสร้างเส้นทางแรกของคุณตอนนี้</p>
                            <!-- <a href="/employee/map"
                                class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
                                <ion-icon name="add-circle-outline" class="mr-2"></ion-icon>
                                สร้างเส้นทางใหม่
                            </a> -->
                        </div>
                        <% } else { %>
                            <!-- Routes Grid -->
                            <div id="routesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                                <% routes.forEach(route => { %>
                                    <div class="route-card bg-white rounded-xl border border-gray-200 overflow-hidden"
                                        data-name="<%= route.routeName.toLowerCase() %>"
                                        data-date="<%= new Date(route.createdAt).getTime() %>"
                                        data-distance="<%= route.totalDistance %>">
                                        
                                        <!-- Card Header -->
                                        <div class="bg-gradient-to-br from-slate-700 via-slate-800 to-slate-900 px-6 py-5 border-b border-slate-600">
                                            <h3 class="font-semibold text-xl text-white truncate mb-2" title="<%= route.routeName %>">
                                                <%= route.routeName %>
                                            </h3>
                                            <div class="flex items-center text-slate-300 text-sm">
                                                <span><%= new Date(route.createdAt).toLocaleDateString('th-TH', {
                                                    year: 'numeric', month: 'long', day: 'numeric'
                                                }) %></span>
                                            </div>
                                        </div>

                                        <!-- Card Body -->
                                        <div class="p-6">
                                            <!-- Route Statistics -->
                                            <!-- <div class="grid grid-cols-2 gap-4 mb-5">
                                                <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
                                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">ระยะทาง</p>
                                                    <p class="text-2xl font-bold text-slate-800">
                                                        <%= route.totalDistance.toFixed(2) %>
                                                    </p>
                                                    <p class="text-xs text-slate-600 mt-1">กิโลเมตร</p>
                                                </div>
                                                <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg">
                                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">เวลา</p>
                                                    <p class="text-2xl font-bold text-slate-800">
                                                        <%= Math.round(route.totalDuration) %>
                                                    </p>
                                                    <p class="text-xs text-slate-600 mt-1">นาที</p>
                                                </div>
                                            </div>

                                            <div class="bg-slate-50 border border-slate-200 p-4 rounded-lg mb-5">
                                                <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">จำนวนจุดหมาย</p>
                                                <p class="text-2xl font-bold text-slate-800">
                                                    <%= route.numberOfPoints %>
                                                </p>
                                                <p class="text-xs text-slate-600 mt-1">จุด</p>
                                            </div> -->

                                            <!-- Note Section -->
                                            <% if (route.note) { %>
                                                <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-5 rounded-r">
                                                    <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mb-2">หมายเหตุ</p>
                                                    <p class="text-sm text-slate-700 leading-relaxed line-clamp-2">
                                                        <%= route.note %>
                                                    </p>
                                                </div>
                                            <% } %>

                                            <!-- Action Buttons -->
                                            <div class="flex gap-3 pt-2">
                                                <a href="/employee/routeList/<%= route._id %>"
                                                    class="flex-1 bg-gray-500 hover:bg-gray-600 text-white text-center py-3 px-4 rounded-lg transition-colors duration-200 text-sm font-medium flex items-center justify-center gap-2">
                                                    <!-- <ion-icon name="eye-outline" class="text-lg"></ion-icon> -->
                                                    <span>ดูรายละเอียด</span>
                                                </a>
                                                <button
                                                    onclick="deleteRoute('<%= route._id %>', '<%= route.routeName %>')"
                                                    class="delete-btn"> <i class="fa fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                </div>
            </main>

            <script>
                // Search functionality
                document.getElementById('searchInput').addEventListener('input', function (e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const cards = document.querySelectorAll('.route-card');

                    cards.forEach(card => {
                        const name = card.dataset.name;
                        if (name.includes(searchTerm)) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });

                // Sort functionality
                document.getElementById('sortSelect').addEventListener('change', function (e) {
                    const sortType = e.target.value;
                    const grid = document.getElementById('routesGrid');
                    const cards = Array.from(document.querySelectorAll('.route-card'));

                    cards.sort((a, b) => {
                        switch (sortType) {
                            case 'newest':
                                return parseInt(b.dataset.date) - parseInt(a.dataset.date);
                            case 'oldest':
                                return parseInt(a.dataset.date) - parseInt(b.dataset.date);
                            case 'distance-desc':
                                return parseFloat(b.dataset.distance) - parseFloat(a.dataset.distance);
                            case 'distance-asc':
                                return parseFloat(a.dataset.distance) - parseFloat(b.dataset.distance);
                            default:
                                return 0;
                        }
                    });

                    // Re-append sorted cards
                    cards.forEach(card => grid.appendChild(card));
                });

                // Delete route function
                async function deleteRoute(routeId, routeName) {
                    const result = await Swal.fire({
                        title: 'ยืนยันการลบ?',
                        html: `ต้องการลบเส้นทาง <strong>"${routeName}"</strong> หรือไม่?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#EF4444',
                        cancelButtonColor: '#6B7280',
                        confirmButtonText: 'ลบเลย',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/employee/routeList/${routeId}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ!',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'ไม่สามารถลบเส้นทางได้',
                                confirmButtonText: 'ตกลง'
                            });
                        }
                    }
                }
            </script>
</body>

</html>