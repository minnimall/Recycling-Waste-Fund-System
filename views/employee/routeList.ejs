<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <link rel="stylesheet" href="/style_employee/res_req.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
        <style>
            .content {
                margin-left: 0;
                padding: 20px;
            }

            .route-card {
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .route-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            }

            .filter-tab {
                color: #6B7280;
                background: transparent;
            }
            .filter-tab:hover {
                background: #F3F4F6;
            }
            .filter-tab.active-tab {
                background: #EFF6FF;
                color: #2563EB;
                font-weight: 600;
            }
        </style>
</head>

<body>

    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>

            <script>
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <main class="content bg-gray-50 min-screen">
                <!-- Page Header -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                                เส้นทางที่บันทึกไว้ทั้งหมด
                            </h1>
                            <p class="text-gray-600 mt-2">จัดการและดูเส้นทางที่คุณบันทึกไว้</p>
                        </div>
                        <div class="mt-4 md:mt-0">
                            <a href="/employee/map"
                                class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition shadow-md">
                                <ion-icon name="add-outline" class="text-2xl mr-2"></ion-icon>
                                สร้างเส้นทางใหม่
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="mx-4 bg-blue-50 rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium text-blue-600">จำนวนเส้นทางทั้งหมด</p>
                                <p class="text-2xl font-bold text-blue-900">
                                    <%= routes.length %>
                                </p>
                            </div>
                            <ion-icon name="map" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-green-100 text-sm">ระยะทางรวม</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.totalDistance, 0).toFixed(2) %> กม.
                                </p>
                            </div>
                            <ion-icon name="speedometer" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>

                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-purple-100 text-sm">จุดทั้งหมด</p>
                                <p class="text-3xl font-bold mt-2">
                                    <%= routes.reduce((sum, r)=> sum + r.numberOfPoints, 0) %> จุด
                                </p>
                            </div>
                            <ion-icon name="location" class="text-5xl opacity-50"></ion-icon>
                        </div>
                    </div>
                </div> -->

                <!-- Filter Tabs -->
                <div class="mx-4 mb-4">
                    <div class="bg-white rounded-lg shadow p-2 flex gap-2 overflow-x-auto">
                        <button onclick="filterByStatus('all')" id="tab-all"
                            class="filter-tab active-tab flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-all whitespace-nowrap">
                            <ion-icon name="list-outline"></ion-icon>
                            ทั้งหมด
                            <span class="tab-count bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-xs font-bold"><%= routes.length %></span>
                        </button>
                        <button onclick="filterByStatus('active')" id="tab-active"
                            class="filter-tab flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-all whitespace-nowrap">
                            <ion-icon name="time-outline"></ion-icon>
                            กำลังดำเนินการ
                            <span class="tab-count bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full text-xs font-bold"><%= routes.filter(r => !r.isAllComplete).length %></span>
                        </button>
                        <button onclick="filterByStatus('completed')" id="tab-completed"
                            class="filter-tab flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-all whitespace-nowrap">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            เสร็จสิ้นแล้ว
                            <span class="tab-count bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-xs font-bold"><%= routes.filter(r => r.isAllComplete).length %></span>
                        </button>
                    </div>
                </div>

                <!-- Filter and Search -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <input type="text" id="searchInput" placeholder="ค้นหาชื่อเส้นทางหรือหมายเหตุ..."
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        <div>
                            <select id="sortSelect"
                                class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="newest">ล่าสุด</option>
                                <option value="oldest">เก่าสุด</option>
                                <option value="distance-desc">ระยะทางมาก-น้อย</option>
                                <option value="distance-asc">ระยะทางน้อย-มาก</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Routes List -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="mx-4 mb-6">
                    <% if (routes.length===0) { %>
                        <!-- Empty State -->
                        <div class="bg-white rounded-lg shadow-lg p-12 text-center">
                            <ion-icon name="map-outline" class="text-gray-300 text-8xl mb-4"></ion-icon>
                            <h3 class="text-2xl font-semibold text-gray-700 mb-2">ยังไม่มีเส้นทางที่บันทึก</h3>
                            <p class="text-gray-500 mb-6">เริ่มต้นสร้างเส้นทางแรกของคุณตอนนี้</p>
                            <!-- <a href="/employee/map"
                                class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
                                <ion-icon name="add-circle-outline" class="mr-2"></ion-icon>
                                สร้างเส้นทางใหม่
                            </a> -->
                        </div>
                        <% } else { %>
                            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                                    <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                                        จำนวนเส้นทางทั้งหมด <span class="text-blue-600 text-base font-normal">
                                            <%= routes.length %> รายการ
                                        </span>
                                    </h2>
                                </div>
                            <!-- Routes Grid -->
                            <div id="routesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                                <% routes.forEach(route => { %>
                                    <div class="route-card group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col h-full relative"
                                        data-name="<%= route.routeName.toLowerCase() %>"
                                        data-date="<%= new Date(route.createdAt).getTime() %>"
                                        data-distance="<%= route.totalDistance %>"
                                        data-status="<%= route.isAllComplete ? 'completed' : 'active' %>">
                                        
                                        <!-- Status Strip -->
                                        <div class="absolute top-0 left-0 w-full h-1 <%= route.isAllComplete ? 'bg-green-500' : 'bg-blue-500' %>"></div>

                                        <!-- Card Header -->
                                        <div class="px-6 pt-6 pb-4">
                                            <div class="flex justify-between items-start mb-2">
                                                <div class="p-2.5 rounded-xl <%= route.isAllComplete ? 'bg-green-100 text-green-600' : 'bg-blue-100 text-blue-600' %>">
                                                    <ion-icon name="<%= route.isAllComplete ? 'checkmark-circle' : 'map' %>" class="text-2xl"></ion-icon>
                                                </div>
                                                <!-- Date Badge -->
                                                <span class="px-3 py-1 bg-gray-50 text-gray-500 rounded-full text-xs font-medium border border-gray-100">
                                                    <%= new Date(route.createdAt).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' }) %>
                                                </span>
                                            </div>
                                            
                                            <h3 class="font-bold text-lg text-gray-800 mb-1 line-clamp-1 group-hover:text-blue-600 transition-colors" title="<%= route.routeName %>">
                                                <%= route.routeName %>
                                            </h3>
                                            
                                            <div class="flex items-center gap-2">
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs font-medium <%= route.isAllComplete ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-yellow-50 text-yellow-700 border border-yellow-100' %>">
                                                    <span class="w-1.5 h-1.5 rounded-full <%= route.isAllComplete ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
                                                    <%= route.isAllComplete ? 'เสร็จสิ้นแล้ว' : 'กำลังดำเนินการ' %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Divider -->
                                        <div class="px-6"><div class="border-t border-gray-100 border-dashed"></div></div>

                                        <!-- Card Stats -->
                                        <div class="p-6 grid grid-cols-2 gap-4">
                                            <div class="space-y-1">
                                                <p class="text-xs text-gray-400">ระยะทาง</p>
                                                <div class="flex items-center gap-1.5">
                                                    <ion-icon name="navigate" class="text-blue-500"></ion-icon>
                                                    <span class="font-semibold text-gray-700"><%= route.totalDistance.toFixed(2) %> <span class="text-xs font-normal text-gray-400">กม.</span></span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <p class="text-xs text-gray-400">จุดหมาย</p>
                                                <div class="flex items-center gap-1.5">
                                                    <ion-icon name="location" class="text-red-500"></ion-icon>
                                                    <span class="font-semibold text-gray-700"><%= route.numberOfPoints %> <span class="text-xs font-normal text-gray-400">จุด</span></span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <p class="text-xs text-gray-400">เวลาโดยประมาณ</p>
                                                <div class="flex items-center gap-1.5">
                                                    <ion-icon name="time" class="text-orange-500"></ion-icon>
                                                    <span class="font-semibold text-gray-700"><%= Math.round(route.totalDuration) %> <span class="text-xs font-normal text-gray-400">นาที</span></span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card Footer (Note & Actions) -->
                                        <div class="mt-auto bg-gray-50/50 p-4 border-t border-gray-100">
                                            <% if (route.note) { %>
                                                <div class="mb-4">
                                                    <p class="text-xs text-gray-400 mb-1 flex items-center gap-1">
                                                        <ion-icon name="document-text-outline"></ion-icon> หมายเหตุ
                                                    </p>
                                                    <p class="text-sm text-gray-600 line-clamp-2 italic bg-white p-2 rounded border border-gray-100">
                                                        "<%= route.note %>"
                                                    </p>
                                                </div>
                                            <% } %>

                                            <div class="grid grid-cols-2 gap-2">
                                                <a href="/employee/routeDetail/<%= route._id %>" 
                                                    class="col-span-2 flex items-center justify-center gap-2 w-full py-2.5 bg-white border border-gray-200 text-gray-700 rounded-xl hover:bg-blue-50 hover:border-blue-200 hover:text-blue-600 transition-all font-medium text-sm shadow-sm">
                                                    <ion-icon name="eye-outline" class="text-lg"></ion-icon>
                                                    รายละเอียด
                                                </a>
                                                
                                                <% if (!route.isAllComplete) { %>
                                                    <button onclick="completeAllPoints('<%= route._id %>')"
                                                        class="flex items-center justify-center gap-2 w-full py-2.5 bg-green-600 text-white rounded-xl hover:bg-green-700 hover:shadow-lg hover:shadow-green-200 transition-all font-medium text-sm">
                                                        <ion-icon name="checkmark-done-circle-outline" class="text-lg"></ion-icon>
                                                        เสร็จสิ้น
                                                    </button>
                                                <% } else { %>
                                                    <button disabled
                                                        class="col-span-2 flex items-center justify-center gap-2 w-full py-2.5 bg-gray-100 text-gray-400 rounded-xl cursor-not-allowed font-medium text-sm">
                                                        <ion-icon name="checkmark-circle" class="text-lg"></ion-icon>
                                                        เรียบร้อย
                                                    </button>
                                                <% } %>

                                                <button onclick="deleteRoute('<%= route._id %>', '<%= route.routeName %>')"
                                                    class="<%= route.isAllComplete ? 'col-span-2' : 'col-span-1' %> flex items-center justify-center gap-2 w-full py-2.5 bg-red-50 text-red-600 border border-red-100 rounded-xl hover:bg-red-100 hover:border-red-200 transition-all font-medium text-sm">
                                                    <ion-icon name="trash-outline" class="text-lg"></ion-icon>
                                                    <%= route.isAllComplete ? 'ลบรายการ' : 'ลบ' %>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>

            <script>

                async function completeAllPoints(routeId) {
                    // แสดงกล่องยืนยันก่อนทำรายการ
                    const result = await Swal.fire({
                        title: 'ยืนยันเสร็จสิ้นทั้งหมด?',
                        text: "คุณต้องการเปลี่ยนสถานะทุกจุดให้เป็น 'เสร็จสิ้น' ใช่หรือไม่?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#ef4444',
                        confirmButtonText: 'ยืนยัน',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (result.isConfirmed) {
                        try {
                            Swal.showLoading();
                            
                            const response = await fetch(`/employee/routeList/${routeId}/complete-all`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' }
                            });

                            const data = await response.json();

                            if (data.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: 'เรียบร้อย!',
                                    text: 'อัปเดตสถานะทุกจุดในเส้นทางแล้ว',
                                    timer: 1500
                                });
                                // รีโหลดหน้าเพื่อให้ UI อัปเดตทั้งหมด
                                window.location.reload();
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            Swal.fire('ผิดพลาด', 'ไม่สามารถอัปเดตสถานะได้', 'error');
                        }
                    }
                }
                // Tab filter state
                let currentFilter = 'all';

                function filterByStatus(status) {
                    currentFilter = status;

                    // Update active tab
                    document.querySelectorAll('.filter-tab').forEach(tab => tab.classList.remove('active-tab'));
                    document.getElementById(`tab-${status}`).classList.add('active-tab');

                    applyFilters();
                }

                function applyFilters() {
                    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                    const cards = document.querySelectorAll('.route-card');
                    let visibleCount = 0;

                    cards.forEach(card => {
                        const matchesSearch = card.dataset.name.includes(searchTerm);
                        const matchesFilter = currentFilter === 'all' || card.dataset.status === currentFilter;
                        const show = matchesSearch && matchesFilter;
                        card.style.display = show ? '' : 'none';
                        if (show) visibleCount++;
                    });
                }

                // Search functionality
                document.getElementById('searchInput').addEventListener('input', function (e) {
                    applyFilters();
                });

                // Sort functionality
                document.getElementById('sortSelect').addEventListener('change', function (e) {
                    const sortType = e.target.value;
                    const grid = document.getElementById('routesGrid');
                    const cards = Array.from(document.querySelectorAll('.route-card'));

                    cards.sort((a, b) => {
                        switch (sortType) {
                            case 'newest':
                                return parseInt(b.dataset.date) - parseInt(a.dataset.date);
                            case 'oldest':
                                return parseInt(a.dataset.date) - parseInt(b.dataset.date);
                            case 'distance-desc':
                                return parseFloat(b.dataset.distance) - parseFloat(a.dataset.distance);
                            case 'distance-asc':
                                return parseFloat(a.dataset.distance) - parseFloat(b.dataset.distance);
                            default:
                                return 0;
                        }
                    });

                    // Re-append sorted cards
                    cards.forEach(card => grid.appendChild(card));
                });

                // Delete route function
                async function deleteRoute(routeId, routeName) {
                    const result = await Swal.fire({
                        title: 'ยืนยันการลบ?',
                        html: `ต้องการลบเส้นทาง <strong>"${routeName}"</strong> หรือไม่?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#EF4444',
                        cancelButtonColor: '#6B7280',
                        confirmButtonText: 'ยืนยัน',
                        cancelButtonText: 'ยกเลิก'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/employee/routeList/${routeId}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ!',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: error.message || 'ไม่สามารถลบเส้นทางได้',
                                confirmButtonText: 'ตกลง'
                            });
                        }
                    }
                }
            </script>
</body>

</html>