<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/funeral-assistance.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body class="bg-gray-50">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>

    <script>
        // แสดง popup message จาก query string
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');

            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ!',
                    text: decodeURIComponent(successMessage),
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#28a745',
                    timer: 3000
                }).then(() => {
                    window.history.replaceState({}, document.title, window.location.pathname);
                });
            }

            if (errorMessage) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: decodeURIComponent(errorMessage),
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#dc3545',
                }).then(() => {
                    window.history.replaceState({}, document.title, window.location.pathname);
                });
            }
        });
    </script>

    <div class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        เบิกถอนเงิน
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการเบิกถอนเงินการขายขยะสำหรับครัวเรือนในชุมชน</p>
                </div>
                <!-- ปุ่มตั้งค่ายอดขั้นต่ำ -->
                <button onclick="openSettingsModal()" 
                    class="mt-4 md:mt-0 bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition flex items-center">
                    <ion-icon name="settings-outline" class="mr-2"></ion-icon>
                    ตั้งค่ายอดขั้นต่ำ
                </button>
            </div>
            <!-- แสดงยอดขั้นต่ำปัจจุบัน -->
            <div class="mt-4">
                <p class="text-sm text-gray-800">
                    <ion-icon name="information-circle-outline" class="align-middle"></ion-icon>
                    <strong>ยอดเงินขั้นต่ำในบัญชีปัจจุบัน:</strong> 
                    <span id="currentMinimumDisplay" class="font-bold text-gray-900"><%= minimumWithdrawAmount || 300 %> บาท</span>
                    (บัญชีต้องมีเงินคงเหลือไม่ต่ำกว่านี้หลังการถอน)
                </p>
            </div>
        </div>

        <div class="mx-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- ส่วนค้นหาบัญชี -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center">
                        ค้นหาบัญชี
                    </h2>
                    <div class="space-y-4">
                        <form onsubmit="event.preventDefault(); searchAccount();">
                            <div>
                                <div class="flex">
                                    <input type="text" id="accountId" name="accountId"
                                        class="flex-1 rounded-l-md border-gray-300 shadow-sm focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50 p-3"
                                        placeholder="กรอกเลขบัญชี" required>
                                    <button type="submit"
                                        class="bg-green-600 text-white px-4 py-2 rounded-r-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition">
                                        <ion-icon name="search-outline"></ion-icon>
                                    </button>
                                </div>
                            </div>
                            <div class="text-sm text-gray-600 mt-3">
                                <p>* กรอกปีตามด้วยเลขหมู่บ้านและลำดับการสมัคร เช่น 680301</p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ส่วนรายละเอียดบัญชีและการถอนเงิน -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="wallet-outline" class="mr-2 text-gray-600"></ion-icon> รายละเอียดการถอนเงิน
                    </h2>

                    <!-- สถานะกำลังโหลด -->
                    <div id="loadingState" class="hidden py-8">
                        <div class="flex flex-col items-center justify-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600"></div>
                            <p class="mt-4 text-gray-600">กำลังค้นหาข้อมูลบัญชี...</p>
                        </div>
                    </div>

                    <!-- รายละเอียดบัญชี -->
                    <div id="accountDetails" class="hidden">
                        <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-200">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-500">ชื่อเจ้าของบัญชี</p>
                                    <p id="accountName" class="text-lg font-medium text-gray-800">-</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">รหัสบัญชี</p>
                                    <p id="accountNumber" class="text-lg font-medium text-gray-800">-</p>
                                </div>
                                <div class="md:col-span-2">
                                    <p class="text-sm text-gray-500">ยอดเงินในบัญชี (บาท)</p>
                                    <p class="text-2xl font-bold text-green-600">฿ <span id="accountBalance">0.00</span></p>
                                </div>
                                <div class="md:col-span-2">
                                    <p class="text-sm text-gray-500">ยอดเงินขั้นต่ำที่ต้องคงเหลือหลังถอน</p>
                                    <p class="text-2xl font-semibold text-orange-600">฿ <span id="minimumAmount">300.00</span></p>
                                </div>
                            </div>
                        </div>

                        <!-- ฟอร์มถอนเงิน -->
                        <form id="withdrawalForm" class="space-y-4" method="POST" action="/employee/withDraw">
                            <input type="hidden" id="hiddenAccountNumber" name="accountId" value="">

                            <div>
                                <label for="withdrawAmount" class="block text-sm font-medium text-gray-700 mb-1">จำนวนเงินที่ต้องการถอน (บาท)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500">฿</span>
                                    </div>
                                    <input type="number" id="withdrawAmount" name="withdrawAmount"
                                        class="pl-8 py-2 px-4 w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50"
                                        placeholder="0.00" step="0.01" min="0.01" disabled oninput="validateAmount()">
                                </div>
                                <p id="amountError" class="mt-1 text-sm text-red-600"></p>
                                <p id="amountInfo" class="mt-1 text-sm text-gray-500"></p>
                            </div>

                            <div class="pt-4">
                                <button type="submit" id="withdrawButton" disabled
                                    class="w-full bg-green-600 text-white py-3 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition disabled:opacity-50 disabled:cursor-not-allowed">
                                    <ion-icon name="checkmark-circle-outline" class="mr-1"></ion-icon> ยืนยันการถอนเงิน
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ประวัติการถอนเงินล่าสุด -->
        <div class="mx-4 mt-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                    <ion-icon name="time-outline" class="mr-2 text-gray-600"></ion-icon> ประวัติการถอนเงินล่าสุด
                </h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col"
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    วันที่
                                </th>
                                <th scope="col"
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    รหัสบัญชี
                                </th>
                                <th scope="col"
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    ชื่อเจ้าของบัญชี
                                </th>
                                <th scope="col"
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    จำนวนเงิน (ถอน)
                                </th>
                                <th scope="col"
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    สถานะ
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (!transactions || transactions.length === 0) { %>
                            <tr>
                                <td colspan="5" class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500">
                                    ไม่มีข้อมูลการถอนเงิน
                                </td>
                            </tr>
                            <% } else { %>
                            <% transactions.forEach(transaction => { %>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= new Date(transaction.transactionDate).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                    - <%= new Date(transaction.transactionDate).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= transaction.account ? transaction.account.AccountNumber : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= transaction.family ? transaction.family.familyName : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    ฿ <%= Number(transaction.amount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800"><%= transaction.status %></span>
                                </td>
                            </tr>
                            <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal ตั้งค่ายอดขั้นต่ำ -->
    <div id="settingsModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">ตั้งค่ายอดเงินขั้นต่ำ</h3>
                    <button onclick="closeSettingsModal()" class="text-gray-400 hover:text-gray-600">
                        <ion-icon name="close-outline" class="text-2xl"></ion-icon>
                    </button>
                </div>
                <p class="text-sm text-gray-600 mb-4">กำหนดยอดเงินขั้นต่ำที่ต้องคงเหลือในบัญชีหลังการถอนเงิน</p>
                
                <div class="mb-4">
                    <label for="newMinimumAmount" class="block text-sm font-medium text-gray-700 mb-2">
                        ยอดเงินขั้นต่ำ (บาท)
                    </label>
                    <input type="number" id="newMinimumAmount" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="300" min="0" step="0.01" value="<%= minimumWithdrawAmount || 300 %>">
                </div>

                <div class="flex gap-3">
                    <button onclick="closeSettingsModal()" 
                        class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 transition">
                        ยกเลิก
                    </button>
                    <button onclick="saveMinimumAmount()" 
                        class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition">
                        บันทึก
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentMinimumWithdraw = <%= minimumWithdrawAmount || 300 %>;

        function openSettingsModal() {
            document.getElementById('settingsModal').classList.remove('hidden');
            document.getElementById('newMinimumAmount').value = currentMinimumWithdraw;
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

        async function saveMinimumAmount() {
            const newAmount = parseFloat(document.getElementById('newMinimumAmount').value);

            if (isNaN(newAmount) || newAmount < 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'ข้อมูลไม่ถูกต้อง',
                    text: 'กรุณากรอกจำนวนเงินที่ถูกต้อง',
                    confirmButtonColor: '#dc3545'
                });
                return;
            }

            try {
                const response = await fetch('/employee/withDraw/settings/minimum', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ minimumAmount: newAmount })
                });

                const data = await response.json();

                if (data.success) {
                    currentMinimumWithdraw = data.minimumWithdrawAmount;
                    document.getElementById('currentMinimumDisplay').textContent = 
                        currentMinimumWithdraw.toLocaleString(undefined, {minimumFractionDigits: 2}) + ' บาท';
                    
                    // อัพเดทในส่วนรายละเอียดบัญชีถ้ามี
                    const minimumAmountEl = document.getElementById('minimumAmount');
                    if (minimumAmountEl) {
                        minimumAmountEl.textContent = currentMinimumWithdraw.toLocaleString(undefined, {minimumFractionDigits: 2});
                    }

                    closeSettingsModal();
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ',
                        text: 'อัพเดทยอดเงินขั้นต่ำเรียบร้อยแล้ว',
                        confirmButtonColor: '#28a745',
                        timer: 2000
                    });

                    // ตรวจสอบจำนวนเงินถอนใหม่
                    validateAmount();
                } else {
                    throw new Error(data.error || 'เกิดข้อผิดพลาด');
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถบันทึกข้อมูลได้',
                    confirmButtonColor: '#dc3545'
                });
            }
        }

        async function searchAccount() {
            const accountId = document.getElementById('accountId').value.trim();
            
            if (!accountId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกเลขบัญชี',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#3085d6',
                });
                return;
            }

            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('accountDetails').classList.add('hidden');

            try {
                console.log('กำลังค้นหาบัญชี:', accountId);
                
                const response = await fetch(`/employee/withDraw/account/${encodeURIComponent(accountId)}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                console.log('Response status:', response.status);

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({ error: 'ไม่พบบัญชีที่ระบุ' }));
                    throw new Error(errorData.error || 'ไม่พบบัญชีที่ระบุ');
                }

                const data = await response.json();
                console.log('ข้อมูลบัญชี:', data);

                if (!data.success && data.error) {
                    throw new Error(data.error);
                }

                // เติมข้อมูลในส่วนรายละเอียดบัญชี
                document.getElementById('accountName').textContent = data.accountName || '-';
                document.getElementById('accountNumber').textContent = data.accountNumber || '-';
                document.getElementById('accountBalance').textContent = Number(data.balance || 0).toLocaleString(undefined, { 
                    minimumFractionDigits: 2, 
                    maximumFractionDigits: 2 
                });
                document.getElementById('minimumAmount').textContent = Number(data.minimumWithdrawAmount || currentMinimumWithdraw).toLocaleString(undefined, { 
                    minimumFractionDigits: 2, 
                    maximumFractionDigits: 2 
                });

                // อัพเดทค่า minimum ปัจจุบัน
                currentMinimumWithdraw = data.minimumWithdrawAmount || currentMinimumWithdraw;

                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('accountDetails').classList.remove('hidden');

                document.getElementById('hiddenAccountNumber').value = data.accountNumber;
                document.getElementById('withdrawAmount').disabled = false;
                document.getElementById('withdrawButton').disabled = true;
                document.getElementById('withdrawAmount').value = '';
                document.getElementById('amountError').textContent = '';
                document.getElementById('amountInfo').textContent = '';

            } catch (error) {
                console.error('เกิดข้อผิดพลาด:', error);
                
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('accountDetails').classList.add('hidden');

                Swal.fire({
                    icon: 'error',
                    title: 'ไม่พบข้อมูลบัญชี',
                    text: error.message || 'เกิดข้อผิดพลาดในการค้นหาบัญชี',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#dc3545',
                });
            }
        }

        function validateAmount() {
            const amountInput = document.getElementById('withdrawAmount');
            const amount = parseFloat(amountInput.value);
            const balanceText = document.getElementById('accountBalance').textContent.replace(/,/g, '');
            const balance = parseFloat(balanceText);

            const errorElement = document.getElementById('amountError');
            const infoElement = document.getElementById('amountInfo');
            const withdrawButton = document.getElementById('withdrawButton');

            if (!amountInput.value || amountInput.value.trim() === '') {
                errorElement.textContent = '';
                infoElement.textContent = '';
                withdrawButton.disabled = true;
                return;
            }

            if (isNaN(amount) || amount <= 0) {
                errorElement.textContent = 'กรุณากรอกจำนวนเงินที่ถูกต้อง';
                infoElement.textContent = '';
                withdrawButton.disabled = true;
                return;
            }

            if (amount > balance) {
                errorElement.textContent = 'จำนวนเงินที่ถอนมากกว่ายอดเงินในบัญชี';
                infoElement.textContent = '';
                withdrawButton.disabled = true;
                return;
            }

            const balanceAfterWithdraw = balance - amount;
            
            if (balanceAfterWithdraw < currentMinimumWithdraw) {
                errorElement.textContent = `ไม่สามารถถอนได้ เนื่องจากยอดคงเหลือหลังถอนจะต่ำกว่ายอดขั้นต่ำ ${currentMinimumWithdraw.toLocaleString(undefined, {minimumFractionDigits: 2})} บาท`;
                infoElement.textContent = `ยอดคงเหลือหลังถอน: ${balanceAfterWithdraw.toLocaleString(undefined, {minimumFractionDigits: 2})} บาท`;
                withdrawButton.disabled = true;
                return;
            }

            errorElement.textContent = '';
            infoElement.textContent = `✓ ยอดคงเหลือหลังถอน: ${balanceAfterWithdraw.toLocaleString(undefined, {minimumFractionDigits: 2})} บาท`;
            infoElement.classList.add('text-green-600');
            withdrawButton.disabled = false;
        }

        document.getElementById('withdrawalForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const amount = document.getElementById('withdrawAmount').value;
            const accountId = document.getElementById('hiddenAccountNumber').value;

            if (!amount || !accountId) {
                Swal.fire({
                    icon: 'error',
                    title: 'ข้อมูลไม่ครบถ้วน',
                    text: 'กรุณาตรวจสอบข้อมูลอีกครั้ง',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#dc3545',
                });
                return;
            }

            Swal.fire({
                title: 'ยืนยันการถอนเงิน',
                text: `คุณต้องการถอนเงินจำนวน ${Number(amount).toLocaleString(undefined, {minimumFractionDigits: 2})} บาท จากบัญชี ${accountId} ใช่หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545',
            }).then((result) => {
                if (result.isConfirmed) {
                    console.log('ส่งฟอร์มถอนเงิน:', { accountId, amount });
                    this.submit();
                }
            });
        });

        // ปิด modal เมื่อคลิกนอก modal
        document.getElementById('settingsModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeSettingsModal();
            }
        });
    </script>
</body>

</html>