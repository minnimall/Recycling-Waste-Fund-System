<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/funeral-assistance.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body class="bg-gray-50">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        เบิกถอนเงิน
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการเบิกถอนเงินการขายขยะสำหรับครัวเรือนในชุมชน</p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="mx-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- ส่วนค้นหาบัญชี -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center">
                        <!-- <ion-icon name="search-outline" class="mr-2 text-gray-600"></ion-icon> -->ค้นหาบัญชี 
                    </h2>
                    <div class="space-y-4">
                        <form action="" method="">
                            <div>
                                <!-- <label for="accountId" class="block text-sm font-medium text-gray-700 mb-1">เลขบัญชี</label> -->
                                <div class="flex">
                                    <input type="text" id="accountId" name="accountId" 
                                        class="flex-1 rounded-l-md border-gray-300 shadow-sm focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50 p-3" 
                                        placeholder="กรอกเลขบัญชี">
                                    <button type="button" onclick="searchAccount()" 
                                        class="bg-green-600 text-white px-4 py-2 rounded-r-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition">
                                        <ion-icon name="search-outline"></ion-icon>
                                    </button>
                                </div>
                            </div>
                            <div class="text-sm text-gray-600 mt-3">
                                <p>* กรอกปีตามด้วยเลขหมู่บ้านและลำดับการสมัคร เช่น 680301</p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ส่วนรายละเอียดบัญชีและการถอนเงิน -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="wallet-outline" class="mr-2 text-gray-600"></ion-icon> รายละเอียดการถอนเงิน
                    </h2>

                    <!-- สถานะกำลังโหลด -->
                    <div id="loadingState" class="hidden py-8">
                        <div class="flex flex-col items-center justify-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600"></div>
                            <p class="mt-4 text-gray-600">กำลังค้นหาข้อมูลบัญชี...</p>
                        </div>
                    </div>

                    <!-- รายละเอียดบัญชี (ซ่อนไว้ก่อน) -->
                    <div id="accountDetails" class="hidden">
                        <div class="bg-gray-50 rounded-lg p-4 mb-6 border border-gray-200">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-500">ชื่อเจ้าของบัญชี</p>
                                    <p id="accountName" class="text-lg font-medium text-gray-800">-</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">รหัสบัญชี</p>
                                    <p id="accountNumber" class="text-lg font-medium text-gray-800">-</p>
                                </div>
                                <div class="md:col-span-2">
                                    <p class="text-sm text-gray-500">ยอดเงินในบัญชี (บาท)</p>
                                    <p class="text-2xl font-bold text-green-600">฿ <span id="accountBalance">0.00</span></p>
                                </div>
                            </div>
                        </div>

                        <form id="withdrawalForm" class="space-y-4">
                            <div>
                                <label for="withdrawAmount" class="block text-sm font-medium text-gray-700 mb-1">จำนวนเงินที่ต้องการถอน (บาท)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500">฿</span>
                                    </div>
                                    <input type="number" id="withdrawAmount" name="withdrawAmount" 
                                        class="pl-8 py-2 px-4 w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50" 
                                        placeholder="0.00" step="0.01" min="0" oninput="validateAmount()">
                                </div>
                                <p id="amountError" class="mt-1 text-sm text-red-600"></p>
                            </div>

                            <!-- <div>
                                <label for="withdrawReason" class="block text-sm font-medium text-gray-700 mb-1">หมายเหตุ (ไม่บังคับ)</label>
                                <textarea id="withdrawReason" name="withdrawReason" rows="2" 
                                    class="w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50" 
                                    placeholder="ระบุหมายเหตุหรือเหตุผลในการถอนเงิน (ถ้ามี)"></textarea>
                            </div> -->

                            <div class="pt-4">
                                <button type="button" id="withdrawButton" onclick="confirmWithdrawal()" disabled
                                    class="w-full bg-green-600 text-white py-3 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition disabled:opacity-50 disabled:cursor-not-allowed">
                                    <ion-icon name="checkmark-circle-outline" class="mr-1"></ion-icon> ยืนยันการถอนเงิน
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- คำแนะนำเมื่อยังไม่ได้ค้นหาบัญชี -->
                    <!-- <div id="initialState" class="py-8 text-center text-gray-500">
                        <ion-icon name="information-circle-outline" class="text-4xl mb-2"></ion-icon>
                        <p>กรุณาค้นหาเลขบัญชีที่ต้องการถอนเงิน</p>
                    </div> -->
                </div>
            </div>
        </div>

        <!-- ประวัติการถอนเงินล่าสุด -->
        <div class="mx-4 mt-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                    <ion-icon name="time-outline" class="mr-2 text-gray-600"></ion-icon> ประวัติการถอนเงินล่าสุด
                </h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">วันที่</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">รหัสบัญชี</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ชื่อเจ้าของบัญชี</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">จำนวนเงิน</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">15/05/2025</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">ACC-1001</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">นางสาวสมหญิง รักดี</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">฿ 1,200.00</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">สำเร็จ</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">14/05/2025</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">ACC-1002</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">นายสมชาย ใจดี</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">฿ 800.00</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">สำเร็จ</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">12/05/2025</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">ACC-1003</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">นายวิชัย มั่งมี</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">฿ 2,500.00</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">สำเร็จ</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>
    <script>
        // ฟังก์ชันสำหรับค้นหาบัญชี
        function searchAccount() {
            const accountId = document.getElementById('accountId').value;
            if (!accountId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกเลขบัญชี',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#3085d6',
                });
                return;
            }

            // แสดง loading
            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('accountDetails').classList.add('hidden');
            
            // จำลองการค้นหาข้อมูล (ในการใช้งานจริงควรใช้ fetch หรือ axios เพื่อดึงข้อมูลจาก API)
            setTimeout(() => {
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('accountDetails').classList.remove('hidden');
                
                // สมมติว่าได้ข้อมูลบัญชีมาแล้ว (ในการใช้งานจริงควรแทนที่ด้วยข้อมูลจริงจาก API)
                document.getElementById('accountName').textContent = 'นายสมชาย ใจดี';
                document.getElementById('accountNumber').textContent = 'ACC-' + accountId;
                document.getElementById('accountBalance').textContent = '5,000.00';
                
                // เปิดใช้งานปุ่มถอนเงิน
                document.getElementById('withdrawButton').disabled = false;
            }, 1000);
        }

        // ฟังก์ชันสำหรับตรวจสอบจำนวนเงินที่ถอน
        function validateAmount() {
            const amount = parseFloat(document.getElementById('withdrawAmount').value);
            const balance = parseFloat(document.getElementById('accountBalance').textContent.replace(/,/g, ''));
            
            if (isNaN(amount) || amount <= 0) {
                document.getElementById('amountError').textContent = 'กรุณากรอกจำนวนเงินที่ถูกต้อง';
                document.getElementById('withdrawButton').disabled = true;
                return;
            }
            
            if (amount > balance) {
                document.getElementById('amountError').textContent = 'จำนวนเงินที่ถอนมากกว่ายอดเงินในบัญชี';
                document.getElementById('withdrawButton').disabled = true;
                return;
            }
            
            document.getElementById('amountError').textContent = '';
            document.getElementById('withdrawButton').disabled = false;
        }

        // ฟังก์ชันสำหรับการถอนเงิน
        function confirmWithdrawal() {
            const accountId = document.getElementById('accountId').value;
            const amount = document.getElementById('withdrawAmount').value;
            
            Swal.fire({
                title: 'ยืนยันการถอนเงิน',
                text: `คุณต้องการถอนเงินจำนวน ${amount} บาท จากบัญชี ${accountId} ใช่หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545',
            }).then((result) => {
                if (result.isConfirmed) {
                    // จำลองการส่งข้อมูลไปยัง server (ในการใช้งานจริงควรใช้ fetch หรือ axios)
                    Swal.fire({
                        title: 'กำลังดำเนินการ...',
                        text: 'กรุณารอสักครู่',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                    
                    // จำลองการรอการประมวลผล
                    setTimeout(() => {
                        Swal.fire({
                            icon: 'success',
                            title: 'ถอนเงินสำเร็จ!',
                            text: `ถอนเงินจำนวน ${amount} บาท เรียบร้อยแล้ว`,
                            confirmButtonText: 'ตกลง',
                            confirmButtonColor: '#28a745',
                        }).then(() => {
                            // รีเซ็ตฟอร์ม
                            document.getElementById('withdrawalForm').reset();
                            document.getElementById('accountDetails').classList.add('hidden');
                            document.getElementById('withdrawButton').disabled = true;
                        });
                    }, 2000);
                }
            });
        }
    </script>
</body>
</html>