        async function performSearch(query, showPopup = true) {
            if (!query || query.trim().length < 2) return;

            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
            }

            try {
                const results = await new Promise((resolve) => {
                    const service = new google.maps.places.PlacesService(map);
                    service.textSearch({
                        query: query,
                        location: { lat: 15.9487, lng: 102.8552 },
                        radius: 50000
                    }, (results, status) => {
                        if (status === google.maps.places.PlacesServiceStatus.OK && results) {
                            resolve(results.slice(0, 5).map(place => ({
                                lat: place.geometry.location.lat(),
                                lng: place.geometry.location.lng(),
                                display_name: place.formatted_address || place.name,
                                name: place.name
                            })));
                        } else {
                            resolve([]);
                        }
                    });
                });

                if (showPopup) Swal.close();

                if (results.length > 0) {
                    showSearchResults(results);
                } else if (showPopup) {
                    Swal.fire({ icon: 'error', title: 'ไม่พบผลการค้นหา', timer: 2000 });
                }

            } catch (error) {
                if (showPopup) {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', timer: 2000 });
                }
            }
        }

