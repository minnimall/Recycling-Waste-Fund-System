                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 transition resize-none"
                                    placeholder="กรอกหมายเหตุ (ถ้ามี)">${routeData.note || ''}</textarea>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                cancelButtonText: 'ยกเลิก',
                confirmButtonText: 'บันทึก',
                reverseButtons: true,
                buttonsStyling: false,
                customClass: {
                    popup: 'rounded-xl shadow-lg',
                    actions: 'w-full flex justify-end px-6 pb-6',
                    confirmButton: 'px-6 py-2.5 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition duration-200',
                    cancelButton: 'px-6 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200 mr-2' 
                },
                preConfirm: () => {
                    const routeName = document.getElementById('routeName').value.trim();
                    if (!routeName) {
                        Swal.showValidationMessage('กรุณากรอกชื่อเส้นทาง');
                        return false;
                    }
                    return {
                        routeName: routeName,
                        note: document.getElementById('routeNote').value.trim()
                    };
                },
                didOpen: () => {
                    document.getElementById('routeName').focus();
                }
            });

            if (formValues) {
                Swal.fire({
                    title: 'กำลังบันทึก...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                try {
                    const response = await fetch(`/employee/routeList/${routeData._id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formValues)
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ!',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        throw new Error(result.message || 'ไม่สามารถบันทึกข้อมูลได้');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์',
                        confirmButtonText: 'ตกลง'
                    });
                }
            }
        }

        async function saveEditedRoute() {
            if (!routeAnalysisData || optimizedRoutePoints.length < 2) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาวิเคราะห์เส้นทางก่อน',
                    text: 'คุณต้องวิเคราะห์เส้นทางใหม่ก่อนบันทึก',
                    timer: 2000
                });
                return;
            }

            const result = await Swal.fire({
                title: 'ยืนยันการบันทึก?',
                html: `
                    <div class="text-left">
                        <p class="mb-2">ระยะทางรวม: <strong>${routeAnalysisData.totalDistance.toFixed(2)} กม.</strong></p>
                        <p class="mb-2">เวลารวม: <strong>${Math.round(routeAnalysisData.totalDuration)} นาที</strong></p>
                        <p class="text-sm text-gray-600">เส้นทางเดิมจะถูกอัปเดตด้วยข้อมูลใหม่</p>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก'
            });

            if (!result.isConfirmed) return;

            Swal.fire({
                title: 'กำลังบันทึก...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const updateData = {
                    points: optimizedRoutePoints.map((point, index) => ({
                        pointNumber: index + 1,
                        lat: point.lat,
                        lng: point.lng,
                        address: point.address,
                        requestId: point.requestId || null
                    })),
                    totalDistance: routeAnalysisData.totalDistance,
                    totalDuration: routeAnalysisData.totalDuration,
                    numberOfPoints: optimizedRoutePoints.length
                };

                const response = await fetch(`/employee/routeList/${routeData._id}/updateRoute`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updateData)
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ!',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถบันทึกได้',
                    confirmButtonText: 'ตกลง'
                });
            }
        }

        async function deleteRoute() {
            const result = await Swal.fire({
                title: 'ยืนยันการลบ?',
                html: `ต้องการลบเส้นทาง <strong>"${routeData.routeName}"</strong> หรือไม่?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/employee/routeList/${routeData._id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบสำเร็จ!',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => window.location.href = '/employee/routeList');
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        timer: 2000
                    });
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // initMap();
            // setupSearch();
        });

        function openInGoogleMaps() {
            try {
                // ตรวจสอบว่ามีข้อมูลเส้นทางหรือไม่
                if (!routeData || !routeData.points || routeData.points.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'ไม่พบข้อมูลเส้นทาง',
                        text: 'ไม่สามารถเปิด Google Maps ได้',
                        timer: 2000
                    });
                    return;
                }

                // สร้าง URL สำหรับ Google Maps
                let googleMapsUrl = '';

                if (routeData.points.length === 1) {
                    // กรณีมีจุดเดียว - แสดงตำแหน่ง
                    const point = routeData.points[0];
                    googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${point.lat},${point.lng}`;
                } else {
                    // กรณีมีหลายจุด - สร้างเส้นทาง
                    const origin = routeData.points[0];
                    const destination = routeData.points[0]; // กลับมาจุดเริ่มต้น (round trip)
                    
                    // สร้าง waypoints (จุดระหว่างทาง) - ข้ามจุดแรกและจุดสุดท้าย
                    const waypoints = routeData.points
                        .slice(1) // ข้ามจุดแรก
                        .map(point => `${point.lat},${point.lng}`)
                        .join('|');

                    // สร้าง URL แบบ Directions
                    googleMapsUrl = `https://www.google.com/maps/dir/?api=1` +
                        `&origin=${origin.lat},${origin.lng}` +
                        `&destination=${destination.lat},${destination.lng}` +
                        (waypoints ? `&waypoints=${waypoints}` : '') +
                        `&travelmode=driving`;
                }

                // เปิดในหน้าต่างใหม่
                window.open(googleMapsUrl, '_blank');

                // แสดงข้อความยืนยัน
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'กำลังเปิด Google Maps...',
                    showConfirmButton: false,
                    timer: 2000
                });

            } catch (error) {
                console.error('Error opening Google Maps:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเปิด Google Maps ได้',
                    timer: 2000
                });
            }
        }

        // === Per-Point Completion Functions ===

        async function callPointStatusAPI(routeId, pointId, status, reason = null) {
            const body = { status };
            if (reason) body.reason = reason;

            const response = await fetch(`/employee/routeList/${routeId}/point/${pointId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            return response.json();
        }

        async function markPointComplete(routeId, pointId) {
            const confirm = await Swal.fire({
                title: 'ยืนยันเสร็จสิ้น?',
                text: 'ยืนยันว่ารับซื้อขยะจุดนี้สำเร็จแล้ว',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16A34A',
                confirmButtonText: 'เสร็จสิ้น',
                cancelButtonText: 'ยกเลิก'
            });
            if (!confirm.isConfirmed) return;

            try {
                const result = await callPointStatusAPI(routeId, pointId, 'complete');
                if (result.success) {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success',
                        title: 'อัปเดตเสร็จสิ้น', showConfirmButton: false, timer: 1500
                    });
                    if (result.isAllComplete) {
                        setTimeout(() => {
                            Swal.fire({
                                icon: 'success',
                                title: 'ครบทุกจุดแล้ว!',
                                text: 'เส้นทางนี้เสร็จสมบูรณ์',
                                timer: 2500
                            }).then(() => window.location.reload());
                        }, 1600);
                    } else {
                        setTimeout(() => window.location.reload(), 1500);
                    }
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: error.message || 'ไม่สามารถอัปเดตได้' });
            }
        }

        async function markPointFailed(routeId, pointId) {
            const { value: reason } = await Swal.fire({
                title: 'เหตุผลที่เข้ารับไม่ได้',
                input: 'select',
                inputOptions: {
                    'NO_ONE_HOME': 'ไม่มีคนอยู่บ้าน',
                    'WASTE_NOT_READY': 'ขยะไม่พร้อม',
                    'WRONG_LOCATION': 'หาสถานที่ไม่เจอ',
                    'ROAD_BLOCKED': 'ถนนเข้าไม่ได้',
                    'OTHER': 'อื่นๆ'
                },
                inputPlaceholder: 'เลือกเหตุผล',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                inputValidator: (value) => {
                    if (!value) return 'กรุณาเลือกเหตุผล';
                }
            });
            if (!reason) return;

            try {
                const result = await callPointStatusAPI(routeId, pointId, 'failed', reason);
                if (result.success) {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'info',
                        title: 'บันทึกปัญหาแล้ว', showConfirmButton: false, timer: 1500
                    });
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: error.message || 'ไม่สามารถอัปเดตได้' });
            }
        }

        async function markPointReset(routeId, pointId) {
            const confirm = await Swal.fire({
                title: 'ยกเลิกสถานะ?',
                text: 'ต้องการเปลี่ยนกลับเป็นรอดำเนินการ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก'
            });
            if (!confirm.isConfirmed) return;

            try {
                const result = await callPointStatusAPI(routeId, pointId, 'in-progress');
                if (result.success) {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success',
                        title: 'ยกเลิกสถานะแล้ว', showConfirmButton: false, timer: 1500
                    });
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: error.message || 'ไม่สามารถอัปเดตได้' });
            }
        }

        async function completeAllPoints(routeId) {
            const confirm = await Swal.fire({
                title: 'จบงานทุกจุดที่เหลือ?',
                html: 'จุดที่ยังเป็น <b>รอดำเนินการ</b> จะถูกเปลี่ยนเป็น <b>เสร็จสิ้น</b> ทั้งหมด',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16A34A',
                confirmButtonText: 'ยืนยัน จบงานทั้งหมด',
                cancelButtonText: 'ยกเลิก'
            });
            if (!confirm.isConfirmed) return;

            try {
                const response = await fetch(`/employee/routeList/${routeId}/complete-all`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'จบงานทั้งหมดสำเร็จ!',
                        text: result.message,
                        timer: 2500,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: error.message || 'ไม่สามารถอัปเดตได้' });
            }
        }
    </script>
