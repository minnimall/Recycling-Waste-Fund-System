        // Search functionality
        function setupSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            
            searchBtn.addEventListener('click', () => {
                const query = searchInput.value.trim();
                if (query) performSearch(query);
            });
            
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    const query = searchInput.value.trim();
                    if (query) performSearch(query);
                }
            });

            searchInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }
                
                if (query.length >= 2) {
                    searchTimeout = setTimeout(() => {
                        performSearch(query, false);
                    }, 500);
                } else {
                    document.getElementById('searchSuggestions').classList.add('hidden');
                }
            });
        }

        async function performSearch(query, showPopup = true) {
            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }
            
            try {
                const nominatimUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5&addressdetails=1&accept-language=th,en&countrycodes=th`;
                
                const response = await fetch(nominatimUrl);
                const data = await response.json();
                
                if (showPopup) {
                    Swal.close();
                }
                
                if (data && data.length > 0) {
                    if (data.length === 1) {
                        const result = data[0];
                        map.setView([parseFloat(result.lat), parseFloat(result.lon)], 15);
                        addPoint(parseFloat(result.lat), parseFloat(result.lon), result.display_name);
                        document.getElementById('searchInput').value = '';
                    } else {
                        showSearchResults(data);
                    }
                } else {
                    if (showPopup) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่พบผลการค้นหา',
                            timer: 2000
                        });
                    }
                }
            } catch (error) {
                if (showPopup) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        timer: 2000
                    });
                }
            }
        }

        function showSearchResults(results) {
            const suggestionsDiv = document.getElementById('searchSuggestions');
            let html = '';
            
            results.forEach(result => {
                html += `
                    <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100" 
                        data-lat="${result.lat}" data-lng="${result.lon}" data-name="${result.display_name}">
                        <div class="font-medium text-gray-800 text-sm">${result.display_name}</div>
                        <div class="text-xs text-gray-500 mt-1">
                            <ion-icon name="location-outline" class="text-blue-500"></ion-icon>
                            ${parseFloat(result.lat).toFixed(4)}, ${parseFloat(result.lon).toFixed(4)}
                        </div>
                    </div>
                `;
            });
            
            suggestionsDiv.innerHTML = `<div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">${html}</div>`;
            suggestionsDiv.classList.remove('hidden');
            
            suggestionsDiv.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);
