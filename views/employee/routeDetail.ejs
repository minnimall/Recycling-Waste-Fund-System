<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
    <style>
        .content {
            margin-left: 0;
            padding: 20px;
        }
        .delete-btn {
            background-color: #f44336; /* สีแดง */
            color: white;
            border: none;
            margin-top: 10px;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 15px;
            transition: background-color 0.3s ease;
        }

        .delete-btn:hover {
            background-color: #d32f2f; /* สีแดงเข้ม */
        }

        .edit-btn {
            background-color: #007bff; /* สีฟ้าสำหรับแก้ไข */
            color: white;
            border: none;
            margin-top: 10px;
            margin-right: 4px;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 15px;
            transition: background-color 0.3s ease;
        }

        .edit-btn:hover {
            background-color: #0155ad;
        }
    </style>
</head>

<body>

    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>

    <main class="content bg-gray-50 min-screen">
        <!-- Header with Back Button -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/employee/routeList" 
                        class="text-gray-600 hover:text-gray-800 transition">
                        <ion-icon name="arrow-back-outline" class="text-3xl"></ion-icon>
                    </a>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                            <%= route.routeName %>
                        </h1>
                        <p class="text-gray-600 text-sm mt-1">
                            บันทึกเมื่อ <%= new Date(route.createdAt).toLocaleDateString('th-TH', { 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button onclick="editRoute()" class="edit-btn" title="แก้ไข">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button onclick="deleteRoute()" class="delete-btn" title="ลบ">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <!-- <div class="mx-4 mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-blue-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">จำนวนจุด</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= route.numberOfPoints %>
                        </p>
                    </div>
                    <ion-icon name="location" class="text-4xl text-blue-500 opacity-50"></ion-icon>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-green-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">ระยะทางรวม</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= route.totalDistance.toFixed(2) %>
                        </p>
                        <p class="text-xs text-gray-500">กิโลเมตร</p>
                    </div>
                    <ion-icon name="speedometer" class="text-4xl text-500 opacity-50"></ion-icon>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-purple-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">เวลาโดยประมาณ</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= Math.round(route.totalDuration) %>
                        </p>
                        <p class="text-xs text-gray-500">นาที (~<%= (route.totalDuration/60).toFixed(1) %> ชม.)</p>
                    </div>
                    <ion-icon name="time" class="text-4xl text-purple-500 opacity-50"></ion-icon>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-6 border-l-4 border-orange-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">บันทึกโดย</p>
                        <p class="text-lg font-bold text-600 mt-2">
                            <%= route.createdBy.firstname %> <%= route.createdBy.lastname %>
                        </p>
                        <p class="text-xs text-gray-500"><%= route.createdBy.email %></p>
                    </div>
                    <ion-icon name="person-circle" class="text-4xl text-orange-500 opacity-50"></ion-icon>
                </div>
            </div>
        </div> -->

        <!-- Note Section -->
        <% if (route.note) { %>
        <div class="mx-4 mb-6 bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                <!-- <ion-icon name="document-text-outline" class="mr-2 text-yellow-500"></ion-icon> -->
                หมายเหตุ
            </h3>
            <p class="text-gray-700 p-4 rounded-lg border-l-4 border-yellow-400">
                <%= route.note %>
            </p>
        </div>
        <% } %>

        <div class="mx-4 mb-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="list-outline" class="mr-2 text-blue-500"></ion-icon>
                        ลำดับจุดในเส้นทาง
                    </h3>
                    <div class="space-y-3 max-h-[600px] overflow-y-auto">
                        <% route.points.forEach((point, index) => { %>
                            <div class="<%= index === 0 ? 'bg-green-50 border-green-300' : 'bg-blue-50 border-blue-200' %> 
                                        border rounded-lg p-4">
                                <div class="flex items-start gap-3">
                                    <div class="<%= index === 0 ? 'bg-green-600' : 'bg-blue-600' %> 
                                                text-white rounded-full w-10 h-10 flex items-center justify-center 
                                                font-bold flex-shrink-0">
                                        <%= point.pointNumber %>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-800 break-words">
                                            <%= point.address %>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-1">
                                            <%= point.lat.toFixed(6) %>, <%= point.lng.toFixed(6) %>
                                        </p>
                                        <% if (index === 0) { %>
                                            <span class="inline-block mt-2 text-xs bg-green-600 text-white px-2 py-1 rounded">
                                                จุดเริ่มต้น/สิ้นสุด
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                        <div class="bg-green-50 border-green-300 border rounded-lg p-4">
                            <div class="flex items-start gap-3">
                                <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center 
                                            font-bold flex-shrink-0">
                                    <ion-icon name="checkmark"></ion-icon>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-green-800">
                                        กลับจุดเริ่มต้น
                                    </p>
                                    <p class="text-xs text-green-600 mt-1">
                                        วนกลับมาที่จุดแรก
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-lg p-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="map-outline" class="mr-2 text-blue-500"></ion-icon>
                        แผนที่แสดงเส้นทาง
                    </h3>
                    <div id="map" class="w-full h-[600px] rounded-lg border border-gray-200"></div>
                </div>
            </div>
        </div>
    </main>

    <script>
        const routeData = <%- JSON.stringify(route) %>;
        let map;
        let routingControl;

        // แสดงแผนที่
        function initMap() {
            // แสดงที่จุดเริ่มต้นของ point
            const firstPoint = routeData.points[0];
            map = L.map('map').setView([firstPoint.lat, firstPoint.lng], 13);

            // ใช้ OpenStreetMap เป็นพื้นหลังของแผนที่
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            routeData.points.forEach((point, index) => { // วนลูปทุกจุดใน routeData.points แล้วเพิ่มลงในแผนที่
                const isStart = index === 0;
                const markerIcon = L.divIcon({
                    html: `<div class="${isStart ? 'bg-green-600' : 'bg-blue-600'} 
                                text-white rounded-full w-10 h-10 flex items-center justify-center 
                                font-bold text-lg shadow-lg border-2 border-white">
                                ${point.pointNumber}
                        </div>`,
                    className: 'custom-marker',
                    iconSize: [40, 40],
                    iconAnchor: [20, 20]
                });

                L.marker([point.lat, point.lng], { icon: markerIcon })
                    .bindPopup(`
                        <div class="text-center">
                            <b>จุดที่ ${point.pointNumber}</b><br>
                            <div class="text-sm mt-2">${point.address}</div>
                            ${isStart ? '<div class="text-green-600 text-xs mt-2 font-bold">🎯 จุดเริ่มต้น</div>' : ''}
                        </div>
                    `) // bindPopup ข้อความที่จะแสดงเมื่อคลิกหมุด
                    .addTo(map);
            });

            // สร้างเส้นทางระหว่างจุด
            const waypoints = routeData.points.map(p => L.latLng(p.lat, p.lng));
            waypoints.push(L.latLng(routeData.points[0].lat, routeData.points[0].lng)); // กลับมาจุดเริ่มต้น

            // สร้างเส้นทางที่แสดงบนแผนที่ ที่บอกเส้นทางที่จะไปแต่ละจุด
            routingControl = L.Routing.control({
                waypoints: waypoints,
                routeWhileDragging: false,
                addWaypoints: false,
                lineOptions: {
                    styles: [{
                        color: '#3B82F6',
                        weight: 5,
                        opacity: 0.8
                    }]
                },
                createMarker: function() { return null; },
                router: L.Routing.osrmv1({
                    serviceUrl: 'https://router.project-osrm.org/route/v1', // (OSRM) เพื่อคำนวณเส้นทางจริง (ถนนจริง)
                    profile: 'driving' // คำนวณเส้นทางแบบขับรถ
                })
            }).addTo(map);

            // ซ่อน panel คำแนะนำเส้นทาง Leaflet Routing Machine มี panel แสดงขั้นตอนการขับรถ (เช่น "เลี้ยวขวา", "ตรงไป")
            setTimeout(() => {
                const container = routingControl.getContainer();
                if (container && container.style) {
                    container.style.display = 'none';
                }
            }, 1000);

            setTimeout(() => {
                const bounds = L.latLngBounds(waypoints);
                map.fitBounds(bounds.pad(0.1));
            }, 1500);
        }

        // แก้ไขเส้นทาง
        async function editRoute() {
            const { value: formValues } = await Swal.fire({
                title: 'แก้ไขเส้นทาง',
                html: `
                    <div class="space-y-6 p-1">
                        <!-- Route Name Section -->
                        <div class="space-y-2">
                            <label for="routeName" class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                                <span>ชื่อเส้นทาง</span>
                                <span class="text-red-500">*</span>
                            </label>
                            <input 
                                id="routeName" 
                                type="text"
                                value="${routeData.routeName}"
                                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg shadow-sm
                                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500 
                                    transition-all duration-200 ease-in-out
                                    hover:border-gray-400
                                    text-gray-900 placeholder-gray-400"
                                placeholder="ระบุชื่อเส้นทาง"
                            >
                        </div>

                        <!-- Notes Section -->
                        <div class="space-y-2">
                            <label for="routeNote" class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                                <span>หมายเหตุ</span>
                                <span class="text-xs text-gray-500 font-normal">(ถ้ามี)</span>
                            </label>
                            <textarea 
                                id="routeNote" 
                                rows="4"
                                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg shadow-sm
                                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500 
                                    transition-all duration-200 ease-in-out
                                    hover:border-gray-400
                                    text-gray-900 placeholder-gray-400 resize-none"
                                placeholder="เพิ่มหมายเหตุหรือรายละเอียดเพิ่มเติม..."
                            >${routeData.note || ''}</textarea>
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#3B82F6',
                preConfirm: () => {
                    const routeName = document.getElementById('routeName').value;
                    if (!routeName) {
                        Swal.showValidationMessage('กรุณากรอกชื่อเส้นทาง');
                        return false;
                    }
                    return {
                        routeName: routeName,
                        note: document.getElementById('routeNote').value
                    };
                }
            });

            if (!formValues) return;

            try {
                const response = await fetch(`/employee/routeList/${routeData._id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formValues)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'แก้ไขสำเร็จ!',
                        text: result.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถแก้ไขได้',
                    confirmButtonText: 'ตกลง'
                });
            }
        }

        // ลบเส้นทาง
        async function deleteRoute() {
            const result = await Swal.fire({
                title: 'ยืนยันการลบ?',
                html: `ต้องการลบเส้นทาง <strong>"${routeData.routeName}"</strong> หรือไม่?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/employee/routeList/${routeData._id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบสำเร็จ!',
                            text: data.message,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '/employee/routeList';
                        });
                    } else {
                        throw new Error(data.message);
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'ไม่สามารถลบได้',
                        confirmButtonText: 'ตกลง'
                    });
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initMap();
        });
    </script>

</body>
</html>