                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-blue-600">${firstSegment.distance.toFixed(2)} กม.</span></div>
                                    <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-green-600">${Math.round(firstSegment.duration)} นาที</span></div>
                                </div>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;
            
            // แสดงจุดที่ 2 เป็นต้นไป (ข้ามจุดแรกเพราะแสดงไปแล้ว)
            for (let index = 1; index < route.length; index++) {
                const point = route[index];
                const segment = segments[index];
                const isLast = index === route.length - 1;
                const isFromRequest = point.requestId ? true : false;
                
                html += `
                    <div class="flex items-start space-x-3 p-3 bg-white rounded-lg border border-gray-200">
                        <div class="flex-shrink-0">
                            <div class="${isFromRequest ? 'bg-green-600' : 'bg-blue-600'} text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold shadow-md">
                                ${index + 1}
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-800 text-sm">${point.address}</div>

                            <div class="text-xs text-gray-500 mt-1">
                                ${point.lat.toFixed(4)}, ${point.lng.toFixed(4)}
                            </div>

                            ${isFromRequest ? '<div class="text-xs text-green-600 mt-1">📋 จากคำขอขายขยะ</div>' : ''}
                            
                            ${!isLast && segment ? `
                                <div class="mt-2 p-2 bg-white rounded border-l-4 border-blue-400">
                                    <div class="text-xs text-gray-700 font-medium mb-1">
                                        → ไปยังจุดที่ ${index + 2}
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-blue-600">${segment.distance.toFixed(2)} กม.</span></div>
                                        <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-green-600">${Math.round(segment.duration)} นาที</span></div>
                                    </div>
                                </div>
                            ` : ''}

                            ${isLast && segments[index] ? `
                                <div class="mt-2 p-2 bg-red-50 rounded border-l-4 border-red-400">
                                    <div class="text-xs text-red-700 font-medium mb-1 flex items-center gap-1">
                                        <ion-icon name="return-down-back" class="text-base"></ion-icon>
                                        <span>กลับจุดเริ่มต้น</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-red-600">${segments[index].distance.toFixed(2)} กม.</span></div>
                                        <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-red-600">${Math.round(segments[index].duration)} นาที</span></div>
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `;
            }
            
            // ส่วนท้าย: แสดงจุดปิดท้าย (Endpoint)
            html += `
                        <div class="flex items-start space-x-3 p-4 bg-gradient-to-r from-green-50 to-green-100 rounded-lg border-2 border-green-400 shadow-md">
                            <div class="flex-shrink-0">
                                <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center shadow-lg border-2 border-white">
                                    <ion-icon name="checkmark-circle" class="text-xl"></ion-icon>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-green-800 text-base mb-1">
                                    กลับถึงจุดเริ่มต้น
                                </div>
                                <div class="font-medium text-gray-800 text-sm">${route[0].address}</div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            routeInfo.innerHTML = html;
            resultsContainer.classList.remove('hidden');
        }

        async function editNameAndNote() {
            const { value: formValues } = await Swal.fire({
                title: '',
                html: `
                    <div class="text-left">
                        <div class="flex items-center space-x-3 mb-6 pb-4 border-b-2 border-gray-200">
                            <ion-icon name="create-outline" class="text-blue-500 text-3xl"></ion-icon>
                            <span class="text-xl font-semibold text-gray-800">แก้ไขชื่อและหมายเหตุ</span>
                        </div>

                        <div class="space-y-5">
                            <div>
                                <label for="routeName" class="block text-sm font-medium text-gray-700 mb-2">
                                    ชื่อเส้นทาง
                                </label>
                                <input type="text" id="routeName" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 transition"
                                    placeholder="กรอกชื่อเส้นทาง" 
                                    value="${routeData.routeName}">
                            </div>

                            <div>
                                <label for="routeNote" class="block text-sm font-medium text-gray-700 mb-2">
                                    หมายเหตุ
                                </label>
                                <textarea id="routeNote" rows="4"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 transition resize-none"
                                    placeholder="กรอกหมายเหตุ (ถ้ามี)">${routeData.note || ''}</textarea>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                cancelButtonText: 'ยกเลิก',
                confirmButtonText: 'บันทึก',
                reverseButtons: true,
                buttonsStyling: false,
                customClass: {
                    popup: 'rounded-xl shadow-lg',
                    actions: 'w-full flex justify-end px-6 pb-6',
                    confirmButton: 'px-6 py-2.5 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition duration-200',
                    cancelButton: 'px-6 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200 mr-2' 
                },
                preConfirm: () => {
                    const routeName = document.getElementById('routeName').value.trim();
                    if (!routeName) {
                        Swal.showValidationMessage('กรุณากรอกชื่อเส้นทาง');
                        return false;
                    }
                    return {
                        routeName: routeName,
                        note: document.getElementById('routeNote').value.trim()
                    };
                },
                didOpen: () => {
                    document.getElementById('routeName').focus();
                }
            });

            if (formValues) {
                Swal.fire({
                    title: 'กำลังบันทึก...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                try {
                    const response = await fetch(`/employee/routeList/${routeData._id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formValues)
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ!',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        throw new Error(result.message || 'ไม่สามารถบันทึกข้อมูลได้');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: error.message || 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์',
                        confirmButtonText: 'ตกลง'
                    });
                }
            }
        }

        async function saveEditedRoute() {
            if (!routeAnalysisData || optimizedRoutePoints.length < 2) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาวิเคราะห์เส้นทางก่อน',
                    text: 'คุณต้องวิเคราะห์เส้นทางใหม่ก่อนบันทึก',
                    timer: 2000
                });
                return;
            }

            const result = await Swal.fire({
                title: 'ยืนยันการบันทึก?',
                html: `
                    <div class="text-left">
                        <p class="mb-2">ระยะทางรวม: <strong>${routeAnalysisData.totalDistance.toFixed(2)} กม.</strong></p>
                        <p class="mb-2">เวลารวม: <strong>${Math.round(routeAnalysisData.totalDuration)} นาที</strong></p>
                        <p class="text-sm text-gray-600">เส้นทางเดิมจะถูกอัปเดตด้วยข้อมูลใหม่</p>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก'
            });

            if (!result.isConfirmed) return;

            Swal.fire({
                title: 'กำลังบันทึก...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const updateData = {
                    points: optimizedRoutePoints.map((point, index) => ({
                        pointNumber: index + 1,
                        lat: point.lat,
                        lng: point.lng,
                        address: point.address,
                        requestId: point.requestId || null
                    })),
                    totalDistance: routeAnalysisData.totalDistance,
                    totalDuration: routeAnalysisData.totalDuration,
                    numberOfPoints: optimizedRoutePoints.length
                };

                const response = await fetch(`/employee/routeList/${routeData._id}/updateRoute`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updateData)
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ!',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    throw new Error(data.message);
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถบันทึกได้',
                    confirmButtonText: 'ตกลง'
                });
            }
        }

        async function deleteRoute() {
            const result = await Swal.fire({
                title: 'ยืนยันการลบ?',
                html: `ต้องการลบเส้นทาง <strong>"${routeData.routeName}"</strong> หรือไม่?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/employee/routeList/${routeData._id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบสำเร็จ!',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => window.location.href = '/employee/routeList');
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        timer: 2000
                    });
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            setupSearch();
        });
        function openInGoogleMaps() {
    try {
        // ตรวจสอบว่ามีข้อมูลเส้นทางหรือไม่
        if (!routeData || !routeData.points || routeData.points.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'ไม่พบข้อมูลเส้นทาง',
                text: 'ไม่สามารถเปิด Google Maps ได้',
                timer: 2000
            });
            return;
        }

        // สร้าง URL สำหรับ Google Maps
        let googleMapsUrl = '';

        if (routeData.points.length === 1) {
            // กรณีมีจุดเดียว - แสดงตำแหน่ง
            const point = routeData.points[0];
            googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${point.lat},${point.lng}`;
        } else {
            // กรณีมีหลายจุด - สร้างเส้นทาง
            const origin = routeData.points[0];
            const destination = routeData.points[0]; // กลับมาจุดเริ่มต้น (round trip)
            
            // สร้าง waypoints (จุดระหว่างทาง) - ข้ามจุดแรกและจุดสุดท้าย
            const waypoints = routeData.points
                .slice(1) // ข้ามจุดแรก
                .map(point => `${point.lat},${point.lng}`)
                .join('|');

            // สร้าง URL แบบ Directions
            googleMapsUrl = `https://www.google.com/maps/dir/?api=1` +
                `&origin=${origin.lat},${origin.lng}` +
                `&destination=${destination.lat},${destination.lng}` +
                (waypoints ? `&waypoints=${waypoints}` : '') +
                `&travelmode=driving`;
        }

        // เปิดในหน้าต่างใหม่
        window.open(googleMapsUrl, '_blank');

        // แสดงข้อความยืนยัน
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'กำลังเปิด Google Maps...',
            showConfirmButton: false,
            timer: 2000
        });

    } catch (error) {
        console.error('Error opening Google Maps:', error);
        Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: 'ไม่สามารถเปิด Google Maps ได้',
            timer: 2000
        });
    }
}
async function updatePointStatus(routeId, pointId, isChecked) {
    const newStatus = isChecked ? 'complete' : 'in-progress';
    
    try {
        // แสดงสถานะกำลังโหลด
        const badge = document.getElementById(`status-badge-${pointId}`);
        const originalBadgeHTML = badge.innerHTML;
        badge.innerHTML = '<ion-icon name="refresh-outline" class="animate-spin"></ion-icon> กำลังอัปเดต...';

        // ส่ง Request ไปยัง Backend (คุณต้องสร้าง Route นี้รองรับใน Express)
        const response = await fetch(`/employee/routeList/${routeId}/point/${pointId}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        });

        const result = await response.json();

        if (result.success) {
            // อัปเดต UI หน้าเว็บทันที
            const card = document.getElementById(`point-card-${pointId}`);
            const addressText = document.getElementById(`address-text-${pointId}`);
            
            if (isChecked) {
                card.classList.add('bg-gray-100', 'opacity-75');
                addressText.classList.add('line-through', 'text-gray-500');
                badge.innerText = 'เสร็จสิ้นแล้ว';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-700';
            } else {
                card.classList.remove('bg-gray-100', 'opacity-75');
                addressText.classList.remove('line-through', 'text-gray-500');
                badge.innerText = 'รอดำเนินการ';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700';
            }

            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'อัปเดตสถานะเรียบร้อย',
                showConfirmButton: false,
                timer: 1500
            });
        } else {
            throw new Error(result.message);
        }
    } catch (error) {
        console.error('Update error:', error);
        // ติ๊ก Checkbox กลับคืนถ้าเกิดข้อผิดพลาด
        event.target.checked = !isChecked;
        Swal.fire({
            icon: 'error',
            title: 'ผิดพลาด',
            text: 'ไม่สามารถอัปเดตสถานะได้'
        });
    }
}
