        async function calculateRoadDistance(point1, point2) {
            const key = `${point1.id}-${point2.id}`;
            if (distanceMatrix[key]) return distanceMatrix[key];

            return new Promise((resolve) => {
                const service = new google.maps.DistanceMatrixService();

                service.getDistanceMatrix({
                    origins: [{ lat: point1.lat, lng: point1.lng }],
                    destinations: [{ lat: point2.lat, lng: point2.lng }],
                    travelMode: 'DRIVING',
                    unitSystem: google.maps.UnitSystem.METRIC
                }, (response, status) => {
                    if (status === 'OK') {
                        const result = response.rows[0].elements[0];
                        if (result.status === 'OK') {
                            const data = {
                                distance: result.distance.value / 1000,
                                duration: result.duration.value / 60
                            };
                            distanceMatrix[key] = data;
                            resolve(data);
                            return;
                        }
                    }
                    // Fallback Haversine
                    const distance = calculateStraightLineDistance(point1, point2);
                    const data = { distance, duration: (distance / 40) * 60 };
                    distanceMatrix[key] = data;
                    resolve(data);
                });
            });
        }

        function calculateStraightLineDistance(point1, point2) {
            const R = 6371;
            const dLat = toRad(point2.lat - point1.lat);
            const dLng = toRad(point2.lng - point1.lng);
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                    Math.cos(toRad(point1.lat)) * Math.cos(toRad(point2.lat)) *
                    Math.sin(dLng/2) * Math.sin(dLng/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }

        function toRad(degrees) {
            return degrees * (Math.PI / 180);
        }

        async function buildDistanceMatrix(points) {
            const n = points.length;
            const matrix = Array(n).fill(null).map(() => Array(n).fill(0));
            
            for (let i = 0; i < n; i++) {
                for (let j = i + 1; j < n; j++) {
                    const result = await calculateRoadDistance(points[i], points[j]);
                    matrix[i][j] = result.distance;
                    matrix[j][i] = result.distance;
                }
            }
            
            return matrix;
        }

        async function calculateOptimalRoute(points) {
            if (points.length < 2) return points;
            const n = points.length;
            const distMatrix = await buildDistanceMatrix(points);

            if (n === 2) return points;

            const startIdx = 0;
            let bestRoute = null;
            let bestTotalDistance = Infinity;

            // วิธีที่ 1: Nearest Neighbor แบบเริ่มจากจุดใกล้ที่สุด
            console.log('\n--- วิธีที่ 1: เริ่มจากจุดใกล้ที่สุด ---');
            const nearestFirst = await nearestNeighborStrict(startIdx, distMatrix, n);
            const nearestImproved = await improve2OptRoundTrip(nearestFirst, distMatrix);
            const nearestDistance = calculateTotalRoundTripDistance(nearestImproved, distMatrix);
            console.log(`ระยะทางรวม: ${nearestDistance.toFixed(2)} km`);
            if (nearestDistance < bestTotalDistance) {
                bestTotalDistance = nearestDistance;
                bestRoute = nearestImproved;
            }

            // วิธีที่ 2: ลองเริ่มจากทุกจุด
            console.log('\n--- วิธีที่ 2: ลองเริ่มจากทุกจุด ---');
            for (let secondPoint = 1; secondPoint < n; secondPoint++) {
                const altRoute = await nearestNeighborFromSecond(startIdx, secondPoint, distMatrix, n);
                const altImproved = await improve2OptRoundTrip(altRoute, distMatrix);
                const altDistance = calculateTotalRoundTripDistance(altImproved, distMatrix);
                console.log(`เริ่มจากจุด ${secondPoint + 1}: ${altDistance.toFixed(2)} km`);
                if (altDistance < bestTotalDistance) {
                    bestTotalDistance = altDistance;
                    bestRoute = altImproved;
                }
            }

            // วิธีที่ 3: Cheapest Insertion
            console.log('\n--- วิธีที่ 3: Cheapest Insertion ---');
            const cheapestRoute = await cheapestInsertion(startIdx, distMatrix, n);
            const cheapestImproved = await improve2OptRoundTrip(cheapestRoute, distMatrix);
            const cheapestDistance = calculateTotalRoundTripDistance(cheapestImproved, distMatrix);
            console.log(`ระยะทางรวม: ${cheapestDistance.toFixed(2)} km`);
            if (cheapestDistance < bestTotalDistance) {
                bestTotalDistance = cheapestDistance;
                bestRoute = cheapestImproved;
            }

            // วิธีที่ 4: Reverse Segments
            console.log('\n--- วิธีที่ 4: Reverse Segments ---');
            const reversedRoute = await tryReverseSegments(bestRoute, distMatrix);
            const reversedDistance = calculateTotalRoundTripDistance(reversedRoute, distMatrix);
            if (reversedDistance < bestTotalDistance) {
                bestTotalDistance = reversedDistance;
                bestRoute = reversedRoute;
                console.log(`✓ ปรับปรุงได้: ${reversedDistance.toFixed(2)} km`);
            }

            // วิธีที่ 5: Optimize เส้นกลับ
            console.log('\n--- วิธีที่ 5: Optimize เส้นกลับ ---');
            const optimizedRoute = await optimizeReturnPath(bestRoute, distMatrix);
            const optimizedDistance = calculateTotalRoundTripDistance(optimizedRoute, distMatrix);
            if (optimizedDistance < bestTotalDistance) {
                console.log('✓ Optimize เส้นกลับสำเร็จ!');
                bestRoute = optimizedRoute;
                bestTotalDistance = optimizedDistance;
            }

            console.log(`\n=== สรุป: ระยะทางรวมที่ดีที่สุด = ${bestTotalDistance.toFixed(2)} km ===`);
            return bestRoute.map(idx => points[idx]);
        }

        async function nearestNeighborStrict(startIdx, distMatrix, n) {
            const route = [startIdx];
            const visited = new Set([startIdx]);
            let currentIdx = startIdx;

            while (route.length < n) {
                let nearestIdx = -1;
                let nearestDistance = Infinity;
                for (let i = 0; i < n; i++) {
                    if (!visited.has(i) && distMatrix[currentIdx][i] < nearestDistance) {
                        nearestDistance = distMatrix[currentIdx][i];
                        nearestIdx = i;
                    }
                }
                if (nearestIdx !== -1) {
                    route.push(nearestIdx);
                    visited.add(nearestIdx);
                    currentIdx = nearestIdx;
                }
            }
            return route;
        }

        async function nearestNeighborFromSecond(startIdx, secondIdx, distMatrix, n) {
            const route = [startIdx, secondIdx];
            const visited = new Set([startIdx, secondIdx]);
            let currentIdx = secondIdx;

            while (route.length < n) {
                let nearestIdx = -1;
                let nearestDistance = Infinity;

                if (route.length === n - 1) {
                    for (let i = 0; i < n; i++) {
                        if (!visited.has(i)) {
                            const totalDist = distMatrix[currentIdx][i] + distMatrix[i][startIdx];
                            if (totalDist < nearestDistance) {
                                nearestDistance = totalDist;
                                nearestIdx = i;
                            }
                        }
                    }
                } else {
                    for (let i = 0; i < n; i++) {
                        if (!visited.has(i) && distMatrix[currentIdx][i] < nearestDistance) {
                            nearestDistance = distMatrix[currentIdx][i];
                            nearestIdx = i;
                        }
                    }
                }

                if (nearestIdx !== -1) {
                    route.push(nearestIdx);
                    visited.add(nearestIdx);
                    currentIdx = nearestIdx;
                }
            }
            return route;
        }

        async function cheapestInsertion(startIdx, distMatrix, n) {
            let nearestIdx = -1;
            let nearestDist = Infinity;
            for (let i = 1; i < n; i++) {
                if (distMatrix[startIdx][i] < nearestDist) {
                    nearestDist = distMatrix[startIdx][i];
                    nearestIdx = i;
                }
            }

            const route = [startIdx, nearestIdx];
            const visited = new Set([startIdx, nearestIdx]);

            while (route.length < n) {
                let bestInsertPos = -1;
                let bestInsertIdx = -1;
                let minIncrease = Infinity;

                for (let i = 0; i < n; i++) {
                    if (visited.has(i)) continue;
                    for (let pos = 1; pos <= route.length; pos++) {
                        const prevIdx = route[pos - 1];
                        const nextIdx = route[pos % route.length];
                        const increase = distMatrix[prevIdx][i] + distMatrix[i][nextIdx] - distMatrix[prevIdx][nextIdx];
                        if (increase < minIncrease) {
                            minIncrease = increase;
                            bestInsertPos = pos;
                            bestInsertIdx = i;
                        }
                    }
                }

                if (bestInsertIdx !== -1) {
                    route.splice(bestInsertPos, 0, bestInsertIdx);
                    visited.add(bestInsertIdx);
                }
            }
            return route;
        }

        async function tryReverseSegments(route, distMatrix) {
            let bestRoute = [...route];
            let bestDistance = calculateTotalRoundTripDistance(bestRoute, distMatrix);
            const n = route.length;

            for (let start = 1; start < n - 1; start++) {
                for (let end = start + 1; end < n; end++) {
                    const testRoute = [...route];
                    for (let i = start, j = end; i < j; i++, j--) {
                        [testRoute[i], testRoute[j]] = [testRoute[j], testRoute[i]];
                    }
                    const testDistance = calculateTotalRoundTripDistance(testRoute, distMatrix);
                    if (testDistance < bestDistance) {
                        bestDistance = testDistance;
                        bestRoute = [...testRoute];
                    }
                }
            }
            return bestRoute;
        }

        async function optimizeReturnPath(route, distMatrix) {
            const n = route.length;
            if (n < 3) return route;

            const startIdx = route[0];
            let bestRoute = [...route];
            let bestTotalDist = calculateTotalRoundTripDistance(bestRoute, distMatrix);

            // ลอง reverse บางส่วน
            for (let returnPoint = n - 2; returnPoint >= Math.max(1, n - 4); returnPoint--) {
                const testRoute = [...route];
                for (let i = returnPoint, j = n - 1; i < j; i++, j--) {
                    [testRoute[i], testRoute[j]] = [testRoute[j], testRoute[i]];
                }
                const testTotalDist = calculateTotalRoundTripDistance(testRoute, distMatrix);
                if (testTotalDist < bestTotalDist) {
                    bestTotalDist = testTotalDist;
                    bestRoute = [...testRoute];
                }
            }

            // ลองย้ายจุดที่ใกล้จุดเริ่มต้นมาเป็นจุดสุดท้าย
            let closestToStart = -1;
            let minDistToStart = Infinity;
            for (let i = 1; i < n; i++) {
                const dist = distMatrix[route[i]][route[0]];
                if (dist < minDistToStart) {
                    minDistToStart = dist;
                    closestToStart = i;
                }
            }

            if (closestToStart > 0 && closestToStart !== n - 1) {
                const testRoute = [...route];
                const closestPoint = testRoute.splice(closestToStart, 1)[0];
                testRoute.push(closestPoint);
                const improvedRoute = await improve2OptRoundTrip(testRoute, distMatrix);
                const testTotalDist = calculateTotalRoundTripDistance(improvedRoute, distMatrix);
                if (testTotalDist < bestTotalDist) {
                    bestTotalDist = testTotalDist;
                    bestRoute = [...improvedRoute];
                }
            }

            // Permutation สำหรับเส้นทางที่ไม่ยาวมาก
            if (n <= 8) {
                const permutations = generateLastNPermutations(route, Math.min(4, n - 1));
                for (const testRoute of permutations) {
                    const testTotalDist = calculateTotalRoundTripDistance(testRoute, distMatrix);
                    if (testTotalDist < bestTotalDist - 0.01) {
                        bestTotalDist = testTotalDist;
                        bestRoute = [...testRoute];
                    }
                }
            }

            if (bestRoute.length !== n) {
                console.warn('⚠️ พบจุดซ้ำ กำลังใช้เส้นทางเดิม');
                return route;
            }

            return bestRoute;
        }

        async function improve2OptRoundTrip(route, distMatrix) {
            const n = route.length;
            let improved = true;
            let currentRoute = [...route];
            let iterations = 0;
            const maxIterations = 1000;

            while (improved && iterations < maxIterations) {
                improved = false;
                iterations++;

                for (let i = 1; i < n - 1; i++) {
                    for (let j = i + 1; j < n; j++) {
                        const edge1Start = currentRoute[i - 1];
                        const edge1End = currentRoute[i];
                        const edge2Start = currentRoute[j];
                        const edge2End = currentRoute[(j + 1) % n];

                        const oldDist = distMatrix[edge1Start][edge1End] + distMatrix[edge2Start][edge2End];
                        const newDist = distMatrix[edge1Start][edge2Start] + distMatrix[edge1End][edge2End];

                        if (newDist < oldDist - 0.001) {
                            const newRoute = [...currentRoute];
                            for (let k = i, l = j; k < l; k++, l--) {
                                [newRoute[k], newRoute[l]] = [newRoute[l], newRoute[k]];
                            }
                            currentRoute = newRoute;
                            improved = true;
                        }
                    }
                }
            }
            return currentRoute;
        }

        function calculateTotalRoundTripDistance(route, distMatrix) {
            let total = 0;
            const n = route.length;
            for (let i = 0; i < n; i++) {
                total += distMatrix[route[i]][route[(i + 1) % n]];
            }
            return total;
        }

        function generateLastNPermutations(route, n) {
            const fixed = route.slice(0, route.length - n);
            const toPermute = route.slice(route.length - n);
            const permutations = [];

            function permute(arr, current = []) {
                if (arr.length === 0) {
                    permutations.push([...fixed, ...current]);
                    return;
                }
                for (let i = 0; i < arr.length; i++) {
                    permute([...arr.slice(0, i), ...arr.slice(i + 1)], [...current, arr[i]]);
                }
            }

            permute(toPermute);
            return permutations;
        }

        // ตัววาดเส้นบนแผนที่
        async function displayOptimizedRoute(route) {
            try {
                clearRoute();
                if (route.length < 2) return;

                optimizedRoutePoints = [...route];

                let totalDistance = 0;
                let totalDuration = 0;
                const routeSegments = [];

                for (let i = 0; i < route.length; i++) {
                    const currentPoint = route[i];
                    const nextPoint = (i === route.length - 1) ? route[0] : route[i + 1];
                    const isReturnTrip = (i === route.length - 1);
                    const isFirstSegment = (i === 0);

                    try {
                        const result = await calculateRoadDistance(currentPoint, nextPoint);
                        totalDistance += result.distance;
                        totalDuration += result.duration;
                        routeSegments.push(result);

                        // กำหนดสีและความหนาของเส้น
                        let color, strokeWeight, strokeOpacity, zIndex;

                        if (isFirstSegment) {
                            color = '#10B981';
                            strokeWeight = 7;
                            strokeOpacity = 0.9;
                            zIndex = 3;
                        } else if (isReturnTrip) {
                            color = '#EF4444';
                            strokeWeight = 6;
                            strokeOpacity = 0.85;
                            zIndex = 2;
                        } else {
                            color = '#3B82F6';
                            strokeWeight = 5;
                            strokeOpacity = 0.8;
                            zIndex = 1;
                        }

                        await new Promise((resolve, reject) => {
                            directionsService.route({
                                origin: { lat: currentPoint.lat, lng: currentPoint.lng },
                                destination: { lat: nextPoint.lat, lng: nextPoint.lng },
                                travelMode: 'DRIVING'
                            }, (result, status) => {
                                if (status === 'OK') {
                                    const renderer = new google.maps.DirectionsRenderer({
                                        map: map,
                                        directions: result,
                                        suppressMarkers: true,
                                        preserveViewport: true,
                                        polylineOptions: {
                                            strokeColor: color,
                                            strokeWeight: strokeWeight,
                                            strokeOpacity: strokeOpacity,
                                            zIndex: zIndex
                                        }
                                    });
                                    directionsRenderers.push(renderer);
                                    resolve();
                                } else {
                                    console.error(`❌ Directions API Error (segment ${i + 1}): ${status}`);
                                    reject(new Error(`ไม่สามารถวาดเส้นทาง: ${status}`));
                                }
                            });
                        });
                    } catch (segmentError) {
                        console.error(`❌ Error in segment ${i + 1}:`, segmentError);
                        throw segmentError;
                    }
                }

                // วาด Markers
                route.forEach((point, index) => {
                    const isStart = index === 0;
                    const isEnd = index === route.length - 1;

                    let markerColor;
                    if (point.requestId) {
                        markerColor = '#10B981';
                    } else if (isStart) {
                        markerColor = '#059669';
                    } else {
                        markerColor = '#3B82F6';
                    }

                    const marker = new google.maps.Marker({
                        position: { lat: point.lat, lng: point.lng },
                        map: map,
                        icon: {
                            path: google.maps.SymbolPath.CIRCLE,
                            fillColor: markerColor,
                            fillOpacity: 1,
                            strokeColor: 'white',
                            strokeWeight: 3,
                            scale: isStart ? 18 : (isEnd ? 16 : 14)
                        },
                        label: {
                            text: String(index + 1),
                            color: 'white',
                            fontWeight: 'bold',
                            fontSize: isStart ? '16px' : '14px'
                        },
                        zIndex: isStart ? 1002 : (isEnd ? 1001 : 1000),
                        animation: google.maps.Animation.DROP
                    });

                    const infoWindow = new google.maps.InfoWindow({
                        content: `<div style="padding: 8px; min-width: 200px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                <div style="background: ${markerColor}; color: white; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                    ${index + 1}
                                </div>
                                <b style="color: #059669; font-size: 15px; display:flex; align-items:center; gap:4px;">
                                    ${isStart ? '<ion-icon name="rocket"></ion-icon> จุดเริ่มต้น' : (isEnd ? '<ion-icon name="flag"></ion-icon> จุดสุดท้าย' : `จุดที่ ${index + 1}`)}
                                </b>
                            </div>
                            <div style="color: #4B5563; font-size: 13px; margin-top: 4px;">
                                ${point.address ? point.address.replace('undefined undefined - ', '') : ''}
                            </div>
                            ${point.requestId ? '<div style="color: #10B981; font-size: 12px; margin-top: 4px; display:flex; align-items:center; gap:4px;"><ion-icon name="clipboard"></ion-icon> จากคำขอขายขยะ</div>' : ''}
                        </div>`
                    });

                    marker.addListener('click', () => infoWindow.open(map, marker));
                    routeMarkers.push(marker);
                });

                // ปรับ bounds
                const bounds = new google.maps.LatLngBounds();
                route.forEach(p => bounds.extend({ lat: p.lat, lng: p.lng }));
                map.fitBounds(bounds);

                displayDetailedRouteResults(route, routeSegments, totalDistance, totalDuration);

                // สร้าง Legend
