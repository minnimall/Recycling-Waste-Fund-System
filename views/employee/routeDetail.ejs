        // Route analysis functions
        async function analyzeRoute() {
            if (selectedPoints.length < 2) {
                Swal.fire({
                    icon: 'warning',
                    title: 'จำนวนจุดไม่เพียงพอ',
                    text: 'ต้องมีอย่างน้อย 2 จุด',
