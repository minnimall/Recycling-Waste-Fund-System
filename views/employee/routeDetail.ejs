<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <!-- <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" /> -->
    <link rel="stylesheet" href="/style_employee/res_req.css">
    <script async
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCOj0SmyVA_9XcjvxjELwfzvO8LNN6uJgw&libraries=places,geometry&loading=async&callback=initMap">
    </script>
    <style>
        .content {
            margin-left: 0;
            padding: 20px;
        }
        .edit-mode-controls {
            display: none;
        }
        .edit-mode .edit-mode-controls {
            display: block;
        }
        .edit-mode .view-mode-controls {
            display: none;
        }
        .point-item {
            transition: all 0.3s ease;
        }
        .point-item:hover {
            transform: translateX(5px);
        }
    </style>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>

    <main class="content bg-gray-50 min-screen">
        <!-- Header -->
        <!-- Header -->
        <div class="mx-4 mb-6 relative overflow-hidden bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
            
            <div class="relative z-10 p-6 md:p-8">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="flex items-center gap-5">
                        <a href="/employee/routeList" class="group flex items-center justify-center w-12 h-12 bg-white border border-gray-200 text-gray-500 rounded-xl shadow-sm hover:border-blue-500 hover:text-blue-600 hover:shadow-md transition-all duration-200">
                            <ion-icon name="arrow-back-outline" class="text-2xl group-hover:-translate-x-0.5 transition-transform duration-200"></ion-icon>
                        </a>
                        
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 tracking-tight">
                                <%= route.routeName %>
                            </h1>
                            <div class="flex items-center gap-2 mt-2 text-sm text-gray-500">
                                <ion-icon name="calendar-clear-outline" class="text-blue-500"></ion-icon>
                                <span>บันทึกเมื่อ <%= new Date(route.createdAt).toLocaleDateString('th-TH', { 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %> น.</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <!-- View Mode Buttons -->
                        <div class="view-mode-controls flex items-center gap-3 w-full md:w-auto">
                            <button onclick="toggleEditMode()" 
                                    class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-xl font-medium shadow-lg shadow-blue-200 hover:bg-blue-700 hover:shadow-blue-300 hover:-translate-y-0.5 transition-all duration-200">
                                <ion-icon name="create-outline" class="text-xl"></ion-icon>
                                <span>แก้ไขเส้นทาง</span>
                            </button>
                            <button onclick="deleteRoute()" 
                                    class="flex-none flex items-center justify-center px-4 py-2.5 rounded-xl border border-red-200 text-red-500 bg-red-50/30 hover:bg-red-50 hover:text-red-600 hover:border-red-300 transition-colors duration-200">
                                <ion-icon name="trash-outline" class="text-xl md:mr-2"></ion-icon>
                                <span class="hidden md:inline font-medium">ลบ</span>
                            </button>
                        </div>
                        
                        <!-- Edit Mode Buttons -->
                        <div class="edit-mode-controls w-full md:w-auto">
                            <button onclick="toggleEditMode()" 
                                    class="w-full md:w-auto flex items-center justify-center gap-2 bg-gray-700 text-white px-5 py-2.5 rounded-xl font-medium shadow-lg shadow-gray-200 hover:bg-gray-800 hover:-translate-y-0.5 transition-all duration-200">
                                <ion-icon name="close-circle-outline" class="text-xl"></ion-icon>
                                <span>ยกเลิกการแก้ไข</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="mx-4 mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-lg shadow-lg p-6 ">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">จำนวนจุด</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= route.numberOfPoints %>
                        </p>
                    </div>
                    <ion-icon name="location" class="text-4xl text-blue-500 opacity-50"></ion-icon>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-6 ">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">ระยะทางรวม</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= route.totalDistance.toFixed(2) %>
                        </p>
                        <p class="text-xs text-gray-500">กิโลเมตร</p>
                    </div>
                    <ion-icon name="speedometer" class="text-4xl text-500 opacity-50"></ion-icon>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-lg p-6 ">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-600 text-sm">เวลาโดยประมาณ</p>
                        <p class="text-3xl font-bold text-600 mt-2">
                            <%= Math.round(route.totalDuration) %>
                        </p>
                        <p class="text-xs text-gray-500">นาที (~<%= (route.totalDuration/60).toFixed(1) %> ชม.)</p>
                    </div>
                    <ion-icon name="time" class="text-4xl text-purple-500 opacity-50"></ion-icon>
                </div>
            </div>

        <div class="bg-white rounded-lg shadow-lg p-6 ">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-600 text-sm">บันทึกโดย</p>
                    <p class="text-lg font-bold text-600 mt-2">
                        <% if (route.createdBy) { %>
                            <%= route.createdBy.firstname %> <%= route.createdBy.lastname %>
                        <% } else { %>
                            ระบบ
                        <% } %>
                    </p>
                    </div>
                    <ion-icon name="person-circle" class="text-4xl text-orange-500 opacity-50"></ion-icon>
                </div>
            </div>
        </div>

        <!-- Note Section -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                    <!-- <ion-icon name="document-text-outline" class="mr-2 text-yellow-500"></ion-icon> -->
                    หมายเหตุ
                </h3>
                <button onclick="editNameAndNote()" 
                        class="view-mode-controls text-blue-600 hover:text-blue-800 text-sm">
                    <ion-icon name="create-outline" class="align-middle"></ion-icon> แก้ไข
                </button>
            </div>
            <p id="noteDisplay" class="text-gray-700 rounded-lg">
                <%= route.note || 'ไม่มีหมายเหตุ' %>
            </p>
        </div>

        <!-- 🔥 วางตรงนี้ - แสดงรายการ Waste Sale Request ที่เกี่ยวข้อง -->
        <% if (route.wasteSaleRequests && route.wasteSaleRequests.length > 0) { %>
        <div class="mx-4 mb-6 bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                <ion-icon name="document-outline" class="mr-2 text-green-500"></ion-icon>
                คำขอขายขยะที่เกี่ยวข้อง (<%= route.wasteSaleRequests.length %> รายการ)
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% route.wasteSaleRequests.forEach(request => { %>
                    <div class="border border-green-200 rounded-lg p-4 bg-green-50">
                        <div class="font-semibold text-gray-800">
                            <%= request.family ? request.family.familyName : 'ไม่ระบุชื่อ' %>
                        </div>
                        <div class="text-sm text-gray-600 mt-2">
                            <% if (request.waste && request.waste.length > 0) { %>
                                <p class="font-medium">ประเภทขยะ:</p>
                                <ul class="list-disc list-inside">
                                    <% request.waste.forEach(w => { %>
                                        <li><%= w.wasteName %></li>
                                    <% }); %>
                                </ul>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>

        <div class="mx-4 mb-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Control Panel -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4 max-h-[calc(100vh-100px)] overflow-y-auto">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="list-outline" class="mr-2 text-blue-500"></ion-icon>
                        จุดในเส้นทาง
                    </h3>

                    <!-- Edit Mode: Search -->
                    <div class="edit-mode-controls mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">เพิ่มจุดใหม่</label>
                        <div class="relative">
                            <input type="text" 
                                id="searchInput" 
                                class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                                placeholder="ค้นหาที่อยู่...">
                            <button id="searchBtn" 
                                    class="absolute right-2 top-2 p-2 text-blue-600">
                                <ion-icon name="search-outline"></ion-icon>
                            </button>
                        </div>
                        <div id="searchSuggestions" class="mt-2 hidden"></div>
                        <p class="text-xs text-gray-500 mt-2">หรือคลิกบนแผนที่เพื่อเพิ่มจุด</p>
                    </div>

                    <!-- Points List -->
                    <div id="pointsList" class="space-y-3 mb-4">
                        <% route.points.forEach((point, index) => { %>
                            <div class="point-item 
                                        <%= point.status === 'complete' ? 'bg-green-50 border-green-300' : (point.status === 'failed' ? 'bg-red-50 border-red-300' : (index === 0 ? 'bg-green-50 border-green-300' : 'bg-blue-50 border-blue-200')) %> 
                                        border rounded-lg p-4 transition-all" 
                                        id="point-card-<%= point._id %>">
                                <div class="flex items-start gap-3">
                                    <div class="<%= point.status === 'complete' ? 'bg-green-600' : (point.status === 'failed' ? 'bg-red-500' : (index === 0 ? 'bg-green-600' : 'bg-blue-600')) %> 
                                                text-white rounded-full w-10 h-10 flex items-center justify-center font-bold flex-shrink-0">
                                        <% if (point.status === 'complete') { %>
                                            <ion-icon name="checkmark" class="text-xl"></ion-icon>
                                        <% } else if (point.status === 'failed') { %>
                                            <ion-icon name="close" class="text-xl"></ion-icon>
                                        <% } else { %>
                                            <%= point.pointNumber %>
                                        <% } %>
                                    </div>

                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-800 break-words <%= point.status === 'complete' ? 'line-through text-gray-500' : '' %>"
                                        id="address-text-<%= point._id %>">
                                            <%= point.address ? point.address.replace('undefined undefined - ', '') : '' %>
                                        </p>
                                        <div class="flex items-center gap-2 mt-1">
                                            <% if (index === 0) { %>
                                                <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-700">
                                                    <ion-icon name="location"></ion-icon> จุดเริ่มต้น
                                                </span>
                                            <% } else { %>
                                                <span id="status-badge-<%= point._id %>" 
                                                    class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full 
                                                        <%= point.status === 'complete' ? 'bg-green-100 text-green-700' : 
                                                           (point.status === 'failed' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700') %>">
                                                    <% if (point.status === 'complete') { %>
                                                        <ion-icon name="checkmark-circle"></ion-icon> เสร็จสิ้น
                                                    <% } else if (point.status === 'failed') { %>
                                                        <ion-icon name="close-circle"></ion-icon> มีปัญหา
                                                    <% } else { %>
                                                        <ion-icon name="time"></ion-icon> รอดำเนินการ
                                                    <% } %>
                                                </span>
                                            <% } %>
                                            <p class="text-[10px] text-gray-400">
                                                <%= point.lat.toFixed(6) %>, <%= point.lng.toFixed(6) %>
                                            </p>
                                        </div>
                                        <% if (index !== 0 && point.requestId && point.requestId.family) { %>
                                        <div class="flex items-center gap-1 mt-1.5">
                                            <ion-icon name="person-outline" class="text-[11px] text-indigo-400"></ion-icon>
                                            <span class="text-[10px] text-indigo-500 font-medium"><%= point.requestId.family.familyName %></span>
                                        </div>
                                        <% } %>

                                        <!-- Action Buttons (View Mode) — ไม่แสดงจุดแรก (จุดเริ่มต้น) -->
                                        <% if (index !== 0) { %>
                                        <div class="view-mode-controls flex gap-2 mt-3" id="actions-<%= point._id %>">
                                            <% if (point.status === 'in-progress') { %>
                                                <button onclick="markPointComplete('<%= route._id %>', '<%= point._id %>')" 
                                                        class="flex items-center gap-1 px-3 py-1.5 bg-green-600 text-white text-xs rounded-lg hover:bg-green-700 transition shadow-sm">
                                                    <ion-icon name="checkmark-circle-outline"></ion-icon> เสร็จสิ้น
                                                </button>
                                                <button onclick="markPointFailed('<%= route._id %>', '<%= point._id %>')" 
                                                        class="flex items-center gap-1 px-3 py-1.5 bg-red-500 text-white text-xs rounded-lg hover:bg-red-600 transition shadow-sm">
                                                    <ion-icon name="alert-circle-outline"></ion-icon> มีปัญหา
                                                </button>
                                            <% } else { %>
                                                <button onclick="markPointReset('<%= route._id %>', '<%= point._id %>')" 
                                                        class="flex items-center gap-1 px-3 py-1.5 bg-gray-500 text-white text-xs rounded-lg hover:bg-gray-600 transition shadow-sm">
                                                    <ion-icon name="refresh-outline"></ion-icon> ยกเลิกสถานะ
                                                </button>
                                            <% } %>
                                        </div>
                                        <% } %>
                                    </div>
                                    
                                    <button onclick="removePoint(<%= index %>)" class="edit-mode-controls text-red-500">
                                        <ion-icon name="close-circle-outline" class="text-2xl"></ion-icon>
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Complete All Button (View Mode) -->
                    <% const hasInProgress = route.points.slice(1).some(p => p.status === 'in-progress'); %>
                    <% if (hasInProgress) { %>
                    <div class="view-mode-controls mb-4">
                        <button onclick="completeAllPoints('<%= route._id %>')" 
                                class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3 px-4 rounded-xl hover:from-green-700 hover:to-emerald-700 transition shadow-lg shadow-green-200 font-medium">
                            <ion-icon name="checkmark-done-outline" class="text-xl"></ion-icon>
                            จบงานทุกจุดที่เหลือ
                        </button>
                    </div>
                    <% } %>

                    <!-- Edit Mode: Analyze Button -->
                    <div class="edit-mode-controls space-y-3">
                        <button id="analyzeBtn" 
                                onclick="analyzeRoute()"
                                class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 transition">
                            <ion-icon name="analytics-outline" class="align-middle"></ion-icon>
                            วิเคราะห์เส้นทางใหม่
                        </button>
                        <button onclick="clearAllPoints()"
                                class="w-full bg-red-600 text-white py-3 px-4 rounded-lg hover:bg-red-700 transition">
                            <ion-icon name="trash-outline" class="align-middle"></ion-icon>
                            ล้างจุดทั้งหมด
                        </button>
                        <button onclick="saveEditedRoute()" 
                                class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition">
                            <ion-icon name="save-outline" class="align-middle"></ion-icon>
                            บันทึกการแก้ไข
                        </button>
                    </div>

                    <!-- Route Results -->
                    <div id="routeResults" class="mt-6 hidden">
                        <h3 class="text-lg font-medium text-gray-700 mb-3">ผลการวิเคราะห์</h3>
                        <div id="routeInfo" class="bg-blue-50 p-4 rounded-lg text-sm"></div>
                    </div>
                </div>
            </div>

            <!-- Map Section -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-lg p-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                        <ion-icon name="map-outline" class="mr-2 text-blue-500"></ion-icon>
                        แผนที่แสดงเส้นทาง
                    </h3>
                    <div class="edit-mode-controls mb-3 text-sm text-blue-600 bg-blue-50 p-3 rounded-lg border border-blue-200">
                        <ion-icon name="information-circle" class="inline-block mr-2"></ion-icon>
                        คลิกบนแผนที่เพื่อเพิ่มจุดใหม่
                    </div>
                    <div id="map" class="w-full h-[600px] rounded-lg border border-gray-200"></div>
                </div>
            </div>
        </div>
    </main>

    <script>
        const routeData = <%- JSON.stringify(route) %>;
        let map;
        let isEditMode = false;
        let selectedPoints = [];
        let markers = [];
        let routeMarkers = [];
        let directionsRenderers = [];   // แทน routeLayer + routingControl
        let directionsService;
        let geocoder;
        let distanceMatrix = {};
        let optimizedRoutePoints = [];
        let routeAnalysisData = null;
        let searchTimeout = null;
        let mapInitialized = false;

        let tambolPolygon = null;
        let checkPolygon = null;

        const KHAMPO_POLYGON_COORDS = [
            { lat: 15.9917406, lng: 102.9022698 },
            { lat: 15.9847685, lng: 102.9053383 },
            { lat: 15.9805724, lng: 102.905049 },
            { lat: 15.9736823, lng: 102.9033324 },
            { lat: 15.9674935, lng: 102.9031393 },
            { lat: 15.9622328, lng: 102.9013798 },
            { lat: 15.9578798, lng: 102.8959725 },
            { lat: 15.9531553, lng: 102.897217 },
            { lat: 15.9505557, lng: 102.8983757 },
            { lat: 15.9452121, lng: 102.8965089 },
            { lat: 15.9417871, lng: 102.8927109 },
            { lat: 15.9387954, lng: 102.8906724 },
            { lat: 15.9372067, lng: 102.890651 },
            { lat: 15.9362163, lng: 102.891874 },
            { lat: 15.934318,  lng: 102.8916165 },
            { lat: 15.9333483, lng: 102.8911874 },
            { lat: 15.9316151, lng: 102.8925607 },
            { lat: 15.9268487, lng: 102.8976032 },
            { lat: 15.9231964, lng: 102.8980538 },
            { lat: 15.9195854, lng: 102.8975174 },
            { lat: 15.9167997, lng: 102.9001138 },
            { lat: 15.9117028, lng: 102.9021308 },
            { lat: 15.9087312, lng: 102.9032895 },
            { lat: 15.9058009, lng: 102.9032895 },
            { lat: 15.902788,  lng: 102.9043195 },
            { lat: 15.9017149, lng: 102.9014012 },
            { lat: 15.8994036, lng: 102.8953073 },
            { lat: 15.8968034, lng: 102.8912732 },
            { lat: 15.8967621, lng: 102.8874967 },
            { lat: 15.8978352, lng: 102.8839776 },
            { lat: 15.9017562, lng: 102.8802869 },
            { lat: 15.9028293, lng: 102.8745792 },
            { lat: 15.9033659, lng: 102.8739354 },
            { lat: 15.9024166, lng: 102.8714892 },
            { lat: 15.8993211, lng: 102.8696439 },
            { lat: 15.89961,   lng: 102.8648803 },
            { lat: 15.9010133, lng: 102.862477 },
            { lat: 15.9043564, lng: 102.862992 },
            { lat: 15.9225968, lng: 102.8317473 },
            { lat: 15.9290346, lng: 102.8333781 },
            { lat: 15.938691,  lng: 102.8343222 },
            { lat: 15.953381,  lng: 102.8323481 },
            { lat: 15.9575806, lng: 102.8497956 },
            { lat: 15.9756524, lng: 102.8656742 },
            { lat: 15.9906697, lng: 102.8862736 },
            { lat: 15.9917406, lng: 102.9022698 }
        ];

        function initMap() {
            if (mapInitialized) return;

            const firstPoint = routeData.points[0];

            map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: firstPoint.lat, lng: firstPoint.lng },
                zoom: 13,
                mapTypeId: 'hybrid',
                streetViewControl: false,
                fullscreenControl: true
            });

            geocoder = new google.maps.Geocoder();
            directionsService = new google.maps.DirectionsService();

            // วาด Polygon ตำบลขามป้อม
            drawTambolPolygon();

            map.addListener('click', function(e) {
                if (!isEditMode) return;

                const lat = e.latLng.lat();
                const lng = e.latLng.lng();

                // เช็คพื้นที่เฉพาะตอน edit mode
                if (!isWithinTambol(lat, lng)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'อยู่นอกพื้นที่',
                        text: 'กรุณาเพิ่มจุดภายในเขตตำบลขามป้อมเท่านั้น',
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#EF4444',
                        timer: 3000
                    });
                    return;
                }

                reverseGeocode(lat, lng).then(address => {
                    addPoint(lat, lng, address);
                }).catch(() => {
                    addPoint(lat, lng, `จุดที่ ${lat.toFixed(4)}, ${lng.toFixed(4)}`);
                });
            });

            mapInitialized = true;
            loadExistingRoute();
            setupSearch();
        }

        // ฟังก์ชันวาด Polygon ของตำบลขามป้อม
        function drawTambolPolygon() {
            tambolPolygon = new google.maps.Polygon({
                paths: KHAMPO_POLYGON_COORDS,
                strokeColor: '#2563EB',
                strokeOpacity: 0.8,
                strokeWeight: 2.5,
                fillColor: '#3B82F6',
                fillOpacity: 0.08,
                map: map,
                zIndex: 0,
                clickable: false
            });

            checkPolygon = new google.maps.Polygon({
                paths: KHAMPO_POLYGON_COORDS
            });
        }

        // ฟังก์ชันตรวจสอบว่าจุดที่เลือกอยู่ภายในพื้นที่ตำบลขามป้อมหรือไม่
        function isWithinTambol(lat, lng) {
            if (!checkPolygon) return true;
            const point = new google.maps.LatLng(lat, lng);
            return google.maps.geometry.poly.containsLocation(point, checkPolygon);
        }

        function loadExistingRoute() {
            // แปลง route points เป็น selectedPoints
            selectedPoints = routeData.points.map((point, index) => ({
                id: index + 1,
                lat: point.lat,
                lng: point.lng,
                address: point.address,
                requestId: point.requestId || null
            }));

            displayRoute();
        }

        async function displayRoute() {
            markers.forEach(marker => marker.setMap(null));
            markers = [];
            routeMarkers.forEach(marker => marker.setMap(null));
            routeMarkers = [];
            directionsRenderers.forEach(renderer => renderer.setMap(null));
            directionsRenderers = [];

            if (selectedPoints.length < 2) return;

            try {
                for (let i = 0; i < selectedPoints.length; i++) {
                    const currentPoint = selectedPoints[i];
                    const nextPoint = (i === selectedPoints.length - 1)
                        ? selectedPoints[0]
                        : selectedPoints[i + 1];
                    const isReturnTrip = (i === selectedPoints.length - 1);

                    let color;
                    if (isReturnTrip)  color = '#EF4444';
                    else if (i === 0)  color = '#10B981';
                    else               color = '#3B82F6';

                    // วาดเส้น Directions
                    await new Promise((resolve) => {
                        directionsService.route({
                            origin: { lat: currentPoint.lat, lng: currentPoint.lng },
                            destination: { lat: nextPoint.lat, lng: nextPoint.lng },
                            travelMode: 'DRIVING'
                        }, (result, status) => {
                            if (status === 'OK') {
                                const renderer = new google.maps.DirectionsRenderer({
                                    map: map,
                                    directions: result,
                                    suppressMarkers: true,
                                    preserveViewport: true,
                                    polylineOptions: {
                                        strokeColor: color,
                                        strokeWeight: 5,
                                        strokeOpacity: 0.8
                                    }
                                });
                                directionsRenderers.push(renderer);
                            }
                            resolve();
                        });
                    });
                }

                // วาด Markers
                selectedPoints.forEach((point, index) => {
                    const isStart = index === 0;
                    const color = isStart ? '#059669' : (point.requestId ? '#10B981' : '#3B82F6');

                    const marker = new google.maps.Marker({
                        position: { lat: point.lat, lng: point.lng },
                        map: map,
                        icon: {
                            path: google.maps.SymbolPath.CIRCLE,
                            fillColor: color,
                            fillOpacity: 1,
                            strokeColor: 'white',
                            strokeWeight: 3,
                            scale: 14
                        },
                        label: {
                            text: String(point.id),
                            color: 'white',
                            fontWeight: 'bold',
                            fontSize: '13px'
                        }
                    });

                    const infoWindow = new google.maps.InfoWindow({
                        content: `<div style="padding:6px;">
                            <b>จุดที่ ${point.id}</b><br>
                            <div style="font-size:13px; margin-top:4px;">${point.address ? point.address.replace('undefined undefined - ', '') : ''}</div>
                            ${isStart ? '<div style="color:#059669; font-size:12px; display:flex; align-items:center; gap:4px;"><ion-icon name="locate"></ion-icon> จุดเริ่มต้น/สิ้นสุด</div>' : ''}
                        </div>`
                    });

                    marker.addListener('click', () => infoWindow.open(map, marker));
                    markers.push(marker);
                });

                // ปรับ bounds
                const bounds = new google.maps.LatLngBounds();
                selectedPoints.forEach(p => bounds.extend({ lat: p.lat, lng: p.lng }));
                map.fitBounds(bounds);

            } catch (error) {
                console.error('Error loading route:', error);
            }
        }

