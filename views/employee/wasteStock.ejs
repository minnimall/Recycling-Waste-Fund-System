    <!-- Chart initialization script -->
    <script>
        // Initialize charts when the DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Pie chart for waste distribution
            const distributionCtx = document.getElementById('wasteDistributionChart').getContext('2d');
            const distributionChart = new Chart(distributionCtx, {
                type: 'pie',
                data: {
                    labels: ['ขยะรีไซเคิล', 'ขยะอินทรีย์', 'ขยะอันตราย', 'ขยะทั่วไป'],
                    datasets: [{
                        data: [1250, 850, 320, 750],
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.7)',
                            'rgba(16, 185, 129, 0.7)',
                            'rgba(239, 68, 68, 0.7)',
                            'rgba(107, 114, 128, 0.7)'
                        ],
                        borderColor: [
                            'rgba(59, 130, 246, 1)',
                            'rgba(16, 185, 129, 1)',
                            'rgba(239, 68, 68, 1)',
                            'rgba(107, 114, 128, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                        }
                    }
                }
            });

            // Bar chart for monthly waste
            const monthlyCtx = document.getElementById('wasteMonthlyChart').getContext('2d');
            const monthlyChart = new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.'],
                    datasets: [
                        {
                            label: 'ขยะรีไซเคิล',
                            data: [1100, 1200, 1250, 0, 0, 0],
                            backgroundColor: 'rgba(59, 130, 246, 0.7)',
                            borderColor: 'rgba(59, 130, 246, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'ขยะอินทรีย์',
                            data: [800, 820, 850, 0, 0, 0],
                            backgroundColor: 'rgba(16, 185, 129, 0.7)',
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'ขยะอันตราย',
                            data: [300, 310, 320, 0, 0, 0],
                            backgroundColor: 'rgba(239, 68, 68, 0.7)',
                            borderColor: 'rgba(239, 68, 68, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'ขยะทั่วไป',
                            data: [700, 730, 750, 0, 0, 0],
                            backgroundColor: 'rgba(107, 114, 128, 0.7)',
                            borderColor: 'rgba(107, 114, 128, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'น้ำหนัก (กก.)'
                            }
                        }
                    }
                }
            });

            // Add event listeners for search and filter
            document.getElementById('search').addEventListener('input', filterTable);
            document.getElementById('wasteTypeFilter').addEventListener('change', filterTable);

            function filterTable() {
                const searchTerm = document.getElementById('search').value.toLowerCase();
                const filterType = document.getElementById('wasteTypeFilter').value.toLowerCase();
                const rows = document.querySelectorAll('tbody tr');

                rows.forEach(row => {
                    const wasteType = row.querySelector('td:first-child').textContent.toLowerCase();
                    const wasteSubtype = row.querySelector('td:nth-child(2)').textContent.toLowerCase();

                    const matchesSearch = searchTerm === '' || 
                                        wasteType.includes(searchTerm) || 
                                        wasteSubtype.includes(searchTerm);

                    const matchesFilter = filterType === '' || wasteType.includes(filterType);

                    row.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
                });
            }
        });
    </script>
</body>
</html>