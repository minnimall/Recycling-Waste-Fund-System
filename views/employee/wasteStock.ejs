<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="/style_admin/dashboard.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
                
    <!-- Main content -->
    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <h1 class="text-2xl font-semibold text-gray-800">สต๊อกขยะ</h1>
            <p class="text-gray-600">ข้อมูลรายการขยะทั้งหมดที่ถูกรับซื้อจากสมาชิกกองทุนขยะ</p>
        </div>

        <!-- Enhanced Filter Section -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <!-- <h3 class="text-lg font-medium text-gray-800 mb-4">ตัวกรองข้อมูล</h3> -->
            <form method="GET" action="/employee/wasteStock" class="grid grid-cols-1 md:grid-cols-5 gap-4">
                
                <!-- Search by Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">ค้นหาชื่อขยะ</label>
                    <input type="text" name="name" value="<%= searchName || '' %>" 
                        placeholder="ค้นหาขยะ..." 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Village Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                    <select name="villageId" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">ทุกหมู่บ้าน</option>
                        <% if (typeof villages !== 'undefined' && villages) { %>
                        <% villages.forEach(v => { %>
                        <option value="<%= v._id %>" <%= selectedVillageId == v._id ? 'selected' : '' %>>
                            <%= v.villageName %>
                        </option>
                        <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Month Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">เดือน/ปี</label>
                    <select name="month" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">ทุกเดือน</option>
                        <% if (typeof monthlyOptions !== 'undefined' && monthlyOptions) { %>
                        <% monthlyOptions.forEach(option => { 
                            const monthValue = `${option._id.year}-${String(option._id.month).padStart(2, '0')}`;
                            const monthName = new Date(option._id.year, option._id.month - 1).toLocaleDateString('th-TH', { year: 'numeric', month: 'long' });
                        %>
                        <option value="<%= monthValue %>" <%= selectedMonth == monthValue ? 'selected' : '' %>>
                            <%= monthName %> (<%= option.count %> รายการ)
                        </option>
                        <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Year Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">ปี</label>
                    <select name="year" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">ทุกปี</option>
                        <% if (typeof monthlyOptions !== 'undefined' && monthlyOptions) { %>
                        <% 
                        const years = [...new Set(monthlyOptions.map(opt => opt._id.year))].sort((a, b) => b - a);
                        years.forEach(year => { 
                        %>
                        <option value="<%= year %>" <%= selectedYear == year ? 'selected' : '' %>>
                            พ.ศ. <%= year + 543 %>
                        </option>
                        <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="flex items-end">
                    <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-md transition duration-300">
                        <i class="fas fa-search mr-2"></i>ค้นหา
                    </button>
                </div>
            </form>

            <!-- Active Filters Display -->
            <div class="mt-4 flex flex-wrap gap-2">
                <% if (selectedVillageId && typeof villages !== 'undefined' && villages) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800">
                    <i class="fas fa-map-marker-alt mr-1"></i>
                    <%= villages.find(v => v._id == selectedVillageId)?.villageName || 'หมู่บ้าน' %>
                    <a href="javascript:void(0)" onclick="removeFilter('villageId')" class="ml-2 text-blue-600 hover:text-blue-800">×</a>
                </span>
                <% } %>
                
                <% if (selectedMonth) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">
                    <i class="fas fa-calendar mr-1"></i>
                    <%= new Date(selectedMonth + '-01').toLocaleDateString('th-TH', { year: 'numeric', month: 'long' }) %>
                    <a href="javascript:void(0)" onclick="removeFilter('month')" class="ml-2 text-green-600 hover:text-green-800">×</a>
                </span>
                <% } %>

                <% if (selectedYear && !selectedMonth) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-purple-100 text-purple-800">
                    <i class="fas fa-calendar-alt mr-1"></i>
                    พ.ศ. <%= parseInt(selectedYear) + 543 %>
                    <a href="javascript:void(0)" onclick="removeFilter('year')" class="ml-2 text-purple-600 hover:text-purple-800">×</a>
                </span>
                <% } %>

                <% if (searchName) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-yellow-100 text-yellow-800">
                    <i class="fas fa-search mr-1"></i>
                    "<%= searchName %>"
                    <a href="javascript:void(0)" onclick="removeFilter('name')" class="ml-2 text-yellow-600 hover:text-yellow-800">×</a>
                </span>
                <% } %>
            </div>
        </div>

        <!-- Summary Cards with Enhanced Information -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <!-- Total Weight -->
            <div class="mx-4 bg-blue-50 rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-600">น้ำหนักรวม</p>
                        <p class="text-2xl font-bold text-blue-900">
                            <% if (typeof stockData !== 'undefined' && stockData && stockData.length > 0) { %>
                            <%= stockData.reduce((sum, item) => sum + (item.totalQuantityKg || 0), 0).toFixed(2) %>
                            <% } else { %>
                            0.00
                            <% } %> กก.
                        </p>
                        <p class="text-xs text-blue-700"><%= (stockData && stockData.length) || 0 %> ประเภท</p>
                    </div>
                    <div class="h-12 w-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-weight text-blue-600"></i>
                    </div>
                </div>
            </div>

            <!-- Historical Value -->
            <div class="mx-4 bg-green-50 rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-green-600">มูลค่าที่จ่ายจริง</p>
                        <p class="text-2xl font-bold text-green-900">
                            <% if (typeof stockData !== 'undefined' && stockData && stockData.length > 0) { %>
                            <%= stockData.reduce((sum, item) => sum + (item.historicalTotalAmount || 0), 0).toLocaleString() %>
                            <% } else { %>
                            0
                            <% } %> บาท
                        </p>
                        <p class="text-xs text-green-700">จากการรับซื้อจริง</p>
                    </div>
                    <div class="h-12 w-12 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-money-bill-wave text-green-600"></i>
                    </div>
                </div>
            </div>

            <!-- Current Value -->
            <div class="mx-4 bg-yellow-50 rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-yellow-600">มูลค่าราคาปัจจุบัน</p>
                        <p class="text-2xl font-bold text-yellow-900">
                            <% if (typeof stockData !== 'undefined' && stockData && stockData.length > 0) { %>
                            <%= stockData.reduce((sum, item) => sum + (item.currentValueIfSoldToday || 0), 0).toLocaleString() %>
                            <% } else { %>
                            0
                            <% } %> บาท
                        </p>
                        <p class="text-xs text-yellow-700">หากขายวันนี้</p>
                    </div>
                    <div class="h-12 w-12 bg-yellow-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-chart-line text-yellow-600"></i>
                    </div>
                </div>
            </div>

            <!-- Price Difference -->
            <!-- <div class="mx-4 bg-purple-50 rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-purple-600">ส่วนต่างมูลค่า</p>
                        <% 
                        let difference = 0;
                        let percentage = 0;
                        if (typeof stockData !== 'undefined' && stockData && stockData.length > 0) {
                            const currentValue = stockData.reduce((sum, item) => sum + (item.currentValueIfSoldToday || 0), 0);
                            const historicalValue = stockData.reduce((sum, item) => sum + (item.historicalTotalAmount || 0), 0);
                            difference = currentValue - historicalValue;
                            percentage = historicalValue > 0 ? Math.abs((difference / historicalValue) * 100) : 0;
                        }
                        %>
                        <p class="text-2xl font-bold <%= difference >= 0 ? 'text-green-900' : 'text-red-900' %>">
                            <%= difference >= 0 ? '+' : '' %><%= difference.toLocaleString() %> บาท
                        </p>
                        <p class="text-xs <%= difference >= 0 ? 'text-green-700' : 'text-red-700' %>">
                            <%= difference >= 0 ? 'กำไร' : 'ขาดทุน' %> <%= percentage.toFixed(1) %>%
                        </p>
                    </div>
                    <div class="h-12 w-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-<%= difference >= 0 ? 'arrow-trend-up' : 'arrow-trend-down' %> text-purple-600"></i>
                    </div>
                </div>
            </div> -->
        </div>

        <!-- Detailed Waste Table -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 flex justify-between items-center border-b border-gray-200 pb-4">
                <h2 class="text-lg font-semibold text-gray-800">
                    รายละเอียดสต๊อกขยะ
                    <!-- <% if (selectedMonth || selectedYear || selectedVillageId || searchName) { %>
                    <span class="text-sm font-normal text-gray-500">(กรองแล้ว)</span>
                    <% } %> -->
                </h2>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                ลำดับที่
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                ชนิดขยะ
                            </th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                น้ำหนักรวม (กก.)
                            </th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                ราคาเฉลี่ย / ปัจจุบัน
                            </th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                มูลค่าที่จ่ายจริง
                            </th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                มูลค่าราคาปัจจุบัน
                            </th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                รายละเอียด
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (!stockData || stockData.length === 0) { %>
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                                <i class="fas fa-inbox text-4xl mb-2 block"></i>
                                ไม่พบข้อมูลสต๊อกขยะตามเงื่อนไขที่เลือก
                            </td>
                        </tr>
                        <% } else { %>
                        <% stockData.forEach((item, index) => { %>
                        <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <%= index + 1 %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900"><%= item._id || 'ไม่ระบุ' %></div>
                                <div class="text-xs text-gray-500">
                                    รับซื้อ <%= item.purchaseCount || 0 %> ครั้ง
                                    <% if (item.monthlyBreakdown && item.monthlyBreakdown.length > 1) { %>
                                    ใน <%= item.monthlyBreakdown.length %> เดือน
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="text-sm text-gray-900 font-semibold">
                                    <%= (item.totalQuantityKg || 0).toFixed(2) %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="text-sm text-gray-900">
                                    <%= (item.avgHistoricalPrice || 0).toFixed(2) %>
                                </div>
                                <div class="text-xs font-medium <%= (item.priceDifference || 0) >= 0 ? 'text-green-600' : 'text-red-600' %>">
                                    <%= (item.currentPrice || 0).toFixed(2) %> 
                                    <!-- <%= (item.priceDifference || 0) >= 0 ? '↗' : '↘' %>
                                    <%= Math.abs(item.priceDifference || 0).toFixed(2) %> -->
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="text-sm font-medium text-gray-900">
                                    <%= (item.historicalTotalAmount || 0).toLocaleString() %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="text-sm font-medium <%= (item.priceDifference || 0) >= 0 ? 'text-green-600' : 'text-red-600' %>">
                                    <%= (item.currentValueIfSoldToday || 0).toLocaleString() %>
                                </div>
                                <div class="text-xs text-gray-500">
                                    <%= (item.priceDifference || 0) >= 0 ? '+' : '' %><%= ((item.currentValueIfSoldToday || 0) - (item.historicalTotalAmount || 0)).toLocaleString() %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <button onclick="toggleMonthlyDetail('<%= index %>')" 
                                        class="text-blue-600 hover:text-blue-800 text-sm">
                                    <i class="fas fa-eye"></i> ดูรายเดือน
                                </button>
                            </td>
                        </tr>
                        
                        <!-- Monthly Breakdown Row (Hidden by default) -->
                        <tr id="monthly-detail-<%= index %>" class="hidden bg-blue-50">
                            <td colspan="7" class="px-6 py-4">
                                <div class="bg-white rounded-lg p-4 border border-blue-200">
                                    <h4 class="font-medium text-gray-800 mb-3">รายละเอียดรายเดือน: <%= item._id || 'ไม่ระบุ' %></h4>
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <% if (item.monthlyBreakdown && item.monthlyBreakdown.length > 0) { %>
                                        <% item.monthlyBreakdown.sort((a, b) => new Date(b.month) - new Date(a.month)).forEach(monthly => { %>
                                        <div class="bg-gray-50 rounded p-3">
                                            <div class="font-medium text-blue-800">
                                                <%= new Date(monthly.month + '-01').toLocaleDateString('th-TH', { year: 'numeric', month: 'long' }) %>
                                            </div>
                                            <div class="text-sm text-gray-600 mt-1">
                                                <div>น้ำหนัก: <%= (monthly.quantity || 0).toFixed(2) %> กก.</div>
                                                <div>ราคาเฉลี่ย: <%= (monthly.avgPrice || 0).toFixed(2) %> บาท/กก.</div>
                                                <div>มูลค่า: <%= (monthly.amount || 0).toLocaleString() %> บาท</div>
                                                <div>จำนวนครั้ง: <%= monthly.purchases || 0 %> ครั้ง</div>
                                            </div>
                                        </div>
                                        <% }); %>
                                        <% } else { %>
                                        <div class="text-gray-500 text-sm">ไม่มีข้อมูลรายเดือน</div>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination or Load More (Optional) -->
            <% if (stockData && stockData.length > 0) { %>
            <div class="mt-4 flex justify-between items-center text-sm text-gray-600">
                <div>แสดง <%= stockData.length %> รายการ</div>
                <div class="flex space-x-4">
                    <button onclick="exportToCSV()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md">
                        <i class="fas fa-download mr-2"></i>ส่งออก CSV
                    </button>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Chart Section (Optional) -->
        <% if (stockData && stockData.length > 0) { %>
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">กราฟแสดงมูลค่าขยะ</h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Quantity Chart -->
                <div>
                    <canvas id="quantityChart" width="400" height="300"></canvas>
                </div>
                <!-- Value Comparison Chart -->
                <div>
                    <canvas id="valueChart" width="400" height="300"></canvas>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Legend and Info -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">คำอธิบาย</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                    <h4 class="font-medium text-gray-700 mb-2">การคำนวณมูลค่า</h4>
                    <ul class="space-y-1 text-gray-600">
                        <li><span class="w-3 h-3 bg-green-100 rounded inline-block mr-2"></span>มูลค่าที่จ่ายจริง: รวมยอดจากการรับซื้อจริงในแต่ละเดือน</li>
                        <li><span class="w-3 h-3 bg-yellow-100 rounded inline-block mr-2"></span>มูลค่าราคาปัจจุบัน: คำนวณจากน้ำหนัก × ราคาปัจจุบัน</li>
                        <li><span class="w-3 h-3 bg-purple-100 rounded inline-block mr-2"></span>ส่วนต่าง: แสดงกำไร/ขาดทุนจากการเปลี่ยนแปลงราคา</li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-medium text-gray-700 mb-2">สัญลักษณ์</h4>
                    <ul class="space-y-1 text-gray-600">
                        <li><span class="text-green-600">↗</span> ราคาขยะเพิ่มขึ้นจากเดิม</li>
                        <li><span class="text-red-600">↘</span> ราคาขยะลดลงจากเดิม</li>
                        <li><i class="fas fa-eye text-blue-600"></i> คลิกเพื่อดูรายละเอียดรายเดือน</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/employeePartials/empFooter.ejs') %>

    <script>
        // Get current URL parameters
        function getCurrentParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const params = {};
            for (const [key, value] of urlParams) {
                params[key] = value;
            }
            return params;
        }

        // Remove filter function
        function removeFilter(filterName) {
            const params = getCurrentParams();
            delete params[filterName];
            
            const newUrl = window.location.pathname + '?' + new URLSearchParams(params).toString();
            window.location.href = newUrl;
        }

        // Toggle monthly detail function
        function toggleMonthlyDetail(index) {
            const detailRow = document.getElementById(`monthly-detail-${index}`);
            const button = event.target.closest('button');
            const icon = button.querySelector('i');
            
            if (detailRow.classList.contains('hidden')) {
                detailRow.classList.remove('hidden');
                icon.className = 'fas fa-eye-slash';
            } else {
                detailRow.classList.add('hidden');
                icon.className = 'fas fa-eye';
            }
        }

        // Export to CSV function
        function exportToCSV() {
            <% if (stockData && stockData.length > 0) { %>
            const stockData = <%- JSON.stringify(stockData) %>;
            
            // สร้าง BOM (Byte Order Mark) สำหรับ UTF-8
            const BOM = '\uFEFF';
            
            let csvContent = BOM + "ชนิดขยะ,น้ำหนักรวม(กก.),ราคาเฉลี่ย(บาท/กก.),ราคาปัจจุบัน(บาท/กก.),มูลค่าที่จ่ายจริง(บาท),มูลค่าราคาปัจจุบัน(บาท),ส่วนต่าง(บาท),จำนวนครั้ง\n";
            
            stockData.forEach(item => {
                const difference = (item.currentValueIfSoldToday || 0) - (item.historicalTotalAmount || 0);
                csvContent += `"${item._id || 'ไม่ระบุ'}",${(item.totalQuantityKg || 0).toFixed(2)},${(item.avgHistoricalPrice || 0).toFixed(2)},${(item.currentPrice || 0).toFixed(2)},${(item.historicalTotalAmount || 0)},${(item.currentValueIfSoldToday || 0)},${difference},${item.purchaseCount || 0}\n`;
            });

            // สร้าง Blob ด้วย UTF-8 encoding และ BOM
            const blob = new Blob([csvContent], { 
                type: 'text/csv;charset=utf-8;' 
            });
            
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            
            // สร้างชื่อไฟล์ด้วยวันที่ปัจจุบัน
            const now = new Date();
            const dateStr = now.toISOString().split('T')[0];
            const fileName = `สต๊อกขยะ_${dateStr}.csv`;
            
            link.setAttribute('download', fileName);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            <% } else { %>
            alert('ไม่มีข้อมูลสำหรับส่งออก');
            <% } %>
        }

        // Initialize Charts
        <% if (stockData && stockData.length > 0) { %>
        document.addEventListener('DOMContentLoaded', function() {
            const stockData = <%- JSON.stringify(stockData) %>;
            
            // Quantity Chart
            const quantityCtx = document.getElementById('quantityChart');
            if (quantityCtx) {
                new Chart(quantityCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: stockData.map(item => item._id || 'ไม่ระบุ'),
                        datasets: [{
                            data: stockData.map(item => item.totalQuantityKg || 0),
                            backgroundColor: [
                                '#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6',
                                '#06B6D4', '#84CC16', '#F97316', '#EC4899', '#6B7280'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'สัดส่วนน้ำหนักขยะแต่ละประเภท'
                            },
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }

            // Value Comparison Chart
            const valueCtx = document.getElementById('valueChart');
            if (valueCtx) {
                new Chart(valueCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: stockData.map(item => item._id || 'ไม่ระบุ'),
                        datasets: [
                            {
                                label: 'มูลค่าที่จ่ายจริง',
                                data: stockData.map(item => item.historicalTotalAmount || 0),
                                backgroundColor: '#10B981'
                            },
                            {
                                label: 'มูลค่าราคาปัจจุบัน',
                                data: stockData.map(item => item.currentValueIfSoldToday || 0),
                                backgroundColor: '#F59E0B'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'เปรียบเทียบมูลค่าขยะ'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return value.toLocaleString() + ' บาท';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
        <% } %>
    </script>
</body>
</html>