    <%- include('../partials/employeePartials/empFooter.ejs') %>
    
    <script>
        // Modal functions
        function openModal(id) {
            document.getElementById(`modal-${id}`).classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        
        function closeModal(id) {
            document.getElementById(`modal-${id}`).classList.add('hidden');
            document.body.style.overflow = 'auto';
        }
        
        // Close modal when clicking outside
        document.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('[id^="modal-"]');
            modals.forEach(modal => {
                if (event.target === modal) {
                    const id = modal.id.replace('modal-', '');
                    closeModal(id);
                }
            });
        });

        // Dropdown menu functions
        function toggleStatusMenu(id) {
            const menu = document.getElementById('statusMenu-' + id);
            // ปิด dropdown อื่นๆ ที่เปิดอยู่
            document.querySelectorAll('[id^="statusMenu-"]').forEach(m => {
                if (m.id !== 'statusMenu-' + id) {
                    m.classList.add('hidden');
                }
            });
            // Toggle dropdown ที่คลิก
            menu.classList.toggle('hidden');
        }

        // Update status function
        async function updateStatus(id, status) {
            try {
                // ปิด dropdown หลังจากเลือก
                const menu = document.getElementById('statusMenu-' + id);
                if (menu) {
                    menu.classList.add('hidden');
                }

                const response = await fetch(`/employee/complaint/${id}/status`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status })
                });

                const result = await response.json();

                if (result.success) {
                    // Update status badge in the list
                    const statusBadge = document.querySelector(`[data-id="${id}"] .status-badge`);
                    const modalStatus = document.getElementById(`modal-status-${id}`);
                    const modalSelect = document.getElementById(`modal-status-select-${id}`);
                    
                    // Update dropdown button
                    const statusBtn = document.getElementById(`statusBtn-${id}`);
                    
                    // Update badge classes and text
                    statusBadge.className = 'status-badge ml-3 px-2 py-1 text-xs font-medium rounded-full ';
                    modalStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ';
                    
                    let statusText = '';
                    let btnContent = '';
                    if (status === 'pending') {
                        statusBadge.className += 'bg-yellow-100 text-yellow-800';
                        modalStatus.className += 'bg-yellow-100 text-yellow-800';
                        statusText = 'รอดำเนินการ';
                        btnContent = '<i class="fas fa-clock text-yellow-300 mr-2"></i>รอดำเนินการ<i class="fas fa-chevron-down ml-2"></i>';
                    } else if (status === 'in-progress') {
                        statusBadge.className += 'bg-blue-100 text-blue-800';
                        modalStatus.className += 'bg-blue-100 text-blue-800';
                        statusText = 'กำลังดำเนินการ';
                        btnContent = '<i class="fas fa-spinner text-blue-300 mr-2"></i>กำลังดำเนินการ<i class="fas fa-chevron-down ml-2"></i>';
                    } else if (status === 'resolved') {
                        statusBadge.className += 'bg-green-100 text-green-800';
                        modalStatus.className += 'bg-green-100 text-green-800';
                        statusText = 'เสร็จสิ้น';
                        btnContent = '<i class="fas fa-check text-green-300 mr-2"></i>เสร็จสิ้น<i class="fas fa-chevron-down ml-2"></i>';
                    }
                    
                    statusBadge.textContent = statusText;
                    modalStatus.textContent = statusText;
                    
                    // Update dropdown button content
                    if (statusBtn) {
                        statusBtn.innerHTML = btnContent;
                    }
                    
                    // Update modal select
                    if (modalSelect) {
                        modalSelect.value = status;
                    }

                    // Update data attribute for filtering
                    const complaintItem = document.querySelector(`[data-id="${id}"]`);
                    complaintItem.setAttribute('data-status', status);

                    // Update dropdown menu highlights
                    const menuButtons = document.querySelectorAll(`#statusMenu-${id} button`);
                    menuButtons.forEach(btn => {
                        btn.classList.remove('bg-blue-50', 'text-blue-700');
                        btn.classList.add('text-gray-700');
                        // Remove check mark
                        const checkIcon = btn.querySelector('.fa-check.float-right');
                        if (checkIcon) {
                            checkIcon.remove();
                        }
                    });
                    
                    // Highlight selected status
                    const selectedBtn = document.querySelector(`#statusMenu-${id} button[onclick*="'${status}'"]`);
                    if (selectedBtn) {
                        selectedBtn.classList.remove('text-gray-700');
                        selectedBtn.classList.add('bg-blue-50', 'text-blue-700');
                        // Add check mark
                        selectedBtn.innerHTML += '<i class="fas fa-check text-blue-500 ml-auto float-right mt-0.5"></i>';
                    }

                    // แสดงข้อความสำเร็จ
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: result.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    throw new Error(result.error || 'เกิดข้อผิดพลาด');
                }
            } catch (error) {
                console.error('Error updating status:', error);
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาดในการอัปเดตสถานะ',
                    showConfirmButton: false,
                    timer: 3000
                });
                
                // Revert select to original value
                location.reload();
            }
        }

        // Update status from modal
        function updateStatusFromModal(id, status) {
            updateStatus(id, status);
        }

        // Filter functionality
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const complaintItems = document.querySelectorAll('.complaint-item');
            const totalCountElement = document.getElementById('total-count');
            const searchInput = document.getElementById('search-input');
            const sortSelect = document.getElementById('sort-select');

            // ปิด dropdown เมื่อคลิกนอกบริเวณ
            document.addEventListener('click', function(event) {
                if (!event.target.closest('[id^="statusBtn-"]') && !event.target.closest('[id^="statusMenu-"]')) {
                    document.querySelectorAll('[id^="statusMenu-"]').forEach(menu => {
                        menu.classList.add('hidden');
                    });
                }
            });

            // Filter by status
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Update active button
                    filterButtons.forEach(btn => {
                        btn.classList.remove('bg-green-700', 'text-white');
                        btn.classList.add('bg-white', 'border-gray-300', 'text-gray-700');
                    });
                    this.classList.remove('bg-white', 'border-gray-300', 'text-gray-700');
                    this.classList.add('bg-green-700', 'text-white');

                    const filterId = this.id;
                    let visibleCount = 0;

                    complaintItems.forEach(item => {
                        const status = item.getAttribute('data-status');
                        let shouldShow = false;

                        if (filterId === 'filter-all') {
                            shouldShow = true;
                        } else if (filterId === 'filter-pending' && status === 'pending') {
                            shouldShow = true;
                        } else if (filterId === 'filter-in-progress' && status === 'in-progress') {
                            shouldShow = true;
                        } else if (filterId === 'filter-resolved' && status === 'resolved') {
                            shouldShow = true;
                        }

                        if (shouldShow) {
                            item.style.display = 'block';
                            visibleCount++;
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    totalCountElement.textContent = `${visibleCount} รายการ`;
                });
            });

            // Search functionality
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                let visibleCount = 0;

                complaintItems.forEach(item => {
                    const familyName = item.getAttribute('data-family').toLowerCase();
                    const complaintId = item.getAttribute('data-id');
                    
                    if (familyName.includes(searchTerm) || complaintId.includes(searchTerm)) {
                        // Only show if it also matches current filter
                        const currentFilter = document.querySelector('.filter-btn.bg-green-700');
                        const status = item.getAttribute('data-status');
                        let shouldShow = false;

                        if (currentFilter.id === 'filter-all') {
                            shouldShow = true;
                        } else if (currentFilter.id === 'filter-pending' && status === 'pending') {
                            shouldShow = true;
                        } else if (currentFilter.id === 'filter-in-progress' && status === 'in-progress') {
                            shouldShow = true;
                        } else if (currentFilter.id === 'filter-resolved' && status === 'resolved') {
                            shouldShow = true;
                        }

                        if (shouldShow) {
                            item.style.display = 'block';
                            visibleCount++;
                        } else {
                            item.style.display = 'none';
                        }
                    } else {
                        item.style.display = 'none';
                    }
                });

                totalCountElement.textContent = `${visibleCount} รายการ`;
            });

            // Sort functionality
            sortSelect.addEventListener('change', function() {
                const sortBy = this.value;
                const container = document.getElementById('complaints-container');
                const items = Array.from(complaintItems);

                items.sort((a, b) => {
                    if (sortBy === 'newest') {
                        // Sort by creation date (newest first) - using data-id as proxy since it contains timestamp
                        return b.getAttribute('data-id').localeCompare(a.getAttribute('data-id'));
                    } else if (sortBy === 'oldest') {
                        // Sort by creation date (oldest first)
                        return a.getAttribute('data-id').localeCompare(b.getAttribute('data-id'));
                    } else if (sortBy === 'status') {
                        // Sort by status: pending, in-progress, resolved
                        const statusOrder = { 'pending': 0, 'in-progress': 1, 'resolved': 2 };
                        const statusA = statusOrder[a.getAttribute('data-status')] || 999;
                        const statusB = statusOrder[b.getAttribute('data-status')] || 999;
                        return statusA - statusB;
                    }
                    return 0;
                });

                // Remove existing items and re-add in sorted order
                items.forEach(item => item.remove());
                items.forEach(item => container.appendChild(item));
            });
        });
    </script>
</body>
</html>