<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="/style_employee/wastePurchase.css">
        <link rel="stylesheet" href="/style_employee/res_req.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <style>
        @media print {
            /* ซ่อนส่วนที่ไม่ต้องการพิมพ์ */
            .no-print {
                display: none !important;
            }
            
            /* แสดงเฉพาะตารางสรุป */
            body * {
                visibility: hidden;
            }
            
            #printable-summary-section,
            #printable-summary-section * {
                visibility: visible;
            }
            
            #printable-summary-section {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            
            /* Header สำหรับการพิมพ์ */
            #print-header {
                display: block !important;
                text-align: center;
                margin-bottom: 20px;
                padding-bottom: 15px;
                border-bottom: 2px solid #333;
            }
            
            #print-header h1 {
                font-size: 20px;
                font-weight: bold;
                margin-bottom: 10px;
                color: #000;
            }
            
            #print-header p {
                font-size: 10px;
                color: #333;
                margin: 5px 0;
            }
            
            /* ปรับตาราง */
            table {
                width: 100%;
                border-collapse: collapse;
            }
            
            table th,
            table td {
                border: 1px solid #333;
                padding: 8px;
                text-align: left;
                font-size: 12px;
                color: #000;
            }
            
            table th {
                background-color: #f3f4f6 !important;
                font-weight: bold;
            }
            
            /* แถวรวม */
            .total-row {
                background-color: #fef3c7 !important;
                font-weight: bold;
            }
            
            /* ข้อมูล Filter */
            .filter-info {
                margin-top: 15px;
                padding-top: 10px;
                border-top: 1px solid #666;
                font-size: 12px;
            }
            
            /* Footer */
            #print-footer {
                display: block !important;
                margin-top: 20px;
                text-align: center;
                font-size: 11px;
                color: #666;
            }
            
            /* ปรับขนาดหน้ากระดาษ */
            @page {
                size: A4;
                margin: 15mm;
            }
        }
        
        /* ซ่อน header สำหรับพิมพ์ในหน้าจอปกติ */
        #print-header,
        #print-footer {
            display: none;
        }

        /* Smooth transition สำหรับ collapse */
#summary-table-content {
    transition: max-height 0.3s ease-in-out;
}

#toggle-icon {
    transition: transform 0.3s ease-in-out;
}
#summary-table-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
}

#summary-table-content:not(.hidden) {
    max-height: none;
    overflow: visible;
}
/* Hover effect สำหรับ header */
.cursor-pointer:hover {
    background-color: #f9fafb;
}
    </style>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
        <%- include('../partials/employeePartials/empSidebar.ejs') %>

            <script>
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <!-- Modal -->
            <div id="itemModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center hidden p-4">
                <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl max-h-[90vh] overflow-hidden flex flex-col">
                    
                    <!-- Header with Gradient -->
                    <div class="bg-white px-6 py-4 flex items-center justify-between flex-shrink-0">
                        <div class="flex items-center gap-3">
                            <div class="bg-green-100 p-2.5 rounded-xl">
                                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-black">รายละเอียดการรับซื้อ</h3>
                                <p class="text-gray-600 text-sm">ข้อมูลรายการขยะและบัญชีลูกค้า</p>
                            </div>
                        </div>
                        <button class="closeModal p-2 hover:bg-white/20 rounded-lg transition-colors">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    
                    <!-- Scrollable Content -->
                    <div class="flex-1 overflow-y-auto p-6 space-y-6">
                        
                        <!-- Account Info Cards -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="modalHeaderInfo">
                            <!-- Populated by JavaScript -->
                        </div>
                        
                        <!-- Items Table Section -->
                        <div class="bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
                            <div class="bg-gray-100 px-4 py-3 border-b border-gray-200">
                                <h4 class="font-semibold text-gray-700 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                    รายการขยะที่รับซื้อ
                                </h4>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="min-w-full">
                                    <thead class="bg-gray-50 border-b border-gray-200">
                                        <tr>
                                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-16">ลำดับ</th>
                                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-left">ชื่อสินค้า</th>
                                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">จำนวน</th>
                                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">ราคา/หน่วย</th>
                                            <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">รวม</th>
                                        </tr>
                                    </thead>
                                    <tbody id="modalItemTable" class="divide-y divide-gray-100">
                                        <!-- Populated by JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Footer with Total -->
                    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex-shrink-0">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="bg-green-100 p-2 rounded-lg">
                                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-500">ยอดรวมทั้งหมด</p>
                                    <p id="totalAmount" class="text-2xl font-bold text-green-600">฿0.00</p>
                                </div>
                            </div>
                            <button type="button" class="closeModal px-6 py-2.5 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-xl transition-colors flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                ปิด
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main -->
            <div class="content bg-gray-50 min-screen">
                <div class="mt-4 mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">สรุปการรับซื้อขยะ
                        </h1>
                        <p class="text-gray-600">ข้อมูลสรุปในการออกรับซื้อขยะ</p>
                    </div>
                </div>

                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="mb-6 ">
                        <!-- Filter Form -->
                        <form action="" method="GET">
                            <div class="flex flex-wrap items-end gap-3">
                                <!-- Filter วันที่ -->
                                <div class="flex-1 min-w-[150px]">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">วันที่</label>
                                    <input type="date" name="searchDate" value="<%= searchDate %>" 
                                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                </div>

                                <!-- Filter เดือน -->
                                <div class="flex-1 min-w-[150px]">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">เดือน</label>
                                    <select name="searchMonth" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                        <option value="">ทั้งหมด</option>
                                        <option value="01" <%= searchMonth === '01' ? 'selected' : '' %>>มกราคม</option>
                                        <option value="02" <%= searchMonth === '02' ? 'selected' : '' %>>กุมภาพันธ์</option>
                                        <option value="03" <%= searchMonth === '03' ? 'selected' : '' %>>มีนาคม</option>
                                        <option value="04" <%= searchMonth === '04' ? 'selected' : '' %>>เมษายน</option>
                                        <option value="05" <%= searchMonth === '05' ? 'selected' : '' %>>พฤษภาคม</option>
                                        <option value="06" <%= searchMonth === '06' ? 'selected' : '' %>>มิถุนายน</option>
                                        <option value="07" <%= searchMonth === '07' ? 'selected' : '' %>>กรกฎาคม</option>
                                        <option value="08" <%= searchMonth === '08' ? 'selected' : '' %>>สิงหาคม</option>
                                        <option value="09" <%= searchMonth === '09' ? 'selected' : '' %>>กันยายน</option>
                                        <option value="10" <%= searchMonth === '10' ? 'selected' : '' %>>ตุลาคม</option>
                                        <option value="11" <%= searchMonth === '11' ? 'selected' : '' %>>พฤศจิกายน</option>
                                        <option value="12" <%= searchMonth === '12' ? 'selected' : '' %>>ธันวาคม</option>
                                    </select>
                                </div>

                                <!-- Filter ปี -->
                                <div class="flex-1 min-w-[120px]">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ปี</label>
                                    <select name="searchYear" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                        <option value="">ทั้งหมด</option>
                                        <% 
                                            const currentYear = new Date().getFullYear();
                                            for (let i = 0; i <= 9; i++) {
                                                const year = currentYear - i;
                                                const buddhistYear = year + 543;
                                        %>
                                            <option value="<%= year %>" <%= searchYear == year.toString() ? 'selected' : '' %>>
                                                <%= buddhistYear %>
                                            </option>
                                        <% } %>
                                    </select>
                                </div>

                                <!-- Filter หมู่บ้าน -->
                                <div class="flex-1 min-w-[180px]">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                                    <select name="villageId" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                        <option value="">ทั้งหมด</option>
                                        <% villages.forEach(village => { %>
                                            <option value="<%= village._id %>" <%= villageId == village._id ? 'selected' : '' %>>
                                                หมู่ <%= village.villageNumber %> - <%= village.villageName %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <!-- ค้นหาเลขบัญชี -->
                                <div class="flex-1 min-w-[150px]">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">เลขบัญชี</label>
                                    <input type="text" name="accountId" value="<%= accountId %>" placeholder="เลขที่บัญชี" 
                                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                </div>

                                <!-- ปุ่มค้นหา -->
                                <div class="flex gap-2">
                                    <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 whitespace-nowrap">
                                        <i class="fas fa-search mr-2"></i>ค้นหา
                                    </button>
                                </div>
                            </div>

                            <!-- Current Filter Display -->
                            <% if (searchDate || searchMonth || searchYear || villageId || accountId) { %>
                                <div class="mt-3 flex flex-wrap items-center gap-2">
                                    <span class="text-sm text-gray-600">ตัวกรองปัจจุบัน:</span>
                                    
                                    <!-- แสดงวันที่ที่เลือก -->
                                    <% if (searchDate) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                            <i class="fas fa-calendar-day mr-1"></i>วันที่ 
                                            <% 
                                                const dateObj = new Date(searchDate);
                                                const thaiDate = dateObj.toLocaleDateString('th-TH', { 
                                                    year: 'numeric', 
                                                    month: 'long', 
                                                    day: 'numeric' 
                                                });
                                            %>
                                            <%= thaiDate %>
                                        </span>
                                    <% } %>

                                    <!-- แสดงเดือนที่เลือก -->
                                    <% if (searchMonth) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            <i class="fas fa-calendar mr-1"></i>
                                            <% 
                                                const monthNames = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                                                                    'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
                                                const monthName = monthNames[parseInt(searchMonth) - 1];
                                            %>
                                            <%= monthName %>
                                        </span>
                                    <% } %>

                                    <!-- แสดงปีที่เลือก -->
                                    <% if (searchYear) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                                            <i class="fas fa-calendar-alt mr-1"></i>ปี <%= parseInt(searchYear) + 543 %>
                                        </span>
                                    <% } %>
                                    
                                    <!-- แสดงหมู่บ้านที่เลือก -->
                                    <% if (villageId) { %>
                                        <% 
                                            const selectedVillage = villages.find(v => v._id.toString() === villageId.toString());
                                        %>
                                        <% if (selectedVillage) { %>
                                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                <i class="fas fa-map-marker-alt mr-1"></i>หมู่ <%= selectedVillage.villageNumber %> - <%= selectedVillage.villageName %>
                                            </span>
                                        <% } %>
                                    <% } %>

                                    <!-- แสดงเลขบัญชีที่ค้นหา -->
                                    <% if (accountId) { %>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            <i class="fas fa-id-card mr-1"></i>บัญชี: <%= accountId %>
                                        </span>
                                    <% } %>

                                    <!-- ปุ่มล้างตัวกรอง -->
                                    <a href="/employee/wastePurchaseTotal" class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
                                        <i class="fas fa-times mr-1"></i>ล้างตัวกรอง
                                    </a>
                                </div>
                            <% } %>
                        </form>
                    </div>
                </div>

                <!-- Stats cards -->
                <div class="mx-4 mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600">จำนวนการรับซื้อ</p>
                                <p class="text-2xl font-bold text-blue-900 mt-1">
                                    <%= purchaseCount %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600">จำนวนลูกค้า</p>
                                <p class="text-2xl font-bold text-green-900 mt-1">
                                    <%= customerCount %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600">ยอดการรับซื้อ</p>
                                <p class="text-2xl font-bold text-purple-900 mt-1">
                                    <%= totalAmount.toLocaleString('th-TH') %> บาท
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search form and table -->
                <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                    <div class="overflow-x-auto">
                        <h2 class="text-base font-semibold text-gray-800 mb-4 border-b border-gray-200 pb-4">
                            ข้อมูลการรับซื้อ <span class="text-blue-600 text-base font-normal">
                                <%= purchaseCount %> รายการ
                            </span>
                        </h2>
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-100">
                                <tr>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        ลำดับที่</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        หมู่ที่</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-700 uppercase">
                                        เลขที่บัญชี</th>
                                    <!-- <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ชื่อบัญชี</th> -->
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-700 uppercase">
                                        ผู้ขาย</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        ยอดรวม (฿)</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        วัน-เวลาที่รับซื้อ</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        รายการขยะ</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-700 uppercase">
                                        พนักงาน</th>
                                    <th
                                        class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase">
                                        จัดการ</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (wastePurchases.length> 0) { %>
                                    <% wastePurchases.forEach((purchase, index)=> { %>
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                <%= startIndex + index + 1 %>
                                            </td>

                                            <!-- หมู่ที่ (ใหม่) -->
                                            <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                <% if (purchase.accountId && purchase.accountId.length> 0 &&
                                                    purchase.accountId[0].familyID &&
                                                    purchase.accountId[0].familyID.village) { %>
                                                    หมู่ <%= purchase.accountId[0].familyID.village.villageNumber %>
                                                        <% } else { %>
                                                            -
                                                            <% } %>
                                            </td>

                                            <td class="px-6 py-4 text-sm text-gray-900">
                                                <%= purchase.accountId && purchase.accountId.length> 0 ?
                                                    purchase.accountId[0].AccountNumber : '-' %>
                                            </td>
                                            <!-- <td class="px-6 py-4 text-sm text-gray-900">
                                                <%= purchase.accountId && purchase.accountId.length> 0 ?
                                                    purchase.accountId[0].AccountName : '-' %>
                                            </td> -->

                                            <!-- ชื่อผู้ขาย (ใหม่) -->
                                            <td class="px-6 py-4 text-sm text-gray-900">
                                                <% if (purchase.accountId && purchase.accountId.length> 0 &&
                                                    purchase.accountId[0].familyID &&
                                                    purchase.accountId[0].familyID.members &&
                                                    purchase.accountId[0].familyID.members.length > 0) { %>
                                                    <div class="flex flex-col">
                                                        <% purchase.accountId[0].familyID.members.forEach((member,
                                                            idx)=> { %>
                                                            <span class="<%= idx > 0 ? 'mt-1' : '' %>">
                                                                <%= member.name %>
                                                            </span>
                                                            <% }); %>
                                                    </div>
                                                    <% } else { %>
                                                        -
                                                        <% } %>
                                            </td>

                                            <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                <%= (purchase.totalAmount || 0).toLocaleString('th-TH') %> บาท
                                            </td>

                                        
                                                <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                    <%= purchase.purchaseDate.toLocaleDateString('th-TH') %>
                                                    <%= purchase.purchaseDate.toLocaleTimeString('th-TH', { hour:'numeric', minute:'numeric' }) %>
                                                </td>

                                                <td class="px-6 py-4 text-center text-sm">
                                                    <a href="#" data-items="<%= JSON.stringify({ 
                                            wasteItems: purchase.wasteItems, 
                                            accountId: purchase.accountId, 
                                            purchaseDate: purchase.purchaseDate,
                                            purchaseAddby: purchase.addByName 
                                        }) %>" class="item-link text-blue-600 hover:text-blue-800 hover:underline flex items-center justify-center">
                                                        <i class="fas fa-receipt mr-1"></i> รายการขยะ
                                                    </a>
                                                </td>

                                                <td class="px-6 py-4 text-sm text-gray-900">
                                                    <%= purchase.addByName ? purchase.addByName : 'Unknown' %>
                                                </td>

                                                <td class="px-6 py-4 text-center text-sm font-medium">
                                                    <div class="flex items-center justify-center gap-2">
                                                        <button
                                                            onclick="showModalDelete('<%= index + 1 %>','<%= purchase._id %>')"
                                                            class="delete-btn">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="10" class="px-6 py-10 text-center text-gray-500">-
                                                        ยังไม่มีข้อมูล -</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                        
                        <!-- Pagination -->
                        <% 
                            // สร้าง Query String สำหรับคงค่า Filter ต่างๆ
                            const filterParams = (searchDate ? '&searchDate=' + searchDate : '') + 
                                                (searchMonth ? '&searchMonth=' + searchMonth : '') + 
                                                (searchYear ? '&searchYear=' + searchYear : '') + 
                                                (villageId ? '&villageId=' + villageId : '') + 
                                                (accountId ? '&accountId=' + accountId : '') + 
                                                (search ? '&search=' + search : '');
                        %>

                        <div class="mx-4 mb-6 mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="text-sm text-gray-700">
                                แสดง <%= totalCount > 0 ? ((pageNumber - 1) * limit) + 1 : 0 %> 
                                ถึง <%= Math.min(pageNumber * limit, totalCount) %> 
                                จาก <%= totalCount %> รายการ
                            </div>

                            <div class="flex items-center gap-2">
                                <% if (pageNumber > 1) { %>
                                <a href="?page=1<%= filterParams %>" 
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                    <ion-icon name="play-back-outline"></ion-icon>
                                </a>
                                <% } %>

                                <% if (pageNumber > 1) { %>
                                <a href="?page=<%= pageNumber - 1 %><%= filterParams %>" 
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                    <ion-icon name="chevron-back-outline"></ion-icon>
                                </a>
                                <% } else { %>
                                <button disabled 
                                        class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">
                                    <ion-icon name="chevron-back-outline"></ion-icon>
                                </button>
                                <% } %>

                                <% 
                                const maxPagesToShow = 5;
                                let startPage = Math.max(1, pageNumber - Math.floor(maxPagesToShow / 2));
                                let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);
                                
                                if (endPage - startPage < maxPagesToShow - 1) {
                                    startPage = Math.max(1, endPage - maxPagesToShow + 1);
                                }
                                
                                if (startPage > 1) { %>
                                    <span class="px-2 text-gray-500">...</span>
                                <% } 
                                
                                for (let i = startPage; i <= endPage; i++) { %>
                                    <% if (i === pageNumber) { %>
                                    <button class="px-4 py-2 rounded-md bg-green-600 text-white text-sm font-medium">
                                        <%= i %>
                                    </button>
                                    <% } else { %>
                                    <a href="?page=<%= i %><%= filterParams %>" 
                                    class="px-4 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                        <%= i %>
                                    </a>
                                    <% } %>
                                <% } 
                                
                                if (endPage < totalPages) { %>
                                    <span class="px-2 text-gray-500">...</span>
                                <% } %>

                                <% if (pageNumber < totalPages) { %>
                                <a href="?page=<%= pageNumber + 1 %><%= filterParams %>" 
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                    <ion-icon name="chevron-forward-outline"></ion-icon>
                                </a>
                                <% } else { %>
                                <button disabled 
                                        class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">
                                    <ion-icon name="chevron-forward-outline"></ion-icon>
                                </button>
                                <% } %>

                                <% if (pageNumber < totalPages) { %>
                                <a href="?page=<%= totalPages %><%= filterParams %>" 
                                class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                    <ion-icon name="play-forward-outline"></ion-icon>
                                </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (wasteSummary && wasteSummary.length > 0) { %>
                <div class="mx-4 mb-6 bg-white rounded-lg shadow">
                    
                    <!-- Header ที่สามารถคลิกได้ -->
                    <div class="p-4 cursor-pointer hover:bg-gray-50 transition-colors" onclick="toggleSummaryTable()">
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <div class="bg-green-100 p-2 rounded-lg">
                                    <i class="fas fa-chart-bar text-green-600 text-lg"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-gray-800">
                                        สรุปยอดขายแยกตามประเภทขยะ
                                        <% if (searchMonth || searchYear || villageId || accountId) { %>
                                        <span class="text-sm font-normal text-gray-500">(กรองแล้ว)</span>
                                        <% } %>
                                    </h2>
                                    <p class="text-sm text-gray-500 mt-1">
                                        รวม <%= wasteSummary.length %> รายการ | 
                                        น้ำหนัก <%= grandTotal.totalQuantity.toFixed(2) %> กก. | 
                                        มูลค่า <%= grandTotal.totalAmount.toLocaleString('th-TH') %> บาท
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-sm text-gray-500">คลิกเพื่อแสดง/ซ่อน</span>
                                <div id="toggle-icon" class="transform transition-transform duration-300">
                                    <i class="fas fa-chevron-down text-gray-600 text-xl"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- เนื้อหาที่ซ่อน/แสดงได้ -->
                    <div id="summary-table-content" class="hidden">
                        <div class="p-4 border-t border-gray-200" id="printable-summary-section">
                            
                            <!-- Header สำหรับพิมพ์ (ซ่อนในหน้าจอปกติ) -->
                            <div id="print-header" style="display: none;">
                                <h1>รายงานสรุปยอดขายแยกตามประเภทขยะ</h1>
                                <p>วันที่พิมพ์: <%= new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
                                <% if (searchDate || searchMonth || searchYear || villageId || accountId) { %>
                                <p>เงื่อนไข: 
                                    <%= searchDate ? 'วันที่ ' + new Date(searchDate).toLocaleDateString('th-TH') : '' %>
                                    <%= searchMonth && !searchDate ? ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'][parseInt(searchMonth) - 1] : '' %>
                                    <%= searchYear && !searchDate ? ' ปี ' + (parseInt(searchYear) + 543) : '' %>
                                    <% if (villageId && villages) { %>
                                        <% const selectedVillage = villages.find(v => v._id.toString() === villageId.toString()); %>
                                        <%= selectedVillage ? 'หมู่ ' + selectedVillage.villageNumber + ' - ' + selectedVillage.villageName : '' %>
                                    <% } %>
                                    <%= accountId ? ' เลขบัญชี: ' + accountId : '' %>
                                </p>
                                <% } else { %>
                                <p>แสดงข้อมูลทั้งหมด</p>
                                <% } %>
                            </div>
                            
                            <!-- ปุ่มควบคุม (แสดงเมื่อเปิดตาราง) -->
                            <div class="mb-4 flex justify-end gap-2 no-print">
                                <button onclick="printSummaryReport()" 
                                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition border border-blue-600 text-sm">
                                    <i class="fas fa-print mr-2"></i>พิมพ์รายงาน
                                </button>
                                <button onclick="exportWasteSummaryToCSV()" 
                                        class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md transition border border-green-600 text-sm">
                                    <i class="fas fa-file-csv mr-2"></i>ส่งออก CSV
                                </button>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-100">
                                        <tr>
                                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                หมู่ที่ / ลำดับ
                                            </th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                ชื่อขยะ / รายการ
                                            </th>
                                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                จำนวน<br>(ครัวเรือน)
                                            </th>
                                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                น้ำหนักรวม<br>(กก.)
                                            </th>
                                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                จำนวนเงิน
                                            </th>
                                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">
                                                หมายเหตุ
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <% if (!wasteSummary || wasteSummary.length === 0) { %>
                                        <tr>
                                            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                                                ไม่พบข้อมูล
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% let globalIndex = 0; %>
                                            <% wasteSummary.forEach((village, villageIdx) => { %>
                                                <% village.wasteItems.forEach((item, itemIdx) => { %>
                                                    <% globalIndex++; %>
                                                    <tr class="<%= globalIndex % 2 === 0 ? 'bg-gray-50' : 'bg-white' %> hover:bg-blue-50">
                                                        <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                            <% if (itemIdx === 0) { %>
                                                                <div class="font-bold text-blue-700 text-base">
                                                                    หมู่ <%= village._id.villageNumber %>
                                                                </div>
                                                            <% } else { %>
                                                                <span class="text-gray-400">-</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="px-6 py-4 text-sm text-gray-900">
                                                            <%= item.wasteName %>
                                                        </td>
                                                        <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                            <%= item.householdCount %>
                                                        </td>
                                                        <td class="px-6 py-4 text-center text-sm text-gray-900">
                                                            <div class="font-medium"><%= item.totalQuantity.toFixed(2) %></div>
                                                        </td>
                                                        <td class="px-6 py-4 text-center text-sm font-semibold text-green-600">
                                                            <%= item.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                                        </td>
                                                        <td class="px-6 py-4 text-center text-sm text-gray-500">
                                                            -
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                                
                                                <!-- แถวรวมของแต่ละหมู่บ้าน -->
                                                <tr class="bg-blue-50 font-semibold">
                                                    <td colspan="2" class="px-6 py-3 text-right text-sm">
                                                        รวมหมู่ <%= village._id.villageNumber %> 
                                                        <span class="text-xs font-normal text-gray-600">
                                                            (<%= village._id.villageName %>)
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-3 text-center text-sm text-blue-700">
                                                        <%= village.villageTotalHouseholds %>
                                                    </td>
                                                    <td class="px-6 py-3 text-center text-sm text-blue-700">
                                                        <%= village.villageTotalQuantity.toFixed(2) %>
                                                    </td>
                                                    <td class="px-6 py-3 text-center text-sm text-blue-700">
                                                        <%= village.villageTotalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                                    </td>
                                                    <td class="px-6 py-3"></td>
                                                </tr>
                                            <% }); %>
                                            
                                            <!-- แถวรวมทั้งหมด -->
                                            <tr class="bg-yellow-50 border-t-2 border-yellow-300 font-bold">
                                                <td colspan="2" class="px-6 py-4 text-right text-sm">
                                                    รวมทั้งหมด (<%= grandTotal.villageCount %> หมู่บ้าน)
                                                </td>
                                                <td class="px-6 py-4 text-center text-sm text-green-700">
                                                    <%= grandTotal.totalHouseholds %>
                                                </td>
                                                <td class="px-6 py-4 text-center text-sm text-green-700">
                                                    <%= grandTotal.totalQuantity.toFixed(2) %>
                                                </td>
                                                <td class="px-6 py-4 text-center text-sm text-green-700">
                                                    <%= grandTotal.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                                                </td>
                                                <td class="px-6 py-4"></td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Footer สำหรับพิมพ์ -->
                            <div id="print-footer" style="display: none;">
                                เอกสารนี้สร้างโดยระบบกองทุนขยะรีไซเคิล เมื่อ <%= new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
</body>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const itemLinks = document.querySelectorAll('.item-link');
        const itemModal = document.getElementById('itemModal');
        const modalHeaderInfo = document.getElementById('modalHeaderInfo');
        const modalItemTable = document.getElementById('modalItemTable');


        itemLinks.forEach(link => {
            link.addEventListener('click', function (event) {
                event.preventDefault();
                const data = JSON.parse(this.dataset.items);
                const items = data.wasteItems;
                const accountData = data.accountId[0];
                const accountId = accountData.AccountNumber;
                const accountName = accountData.AccountName;
                const accountAddBy = data.purchaseAddby;
                const purchaseDate = new Date(data.purchaseDate);
                const formattedDate = purchaseDate.toLocaleDateString('th-TH');
                const formattedTime = purchaseDate.toLocaleTimeString('th-TH');

                // หมู่ที่
                let villageNumber = '-';
                if (accountData.familyID && accountData.familyID.village) {
                    villageNumber = 'หมู่ ' + accountData.familyID.village.villageNumber;
                }

                // ชื่อผู้ขาย
                let sellerNames = '-';
                if (accountData.familyID && accountData.familyID.members && accountData.familyID.members.length > 0) {
                    sellerNames = accountData.familyID.members.map(m => m.name).join(', ');
                }

                // คำนวณยอดรวม
                const totalAmount = items.reduce((sum, item) => sum + (item.quantity * item.pricePerUnit), 0);

                // ข้อมูลส่วนหัว - แบบ Cards
                const headerCards = `
                    <div class="bg-blue-50 rounded-xl p-3 border border-blue-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                            </svg>
                            <span class="text-xs text-blue-600 font-medium">เลขบัญชี</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${accountId}</p>
                    </div>
                    <div class="bg-green-50 rounded-xl p-3 border border-green-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="text-xs text-green-600 font-medium">ชื่อบัญชี</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${accountName}</p>
                    </div>
                    <div class="bg-purple-50 rounded-xl p-3 border border-purple-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span class="text-xs text-purple-600 font-medium">หมู่ที่</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${villageNumber}</p>
                    </div>
                    <div class="bg-amber-50 rounded-xl p-3 border border-amber-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span class="text-xs text-amber-600 font-medium">วันที่</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${formattedDate}</p>
                    </div>
                    <div class="bg-indigo-50 rounded-xl p-3 border border-indigo-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-xs text-indigo-600 font-medium">เวลา</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${formattedTime}</p>
                    </div>
                    <div class="bg-rose-50 rounded-xl p-3 border border-rose-100">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path>
                            </svg>
                            <span class="text-xs text-rose-600 font-medium">พนักงาน</span>
                        </div>
                        <p class="text-sm font-bold text-gray-800">${accountAddBy}</p>
                    </div>
                `;
                modalHeaderInfo.innerHTML = headerCards;

                // รายการสินค้า - แบบ Modern Table Rows
                let itemRows = '';
                let total = 0;
                items.forEach((item, index) => {
                    const subtotal = item.quantity * item.pricePerUnit;
                    total += subtotal;
                    itemRows += `<tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-700 text-sm font-medium">${index + 1}</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="font-medium text-gray-800">${item.name}</span>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <span class="px-2 py-1 rounded-lg bg-blue-50 text-blue-700 text-sm font-medium">${item.quantity.toLocaleString('th-TH')} กก.</span>
                        </td>
                        <td class="px-4 py-3 text-center text-gray-600">฿${item.pricePerUnit.toLocaleString('th-TH')}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="font-semibold text-green-600">฿${subtotal.toLocaleString('th-TH')}</span>
                        </td>
                    </tr>`;
                });
                modalItemTable.innerHTML = itemRows;
                document.getElementById('totalAmount').textContent = `฿${total.toLocaleString('th-TH')}`;

                itemModal.classList.remove('hidden');
            });
        });

        const closeModalButtons = document.querySelectorAll('.closeModal'); 

        closeModalButtons.forEach(button => {
             button.addEventListener('click', function () {
                itemModal.classList.add('hidden');
            });
        });

        window.addEventListener('click', function (event) {
            if (event.target === itemModal) {
                itemModal.classList.add('hidden');
            }
        });
    });

    function showModalDelete(index, id) {
        Swal.fire({
            title: `ลบรายการลำดับที่ "${index}" หรือไม่?`,
            text: "คุณจะไม่สามารถกู้คืนข้อมูลนี้ได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6b7280",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ยืนยัน"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/employee/wastePurchaseDelete/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                    .then(response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            return response.json();
                        }
                    })
                    .then(data => {
                        if (data && data.success) {
                            Swal.fire("ลบสำเร็จ!", "ข้อมูลถูกลบเรียบร้อย", "success")
                                .then(() => {
                                    location.reload();
                                });
                        } else if (data) {
                            Swal.fire("เกิดข้อผิดพลาด!", data.message || "ไม่สามารถลบข้อมูลได้", "error");
                        }
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        Swal.fire("เกิดข้อผิดพลาด!", "ไม่สามารถติดต่อเซิร์ฟเวอร์ได้", "error");
                    });
            }
        });
    }

    function exportWasteSummaryToCSV() {
        <% if (wasteSummary && wasteSummary.length > 0) { %>
        const wasteSummary = <%- JSON.stringify(wasteSummary) %>;
        const grandTotal = <%- JSON.stringify(grandTotal) %>;
        
        const reportDate = new Date().toLocaleDateString('th-TH', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric', 
            hour: '2-digit', 
            minute: '2-digit' 
        });
        
        let filterText = 'เงื่อนไข: แสดงข้อมูลทั้งหมด';
        <% if (searchDate || searchMonth || searchYear || villageId || accountId) { %>
            let filters = [];
            <% if (searchDate) { %>
                filters.push('วันที่: <%= new Date(searchDate).toLocaleDateString("th-TH") %>');
            <% } else if (searchMonth || searchYear) { %>
                <% if (searchMonth) { %>
                    const monthNames = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                                        'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
                    filters.push('เดือน: ' + monthNames[<%= parseInt(searchMonth) - 1 %>]);
                <% } %>
                <% if (searchYear) { %>
                    filters.push('ปี: <%= parseInt(searchYear) + 543 %>');
                <% } %>
            <% } %>
            <% if (villageId && villages) { %>
                const selectedVillage = <%- JSON.stringify(villages.find(v => v._id.toString() === villageId.toString())) %>;
                if(selectedVillage) filters.push('หมู่บ้าน: หมู่ ' + selectedVillage.villageNumber + ' - ' + selectedVillage.villageName);
            <% } %>
            <% if (accountId) { %>
                filters.push('เลขบัญชี: <%= accountId %>');
            <% } %>
            if(filters.length > 0) filterText = 'เงื่อนไข: ' + filters.join(', ');
        <% } %>

        const BOM = '\uFEFF';
        let csvContent = BOM;

        csvContent += `สรุปยอดขายแยกตามประเภทขยะ\n`;
        csvContent += `วันที่พิมพ์,${reportDate}\n`;
        csvContent += `"${filterText}"\n\n`;
        
        csvContent += "หมู่ที่/ลำดับ,ชื่อขยะ/รายการ,จำนวน(ครัวเรือน),จำนวนเงิน(บาท),จำนวนเงิน,หมายเหตุ\n";
        
        let rowIndex = 0;
        wasteSummary.forEach((village, villageIdx) => {
            village.wasteItems.forEach((item, itemIdx) => {
                rowIndex++;
                const villageLabel = itemIdx === 0 ? `หมู่ ${village._id.villageNumber}` : rowIndex;
                csvContent += `"${villageLabel}","${item.wasteName}",${item.householdCount},${item.totalQuantity.toFixed(2)},${item.totalAmount.toFixed(2)},-\n`;
            });
            
            // แถวรวมหมู่บ้าน
            csvContent += `,รวมหมู่ ${village._id.villageNumber} (${village._id.villageName}),${village.villageTotalHouseholds},${village.villageTotalQuantity.toFixed(2)},${village.villageTotalAmount.toFixed(2)},-\n`;
        });

        // แถวรวมทั้งหมด
        csvContent += `,รวมทั้งหมด (${grandTotal.villageCount} หมู่บ้าน),${grandTotal.totalHouseholds},${grandTotal.totalQuantity.toFixed(2)},${grandTotal.totalAmount.toFixed(2)},-\n`;
        csvContent += `\nข้อมูล ณ วันที่ ${reportDate} โดยระบบกองทุนขยะรีไซเคิล`;

        const blob = new Blob([csvContent], { 
            type: 'text/csv;charset=utf-8;' 
        });
        
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        
        const now = new Date();
        const dateStr = now.toISOString().split('T')[0];
        const fileName = `สรุปยอดขาย_${dateStr}.csv`;
        
        link.setAttribute('download', fileName);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        <% } else { %>
        alert('ไม่มีข้อมูลสำหรับส่งออก');
        <% } %>
    }

    // ฟังก์ชันพิมพ์รายงานสรุปยอดขาย
    function printSummaryReport() {
        window.print();
    }

    // ฟังก์ชัน Toggle แสดง/ซ่อนตารางสรุป (แก้ไขแล้ว)
    function toggleSummaryTable() {
        const content = document.getElementById('summary-table-content');
        const icon = document.getElementById('toggle-icon');
        
        if (content.classList.contains('hidden')) {
            // แสดงตาราง
            content.classList.remove('hidden');
            
            // คำนวณความสูงจริงของเนื้อหา
            const actualHeight = content.scrollHeight;
            
            // ตั้งค่าความสูงเป็น auto แทน
            content.style.maxHeight = actualHeight + 'px';
            icon.style.transform = 'rotate(180deg)';
            
            // หลังจาก animation เสร็จ ให้เป็น auto เพื่อให้เลื่อนได้เต็มที่
            setTimeout(() => {
                content.style.maxHeight = 'none';
                content.style.overflow = 'visible';
            }, 300);
        } else {
            // ซ่อนตาราง
            // ตั้งค่าความสูงจริงก่อน แล้วค่อยลดลงเป็น 0
            const actualHeight = content.scrollHeight;
            content.style.maxHeight = actualHeight + 'px';
            content.style.overflow = 'hidden';
            
            // Force reflow
            content.offsetHeight;
            
            // Animation ปิด
            content.style.maxHeight = '0';
            icon.style.transform = 'rotate(0deg)';
            
            setTimeout(() => {
                content.classList.add('hidden');
            }, 300);
        }
    }
</script>

</html>