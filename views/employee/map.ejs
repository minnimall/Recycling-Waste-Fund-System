<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
    <style>
        .content {
            margin-left: 0;
            padding: 20px;
        }
        .search-loading {
            display: none;
        }
        .search-loading.active {
            display: inline-block;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .request-item {
            transition: all 0.3s ease;
        }
        .request-item:hover {
            transform: translateX(5px);
        }
        .request-item.selected {
            border-color: #3B82F6;
            background-color: #EFF6FF;
        }
    </style>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // ข้อมูล wasteSaleRequest จาก server
        const pendingRequests = <%- JSON.stringify(pendingRequests) %>;
        console.log('Pending requests:', pendingRequests);
    </script>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <main class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ระบบแผนที่จุดรับซื้อขยะรีไซเคิล
                    </h1>
                    <p class="text-gray-600 mt-2">เลือกจุดรับซื้อและวิเคราะห์เส้นทางที่สั้นที่สุด</p>
                </div>
                <div>
                    <a href="/employee/routeList"
                        class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition shadow-md">
                        เส้นทางทั้งหมด
                    </a>
                </div>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Control Panel -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4 max-h-[calc(100vh-100px)] overflow-y-auto">
                        <p class="text-lg font-semibold text-gray-800 mb-4">
                            <!-- <ion-icon name="location-outline" class="inline-block mr-2"></ion-icon> -->
                            จัดการจุดรับซื้อ
                        </p>

                        <!-- Waste Sale Requests Section -->
                        <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                            <div class="flex justify-between items-center mb-3">
                                <p class="text-base font-medium text-800">คำขอขายขยะ</p>

                                <span class="bg-blue-600 text-white text-xs px-2 py-1 rounded-full ">
                                    <%= pendingRequests.length %> รายการ
                                </span>
                            </div>
                            
                            <% if (pendingRequests.length > 0) { %>
                                <div id="requestsList" class="space-y-2 max-h-80 overflow-y-auto">
                                    <% pendingRequests.forEach((request, index) => { %>
                                        <div class="request-item bg-white p-3 rounded-lg border border-gray-200 cursor-pointer hover:shadow-md"
                                            data-request-id="<%= request._id %>"
                                            data-lat="<%= request.latitude %>"
                                            data-lng="<%= request.longitude %>"
                                            data-location="<%= request.location %>"
                                            data-family="<%= request.family ? (request.family.firstname + ' ' + request.family.lastname) : 'N/A' %>"
                                            data-familyname="<%= request.family ? request.family.familyName : '' %>"
                                            onclick="toggleRequestSelection(this)">
                                            <div class="flex items-start">
                                                <input type="checkbox" 
                                                    class="request-checkbox mt-1 mr-2 h-4 w-4 text-blue-600 rounded"
                                                    onclick="event.stopPropagation();">
                                                <div class="flex-1">
                                                    <div class="font-medium text-gray-800 text-sm">
                                                        <%= request.family ? (request.family.familyName) : 'ไม่ระบุชื่อ' %>
                                                    </div>
                                                    <div class="text-xs text-gray-600 mt-1">
                                                        <ion-icon name="location" class="text-red-500"></ion-icon>
                                                        <%= request.location ? (request.location.substring(0, 40) + (request.location.length > 40 ? '...' : '')) : 'ไม่ระบุที่อยู่' %>
                                                    </div>
                                                    <p class="text-xs text-gray-800 mt-1">ขยะที่อยากขาย :</p>
                                                    <% request.waste.forEach(w => { %>
                                                        <div class="text-xs text-green-600 mt-1">
                                                            <%= w.wasteName %>
                                                        </div>
                                                    <% }) %>
                                                    <div class="text-xs text-gray-400 mt-1">
                                                        วันที่ให้เข้ามารับซื้อขยะ: <%= new Date(request.date).toLocaleDateString('th-TH') %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                
                                <div class="mt-3 flex gap-2">
                                    <button onclick="selectAllRequests()" 
                                            class="flex-1 bg-blue-600 text-white text-sm py-2 px-3 rounded-lg hover:bg-blue-700 transition">
                                        เลือกทั้งหมด
                                    </button>
                                    <button onclick="deselectAllRequests()" 
                                            class="flex-1 bg-gray-500 text-white text-sm py-2 px-3 rounded-lg hover:bg-gray-600 transition">
                                        ยกเลิกทั้งหมด
                                    </button>
                                </div>
                                
                                <button onclick="addSelectedRequestsToMap()" 
                                        class="w-full mt-2 bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition">
                                    <ion-icon name="add-circle-outline" class="inline-block mr-1"></ion-icon>
                                    เพิ่มจุดที่เลือกลงแผนที่
                                </button>
                            <% } else { %>
                                <div class="text-center text-gray-500 py-4 text-sm">
                                    <ion-icon name="alert-circle-outline" class="text-2xl"></ion-icon>
                                    <p class="mt-2">ไม่มีคำขอขายขยะที่รอดำเนินการ</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Manual Search Section -->
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">ค้นหาที่อยู่เพิ่มเติม</label>
                            <div class="relative">
                                <input type="text" 
                                    id="searchInput" 
                                    class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent pr-12" 
                                    placeholder="เช่น ขอนแก่น, มหาวิทยาลัยขอนแก่น...">
                                <button id="searchBtn" 
                                        class="absolute right-2 top-2 p-2 text-blue-600 hover:text-blue-800 transition-colors">
                                    <ion-icon name="search-outline" class="search-icon"></ion-icon>
                                    <ion-icon name="refresh-outline" class="search-loading"></ion-icon>
                                </button>
                            </div>
                            <div id="searchSuggestions" class="mt-2 hidden">
                                <div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                </div>
                            </div>
                        </div>

                        <!-- Selected Points List -->
                        <div class="mb-4">
                            <h3 class="text-lg font-medium text-gray-700 mb-2">จุดที่เลือก</h3>
                            <div id="selectedPointsList" class="space-y-2 max-h-60 overflow-y-auto">
                                <div class="text-gray-500 text-center py-4 text-sm">ยังไม่มีจุดที่เลือก</div>
                            </div>
                        </div>

                        <!-- Control Buttons -->
                        <div class="space-y-3">
                            <button id="analyzeBtn" 
                                    class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed" 
                                    disabled>
                                วิเคราะห์เส้นทาง
                            </button>
                            
                            <button id="clearBtn" 
                                    class="w-full bg-red-600 text-white py-3 px-4 rounded-lg hover:bg-red-700 transition">
                                ล้างจุดทั้งหมด
                            </button>

                            <button id="saveRouteBtn" 
                                    class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed" 
                                    onclick="saveCurrentRoute()"
                                    disabled>
                                บันทึกเส้นทาง
                            </button>
                        </div>

                        <!-- Route Analysis Results -->
                        <div id="routeResults" class="mt-6 hidden">
                            <h3 class="text-lg font-medium text-gray-700 mb-3">ผลการวิเคราะห์</h3>
                            <div id="routeInfo" class="bg-blue-50 p-4 rounded-lg text-sm">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Map Section -->
                <div class="lg:col-span-3">
                    <div class="bg-white rounded-lg shadow-lg p-4">
                        <div class="mb-3 text-sm text-gray-600 bg-blue-50 p-3 rounded-lg border border-blue-200">
                            <ion-icon name="information-circle" class="inline-block mr-2 text-blue-600"></ion-icon>
                            เลือกคำขอขายขยะจากรายการด้านซ้าย หรือคลิกบนแผนที่เพื่อเลือกจุด
                        </div>
                        <div id="map" class="w-full h-96 lg:h-[600px] rounded-lg border border-gray-200"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <script>
        // Global variables
        let map;
        let selectedPoints = [];
        let markers = [];
        let routeLayer = null;
        let routeMarkers = [];
        let distanceMatrix = {};
        let isCalculatingDistances = false;
        let searchTimeout = null;
        let optimizedRoutePoints = [];
        let routeAnalysisData = null;
        let selectedRequestIds = []; // เก็บ ID ของ wasteSaleRequest ที่เลือก
        
        // Initialize map
        function initMap() {
            const initialLat = 15.948741697876695;
            const initialLng = 102.85523133360921;
            
            map = L.map('map').setView([initialLat, initialLng], 15);
            
            L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                attribution: '© Google',
                maxZoom: 20
            }).addTo(map);
            
            map.on('click', function(e) {
                const lat = e.latlng.lat;
                const lng = e.latlng.lng;
                
                const loadingPopup = L.popup()
                    .setLatLng(e.latlng)
                    .setContent('<div class="text-center"><ion-icon name="refresh-outline" class="animate-spin"></ion-icon> กำลังหาที่อยู่...</div>')
                    .openOn(map);
                
                reverseGeocode(lat, lng).then(address => {
                    map.closePopup(loadingPopup);
                    addPoint(lat, lng, address, null);
                }).catch(error => {
                    map.closePopup(loadingPopup);
                    const fallbackAddress = `จุดที่ ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                    addPoint(lat, lng, fallbackAddress, null);
                });
            });
        }

        // Toggle request selection
        function toggleRequestSelection(element) {
            const checkbox = element.querySelector('.request-checkbox');
            checkbox.checked = !checkbox.checked;
            
            if (checkbox.checked) {
                element.classList.add('selected');
            } else {
                element.classList.remove('selected');
            }
        }

        // Select all requests
        function selectAllRequests() {
            document.querySelectorAll('.request-item').forEach(item => {
                item.querySelector('.request-checkbox').checked = true;
                item.classList.add('selected');
            });
        }

        // Deselect all requests
        function deselectAllRequests() {
            document.querySelectorAll('.request-item').forEach(item => {
                item.querySelector('.request-checkbox').checked = false;
                item.classList.remove('selected');
            });
        }

        // Add selected requests to map
        function addSelectedRequestsToMap() {
            const selectedItems = document.querySelectorAll('.request-item .request-checkbox:checked');
    
            if (selectedItems.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกคำขอ',
                    text: 'กรุณาเลือกคำขอขายขยะอย่างน้อย 1 รายการ',
                    timer: 2000
                });
                return;
            }

            let addedCount = 0;
            selectedItems.forEach(checkbox => {
                const item = checkbox.closest('.request-item');
                const requestId = item.dataset.requestId;
                const lat = parseFloat(item.dataset.lat);
                const lng = parseFloat(item.dataset.lng);
                const location = item.dataset.location;
                const family = item.dataset.family;
                const familyName = item.dataset.familyname;
                
                const alreadyAdded = selectedPoints.some(p => 
                    p.lat === lat && p.lng === lng && p.requestId === requestId
                );
                
                if (!alreadyAdded) {
                    const address = `${family} - ${location}`;
                    addPoint(lat, lng, address, requestId, familyName);
                    addedCount++;
                }
            });

            if (addedCount > 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `เพิ่ม ${addedCount} จุดลงแผนที่แล้ว`,
                    showConfirmButton: false,
                    timer: 2000
                });

                // ยกเลิกการเลือกหลังจากเพิ่มแล้ว
                deselectAllRequests();
            } else {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: 'จุดเหล่านี้ถูกเพิ่มไว้แล้ว',
                    showConfirmButton: false,
                    timer: 2000
                });
            }
        }
        
        // Reverse geocoding
        async function reverseGeocode(lat, lng) {
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1&accept-language=th`);
                const data = await response.json();
                
                if (data && data.display_name) {
                    return data.display_name;
                } else {
                    throw new Error('No address found');
                }
            } catch (error) {
                console.warn('Reverse geocoding failed:', error);
                return `จุดที่ ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
            }
        }
        
        // Enhanced search
        async function performSearch(query, showPopup = true) {
            if (!query || query.trim().length < 2) {
                if (showPopup) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาใส่ข้อความค้นหา',
                        text: 'กรุณาใส่อย่างน้อย 2 ตัวอักษร',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                return;
            }
            
            const searchBtn = document.getElementById('searchBtn');
            const searchIcon = searchBtn.querySelector('.search-icon');
            const loadingIcon = searchBtn.querySelector('.search-loading');
            
            searchIcon.style.display = 'none';
            loadingIcon.style.display = 'inline-block';
            loadingIcon.classList.add('active');
            searchBtn.disabled = true;
            
            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    html: `กำลังค้นหา "${query}"`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }
            
            try {
                const results = await searchMultipleSources(query);
                
                if (showPopup) {
                    Swal.close();
                }
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (results.length > 0) {
                    if (results.length === 1) {
                        const result = results[0];
                        map.setView([result.lat, result.lng], 15);
                        addPoint(result.lat, result.lng, result.display_name, null);
                        document.getElementById('searchInput').value = '';
                    } else {
                        showSearchResults(results);
                    }
                } else {
                    if (showPopup) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่พบผลการค้นหา',
                            html: `
                                <div class="text-left">
                                    <p class="mb-2">ไม่พบสถานที่ที่ค้นหา "${query}"</p>
                                    <p class="text-sm text-gray-600">ลองใช้คำค้นหาอื่น</p>
                                </div>
                            `,
                            timer: 5000,
                            confirmButtonText: 'ตกลง'
                        });
                    }
                }
            } catch (error) {
                console.error('Search error:', error);
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (showPopup) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถค้นหาได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง',
                        timer: 3000
                    });
                }
            }
        }
        
        async function searchMultipleSources(query) {
            const results = [];
            
            try {
                const nominatimUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5&addressdetails=1&accept-language=th,en&countrycodes=th`;
                
                const response = await fetch(nominatimUrl);
                const data = await response.json();
                
                if (data && data.length > 0) {
                    data.forEach(item => {
                        if (item.lat && item.lon) {
                            results.push({
                                lat: parseFloat(item.lat),
                                lng: parseFloat(item.lon),
                                display_name: item.display_name,
                                type: item.type || 'location',
                                importance: parseFloat(item.importance || 0)
                            });
                        }
                    });
                }
                
                results.sort((a, b) => (b.importance || 0) - (a.importance || 0));
                
                return results.slice(0, 5);
                
            } catch (error) {
                console.error('Search sources error:', error);
                throw error;
            }
        }
        
        function showSearchResults(results) {
            const suggestionsDiv = document.getElementById('searchSuggestions');
            let html = '';
            
            results.forEach((result, index) => {
                html += `
                    <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0" 
                        data-lat="${result.lat}" data-lng="${result.lng}" data-name="${result.display_name}">
                        <div class="font-medium text-gray-800 text-sm">${result.display_name}</div>
                        <div class="text-xs text-gray-500 mt-1">
                            <ion-icon name="location-outline" class="text-blue-500"></ion-icon>
                            ${result.lat.toFixed(4)}, ${result.lng.toFixed(4)}
                        </div>
                    </div>
                `;
            });
            
            suggestionsDiv.innerHTML = `<div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">${html}</div>`;
            suggestionsDiv.classList.remove('hidden');
            
            suggestionsDiv.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);
                    const name = this.dataset.name;
                    
                    map.setView([lat, lng], 15);
                    addPoint(lat, lng, name, null);
                    
                    document.getElementById('searchInput').value = '';
                    suggestionsDiv.classList.add('hidden');
                });
            });
            
            document.addEventListener('click', function(event) {
                if (!suggestionsDiv.contains(event.target) && !document.getElementById('searchInput').contains(event.target)) {
                    suggestionsDiv.classList.add('hidden');
                }
            });
        }
        
        function setupEnhancedSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const suggestionsDiv = document.getElementById('searchSuggestions');
            
            function doSearch() {
                const query = searchInput.value.trim();
                performSearch(query, true);
            }
            
            searchBtn.addEventListener('click', doSearch);
            
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    doSearch();
                    suggestionsDiv.classList.add('hidden');
                }
            });
            
            searchInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }
                
                if (query.length >= 2) {
                    searchTimeout = setTimeout(() => {
                        performSearch(query, false).then(() => {
                        });
                    }, 500);
                } else {
                    suggestionsDiv.classList.add('hidden');
                }
            });
            
            map.on('click', function() {
                suggestionsDiv.classList.add('hidden');
            });
        }
        
        // Add point - รองรับ requestId
        function addPoint(lat, lng, address, requestId = null,familyName = null) {
            const pointNumber = selectedPoints.length + 1;
            const point = {
                id: pointNumber,
                lat: lat,
                lng: lng,
                address: address,
                requestId: requestId,
                familyName: familyName
            };
            
            selectedPoints.push(point);
            
            // เก็บ requestId ไว้ใน array แยก
            if (requestId) {
                selectedRequestIds.push(requestId);
            }
            
            const marker = L.marker([lat, lng])
                .addTo(map)
