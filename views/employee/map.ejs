        function clearRoute() {
            if (routeLayer) {
                try {
                    map.removeControl(routeLayer);
                } catch (e) {
                    console.warn('Error removing route layer:', e);
                }
                routeLayer = null;
            }
            
            routeMarkers.forEach(marker => {
                try {
                    map.removeLayer(marker);
                } catch (e) {
                    console.warn('Error removing marker:', e);
                }
            });
            routeMarkers = [];
            
            document.getElementById('routeResults').classList.add('hidden');
            distanceMatrix = {};
            optimizedRoutePoints = [];
            routeAnalysisData = null;
        }
        
        function clearAllPoints() {
            Swal.fire({
                title: 'ต้องการล้างจุดทั้งหมดหรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'ล้างทั้งหมด',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    selectedPoints = [];
                    selectedRequestIds = [];
                    
                    markers.forEach(marker => {
                        map.removeLayer(marker);
                    });
                    markers = [];
                    
                    clearRoute();
                    updatePointsList();
                    updateButtons();
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'ล้างข้อมูลเรียบร้อย',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            });
        }
        
