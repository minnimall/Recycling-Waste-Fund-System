        // ----------- Date Filter ----------
        function setDateFilter(preset) {
            const dateInput = document.getElementById('dateFilter');
            if (preset === 'all') {
                dateInput.value = '';
            } else {
                const d = new Date();
                if (preset === 'tomorrow') d.setDate(d.getDate() + 1);
                dateInput.value = d.toISOString().split('T')[0];
            }
            filterByDate();
        }

        function filterByDate() {
            const dateInput = document.getElementById('dateFilter');
            const filterValue = dateInput.value; // e.g. '2026-02-23' or ''
            const items = document.querySelectorAll('.request-item');
            let visibleCount = 0;

            items.forEach(item => {
                const pickupDate = item.getAttribute('data-pickup-date') || '';
                if (!filterValue || pickupDate === filterValue) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                    // Deselect hidden items
                    if (item.classList.contains('selected')) {
                        item.classList.remove('selected');
                        const cb = item.querySelector('.request-checkbox');
                        if (cb) cb.checked = false;
                    }
                }
            });

            // Update counter badge
            const badge = document.getElementById('requestCountBadge');
            if (badge) {
                const total = items.length;
                badge.textContent = filterValue 
                    ? `${visibleCount}/${total} รายการ` 
                    : `${total} รายการ`;
            }
        }

