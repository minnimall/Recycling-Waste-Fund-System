        // Update button states
        function updateButtons() {
            const analyzeBtn = document.getElementById('analyzeBtn');
            const clearBtn = document.getElementById('clearBtn');
            
            analyzeBtn.disabled = selectedPoints.length < 2;
            clearBtn.disabled = selectedPoints.length === 0;
        }
        

        // Calculate road distance between two points using [ OSRM คำนวณระยะทางจริง (บนถนน) ระหว่าง point1 และ point2 โดยใช้ OSRM API ]
        async function calculateRoadDistance(point1, point2) {
            const key = `${point1.id}-${point2.id}`; // 1 - 2
            const reverseKey = `${point2.id}-${point1.id}`; // 2 - 1
            // เพื่อตรวจสอบว่าเคยมีการคำนวณระยะทางระหว่าง 2 จุดนี้มาก่อนหรือไม่จาก key , reverseKey
            if (distanceMatrix[key]) {
                return distanceMatrix[key];
            }
            if (distanceMatrix[reverseKey]) {
                return distanceMatrix[reverseKey];
            }
            
            try {
                // สร้าง URL สำหรับเรียก OSRM API โดยกำหนดพิกัดของจุดเริ่มต้น (point1) และจุดสิ้นสุด (point2) และระบุการเดินทางแบบ driving (ขับรถ)
                const url = `https://router.project-osrm.org/route/v1/driving/${point1.lng},${point1.lat};${point2.lng},${point2.lat}?overview=false&steps=false`; // หาเส้นทางเดินทางแบบรถยนต์
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.routes && data.routes.length > 0) {
                    const distance = data.routes[0].distance / 1000; // Convert to km ดึงระยะทาง distance (เมตร → กม)
                    const duration = data.routes[0].duration / 60; // Convert to minutes ดึงเวลา duration (วินาที → นาที)
                    
                    const result = { distance, duration };
                    distanceMatrix[key] = result; //เก็บลัพธ์
                    return result;
                } else {
                    const distance = calculateStraightLineDistance(point1, point2);
                    const result = { distance, duration: (distance / 40) * 60 };
                    distanceMatrix[key] = result;
                    return result;
                }
            } catch (error) {
                console.error('Error calculating road distance:', error);
                const distance = calculateStraightLineDistance(point1, point2);
                const result = { distance, duration: (distance / 40) * 60 };
                distanceMatrix[key] = result;
                return result;
            }
        }
        
        // Calculate straight-line distance (fallback) [ คำนวณระยะทางเส้นตรงระหว่างจุด 2 จุดโดยใช้ Haversine formula ]
        function calculateStraightLineDistance(point1, point2) {
            const R = 6371; // Earth's radius in kilometers ใช้สูตรระยะโค้งใหญ่บนทรงกลม (Earth radius = 6371 km)
            const dLat = toRad(point2.lat - point1.lat); // คำนวณ Δlat, Δlng, จากนั้นหา a, c และ distance = R * c
            const dLng = toRad(point2.lng - point1.lng);
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                    Math.cos(toRad(point1.lat)) * Math.cos(toRad(point2.lat)) *
                    Math.sin(dLng/2) * Math.sin(dLng/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }
        
        function toRad(degrees) {
            return degrees * (Math.PI / 180); // แปลงองศา (Degrees) เป็นเรเดียน (Radians) เพื่อใช้ในฟังก์ชันตรีโกณมิติ
        }
        
        // Build distance matrix for all points สร้าง ตารางระยะทาง (Matrix) ระหว่างทุกจุดใน points
        async function buildDistanceMatrix(points) {
            const n = points.length;
            const matrix = Array(n).fill(null).map(() => Array(n).fill(0));
            
            for (let i = 0; i < n; i++) {
                for (let j = i + 1; j < n; j++) {
                    const result = await calculateRoadDistance(points[i], points[j]);
                    matrix[i][j] = result.distance;
                    matrix[j][i] = result.distance;
                }
            }
            
            return matrix;
        }
        
        // Solve TSP using nearest neighbor with 2-opt improvement เริ่มต้นจากทุกจุด → สร้างเส้นทางแบบ Nearest Neighbor และปรับปรุงด้วย 2-opt
        async function calculateOptimalRoute(points) {
            if (points.length < 2) return points;

            const n = points.length;
            const distMatrix = await buildDistanceMatrix(points);

            // กรณีมี 2 จุด ให้เรียงตามลำดับเดิม
            if (n === 2) {
                return points;
            }

            // เริ่มต้นจากจุดแรกเสมอ (index 0)
            const startIdx = 0;
            const route = [startIdx];
            const visited = new Set([startIdx]);
            let currentIdx = startIdx;

            // หาจุดที่ใกล้ที่สุดจากจุดปัจจุบัน (Nearest Neighbor Algorithm) เลือกจุดที่ใกล้ที่สุดที่ยังไม่ได้เยี่ยมชม ทำซ้ำจนครบทุกจุด
            while (route.length < n) {
                let nearestIdx = -1;
                let nearestDistance = Infinity;

                for (let i = 0; i < n; i++) {
                    if (!visited.has(i) && distMatrix[currentIdx][i] < nearestDistance) {
                        nearestDistance = distMatrix[currentIdx][i];
                        nearestIdx = i;
                    }
                }

                if (nearestIdx !== -1) {
                    route.push(nearestIdx);
                    visited.add(nearestIdx);
                    currentIdx = nearestIdx;
                }
            }

            // ปรับปรุงด้วย 2-opt (แต่ยังคงจุดเริ่มต้นไว้)
            const improvedRoute = await improve2OptWithFixedStart(route, distMatrix);

            return improvedRoute.map(idx => points[idx]);
        }

        // ฟังก์ชัน 2-opt ที่คงจุดเริ่มต้นไว้
        async function improve2OptWithFixedStart(route, distMatrix) { //ปรับปรุงเส้นทาง (route) โดยใช้ 2-opt Algorithm เพื่อ "ตัดแล้วสลับ" ช่วงทางให้ได้เส้นทางสั้นลง
            const n = route.length; // หลักการ 2-opt:
            let improved = true;

            // ให้จุดแรก (index 0) คงที่ ปรับเฉพาะจุดที่เหลือ
            while (improved) {
                improved = false;

                // เริ่มจาก i = 1 เพื่อไม่ให้จุดแรกถูกย้าย
                for (let i = 1; i < n - 1; i++) { // วนลูปผ่านคู่ของตำแหน่งในเส้นทาง: (i, j) คำนวณความยาวของเส้นทางก่อน และหลังสลับ
                    for (let j = i + 1; j < n; j++) {
                        const currentDistance = 
                            distMatrix[route[i-1]][route[i]] + 
                            distMatrix[route[j]][route[(j+1) % n]];

                        const newDistance = 
                            distMatrix[route[i-1]][route[j]] + 
                            distMatrix[route[i]][route[(j+1) % n]];

                        if (newDistance < currentDistance) { // ถ้าแบบสลับดีกว่า → ทำการ reverse จุดระหว่าง i ถึง j
                            const newRoute = [...route];
                            // Reverse เฉพาะส่วนที่อยู่ระหว่าง i ถึง j
                            for (let k = i, l = j; k < l; k++, l--) {
                                [newRoute[k], newRoute[l]] = [newRoute[l], newRoute[k]];
                            }
                            route = newRoute;
                            improved = true;
                        }
                    }
                }
            }

            return route;
        }
        
        // Analyze route - Enhanced version
        async function analyzeRoute() {
            if (selectedPoints.length < 2) return;
            
            if (isCalculatingDistances) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณารอสักครู่',
                    text: 'ระบบกำลังคำนวณระยะทางอยู่',
                    timer: 2000
                });
                return;
            }
            
            isCalculatingDistances = true;
            
            Swal.fire({
                title: 'กำลังวิเคราะห์เส้นทาง...',
                html: `
                    <div class="text-center">
                        <div class="mb-3">กำลังคำนวณระยะทางตามเส้นถนนจริง</div>
                        <div id="progress-text" class="text-sm text-gray-600">กำลังเตรียมข้อมูล...</div>
                        <div class="w-full bg-gray-200 rounded-full h-2 mt-3">
                            <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                `,
                allowOutsideClick: false,
                showConfirmButton: false
            });
            
            try {
                const updateProgress = (text, width) => {
                    const progressText = document.getElementById('progress-text');
                    const progressBar = document.getElementById('progress-bar');
                    if (progressText) progressText.textContent = text;
                    if (progressBar) progressBar.style.width = width + '%';
                };
                
                updateProgress('กำลังคำนวณระยะทางระหว่างจุด...', 30);
                
                console.log('Starting route optimization for', selectedPoints.length, 'points');
                const optimizedRoute = await calculateOptimalRoute(selectedPoints);
                console.log('Route optimization completed');
                
                updateProgress('กำลังวาดเส้นทางบนแผนที่...', 70);
                
                await Promise.resolve(displayOptimizedRoute(optimizedRoute));
                console.log('Route display completed');
                
                updateProgress('เสร็จสิ้น', 100);
                
                // อัปเดตสถานะปุ่มบันทึก
                updateButtons();

                setTimeout(() => {
                    if (Swal.isVisible()) {
                        Swal.close();
                    }
                    isCalculatingDistances = false;
                }, 1000);
                
            } catch (error) {
                console.error('Error in analyzeRoute:', error);
                
                if (Swal.isVisible()) {
                    Swal.close();
                }
                
                setTimeout(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        html: `
                            <div class="text-left">
                                <p class="mb-2">ไม่สามารถวิเคราะห์เส้นทางได้ กรุณาลองใหม่อีกครั้ง</p>
                                <details class="text-xs text-gray-600 mt-2">
                                    <summary>รายละเอียดข้อผิดพลาด (สำหรับนักพัฒนา)</summary>
                                    <pre class="mt-2 p-2 bg-gray-100 rounded text-xs overflow-auto">${error.message}</pre>
                                </details>
                            </div>
                        `,
                        confirmButtonText: 'ลองใหม่',
                        showCancelButton: true,
                        cancelButtonText: 'ปิด'
                    });
                }, 500);
                
                isCalculatingDistances = false;
            }
        }
        
        // Display optimized route on map แสดงเส้นทางที่เหมาะสมที่สุดบนแผนที่
        async function displayOptimizedRoute(route) {
            try {
                clearRoute();
                
                if (route.length < 2) {
                    console.log('Route too short, skipping display');
                    return;
                }
                
                console.log('Displaying route for', route.length, 'points');

                // เก็บเส้นทางที่วิเคราะห์แล้วไว้ใน global variable
                optimizedRoutePoints = [...route];
                
                let totalDistance = 0;
                let totalDuration = 0;
                const routeSegments = [];
                
                // Create routing control for the entire route
                const waypoints = route.map(point => L.latLng(point.lat, point.lng));
                // เพิ่มจุดเริ่มต้นเข้าไปในตอนท้ายเพื่อสร้าง round trip ที่จะวนกลับไปที่จุดเริ่มต้น
                waypoints.push(L.latLng(route[0].lat, route[0].lng));
                
                const routingControl = L.Routing.control({ 
                    waypoints: waypoints, // กำหนดจุดทั้งหมดที่ต้องไป
                    routeWhileDragging: false,
                    addWaypoints: false,
                    lineOptions: { // กำหนดสี, ความหนา, และความทึบของเส้นทาง
                        styles: [{
                            color: '#3B82F6',
                            weight: 4,
                            opacity: 0.8
                        }]
                    },
                    createMarker: function() { return null; }, 
                    router: L.Routing.osrmv1({   // ใช้ไลบรารี OSRM เป็น routing engine Library สำหรับวาดเส้นทางบนแผนที่
                        serviceUrl: 'https://router.project-osrm.org/route/v1',
                        profile: 'driving'
                    })
                });
                
                routingControl.on('routesfound', function(e) {
                    console.log('Routes found:', e.routes.length);
                });
                
                routingControl.on('routingerror', function(e) {
                    console.warn('Routing error:', e.error);
                });
                
                routingControl.addTo(map);
                routeLayer = routingControl;
                
                // Hide the routing instructions panel
                setTimeout(() => {
                    try {
                        const routingContainer = routingControl.getContainer();
                        if (routingContainer && routingContainer.style) {
                            routingContainer.style.display = 'none';
                        }
                    } catch (e) {
                        console.warn('Could not hide routing container:', e.message);
                    }
                }, 1000);
                
                // Calculate segment distances and durations 
                // ส่วนนี้จะวนลูปเพื่อคำนวณระยะทางและเวลาระหว่าง แต่ละคู่จุด ในเส้นทางที่เรียงลำดับแล้ว
                for (let i = 0; i < route.length; i++) {
                    try {
                        // คำนวณระยะทางไปจุดถัดไป หรือกลับจุดเริ่มต้นถ้าเป็นจุดสุดท้าย
                        const nextPoint = (i === route.length - 1) ? route[0] : route[i + 1];
                        const result = await calculateRoadDistance(route[i], nextPoint);
                        totalDistance += result.distance;
                        totalDuration += result.duration;
                        routeSegments.push(result);
                    } catch (error) {
                        console.warn(`Error calculating segment ${i+1}:`, error.message);
                        const nextPoint = (i === route.length - 1) ? route[0] : route[i + 1];
                        const fallbackDist = calculateStraightLineDistance(route[i], nextPoint);
                        const fallbackResult = { distance: fallbackDist, duration: (fallbackDist / 40) * 60 };
                        totalDistance += fallbackResult.distance;
                        totalDuration += fallbackResult.duration;
                        routeSegments.push(fallbackResult);
                    }
                }
                
                // Add custom route markers with numbers ไว้สำหรับสร้างตกแต่งมาร์กจุดเอง custom เองได้
                route.forEach((point, index) => {
                    try {
                        const routeMarker = L.divIcon({
                            html: `<div class="bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shadow-lg border-2 border-white">${index + 1}</div>`,
                            className: 'custom-route-marker',
                            iconSize: [32, 32],
                            iconAnchor: [16, 16]
                        });
                        
                        const marker = L.marker([point.lat, point.lng], { icon: routeMarker })
                            .bindPopup(`
                                <div class="text-center">
                                    <b>จุดที่ ${index + 1}</b><br>
                                    <div class="text-sm mt-1">${point.address}</div>
                                    ${index === 0 ? '<div class="text-green-600 text-xs mt-1">จุดเริ่มต้น/สิ้นสุด</div>' : ''}
                                </div>
                            `)
                            .addTo(map);
                            
                        routeMarkers.push(marker);
                    } catch (error) {
                        console.warn(`Error creating marker for point ${index + 1}:`, error.message);
                    }
                });
                
                // Display detailed results
                displayDetailedRouteResults(route, routeSegments, totalDistance, totalDuration);

                // เก็บข้อมูลการวิเคราะห์
                routeAnalysisData = {
                    optimizedRoute: route,
                    segments: routeSegments,
                    totalDistance: totalDistance,
                    totalDuration: totalDuration
                };
                
                // Fit map to route bounds
                setTimeout(() => {
                    try {
                        if (routeMarkers.length > 0) {
                            const group = L.featureGroup([...routeMarkers]);
                            map.fitBounds(group.getBounds().pad(0.1));
                        }
                    } catch (error) {
                        console.warn('Error fitting map bounds:', error.message);
                    }
                }, 1500);
                
                // Show success message    หน้า alert ตอนที่กดวิเคราะห์เส้นทางเสร็จแล้วแสดงข้อมูลสรุปรวม
                setTimeout(() => {
                    Swal.fire({
                        icon: 'success',
                        title: 'เส้นทางที่เหมาะสมที่สุด!',
                        html: `
                            <div class="text-left">
                                <div class="mb-2"><strong>ระยะทางรวม:</strong> ${totalDistance.toFixed(2)} กิโลเมตร</div>
                                <div class="mb-2"><strong>เวลารวม:</strong> ${Math.round(totalDuration)} นาที</div>
                                <div class="text-sm text-gray-600">*คำนวณจากเส้นทางถนนจริง</div>
                            </div>
                        `,
                        timer: 5000,
                        showConfirmButton: true,
                        confirmButtonText: 'ดูรายละเอียด'
                    });
                }, 2000);
                
            } catch (error) {
                console.error('Error in displayOptimizedRoute:', error);
                throw error;
            }
        }
        
        // Display detailed route analysis results  ตัวข้อมูลแถบทางซ้ายล่างตอนที่วิเคราะห์เส้นทางเสร็จแสดงข้อมูลต่างๆ
        function displayDetailedRouteResults(route, segments, totalDistance, totalDuration) {
            const resultsContainer = document.getElementById('routeResults');
            const routeInfo = document.getElementById('routeInfo');
            
            let html = `
                <div class="mb-4 p-4 bg-gradient-to-r from-blue-50 to-green-50 rounded-lg border border-blue-200">
                    <h4 class="font-bold text-blue-800 mb-3 flex items-center">
                        <ion-icon name="analytics-outline" class="mr-2"></ion-icon>
                        สรุปเส้นทาง Round Trip
                    </h4>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="bg-white p-3 rounded-lg shadow-sm">
                            <span class="font-medium text-gray-700">ระยะทางรวม:</span><br>
                            <span class="text-blue-600 font-bold text-lg">${totalDistance.toFixed(2)} กม.</span>
                            <div class="text-xs text-gray-500 mt-1">จากเส้นทางถนนจริง</div>
                        </div>
                        <div class="bg-white p-3 rounded-lg shadow-sm">
                            <span class="font-medium text-gray-700">เวลาโดยประมาณ:</span><br>
                            <span class="text-green-600 font-bold text-lg">${Math.round(totalDuration)} นาที</span>
                            <div class="text-xs text-gray-500 mt-1">${(totalDuration/60).toFixed(1)} ชั่วโมง</div>
                        </div>
                    </div>
                </div>
                
                <div>
                    <h4 class="font-semibold text-blue-700 mb-3 flex items-center">
                        <ion-icon name="navigate-outline" class="mr-2"></ion-icon>
                        ลำดับการเดินทาง
                    </h4>
                    <div class="space-y-2">
            `;
            
            // แสดงทุกจุดรวมถึงการกลับจุดเริ่มต้น
            route.forEach((point, index) => {
                const segment = segments[index];
                const isFirst = index === 0;
                
                html += `
                    <div class="flex items-start space-x-3 p-3 ${index % 2 === 0 ? 'bg-blue-50' : 'bg-white'} rounded-lg border ${isFirst ? 'border-green-300 bg-green-50' : 'border-gray-200'}">
                        <div class="flex-shrink-0">
                            <div class="${isFirst ? 'bg-green-600' : 'bg-blue-600'} text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold shadow-md">
                                ${index + 1}
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-800 text-sm leading-tight">${point.address}</div>
                            <div class="text-xs text-gray-500 mt-1">
                                ${point.lat.toFixed(4)}, ${point.lng.toFixed(4)}
                            </div>
                            ${segment ? `
                                <div class="mt-2 p-2 bg-white rounded border-l-4 border-blue-400">
                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div>
                                            <span class="text-gray-600">ระยะทาง:</span>
                                            <span class="font-semibold text-blue-600">${segment.distance.toFixed(2)} กม.</span>
                                        </div>
                                        <div>
                                            <span class="text-gray-600">เวลา:</span>
                                            <span class="font-semibold text-green-600">${Math.round(segment.duration)} นาที</span>
                                        </div>
                                    </div>
                                </div>
                            ` : isFirst ? '<div class="text-xs text-green-600 mt-1 font-medium">🎯 จุดเริ่มต้น</div>' : ''}
                        </div>
                        <div class="flex-shrink-0">
                            ${isFirst ? '<ion-icon name="play-circle" class="text-green-600 text-lg"></ion-icon>' :
                            '<ion-icon name="arrow-forward-circle" class="text-blue-600 text-lg"></ion-icon>'}
                        </div>
                    </div>
                `;
            });
            
            // เพิ่มส่วนแสดงการกลับจุดเริ่มต้น
            const returnSegment = segments[segments.length - 1];
            html += `
                <div class="flex items-start space-x-3 p-3 bg-green-50 rounded-lg border border-green-300">
                    <div class="flex-shrink-0">
                        <div class="bg-green-600 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold shadow-md">
                            ${route.length + 1}
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="font-medium text-gray-800 text-sm leading-tight">${route[0].address}</div>
                        <div class="text-xs text-green-600 mt-1 font-medium">🏁 กลับจุดเริ่มต้น</div>
                        <div class="text-xs text-gray-500 mt-1">
                            ${route[0].lat.toFixed(4)}, ${route[0].lng.toFixed(4)}
                        </div>
                        ${returnSegment ? `
                            <div class="mt-2 p-2 bg-white rounded border-l-4 border-green-400">
                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div>
                                        <span class="text-gray-600">ระยะทาง:</span>
                                        <span class="font-semibold text-blue-600">${returnSegment.distance.toFixed(2)} กม.</span>
                                    </div>
                                    <div>
                                        <span class="text-gray-600">เวลา:</span>
                                        <span class="font-semibold text-green-600">${Math.round(returnSegment.duration)} นาที</span>
                                    </div>
                                </div>
                            </div>
                        ` : ''}
                    </div>
                    <div class="flex-shrink-0">
                        <ion-icon name="checkmark-circle" class="text-green-600 text-lg"></ion-icon>
                    </div>
                </div>
            `;
            
            html += `
                    </div>
                    <div class="mt-4 p-3 bg-yellow-50 rounded-lg border border-yellow-200">
                        <div class="flex items-center text-yellow-800 text-sm">
                            <ion-icon name="information-circle" class="mr-2 flex-shrink-0"></ion-icon>
                            <span>เส้นทางแบบ Round Trip ที่คำนวณจากระยะทางจริงบนถนนและใช้อัลกอริธึม TSP</span>
                        </div>
                    </div>
                </div>
            `;
            
            routeInfo.innerHTML = html;
            resultsContainer.classList.remove('hidden');
        }
        
        // เคลียร์ลบเส้นทางออกจากแผนที่
        function clearRoute() {
            // ลบ routing control layer
            if (routeLayer) {
                try {
                    map.removeControl(routeLayer); // ใช้ removeControl แทน removeLayer
                } catch (e) {
                    console.warn('Error removing route layer:', e);
                }
                routeLayer = null;
            }
            
            // ลบ custom markers ทั้งหมด
            routeMarkers.forEach(marker => {
                try {
                    map.removeLayer(marker);
                } catch (e) {
                    console.warn('Error removing marker:', e);
                }
            });
            routeMarkers = [];
            
            // ซ่อนผลลัพธ์
            document.getElementById('routeResults').classList.add('hidden');
            
            // ล้าง distance matrix cache
            distanceMatrix = {};

            // ล้างข้อมูลการวิเคราะห์
            optimizedRoutePoints = [];
            routeAnalysisData = null;
        }
        
        // ล้างจุดทั้งหมดที่ม
        function clearAllPoints() {
            Swal.fire({
                title: 'ต้องการล้างจุดทั้งหมดหรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'ล้างทั้งหมด',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    selectedPoints = [];
                    
                    markers.forEach(marker => {
                        map.removeLayer(marker);
                    });
                    markers = [];
                    
                    clearRoute();
                    
                    updatePointsList();
                    updateButtons();
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'ล้างข้อมูลเรียบร้อย',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            });
        }
        
        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            setupEnhancedSearch();
            
            document.getElementById('analyzeBtn').addEventListener('click', analyzeRoute);
            document.getElementById('clearBtn').addEventListener('click', clearAllPoints);
            
            updateButtons();
        });

        // ฟังก์ชันบันทึกเส้นทาง
        async function saveCurrentRoute() {
            // ตรวจสอบว่ามีการวิเคราะห์เส้นทางแล้วหรือไม่
            if (!routeAnalysisData || optimizedRoutePoints.length < 2) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่สามารถบันทึกได้',
                    text: 'กรุณาวิเคราะห์เส้นทางก่อนบันทึก',
                    confirmButtonText: 'ตกลง'
                });
                return;
            }
            
            // ให้ผู้ใช้ตั้งชื่อเส้นทาง
            const { value: formValues } = await Swal.fire({
                title: 'บันทึกเส้นทาง',
                html: `
                    <div class="text-left space-y-6 p-1">
                        <!-- Route Name Input -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-800">
                                ชื่อเส้นทาง 
                                <span class="text-red-500">*</span>
                            </label>
                            <input 
                                id="routeName" 
                                type="text"
                                class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none text-gray-800 placeholder-gray-400" 
                                placeholder="เช่น เส้นทางเก็บขยะเขต 1"
                            >
                        </div>

                        <!-- Notes Textarea -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-800">
                                หมายเหตุ 
                                <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                            </label>
                            <textarea 
                                id="routeNote" 
                                rows="3"
                                class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none text-gray-800 placeholder-gray-400 resize-none" 
                                placeholder="เพิ่มหมายเหตุเพิ่มเติมเกี่ยวกับเส้นทางนี้..."
                            ></textarea>
                        </div>

                        <!-- Route Analysis Info Card -->
                        <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 shadow-sm">
                            <div class="p-5">
                                <!-- Header -->
                                <div class="flex items-center gap-2 mb-4">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                    </svg>
                                    <h3 class="font-semibold text-blue-900">ข้อมูลเส้นทางที่วิเคราะห์แล้ว</h3>
                                </div>

                                <!-- Stats Grid -->
                                <div class="grid grid-cols-1 gap-3 mb-4">
                                    <!-- Points -->
                                    <div class="flex items-center gap-3 bg-white/60 backdrop-blur-sm rounded-lg p-3 border border-blue-100/50">
                                        <div class="flex-shrink-0 w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            </svg>
                                        </div>
                                        <div class="flex-1">
                                            <div class="text-xs text-gray-600 font-medium">จำนวนจุด</div>
                                            <div class="text-lg font-bold text-gray-900">${optimizedRoutePoints.length} <span class="text-sm font-normal text-gray-600">จุด</span></div>
                                        </div>
                                    </div>

                                    <!-- Distance -->
                                    <div class="flex items-center gap-3 bg-white/60 backdrop-blur-sm rounded-lg p-3 border border-blue-100/50">
                                        <div class="flex-shrink-0 w-10 h-10 bg-indigo-500 rounded-lg flex items-center justify-center">
                                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                            </svg>
                                        </div>
                                        <div class="flex-1">
                                            <div class="text-xs text-gray-600 font-medium">ระยะทาง</div>
                                            <div class="text-lg font-bold text-gray-900">${routeAnalysisData.totalDistance.toFixed(2)} <span class="text-sm font-normal text-gray-600">กม.</span></div>
                                        </div>
                                    </div>

                                    <!-- Duration -->
                                    <div class="flex items-center gap-3 bg-white/60 backdrop-blur-sm rounded-lg p-3 border border-blue-100/50">
                                        <div class="flex-shrink-0 w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center">
                                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        </div>
                                        <div class="flex-1">
                                            <div class="text-xs text-gray-600 font-medium">เวลาโดยประมาณ</div>
                                            <div class="text-lg font-bold text-gray-900">${Math.round(routeAnalysisData.totalDuration)} <span class="text-sm font-normal text-gray-600">นาที</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'บันทึก',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#3B82F6',
                preConfirm: () => {
                    const routeName = document.getElementById('routeName').value;
                    const routeNote = document.getElementById('routeNote').value;
                    
                    if (!routeName) {
                        Swal.showValidationMessage('กรุณากรอกชื่อเส้นทาง');
                        return false;
                    }
                    
                    return {
                        routeName: routeName,
                        routeNote: routeNote
                    };
                }
            });
            
            // ถ้ายกเลิก
            if (!formValues) return;
            
            // แสดงสถานะกำลังบันทึก
            Swal.fire({
                title: 'กำลังบันทึก...',
                html: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            try {
                // เตรียมข้อมูลที่จะส่ง - ใช้เส้นทางที่วิเคราะห์แล้ว
                const routeData = {
                    routeName: formValues.routeName,
                    points: optimizedRoutePoints.map((point, index) => ({
                        pointNumber: index + 1,
                        lat: point.lat,
                        lng: point.lng,
                        address: point.address
                    })),
                    totalDistance: routeAnalysisData.totalDistance,
                    totalDuration: routeAnalysisData.totalDuration,
                    note: formValues.routeNote || ''
                };
                
                // ส่งข้อมูลไปยัง server
                const response = await fetch('/employee/routes/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(routeData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ!',
                        text: result.message,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    }).then(() => {
                        // ถามว่าต้องการดูรายการเส้นทางหรือไม่
                        Swal.fire({
                            title: 'ดูรายการเส้นทาง?',
                            text: 'ต้องการไปยังหน้ารายการเส้นทางที่บันทึกหรือไม่',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'ไปดู',
                            cancelButtonText: 'อยู่หน้านี้',
                            confirmButtonColor: '#3B82F6'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/employee/routeList';
                            }
                        });
                    });
                } else {
                    throw new Error(result.message);
                }
                
            } catch (error) {
                console.error('Error saving route:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถบันทึกเส้นทางได้',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#EF4444'
                });
            }
        }

        // ฟังก์ชันคำนวณระยะทางรวม (ถ้ายังไม่มี)
        function calculateTotalDistance() {
            if (selectedPoints.length < 2) return 0;
            
            let totalDist = 0;
            for (let i = 0; i < selectedPoints.length - 1; i++) {
                const dist = calculateStraightLineDistance(selectedPoints[i], selectedPoints[i + 1]);
                totalDist += dist;
            }
            // รวมระยะทางกลับจุดเริ่มต้น
            if (selectedPoints.length > 0) {
                totalDist += calculateStraightLineDistance(
                    selectedPoints[selectedPoints.length - 1], 
                    selectedPoints[0]
                );
            }
            return totalDist.toFixed(2);
        }

        // ฟังก์ชันคำนวณเวลารวม (ถ้ายังไม่มี)
        function calculateTotalDuration() {
            const distance = parseFloat(calculateTotalDistance());
            const avgSpeed = 40; // ความเร็วเฉลี่ย 40 กม./ชม.
            return Math.round((distance / avgSpeed) * 60); // แปลงเป็นนาที
        }

        // อัปเดต updateButtons() เพื่อเปิด/ปิดปุ่มบันทึก
        function updateButtons() {
            const analyzeBtn = document.getElementById('analyzeBtn');
            const clearBtn = document.getElementById('clearBtn');
            const saveRouteBtn = document.getElementById('saveRouteBtn');
            
            analyzeBtn.disabled = selectedPoints.length < 2;
            clearBtn.disabled = selectedPoints.length === 0;
            
            // ปุ่มบันทึกจะเปิดได้ก็ต่อเมื่อวิเคราะห์เส้นทางแล้วเท่านั้น
            if (saveRouteBtn) {
                saveRouteBtn.disabled = !routeAnalysisData || optimizedRoutePoints.length < 2;
            }
        }
    </script>

</body>
</html>