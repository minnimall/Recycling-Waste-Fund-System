    <style>
        .content {
            margin-left: 0;
            padding: 20px;
        }
        .search-loading {
            display: none;
        }
        .search-loading.active {
            display: inline-block;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>

<body>

    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <main class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ระบบแผนที่จุดรับซื้อขยะรีไซเคิล
                    </h1>
                    <p class="text-gray-600 mt-2">เลือกจุดรับซื้อและวิเคราะห์เส้นทางที่สั้นที่สุด</p>
                </div>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Control Panel -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4">
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">
                            <ion-icon name="location-outline" class="inline-block mr-2"></ion-icon>
                            ค้นหาและเลือกจุด
                        </h2>
                        
                        <!-- Enhanced Search Input -->
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">ค้นหาที่อยู่</label>
                            <div class="relative">
                                <input type="text" 
                                    id="searchInput" 
                                    class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent pr-12" 
                                    placeholder="เช่น ขอนแก่น, มหาวิทยาลัยขอนแก่น, ตลาดเซ็นทรัล...">
                                <button id="searchBtn" 
                                        class="absolute right-2 top-2 p-2 text-blue-600 hover:text-blue-800 transition-colors">
                                    <ion-icon name="search-outline" class="search-icon"></ion-icon>
                                    <ion-icon name="refresh-outline" class="search-loading"></ion-icon>
                                </button>
                            </div>
                            <!-- Search suggestions -->
                            <div id="searchSuggestions" class="mt-2 hidden">
                                <div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                    <!-- Suggestions will be populated here -->
                                </div>
                            </div>
                        </div>

                        <!-- Quick Location Buttons -->
                        <!-- <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">สถานที่ใกล้เคียง</label>
                            <div class="grid grid-cols-2 gap-2">
                                <button class="quick-location-btn bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs py-2 px-3 rounded-lg border border-blue-200 transition-colors" data-search="ขอนแก่น">
                                    เมืองขอนแก่น
                                </button>
                                <button class="quick-location-btn bg-green-50 hover:bg-green-100 text-green-700 text-xs py-2 px-3 rounded-lg border border-green-200 transition-colors" data-search="มหาวิทยาลัยขอนแก่น">
                                    มข.
                                </button>
                                <button class="quick-location-btn bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs py-2 px-3 rounded-lg border border-purple-200 transition-colors" data-search="สนามบินขอนแก่น">
                                    สนามบิน
                                </button>
                                <button class="quick-location-btn bg-orange-50 hover:bg-orange-100 text-orange-700 text-xs py-2 px-3 rounded-lg border border-orange-200 transition-colors" data-search="ตลาดเซ็นทรัลขอนแก่น">
                                    เซ็นทรัล
                                </button>
                            </div>
                        </div> -->

                        <!-- Selected Points List -->
                        <div class="mb-4">
                            <h3 class="text-lg font-medium text-gray-700 mb-2">จุดที่เลือก</h3>
                            <div id="selectedPointsList" class="space-y-2 max-h-60 overflow-y-auto">
                                <div class="text-gray-500 text-center py-4 text-sm">ยังไม่มีจุดที่เลือก</div>
                            </div>
                        </div>

                        <!-- Control Buttons -->
                        <div class="space-y-3">
                            <button id="analyzeBtn" 
                                    class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed" 
                                    disabled>
                                <ion-icon name="analytics-outline" class="inline-block mr-2"></ion-icon>
                                วิเคราะห์เส้นทาง
                            </button>
                            
                            <button id="clearBtn" 
                                    class="w-full bg-red-600 text-white py-3 px-4 rounded-lg hover:bg-red-700 transition">
                                <ion-icon name="trash-outline" class="inline-block mr-2"></ion-icon>
                                ล้างจุดทั้งหมด
                            </button>
                        </div>

                        <!-- Route Analysis Results -->
                        <div id="routeResults" class="mt-6 hidden">
                            <h3 class="text-lg font-medium text-gray-700 mb-3">ผลการวิเคราะห์</h3>
                            <div id="routeInfo" class="bg-blue-50 p-4 rounded-lg text-sm">
