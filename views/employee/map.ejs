    </main>
    
    <script>
        // Global variables
        let map;
        let selectedPoints = [];
        let markers = [];
        let routeLayer = null;
        let routeMarkers = [];
        let distanceMatrix = {};
        let isCalculatingDistances = false;
        let searchTimeout = null;
        let optimizedRoutePoints = []; // เก็บจุดที่วิเคราะห์แล้ว
        let routeAnalysisData = null; // เก็บข้อมูลการวิเคราะห์
        
        // Initialize map ส่วนแสดงแผนที่
        function initMap() {
            // set จุดเริ่มหน้าแมพเป็น อบต.ขามป้อม
            const initialLat = 15.948741697876695;
            const initialLng = 102.85523133360921;
            
            map = L.map('map').setView([initialLat, initialLng], 15); // ตัวเลขมันคือระยะการซูม
            
            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            
            // Add click event to map  กดคลิ๊กบนแผนที่
            map.on('click', function(e) { 
                const lat = e.latlng.lat;  // เก็บละติจูด
                const lng = e.latlng.lng;  // เก็บลองติจูด
                
                // Show loading for reverse geocoding
                const loadingPopup = L.popup()
                    .setLatLng(e.latlng)
                    .setContent('<div class="text-center"><ion-icon name="refresh-outline" class="animate-spin"></ion-icon> กำลังหาที่อยู่...</div>')
                    .openOn(map);
                
                // Reverse geocoding to get address แปลงพิกัด (ละติจูด, ลองจิจูด) ให้กลายเป็นที่อยู่จริง (ข้อความ)
                reverseGeocode(lat, lng).then(address => { // ค้นหาสำเร็จ address คือตัวแปรที่เก็บค่าที่อยู่ที่ได้จาก API เช่น "ตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น"
                    map.closePopup(loadingPopup);
                    addPoint(lat, lng, address); // โดยส่งค่าพิกัดเดิม (lat, lng) และที่อยู่ที่ค้นหามาได้ (address) เข้าไป เพื่อนำไปสร้างหมุด (Marker) บนแผนที่และเพิ่มข้อมูลจุดลงในรายการ
                }).catch(error => {
                    map.closePopup(loadingPopup);
                    const fallbackAddress = `จุดที่ ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                    addPoint(lat, lng, fallbackAddress);
                });
            });
        }
        
        // Enhanced reverse geocoding ส่วนที่เอาไว้ดึงชื่อสถานที่/ที่อยู่ จากพิกัด lat/lng
        async function reverseGeocode(lat, lng) {
            try {
                // เรียก API ของ Nominatim (OpenStreetMap) ค้นหาข้อมูลทางภูมิศาสตร์ โดย Geocoding (การแปลงชื่อเป็นพิกัด) และ Reverse Geocoding (การแปลงพิกัดเป็นที่อยู่)
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1&accept-language=th`);
                const data = await response.json(); // แปลงผลลัพธ์เป็น JSON
                
                if (data && data.display_name) { // ถ้ามี display_name → return ที่อยู่
                    return data.display_name;
                } else {
                    throw new Error('No address found');
                }
            } catch (error) { // ถ้า error (เช่น ไม่มีเน็ต หรือ API ไม่ตอบ) → แสดง lat/lng แทน
                console.warn('Reverse geocoding failed:', error);
                return `จุดที่ ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
            }
        }
        
        // Enhanced search functionality ค้นหาสถานที่จากข้อความ (query) ที่ผู้ใช้กรอก
        async function performSearch(query, showPopup = true) {
            if (!query || query.trim().length < 2) {
                if (showPopup) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาใส่ข้อความค้นหา',
                        text: 'กรุณาใส่อย่างน้อย 2 ตัวอักษร',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                return;
            }
            
            // Show loading state
            const searchBtn = document.getElementById('searchBtn');
            const searchIcon = searchBtn.querySelector('.search-icon');
            const loadingIcon = searchBtn.querySelector('.search-loading');
            
            searchIcon.style.display = 'none';
            loadingIcon.style.display = 'inline-block';
            loadingIcon.classList.add('active');
            searchBtn.disabled = true;
            
            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    html: `กำลังค้นหา "${query}"`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }
            
            try {
                // Enhanced search with multiple sources ค้นหาจากหลายแหล่ง (Multiple Sources)
                const results = await searchMultipleSources(query); // ตรงนี้จะไปหาผลลัพธ์จาก API ต่าง ๆ เช่น Nominatim, Google, หรือฐานข้อมูลภายใน
                
                if (showPopup) {
                    Swal.close();
                }
                
                // Reset button state
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (results.length > 0) {
                    if (results.length === 1) {
                        // Single result - add directly
                        const result = results[0];
                        map.setView([result.lat, result.lng], 15);
                        addPoint(result.lat, result.lng, result.display_name);
                        document.getElementById('searchInput').value = '';
                    } else {
                        // Multiple results - show selection
                        showSearchResults(results);
                    }
                } else {
                    if (showPopup) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่พบผลการค้นหา',
                            html: `
                                <div class="text-left">
                                    <p class="mb-2">ไม่พบสถานที่ที่ค้นหา "${query}"</p>
                                    <p class="text-sm text-gray-600">ลองใช้คำค้นหาอื่น เช่น:</p>
                                    <ul class="text-sm text-gray-600 mt-1 ml-4">
                                        <li>• ชื่อเมือง: "ขอนแก่น"</li>
                                        <li>• ชื่อสถานที่: "มหาวิทยาลัยขอนแก่น"</li>
                                        <li>• ชื่อถนน: "ถนนมิตรภาพ"</li>
                                    </ul>
                                </div>
                            `,
                            timer: 5000,
                            confirmButtonText: 'ตกลง'
                        });
                    }
                }
            } catch (error) {
                console.error('Search error:', error);
                
                // Reset button state
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (showPopup) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถค้นหาได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง',
                        timer: 3000
                    });
                }
            }
        }
        
        // Search from multiple sources ค้นหาจากหลายแหล่ง
        async function searchMultipleSources(query) {
            const results = [];
            
            try {
                // Nominatim search with Thai language preference
                const nominatimUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5&addressdetails=1&accept-language=th,en&countrycodes=th`;
                
                
                const response = await fetch(nominatimUrl);
                const data = await response.json(); //แปลงผลลัพธ์เป็น JSON เก็บไว้ใน data
                
                if (data && data.length > 0) { // จะเก็บผลลัพธ์พวก lat long "ถนนมิตรภาพ, เมืองขอนแก่น, ขอนแก่น, ประเทศไทย" type: "road", เก็บใน result 
                    data.forEach(item => {
                        if (item.lat && item.lon) { // ส่งกลับ array ที่ประกอบด้วย lat/lng + ชื่อ + type
                            results.push({
                                lat: parseFloat(item.lat),
                                lng: parseFloat(item.lon),
                                display_name: item.display_name,
                                type: item.type || 'location',
                                importance: parseFloat(item.importance || 0)
                            });
                        }
                    });
                }
                
                // จัดเรียงผลลัพธ์ตาม ความสำคัญ (importance) เช่น ถนนใหญ่หรือจังหวัด → คะแนนสูงกว่า
                results.sort((a, b) => (b.importance || 0) - (a.importance || 0));
                
                return results.slice(0, 5); // ส่งกลับแค่ 5 อันดับแรก ที่สำคัญที่สุด
                
            } catch (error) {
                console.error('Search sources error:', error);
                throw error;
            }
        }
        
        // Show search results for selection แสดงผลลัพธ์การค้นหาแบบเลือก เจอผลลัพธ์หลายรายการ (เช่น ค้นหา “ถนนมิตรภาพ” แล้วเจอหลายตำแหน่ง)
        function showSearchResults(results) {
            const suggestionsDiv = document.getElementById('searchSuggestions');
            let html = '';
            
            results.forEach((result, index) => { //สร้าง กล่องแต่ละรายการ จากผลลัพธ์การค้นหา เก็บข้อมูลจริงไว้ใน data-* attribute (data-lat, data-lng, data-name) เพื่อใช้ตอนกดเลือก
                html += `
                    <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0" 
                        data-lat="${result.lat}" data-lng="${result.lng}" data-name="${result.display_name}">
                        <div class="font-medium text-gray-800 text-sm">${result.display_name}</div>
                        <div class="text-xs text-gray-500 mt-1">
                            <ion-icon name="location-outline" class="text-blue-500"></ion-icon>
                            ${result.lat.toFixed(4)}, ${result.lng.toFixed(4)}
                        </div>
                    </div>
                `;
            });
            
            suggestionsDiv.innerHTML = `<div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">${html}</div>`;
            suggestionsDiv.classList.remove('hidden');
            
            // Add click handlers
            suggestionsDiv.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);
                    const name = this.dataset.name;
                    
                    map.setView([lat, lng], 15); // ขยับแผนที่ไปที่พิกัดนั้น
                    addPoint(lat, lng, name); // เพิ่มจุดลงบนแผนที่ (และเก็บข้อมูลสำหรับเส้นทาง)
                    
                    document.getElementById('searchInput').value = '';
                    suggestionsDiv.classList.add('hidden'); // เคลียร์ช่องค้นหา และซ่อน suggestion list
                });
            });
            
            // Hide suggestions when clicking outside
            document.addEventListener('click', function(event) {
                if (!suggestionsDiv.contains(event.target) && !document.getElementById('searchInput').contains(event.target)) {
                    suggestionsDiv.classList.add('hidden');
                }
            });
        }
        
        // Setup enhanced search ระบบจัดการการค้นหาแบบครบวงจร
        function setupEnhancedSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const suggestionsDiv = document.getElementById('searchSuggestions');
            
            // Main search function
            function doSearch() {
                const query = searchInput.value.trim();
                performSearch(query, true);
            }
            
            // Search button click
            searchBtn.addEventListener('click', doSearch);
            
            // Enter key press
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    doSearch();
                    suggestionsDiv.classList.add('hidden');
                }
            });
            
            // Auto-suggest on input (with debouncing)
            searchInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                // Clear previous timeout
                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }
                
                if (query.length >= 2) {
                    // Debounce search requests
                    searchTimeout = setTimeout(() => {
                        performSearch(query, false).then(() => {
                            // Auto-suggestions handled in performSearch
                        });
                    }, 500);
                } else {
                    suggestionsDiv.classList.add('hidden');
                }
            });
            
            // Quick location buttons
            document.querySelectorAll('.quick-location-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const searchQuery = this.dataset.search;
                    searchInput.value = searchQuery;
                    performSearch(searchQuery, true);
                });
            });
            
            // Clear input when map is clicked
            map.on('click', function() {
                suggestionsDiv.classList.add('hidden');
            });
        }
        
        // Add point to selected points t  ไว้เพิ่มจุดตอนผู้ใช้คลิ๊กบนแผนที่
        function addPoint(lat, lng, address) {
            const pointNumber = selectedPoints.length + 1; // จะได้ลำดับที่ของจุด เช่น จุดแรก = 1, จุดถัดไป = 2, …
            const point = {
                id: pointNumber,
