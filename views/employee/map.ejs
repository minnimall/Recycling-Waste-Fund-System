        // --------- การค้นหาสถานที่ ---------- ( 762 ถึง 973)

        // เพิ่มระบบค้นหาที่อยู่แบบอัจฉริยะ (Enhanced Search) ที่จะช่วยแนะนำผลการค้นหาและรองรับการค้นหาที่หลากหลายมากขึ้น
        function setupEnhancedSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const suggestionsDiv = document.getElementById('searchSuggestions');

            const autocompleteService = new google.maps.places.AutocompleteService();
            const placesService = new google.maps.places.PlacesService(map);

            let searchTimeout = null;

            // พิมพ์แล้ว suggest อัตโนมัติ
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                const query = this.value.trim();

                if (query.length < 2) {
                    suggestionsDiv.classList.add('hidden');
                    return;
                }

                searchTimeout = setTimeout(() => {
                    autocompleteService.getPlacePredictions({
                        input: query,
                        location: new google.maps.LatLng(15.9487, 102.8552),
                        radius: 50000,
                        language: 'th'
                    }, (predictions, status) => {
                        if (status !== google.maps.places.PlacesServiceStatus.OK || !predictions) {
                            suggestionsDiv.classList.add('hidden');
                            return;
                        }
                        renderSuggestions(predictions, placesService);
                    });
                }, 300);
            });

            // กด Enter หรือปุ่ม search
            function doSearch() {
                const query = searchInput.value.trim();
                if (!query) return;

                autocompleteService.getPlacePredictions({
                    input: query,
                    location: new google.maps.LatLng(15.9487, 102.8552),
                    radius: 50000,
                    language: 'th'
                }, (predictions, status) => {
                    if (status === google.maps.places.PlacesServiceStatus.OK && predictions?.length > 0) {
                        selectPlace(predictions[0].place_id, predictions[0].description, placesService);
                    }
                });
            }

            searchBtn.addEventListener('click', doSearch);
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') { doSearch(); suggestionsDiv.classList.add('hidden'); }
            });

            // ปิด dropdown เมื่อคลิกนอก
            document.addEventListener('click', (e) => {
                if (!suggestionsDiv.contains(e.target) && e.target !== searchInput) {
                    suggestionsDiv.classList.add('hidden');
                }
            });

            function renderSuggestions(predictions, placesService) {
                let html = `<div class="py-1">`;

                predictions.forEach((pred, index) => {
                    // แยกชื่อสถานที่ vs ที่อยู่
                    const mainText = pred.structured_formatting?.main_text || pred.description;
                    const secondaryText = pred.structured_formatting?.secondary_text || '';

                    // ไอคอนตามประเภท
                    const icon = pred.types?.includes('establishment')
                        ? `<div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <ion-icon name="business-outline" class="text-blue-500 text-sm"></ion-icon>
                        </div>`
                        : `<div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <ion-icon name="location-outline" class="text-gray-500 text-sm"></ion-icon>
                        </div>`;

                    html += `
                        <div class="suggestion-item flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-blue-50 transition-colors duration-150 border-b border-gray-50 last:border-b-0"
                            data-place-id="${pred.place_id}"
                            data-description="${pred.description}">
                            ${icon}
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-medium text-gray-800 truncate">${mainText}</div>
                                ${secondaryText ? `<div class="text-xs text-gray-400 truncate mt-0.5">${secondaryText}</div>` : ''}
                            </div>
                            <ion-icon name="arrow-forward-outline" class="text-gray-300 text-sm flex-shrink-0"></ion-icon>
                        </div>
                    `;
                });

                html += `
                    <div class="px-4 py-2 flex items-center justify-end gap-1 border-t border-gray-100">
                        <span class="text-xs text-gray-400">Powered by</span>
                        <img src="https://developers.google.com/static/maps/documentation/images/google_on_white.png" 
                            class="h-3" alt="Google">
                    </div>
                </div>`;

                suggestionsDiv.innerHTML = `
                    <div class="bg-white border border-gray-200 rounded-xl shadow-xl overflow-hidden mt-1">
                        ${html}
                    </div>`;
                suggestionsDiv.classList.remove('hidden');

                // Event listener สำหรับแต่ละ item
                suggestionsDiv.querySelectorAll('.suggestion-item').forEach(item => {
                    item.addEventListener('click', function () {
                        selectPlace(this.dataset.placeId, this.dataset.description, placesService);
                    });
                });
            }

            function selectPlace(placeId, description, placesService) {
                placesService.getDetails({
                    placeId: placeId,
                    fields: ['geometry', 'formatted_address', 'name']
                }, (place, status) => {
                    if (status === google.maps.places.PlacesServiceStatus.OK && place.geometry) {
                        const lat = place.geometry.location.lat();
                        const lng = place.geometry.location.lng();
                        const name = place.formatted_address || place.name || description;

                        map.setCenter({ lat, lng });
                        map.setZoom(15);
                        addPoint(lat, lng, name, null);

                        searchInput.value = '';
                        suggestionsDiv.classList.add('hidden');
                    }
                });
            }
        }

        // ควบคุมระบบการค้นหา
        async function performSearch(query, showPopup = true) {
            if (!query || query.trim().length < 2) {
                if (showPopup) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาใส่ข้อความค้นหา',
                        text: 'กรุณาใส่อย่างน้อย 2 ตัวอักษร',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                return;
            }
            
            const searchBtn = document.getElementById('searchBtn');
            const searchIcon = searchBtn.querySelector('.search-icon');
            const loadingIcon = searchBtn.querySelector('.search-loading');
            
            searchIcon.style.display = 'none';
            loadingIcon.style.display = 'inline-block';
            loadingIcon.classList.add('active');
            searchBtn.disabled = true;
            
            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    html: `กำลังค้นหา "${query}"`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }
            
            try {
                const results = await searchWithGoogle(query);
                
                if (showPopup) {
                    Swal.close();
                }
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (results.length > 0) {
                    showSearchResults(results);
                } else {
                    if (showPopup) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่พบผลการค้นหา',
                            html: `
                                <div class="text-left">
                                    <p class="mb-2">ไม่พบสถานที่ที่ค้นหา "${query}"</p>
                                    <p class="text-sm text-gray-600">ลองใช้คำค้นหาอื่น</p>
                                </div>
                            `,
                            timer: 5000,
                            confirmButtonText: 'ตกลง'
                        });
                    }
                }
            } catch (error) {
                console.error('Search error:', error);
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (showPopup) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถค้นหาได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง',
                        timer: 3000
                    });
                }
            }
        }

        // ส่วนการค้นหาสถานที่ที่จะนำไปใช้กับ performSearch
        async function searchWithGoogle(query) {
            return new Promise((resolve, reject) => {
                const request = {
                    query: query,
                    location: { lat: 15.9487, lng: 102.8552 },
                    radius: 50000,
                    fields: ['name', 'geometry', 'formatted_address']
                };
                
                const service = new google.maps.places.PlacesService(map);
                
                service.textSearch(request, (results, status) => {
                    if (status === google.maps.places.PlacesServiceStatus.OK && results) {
                        const formatted = results.slice(0, 5).map(place => ({
                            lat: place.geometry.location.lat(),
                            lng: place.geometry.location.lng(),
                            display_name: place.formatted_address || place.name,
                            name: place.name
                        }));
                        resolve(formatted);
                    } else {
                        console.warn('Places API Status:', status);
                        resolve([]);
                    }
                });
            });
        }
        
        // แสดงรายการผลลัพธ์ใต้ช่องค้นหา
        function showSearchResults(results) {
            const suggestionsDiv = document.getElementById('searchSuggestions');
            let html = '';
            
            results.forEach((result, index) => {
                html += `
                    <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0" 
                        data-lat="${result.lat}" data-lng="${result.lng}" data-name="${result.display_name}">
                        <div class="font-medium text-gray-800 text-sm">${result.display_name}</div>
                        <div class="text-xs text-gray-500 mt-1">
                            <ion-icon name="location-outline" class="text-blue-500"></ion-icon>
                            ${result.lat.toFixed(4)}, ${result.lng.toFixed(4)}
                        </div>
                    </div>
                `;
            });
            
            suggestionsDiv.innerHTML = `<div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">${html}</div>`;
            suggestionsDiv.classList.remove('hidden');
            
            suggestionsDiv.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);
                    const name = this.dataset.name;
                    
                    map.setCenter({ lat: lat, lng: lng });
                    map.setZoom(15);
                    addPoint(lat, lng, name, null);
                    
                    document.getElementById('searchInput').value = '';
                    suggestionsDiv.classList.add('hidden');
                });
            });
            
            document.addEventListener('click', function(event) {
                if (!suggestionsDiv.contains(event.target) && !document.getElementById('searchInput').contains(event.target)) {
                    suggestionsDiv.classList.add('hidden');
                }
            });
        }

        // เอาตัวเลขพิกัด (Lat, Lng) ไปหา "ชื่อที่อยู่" หรือ "ชื่อสถานที่"
        async function reverseGeocode(lat, lng) {
            return new Promise((resolve) => {
                geocoder.geocode({ 
                    location: { lat, lng },
                    language: 'th'
                }, (results, status) => {
                    if (status === 'OK' && results.length > 0) {
                        // กรองเอาแบบที่ไม่ใช่ Plus Code
                        const filtered = results.find(r => 
                            !r.formatted_address.match(/^[A-Z0-9]{4}\+[A-Z0-9]{2,}/)
                        );
                        resolve(filtered ? filtered.formatted_address : results[0].formatted_address);
                    } else {
                        resolve(`${lat.toFixed(4)}, ${lng.toFixed(4)}`);
                    }
                });
            });
        }


