        // ควบคุมระบบการค้นหา
        async function performSearch(query, showPopup = true) {
            if (!query || query.trim().length < 2) {
                if (showPopup) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาใส่ข้อความค้นหา',
                        text: 'กรุณาใส่อย่างน้อย 2 ตัวอักษร',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                return;
            }
            
            const searchBtn = document.getElementById('searchBtn');
            const searchIcon = searchBtn.querySelector('.search-icon');
            const loadingIcon = searchBtn.querySelector('.search-loading');
            
            searchIcon.style.display = 'none';
            loadingIcon.style.display = 'inline-block';
            loadingIcon.classList.add('active');
            searchBtn.disabled = true;
            
            if (showPopup) {
                Swal.fire({
                    title: 'กำลังค้นหา...',
                    html: `กำลังค้นหา "${query}"`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }
            
            try {
                const results = await searchMultipleSources(query);
                
                if (showPopup) {
                    Swal.close();
                }
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (results.length > 0) {
                    showSearchResults(results);
                } else {
                    if (showPopup) {
                        Swal.fire({
                            icon: 'error',
                            title: 'ไม่พบผลการค้นหา',
                            html: `
                                <div class="text-left">
                                    <p class="mb-2">ไม่พบสถานที่ที่ค้นหา "${query}"</p>
                                    <p class="text-sm text-gray-600">ลองใช้คำค้นหาอื่น</p>
                                </div>
                            `,
                            timer: 5000,
                            confirmButtonText: 'ตกลง'
                        });
                    }
                }
            } catch (error) {
                console.error('Search error:', error);
                
                searchIcon.style.display = 'inline-block';
                loadingIcon.style.display = 'none';
                loadingIcon.classList.remove('active');
                searchBtn.disabled = false;
                
                if (showPopup) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถค้นหาได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง',
                        timer: 3000
                    });
                }
            }
        }
        
        // ส่วนการค้นหาสถานที่ที่จะนำไปใช้กับ performSearch
        async function searchMultipleSources(query) {
            const results = [];
            
            try {
                const nominatimUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5&addressdetails=1&accept-language=th,en&countrycodes=th`;
                
                const response = await fetch(nominatimUrl);
                const data = await response.json();
                
                if (data && data.length > 0) {
                    data.forEach(item => {
                        if (item.lat && item.lon) {
                            results.push({
                                lat: parseFloat(item.lat),
                                lng: parseFloat(item.lon),
                                display_name: item.display_name,
                                type: item.type || 'location',
                                importance: parseFloat(item.importance || 0)
                            });
                        }
                    });
                }
                
                results.sort((a, b) => (b.importance || 0) - (a.importance || 0));
                
                return results.slice(0, 5);
                
            } catch (error) {
                console.error('Search sources error:', error);
                throw error;
            }
        }
        
        // แสดงรายการผลลัพธ์ใต้ช่องค้นหา
