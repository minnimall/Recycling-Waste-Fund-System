        // ตัววาดเส้นบนแผนที่ วาดเส้นด้วย Directions API และจัดการ markers ใหม่ตามเส้นทางที่วิเคราะห์ได้
        async function displayOptimizedRoute(route) {
            try {
                clearRoute();
                
                // ซ่อน markers เดิมทั้งหมด
                markers.forEach(marker => {
                    marker.setVisible(false);
                });
                
                if (route.length < 2) {
