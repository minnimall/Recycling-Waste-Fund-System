<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>

    <script async
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCOj0SmyVA_9XcjvxjELwfzvO8LNN6uJgw&libraries=places,geometry&loading=async&callback=initMap">
    </script>
    
    <script>
        // ข้อมูล wasteSaleRequest จาก server
        const pendingRequests = <%- JSON.stringify(pendingRequests) %>;
        console.log('Pending requests:', pendingRequests);
    </script>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <main class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ระบบแผนที่จุดรับซื้อขยะรีไซเคิล
                    </h1>
                    <p class="text-gray-600 mt-2">เลือกจุดรับซื้อและวิเคราะห์เส้นทางที่สั้นที่สุด</p>
                </div>
                <div>
                    <a href="/employee/routeList"
                        class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition shadow-md">
                        <ion-icon name="list-outline" class="text-2xl mr-2"></ion-icon>
                        เส้นทางทั้งหมด
                    </a>
                </div>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Control Panel -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4 max-h-[calc(100vh-100px)] overflow-y-auto">
                        
                        <!-- Header -->
                        <div class="mb-6 pb-4 border-b border-gray-200">
                            <h2 class="text-xl font-bold text-gray-800 flex items-center">
                                <!-- <ion-icon name="settings-outline" class="text-2xl mr-2 text-blue-600"></ion-icon> -->
                                จัดการเส้นทาง
                            </h2>
                            <p class="text-sm text-gray-500 mt-1">เลือกจุดและวิเคราะห์เส้นทาง</p>
                        </div>

                        <!-- Step 1: Organization Start Point -->
                        <div class="mb-6">
                            <div class="flex items-center mb-3">
                                <div class="bg-blue-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm font-bold mr-2">1</div>
                                <h3 class="text-base font-semibold text-gray-800">กำหนดจุดเริ่มต้น</h3>
                            </div>
                            <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                                <label class="flex items-start cursor-pointer">
                                    <input type="checkbox" 
                                        id="useOrgStartPoint" 
                                        class="mt-0.5 mr-3 h-5 w-5 text-blue-600 rounded focus:ring-2 focus:ring-blue-500"
                                        onchange="toggleOrganizationStartPoint()">
                                    <div class="flex-1">
                                        <div class="font-medium text-gray-800 text-sm">เริ่มจาก อบต.ขามป้อม</div>
                                        <!-- <p class="text-xs text-gray-600 mt-1">15.9487, 102.8552</p> -->
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Step 2: Select Points -->
                        <div class="mb-6">
                            <div class="flex items-center mb-3">
                                <div class="bg-blue-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm font-bold mr-2">2</div>
                                <h3 class="text-base font-semibold text-gray-800">เลือกจุดรับซื้อ</h3>
                            </div>

                            <!-- 2.1 Waste Sale Requests -->
                            <div class="mb-4">
                                <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                                    <div class="flex justify-between items-center mb-3">
                                        <p class="text-sm font-medium text-gray-700 flex items-center">
                                            <ion-icon name="document-text-outline" class="mr-1"></ion-icon>
                                            คำขอขายขยะ
                                        </p>
                                        <span id="requestCountBadge" class="bg-blue-600 text-white text-xs px-2 py-1 rounded-full">
                                            <%= pendingRequests.length %> รายการ
                                        </span>
                                    </div>

                                    <!-- Date Filter -->
                                    <div class="mb-3 p-3 bg-white rounded-lg border border-blue-100">
                                        <label class="block text-xs font-medium text-gray-600 mb-1.5 flex items-center">
                                            <ion-icon name="calendar-outline" class="mr-1 text-blue-500"></ion-icon>
                                            กรองตามวันนัดรับซื้อ
                                        </label>
                                        <input type="date" id="dateFilter" 
                                            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-2"
                                            onchange="filterByDate()">
                                        <div class="flex gap-1.5">
                                            <button onclick="setDateFilter('today')" 
                                                class="flex-1 text-[10px] py-1.5 px-1 bg-blue-50 text-blue-700 rounded-md hover:bg-blue-100 transition font-medium border border-blue-200">
                                                วันนี้
                                            </button>
                                            <button onclick="setDateFilter('tomorrow')" 
                                                class="flex-1 text-[10px] py-1.5 px-1 bg-purple-50 text-purple-700 rounded-md hover:bg-purple-100 transition font-medium border border-purple-200">
                                                พรุ่งนี้
                                            </button>
                                            <button onclick="setDateFilter('all')" 
                                                class="flex-1 text-[10px] py-1.5 px-1 bg-gray-50 text-gray-700 rounded-md hover:bg-gray-100 transition font-medium border border-gray-200">
                                                ทั้งหมด
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <% if (pendingRequests.length > 0) { %>
                                        <div id="requestsList" class="space-y-2 max-h-60 overflow-y-auto mb-3">
                                            <% pendingRequests.forEach((request, index) => { %>
                                                <div class="request-item bg-white p-3 rounded-lg border border-gray-200 cursor-pointer hover:shadow-md transition"
                                                    data-request-id="<%= request._id %>"
                                                    data-lat="<%= request.latitude %>"
                                                    data-lng="<%= request.longitude %>"
                                                    data-location="<%= request.location %>"
                                                    data-family="<%= request.family ? (request.family.firstname + ' ' + request.family.lastname) : 'N/A' %>"
                                                    data-familyname="<%= request.family ? request.family.familyName : '' %>"
                                                    data-pickup-date="<%= request.approvePickupDate ? new Date(request.approvePickupDate).toISOString().split('T')[0] : '' %>"
                                                    onclick="toggleRequestSelection(this)">
                                                    <div class="flex items-start">
                                                        <input type="checkbox" 
                                                            class="request-checkbox mt-1 mr-2 h-4 w-4 text-blue-600 rounded"
                                                            onclick="event.stopPropagation();">
                                                        <div class="flex-1">
                                                            <div class="font-medium text-gray-800 text-sm">
                                                                <%= request.family ? (request.family.familyName) : 'ไม่ระบุชื่อ' %>
                                                            </div>
                                                            <div class="text-xs text-gray-600 mt-1 line-clamp-2">
                                                                <ion-icon name="location" class="text-red-500"></ion-icon>
                                                                <%= request.location ? (request.location.substring(0, 35) + (request.location.length > 35 ? '...' : '')) : 'ไม่ระบุที่อยู่' %>
                                                            </div>
                                                            <% if (request.approvePickupDate) { %>
                                                            <div class="text-xs mt-1 flex items-center gap-1">
                                                                <ion-icon name="calendar" class="text-blue-500"></ion-icon>
                                                                <span class="text-blue-600 font-medium">นัดรับ <%= new Date(request.approvePickupDate).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' }) %></span>
                                                            </div>
                                                            <% } else { %>
                                                            <div class="text-xs text-gray-400 mt-1">
                                                                <ion-icon name="calendar-outline" class="text-gray-400"></ion-icon>
                                                                ยังไม่กำหนดวันรับ
                                                            </div>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                        
                                        <div class="flex gap-2 mb-2">
                                            <button onclick="selectAllRequests()" 
                                                    class="flex-1 bg-blue-600 text-white text-xs py-2 px-2 rounded hover:bg-blue-700 transition">
                                                ทั้งหมด
                                            </button>
                                            <button onclick="deselectAllRequests()" 
                                                    class="flex-1 bg-gray-500 text-white text-xs py-2 px-2 rounded hover:bg-gray-600 transition">
                                                ยกเลิก
                                            </button>
                                        </div>
                                        
                                        <button onclick="addSelectedRequestsToMap()" 
                                                class="w-full bg-green-600 text-white text-sm py-2.5 px-4 rounded-lg hover:bg-green-700 transition font-medium">
                                            <ion-icon name="add-circle-outline" class="align-middle"></ion-icon>
                                            เพิ่มจุดที่เลือก
                                        </button>
                                    <% } else { %>
                                        <div class="text-center text-gray-400 py-6 text-sm">
                                            <ion-icon name="alert-circle-outline" class="text-3xl block mx-auto mb-2"></ion-icon>
                                            <p>ไม่มีคำขอขายขยะ</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- 2.2 Manual Search -->
                            <div class="">
                                <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                                    <ion-icon name="search-outline" class="mr-1"></ion-icon>
                                    หรือค้นหาที่อยู่
                                </label>
                                <div class="relative">
                                    <input type="text" 
                                        id="searchInput" 
                                        class="w-full p-2.5 pr-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" 
                                        placeholder="ค้นหาสถานที่...">
                                    <button id="searchBtn" 
                                            class="absolute right-2 top-2 p-1.5 text-blue-600 hover:text-blue-800 transition-colors">
                                        <ion-icon name="search-outline" class="search-icon text-lg"></ion-icon>
                                        <ion-icon name="refresh-outline" class="search-loading text-lg"></ion-icon>
                                    </button>
                                </div>
                                <div id="searchSuggestions" class="mt-2 hidden">
                                    <div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Selected Points Summary -->
                        <div class="mb-6">
                            <div class="flex items-center mb-3">
                                <div class="bg-blue-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm font-bold mr-2">3</div>
                                <h3 class="text-base font-semibold text-gray-800">จุดที่เลือกแล้ว</h3>
                            </div>
                            <div class="">
                                <div id="selectedPointsList" class="space-y-2 max-h-60 overflow-y-auto p-3 bg-gray-50 rounded-lg border border-gray-200">
                                    <div class="text-gray-400 text-center py-6 text-sm">
                                        <ion-icon name="location-outline" class="text-3xl block mx-auto mb-2"></ion-icon>
                                        <p>ยังไม่มีจุดที่เลือก</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 4: Actions -->
                        <div class="mb-6">
                            <div class="flex items-center mb-3">
                                <div class="bg-blue-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm font-bold mr-2">4</div>
                                <h3 class="text-base font-semibold text-gray-800">ดำเนินการ</h3>
                            </div>
                            <div class="flex flex-col gap-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <button id="analyzeBtn" 
                                            class="flex flex-col items-center justify-center gap-1 bg-green-600 text-white py-4 px-2 rounded-2xl hover:bg-green-500 active:scale-95 transition-all disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed shadow-sm">
                                        <ion-icon name="analytics-outline" class="text-2xl mb-1"></ion-icon>
                                        <span class="text-sm font-bold">วิเคราะห์เส้นทาง</span>
                                    </button>
                                    
                                    <button id="saveRouteBtn" 
                                            onclick="saveCurrentRoute()"
                                            class="flex flex-col items-center justify-center gap-1 bg-blue-600 text-white py-4 px-2 rounded-2xl hover:bg-blue-500 active:scale-95 transition-all disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed shadow-sm">
                                        <!-- <ion-icon name="save-outline" class="text-2xl mb-1"></ion-icon> -->
                                        <ion-icon name="bookmark-outline" class="text-2xl mb-1"></ion-icon>
                                        <span class="text-sm font-bold">บันทึกเส้นทาง</span>
                                    </button>
                                </div>

                                <button id="clearBtn" 
                                        class="w-full flex items-center justify-center gap-2 bg-gray-100 text-gray-600 py-3 px-4 rounded-xl hover:bg-red-600 hover:text-white transition-all duration-300 ease-in-out font-medium text-sm">
                                    <!-- <ion-icon name="trash-outline" class="text-lg"></ion-icon> -->
                                    <span class="text-sm font-bold">ล้างข้อมูลทั้งหมด</span>
                                </button>
                            </div>
                        </div>

                        <!-- Route Analysis Results -->
                        <div id="routeResults" class="hidden">
                            <div class="flex items-center mb-3">
                                <div class="bg-teal-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-sm font-bold mr-2">
                                    <ion-icon name="checkmark" class="text-lg"></ion-icon>
                                </div>
                                <h3 class="text-base font-semibold text-gray-800">ผลการวิเคราะห์</h3>
                            </div>
                            <div class="">
                                <div id="routeInfo" class="bg-blue-50 p-4 rounded-lg text-sm border border-blue-200">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Map Section -->
                <div class="lg:col-span-3">
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                        <!-- Map Header -->
                        <div class="bg-gradient-to-r from-green-600 to-green-700 p-4 text-white">
                            <h2 class="text-xl font-bold flex items-center">
                                <!-- <ion-icon name="map-outline" class="text-2xl mr-2"></ion-icon> -->
                                แผนที่เส้นทาง
                            </h2>
                            <p class="text-sm text-gray-100 mt-1">คลิกบนแผนที่เพื่อเพิ่มจุดเพิ่มเติม</p>
                        </div>

                        <!-- Info Banner -->
                        <div class="bg-blue-50 p-3 border-b border-blue-100">
                            <div class="flex items-start text-sm text-blue-800">
                                <ion-icon name="information-circle" class="text-xl mr-2 flex-shrink-0 mt-0.5"></ion-icon>
                                <div>
                                    <p class="font-medium mb-1">วิธีใช้งาน:</p>
                                    <ul class="text-xs space-y-0.5 text-blue-700">
                                        <li>• เลือกจุดเริ่มต้น (ถ้าต้องการ)</li>
                                        <li>• เลือกคำขอขายขยะหรือค้นหาสถานที่</li>
                                        <li>• กดวิเคราะห์เส้นทางเมื่อเลือกครบแล้ว</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Map -->
                        <div id="map" class="w-full h-96 lg:h-[600px] z-0"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
