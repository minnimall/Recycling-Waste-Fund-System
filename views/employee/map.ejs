        // ฟังก์ชันสำหรับวาดพื้นที่ตำบลขามป้อม
        function drawTambolPolygon() {
            tambolPolygon = new google.maps.Polygon({
                paths: KHAMPO_POLYGON_COORDS,
                strokeColor: '#2563EB',
                strokeOpacity: 0.8,
                strokeWeight: 2.5,
                fillColor: '#3B82F6',
                fillOpacity: 0.08,
                map: map,
                zIndex: 0,
                clickable: false
            });

            // fitBounds แล้วค่อย set zoom ทีหลัง
            const bounds = new google.maps.LatLngBounds();
            KHAMPO_POLYGON_COORDS.forEach(coord => bounds.extend(coord));
            map.fitBounds(bounds);
            
            // บังคับ zoom หลัง fitBounds
            google.maps.event.addListenerOnce(map, 'bounds_changed', function() {
                map.setZoom(13); // ปรับตัวเลขนี้ได้เลยครับ
            });
        }

        // ฟังก์ชันตรวจสอบว่าจุดที่เลือกอยู่ภายในพื้นที่ตำบลขามป้อมหรือไม่
        function isWithinTambol(lat, lng) {
            if (!tambolPolygon) return true; // ถ้า polygon ไม่พร้อมให้ผ่านไปก่อน
            
            const point = new google.maps.LatLng(lat, lng);
            const result = google.maps.geometry.poly.containsLocation(point, tambolPolygon);
            
            // Debug: ดูว่า polygon center อยู่ที่ไหน
            const bounds = new google.maps.LatLngBounds();
            KHAMPO_POLYGON_COORDS.forEach(c => bounds.extend(c));
            console.log('📐 Polygon center:', bounds.getCenter().toString());
            console.log(`📍 จุดที่คลิก: lat:${lat}, lng:${lng}`);
            
            return result;
        }

