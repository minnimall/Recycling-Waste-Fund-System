                    <div class="flex-shrink-0">
                        <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center shadow-lg border-2 border-white text-lg font-bold">
                            1
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-bold text-green-800 text-base">จุดเริ่มต้น</span>
                            ${isFromRequest ? '<span class="text-xs bg-green-600 text-white px-2 py-0.5 rounded">คำขอขายขยะ</span>' : ''}
                        </div>
                        <div class="font-medium text-gray-800 text-sm">${startPoint.address}</div>
                        <div class="text-xs text-gray-500 mt-1">
                            ${startPoint.lat.toFixed(4)}, ${startPoint.lng.toFixed(4)}
                        </div>
                        
                        ${firstSegment ? `
                            <div class="mt-2 p-2 bg-white rounded border-l-4 border-blue-400">
                                <div class="text-xs text-gray-700 font-medium mb-1">
                                    → ไปยังจุดที่ 2
                                </div>
                                <div class="grid grid-cols-2 gap-2 text-xs">
                                    <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-blue-600">${firstSegment.distance.toFixed(2)} กม.</span></div>
                                    <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-green-600">${Math.round(firstSegment.duration)} นาที</span></div>
                                </div>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;
            
            // แสดงจุดที่ 2 เป็นต้นไป (ข้ามจุดแรกเพราะแสดงไปแล้ว)
            for (let index = 1; index < route.length; index++) {
                const point = route[index];
                const segment = segments[index];
                const isLast = index === route.length - 1;
                const isFromRequest = point.requestId ? true : false;
                
                html += `
                    <div class="flex items-start space-x-3 p-3 bg-white rounded-lg border border-gray-200">
                        <div class="flex-shrink-0">
                            <div class="${isFromRequest ? 'bg-green-600' : 'bg-blue-600'} text-white rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold shadow-md">
                                ${index + 1}
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-800 text-sm">${point.address}</div>

                            <div class="text-xs text-gray-500 mt-1">
                                ${point.lat.toFixed(4)}, ${point.lng.toFixed(4)}
                            </div>

                            ${isFromRequest ? '<div class="text-xs text-green-600 mt-1">📋 จากคำขอขายขยะ</div>' : ''}
                            
                            ${!isLast && segment ? `
                                <div class="mt-2 p-2 bg-white rounded border-l-4 border-blue-400">
                                    <div class="text-xs text-gray-700 font-medium mb-1">
                                        → ไปยังจุดที่ ${index + 2}
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-blue-600">${segment.distance.toFixed(2)} กม.</span></div>
                                        <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-green-600">${Math.round(segment.duration)} นาที</span></div>
                                    </div>
                                </div>
                            ` : ''}

                            ${isLast && segments[index] ? `
                                <div class="mt-2 p-2 bg-red-50 rounded border-l-4 border-red-400">
                                    <div class="text-xs text-red-700 font-medium mb-1 flex items-center gap-1">
                                        <ion-icon name="return-down-back" class="text-base"></ion-icon>
                                        <span>กลับจุดเริ่มต้น</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div><span class="text-gray-600">ระยะทาง:</span> <span class="font-semibold text-red-600">${segments[index].distance.toFixed(2)} กม.</span></div>
                                        <div><span class="text-gray-600">เวลา:</span> <span class="font-semibold text-red-600">${Math.round(segments[index].duration)} นาที</span></div>
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `;
            }
            
            // ส่วนท้าย: แสดงจุดปิดท้าย (Endpoint)
            html += `
                        <div class="flex items-start space-x-3 p-4 bg-gradient-to-r from-green-50 to-green-100 rounded-lg border-2 border-green-400 shadow-md">
                            <div class="flex-shrink-0">
                                <div class="bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center shadow-lg border-2 border-white">
                                    <ion-icon name="checkmark-circle" class="text-xl"></ion-icon>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-green-800 text-base mb-1">
                                    กลับถึงจุดเริ่มต้น
                                </div>
                                <div class="font-medium text-gray-800 text-sm">${route[0].address}</div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            routeInfo.innerHTML = html;
            resultsContainer.classList.remove('hidden');
        }
        
        function clearRoute() {
            if (routeLayer) {
                if (Array.isArray(routeLayer)) {
                    // ถ้าเป็น array ให้ลบทีละตัว
                    routeLayer.forEach(control => {
                        try {
                            map.removeControl(control);
                        } catch (e) {
                            console.warn('Error removing route control:', e);
                        }
                    });
                } else {
                    // ถ้าเป็น control เดียว
                    try {
                        map.removeControl(routeLayer);
                    } catch (e) {
                        console.warn('Error removing route layer:', e);
                    }
                }
                routeLayer = null;
            }
            
            routeMarkers.forEach(marker => {
                try {
                    map.removeLayer(marker);
                } catch (e) {
                    console.warn('Error removing marker:', e);
                }
            });
            routeMarkers = [];
            
            document.getElementById('routeResults').classList.add('hidden');
            distanceMatrix = {};
            optimizedRoutePoints = [];
            routeAnalysisData = null;
        }
        
        function clearAllPoints() {
            Swal.fire({
                title: 'ต้องการล้างจุดทั้งหมดหรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'ล้างทั้งหมด',
                cancelButtonText: 'ยกเลิก',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // ยกเลิก checkbox องค์การ
                    document.getElementById('useOrgStartPoint').checked = false;
                    useOrganizationStart = false;
                    selectedPoints = [];
                    selectedRequestIds = [];
                    
                    markers.forEach(marker => {
                        map.removeLayer(marker);
                    });
                    markers = [];
                    
                    clearRoute();
                    updatePointsList();
                    updateButtons();
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'ล้างข้อมูลเรียบร้อย',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            });
        }
        
        async function saveCurrentRoute() {
        if (!routeAnalysisData || optimizedRoutePoints.length < 2) {
            Swal.fire({
                icon: 'warning',
                title: 'ไม่สามารถบันทึกได้',
                text: 'กรุณาวิเคราะห์เส้นทางก่อนบันทึก',
                confirmButtonText: 'ตกลง'
            });
            return;
        }
        
        const { value: formValues } = await Swal.fire({
            title: '',
            html: `
                <div class="text-left">
                    <div class="flex items-center space-x-3 mb-6 pb-4 border-b-2 border-gray-200">
                        <ion-icon name="bookmark-outline" class="text-blue-500 text-3xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">บันทึกเส้นทาง</span>
                    </div>

                    <div class="space-y-5">
                        <div>
                            <label for="routeName" class="block text-sm font-medium text-gray-700 mb-2">
                                ชื่อเส้นทาง <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="routeName" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 transition"
                                placeholder="เช่น เส้นทางเก็บขยะเขต 1">
                        </div>

                        <div>
                            <label for="routeNote" class="block text-sm font-medium text-gray-700 mb-2">
                                หมายเหตุ <span class="text-gray-400 font-normal">(ถ้ามี)</span>
                            </label>
                            <textarea id="routeNote" rows="3"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 transition resize-none"
                                placeholder="เพิ่มหมายเหตุเพิ่มเติม..."></textarea>
                        </div>

                        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100">
                            <div class="flex items-center gap-2 mb-4">
                                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                </svg>
                                <h3 class="font-semibold text-blue-900">ข้อมูลเส้นทาง</h3>
                            </div>

                            <div class="grid grid-cols-1 gap-3">
                                <div class="flex items-center gap-3 bg-white/60 rounded-lg p-3 border border-blue-100/50">
                                    <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <div class="text-xs text-gray-600 font-medium">จำนวนจุด</div>
                                        <div class="text-lg font-bold text-gray-900">${optimizedRoutePoints.length} <span class="text-sm font-normal text-gray-600">จุด</span></div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-3 bg-white/60 rounded-lg p-3 border border-blue-100/50">
                                    <div class="w-10 h-10 bg-indigo-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <div class="text-xs text-gray-600 font-medium">ระยะทาง</div>
                                        <div class="text-lg font-bold text-gray-900">${routeAnalysisData.totalDistance.toFixed(2)} <span class="text-sm font-normal text-gray-600">กม.</span></div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-3 bg-white/60 rounded-lg p-3 border border-blue-100/50">
                                    <div class="w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <div class="text-xs text-gray-600 font-medium">เวลา</div>
                                        <div class="text-lg font-bold text-gray-900">${Math.round(routeAnalysisData.totalDuration)} <span class="text-sm font-normal text-gray-600">นาที</span></div>
                                    </div>
                                </div>

                                ${selectedRequestIds.length > 0 ? `
                                <div class="flex items-center gap-3 bg-green-50 rounded-lg p-3 border border-green-200">
                                    <div class="w-10 h-10 bg-green-500 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1">
                                        <div class="text-xs text-gray-600 font-medium">คำขอขายขยะ</div>
                                        <div class="text-lg font-bold text-green-700">${selectedRequestIds.length} <span class="text-sm font-normal text-gray-600">รายการ</span></div>
                                    </div>
                                </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `,
            focusConfirm: false,
            showCancelButton: true,
            showCloseButton: true,
            closeButtonHtml: '&times;',
            cancelButtonText: 'ยกเลิก',
            confirmButtonText: 'บันทึก',
            reverseButtons: true,
            buttonsStyling: false,
            width: '700px',
            customClass: {
                popup: 'rounded-xl shadow-lg',
                closeButton: 'custom-close-btn',
                actions: 'w-full flex justify-end px-6 pb-6',
                confirmButton: 'px-6 py-2.5 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition duration-200',
                cancelButton: 'px-6 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200 mr-2'
            },
            preConfirm: () => {
                const routeName = document.getElementById('routeName').value.trim();
                const routeNote = document.getElementById('routeNote').value.trim();
                
                if (!routeName) {
                    Swal.showValidationMessage('กรุณากรอกชื่อเส้นทาง');
                    return false;
                }
                
                return {
                    routeName: routeName,
                    routeNote: routeNote
                };
            },
            didOpen: () => {
                document.getElementById('routeName').focus();
                const closeBtn = document.querySelector('.swal2-close');
                const header = document.querySelector('.swal2-html-container > div > div');
                
                if (closeBtn && header) {
                    const headerTop = header.offsetTop;
                    closeBtn.style.top = `${headerTop + 4}px`;  // +4px เพื่อปรับให้ตรงกลาง
                }
            }
        });
        
        if (!formValues) return;
        
        Swal.fire({
            title: 'กำลังบันทึก...',
            html: 'กรุณารอสักครู่',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        try {
            const routeData = {
                routeName: formValues.routeName,
                points: optimizedRoutePoints.map((point, index) => ({
                    pointNumber: index + 1,
                    lat: point.lat,
                    lng: point.lng,
                    address: point.address,
                    requestId: point.requestId || null
                })),
                totalDistance: routeAnalysisData.totalDistance,
                totalDuration: routeAnalysisData.totalDuration,
                note: formValues.routeNote || '',
                requestIds: selectedRequestIds
            };
            
            const response = await fetch('/employee/routes/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(routeData)
            });
            
            const result = await response.json();
            
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'บันทึกสำเร็จ!',
                    text: result.message,
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#28a745',
                    timer: 3000
                }).then(() => {
                    Swal.fire({
                        title: 'ดูรายการเส้นทาง?',
                        text: 'ต้องการไปยังหน้ารายการเส้นทางที่บันทึกหรือไม่',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'ไปดู',
                        cancelButtonText: 'อยู่หน้านี้',
                        confirmButtonColor: '#3B82F6'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/employee/routeList';
                        }
                    });
                });
            } else {
                throw new Error(result.message);
            }
            
        } catch (error) {
            console.error('Error saving route:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: error.message || 'ไม่สามารถบันทึกเส้นทางได้',
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#EF4444'
            });
        }
    }
        
        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            setupEnhancedSearch();
            
            document.getElementById('analyzeBtn').addEventListener('click', analyzeRoute);
            document.getElementById('clearBtn').addEventListener('click', clearAllPoints);
            
            updateButtons();
        });
    </script>

</body>
</html>