<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wasteSaleRequest.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #0a0a0a;
            color: #ededed;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .status-pending {
            background-color: #fef3c7;
            color: #92400e;
        }

        .status-approved {
            background-color: #d1fae5;
            color: #065f46;
        }

        .status-rejected {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .btn {
            padding: 0.625rem 1.25rem;
            border-radius: 0.5rem;
            font-weight: 500;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }

        .btn-primary {
            background-color: #22c55e;
            color: #0a0a0a;
        }

        .btn-primary:hover {
            background-color: #16a34a;
        }

        .btn-secondary {
            background-color: #262626;
            color: #ededed;
            border: 1px solid #404040;
        }

        .btn-secondary:hover {
            background-color: #404040;
        }

        .btn-danger {
            background-color: #ef4444;
            color: #fff;
        }

        .btn-danger:hover {
            background-color: #dc2626;
        }


        .input-field {
            width: 100%;
            padding: 0.625rem 0.875rem;
            background-color: #262626;
            border: 1px solid #404040;
            border-radius: 0.5rem;
            color: #ededed;
            font-size: 0.875rem;
        }

        .input-field:focus {
            outline: none;
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
        }

        textarea.input-field {
            resize: vertical;
            min-height: 100px;
        }

        .info-row {
            display: flex;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e7e7e7;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 500;
            color: #000000;
            min-width: 140px;
        }

        .info-value {
            color: #7e7e7e;
            flex: 1;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            max-width: 90%;
            max-height: 90%;
        }

        .modal-content img {
            border-radius: 0.5rem;
            max-width: 100%;
            height: auto;
        }
    </style>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        คำขอขายขยะ
                    </h1>
                    <p class="text-gray-600 mt-2">ตรวจสอบและตอบกลับคำขอจากผู้ใช้</p>
                </div>
            </div>
        </div>

            <!-- Request Details Card -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column - Request Info -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Status and Date -->
                <div class="w-full bg-white rounded-lg shadow p-4 mx-4 mb-6 text-black">
                    <div class="flex items-center justify-between mb-6 ">
                        <div>
                            <h3 class="text-lg font-semibold mb-2">รายละเอียดคำขอ</h3>
                            <p class="text-sm text-gray-500">ID: <%= request._id  %></p>
                        </div> 
                        <span class="status-badge status-pending" id="statusBadge">รอดำเนินการ</span>
                    </div>

                    <div class="space-y-0">
                        <div class="info-row">
                            <span class="info-label">วันที่แจ้ง:</span>
                            <span class="info-value" id="requestDate"><%= request.createdAt.toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">น้ำหนัก:</span>
                            <span class="info-value" id="weight"><%= request.weight %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">ประเภทขยะ:</span>
                            <span class="info-value" id="wasteTypes">กำลังโหลด...</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">สถานที่:</span>
                            <span class="info-value" id="location"><%= request.location  %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">รายละเอียดเพิ่มเติม:</span>
                            <span class="info-value" id="locationDetail">-</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">พิกัด:</span>
                            <span class="info-value">
                                <a href="#" id="mapLink" class="text-[#22c55e] hover:underline" target="_blank">
                                    <%= request.latitude  %>, <%= request.longitude  %>
                                </a>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Image -->
                <div class="w-full bg-white rounded-lg shadow p-4 mx-4 mb-6 text-black">
                    <h3 class="text-lg font-semibold mb-4">รูปภาพขยะ</h3>
                    <div class="relative aspect-video rounded-lg overflow-hidden cursor-pointer" onclick="openImageModal()">
                        <img 
                            id="wasteImage" 
                            src="<%= request.img  %>" 
                            alt="รูปภาพขยะ" 
                            class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-20 transition-all flex items-center justify-center">
                            <svg class="w-12 h-12 text-white opacity-0 hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Response Form -->
            <div class="lg:col-span-1">
                <div class="sticky top-8 w-80 bg-white rounded-lg shadow p-4 mx-4 mb-6 text-black">
                    <h3 class="text-lg font-semibold mb-4">ตอบกลับคำขอ</h3>
                    
                    <form id="responseForm" class="space-y-4">
                        <!-- Weight Input -->
                        <div>
                            <label class="block text-sm font-medium mb-2">น้ำหนักที่ประเมิน (กก.)</label>
                            <input 
                                type="number" 
                                id="estimatedWeight" 
                                class="w-full bg-gray-50 border border-gray-200 px-3 py-2 rounded-md" 
                                placeholder="0.00"
                                step="0.01"
                                min="0"
                            />
                        </div>

                        <!-- Price Input -->
                        <div>
                            <label class="block text-sm font-medium mb-2">ราคาที่เสนอ (บาท)</label>
                            <input 
                                type="number" 
                                id="offeredPrice" 
                                class="w-full bg-gray-50 border border-gray-200 px-3 py-2 rounded-md" 
                                placeholder="0.00"
                                step="0.01"
                                min="0"
                            />
                        </div>

                        <!-- Response Message -->
                        <div>
                            <label class="block text-sm font-medium mb-2">ข้อความตอบกลับ</label>
                            <textarea 
                                id="responseMessage" 
                                class="w-full bg-gray-50 border border-gray-200 px-3 py-2 rounded-md" 
                                placeholder="กรอกข้อความตอบกลับ..."
                            ></textarea>
                        </div>

                        <!-- Pickup Date -->
                        <div>
                            <label class="block text-sm font-medium mb-2">วันที่นัดรับ</label>
                            <input 
                                type="date" 
                                id="pickupDate" 
                                class="w-full bg-gray-50 border border-gray-200 px-3 py-2 rounded-md"
                            />
                        </div>

                        <!-- Action Buttons -->
                        <div class="space-y-2 pt-4">
                            <button type="button" onclick="approveRequest()" class="btn btn-primary w-full">
                                อนุมัติคำขอ
                            </button>
                            <button type="button" onclick="rejectRequest()" class="btn btn-danger w-full">
                                ปฏิเสธคำขอ
                            </button>
                            <button type="button" onclick="saveAsDraft()" class="btn btn-secondary w-full">
                                บันทึกแบบร่าง
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


    </div>
    
</body>

<script>
</script>
</html>