<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/funeral-assistance.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <style>
        /* เพิ่ม custom styles สำหรับ UI ใหม่ */
        .status-badge {
            transition: all 0.3s ease;
        }
        .status-badge:hover {
            transform: scale(1.05);
        }
        .calculation-card {
            transition: all 0.3s ease;
        }
        .calculation-card:hover {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .progress-step {
            position: relative;
        }
        .progress-step::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 100%;
            width: 100%;
            height: 2px;
            background: #e5e7eb;
            z-index: -1;
        }
        .progress-step:last-child::after {
            display: none;
        }
        .progress-step.active::after {
            background: #3b82f6;
        }
        /* เพิ่ม styles สำหรับ dropdown autocomplete */
        #householdDropdown {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        #householdDropdown::-webkit-scrollbar {
            width: 8px;
        }
        #householdDropdown::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        #householdDropdown::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 4px;
        }
        #householdDropdown::-webkit-scrollbar-thumb:hover {
            background: #a0aec0;
        }
    </style>
</head>

<body class="bg-gray-50">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
    </script>

    <div class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ฌาปนกิจสงเคราะห์
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการเงินช่วยเหลือฌาปนกิจสงเคราะห์สำหรับครัวเรือนในชุมชน</p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form Section -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="bg-blue-50 px-6 py-4 border-b border-gray-200">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            แบบฟอร์มขอรับเงินช่วยเหลือฌาปนกิจสงเคราะห์
                        </h2>
                    </div>
                    
                    <form id="funeralForm" action="/employee/funeral-assistance/submit" method="POST" class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                            <div class="md:col-span-3">
                                <p class="block text-sm font-bold text-xl text-gray-700 mb-1">เงื่อนไขรับเงินช่วยเหลือฌาปนกิจสงเคราะห์ <span class="text-red-500">*</span></p>
                                <p class="block text-sm font-medium text-gray-700 mb-1">ต้องสมัครเข้าร่วมกองทุนขยะรีไซเคิลครบ 6 เดือน และมีการนำขยะมาขายให้ครบยอดเงินขั้นต่ำ 300 บาท</p>
                            </div>
                            
                            <!-- ค้นหาครัวเรือน -->
                            <div class="md:col-span-3">
                                <label for="householdSearch" class="block text-sm font-medium text-gray-700 mb-1">ค้นหาครัวเรือน <span class="text-red-500">*</span></label>
                                <div class="relative">
                                    <input type="text" id="householdSearch" name="householdSearch" placeholder="ค้นหาด้วยรหัสครัวเรือนหรือชื่อหัวหน้าครัวเรือน" class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="off">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                    <div id="householdDropdown" class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-md shadow-lg max-h-60 overflow-y-auto hidden">
                                        <div id="householdList" class="py-1">
                                        </div>
                                        <div id="noResults" class="px-4 py-3 text-sm text-gray-500 text-center hidden">
                                            ไม่พบข้อมูลครัวเรือน
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- ข้อมูลครัวเรือน (จะแสดงหลังจากค้นหา) -->
                            <div class="md:col-span-3 p-4 bg-gray-50 rounded-lg border border-gray-200 hidden" id="householdInfo">
                                <h3 class="font-medium text-gray-800 mb-2">ข้อมูลครัวเรือน</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-sm text-gray-500">เลขบัญชี</p>
                                        <p class="font-medium" id="householdId">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">ชื่อตัวแทนครัวเรือน</p>
                                        <p class="font-medium" id="householdHead">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">ที่อยู่</p>
                                        <p class="font-medium" id="householdAddress">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">จำนวนสมาชิก</p>
                                        <p class="font-medium" id="memberCount">-</p>
                                    </div>
                                </div>
                            </div>

                            <!-- เพิ่มส่วนตรวจสอบคุณสมบัติ -->
                            <div class="md:col-span-3 hidden" id="eligibilitySection">
                                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg border-2 border-blue-200 p-6">
                                    <div class="flex items-center mb-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <h3 class="text-lg font-semibold text-gray-800">ตรวจสอบคุณสมบัติ</h3>
                                    </div>
                                    
                                    <div class="space-y-3">
                                        <!-- เงื่อนไข 1: สมัครครบ 6 เดือน -->
                                        <div class="flex items-start bg-white rounded-lg p-4 shadow-sm">
                                            <div class="flex-shrink-0 mr-3">
                                                <div class="w-8 h-8 rounded-full flex items-center justify-center" id="condition1Icon">
                                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="flex-1">
                                                <p class="font-medium text-gray-800">สมัครเข้าร่วมกองทุนครบ 6 เดือน</p>
                                                <p class="text-sm text-gray-600 mt-1" id="condition1Detail">กำลังตรวจสอบ...</p>
                                            </div>
                                        </div>

                                        <!-- เงื่อนไข 2: ขายขยะครบ 300 บาท -->
                                        <div class="flex items-start bg-white rounded-lg p-4 shadow-sm">
                                            <div class="flex-shrink-0 mr-3">
                                                <div class="w-8 h-8 rounded-full flex items-center justify-center" id="condition2Icon">
                                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="flex-1">
                                                <p class="font-medium text-gray-800">ขายขยะรีไซเคิลครบ 300 บาท</p>
                                                <p class="text-sm text-gray-600 mt-1" id="condition2Detail">กำลังตรวจสอบ...</p>
                                            </div>
                                        </div>

                                        <!-- สรุปผลการตรวจสอบ -->
                                        <div class="mt-4 p-4 rounded-lg" id="eligibilityResult">
                                            <div class="flex items-center">
                                                <svg class="w-6 h-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="resultIcon">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <p class="font-semibold text-lg" id="resultText">กำลังตรวจสอบคุณสมบัติ...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ชื่อผู้รับผิดชอบในการจัดทำศพ -->
                            <div class="md:col-span-2">
                                <label for="responsiblePersonName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อผู้รับผิดชอบในการจัดทำศพ <span class="text-red-500">*</span></label>
                                <input type="text" id="responsiblePersonName" name="responsiblePersonName" required placeholder="ระบุชื่อ-นามสกุล ชื่อผู้รับผิดชอบในการจัดทำศพ" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- เพิ่มฟิลด์มีความเกี่ยวข้องกับผู้ตายในฐานะ -->
                            <div>
                                <label for="deceasedRelationshipDetail" class="block text-sm font-medium text-gray-700 mb-1">มีความเกี่ยวข้องกับผู้ตายในฐานะ <span class="text-red-500">*</span></label>
                                <select id="relationship" name="relationship" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>-- เลือกความสัมพันธ์ --</option>
                                    <option value="หัวหน้าครัวเรือน">หัวหน้าครัวเรือน</option>
                                    <option value="คู่สมรส">คู่สมรส</option>
                                    <option value="บุตร">บุตร</option>
                                    <option value="บิดา/มารดา">บิดา/มารดา</option>
                                    <option value="ญาติ">ญาติ</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>

                            <!-- ข้อมูลผู้เสียชีวิต -->
                            <div class="md:col-span-3">
                                <p class="block text-base font-medium text-gray-700 mb-1">ข้อมูลผู้เสียชีวิต</p>
                            </div>
                            
                            <!-- ชื่อผู้เสียชีวิต -->
                            <div class="md:col-span-2">
                                <label for="deceasedName" class="block text-sm font-medium text-gray-700 mb-1">
                                    ชื่อผู้เสียชีวิต <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="deceasedName" name="deceasedName" required 
                                    placeholder="ระบุชื่อ-นามสกุล ผู้เสียชีวิต" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- อายุผู้เสียชีวิต -->
                            <div>
                                <label for="deceasedAge" class="block text-sm font-medium text-gray-700 mb-1">
                                    อายุ (ปี) <span class="text-red-500">*</span>
                                </label>
                                <input type="number" id="deceasedAge" name="deceasedAge" required 
                                    placeholder="ระบุอายุ" min="0"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- หมายเลขบัตรประชาชน -->
                            <div>
                                <label for="idCard" class="block text-sm font-medium text-gray-700 mb-1">
                                    หมายเลขบัตรประชาชน <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="idCard" name="idCard" required 
                                    placeholder="X-XXXX-XXXXX-XX-X" maxlength="17"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- บ้านเลขที่ -->
                            <div>
                                <label for="deceasedAddress" class="block text-sm font-medium text-gray-700 mb-1">
                                    อยู่บ้านเลขที่ <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="deceasedAddress" name="deceasedAddress" required 
                                    placeholder="ระบุบ้านเลขที่" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- หมู่ที่ -->
                            <div>
                                <label for="deceasedVillage" class="block text-sm font-medium text-gray-700 mb-1">
                                    หมู่ที่ <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="deceasedVillage" name="deceasedVillage" required 
                                    placeholder="ระบุหมู่ที่" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: ตำบล -->
                            <div>
                                <label for="subDistrict" class="block text-sm font-medium text-gray-700 mb-1">
                                    ตำบล <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="subDistrict" name="subDistrict" required 
                                    placeholder="ระบุตำบล" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: อำเภอ -->
                            <div>
                                <label for="district" class="block text-sm font-medium text-gray-700 mb-1">
                                    อำเภอ <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="district" name="district" required 
                                    placeholder="ระบุอำเภอ" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: จังหวัด -->
                            <div>
                                <label for="province" class="block text-sm font-medium text-gray-700 mb-1">
                                    จังหวัด <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="province" name="province" required 
                                    placeholder="ระบุจังหวัด" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: รหัสไปรษณีย์ -->
                            <div>
                                <label for="postalCode" class="block text-sm font-medium text-gray-700 mb-1">
                                    รหัสไปรษณีย์ <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="postalCode" name="postalCode" required 
                                    placeholder="XXXXX" maxlength="5"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: โทรศัพท์ -->
                            <div>
                                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                                    โทรศัพท์ <span class="text-red-500">*</span>
                                </label>
                                <input type="tel" id="phone" name="phone" required 
                                    placeholder="0XX-XXX-XXXX" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- ✅ แก้ไข: สาเหตุการเสียชีวิต -->
                            <div>
                                <label for="causeOfDeath" class="block text-sm font-medium text-gray-700 mb-1">
                                    ถึงแก่กรรมด้วยสาเหตุ <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="causeOfDeath" name="causeOfDeath" required 
                                    placeholder="ระบุสาเหตุการเสียชีวิต" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- วันที่เสียชีวิต -->
                            <div>
                                <label for="dateOfDeath" class="block text-sm font-medium text-gray-700 mb-1">
                                    วันที่เสียชีวิต <span class="text-red-500">*</span>
                                </label>
                                <input type="date" id="dateOfDeath" name="dateOfDeath" required 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- หมายเหตุ -->
                            <div class="md:col-span-3">
                                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">หมายเหตุ</label>
                                <textarea id="notes" name="notes" rows="2" 
                                    placeholder="ระบุหมายเหตุเพิ่มเติม (ถ้ามี)" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>
                            
                            <!-- จำนวนเงินช่วยเหลือ -->
                            <div class="md:col-span-3">
                                <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">
                                    จำนวนเงินช่วยเหลือ (บาท) <span class="text-red-500">*</span>
                                </label>
                                <input type="number" id="amount" name="amount" required 
                                    placeholder="0.00" min="0" step="0.01" 
                                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- เพิ่มส่วนคำนวณเงินฌาปนกิจ -->
                            <div class="md:col-span-3 hidden" id="calculationSection">
                                <div class="rounded-lg border-2 border-gray-200 p-6">
                                    <div class="flex items-center mb-4">
                                        <h3 class="text-lg font-semibold text-gray-800">การคำนวณเงินฌาปนกิจ</h3>
                                    </div>

                                    <!-- สรุปยอดเงิน -->
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                                        <div class="bg-white rounded-lg p-4 shadow-sm">
                                            <p class="text-sm text-gray-600 mb-1">จำนวนเงินที่ต้องจ่าย</p>
                                            <p class="text-2xl font-bold text-emerald-600" id="totalAmount">0 บาท</p>
                                        </div>
                                        <div class="bg-white rounded-lg p-4 shadow-sm">
                                            <p class="text-sm text-gray-600 mb-1">จำนวนบัญชีในระบบ</p>
                                            <p class="text-2xl font-bold text-blue-600" id="totalAccounts">0 บัญชี</p>
                                        </div>
                                        <div class="bg-white rounded-lg p-4 shadow-sm">
                                            <p class="text-sm text-gray-600 mb-1">หักจากบัญชีละ</p>
                                            <p class="text-2xl font-bold text-orange-600" id="perAccountAmount">0 บาท</p>
                                        </div>
                                    </div>

                                    <!-- รายละเอียดการกระจายเงิน -->
                                    <div class="bg-white rounded-lg p-4 shadow-sm">
                                        <div class="flex items-center justify-between mb-3">
                                            <h4 class="font-medium text-gray-800">รายละเอียดการกระจายภาระ</h4>
                                            <button type="button" id="toggleDetails" class="text-sm text-blue-600 hover:text-blue-800 flex items-center">
                                                <span>ดูรายละเอียด</span>
