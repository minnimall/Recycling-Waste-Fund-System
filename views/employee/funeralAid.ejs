        // ✅ แก้ไขฟังก์ชัน submitFuneralAssistance ให้รับ FormData
        async function submitFuneralAssistance(formDataToSend) {
            try {
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล...',
                    text: 'โปรดรอสักครู่',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/employee/funeral-assistance/submit', {
                    method: 'POST',
                    body: formDataToSend // ไม่ต้องใส่ Content-Type, browser จะใส่ให้อัตโนมัติ
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ',
                        html: `
                            <p>บันทึกข้อมูลฌาปนกิจสงเคราะห์เรียบร้อยแล้ว</p>
                            <div class="mt-3 text-sm text-gray-600">
                                <p>หักเงินจำนวน: ${result.data.totalDeducted.toFixed(2)} บาท</p>
                                <p>จากบัญชี: ${result.data.accountsDeducted} บัญชี</p>
                            </div>
                        `
                    });

                    window.location.href = `/employee/funeralAidHistory`;
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: result.message || 'ไม่สามารถบันทึกข้อมูลได้'
                    });
                }
            } catch (error) {
                console.error('❌ Submit Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้'
                });
            }
        }

        // ฟังก์ชันรีเซ็ตฟอร์ม
        function resetForm() {
            if (confirm('ต้องการยกเลิกและล้างข้อมูลทั้งหมดหรือไม่?')) {
                document.getElementById('funeralForm').reset();
                clearHouseholdInfo();
