<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/funeral-assistance.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body class="bg-gray-50">
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ฌาปนกิจสงเคราะห์
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการเงินช่วยเหลือฌาปนกิจสงเคราะห์สำหรับครัวเรือนในชุมชน</p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form Section -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="bg-blue-50 px-6 py-4 border-b border-gray-200">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            แบบฟอร์มขอรับเงินช่วยเหลือฌาปนกิจสงเคราะห์
                        </h2>
                    </div>
                    
                    <form action="/employee/funeral-assistance/submit" method="POST" class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- ปีงบประมาณ -->
                            <div>
                                <label for="fiscalYear" class="block text-sm font-medium text-gray-700 mb-1">ปีงบประมาณ <span class="text-red-500">*</span></label>
                                <select id="fiscalYear" name="fiscalYear" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>-- เลือกปีงบประมาณ --</option>
                                    <option value="2566">2566</option>
                                    <option value="2567">2567</option>
                                    <option value="2568">2568</option>
                                </select>
                            </div>
                            
                            <!-- วันที่หักจ่าย -->
                            <div>
                                <label for="paymentDate" class="block text-sm font-medium text-gray-700 mb-1">วันที่หักจ่าย <span class="text-red-500">*</span></label>
                                <input type="date" id="paymentDate" name="paymentDate" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- ค้นหาครัวเรือน -->
                            <div class="md:col-span-2">
                                <label for="householdSearch" class="block text-sm font-medium text-gray-700 mb-1">ค้นหาครัวเรือน <span class="text-red-500">*</span></label>
                                <div class="relative">
                                    <input type="text" id="householdSearch" name="householdSearch" placeholder="ค้นหาด้วยรหัสครัวเรือนหรือชื่อหัวหน้าครัวเรือน" class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                </div>
                            </div>
                            
                            <!-- ข้อมูลครัวเรือน (จะแสดงหลังจากค้นหา) -->
                            <div class="md:col-span-2 p-4 bg-gray-50 rounded-lg border border-gray-200 hidden" id="householdInfo">
                                <h3 class="font-medium text-gray-800 mb-2">ข้อมูลครัวเรือน</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-sm text-gray-500">รหัสครัวเรือน</p>
                                        <p class="font-medium" id="householdId">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">ชื่อหัวหน้าครัวเรือน</p>
                                        <p class="font-medium" id="householdHead">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">ที่อยู่</p>
                                        <p class="font-medium" id="householdAddress">-</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">จำนวนสมาชิก</p>
                                        <p class="font-medium" id="memberCount">-</p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- ชื่อผู้เสียชีวิต -->
                            <div class="md:col-span-2">
                                <label for="deceasedName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อผู้เสียชีวิต <span class="text-red-500">*</span></label>
                                <input type="text" id="deceasedName" name="deceasedName" required placeholder="ระบุชื่อ-นามสกุลผู้เสียชีวิต" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- ความสัมพันธ์กับหัวหน้าครัวเรือน -->
                            <div>
                                <label for="relationship" class="block text-sm font-medium text-gray-700 mb-1">ความสัมพันธ์กับหัวหน้าครัวเรือน <span class="text-red-500">*</span></label>
                                <select id="relationship" name="relationship" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>-- เลือกความสัมพันธ์ --</option>
                                    <option value="หัวหน้าครัวเรือน">หัวหน้าครัวเรือน</option>
                                    <option value="คู่สมรส">คู่สมรส</option>
                                    <option value="บุตร">บุตร</option>
                                    <option value="บิดา/มารดา">บิดา/มารดา</option>
                                    <option value="ญาติ">ญาติ</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            
                            <!-- วันที่เสียชีวิต -->
                            <div>
                                <label for="dateOfDeath" class="block text-sm font-medium text-gray-700 mb-1">วันที่เสียชีวิต <span class="text-red-500">*</span></label>
                                <input type="date" id="dateOfDeath" name="dateOfDeath" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- สาเหตุการเสียชีวิต -->
                            <div class="md:col-span-2">
                                <label for="causeOfDeath" class="block text-sm font-medium text-gray-700 mb-1">สาเหตุการเสียชีวิต <span class="text-red-500">*</span></label>
                                <textarea id="causeOfDeath" name="causeOfDeath" rows="2" required placeholder="ระบุสาเหตุการเสียชีวิต" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>
                            
                            <!-- จำนวนเงินช่วยเหลือ -->
                            <div>
                                <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">จำนวนเงินช่วยเหลือ (บาท) <span class="text-red-500">*</span></label>
                                <input type="number" id="amount" name="amount" required placeholder="0.00" min="0" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- ผู้รับเงินช่วยเหลือ -->
                            <div>
                                <label for="beneficiary" class="block text-sm font-medium text-gray-700 mb-1">ผู้รับเงินช่วยเหลือ <span class="text-red-500">*</span></label>
                                <input type="text" id="beneficiary" name="beneficiary" required placeholder="ระบุชื่อ-นามสกุลผู้รับเงิน" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- ความสัมพันธ์กับผู้เสียชีวิต -->
                            <div>
                                <label for="beneficiaryRelationship" class="block text-sm font-medium text-gray-700 mb-1">ความสัมพันธ์กับผู้เสียชีวิต <span class="text-red-500">*</span></label>
                                <select id="beneficiaryRelationship" name="beneficiaryRelationship" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>-- เลือกความสัมพันธ์ --</option>
                                    <option value="คู่สมรส">คู่สมรส</option>
                                    <option value="บุตร">บุตร</option>
                                    <option value="บิดา/มารดา">บิดา/มารดา</option>
                                    <option value="พี่/น้อง">พี่/น้อง</option>
                                    <option value="ญาติ">ญาติ</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            
                            <!-- เบอร์โทรศัพท์ผู้รับเงิน -->
                            <div>
                                <label for="beneficiaryPhone" class="block text-sm font-medium text-gray-700 mb-1">เบอร์โทรศัพท์ผู้รับเงิน</label>
                                <input type="tel" id="beneficiaryPhone" name="beneficiaryPhone" placeholder="0xxxxxxxxx" pattern="[0-9]{10}" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            
                            <!-- หมายเหตุ -->
                            <div class="md:col-span-2">
                                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">หมายเหตุ</label>
                                <textarea id="notes" name="notes" rows="2" placeholder="ระบุหมายเหตุเพิ่มเติม (ถ้ามี)" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>
                            
                            <!-- เอกสารแนบ -->
                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-gray-700 mb-1">เอกสารแนบ</label>
                                <div class="space-y-4">
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="deathCertificate" name="documents[]" value="deathCertificate" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                        <label for="deathCertificate" class="text-sm text-gray-700">สำเนาใบมรณบัตร</label>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="idCard" name="documents[]" value="idCard" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                        <label for="idCard" class="text-sm text-gray-700">สำเนาบัตรประชาชนผู้เสียชีวิต</label>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="houseRegistration" name="documents[]" value="houseRegistration" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                        <label for="houseRegistration" class="text-sm text-gray-700">สำเนาทะเบียนบ้าน</label>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="beneficiaryIdCard" name="documents[]" value="beneficiaryIdCard" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                        <label for="beneficiaryIdCard" class="text-sm text-gray-700">สำเนาบัตรประชาชนผู้รับเงิน</label>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="otherDocuments" name="documents[]" value="otherDocuments" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                        <label for="otherDocuments" class="text-sm text-gray-700">เอกสารอื่นๆ</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-8 flex justify-end space-x-3">
                            <button type="button" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                ยกเลิก
                            </button>
                            <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                บันทึกข้อมูล
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Sidebar -->
            <div>
                <!-- ข้อมูลสรุป -->
                <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
                    <div class="bg-blue-50 px-6 py-4 border-b border-gray-200">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                            สรุปข้อมูล
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="space-y-4">
                            <div class="bg-blue-50 rounded-lg p-4">
                                <h3 class="font-medium text-gray-800 mb-2">ปีงบประมาณ 2567</h3>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <p class="text-sm text-gray-500">จำนวนผู้เสียชีวิต</p>
                                        <p class="text-xl font-bold text-blue-600">12 ราย</p>
                                    </div>
                                    <div>
                                        <p class="text-sm text-gray-500">งบประมาณที่ใช้ไป</p>
                                        <p class="text-xl font-bold text-blue-600">120,000 บาท</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div>
                                <h3 class="font-medium text-gray-800 mb-2">สถิติรายเดือน</h3>
                                <div class="space-y-2">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">มกราคม</span>
                                        <span class="text-sm font-medium">2 ราย</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">กุมภาพันธ์</span>
                                        <span class="text-sm font-medium">1 ราย</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">มีนาคม</span>
                                        <span class="text-sm font-medium">3 ราย</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">เมษายน</span>
                                        <span class="text-sm font-medium">2 ราย</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">พฤษภาคม</span>
                                        <span class="text-sm font-medium">1 ราย</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-600">มิถุนายน</span>
                                        <span class="text-sm font-medium">3 ราย</span>
                                    </div>
                                </div>
                                <div class="mt-2 text-right">
                                    <a href="#" class="text-sm text-blue-600 hover:text-blue-800">ดูทั้งหมด</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- คำแนะนำ -->
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="bg-blue-50 px-6 py-4 border-b border-gray-200">
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            คำแนะนำ
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="space-y-4">
                            <div class="flex items-start">
                                <div class="flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-gray-700">กรุณาตรวจสอบความถูกต้องของข้อมูลก่อนบันทึก</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-gray-700">ต้องแนบเอกสารสำเนาใบมรณบัตรทุกครั้ง</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-gray-700">ผู้รับเงินต้องเป็นทายาทโดยชอบธรรมหรือผู้ที่ได้รับมอบหมายเท่านั้น</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-gray-700">การจ่ายเงินจะดำเนินการภายใน 7 วันทำการหลังจากได้รับอนุมัติ</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
