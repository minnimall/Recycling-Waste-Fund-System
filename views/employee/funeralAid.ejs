                    confirmButtonText: 'ตกลง'
                });
                this.value = '';
                document.getElementById('responsiblePersonId').value = '';
            }
        });

        document.getElementById('deceasedName').addEventListener('change', function() {
            const selectedId = this.options[this.selectedIndex].dataset.memberId;
            document.getElementById('deceasedId').value = selectedId;
            
            const responsibleId = document.getElementById('responsiblePersonId').value;
            
            if (selectedId && selectedId === responsibleId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่สามารถเลือกได้',
                    text: 'ผู้รับผิดชอบและผู้เสียชีวิตต้องไม่เป็นคนเดียวกัน',
                    confirmButtonText: 'ตกลง'
                });
                this.value = '';
                document.getElementById('deceasedId').value = '';
            }
            
            // Auto-fill ข้อมูลผู้เสียชีวิต
            const selectedMember = householdMembers.find(m => m._id === selectedId);
            if (selectedMember) {
                document.getElementById('deceasedAge').value = selectedMember.age || '';
                document.getElementById('idCard').value = formatThaiID(selectedMember.idCardNumber || '');
                document.getElementById('phone').value = selectedMember.phone || '';
            }
        });

        function formatThaiID(value) {
            // เอาเฉพาะตัวเลข
            let numbers = value.replace(/\D/g, '').slice(0, 13);

            // ใส่ขีดตามตำแหน่ง 1-4-5-2-1
            let formatted = '';
            if(numbers.length > 0) formatted += numbers.substr(0,1);
            if(numbers.length > 1) formatted += '-' + numbers.substr(1,4);
            if(numbers.length > 5) formatted += '-' + numbers.substr(5,5);
            if(numbers.length > 10) formatted += '-' + numbers.substr(10,2);
            if(numbers.length > 12) formatted += '-' + numbers.substr(12,1);

            return formatted;
        }

        // ==================== Setup File Preview ====================
        function setupFilePreview() {
            const fileInputs = [
                'deathCertificate',
                'deceasedIdCard',
                'deceasedHouseRegistration',
                'applicantIdCard',
                'applicantHouseRegistration'
            ];

            fileInputs.forEach(inputId => {
                const input = document.getElementById(inputId);
                const preview = document.getElementById(inputId + 'Preview');
                const label = input.nextElementSibling;

                // Drag & Drop Events
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    label.addEventListener(eventName, preventDefaults, false);
                });

                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                ['dragenter', 'dragover'].forEach(eventName => {
                    label.addEventListener(eventName, () => {
                        label.classList.add('dragover');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    label.addEventListener(eventName, () => {
                        label.classList.remove('dragover');
                    });
                });

                // Handle Drop
                label.addEventListener('drop', function(e) {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    
                    if (files.length > 0) {
                        input.files = files;
                        handleFileSelect(input, preview);
                    }
                });

                // Handle File Select
                input.addEventListener('change', function(e) {
                    handleFileSelect(input, preview);
                });
            });
        }

        // ==================== Handle File Selection ====================
        function handleFileSelect(input, preview) {
            const file = input.files[0];
            const label = input.nextElementSibling;
            
            if (file) {
                const fileSize = (file.size / 1024 / 1024).toFixed(2); // MB
                const fileType = file.type;

                // ตรวจสอบขนาดไฟล์
                if (file.size > 10 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไฟล์ใหญ่เกินไป',
                        text: 'ไฟล์มีขนาดใหญ่เกิน 10MB กรุณาเลือกไฟล์ใหม่',
                        confirmButtonColor: '#ef4444'
                    });
                    input.value = '';
                    preview.innerHTML = '';
                    input.classList.remove('has-file');
                    return;
                }

                // เพิ่ม class has-file
                input.classList.add('has-file');

                // อัปเดตข้อความใน label
                const textSpan = label.querySelector('.file-upload-text');
                const subtextSpan = label.querySelector('.file-upload-subtext');
                textSpan.textContent = '✓ เลือกไฟล์แล้ว';
                subtextSpan.textContent = file.name;

                // แสดง Preview
                if (fileType.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.innerHTML = `
                            <div class="flex items-center space-x-2 p-2 bg-green-50 border border-green-200 rounded-lg">
                                <img src="${e.target.result}" class="w-16 h-16 object-cover rounded">
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-green-800">${file.name}</p>
                                    <p class="text-xs text-green-600">${fileSize} MB</p>
                                </div>
                                <button type="button" onclick="removeFile('${input.id}')" class="text-red-600 hover:text-red-800">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        `;
                    };
                    reader.readAsDataURL(file);
                } else if (fileType === 'application/pdf') {
                    preview.innerHTML = `
                        <div class="flex items-center space-x-2 p-2 bg-blue-50 border border-blue-200 rounded-lg">
                            <svg class="w-12 h-12 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-blue-800">${file.name}</p>
                                <p class="text-xs text-blue-600">${fileSize} MB</p>
                            </div>
                            <button type="button" onclick="removeFile('${input.id}')" class="text-red-600 hover:text-red-800">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    `;
                }
            }
        }

        // ==================== Remove File ====================
        function removeFile(inputId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(inputId + 'Preview');
            const label = input.nextElementSibling;
            const textSpan = label.querySelector('.file-upload-text');
            const subtextSpan = label.querySelector('.file-upload-subtext');

            input.value = '';
            input.classList.remove('has-file');
            preview.innerHTML = '';
            textSpan.textContent = 'คลิกเพื่อเลือกไฟล์';
            subtextSpan.textContent = 'หรือลากไฟล์มาวางที่นี่';
        }

        // ==================== Setup ID Card Auto-Format ====================
        function setupIDCardFormatter() {
            const idInput = document.getElementById('idCard');
            
            if (idInput) {
                idInput.addEventListener('input', (e) => {
                    e.target.value = formatThaiID(e.target.value);
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // เรียกใช้ฟังก์ชัน setup
            setupFilePreview();
            setupIDCardFormatter();
        });

        // ==================== Address Management ====================
        let householdAddressData = null;

        function selectAddressOption(option) {
            const existingOption = document.getElementById('useExistingAddress');
            const newOption = document.getElementById('useNewAddress');
            const existingRadio = document.querySelector('input[name="addressOption"][value="existing"]');
            const newRadio = document.querySelector('input[name="addressOption"][value="new"]');

            if (option === 'existing') {
                existingOption.classList.add('selected');
                newOption.classList.remove('selected');
                existingRadio.checked = true;
                
                // ⭐ แสดง preview กลับมา
                if (householdAddressData) {
                    displayExistingAddress(householdAddressData);
                }
                
                fillExistingAddress();
            } else {
                newOption.classList.add('selected');
                existingOption.classList.remove('selected');
                newRadio.checked = true;
                clearAddressFields();
            }
        }

        function fillExistingAddress() {
            if (!householdAddressData) return;
            
            const form = document.getElementById('funeralForm');
            form.deceasedAddress.value = householdAddressData.houseNumber || '';
            form.deceasedVillage.value = householdAddressData.moo || '';
            form.subDistrict.value = householdAddressData.subdistrict || '';
            form.district.value = householdAddressData.district || '';
            form.province.value = householdAddressData.province || '';
            form.postalCode.value = householdAddressData.postalCode || '';
        }

        function clearAddressFields() {
            const form = document.getElementById('funeralForm');
            form.deceasedAddress.value = '';
            form.deceasedVillage.value = '';
            form.subDistrict.value = '';
            form.district.value = '';
            form.province.value = '';
            form.postalCode.value = '';
            form.deceasedAddress.focus();
        }

        function displayExistingAddress(data) {
            householdAddressData = data; // เก็บข้อมูลไว้ใน global variable
            const preview = document.getElementById('existingAddressPreview');
            
            if (data && data.houseNumber) {
                preview.innerHTML = `
                    <span class="text-gray-800">
                        บ้านเลขที่ ${data.houseNumber || '-'} 
                        หมู่ ${data.moo || '-'}<br>
                        ตำบล${data.subdistrict || '-'} 
                        อำเภอ${data.district || '-'}<br>
                        จังหวัด${data.province || '-'} 
                        ${data.postalCode || '-'}
                    </span>
                `;
            } else {
                preview.innerHTML = '<span class="text-gray-500">ไม่มีที่อยู่ที่บันทึกไว้</span>';
            }
        }

    </script>
</body>
</html>