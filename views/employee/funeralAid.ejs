        // เพิ่มฟังก์ชันโหลดสมาชิก (เพิ่มใน displayHouseholdInfo)
        async function loadFamilyMembers(familyID) {
            try {
                const response = await fetch(`/employee/funeral-assistance/members/${familyID}`);
