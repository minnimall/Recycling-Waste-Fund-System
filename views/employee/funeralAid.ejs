    <%- include('../partials/employeePartials/empFooter.ejs') %>
    
    <script>
        
        // ==================== Global Variables ====================
        let selectedHousehold = null;
        let currentFocusIndex = -1;
        let isEligible = false;

        const householdSearchInput = document.getElementById('householdSearch');
        const householdDropdown = document.getElementById('householdDropdown');
        const householdList = document.getElementById('householdList');
        const noResults = document.getElementById('noResults');

        // ==================== Event Listeners ====================

        // ค้นหาครัวเรือน (Debounced)
        let searchTimeout;
        householdSearchInput.addEventListener('input', function(e) {
            const searchValue = e.target.value.trim();
            currentFocusIndex = -1;
            
            clearTimeout(searchTimeout);
            
            if (searchValue.length === 0) {
                hideDropdown();
                clearHouseholdInfo();
                return;
            }

            // Debounce search
            searchTimeout = setTimeout(() => {
                searchHouseholds(searchValue);
            }, 300);
        });

        // Keyboard navigation
        householdSearchInput.addEventListener('keydown', function(e) {
            const items = householdList.querySelectorAll('div[class*="cursor-pointer"]');
            
            if (items.length === 0) return;
            
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                currentFocusIndex = Math.min(currentFocusIndex + 1, items.length - 1);
                updateFocus(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                currentFocusIndex = Math.max(currentFocusIndex - 1, 0);
                updateFocus(items);
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (currentFocusIndex >= 0 && items[currentFocusIndex]) {
                    items[currentFocusIndex].click();
                }
            } else if (e.key === 'Escape') {
                hideDropdown();
            }
        });

        // คำนวณเงินฌาปนกิจเมื่อกรอกจำนวนเงิน
        document.getElementById('amount').addEventListener('input', function(e) {
            const amount = parseFloat(e.target.value) || 0;
            
            if (amount > 0) {
                calculateFuneralAmount(amount);
            } else {
                document.getElementById('calculationSection').classList.add('hidden');
            }
        });

        // Toggle รายละเอียดการคำนวณ
        document.getElementById('toggleDetails').addEventListener('click', function() {
            const detailsContent = document.getElementById('detailsContent');
            const toggleIcon = document.getElementById('toggleIcon');
            
            detailsContent.classList.toggle('hidden');
            toggleIcon.classList.toggle('rotate-180');
        });

        // Click outside to close dropdown
        document.addEventListener('click', function(e) {
            if (!householdSearchInput.contains(e.target) && !householdDropdown.contains(e.target)) {
                hideDropdown();
            }
        });

        // ✅ แก้ไข JavaScript - รวบรวมข้อมูลครบถ้วน
        document.getElementById('funeralForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            console.log('🔍 Form submitted'); // Debug
            
            if (!selectedHousehold) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกครัวเรือน',
                    text: 'โปรดค้นหาและเลือกครัวเรือนก่อนบันทึกข้อมูล'
                });
                return;
            }

            if (!isEligible) {
                Swal.fire({
                    icon: 'error',
                    title: 'ไม่มีสิทธิ์',
                    text: 'ครัวเรือนนี้ไม่มีสิทธิ์รับเงินช่วยเหลือฌาปนกิจ'
                });
                return;
            }

            // ✅ รวบรวมข้อมูลให้ครบถ้วนตามที่ Backend ต้องการ
            const formData = {
                // ข้อมูลครัวเรือน
                familyID: selectedHousehold.familyID,
                
                // ข้อมูลผู้รับผิดชอบ
                responsiblePersonName: document.getElementById('responsiblePersonName').value.trim(),
                relationship: document.getElementById('relationship').value,
                
                // ข้อมูลผู้เสียชีวิต
                deceasedName: document.getElementById('deceasedName').value.trim(),
                deceasedAge: document.getElementById('deceasedAge').value,
                idCard: document.getElementById('idCard').value.trim(),
                deceasedAddress: document.getElementById('deceasedAddress').value.trim(),
                deceasedVillage: document.getElementById('deceasedVillage').value.trim(),
                subDistrict: document.getElementById('subDistrict').value.trim(),
                district: document.getElementById('district').value.trim(),
                province: document.getElementById('province').value.trim(),
                postalCode: document.getElementById('postalCode').value.trim(),
                phone: document.getElementById('phone').value.trim(),
                causeOfDeath: document.getElementById('causeOfDeath').value.trim(),
                dateOfDeath: document.getElementById('dateOfDeath').value,
                
                // ข้อมูลอื่นๆ
                notes: document.getElementById('notes').value.trim(),
                amount: parseFloat(document.getElementById('amount').value),
                memberID: null // ถ้ามีการเลือก member ใน UI
            };

            console.log('📋 Form Data:', formData); // Debug
            
            // ตรวจสอบข้อมูลก่อนส่ง
            const missingFields = [];
            const requiredFields = {
                responsiblePersonName: 'ชื่อผู้รับผิดชอบ',
                relationship: 'ความสัมพันธ์',
                deceasedName: 'ชื่อผู้เสียชีวิต',
                deceasedAge: 'อายุ',
                idCard: 'บัตรประชาชน',
                deceasedAddress: 'บ้านเลขที่',
                deceasedVillage: 'หมู่ที่',
                subDistrict: 'ตำบล',
                district: 'อำเภอ',
                province: 'จังหวัด',
                postalCode: 'รหัสไปรษณีย์',
                phone: 'โทรศัพท์',
                causeOfDeath: 'สาเหตุการเสียชีวิต',
                dateOfDeath: 'วันที่เสียชีวิต',
                amount: 'จำนวนเงิน'
            };

            for (const [field, label] of Object.entries(requiredFields)) {
                if (!formData[field] || formData[field].toString().trim() === '') {
                    missingFields.push(label);
                }
            }

            if (missingFields.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    html: `<p>ข้อมูลที่ขาดหาย:</p><ul class="text-left">${missingFields.map(f => `<li>• ${f}</li>`).join('')}</ul>`
                });
                return;
            }

            // เรียกฟังก์ชันบันทึกข้อมูล
            await submitFuneralAssistance(formData);
        });

        // ==================== API Functions ====================

        // ค้นหาครัวเรือน
        async function searchHouseholds(query) {
            try {
                const response = await fetch(`/employee/funeral-assistance/search?query=${encodeURIComponent(query)}`);
                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    displayDropdown(result.data, query);
                } else {
                    showNoResults();
                }
            } catch (error) {
                console.error('Error searching households:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถค้นหาครัวเรือนได้'
                });
            }
        }

        // ตรวจสอบคุณสมบัติ
        async function checkEligibility(familyID) {
            try {
                const response = await fetch(`/employee/funeral-assistance/eligibility/${familyID}`);
                const result = await response.json();

                if (result.success) {
                    displayEligibilityCheck(result.data);
                }
            } catch (error) {
                console.error('Error checking eligibility:', error);
            }
        }

        // คำนวณเงินฌาปนกิจ
        async function calculateFuneralAmount(amount) {
            try {
                const response = await fetch('/employee/funeral-assistance/calculate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ amount })
                });

                const result = await response.json();

                if (result.success) {
                    displayCalculation(result.data);
                }
            } catch (error) {
                console.error('Error calculating funeral amount:', error);
            }
        }

        // แสดง Preview รายการหัก
        async function showDeductionPreview(formData) {
            try {
                // แสดง loading
                Swal.fire({
                    title: 'กำลังคำนวณ...',
                    text: 'โปรดรอสักครู่',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/employee/funeral-assistance/preview', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (result.success) {
                    // แสดง confirmation dialog พร้อมรายละเอียด
                    await showConfirmationDialog(result.data, formData);
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: result.message
                    });
                }
            } catch (error) {
                console.error('Error getting deduction preview:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถดึงข้อมูลรายการหักได้'
                });
            }
        }

        // แสดง Confirmation Dialog
        async function showConfirmationDialog(previewData, formData) {
            const { summary, accountsToDeduct, disqualifiedAccounts } = previewData;

            const html = `
                <div class="text-left">
                    <div class="mb-4 p-4 bg-blue-50 rounded-lg">
                        <h3 class="font-semibold text-lg mb-2">สรุปการหักเงิน</h3>
                        <div class="space-y-1 text-sm">
                            <p><span class="font-medium">จำนวนเงินรวม:</span> ${summary.totalAmount.toLocaleString()} บาท</p>
                            <p><span class="font-medium">จำนวนบัญชีทั้งหมด:</span> ${summary.totalAccounts} บัญชี</p>
                            <p><span class="font-medium">หักจากบัญชีละ:</span> ${summary.perAccountAmount.toFixed(2)} บาท</p>
                            <p class="text-green-600"><span class="font-medium">บัญชีที่หักได้:</span> ${summary.accountsToDeduct} บัญชี</p>
                            <p class="text-red-600"><span class="font-medium">บัญชีที่ถูกตัดสิทธิ์:</span> ${summary.disqualifiedAccounts} บัญชี</p>
                        </div>
                    </div>

                    ${disqualifiedAccounts.length > 0 ? `
                        <div class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-lg">
                            <h4 class="font-semibold text-sm text-amber-800 mb-2">
                                ⚠️ บัญชีที่ถูกตัดสิทธิ์ (${disqualifiedAccounts.length} บัญชี)
                            </h4>
                            <div class="max-h-32 overflow-y-auto text-xs space-y-1">
                                ${disqualifiedAccounts.slice(0, 5).map(acc => `
                                    <p class="text-gray-700">• ${acc.accountName} (${acc.accountNumber}) - มียอดเพียง ${acc.balanceAtCheck.toFixed(2)} บาท</p>
                                `).join('')}
                                ${disqualifiedAccounts.length > 5 ? `<p class="text-gray-500 italic">และอีก ${disqualifiedAccounts.length - 5} บัญชี...</p>` : ''}
                            </div>
                        </div>
                    ` : ''}

                    <p class="text-sm text-gray-600 mt-4">คุณต้องการดำเนินการหักเงินฌาปนกิจหรือไม่?</p>
                </div>
            `;

            const result = await Swal.fire({
                title: 'ยืนยันการบันทึก',
                html: html,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'ยืนยัน',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#6b7280',
                width: '600px'
            });

            if (result.isConfirmed) {
                await submitFuneralAssistance(formData);
            }
        }

        // ฟังก์ชัน submitFuneralAssistance (แก้ไขให้ส่งข้อมูลตรงกับ Backend)
        async function submitFuneralAssistance(formData) {
            try {
                console.log('📤 Sending data to server...', formData); // Debug
                
                Swal.fire({
                    title: 'กำลังบันทึกข้อมูล...',
                    text: 'โปรดรอสักครู่',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/employee/funeral-assistance/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                console.log('📥 Response status:', response.status); // Debug

                const result = await response.json();
                console.log('📥 Response data:', result); // Debug

                if (result.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'บันทึกสำเร็จ',
                        html: `
                            <p>บันทึกข้อมูลฌาปนกิจสงเคราะห์เรียบร้อยแล้ว</p>
                            <div class="mt-3 text-sm text-gray-600">
                                <p>หักเงินจำนวน: ${result.data.totalDeducted.toFixed(2)} บาท</p>
                                <p>จากบัญชี: ${result.data.accountsDeducted} บัญชี</p>
                                ${result.data.accountsWithInsufficientBalance > 0 ? 
                                    `<p class="text-amber-600 mt-2">⚠️ มีบัญชีที่เงินไม่พอ: ${result.data.accountsWithInsufficientBalance} บัญชี</p>` 
                                    : ''
                                }
                            </div>
                        `,
                        confirmButtonText: 'ดูรายละเอียด'
                    });

                    // Redirect ไปหน้ารายละเอียด
                    // window.location.href = `/employee/funeral-assistance/detail/${result.data.funeralID}`;
                    window.location.href = `/employee/funeralAidHistory`;
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: result.message || 'ไม่สามารถบันทึกข้อมูลได้'
                    });
                }
            } catch (error) {
                console.error('❌ Error submitting funeral assistance:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้ กรุณาลองใหม่อีกครั้ง'
                });
            }
        }

        // ฟังก์ชันรีเซ็ตฟอร์ม
        function resetForm() {
            if (confirm('ต้องการยกเลิกและล้างข้อมูลทั้งหมดหรือไม่?')) {
                document.getElementById('funeralForm').reset();
                clearHouseholdInfo();
                document.getElementById('householdSearch').value = '';
                selectedHousehold = null;
                isEligible = false;
            }
        }

        // ==================== UI Functions ====================

        function displayDropdown(households, searchTerm) {
            householdList.innerHTML = '';
            noResults.classList.add('hidden');
            
            households.forEach(household => {
                const item = document.createElement('div');
                item.className = 'px-4 py-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition-colors';
                
                const idHighlighted = highlightText(household.id, searchTerm);
                const nameHighlighted = highlightText(household.head, searchTerm);
                
                item.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <div class="font-medium text-gray-900">${nameHighlighted}</div>
                            <div class="text-sm text-gray-500 mt-1">
                                <span class="inline-flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                                    </svg>
                                    ${idHighlighted}
                                </span>
                                <span class="mx-2">•</span>
                                <span>${household.address}</span>
                            </div>
                        </div>
                        <div class="ml-3 text-right">
                            <div class="text-xs text-gray-500">สมาชิก</div>
                            <div class="text-sm font-medium text-blue-600">${household.memberCount} คน</div>
                        </div>
                    </div>
                `;
                
                item.addEventListener('click', () => selectHousehold(household));
                householdList.appendChild(item);
            });
            
            householdDropdown.classList.remove('hidden');
        }

        function highlightText(text, searchTerm) {
            if (!searchTerm) return text;
            const regex = new RegExp(`(${searchTerm})`, 'gi');
            return text.replace(regex, '<span class="bg-yellow-200 font-semibold">$1</span>');
        }

        function showNoResults() {
            householdList.innerHTML = '';
            noResults.classList.remove('hidden');
            householdDropdown.classList.remove('hidden');
        }

        function hideDropdown() {
            householdDropdown.classList.add('hidden');
            currentFocusIndex = -1;
        }

        function selectHousehold(household) {
            selectedHousehold = household;
            householdSearchInput.value = `${household.id} - ${household.head}`;
            hideDropdown();
            displayHouseholdInfo(household);
            checkEligibility(household.familyID);
        }

        function clearHouseholdInfo() {
            selectedHousehold = null;
            isEligible = false;
            document.getElementById('householdInfo').classList.add('hidden');
            document.getElementById('eligibilitySection').classList.add('hidden');
            document.getElementById('calculationSection').classList.add('hidden');
        }

        function updateFocus(items) {
            items.forEach((item, index) => {
                if (index === currentFocusIndex) {
                    item.classList.add('bg-blue-50');
                    item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                } else {
                    item.classList.remove('bg-blue-50');
                }
            });
        }

        function displayHouseholdInfo(data) {
            document.getElementById('householdInfo').classList.remove('hidden');
            document.getElementById('householdId').textContent = data.id;
            document.getElementById('householdHead').textContent = data.head;
            document.getElementById('householdAddress').textContent = data.address;
            document.getElementById('memberCount').textContent = data.memberCount + ' คน';
        }

        // ฟังก์ชันแสดงผลการตรวจสอบคุณสมบัติ (อัพเดท: 3 เงื่อนไข)
        function displayEligibilityCheck(data) {
            const eligibilitySection = document.getElementById('eligibilitySection');
            eligibilitySection.classList.remove('hidden');

            console.log('Eligibility Data:', data);

            // สร้าง HTML สำหรับ 3 เงื่อนไข
            const conditionsHTML = `
                <div class="space-y-3">
                    <!-- เงื่อนไข 1: สมัครครบ 180 วัน (6 เดือน) -->
                    <div class="flex items-start bg-white rounded-lg p-4 shadow-sm">
                        <div class="flex-shrink-0 mr-3">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center ${data.passedMembershipPeriod ? 'bg-green-100' : 'bg-red-100'}">
                                <svg class="w-5 h-5 ${data.passedMembershipPeriod ? 'text-green-600' : 'text-red-600'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${data.passedMembershipPeriod ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12'}" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1">
                            <p class="font-medium text-gray-800">เป็นสมาชิกครบ 180 วัน (6 เดือน)</p>
                            <p class="text-sm ${data.passedMembershipPeriod ? 'text-green-600' : 'text-red-600'} mt-1">
                                ${data.passedMembershipPeriod 
                                    ? `✅ ผ่าน - เป็นสมาชิกมา ${data.membershipDays} วัน (${data.membershipMonths} เดือน)` 
                                    : `❌ ไม่ผ่าน - เป็นสมาชิกเพียง ${data.membershipDays} วัน (ต้องครบ 180 วัน)`
                                }
                            </p>
                        </div>
                    </div>

                    <!-- เงื่อนไข 2: ขายขยะครบ 300 บาท -->
                    <div class="flex items-start bg-white rounded-lg p-4 shadow-sm">
                        <div class="flex-shrink-0 mr-3">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center ${data.passedSalesRequirement ? 'bg-green-100' : 'bg-red-100'}">
                                <svg class="w-5 h-5 ${data.passedSalesRequirement ? 'text-green-600' : 'text-red-600'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${data.passedSalesRequirement ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12'}" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1">
                            <p class="font-medium text-gray-800">ขายขยะสะสมครบ 300 บาท</p>
                            <p class="text-sm ${data.passedSalesRequirement ? 'text-green-600' : 'text-red-600'} mt-1">
                                ${data.passedSalesRequirement 
                                    ? `✅ ผ่าน - ขายสะสม ${data.totalSalesAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท` 
                                    : `❌ ไม่ผ่าน - ขายเพียง ${data.totalSalesAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท (ต้องครบ 300 บาท)`
                                }
                            </p>
                        </div>
                    </div>

                    <!-- เงื่อนไข 3: ยอดคงเหลือ >= 300 บาท -->
                    <div class="flex items-start bg-white rounded-lg p-4 shadow-sm">
                        <div class="flex-shrink-0 mr-3">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center ${data.hasActiveBalance ? 'bg-green-100' : 'bg-red-100'}">
                                <svg class="w-5 h-5 ${data.hasActiveBalance ? 'text-green-600' : 'text-red-600'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${data.hasActiveBalance ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12'}" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1">
                            <p class="font-medium text-gray-800">ยอดคงเหลือในบัญชีมากกว่า 300 บาท</p>
                            <p class="text-sm ${data.hasActiveBalance ? 'text-green-600' : 'text-red-600'} mt-1">
                                ${data.hasActiveBalance 
                                    ? `✅ ผ่าน - คงเหลือ ${data.currentBalance.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท` 
                                    : `❌ ไม่ผ่าน - คงเหลือเพียง ${data.currentBalance.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท (สมาชิกถูกพักชั่วคราว)`
                                }
                            </p>
                            ${!data.hasActiveBalance && data.hasEverBeenMember ? 
                                `<p class="text-xs text-orange-600 mt-1">
                                    💡 <strong>วิธีแก้ไข:</strong> นำขยะมาขายให้ยอดคงเหลือเกิน 300 บาท สิทธิ์จะกลับมาทันที
                                </p>` 
                                : ''
                            }
                        </div>
                    </div>

                    <!-- สรุปผลการตรวจสอบ -->
                    <div class="mt-4 p-4 rounded-lg ${data.isEligible ? 'bg-green-100 border-2 border-green-300' : 'bg-red-100 border-2 border-red-300'}">
                        <div class="flex items-center">
                            <svg class="w-6 h-6 mr-2 ${data.isEligible ? 'text-green-600' : 'text-red-600'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${data.isEligible ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' : 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z'}" />
                            </svg>
                            <p class="font-semibold text-lg ${data.isEligible ? 'text-green-800' : 'text-red-800'}">
                                ${data.isEligible 
                                    ? '✅ ครัวเรือนนี้มีสิทธิ์รับเงินช่วยเหลือฌาปนกิจ' 
                                    : '❌ ครัวเรือนนี้ไม่มีสิทธิ์รับเงินช่วยเหลือฌาปนกิจ'
                                }
                            </p>
                        </div>
                        ${!data.isEligible && data.ineligibleReasons && data.ineligibleReasons.length > 0 ? 
                            `<div class="mt-3 ml-8 text-sm text-red-700">
                                <p class="font-medium mb-1">เหตุผล:</p>
                                <ul class="list-disc list-inside space-y-1">
                                    ${data.ineligibleReasons.map(reason => `<li>${reason}</li>`).join('')}
                                </ul>
                            </div>`
                            : ''
                        }
                        ${data.isEligible && data.pendingDeductions > 0 ? 
                            `<div class="mt-3 ml-8 text-sm text-amber-700 bg-amber-50 rounded p-2">
                                <p class="font-medium">⚠️ หมายเหตุ: มีเงินค้างหัก ${data.pendingDeductions.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</p>
                            </div>`
                            : ''
                        }
                    </div>
                </div>
            `;

            // แทนที่ HTML เดิมด้วย HTML ใหม่
            document.getElementById('eligibilitySection').querySelector('.space-y-3').innerHTML = conditionsHTML;

            // อัพเดท global variable
            isEligible = data.isEligible;
        }

        function updateConditionStatus(conditionId, pass, detail) {
            const icon = document.getElementById(conditionId + 'Icon');
            const detailElement = document.getElementById(conditionId + 'Detail');

            if (pass) {
                icon.className = 'w-8 h-8 rounded-full flex items-center justify-center bg-green-100';
                icon.innerHTML = '<svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
            } else {
                icon.className = 'w-8 h-8 rounded-full flex items-center justify-center bg-red-100';
                icon.innerHTML = '<svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
            }

            detailElement.textContent = detail;
        }

        function updateEligibilityResult(eligible) {
            const resultDiv = document.getElementById('eligibilityResult');
            const resultIcon = document.getElementById('resultIcon');
            const resultText = document.getElementById('resultText');

            if (eligible) {
                resultDiv.className = 'mt-4 p-4 rounded-lg bg-green-100 border-2 border-green-300';
                resultIcon.className = 'w-6 h-6 mr-2 text-green-600';
                resultIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />';
                resultText.textContent = 'ครัวเรือนนี้มีสิทธิ์รับเงินช่วยเหลือฌาปนกิจ';
                resultText.className = 'font-semibold text-lg text-green-800';
            } else {
                resultDiv.className = 'mt-4 p-4 rounded-lg bg-red-100 border-2 border-red-300';
                resultIcon.className = 'w-6 h-6 mr-2 text-red-600';
                resultIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />';
                resultText.textContent = 'ครัวเรือนนี้ไม่มีสิทธิ์รับเงินช่วยเหลือฌาปนกิจ';
                resultText.className = 'font-semibold text-lg text-red-800';
            }
        }

        function displayCalculation(data) {
            const calculationSection = document.getElementById('calculationSection');
            calculationSection.classList.remove('hidden');

            // อัพเดทข้อมูล
            document.getElementById('totalAmount').textContent = data.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';
            document.getElementById('totalAccounts').textContent = data.totalAccounts.toLocaleString() + ' บัญชี';
            document.getElementById('perAccountAmount').textContent = data.perAccountAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';

            // อัพเดทการคำนวณ
            document.getElementById('calc1').textContent = data.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2});
            document.getElementById('calc2').textContent = data.totalAccounts.toLocaleString();
            document.getElementById('calc3').textContent = data.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2});
            document.getElementById('calc4').textContent = data.totalAccounts.toLocaleString();
            document.getElementById('calc5').textContent = data.perAccountAmount.toLocaleString('th-TH', {minimumFractionDigits: 2});

            document.getElementById('beforeBalance').textContent = data.totalBalance.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';
            document.getElementById('afterBalance').textContent = data.afterBalance.toLocaleString('th-TH', {minimumFractionDigits: 2}) + ' บาท';
        }
    </script>
    
</body>
</html>