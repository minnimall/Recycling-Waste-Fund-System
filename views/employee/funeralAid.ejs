        // ฟังก์ชันเติมข้อมูลใน dropdown
        function populateMemberDropdowns() {
            const responsibleSelect = document.getElementById('responsiblePersonName');
            const deceasedSelect = document.getElementById('deceasedName');

            // ล้างข้อมูลเดิม
            responsibleSelect.innerHTML = '<option value="">-- เลือกผู้รับผิดชอบ --</option>';
            deceasedSelect.innerHTML = '<option value="">-- เลือกผู้เสียชีวิต --</option>';

            // เพิ่ม options
            householdMembers.forEach(member => {
                const option1 = new Option(
                    `${member.name}${member.relation ? ' (' + member.relation + ')' : ''}`,
                    member.name
                );
                option1.dataset.memberId = member._id;
                option1.dataset.memberType = member.type;

                const option2 = option1.cloneNode(true);

                responsibleSelect.appendChild(option1);
                deceasedSelect.appendChild(option2);
            });
        }

        // Event listeners สำหรับป้องกันการเลือกซ้ำ
        document.getElementById('responsiblePersonName').addEventListener('change', function() {
            const selectedId = this.options[this.selectedIndex].dataset.memberId;
            document.getElementById('responsiblePersonId').value = selectedId;
            
            const deceasedSelect = document.getElementById('deceasedName');
            const deceasedId = document.getElementById('deceasedId').value;
            
            if (selectedId && selectedId === deceasedId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่สามารถเลือกได้',
