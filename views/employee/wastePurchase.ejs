<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wastePurchase.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        $(document).ready(function() {
            $('#accountId').select2({
                placeholder: "-- เลือกรหัสบัญชี --",
                allowClear: true
            });
        });
    </script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    
    <div class="content bg-gray-50 min-screen">
        <div class="flex gap-6 p-6">
            <!-- ฝั่งซ้าย: รายการขยะ -->
            <div class="border p-4 rounded-lg shadow-lg left-box bg-white border h-[750px] flex flex-col">
                <div class="flex justify-between items-center mb-5 flex-shrink-0">
                    <h2 class="text-lg font-bold mb-4">เลือกรายการขยะ</h2>
                    <div class="flex items-center gap-4">
                        <!-- ปุ่มเปลี่ยน Layout -->
                        <div class="flex gap-2">
                            <button id="cardViewBtn" class="px-3 py-2 bg-blue-500 text-white rounded text-sm" onclick="showCardView()">
                                การ์ด
                            </button>
                            <button id="tableViewBtn" class="px-3 py-2 bg-gray-300 text-gray-700 rounded text-sm" onclick="showTableView()">
                                ตาราง
                            </button>
                        </div>
                        
                        <div class="">
                            <!-- ช่องค้นหากิจกรรม -->
                            <form action="/employee/wastePurchase" method="GET" class="">
                                <select name="wasteType" class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    <option value="">เลือกประเภทขยะ</option>
                                    <% wasteTypes.forEach((type) => { %>
                                        <option value="<%= type._id %>" <%= selectedWasteType === type._id.toString() ? 'selected' : '' %>>
                                            <%= type.wasteTypeName %>
                                        </option>
                                    <% }); %>
                                </select>
                                <input type="text" name="search" value="<%= searchQuery %>" placeholder="ค้นหาขยะ" class="px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                                <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                    <i class="fas fa-search mr-2"></i>ค้นหา
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Optional: Stats or Info Bar -->
                <div class="mt-4 pt-4 border-t border-gray-200 mb-5 flex-shrink-0">
                    <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-gray-600">
                        <div class="flex items-center gap-4">
                            <p class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                                รายการขยะทั้งหมด <span class="text-blue-600 text-base font-normal"><%= waste.length %> รายการ</span>
                            </p>
                            <% if (searchQuery) { %>
                                <span class="flex items-center gap-1">
                                    <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                                    ผลการค้นหา: "<%= searchQuery %>"
                                </span>
                            <% } %>
                        </div>
                        <!-- <div class="text-xs text-gray-500">
                            อัพเดทล่าสุด: <%= new Date().toLocaleDateString('th-TH') %>
                        </div> -->
                    </div>
                </div>

                <!-- แบบตาราง -->
                <div id="tableView" class="flex-1 overflow-hidden" style="display: none;">
                    <div class="h-full overflow-y-auto border border-gray-200 rounded-lg">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-100 sticky top-0 z-10">
                                <tr>
                                    <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase w-[10%]">ลำดับ</th>
                                    <th class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-700 uppercase w-[40%]">ชื่อรายการขยะ</th>
                                    <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase w-[25%]">ราคา/กก. (บาท)</th>
                                    <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-700 uppercase w-[25%]">น้ำหนัก (กก.)</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (waste.length > 0) { %>
                                    <% waste.forEach((item, index) => { %>
                                        <tr class="hover:bg-gray-50" id="waste-row-<%= index %>">
                                            <td class="px-6 py-4 text-center text-sm text-gray-900"><%= index + 1 %></td>
                                            <td class="px-6 py-4 text-sm text-gray-900 text-left">
                                                <div class="flex items-center gap-3">
                                                    <img class="w-10 h-10 object-cover rounded" src="<%= item.img %>" alt="รูป <%= item.wasteName %>">
                                                    <%= item.wasteName %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-sm text-center text-gray-900"><%= item.pricePerUnit %></td>
                                            <td class="px-6 py-4 text-sm text-center">
                                                <input type="number" min="0.1" step="0.1" placeholder="0.0" class="weight-input w-24 px-2 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                                                    id="table-weight-<%= index %>" data-index="<%= index %>" data-name="<%= item.wasteName %>" data-price="<%= item.pricePerUnit %>" data-layout="table"
                                                    oninput="handleWeightInput('<%= index %>', 'table')"
                                                    onblur="handleWeightBlur('<%= index %>', 'table')"
                                                >
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-6 py-10 text-center text-gray-500">- ยังไม่มีข้อมูล -</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- แบบการ์ด -->
                <div id="cardView" class="flex-1 overflow-hidden" style="display: block;">
                    <div class="h-full overflow-y-auto border border-gray-200 rounded-lg p-4">
                        <div class="grid grid-cols-5 gap-4">
                            <% if (waste.length > 0) { %>
                                <% waste.forEach((item, index) => { %>
                                    <div class="border p-3 rounded-lg shadow-md h-auto" id="waste-card-<%= index %>">
                                        <img class="w-full h-32 object-cover mb-2 rounded" src="<%= item.img %>" alt="รูป <%= item.wasteName %>">
                                        <p class="text-center font-semibold mb-2 text-sm"><%= item.wasteName %></p>
                                        <p class="text-center text-xs text-gray-500 mb-3">฿ <%= item.pricePerUnit %> บาท/กก.</p>
                                        <div class="space-y-2">
                                            <input type="number" min="0.1" step="0.1" placeholder="น้ำหนัก (กก.)" class="w-full p-2 text-sm border rounded weight-input focus:outline-none focus:ring-2 focus:ring-blue-400"
                                                id="card-weight-<%= index %>" data-index="<%= index %>" data-name="<%= item.wasteName %>" data-price="<%= item.pricePerUnit %>" data-layout="card"
                                                oninput="handleWeightInput('<%= index %>', 'card')"
                                                onblur="handleWeightBlur('<%= index %>', 'card')"
                                            >
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="col-span-5 mt-3 no-data-container text-center">
                                    <span class="text-gray-500">- ยังไม่มีข้อมูล -</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>           

            <!-- ฝั่งขวา: ฟอร์มและรายการขยะที่เลือก -->
            <div class="border p-4 rounded-lg shadow-lg right-box bg-white border ">
                <h2 class="text-xl font-semibold mb-4">ฟอร์มรับซื้อขยะ</h2>
                <form id="wastePurchaseForm" action="/employee/wastePurchasePost" method="POST">
                    <input type="hidden" name="addBy" value="<%= username %>">
                    <label class="text-base font-semibold block mb-2">รหัสบัญชี:</label>
                    <div class="relative">
                        <select name="accountId" id="accountId" class="w-full p-2 border rounded mb-1" required>
                            <option value="">-- เลือกรหัสบัญชี --</option>
                            <% if (allWasteBankAccount && allWasteBankAccount.length > 0) { %>
                                <% allWasteBankAccount.forEach((account) => { %>
                                    <option value="<%= account._id %>" data-account-number="<%= account.AccountNumber %>" data-account-name="<%= account.AccountName %>">
                                        <%= account.AccountNumber %> - <%= account.AccountName %>
                                    </option>
                                <% }); %>
                            <% } else { %>
                                <option value="" disabled>-- ยังไม่มีบัญชีผู้ใช้ --</option>
                            <% } %>
                        </select>
                    </div>
                    
                    <p><span class="text-total">ยอดรวม</span> <span id="totalAmount">0.00</span> <span class="text-unit">บาท</span></p>
                    <button type="button" class="mt-1 mb-2 bg-green-500 text-white px-4 py-2 rounded" onclick="openConfirmModal('<%= username %>')">ยืนยันการรับซื้อ</button>
            
                    <h3 class="text-lg mb-2">รายการที่เลือก</h3>
                    <ul id="selectedWasteList" class="mb-4">
                    </ul>
                    <input type="hidden" name="wasteItems" id="wasteItemsInput">
                </form>
            </div>

            <!-- Modal ยืนยันการรับซื้อ -->
            <div id="confirmModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
                <form class="bg-white p-3 w-1/2 rounded-lg" action="" method="POST">
                    <input type="hidden" name="accountId" class="w-full p-2 border rounded mb-1" required>

                    <ul id="selectedWasteList" class="hidden" >
                    </ul>
                    <input type="hidden" name="wasteItems" id="wasteItemsInput">
                    <h2 class="text-xl font-medium leading-6 text-gray-800">รายการการรับซื้อ</h2>
                    <hr class="my-3">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">รหัสบัญชี</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">ชื่อ-สกุล</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">วันที่รับซื้อ</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">เวลา</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">พนักงาน</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200" id="user-lists">
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-center" id="accountId"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-left" id="accountName"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-center" id="purchaseDate"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-center" id="purchaseTime"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-center" id="employeePost"></td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">ลำดับที่</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">ชื่อสินค้า</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">จำนวน/หน่วย</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">ราคา/หน่วย</th>
                                <th class="px-6 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">ยอดรวม(฿)</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200" id="items-lists">
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="px-6 py-4 text-right">ยอดรวมทั้งหมด</td>
                                <td class="px-6 py-4 text-center" id="totalAmount"></td>
                            </tr>
                        </tfoot>
                    </table>
                    <hr class="my-5">
                    <div class="flex justify-end w-full">
                        <button type="button" onclick="closeConfirmModal()" class="bg-gray-500 text-white px-4 py-2 rounded">ยกเลิก</button>
                        <button type="button" class="main-bg-color text-white px-4 py-2 rounded ml-2" onclick="wastePurchasePost()">ยืนยันการรับซื้อ</button>                     
                    </div>
                </form>
            </div>

        </div>
    </div>
</body>

<script>
    let selectedWaste = [];
    let inputTimeout = {};

    // แก้ไขฟังก์ชัน handleWeightInput
    function handleWeightInput(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        // ตรวจสอบค่าติดลบ
        if (weight < 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'ไม่สามารถกรอกค่าติดลบได้',
                showConfirmButton: false,
                timer: 2000
            });
            weightInput.value = ''; // เคลียร์ค่า
            return;
        }
        
        // ยกเลิก timeout เก่า
        if (inputTimeout[inputId]) {
            clearTimeout(inputTimeout[inputId]);
        }

        // ตั้ง timeout ใหม่ (รอ 1 วินาที)
        inputTimeout[inputId] = setTimeout(() => {
            addWasteFromInput(index, layout);
        }, 500);
    }

    // แก้ไขฟังก์ชัน handleWeightBlur
    function handleWeightBlur(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        
        // ยกเลิก timeout
        if (inputTimeout[inputId]) {
            clearTimeout(inputTimeout[inputId]);
            delete inputTimeout[inputId];
        }

        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        // ตรวจสอบค่าติดลบ
        if (weight <= 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'ไม่สามารถกรอกค่าติดลบได้',
                showConfirmButton: false,
                timer: 2000
            });
            weightInput.value = ''; // เคลียร์ค่า
            return;
        }
        
        if (weight && weight > 0) {
            addWasteFromInput(index, layout);
        }
    }
    // ฟังก์ชันสำหรับเพิ่มขยะจาก input (ทั้ง table และ card)
    function addWasteFromInput(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        if (!weight || weight <= 0) {
            return; // ไม่แสดงเตือนเมื่อไม่มีค่า
        }

        const name = weightInput.dataset.name;
        const pricePerUnit = parseFloat(weightInput.dataset.price);
        const totalPrice = (weight * pricePerUnit).toFixed(2);

        // ตรวจสอบว่ามีสินค้านี้ในรายการแล้วหรือไม่
        const existingIndex = selectedWaste.findIndex(item => item.name === name);
        
        if (existingIndex >= 0) {
            // ถ้ามีแล้ว ให้อัพเดทน้ำหนัก
            selectedWaste[existingIndex].weight = weight;
            selectedWaste[existingIndex].totalPrice = totalPrice;
        } else {
            // ถ้ายังไม่มี ให้เพิ่มใหม่
            selectedWaste.push({ 
                name: name, 
                pricePerUnit: pricePerUnit, 
                weight: weight, 
                totalPrice: totalPrice 
            });
        }

        // Sync ค่าไปยัง layout อื่น
        syncWeightInputs(index, weight, name);

        // อัพเดทรายการ
        updateSelectedWasteList();

        // ล้าง input หลังเพิ่มสำเร็จ (ป้องกันการกดซ้ำ)
        weightInput.value = '';

        // แสดงข้อความสำเร็จ
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: `เพิ่ม ${name} ${weight} กก. แล้ว`,
            showConfirmButton: false,
            timer: 1000
        });
    }

    // ฟังก์ชันสำหรับ sync ค่าระหว่าง layout
    function syncWeightInputs(index, weight, itemName) {
        const tableInput = document.getElementById(`table-weight-${index}`);
        const cardInput = document.getElementById(`card-weight-${index}`);
        
        // ตรวจสอบว่า input elements มีอยู่จริงและเป็นของ item เดียวกัน
        if (tableInput && tableInput.dataset.name === itemName) {
            tableInput.value = weight;
        }
        if (cardInput && cardInput.dataset.name === itemName) {
            cardInput.value = weight;
        }
    }

    function updateSelectedWasteList() {
        const list = document.getElementById('selectedWasteList');
        const items_lists = document.getElementById('items-lists');
        list.innerHTML = '';
        items_lists.innerHTML = '';
        let totalAmount = 0;

        selectedWaste.forEach((item, index) => {
            totalAmount += parseFloat(item.totalPrice);
            const formattedTotalPrice = parseFloat(item.totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            list.innerHTML += `
                <li class="cart">
                    <span><span>${item.name}</span> <br> <span>${item.weight} กก. (฿${formattedTotalPrice})</span></span>
                    <div class="cart-action">
                        <div onclick="editWaste(${index})" class="edit-btn mr-1"><i class="fa fa-edit"></i></div>
                        <div onclick="deleteWaste(${index})" class="delete-btn"><i class="fa fa-trash"></i></div>
                    </div>
                </li>
            `;
            const formattedPricePerUnit = parseFloat(item.pricePerUnit).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            const formattedTotalPriceRow = parseFloat(item.totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            items_lists.innerHTML += `
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-center">${index + 1}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-left">${item.name}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">${item.weight} กก.</td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">${formattedPricePerUnit}฿</td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">${formattedTotalPriceRow}฿</td>
                </tr>
            `;
        });

        const formattedTotalAmount = totalAmount.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        });
        document.getElementById('totalAmount').textContent = formattedTotalAmount;
        document.getElementById('wasteItemsInput').value = JSON.stringify(selectedWaste);
    }

    function editWaste(index) {
        const item = selectedWaste[index];
        const newPrice = (parseFloat(item.weight) * item.pricePerUnit).toFixed(2);

        // สร้าง HTML modal
        const modalHTML = `
            <div id="editWasteModal" class="fixed inset-0 z-50 bg-black bg-opacity-30 hidden">
                <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-md px-4">
                    <form id="editWasteForm" class="bg-white rounded-xl shadow-lg p-8 space-y-6">

                        <!-- หัวฟอร์ม -->
                        <div class="flex items-center space-x-3 border-b pb-4">
                            <ion-icon name="create-outline" class="text-blue-500 text-2xl"></ion-icon>
                            <span class="text-xl font-semibold text-gray-800">แก้ไขรายการขยะ</span>
                        </div>

                        <!-- ชื่อสินค้า (แสดงเท่านั้น) -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">ชื่อสินค้า</label>
                            <div class="w-full bg-gray-50 border border-gray-300 rounded-lg px-4 py-3">
                                <p class="text-gray-800 font-semibold">${item.name}</p>
                            </div>
                        </div>

                        <!-- ราคาต่อหน่วย (แสดงเท่านั้น) -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">ราคาต่อหน่วย</label>
                            <div class="w-full bg-gray-50 border border-gray-300 rounded-lg px-4 py-3">
                                <p class="text-gray-800 font-semibold">฿ ${parseFloat(item.pricePerUnit).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</p>
                            </div>
                        </div>

                        <!-- น้ำหนัก (สามารถแก้ไข) -->
                        <div>
                            <label for="editWeightInput" class="block text-sm font-medium text-gray-700 mb-2">น้ำหนัก (กิโลกรัม) *</label>
                            <input type="number" 
                                id="editWeightInput" 
                                min="0.1" 
                                step="0.1" 
                                value="${item.weight}"
                                placeholder="ระบุน้ำหนัก"
                                required
                                onkeyup="updatePricePreview('${item.pricePerUnit}')"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                        </div>

                        <!-- ยอดรวม (แสดง Preview) -->
                        <div class="bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 rounded-lg px-4 py-4">
                            <p class="text-sm font-medium text-gray-600 mb-1">ยอดรวม</p>
                            <p id="pricePreview" class="text-3xl font-bold text-blue-600">฿ ${newPrice}</p>
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-4">
                            <button type="button" 
                                onclick="closeEditWasteModal()"
                                class="px-6 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200">
                                ยกเลิก
                            </button>
                            <button type="button" 
                                onclick="saveEditWaste(${index})"
                                class="px-6 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition duration-200">
                                บันทึก
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        `;

        // เพิ่ม modal ลงในหน้า (ถ้ายังไม่มี)
        if (!document.getElementById('editWasteModal')) {
            document.body.insertAdjacentHTML('beforeend', modalHTML);
        } else {
            document.getElementById('editWasteModal').remove();
            document.body.insertAdjacentHTML('beforeend', modalHTML);
        }

        // แสดง modal
        const modal = document.getElementById('editWasteModal');
        modal.classList.remove('hidden');

        // ตั้งค่า focus
        const input = document.getElementById('editWeightInput');
        if (input) {
            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);
        }

        // ปิด modal เมื่อคลิกนอก modal
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeEditWasteModal();
            }
        });
    }

    // ฟังก์ชันปิด modal
    function closeEditWasteModal() {
        const modal = document.getElementById('editWasteModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }

    // ฟังก์ชันบันทึกการแก้ไข
    function saveEditWaste(index) {
        const weightInput = document.getElementById('editWeightInput');
        const weight = parseFloat(weightInput.value);

        // ตรวจสอบค่า
        if (!weight || weight <= 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'กรุณากรอกน้ำหนักที่ถูกต้อง',
                showConfirmButton: false,
                timer: 2000
            });
            return;
        }

        // อัพเดท data
        const item = selectedWaste[index];
        const totalPrice = (weight * item.pricePerUnit).toFixed(2);
        
        selectedWaste[index].weight = weight;
        selectedWaste[index].totalPrice = totalPrice;

        // Sync ค่ากลับไปยัง input ต่างๆ
        syncWeightInputs(index, weight, item.name);

        // อัพเดทรายการ
        updateSelectedWasteList();

        // ปิด modal
        closeEditWasteModal();

        // แสดง toast สำเร็จ
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'แก้ไขน้ำหนักสำเร็จ',
            showConfirmButton: false,
            timer: 1500
        });
    }

    // ฟังก์ชัน helper สำหรับ update ราคา preview แบบ real-time
    function updatePricePreview(pricePerUnit) {
        const weightInput = document.getElementById('editWeightInput');
        const pricePreview = document.getElementById('pricePreview');
        
        if (weightInput && pricePreview) {
            const weight = parseFloat(weightInput.value) || 0;
            const totalPrice = (weight * parseFloat(pricePerUnit)).toFixed(2);
            pricePreview.textContent = '฿ ' + parseFloat(totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }
    }

    function deleteWaste(index) {
        const deletedItem = selectedWaste[index];
        selectedWaste.splice(index, 1);
        updateSelectedWasteList();
        
        // เคลียร์ช่องกรอกน้ำหนักของสินค้าที่ถูกลบใน layout ทั้งหมด
        const weightInputs = document.querySelectorAll('.weight-input');
        weightInputs.forEach(input => {
            if (input.dataset.name === deletedItem.name) {
                input.value = '';
            }
        });
        
        // แสดง toast แจ้งเตือนแบบสั้นๆ (ถ้าต้องการ)
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: `ลบ ${deletedItem.name} แล้ว`,
            showConfirmButton: false,
            timer: 1000
        });
    }

    function openConfirmModal(employee) {
        const accountIdInput = document.querySelector("select[name='accountId']");
        const selectedWasteListElem = document.getElementById("selectedWasteList");
        const totalAmountElem = document.getElementById("totalAmount");
        const confirmModal = document.getElementById("confirmModal");

        if (!accountIdInput || !selectedWasteListElem || !totalAmountElem || !confirmModal) {
            console.error("Element not found!");
            return;
        }

        const accountId = accountIdInput.value.trim();
        const selectedWasteList = selectedWasteListElem.innerHTML.trim();
        const totalAmount = totalAmountElem.innerText.trim();

        if (!accountId) {
            Swal.fire("กรุณาเลือกรหัสบัญชี", "", "warning");
            return;
        }

        if (selectedWaste.length === 0) {
            Swal.fire("กรุณาเลือกรายการขยะที่ต้องการรับซื้อ", "", "warning");
            return;
        }

        const now = new Date();
        const options = { timeZone: "Asia/Bangkok", hour12: false };

        const purchaseDate = now.toLocaleDateString("th-TH", options);
        const purchaseTime = now.toLocaleTimeString("th-TH", options);

        // อัปเดตข้อมูลใน ConfirmModal
        document.querySelector("#confirmModal input[name='accountId']").value = accountId;
        const selectedOption = accountIdInput.options[accountIdInput.selectedIndex];
        if (selectedOption) {
            const accountNumber = selectedOption.textContent.split(' - ')[0].trim();
            const accountName = selectedOption.textContent.split(' - ')[1].trim();
            document.querySelector("#confirmModal #accountId").textContent = accountNumber;
            document.querySelector("#confirmModal #accountName").textContent = accountName;
        } else {
            document.querySelector("#confirmModal #accountId").textContent = accountId;
            document.querySelector("#confirmModal #accountName").textContent = "";
        }
        
        document.querySelector("#confirmModal #selectedWasteList").innerHTML = selectedWasteList;
        document.querySelector("#confirmModal #totalAmount").textContent = totalAmount + '฿';
        document.querySelector("#confirmModal #employeePost").textContent = employee;
        document.querySelector("#confirmModal #purchaseDate").textContent = purchaseDate;
        document.querySelector("#confirmModal #purchaseTime").textContent = purchaseTime;

        document.querySelector("#confirmModal #wasteItemsInput").value = JSON.stringify(selectedWaste);
        
        // แสดง ConfirmModal
        confirmModal.classList.remove("hidden");
    }

    function wastePurchasePost() {
        document.getElementById("wastePurchaseForm").submit();
    }

    function closeConfirmModal() {
        document.getElementById("confirmModal").classList.add("hidden");
    }

    // เพิ่ม Enter key support สำหรับช่องกรอกน้ำหนัก
    document.addEventListener('keypress', function(e) {
        if (e.target.classList.contains('weight-input') && e.key === 'Enter') {
            e.preventDefault();
            const index = parseInt(e.target.dataset.index);
            const layout = e.target.dataset.layout;
            const inputId = `${layout}-weight-${index}`;
            
            // ยกเลิก timeout
            if (inputTimeout[inputId]) {
                clearTimeout(inputTimeout[inputId]);
                delete inputTimeout[inputId];
            }
            
            addWasteFromInput(index, layout);
        }
    });

    function showCardView() {
        // ซ่อนตาราง แสดงการ์ด
        document.getElementById("tableView").style.display = "none"
        document.getElementById("cardView").style.display = "block"

        // เปลี่ยนสีปุ่ม
        document.getElementById("cardViewBtn").className = "px-3 py-2 bg-blue-500 text-white rounded text-sm"
        document.getElementById("tableViewBtn").className = "px-3 py-2 bg-gray-300 text-gray-700 rounded text-sm"
    }

    function showTableView() {
        // ซ่อนการ์ด แสดงตาราง
        document.getElementById("cardView").style.display = "none"
        document.getElementById("tableView").style.display = "block"

        // เปลี่ยนสีปุ่ม
        document.getElementById("tableViewBtn").className = "px-3 py-2 bg-blue-500 text-white rounded text-sm"
        document.getElementById("cardViewBtn").className = "px-3 py-2 bg-gray-300 text-gray-700 rounded text-sm"
    }
</script>
</html>