<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wastePurchase.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        $(document).ready(function() {
            $('#accountId').select2({
                placeholder: "-- เลือกรหัสบัญชี --",
                allowClear: true
            });
        });
    </script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    
    <div class="content bg-gray-50 min-h-screen">
        <div class="flex flex-col lg:flex-row gap-4 p-4 lg:p-6">
            <!-- ฝั่งซ้าย: รายการขยะ  -->
            <div id="wasteList" class="order-2 lg:order-1 bg-white rounded-2xl shadow-xl border border-gray-100 min-h-[500px] lg:h-[750px] flex flex-col w-full lg:flex-1 overflow-hidden">
                
                <!-- Header with Gradient Accent -->
                <div class="bg-gradient-to-r from-green-800 to-green-600 px-4 sm:px-6 py-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div class="flex items-center gap-3">
                            <div class="bg-white/20 p-2.5 rounded-xl">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-xl sm:text-2xl font-bold text-white">รับซื้อขยะ</h2>
                                <p class="text-green-100 text-sm hidden sm:block">เลือกรายการและกรอกน้ำหนัก</p>
                            </div>
                        </div>
                        
                        <!-- View Toggle Buttons -->
                        <div class="flex bg-white/20 rounded-xl p-1">
                            <button id="cardViewBtn" class="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white text-green-700 font-medium text-sm transition-all" onclick="showCardView()">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                                </svg>
                                <span class="hidden sm:inline">การ์ด</span>
                            </button>
                            <button id="tableViewBtn" class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 font-medium text-sm transition-all" onclick="showTableView()">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                                </svg>
                                <span class="hidden sm:inline">ตาราง</span>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Toolbar: Search & Filter -->
                <div class="px-4 sm:px-6 py-4 bg-gray-50 border-b border-gray-200">
                    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
                        <!-- Search Box -->
                        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
                            <div class="relative">
                                <input type="text" id="searchInput" placeholder="ค้นหาขยะ..." 
                                    class="w-full sm:w-56 px-4 py-2.5 pl-10 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 text-sm bg-white" 
                                    oninput="filterWasteItems()">
                                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <select id="wasteTypeFilter" 
                                class="px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 text-sm bg-white" 
                                onchange="filterWasteItems()">
                                <option value="">ทุกประเภท</option>
                                <% wasteTypes.forEach((type) => { %>
                                    <option value="<%= type.wasteTypeName %>"><%= type.wasteTypeName %></option>
                                <% }); %>
                            </select>
                            <button type="button" onclick="clearSearch()" 
                                class="px-4 py-2.5 bg-gray-200 text-gray-600 rounded-xl hover:bg-gray-300 transition-colors text-sm font-medium flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                                ล้าง
                            </button>
                        </div>
                        
                        <!-- Stats Badge -->
                        <div class="flex items-center gap-2 bg-green-100 text-green-700 px-4 py-2 rounded-full text-sm font-medium">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                            </svg>
                            <span id="wasteCountBadge"><%= waste.length %> รายการ</span>
                        </div>
                    </div>
                </div>

                <!-- แบบตาราง  -->
                <div id="tableView" class="flex-1 overflow-hidden" style="display: none;">
                    <div class="h-full bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden flex flex-col">
                        
                        <!-- Table Content -->
                        <div class="flex-1 overflow-y-auto">
                            <table class="min-w-full">
                                <thead class="bg-gray-50 sticky top-0 z-10">
                                    <tr>
                                        <th class="px-4 py-3 text-xs font-semibold tracking-wider text-center text-gray-600 uppercase border-b-2 border-green-200 w-[8%]">
                                            <div class="flex items-center justify-center gap-1">
                                                <span>#</span>
                                            </div>
                                        </th>
                                        <th class="px-4 py-3 text-xs font-semibold tracking-wider text-left text-gray-600 uppercase border-b-2 border-green-200 w-[42%]">
                                            <div class="flex items-center gap-2">
                                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                                </svg>
                                                <span>ชื่อรายการขยะ</span>
                                            </div>
                                        </th>
                                        <th class="px-4 py-3 text-xs font-semibold tracking-wider text-center text-gray-600 uppercase border-b-2 border-green-200 w-[25%]">
                                            <div class="flex items-center justify-center gap-1">
                                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                                <span>ราคา/กก.</span>
                                            </div>
                                        </th>
                                        <th class="px-4 py-3 text-xs font-semibold tracking-wider text-center text-gray-600 uppercase border-b-2 border-green-200 w-[25%]">
                                            <div class="flex items-center justify-center gap-1">
                                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                                                </svg>
                                                <span>น้ำหนัก (กก.)</span>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% if (waste.length > 0) { %>
                                        <% waste.forEach((item, index) => { %>
                                            <tr class="hover:bg-green-50/50 transition-colors group" id="waste-row-<%= index %>">
                                                <td class="px-4 py-3 text-center">
                                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 text-gray-600 text-sm font-medium group-hover:bg-green-100 group-hover:text-green-700 transition-colors"><%= index + 1 %></span>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="flex items-center gap-3">
                                                        <img class="w-12 h-12 object-cover rounded-lg shadow-sm border border-gray-200" src="<%= item.img %>" alt="รูป <%= item.wasteName %>">
                                                        <div>
                                                            <p class="font-medium text-gray-800"><%= item.wasteName %></p>
                                                            <p class="text-xs text-gray-400">คลิกเพื่อกรอกน้ำหนัก</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-700 font-semibold text-sm">
                                                        ฿<%= item.pricePerUnit %>
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <input type="number" min="0.1" step="0.1" placeholder="0.0" 
                                                        class="w-24 px-3 py-2 border-2 border-gray-200 rounded-xl text-center font-medium focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 hover:border-green-300 transition-all"
                                                        id="table-weight-<%= index %>" data-index="<%= index %>" data-name="<%= item.wasteName %>" data-price="<%= item.pricePerUnit %>" data-layout="table"
                                                        oninput="handleWeightInput('<%= index %>', 'table')"
                                                        onblur="handleWeightBlur('<%= index %>', 'table')"
                                                    >
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-16 text-center">
                                                <div class="flex flex-col items-center text-gray-400">
                                                    <svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                                    </svg>
                                                    <span class="font-medium">ยังไม่มีข้อมูลขยะ</span>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- แบบการ์ด  -->
                <div id="cardView" class="flex-1 overflow-hidden" style="display: block;">
                    <div class="h-full bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden flex flex-col">
                        
                        <!-- Cards Grid -->
                        <div class="flex-1 overflow-y-auto p-4">
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 lg:gap-4">
                                <% if (waste.length > 0) { %>
                                    <% waste.forEach((item, index) => { %>
                                        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-md hover:shadow-xl hover:border-green-300 transition-all duration-300 group" id="waste-card-<%= index %>">
                                            <!-- Image Container -->
                                            <div class="relative overflow-hidden">
                                                <img class="w-full h-24 sm:h-28 lg:h-32 object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.img %>" alt="รูป <%= item.wasteName %>">
                                                <!-- Price Badge -->
                                                <div class="absolute top-2 right-2 bg-gradient-to-r from-green-700 to-green-600 text-white text-xs px-2 py-1 rounded-full font-semibold shadow-lg">
                                                    ฿<%= item.pricePerUnit %>
                                                </div>
                                            </div>
                                            
                                            <!-- Card Content -->
                                            <div class="p-3">
                                                <p class="font-semibold text-gray-800 text-sm line-clamp-1 mb-2" title="<%= item.wasteName %>"><%= item.wasteName %></p>
                                                <p class="text-xs text-gray-400 mb-3 flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                                                    </svg>
                                                    กรอกน้ำหนัก (กก.)
                                                </p>
                                                <input type="number" min="0.1" step="0.1" placeholder="0.0" 
                                                    class="w-full px-3 py-2 text-sm border-2 border-gray-200 rounded-lg text-center font-medium focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 hover:border-green-300 transition-all"
                                                    id="card-weight-<%= index %>" data-index="<%= index %>" data-name="<%= item.wasteName %>" data-price="<%= item.pricePerUnit %>" data-layout="card"
                                                    oninput="handleWeightInput('<%= index %>', 'card')"
                                                    onblur="handleWeightBlur('<%= index %>', 'card')"
                                                >
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="col-span-full py-16 text-center">
                                        <div class="flex flex-col items-center text-gray-400">
                                            <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                            </svg>
                                            <span class="font-medium text-lg">ยังไม่มีข้อมูลขยะ</span>
                                            <p class="text-sm mt-1">กรุณาเพิ่มรายการขยะในระบบ</p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>           

            <!-- ฝั่งขวา: ฟอร์มและรายการขยะที่เลือก (Desktop Only) -->
            <div id="cartContainer" class="hidden lg:block order-1 lg:order-2 w-full lg:w-80 xl:w-96 lg:sticky lg:top-4 lg:h-fit">
                <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
                    <!-- Cart Header -->
                    <div class="bg-gradient-to-r from-green-800 to-green-600 px-4 py-4">
                        <div class="flex items-center gap-3">
                            <div class="bg-white/20 p-2 rounded-lg">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-white">ตะกร้ารับซื้อ</h2>
                                <p class="text-green-100 text-xs">เพิ่มรายการขยะที่ต้องการรับซื้อ</p>
                            </div>
                        </div>
                    </div>
                    
                    <form id="wastePurchaseForm" action="/employee/wastePurchasePost" method="POST" class="p-4 space-y-4">
                        <input type="hidden" name="addBy" value="<%= username %>">
                        
                        <!-- Account Selector (Searchable Dropdown) -->
                        <div class="relative">
                            <label class="flex items-center gap-2 text-sm font-semibold text-gray-700 mb-2">
                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                เลือกบัญชีลูกค้า
                            </label>
                            
                            <!-- Hidden input for form submission -->
                            <input type="hidden" name="accountId" id="accountId" required>
                            
                            <!-- Custom Dropdown Trigger -->
                            <div id="accountDropdownTrigger" 
                                onclick="toggleAccountDropdown()" 
                                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl cursor-pointer bg-white hover:border-green-400 transition-all flex items-center justify-between group">
                                <div class="flex items-center gap-3 flex-1 min-w-0">
                                    <div class="bg-green-100 p-2 rounded-lg group-hover:bg-green-200 transition-colors">
                                        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                    </div>
                                    <div class="truncate">
                                        <p id="selectedAccountDisplay" class="text-sm text-gray-500">-- เลือกบัญชี --</p>
                                    </div>
                                </div>
                                <svg id="dropdownArrow" class="w-5 h-5 text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                            
                            <!-- Dropdown Panel -->
                            <div id="accountDropdownPanel" class="hidden absolute z-50 w-full mt-2 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden">
                                <!-- Search Input -->
                                <div class="p-3 border-b border-gray-100">
                                    <div class="relative">
                                        <input type="text" id="accountSearchInput" placeholder="ค้นหาบัญชี..." 
                                            class="w-full px-4 py-2.5 pl-10 border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 text-sm"
                                            oninput="filterAccounts()">
                                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                    </div>
                                </div>
                                
                                <!-- Account List -->
                                <div id="accountListContainer" class="max-h-48 overflow-y-auto">
                                    <% if (allWasteBankAccount && allWasteBankAccount.length > 0) { %>
                                        <% allWasteBankAccount.forEach((account) => { %>
                                            <div class="account-option px-4 py-3 hover:bg-green-50 cursor-pointer transition-colors flex items-center gap-3 border-b border-gray-50"
                                                data-id="<%= account._id %>"
                                                data-number="<%= account.AccountNumber %>"
                                                data-name="<%= account.AccountName %>"
                                                onclick="selectAccount(this)">
                                                <div class="bg-gray-100 p-2 rounded-lg">
                                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                    </svg>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-medium text-gray-800 truncate"><%= account.AccountName %></p>
                                                    <p class="text-xs text-gray-500">รหัส: <%= account.AccountNumber %></p>
                                                </div>
                                                <svg class="w-4 h-4 text-green-500 hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
