                            onclick="selectMobileAccount(this)">
                            <div class="bg-gray-100 p-2 rounded-lg">
                                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium text-gray-800"><%= account.AccountName %></p>
                                <p class="text-xs text-gray-500">รหัส: <%= account.AccountNumber %></p>
                            </div>
                            <svg class="w-5 h-5 text-green-500 hidden mobile-check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="px-4 py-12 text-center text-gray-400">
                        <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <p class="text-sm">ยังไม่มีบัญชีผู้ใช้</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Add padding to main content for mobile bottom bar -->
    <style>
        @media (max-width: 1023px) {
            .content {
                padding-bottom: 140px !important;
            }
        }
        @keyframes slide-up {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
        .animate-slide-up {
            animation: slide-up 0.3s ease-out;
        }
    </style>
</body>

<script>
    let selectedWaste = [];
    let inputTimeout = {};

    // ===== Account Dropdown Functions =====
    function toggleAccountDropdown() {
        const panel = document.getElementById('accountDropdownPanel');
        const arrow = document.getElementById('dropdownArrow');
        const trigger = document.getElementById('accountDropdownTrigger');
        
        if (panel.classList.contains('hidden')) {
            panel.classList.remove('hidden');
            arrow.classList.add('rotate-180');
            trigger.classList.add('border-green-400', 'ring-2', 'ring-green-200');
            document.getElementById('accountSearchInput').focus();
        } else {
            closeAccountDropdown();
        }
    }

    function closeAccountDropdown() {
        const panel = document.getElementById('accountDropdownPanel');
        const arrow = document.getElementById('dropdownArrow');
        const trigger = document.getElementById('accountDropdownTrigger');
        
        panel.classList.add('hidden');
        arrow.classList.remove('rotate-180');
        trigger.classList.remove('border-green-400', 'ring-2', 'ring-green-200');
        document.getElementById('accountSearchInput').value = '';
        filterAccounts(); // Reset filter
    }

    function selectAccount(element) {
        const id = element.dataset.id;
        const name = element.dataset.name;
        const number = element.dataset.number;
        
        // Set hidden input value
        document.getElementById('accountId').value = id;
        
        // Update display
        document.getElementById('selectedAccountDisplay').innerHTML = `
            <p class="text-sm font-medium text-gray-800">${name}</p>
            <p class="text-xs text-gray-500">รหัส: ${number}</p>
        `;
        
        // Update check icons
        document.querySelectorAll('.account-option .check-icon').forEach(icon => {
            icon.classList.add('hidden');
        });
        element.querySelector('.check-icon').classList.remove('hidden');
        
        // Update selected styling
        document.querySelectorAll('.account-option').forEach(opt => {
            opt.classList.remove('bg-green-50');
            opt.querySelector('.bg-gray-100, .bg-green-100')?.classList.replace('bg-green-100', 'bg-gray-100');
        });
        element.classList.add('bg-green-50');
        element.querySelector('.bg-gray-100')?.classList.replace('bg-gray-100', 'bg-green-100');
        
        closeAccountDropdown();
    }

    function filterAccounts() {
        const searchText = document.getElementById('accountSearchInput').value.toLowerCase().trim();
        const options = document.querySelectorAll('.account-option');
        const noResults = document.getElementById('noAccountResults');
        let visibleCount = 0;
        
        options.forEach(option => {
            const name = option.dataset.name.toLowerCase();
            const number = option.dataset.number.toLowerCase();
            const isVisible = name.includes(searchText) || number.includes(searchText);
            
            option.style.display = isVisible ? '' : 'none';
            if (isVisible) visibleCount++;
        });
        
        noResults.classList.toggle('hidden', visibleCount > 0);
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
        const dropdown = document.getElementById('accountDropdownPanel');
        const trigger = document.getElementById('accountDropdownTrigger');
        
        if (dropdown && !dropdown.classList.contains('hidden')) {
            if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
                closeAccountDropdown();
            }
        }
    });

    // ===== Mobile Functions =====
    function openMobileCartModal() {
        const modal = document.getElementById('mobileCartModal');
        modal.classList.remove('hidden');
        updateMobileCartList();
        document.body.style.overflow = 'hidden';
    }

    function closeMobileCartModal() {
        const modal = document.getElementById('mobileCartModal');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    function openMobileAccountSelector() {
        const modal = document.getElementById('mobileAccountModal');
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeMobileAccountModal() {
        const modal = document.getElementById('mobileAccountModal');
        modal.classList.add('hidden');
        document.getElementById('mobileAccountSearch').value = '';
        filterMobileAccounts();
        document.body.style.overflow = '';
    }

    function selectMobileAccount(element) {
        const id = element.dataset.id;
        const name = element.dataset.name;
        const number = element.dataset.number;
        
        // Set hidden input value (sync with desktop)
        document.getElementById('accountId').value = id;
        
        // Update mobile display
        document.getElementById('mobileSelectedAccount').textContent = name;
        
        // Update desktop display
        document.getElementById('selectedAccountDisplay').innerHTML = `
            <p class="text-sm font-medium text-gray-800">${name}</p>
            <p class="text-xs text-gray-500">รหัส: ${number}</p>
        `;
        
        // Update check icons
        document.querySelectorAll('.mobile-account-option .mobile-check-icon').forEach(icon => {
            icon.classList.add('hidden');
        });
        element.querySelector('.mobile-check-icon').classList.remove('hidden');
        
        // Update desktop check icons too
        document.querySelectorAll('.account-option .check-icon').forEach(icon => {
            icon.classList.add('hidden');
        });
        const desktopOption = document.querySelector(`.account-option[data-id="${id}"]`);
        if (desktopOption) {
            desktopOption.querySelector('.check-icon').classList.remove('hidden');
        }
        
        closeMobileAccountModal();
    }

    function filterMobileAccounts() {
        const searchText = document.getElementById('mobileAccountSearch').value.toLowerCase().trim();
        const options = document.querySelectorAll('.mobile-account-option');
        
        options.forEach(option => {
            const name = option.dataset.name.toLowerCase();
            const number = option.dataset.number.toLowerCase();
            const isVisible = name.includes(searchText) || number.includes(searchText);
            option.style.display = isVisible ? '' : 'none';
        });
    }

    function clearCart() {
        if (selectedWaste.length === 0) {
            Swal.fire('ตะกร้าว่างเปล่า', 'ไม่มีรายการที่จะลบ', 'info');
            return;
        }
        
        Swal.fire({
            title: 'ล้างตะกร้า?',
            text: 'ต้องการลบรายการทั้งหมดหรือไม่?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'ล้างทั้งหมด',
            cancelButtonText: 'ยกเลิก'
        }).then((result) => {
            if (result.isConfirmed) {
                // Reset all weight inputs
                selectedWaste.forEach(item => {
                    const tableInput = document.querySelector(`input[name="weight-${item.id}"]`);
                    const cardInput = document.querySelector(`input[name="weightCard-${item.id}"]`);
                    if (tableInput) tableInput.value = '';
                    if (cardInput) cardInput.value = '';
                });
                
                selectedWaste = [];
                updateCart();
                updateMobileUI();
                Swal.fire('สำเร็จ', 'ล้างตะกร้าเรียบร้อย', 'success');
            }
        });
    }

    function updateMobileUI() {
        // Update mobile total amount
        const total = selectedWaste.reduce((sum, item) => sum + parseFloat(item.totalPrice || 0), 0);
        const mobileTotalElem = document.getElementById('mobileTotalAmount');
        const mobileModalTotalElem = document.getElementById('mobileModalTotalAmount');
        const mobileCartCountElem = document.getElementById('mobileCartCount');
        
        if (mobileTotalElem) mobileTotalElem.textContent = `฿${total.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
        if (mobileModalTotalElem) mobileModalTotalElem.textContent = `฿${total.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
        if (mobileCartCountElem) mobileCartCountElem.textContent = selectedWaste.length;
    }

    function updateMobileCartList() {
        const listElem = document.getElementById('mobileSelectedWasteList');
        const emptyMsg = document.getElementById('mobileEmptyCartMessage');
        
        if (selectedWaste.length === 0) {
            if (emptyMsg) emptyMsg.classList.remove('hidden');
            if (listElem) listElem.innerHTML = '';
        } else {
            if (emptyMsg) emptyMsg.classList.add('hidden');
            if (listElem) {
                listElem.innerHTML = selectedWaste.map((item, index) => `
                    <li class="bg-white rounded-xl p-4 border border-gray-200 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold text-gray-800 truncate">${item.name}</p>
                                <div class="flex items-center gap-2 mt-1.5">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium">
                                        ${item.weight} กก.
                                    </span>
                                    <span class="text-gray-400">×</span>
                                    <span class="text-gray-600 text-sm">฿${parseFloat(item.pricePerUnit).toLocaleString('th-TH')}</span>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <p class="font-bold text-green-600 text-lg">฿${parseFloat(item.totalPrice).toLocaleString('th-TH', {minimumFractionDigits: 2})}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-100">
                            <button type="button" onclick="editWasteFromMobile(${index})" 
                                class="flex-1 py-2 px-3 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium hover:bg-blue-100 transition-colors flex items-center justify-center gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                แก้ไข
                            </button>
                            <button type="button" onclick="deleteWasteFromMobile(${index})" 
                                class="flex-1 py-2 px-3 bg-red-50 text-red-600 rounded-lg text-sm font-medium hover:bg-red-100 transition-colors flex items-center justify-center gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                ลบ
                            </button>
                        </div>
                    </li>
                `).join('');
            }
        }
        
        updateMobileUI();
    }

    // Edit waste from mobile modal
    function editWasteFromMobile(index) {
        closeMobileCartModal();
        setTimeout(() => {
            editWaste(index);
        }, 300);
    }

    // Delete waste from mobile modal
    function deleteWasteFromMobile(index) {
        const item = selectedWaste[index];
        Swal.fire({
            title: 'ลบรายการ?',
            text: `ต้องการลบ "${item.name}" หรือไม่?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'ลบ',
            cancelButtonText: 'ยกเลิก'
        }).then((result) => {
            if (result.isConfirmed) {
                // Reset weight input
                const wasteData = <%- JSON.stringify(waste.map((w, i) => ({ index: i, name: w.wasteName }))) %>;
                const wasteIndex = wasteData.findIndex(w => w.name === item.name);
                if (wasteIndex >= 0) {
                    const tableInput = document.getElementById(`table-weight-${wasteIndex}`);
                    const cardInput = document.getElementById(`card-weight-${wasteIndex}`);
                    if (tableInput) tableInput.value = '';
                    if (cardInput) cardInput.value = '';
                }
                
                selectedWaste.splice(index, 1);
                updateSelectedWasteList();
                updateMobileCartList();
                
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'ลบรายการแล้ว',
                    showConfirmButton: false,
                    timer: 1500
                });
            }
        });
    }

    // Close mobile modals when clicking outside
    document.getElementById('mobileCartModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeMobileCartModal();
    });
    
    document.getElementById('mobileAccountModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeMobileAccountModal();
    });

    // ข้อมูลขยะสำหรับ Client-side filtering
    const wasteData = <%- JSON.stringify(waste.map((w, i) => ({ index: i, name: w.wasteName, type: w.wasteType?.wasteTypeName || '' }))) %>;

    // ฟังก์ชันค้นหาและกรองขยะ (Client-side)
    function filterWasteItems() {
        const searchText = document.getElementById('searchInput').value.toLowerCase().trim();
        const typeFilter = document.getElementById('wasteTypeFilter').value;

        wasteData.forEach(item => {
            const matchesSearch = item.name.toLowerCase().includes(searchText);
            const matchesType = !typeFilter || item.type === typeFilter;
            const isVisible = matchesSearch && matchesType;

            // ซ่อน/แสดงใน TableView
            const tableRow = document.getElementById(`waste-row-${item.index}`);
            if (tableRow) {
                tableRow.style.display = isVisible ? '' : 'none';
            }

            // ซ่อน/แสดงใน CardView
            const card = document.getElementById(`waste-card-${item.index}`);
            if (card) {
                card.style.display = isVisible ? '' : 'none';
            }
        });

        // อัพเดทจำนวนที่แสดง
        const visibleCount = wasteData.filter(item => {
            const matchesSearch = item.name.toLowerCase().includes(searchText);
            const matchesType = !typeFilter || item.type === typeFilter;
            return matchesSearch && matchesType;
        }).length;
        
        // อัพเดทข้อความจำนวนรายการ (ถ้ามี)
        const countSpan = document.querySelector('.text-blue-600');
        if (countSpan && countSpan.textContent.includes('รายการ')) {
            countSpan.textContent = `${visibleCount} รายการ`;
        }
    }

    // ฟังก์ชันล้างการค้นหา
    function clearSearch() {
        document.getElementById('searchInput').value = '';
        document.getElementById('wasteTypeFilter').value = '';
        filterWasteItems();
    }

    // แก้ไขฟังก์ชัน handleWeightInput
    function handleWeightInput(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        // ตรวจสอบค่าติดลบ
        if (weight < 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'ไม่สามารถกรอกค่าติดลบได้',
                showConfirmButton: false,
                timer: 2000
            });
            weightInput.value = ''; // เคลียร์ค่า
            return;
        }
        
        // ยกเลิก timeout เก่า
        if (inputTimeout[inputId]) {
            clearTimeout(inputTimeout[inputId]);
        }

        // ตั้ง timeout ใหม่ (รอ 1 วินาที)
        inputTimeout[inputId] = setTimeout(() => {
            addWasteFromInput(index, layout);
        }, 500);
    }

    // แก้ไขฟังก์ชัน handleWeightBlur
    function handleWeightBlur(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        
        // ยกเลิก timeout
        if (inputTimeout[inputId]) {
            clearTimeout(inputTimeout[inputId]);
            delete inputTimeout[inputId];
        }

        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        // ตรวจสอบค่าติดลบ
        if (weight <= 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'ไม่สามารถกรอกค่าติดลบได้',
                showConfirmButton: false,
                timer: 2000
            });
            weightInput.value = ''; // เคลียร์ค่า
            return;
        }
        
        if (weight && weight > 0) {
            addWasteFromInput(index, layout);
        }
    }
    // ฟังก์ชันสำหรับเพิ่มขยะจาก input (ทั้ง table และ card)
    function addWasteFromInput(index, layout) {
        const inputId = `${layout}-weight-${index}`;
        const weightInput = document.getElementById(inputId);
        const weight = parseFloat(weightInput.value);
        
        if (!weight || weight <= 0) {
            return; // ไม่แสดงเตือนเมื่อไม่มีค่า
        }

        const name = weightInput.dataset.name;
        const pricePerUnit = parseFloat(weightInput.dataset.price);
        const totalPrice = (weight * pricePerUnit).toFixed(2);

        // ตรวจสอบว่ามีสินค้านี้ในรายการแล้วหรือไม่
        const existingIndex = selectedWaste.findIndex(item => item.name === name);
        
        if (existingIndex >= 0) {
            // ถ้ามีแล้ว ให้อัพเดทน้ำหนัก
            selectedWaste[existingIndex].weight = weight;
            selectedWaste[existingIndex].totalPrice = totalPrice;
        } else {
            // ถ้ายังไม่มี ให้เพิ่มใหม่
            selectedWaste.push({ 
                name: name, 
                pricePerUnit: pricePerUnit, 
                weight: weight, 
                totalPrice: totalPrice 
            });
        }

        // Sync ค่าไปยัง layout อื่น
        syncWeightInputs(index, weight, name);

        // อัพเดทรายการ
        updateSelectedWasteList();



        // แสดงข้อความสำเร็จ
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: `เพิ่ม ${name} ${weight} กก. แล้ว`,
            showConfirmButton: false,
            timer: 1000
        });
    }

    // ฟังก์ชันสำหรับ sync ค่าระหว่าง layout
    function syncWeightInputs(index, weight, itemName) {
        const tableInput = document.getElementById(`table-weight-${index}`);
        const cardInput = document.getElementById(`card-weight-${index}`);
        
        // ตรวจสอบว่า input elements มีอยู่จริงและเป็นของ item เดียวกัน
        if (tableInput && tableInput.dataset.name === itemName) {
            tableInput.value = weight;
        }
        if (cardInput && cardInput.dataset.name === itemName) {
            cardInput.value = weight;
        }
    }

    function updateSelectedWasteList() {
        const list = document.getElementById('selectedWasteList');
        const items_lists = document.getElementById('items-lists');
        const emptyMessage = document.getElementById('emptyCartMessage');
        list.innerHTML = '';
        items_lists.innerHTML = '';
        let totalAmount = 0;

        // Show/hide empty cart message
        if (selectedWaste.length === 0) {
            if (emptyMessage) emptyMessage.style.display = 'flex';
        } else {
            if (emptyMessage) emptyMessage.style.display = 'none';
        }

        selectedWaste.forEach((item, index) => {
            totalAmount += parseFloat(item.totalPrice);
            const formattedTotalPrice = parseFloat(item.totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            list.innerHTML += `
                <li class="p-3 hover:bg-gray-100 transition-colors group">
                    <div class="flex items-center justify-between">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-800 truncate">${item.name}</div>
                            <div class="text-sm text-gray-500 flex items-center gap-2 mt-1">
                                <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-xs font-medium">${item.weight} กก.</span>
                                <span class="text-green-600 font-semibold">฿${formattedTotalPrice}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1 opacity-60 group-hover:opacity-100 transition-opacity">
                            <button type="button" onclick="editWaste(${index})" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="แก้ไข">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </button>
                            <button type="button" onclick="deleteWaste(${index})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="ลบ">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </li>
            `;
            const formattedPricePerUnit = parseFloat(item.pricePerUnit).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            const formattedTotalPriceRow = parseFloat(item.totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            items_lists.innerHTML += `
                <div class="px-4 py-3 hover:bg-gray-50 transition-colors">
                    <!-- Desktop Layout (Grid) -->
                    <div class="hidden sm:grid grid-cols-12 gap-2 items-center">
                        <div class="col-span-1 text-center text-gray-500 font-medium">${index + 1}</div>
                        <div class="col-span-5 font-medium text-gray-800">${item.name}</div>
                        <div class="col-span-2 text-center text-gray-600">${item.weight} กก.</div>
                        <div class="col-span-2 text-center text-gray-600">${formattedPricePerUnit}฿</div>
                        <div class="col-span-2 text-right font-semibold text-green-700">${formattedTotalPriceRow}฿</div>
                    </div>
                    <!-- Mobile Layout (Card) -->
                    <div class="sm:hidden flex justify-between items-start">
                        <div class="flex-1">
                            <div class="font-medium text-gray-800">${index + 1}. ${item.name}</div>
                            <div class="text-sm text-gray-500 mt-1">${item.weight} กก. × ${formattedPricePerUnit}฿</div>
                        </div>
                        <div class="font-semibold text-green-700 text-lg">${formattedTotalPriceRow}฿</div>
                    </div>
                </div>
            `;
        });

        const formattedTotalAmount = totalAmount.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        });
        document.getElementById('totalAmount').textContent = formattedTotalAmount;
        document.getElementById('wasteItemsInput').value = JSON.stringify(selectedWaste);
        
        // Update mobile UI
        updateMobileUI();
    }

    function editWaste(index) {
        const item = selectedWaste[index];
        const newPrice = (parseFloat(item.weight) * item.pricePerUnit).toFixed(2);

        // สร้าง HTML modal
        const modalHTML = `
            <div id="editWasteModal" class="fixed inset-0 z-50 bg-black bg-opacity-30 hidden">
                <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-xl px-4">
                    <form id="editWasteForm" class="bg-white rounded-xl shadow-lg p-8 space-y-6">

                        <!-- หัวฟอร์ม -->
                        <div class="flex items-center space-x-3 border-b pb-4">
                            <ion-icon name="create-outline" class="text-blue-500 text-2xl"></ion-icon>
                            <span class="text-xl font-semibold text-gray-800">แก้ไขรายการขยะ</span>
                        </div>

                        <!-- ชื่อสินค้า (แสดงเท่านั้น) -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">ชื่อสินค้า</label>
                            <div class="w-full bg-gray-50 border border-gray-300 rounded-lg px-4 py-3">
                                <p class="text-gray-800 font-semibold">${item.name}</p>
                            </div>
                        </div>

                        <!-- ราคาต่อหน่วย (แสดงเท่านั้น) -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">ราคาต่อหน่วย</label>
                            <div class="w-full bg-gray-50 border border-gray-300 rounded-lg px-4 py-3">
                                <p class="text-gray-800 font-semibold">฿ ${parseFloat(item.pricePerUnit).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</p>
                            </div>
                        </div>

                        <!-- น้ำหนัก (สามารถแก้ไข) -->
                        <div>
                            <label for="editWeightInput" class="block text-sm font-medium text-gray-700 mb-2">น้ำหนัก (กิโลกรัม) *</label>
                            <input type="number" 
                                id="editWeightInput" 
                                min="0.1" 
                                step="0.1" 
                                value="${item.weight}"
                                placeholder="ระบุน้ำหนัก"
                                required
                                onkeyup="updatePricePreview('${item.pricePerUnit}')"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                        </div>

                        <!-- ยอดรวม (แสดง Preview) -->
                        <div class="bg-gradient-to-r from-blue-50 to-blue-100 border border-blue-200 rounded-lg px-4 py-4">
                            <p class="text-sm font-medium text-gray-600 mb-1">ยอดรวม</p>
                            <p id="pricePreview" class="text-3xl font-bold text-blue-600"> ${newPrice} บาท</p>
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-4">
                            <button type="button" 
                                onclick="closeEditWasteModal()"
                                class="px-6 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200">
                                ยกเลิก
                            </button>
                            <button type="button" 
                                onclick="saveEditWaste(${index})"
                                class="px-6 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition duration-200">
                                บันทึก
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        `;

        // เพิ่ม modal ลงในหน้า (ถ้ายังไม่มี)
        if (!document.getElementById('editWasteModal')) {
            document.body.insertAdjacentHTML('beforeend', modalHTML);
        } else {
            document.getElementById('editWasteModal').remove();
            document.body.insertAdjacentHTML('beforeend', modalHTML);
        }

        // แสดง modal
        const modal = document.getElementById('editWasteModal');
        modal.classList.remove('hidden');

        // ตั้งค่า focus
        const input = document.getElementById('editWeightInput');
        if (input) {
            setTimeout(() => {
                input.focus();
                input.select();
            }, 100);
        }

        // ปิด modal เมื่อคลิกนอก modal
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeEditWasteModal();
            }
        });
    }

    // ฟังก์ชันปิด modal
    function closeEditWasteModal() {
        const modal = document.getElementById('editWasteModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }

    // ฟังก์ชันบันทึกการแก้ไข
    function saveEditWaste(index) {
        const weightInput = document.getElementById('editWeightInput');
        const weight = parseFloat(weightInput.value);

        // ตรวจสอบค่า
        if (!weight || weight <= 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'กรุณากรอกน้ำหนักที่ถูกต้อง',
                showConfirmButton: false,
                timer: 2000
            });
            return;
        }

        // อัพเดท data
        const item = selectedWaste[index];
        const totalPrice = (weight * item.pricePerUnit).toFixed(2);
        
        selectedWaste[index].weight = weight;
        selectedWaste[index].totalPrice = totalPrice;

        // Sync ค่ากลับไปยัง input ต่างๆ
        syncWeightInputs(index, weight, item.name);

        // อัพเดทรายการ
        updateSelectedWasteList();

        // ปิด modal
        closeEditWasteModal();

        // แสดง toast สำเร็จ
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'แก้ไขน้ำหนักสำเร็จ',
            showConfirmButton: false,
            timer: 1500
        });
    }

    // ฟังก์ชัน helper สำหรับ update ราคา preview แบบ real-time
    function updatePricePreview(pricePerUnit) {
        const weightInput = document.getElementById('editWeightInput');
        const pricePreview = document.getElementById('pricePreview');
        
        if (weightInput && pricePreview) {
            const weight = parseFloat(weightInput.value) || 0;
            const totalPrice = (weight * parseFloat(pricePerUnit)).toFixed(2);
            pricePreview.textContent = '฿ ' + parseFloat(totalPrice).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }
    }

    function deleteWaste(index) {
        const deletedItem = selectedWaste[index];
        selectedWaste.splice(index, 1);
        updateSelectedWasteList();
        
        // เคลียร์ช่องกรอกน้ำหนักของสินค้าที่ถูกลบใน layout ทั้งหมด
        const weightInputs = document.querySelectorAll('.weight-input');
        weightInputs.forEach(input => {
            if (input.dataset.name === deletedItem.name) {
                input.value = '';
            }
        });
        
        // แสดง toast แจ้งเตือนแบบสั้นๆ (ถ้าต้องการ)
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: `ลบ ${deletedItem.name} แล้ว`,
            showConfirmButton: false,
            timer: 1000
        });
    }

    function openConfirmModal(employee) {
        const accountIdInput = document.getElementById("accountId");
        const selectedWasteListElem = document.getElementById("selectedWasteList");
        const totalAmountElem = document.getElementById("totalAmount");
        const confirmModal = document.getElementById("confirmModal");

        if (!accountIdInput || !selectedWasteListElem || !totalAmountElem || !confirmModal) {
            console.error("Element not found!");
            return;
        }

        const accountId = accountIdInput.value.trim();
        const selectedWasteList = selectedWasteListElem.innerHTML.trim();
        const totalAmount = totalAmountElem.innerText.trim();

        if (!accountId) {
            Swal.fire("กรุณาเลือกรหัสบัญชี", "", "warning");
            return;
        }

        if (selectedWaste.length === 0) {
            Swal.fire("กรุณาเลือกรายการขยะที่ต้องการรับซื้อ", "", "warning");
            return;
        }

        const now = new Date();
        const options = { timeZone: "Asia/Bangkok", hour12: false };

        const purchaseDate = now.toLocaleDateString("th-TH", options);
        const purchaseTime = now.toLocaleTimeString("th-TH", options);

        // อัปเดตข้อมูลใน ConfirmModal
        document.querySelector("#confirmModal input[name='accountId']").value = accountId;
        
        // Get account info from selected option in custom dropdown
        const selectedAccountOption = document.querySelector(`.account-option[data-id="${accountId}"]`);
        if (selectedAccountOption) {
            const accountNumber = selectedAccountOption.dataset.number;
            const accountName = selectedAccountOption.dataset.name;
            document.querySelector("#confirmModal #accountId").textContent = accountNumber;
            document.querySelector("#confirmModal #accountName").textContent = accountName;
        } else {
            document.querySelector("#confirmModal #accountId").textContent = accountId;
            document.querySelector("#confirmModal #accountName").textContent = "";
        }
        
        document.querySelector("#confirmModal #selectedWasteList").innerHTML = selectedWasteList;
        document.querySelector("#confirmModal #totalAmount").textContent = totalAmount + '฿';
        document.querySelector("#confirmModal #employeePost").textContent = employee;
        document.querySelector("#confirmModal #purchaseDate").textContent = purchaseDate;
        document.querySelector("#confirmModal #purchaseTime").textContent = purchaseTime;

        document.querySelector("#confirmModal #wasteItemsInput").value = JSON.stringify(selectedWaste);
        
        // แสดง ConfirmModal
        confirmModal.classList.remove("hidden");
    }

    function wastePurchasePost() {
        document.getElementById("wastePurchaseForm").submit();
    }

    function closeConfirmModal() {
        document.getElementById("confirmModal").classList.add("hidden");
    }

    // เพิ่ม Enter key support สำหรับช่องกรอกน้ำหนัก
    document.addEventListener('keypress', function(e) {
        if (e.target.classList.contains('weight-input') && e.key === 'Enter') {
            e.preventDefault();
            const index = parseInt(e.target.dataset.index);
            const layout = e.target.dataset.layout;
            const inputId = `${layout}-weight-${index}`;
            
            // ยกเลิก timeout
            if (inputTimeout[inputId]) {
                clearTimeout(inputTimeout[inputId]);
                delete inputTimeout[inputId];
            }
            
            addWasteFromInput(index, layout);
        }
    });

    function showCardView() {
        // ซ่อนตาราง แสดงการ์ด
        document.getElementById("tableView").style.display = "none"
        document.getElementById("cardView").style.display = "block"

        // เปลี่ยนสีปุ่ม - Card View เป็น Active
        document.getElementById("cardViewBtn").className = "flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white text-green-700 font-medium text-sm transition-all"
        document.getElementById("tableViewBtn").className = "flex items-center gap-1.5 px-4 py-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 font-medium text-sm transition-all"
    }

    function showTableView() {
        // ซ่อนการ์ด แสดงตาราง
        document.getElementById("cardView").style.display = "none"
        document.getElementById("tableView").style.display = "block"

        // เปลี่ยนสีปุ่ม - Table View เป็น Active
        document.getElementById("tableViewBtn").className = "flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white text-green-700 font-medium text-sm transition-all"
        document.getElementById("cardViewBtn").className = "flex items-center gap-1.5 px-4 py-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 font-medium text-sm transition-all"
    }
</script>
</html>