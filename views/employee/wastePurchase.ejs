<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wastePurchase.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <div class="content">
        <div class="flex gap-6 p-6">
            <!-- ฝั่งซ้าย: รายการขยะ -->
            <div class="w-1/2 border p-4 rounded-lg shadow-lg">
                <h2 class="text-lg font-bold mb-4">เลือกขยะรีไซเคิล</h2>
                <div class="grid grid-cols-2 gap-4">
                    <% if (waste.length > 0) { %>
                        <% waste.forEach((item, index) => { %>
                            <div class="border p-3 rounded-lg shadow-md cursor-pointer" onclick="selectWaste('<%= index %>', '<%= item.wasteName %>', '<%= item.pricePerUnit %>')">
                                <img class="w-full h-32 object-cover mb-2" src="<%= item.img %>" alt="รูป <%= item.wasteName %>">
                                <p class="text-center font-semibold"><%= item.wasteName %></p>
                                <p class="text-center text-sm text-gray-500"><%= item.pricePerUnit %> บาท/กก.</p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-center text-gray-500">ยังไม่มีข้อมูล</p>
                    <% } %>
                </div>
            </div>

            <!-- ฝั่งขวา: ฟอร์มและรายการขยะที่เลือก -->
            <div class="w-1/2 border p-4 rounded-lg shadow-lg">
                <h2 class="text-lg font-bold mb-4">ฟอร์มรับซื้อขยะ</h2>
                <form action="/employee/wastePost" method="POST">
                    <label class="block mb-2">รหัสบัญชี:</label>
                    <input type="text" name="accountId" class="w-full p-2 border rounded mb-4" required>

                    <p class="font-bold">ยอดรวม: <span id="totalAmount">0</span> บาท</p>
                    <button type="submit" class="mt-4 bg-green-500 text-white px-4 py-2 rounded">ยืนยันการรับซื้อ</button>

                    <h3 class="text-md font-semibold mb-2">รายการที่เลือก:</h3>
                    <ul id="selectedWasteList" class="mb-4"></ul>
                </form>
            </div>

            <!-- Modal for weight input -->
            <div id="weightModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
                <div class="bg-white p-6 rounded-lg shadow-lg w-1/3">
                    <h3 class="text-lg font-bold mb-4">กรุณากรอกน้ำหนัก</h3>
                    <input id="weightInput" type="number" placeholder="น้ำหนัก (กก.)" class="w-full p-2 border rounded mb-4" required>
                    <p id="modalWasteName" class="mb-2"></p>
                    <p id="modalWastePrice" class="mb-2"></p>
                    <button onclick="closeModal()" class="bg-gray-500 text-white px-4 py-2 rounded">ปิด</button>
                    <button onclick="confirmWeight()" class="bg-blue-500 text-white px-4 py-2 rounded mr-2">ยืนยัน</button>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/employeePartials/empFooter.ejs') %>
</body>
<script>
    let selectedWaste = [];
    let currentWasteName = "";
    let currentPricePerUnit = 0;
    let currentIndex = -1;

    function selectWaste(index, name, pricePerUnit) {
        currentIndex = index;
        currentWasteName = name;
        currentPricePerUnit = pricePerUnit;
        document.getElementById('modalWasteName').textContent = `ขยะ: ${name}`;
        document.getElementById('modalWastePrice').textContent = `ราคา: ฿${pricePerUnit}/กก.`;
        document.getElementById('weightModal').classList.remove('hidden');
    }

    function confirmWeight() {
        const weight = parseFloat(document.getElementById('weightInput').value);
        if (weight && weight > 0) {
            const totalPrice = (weight * currentPricePerUnit).toFixed(2);
            if (currentIndex >= 0) {
                selectedWaste[currentIndex] = { name: currentWasteName, pricePerUnit: currentPricePerUnit, weight, totalPrice };
            } else {
                selectedWaste.push({ name: currentWasteName, pricePerUnit: currentPricePerUnit, weight, totalPrice });
            }
            updateSelectedWasteList();
            closeModal();
        } else {
            alert("กรุณากรอกน้ำหนักที่ถูกต้อง");
        }
    }

    function updateSelectedWasteList() {
        const list = document.getElementById('selectedWasteList');
        list.innerHTML = '';
        let totalAmount = 0;
        selectedWaste.forEach((item, index) => {
            totalAmount += parseFloat(item.totalPrice);
            list.innerHTML += `
                <li>
                    ${item.name} - ${item.weight} กก. (฿${item.totalPrice}) 
                    <button onclick="editWaste(${index})" class="ml-2 text-blue-500">แก้ไข</button>
                    <button onclick="deleteWaste(${index})" class="ml-2 text-red-500">ลบ</button>
                </li>
            `;
        });
        document.getElementById('totalAmount').textContent = totalAmount.toFixed(2);
    }

    function editWaste(index) {
        const item = selectedWaste[index];
        currentIndex = index;
        document.getElementById('weightInput').value = item.weight;
        selectWaste(index, item.name, item.pricePerUnit);
        document.getElementById('weightModal').classList.remove('hidden');
    }

    function deleteWaste(index) {
        selectedWaste.splice(index, 1);
        updateSelectedWasteList();
    }

    function closeModal() {
        document.getElementById('weightModal').classList.add('hidden');
    }
</script>
</html>
