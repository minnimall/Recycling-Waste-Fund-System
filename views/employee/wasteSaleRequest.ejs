<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wasteSaleRequest.css">
    <link rel="stylesheet" href="/style_employee/res_req.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <style>
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { scrollbar-width: none; }
    </style>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mt-4 mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        รายการความประสงค์ขายขยะ
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการความประสงค์ขายขยะจากสมาชิก</p>
                </div>
            </div>
        </div>
        
        <div id="pending-requests-section" class="mx-4 mb-6 relative bg-white rounded-xl shadow-sm border border-gray-100 p-5 hidden">
            <div class="flex items-center justify-between mb-4">
                <h1 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <span class="bg-yellow-100 text-yellow-700 p-1.5 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </span>
                    รอการอนุมัติ
                    <span id="pending-count" class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200 ml-2">
                        0 รายการ
                    </span>
                </h1>
            </div>

            <div class="relative group">
                <!-- Scroll Buttons -->
                <button class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 w-10 h-10 rounded-full bg-white shadow-lg border border-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-50 hover:text-green-600 transition-all opacity-0 group-hover:opacity-100 disabled:opacity-0" id="scroll-left" onclick="scrollContainer('left')">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                
                <div class="flex gap-4 overflow-x-auto pb-4 scroll-smooth scrollbar-hide px-1" id="pending-cards">
                    <!-- Cards will be injected here via JS -->
                </div>

                <button class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 w-10 h-10 rounded-full bg-white shadow-lg border border-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-50 hover:text-green-600 transition-all opacity-0 group-hover:opacity-100 disabled:opacity-0" id="scroll-right" onclick="scrollContainer('right')">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>

        <script>
            function scrollContainer(direction) {
                const container = document.getElementById('pending-cards');
                const scrollAmount = 340; // Card width + gap
                if (direction === 'left') {
                    container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                } else {
                    container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            }

            // Real-time Pending Requests Fetcher
            async function fetchPendingRequests() {
                try {
                    const response = await fetch('/employee/wasteSaleRequest/pending');
                    const data = await response.json();

                    if (data.success) {
                        renderPendingRequests(data.pendingRequests);
                    }
                } catch (error) {
                    console.error('Error fetching pending requests:', error);
                }
            }

            function renderPendingRequests(requests) {
                const container = document.getElementById('pending-cards');
                const section = document.getElementById('pending-requests-section');
                const countBadge = document.getElementById('pending-count');

                if (requests.length === 0) {
                    section.classList.add('hidden');
                    return;
                }

                section.classList.remove('hidden');
                countBadge.textContent = `${requests.length} รายการ`;
                
                // Keep track of current scroll position
                // const scrollLeft = container.scrollLeft;

                // Generate HTML for cards
                const html = requests.map(request => {
                    const date = new Date(request.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' });
                    const wasteItems = request.waste.slice(0, 3).map(w => `
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-white border border-gray-200 text-[10px] text-gray-700 shadow-sm">
                            ${w.wasteName}
                        </span>
                    `).join('');
                    
                    const moreItems = request.waste.length > 3 ? 
                        `<span class="text-[10px] text-gray-500 px-1">+${request.waste.length - 3}</span>` : '';

                    return `
                        <div class="min-w-[320px] max-w-[350px] group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden cursor-pointer" onclick="openModal('${request._id}')">
                            
                            <!-- Header: User Info & Status -->
                            <div class="px-4 py-3 flex justify-between items-center border-b border-gray-100 bg-gray-50/50">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
                                        <i class="fas fa-user text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="text-sm font-semibold text-gray-900 truncate max-w-[120px]">${request.family.familyName}</h3>
                                        <p class="text-[10px] text-gray-500">#${request._id.toString().slice(-6)}</p>
                                    </div>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-yellow-100 text-yellow-800">
                                    <span class="w-1 h-1 bg-yellow-500 rounded-full mr-1"></span>รอการอนุมัติ
                                </span>
                            </div>
                            
                            <!-- Body: Details & Items -->
                            <div class="p-4 space-y-3">
                                <!-- Details -->
                                <div class="space-y-2">
                                    <div class="flex items-start gap-2">
                                        <div class="mt-0.5 text-gray-400 text-xs">
                                            <i class="far fa-calendar-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-medium text-gray-500 uppercase tracking-wide">วันที่ให้เข้าซื้อ</p>
                                            <p class="text-xs text-gray-900 font-medium">${date}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-2">
                                        <div class="mt-0.5 text-gray-400 text-xs">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-medium text-gray-500 uppercase tracking-wide">สถานที่</p>
                                            <p class="text-xs text-gray-900 line-clamp-1" title="${request.location}">${request.location}</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Waste Items -->
                                <div class="bg-gray-50 rounded-lg p-2.5">
                                    <p class="text-[10px] font-medium text-gray-500 uppercase tracking-wide mb-1.5 flex items-center gap-1">
                                        <i class="fas fa-recycle text-green-500"></i> รายการขยะ
                                    </p>
                                    <div class="flex flex-wrap gap-1.5">
                                        ${wasteItems}
                                        ${moreItems}
                                        ${request.waste.length === 0 ? '<span class="text-[10px] text-gray-400 italic">ไม่มีรายการ</span>' : ''}
                                    </div>
                                </div>
                                
                                <!-- Actions -->
                                <div class="flex gap-2 pt-1">
                                    <button onclick="event.stopPropagation(); loadRequest('${request._id}')" 
                                            class="flex-1 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-medium rounded-lg transition-colors shadow-sm hover:shadow flex items-center justify-center gap-1.5">
                                        <i class="fa-solid fa-reply"></i> ตอบกลับ
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');

                container.innerHTML = html;
                // Restore scroll position if needed, but simple re-render usually resets it. 
                // For a smoother experience, complex diffing would be needed, but basic replace is acceptable for now.
            }

            // Initial fetch
            fetchPendingRequests();

            // Poll every 5 seconds
            setInterval(fetchPendingRequests, 5000);
        </script>

        <div id="filter-container" class="mx-4 mb-6 bg-white rounded-xl shadow-sm border border-gray-100 p-5">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full lg:w-auto">
                    <span class="text-gray-700 font-medium whitespace-nowrap">สถานะ:</span>
                    <div class="flex flex-wrap gap-2">
                        <button id="filter-all" data-color="green" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-green-600 text-white ring-2 ring-green-600 ring-offset-1">
                            ทั้งหมด (<%= wasteSaleRequests.length %>)
                        </button>
                        <button id="filter-pending" data-color="yellow" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-yellow-50 hover:text-yellow-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-yellow-500 mr-1"></span>รอการอนุมัติ (<%= wasteSaleRequests.filter(r => r.status === 'pending').length %>)
                        </button>
                        <!-- <button id="filter-waitingUser" data-color="orange" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-orange-50 hover:text-orange-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-orange-500 mr-1"></span>รอผู้ใช้ยืนยัน (<%= wasteSaleRequests.filter(r => r.status === 'waitingUser').length %>)
                        </button> -->
                        <button id="filter-confirmed" data-color="indigo" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-indigo-50 hover:text-indigo-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-indigo-500 mr-1"></span>รอการดำเนินการ (<%= wasteSaleRequests.filter(r => r.status === 'confirmed').length %>)
                        </button>
                        <button id="filter-in-progress" data-color="blue" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-blue-50 hover:text-blue-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500 mr-1"></span>กำลังเข้าจัดเก็บ (<%= wasteSaleRequests.filter(r => r.status === 'in-progress').length %>)
                        </button>
                        <button id="filter-resolved" data-color="green" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-green-50 hover:text-green-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-500 mr-1"></span>เสร็จสิ้น (<%= wasteSaleRequests.filter(r => r.status === 'resolved').length %>)
                        </button>
                        <button id="filter-rejected" data-color="red" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-red-50 hover:text-red-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-red-500 mr-1"></span>ปฏิเสธ (<%= wasteSaleRequests.filter(r => r.status === 'rejected').length %>)
                        </button>
                        <button id="filter-cancelled" data-color="red" class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 shadow-sm hover:shadow bg-white text-gray-600 border border-gray-200 hover:bg-red-50 hover:text-red-700">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-red-400 mr-1"></span>ยกเลิก (<%= wasteSaleRequests.filter(r => r.status === 'cancelled').length %>)
                        </button>
                    </div>
                </div>
                <div class="w-full lg:w-auto">
                    <div class="relative group">
                        <input type="text" id="search-input" placeholder="ค้นหารายการ..." class="w-full sm:w-80 pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all shadow-sm">
                        <div class="absolute left-3 top-2.5 text-gray-400 group-focus-within:text-green-500 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-800">
                    รายการทั้งหมด <span class="text-blue-600 text-base font-normal"><%= wasteSaleRequests.length %> รายการ</span>
                </h2>
            </div>
            <script>
                function loadRequest(id) {
                    window.location.href = `/employee/wasteSaleRequest/${id}`; 
                }
            </script>
            <div class="space-y-4">
                <% if (wasteSaleRequests.length > 0) { %>
                    <% wasteSaleRequests.forEach(request => { %>
                        <div class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden" 
                             data-status="<%= request.status %>" 
                             data-search="<%= request.family.familyName %> <%= request.location %> <%= request.waste.map(w => w.wasteName).join(' ') %>">
                            
                            <!-- Header: User Info & Status -->
                            <div class="px-5 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100 bg-gray-50/50">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
                                        <i class="fas fa-user text-lg"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-base font-semibold text-gray-900"><%= request.family.familyName %></h3>
                                        <p class="text-xs text-gray-500">รหัสคำขอ: #<%= request._id.toString().slice(-6) %></p>
                                    </div>
                                </div>
                                <div>
                                    <% if (request.status === 'resolved') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span>เสร็จสิ้น
                                        </span>
                                    <% } else if (request.status === 'pending') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full mr-1.5"></span>รอการอนุมัติ
                                        </span>
                                    <% } else if (request.status === 'waitingUser') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                            <span class="w-1.5 h-1.5 bg-orange-500 rounded-full mr-1.5"></span>รอผู้ใช้ยืนยัน
                                        </span>
                                    <% } else if (request.status === 'in-progress') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-1.5"></span>กำลังเข้าจัดเก็บ
                                        </span>
                                    <% } else if (request.status === 'confirmed') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                                            <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-1.5"></span>รอการดำเนินการ
                                        </span>
                                    <% } else if (request.status === 'rejected') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>ปฏิเสธคำขอ
                                        </span>
                                    <% } else if (request.status === 'cancelled') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>ยกเลิกคำขอโดยผู้ใช้
                                        </span>
                                    <% } else if (request.status === 'failed') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-200 text-gray-800">
                                            <span class="w-1.5 h-1.5 bg-gray-500 rounded-full mr-1.5"></span>ไม่สำเร็จ
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            ไม่ทราบ
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                            
                            <!-- Body: Details & Items -->
                            <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-6">
                                <!-- Details Column -->
                                <div class="md:col-span-4 space-y-3">
                                    <div class="flex items-start gap-3">
                                        <div class="mt-0.5 text-gray-400">
                                            <i class="far fa-calendar-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">วันที่ให้เข้าซื้อ</p>
                                            <p class="text-sm text-gray-900 font-medium whitespace-nowrap"><%= new Date(request.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-3">
                                        <div class="mt-0.5 text-gray-400">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">สถานที่</p>
                                            <p class="text-sm text-gray-900 line-clamp-2" title="<%= request.location %>"><%= request.location %></p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Waste Items Column -->
                                <div class="md:col-span-5">
                                    <div class="bg-gray-50 rounded-lg p-3 h-full">
                                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2 flex items-center gap-1">
                                            <i class="fas fa-recycle text-green-500"></i> รายการขยะ
                                        </p>
                                        <div class="flex flex-wrap gap-2">
                                            <% request.waste.forEach((w, index) => { %>
                                                <span class="inline-flex items-center px-2 py-1 rounded bg-white border border-gray-200 text-xs text-gray-700 shadow-sm">
                                                    <%= w.wasteName %>
                                                </span>
                                            <% }) %>
                                            <% if (request.waste.length === 0) { %>
                                                <span class="text-xs text-gray-400 italic">ไม่มีรายการ</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Actions Column -->
                                <div class="md:col-span-3 flex md:flex-col justify-end md:justify-center gap-3 border-t md:border-t-0 md:border-l border-gray-100 pt-4 md:pt-0 md:pl-4">
                                    <button onclick="loadRequest('<%= request._id %>')" 
                                            class="flex-1 md:flex-none inline-flex justify-center items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm hover:shadow">
                                        <i class="fa-solid fa-reply mr-2"></i> ตอบกลับ
                                    </button>
                                    <button onclick="openModal('<%= request._id %>')" 
                                            class="flex-1 md:flex-none inline-flex justify-center items-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors">
                                        <i class="fa-solid fa-circle-info mr-2 text-gray-500"></i> รายละเอียด
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Modal รายละเอียดความประสงค์ขายขยะ -->
                        <div id="modal-<%= request._id %>" class="hidden fixed inset-0 z-50 bg-black bg-opacity-30">
                            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4 max-h-[90vh] overflow-y-auto">
                                <div class="bg-white rounded-xl shadow-lg p-8 space-y-6">
                                    
                                    <div class="flex items-center justify-between border-b pb-4">
                                        <div class="flex items-center space-x-3">
                                            <!-- <ion-icon name="trash-outline" class="text-green-500 text-2xl"></ion-icon> -->
                                            <ion-icon name="document-text-outline" class="text-blue-500 text-2xl"></ion-icon>
                                            <span class="text-xl font-semibold text-gray-800">รายละเอียดความประสงค์ขายขยะ</span>
                                        </div>
                                        <button type="button" onclick="closeModal('<%= request._id %>')" class="text-gray-400 hover:text-gray-600 transition">
                                            <ion-icon name="close-outline" class="text-2xl"></ion-icon>
                                        </button>
                                    </div>

                                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                        <!-- Left Column -->
                                        <div class="space-y-5">
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">ผู้ขาย</label>
                                                <div class="flex items-center space-x-2 px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
                                                    <!-- <ion-icon name="person-circle-outline" class="text-gray-600 text-xl"></ion-icon> -->
                                                    <span class="text-gray-800 font-medium"><%= request.family.familyName %></span>
                                                </div>
                                            </div>

                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">วันที่ให้เข้ารับซื้อ</label>
                                                <div class="flex items-center space-x-2 px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
                                                    <!-- <ion-icon name="calendar-outline" class="text-green-500 text-xl"></ion-icon> -->
                                                    <span class="text-gray-800"><%= request.date.toISOString().split('T')[0] %></span>
                                                </div>
                                            </div>
                                            
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">ตำแหน่งให้เข้าไปรับซื้อ</label>
                                                <div class="flex items-center space-x-2 px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
                                                    <!-- <ion-icon name="location-outline" class="text-red-500 text-xl"></ion-icon> -->
                                                    <span class="text-gray-800"><%= request.location %></span>
                                                </div>
                                            </div>

                                            <!-- น้ำหนักรวม -->
                                            <!-- <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">น้ำหนักรวม</label>
                                                <div class="flex items-center space-x-2 px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
                                                    <ion-icon name="barbell-outline" class="text-blue-500 text-xl"></ion-icon>
                                                    <span class="text-gray-800"><%= request.weight %> กิโลกรัม</span>
                                                </div>
                                            </div> -->

                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">พิกัดที่ตั้ง (Latitude, Longitude)</label>
                                                <div class="flex items-center space-x-2 px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
                                                    <!-- <ion-icon name="pin-outline" class="text-red-500 text-xl"></ion-icon> -->
                                                    <span class="text-gray-800">ละติจูด <%= request.latitude %>, ลองจิจูด <%= request.longitude %></span>
                                                </div>
                                            </div>

                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">ดูพิกัดจุดใน Google Maps</label>
                                                <a href="https://www.google.com/maps?q=<%= request.latitude %>,<%= request.longitude %>" 
                                                    target="_blank" 
                                                    class="flex items-center space-x-2 px-4 py-3 bg-blue-50 hover:bg-blue-100 rounded-lg border border-blue-200 transition duration-200">
                                                    <ion-icon name="open-outline" class="text-blue-600 text-xl"></ion-icon>
                                                    <span class="text-blue-600 font-medium">เปิดแผนที่</span>
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Right Column -->
                                        <div class="space-y-5">
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-2">รูปภาพ</label>
                                                <% if (request.img) { %>
                                                    <div class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
                                                        <img src="<%= request.img %>" alt="รูปภาพขยะ" class="w-full h-64 object-cover">
                                                    </div>
                                                <% } else { %>
                                                    <div class="rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 h-64 flex flex-col items-center justify-center">
                                                        <ion-icon name="image-outline" class="text-gray-400 text-5xl mb-2"></ion-icon>
                                                        <p class="text-gray-400 italic">ไม่มีรูปภาพ</p>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center space-x-2">
                                            <ion-icon name="list-outline" class="text-green-500 text-xl"></ion-icon>
                                            <span>รายการขยะ</span>
                                        </label>
                                        
                                        <div class="bg-gray-50 rounded-lg border border-gray-200 overflow-hidden">
                                            <table class="w-full">
                                                <thead class="bg-gray-100">
                                                    <tr>
                                                        <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700">ชื่อขยะ</th>
                                                        <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">ราคา/หน่วย</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-gray-200">
                                                    <% request.waste.forEach(w => { %>
                                                        <tr class="hover:bg-gray-50 transition">
                                                            <td class="py-3 px-4">
                                                                <span class="text-gray-800 font-medium"><%= w.wasteName %></span>
                                                            </td>
                                                            <td class="py-3 px-4 text-right">
                                                                <span class="text-green-600 font-semibold"><%= w.pricePerUnit %> บาท/กก.</span>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="flex justify-end pt-4">
                                        <button type="button" onclick="closeModal('<%= request._id %>')" 
                                            class="px-6 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition duration-200">
                                            ปิด
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-16 px-6">
                        <div class="w-32 h-32 mb-6 rounded-full bg-gray-100 flex items-center justify-center">
                            <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">ไม่มีรายการความประสงค์ขายขยะ</h3>
                        <p class="text-gray-400 text-sm text-center max-w-md">ยังไม่มีคำขอขายขยะในระบบ เมื่อผู้ใช้ส่งคำขอเข้ามา รายการจะแสดงที่นี่</p>
                    </div>
                <% } %>

                <!-- Empty state for filtered results (hidden by default) -->
                <div id="no-filter-results" class="hidden flex flex-col items-center justify-center py-16 px-6">
                    <div class="w-28 h-28 mb-5 rounded-full bg-gray-100 flex items-center justify-center">
                        <svg class="w-14 h-14 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-500 mb-1">ไม่พบรายการที่ตรงกับตัวกรอง</h3>
                    <p class="text-gray-400 text-sm text-center">ลองเปลี่ยนสถานะหรือคำค้นหาใหม่</p>
                </div>

            </div>
        </div>
    </div>
    
</body>

<script>
    // Modal Functions
    function openModal(id) {
        document.getElementById(`modal-${id}`).classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    
    function closeModal(id) {
        document.getElementById(`modal-${id}`).classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
    
    // Status Menu Functions
    function toggleStatusMenu(id) {
        const menu = document.getElementById(`statusMenu-${id}`);
        const allMenus = document.querySelectorAll('[id^="statusMenu-"]');
        
        // ปิดเมนูอื่นๆ
        allMenus.forEach(m => {
            if (m.id !== `statusMenu-${id}`) {
                m.classList.add('hidden');
            }
        });
        
        // Toggle เมนูปัจจุบัน
        menu.classList.toggle('hidden');
    }
    
    // Update Status Function
    async function updateStatus(id, status) {
        try {
            // ปิด dropdown หลังจากเลือก
            const menu = document.getElementById('statusMenu-' + id);
            if (menu) {
                menu.classList.add('hidden');
            }

            const response = await fetch(`/employee/wasteSaleRequest/${id}/status`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ status })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Update status badge in the list
                const statusBadge = document.querySelector(`[data-id="${id}"] .status-badge`);
                const modalStatus = document.getElementById(`modal-status-${id}`);
                const modalSelect = document.getElementById(`modal-status-select-${id}`);
                
                // Update dropdown button
                const statusBtn = document.getElementById(`statusBtn-${id}`);
                
                // Update badge classes and text
                if (statusBadge) {
                    statusBadge.className = 'status-badge ml-3 px-2 py-1 text-xs font-medium rounded-full ';
                }
                if (modalStatus) {
                    modalStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ';
                }
                
                let statusText = '';
                if (status === 'pending') {
                    if (statusBadge) statusBadge.className += 'bg-yellow-100 text-yellow-800';
                    if (modalStatus) modalStatus.className += 'bg-yellow-100 text-yellow-800';
                    statusText = 'รอดำเนินการ';
                } else if (status === 'in-progress') {
                    if (statusBadge) statusBadge.className += 'bg-blue-100 text-blue-800';
                    if (modalStatus) modalStatus.className += 'bg-blue-100 text-blue-800';
                    statusText = 'กำลังเข้าจัดเก็บ';
                } else if (status === 'resolved') {
                    if (statusBadge) statusBadge.className += 'bg-green-100 text-green-800';
                    if (modalStatus) modalStatus.className += 'bg-green-100 text-green-800';
                    statusText = 'เสร็จสิ้น';
                }
                
                if (statusBadge) statusBadge.textContent = statusText;
                if (modalStatus) modalStatus.textContent = statusText;
                
                // ปุ่ม dropdown ยังคงแสดงข้อความ "เปลี่ยนสถานะ" เสมอ (ไม่เปลี่ยน)
                
                // Update modal select
                if (modalSelect) {
                    modalSelect.value = status;
                }

                // Update data attribute for filtering
                const requestItem = document.querySelector(`[data-id="${id}"]`);
                if (requestItem) {
                    requestItem.setAttribute('data-status', status);
                }

                // Update dropdown menu highlights
                const menuButtons = document.querySelectorAll(`#statusMenu-${id} button`);
                menuButtons.forEach(btn => {
                    btn.classList.remove('bg-blue-50', 'text-blue-700');
                    btn.classList.add('text-gray-700');
                    // Remove check mark
                    const checkIcon = btn.querySelector('.fa-check.float-right');
                    if (checkIcon) {
                        checkIcon.remove();
                    }
                });
                
                // Highlight selected status
                const selectedBtn = document.querySelector(`#statusMenu-${id} button[onclick*="'${status}'"]`);
                if (selectedBtn) {
                    selectedBtn.classList.remove('text-gray-700');
                    selectedBtn.classList.add('bg-blue-50', 'text-blue-700');
                    // Add check mark
                    selectedBtn.innerHTML += '<i class="fas fa-check text-blue-500 ml-auto float-right mt-0.5"></i>';
                }

                // แสดงข้อความสำเร็จ
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ!',
                    text: result.message,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                throw new Error(result.error);
            }
        } catch (error) {
            console.error('Error updating status:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: 'ไม่สามารถอัปเดตสถานะได้',
                confirmButtonText: 'ตกลง'
            });
        }
    }
    
    // Filter Functions
    const statusColorMap = {
        'all':         { bg: 'bg-green-600',  text: 'text-white',      ring: 'ring-green-600'  },
        'pending':     { bg: 'bg-yellow-500', text: 'text-white',      ring: 'ring-yellow-500' },
        'waitingUser': { bg: 'bg-orange-500', text: 'text-white',      ring: 'ring-orange-500' },
        'confirmed':   { bg: 'bg-indigo-600', text: 'text-white',      ring: 'ring-indigo-600' },
        'in-progress': { bg: 'bg-blue-600',   text: 'text-white',      ring: 'ring-blue-600'   },
        'resolved':    { bg: 'bg-green-600',  text: 'text-white',      ring: 'ring-green-600'  },
        'rejected':    { bg: 'bg-red-600',    text: 'text-white',      ring: 'ring-red-600'    },
        'cancelled':   { bg: 'bg-red-500',    text: 'text-white',      ring: 'ring-red-500'    }
    };

    function filterRequests(status) {
        const cards = document.querySelectorAll('[data-status]');
        const filterButtons = document.querySelectorAll('.filter-btn');
        
        const inactiveClasses = ['bg-white', 'text-gray-600', 'border', 'border-gray-200'];
        
        // Reset all buttons to inactive
        filterButtons.forEach(btn => {
            // Remove all possible active color classes
            Object.values(statusColorMap).forEach(c => {
                btn.classList.remove(c.bg, c.text, c.ring);
            });
            btn.classList.remove('ring-2', 'ring-offset-1');
            btn.classList.add(...inactiveClasses);
        });
        
        // Set active button with status-specific color
        const activeBtn = document.getElementById(`filter-${status}`);
        const colors = statusColorMap[status] || statusColorMap['all'];
        if (activeBtn) {
            activeBtn.classList.remove(...inactiveClasses);
            activeBtn.classList.add(colors.bg, colors.text, 'ring-2', colors.ring, 'ring-offset-1');
        }
        
        let visibleCount = 0;
        
        // Show/hide cards
        cards.forEach(card => {
            if (status === 'all' || card.dataset.status === status) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Update total count if element exists
        const totalCountElement = document.getElementById('total-count');
        if (totalCountElement) {
            totalCountElement.textContent = `${visibleCount} รายการ`;
        }

        // Show/hide no-results empty state
        const noResults = document.getElementById('no-filter-results');
        if (noResults) {
            if (visibleCount === 0 && cards.length > 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }
        
        // Re-run search if there is input
        const searchInput = document.getElementById('search-input');
        if (searchInput && searchInput.value) {
            searchRequests(searchInput.value);
        }
    }
    
    // Search Function
    function searchRequests(query) {
        const cards = document.querySelectorAll('[data-search]');
        let visibleCount = 0;
        
        cards.forEach(card => {
            const searchText = card.dataset.search.toLowerCase();
            if (searchText.includes(query.toLowerCase())) {
                // Only show if it also matches current filter
                const currentFilter = document.querySelector('.filter-btn.bg-green-600');
                const status = card.getAttribute('data-status');
                let shouldShow = false;

                if (currentFilter && currentFilter.id === 'filter-all') {
                    shouldShow = true;
                } else if (currentFilter && currentFilter.id === `filter-${status}`) {
                    shouldShow = true;
                }

                if (shouldShow) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            } else {
                card.style.display = 'none';
            }
        });

        // Update total count if element exists
        const totalCountElement = document.getElementById('total-count');
        if (totalCountElement) {
            totalCountElement.textContent = `${visibleCount} รายการ`;
        }
    }

    // Sort Function
    function sortRequests() {
        const sortSelect = document.getElementById('sort-select');
        if (!sortSelect) return;
        
        const sortBy = sortSelect.value;
        const container = document.getElementById('requests-container') || document.querySelector('.grid');
        if (!container) return;
        
        const items = Array.from(container.children);

        items.sort((a, b) => {
            if (sortBy === 'newest') {
                // Sort by creation date (newest first) - using data-id as proxy
                return b.getAttribute('data-id').localeCompare(a.getAttribute('data-id'));
            } else if (sortBy === 'oldest') {
                // Sort by creation date (oldest first)
                return a.getAttribute('data-id').localeCompare(b.getAttribute('data-id'));
            } else if (sortBy === 'status') {
                // Sort by status: pending, in-progress, resolved
                const statusOrder = { 'pending': 0, 'in-progress': 1, 'resolved': 2 };
                const statusA = statusOrder[a.getAttribute('data-status')] || 999;
                const statusB = statusOrder[b.getAttribute('data-status')] || 999;
                return statusA - statusB;
            }
            return 0;
        });

        // Remove existing items and re-add in sorted order
        items.forEach(item => item.remove());
        items.forEach(item => container.appendChild(item));
    }
    
    // Event Listeners
    document.addEventListener('DOMContentLoaded', function() {
        // Filter buttons
        const filterAll = document.getElementById('filter-all');
        const filterPending = document.getElementById('filter-pending');
        const filterInProgress = document.getElementById('filter-in-progress');
        const filterResolved = document.getElementById('filter-resolved');
        const filterWaitingUser = document.getElementById('filter-waitingUser');
        const filterConfirmed = document.getElementById('filter-confirmed');
        const filterRejected = document.getElementById('filter-rejected');
        const filterCancelled = document.getElementById('filter-cancelled');
        
        if (filterAll) filterAll.addEventListener('click', () => filterRequests('all'));
        if (filterPending) filterPending.addEventListener('click', () => filterRequests('pending'));
        if (filterConfirmed) filterConfirmed.addEventListener('click', () => filterRequests('confirmed'));
        if (filterWaitingUser) filterWaitingUser.addEventListener('click', () => filterRequests('waitingUser'));
        if (filterInProgress) filterInProgress.addEventListener('click', () => filterRequests('in-progress'));
        if (filterResolved) filterResolved.addEventListener('click', () => filterRequests('resolved'));
        if (filterRejected) filterRejected.addEventListener('click', () => filterRequests('rejected'));
        if (filterCancelled) filterCancelled.addEventListener('click', () => filterRequests('cancelled'));
        
        // Search input
        const searchInput = document.getElementById('search-input');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                searchRequests(this.value);
            });
        }

        // Sort select
        const sortSelect = document.getElementById('sort-select');
        if (sortSelect) {
            sortSelect.addEventListener('change', sortRequests);
        }

        // ปิด dropdown เมื่อคลิกนอกบริเวณ
        document.addEventListener('click', function(event) {
            if (!event.target.closest('[id^="statusBtn-"]') && !event.target.closest('[id^="statusMenu-"]')) {
                document.querySelectorAll('[id^="statusMenu-"]').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });
    });
    
    // Close modal when clicking outside
    document.addEventListener('click', function(event) {
        // ปิด Modal
        const modals = document.querySelectorAll('[id^="modal-"]');
        modals.forEach(modal => {
            if (event.target === modal) {
                const id = modal.id.replace('modal-', '');
                closeModal(id);
            }
        });
    });
</script>
</html>