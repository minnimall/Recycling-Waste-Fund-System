<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wasteSaleRequest.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        รายการความประสงค์ขายขยะ
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการความประสงค์ขายขยะจากสมาชิก</p>
                </div>
            </div>
        </div>
        
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-xl md:text-3xl font-bold text-gray-800 flex items-center">
                        ความประสงค์ขายขยะที่ต้องการอนุมัติ
                    </h1>
                    <div class="flex">
                        <div class="bg-blue-100 flex">
                            <i class="fas fa-user-circle text-gray-600 mr-2 text-xl"></i>
                            <h2 class="text-xl font-semibold text-gray-700 mr-2">
                                Test
                            </h2>
                            <span class="text-xs text-yellow-600 bg-yellow-100 px-2 py-1 rounded-full border border-yellow-200">รอการอนุมัติ</span>
                        </div>
                    </div>
                    <!-- <p class="text-gray-600 mt-2">ระบบจัดการความประสงค์ขายขยะจากสมาชิก</p> -->
                </div>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
                <div class="flex items-center">
                    <span class="text-gray-700 font-medium mr-3">สถานะ:</span>
                    <div class="flex space-x-2">
                        <button id="filter-all" class="filter-btn px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-600 transition-colors active">
                            ทั้งหมด (<%= wasteSaleRequests.length %>)
                        </button>
                        <button id="filter-pending" class="filter-btn px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            รอดำเนินการ
                        </button>
                        <button id="filter-in-progress" class="filter-btn px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            กำลังดำเนินการ
                        </button>
                        <button id="filter-resolved" class="filter-btn px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            เสร็จสิ้น
                        </button>
                    </div>
                </div>
                
                <div class="w-full md:w-auto">
                    <div class="relative">
                        <input type="text" id="search-input" placeholder="ค้นหารายการ..." class="w-full md:w-80 px-4 py-2 pl-10 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-800">
                    รายการทั้งหมด <span class="text-blue-600 text-base font-normal"><%= wasteSaleRequests.length %> รายการ</span>
                </h2>
            </div>
            <script>
                function loadRequest(id) {
                    window.location.href = `/employee/wasteSaleRequest/${id}`; 
                }
            </script>
            <div class="space-y-4">
                <% if (wasteSaleRequests.length > 0) { %>
                    <% wasteSaleRequests.forEach(request => { %>
                        <div class="border border-gray-200 rounded-lg hover:shadow-md transition-shadow duration-300 p-4 rounded-lg shadow-sm bg-white  relative" 
                            data-status="<%= request.status %>" 
                            data-search="<%= request.family.familyName %> <%= request.location %> <%= request.waste.map(w => w.wasteName).join(' ') %>">
                            <div class="flex flex-col md:flex-row md:items-center justify-between">
                                <div class="mb-3 md:mb-0">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-user-circle text-gray-600 mr-2 text-xl"></i>
                                        <h2 class="text-xl font-semibold text-gray-700 mr-2">
                                            <%= request.family.familyName %>
                                        </h2>
                                        <% if (request.status === 'resolved') { %><span class="text-xs text-green-600 bg-green-100 px-2 py-1 rounded-full border border-green-200">เสร็จสิ้น</span>
                                        <% } else if (request.status === 'pending') { %><span class="text-xs text-yellow-600 bg-yellow-100 px-2 py-1 rounded-full border border-yellow-200">รอการอนุมัติ</span>
                                        <% } else if (request.status === 'waitingUser') { %><span class="text-xs text-yellow-600 bg-yellow-100 px-2 py-1 rounded-full border border-yellow-200">รอผู้ใช้ยืนยืน</span>
                                        <% } else if (request.status === 'in-progress') { %><span class="text-xs text-blue-600 bg-blue-100 px-2 py-1 rounded-full border border-blue-200">กำลังดำเนินการ</span>
                                        <% } else if (request.status === 'confirmed') { %><span class="text-xs text-blue-600 bg-blue-100 px-2 py-1 rounded-full border border-blue-200">รอการดำเนินการ</span>
                                        <% } else if (request.status === 'rejected') { %><span class="text-xs text-red-600 bg-red-100 px-2 py-1 rounded-full border border-red-200">ปฏิเสธคำขอ</span>
                                        <% } else if (request.status === 'CANCELLED_BY_USER') { %><span class="text-xs text-red-600 bg-red-100 px-2 py-1 rounded-full border border-red-200">ยกเลิกคำขอโดยผู้ใช้</span>
                                        <% } else { %><span class="text-xs text-gray-600 bg-gray-100 px-2 py-1 rounded-full border border-gray-200">ไม่ทราบ</span><% } %>
                                    </div>
                                    
                                    <div class="flex flex-wrap items-center text-sm text-gray-600">
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="far fa-calendar-alt mr-1"></i> 
                                            <span>วันให้เข้ารับซื้อ : <%= request.date.toISOString().split('T')[0] %></span>
                                        </div>
                                        
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="fas fa-map-marker-alt mr-1"></i>
                                            <span>พิกัด : <%= request.location %></span>
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap items-center text-sm text-gray-600">
                                        <span>รายการขาย : </span>
                                        <% request.waste.forEach((w, index) => { %>
                                            <span><%= w.wasteName %><%= index < request.waste.length - 1 ? ', ' : '' %></span>
                                        <% }) %>
                                    </div>
                                </div>
                                
                                <div class="flex items-center space-x-2">
                                    <!-- ปุ่มเปลี่ยนสถานะสำหรับ request -->
                                    <div class="relative">
                                        <button onclick="loadRequest('<%= request._id %>')" class="px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center">
                                            <i class="fa-solid fa-reply mr-2"></i> ตอบกลับคำขอ
                                        </button>
                                    </div>
                                    
                                    <button onclick="openModal('<%= request._id %>')" 
                                        class="px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-600 transition-colors flex items-center">
                                        <i class="fa-solid fa-circle-info mr-2"></i>
                                        ดูรายละเอียด
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Modal -->
                        <div id="modal-<%= request._id %>" class="fixed inset-0 hidden z-50 flex items-center justify-center bg-gray-900 bg-opacity-50">
                            <div class="bg-white rounded-lg shadow-lg w-11/12 md:w-2/3 lg:w-1/2 xl:w-2/5 modal-transition modal-content">
                                <div class="flex justify-between items-center p-4 border-b border-gray-200">
                                    <h3 class="text-lg leading-6 font-medium text-gray-900 flex items-center">
                                        <i class="fas fa-info-circle text-green-600 mr-2"></i>
                                        รายละเอียดความประสงค์ขายขยะ
                                    </h3>
                                    <button onclick="closeModal('<%= request._id %>')" class="text-gray-500 hover:text-gray-700 text-2xl focus:outline-none">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <div class="p-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">ผู้ขาย</h4>
                                                <p class="text-base text-gray-700 flex items-center">
                                                    <i class="fas fa-user-circle text-gray-600 mr-2"></i>
                                                    <%= request.family.familyName %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">วันที่ให้เข้ารับซื้อ</h4>
                                                <p class="text-base text-gray-700 flex items-center">
                                                    <i class="far fa-calendar-alt text-green-600 mr-2"></i>
                                                    <%= request.date.toISOString().split('T')[0] %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">ตำแหน่งให้เข้าไปรับซื้อ</h4>
                                                <p class="text-base text-gray-700 flex items-center">
                                                    <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>
                                                    <%= request.location %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">น้ำหนักรวม</h4>
                                                <p class="text-base text-gray-700 flex items-center">
                                                    <i class="fas fa-weight text-blue-500 mr-2"></i>
                                                    <%= request.weight %> กิโลกรัม
                                                </p>
                                            </div>
                                            
                                            <!-- พิกัดที่ตั้ง -->
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">พิกัดที่ตั้ง (Latitude, Longitude)</h4>
                                                <p class="text-base text-gray-700 flex items-center">
                                                    <i class="fas fa-map-pin text-red-500 mr-2"></i>
                                                    <%= request.latitude %>, <%= request.longitude %>
                                                </p>
                                            </div>
                                            
                                            <!-- Google Maps Link -->
                                            <div class="mb-4">
                                                <h4 class="text-base font-semibold text-gray-800 mb-1">ดูพิกัดจุดใน Google Maps</h4>
                                                <a href="https://www.google.com/maps?q=<%= request.latitude %>,<%= request.longitude %>" 
                                                    target="_blank" 
                                                    class="text-blue-600 hover:text-blue-800 flex items-center">
                                                    <i class="fas fa-external-link-alt mr-2"></i>
                                                    เปิดแผนที่
                                                </a>
                                            </div>
                                        </div>
                                        
                                        <div>
                                            <h4 class="text-sm text-gray-500 mb-2">รูปภาพ</h4>
                                            <% if (request.img) { %>
                                                <div class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
                                                    <img src="<%= request.img %>" alt="รูปภาพขยะ" class="w-full h-50 object-cover">
                                                </div>
                                            <% } else { %>
                                                <div class="rounded-lg border border-gray-200 bg-gray-50 h-48 flex items-center justify-center">
                                                    <p class="text-gray-400 italic">
                                                        <i class="fas fa-image mr-2"></i>
                                                        ไม่มีรูปภาพ
                                                    </p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-6">
                                        <h4 class="text-base font-semibold text-gray-800 mb-1">
                                            <i class="fas fa-recycle text-green-600 mr-2"></i>
                                            รายการขยะ
                                        </h4>
                                        
                                        <div class="bg-gray-50 rounded-lg p-4">
                                            <table class="w-full">
                                                <thead>
                                                    <tr class="border-b border-gray-200">
                                                        <th class="text-left py-2 text-gray-600">ขยะ</th>
                                                        <th class="text-right py-2 text-gray-600">ราคา/หน่วย</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% request.waste.forEach(w => { %>
                                                        <tr class="border-b border-gray-100">
                                                            <td class="py-3">
                                                                <span class="font-medium"><%= w.wasteName %></span>
                                                            </td>
                                                            <td class="py-3 text-right font-medium text-green-700">
                                                                <%= w.pricePerUnit %> บาท/กก.
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="border-t border-gray-200 p-4 flex justify-end space-x-3">
                                    <button onclick="closeModal('<%= request._id %>')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                                        ปิด
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state text-center py-8">
                        <i class="fas fa-clipboard-list text-gray-300 text-5xl mb-4"></i>
                        <h3 class="text-xl font-medium text-gray-500">ไม่พบรายการความประสงค์ขายขยะ</h3>
                        <p class="text-gray-400 mt-2">กรุณาเพิ่มรายการใหม่เพื่อแสดงที่นี่</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
</body>

<script>
    // Modal Functions
    function openModal(id) {
        document.getElementById(`modal-${id}`).classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    
    function closeModal(id) {
        document.getElementById(`modal-${id}`).classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
    
    // Status Menu Functions
    function toggleStatusMenu(id) {
        const menu = document.getElementById(`statusMenu-${id}`);
        const allMenus = document.querySelectorAll('[id^="statusMenu-"]');
        
        // ปิดเมนูอื่นๆ
        allMenus.forEach(m => {
            if (m.id !== `statusMenu-${id}`) {
                m.classList.add('hidden');
            }
        });
        
        // Toggle เมนูปัจจุบัน
        menu.classList.toggle('hidden');
    }
    
    // Update Status Function
    async function updateStatus(id, status) {
        try {
            // ปิด dropdown หลังจากเลือก
            const menu = document.getElementById('statusMenu-' + id);
            if (menu) {
                menu.classList.add('hidden');
            }

            const response = await fetch(`/employee/wasteSaleRequest/${id}/status`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ status })
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Update status badge in the list
                const statusBadge = document.querySelector(`[data-id="${id}"] .status-badge`);
                const modalStatus = document.getElementById(`modal-status-${id}`);
                const modalSelect = document.getElementById(`modal-status-select-${id}`);
                
                // Update dropdown button
                const statusBtn = document.getElementById(`statusBtn-${id}`);
                
                // Update badge classes and text
                if (statusBadge) {
                    statusBadge.className = 'status-badge ml-3 px-2 py-1 text-xs font-medium rounded-full ';
                }
                if (modalStatus) {
                    modalStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ';
                }
                
                let statusText = '';
                if (status === 'pending') {
                    if (statusBadge) statusBadge.className += 'bg-yellow-100 text-yellow-800';
                    if (modalStatus) modalStatus.className += 'bg-yellow-100 text-yellow-800';
                    statusText = 'รอดำเนินการ';
                } else if (status === 'in-progress') {
                    if (statusBadge) statusBadge.className += 'bg-blue-100 text-blue-800';
                    if (modalStatus) modalStatus.className += 'bg-blue-100 text-blue-800';
                    statusText = 'กำลังดำเนินการ';
                } else if (status === 'resolved') {
                    if (statusBadge) statusBadge.className += 'bg-green-100 text-green-800';
                    if (modalStatus) modalStatus.className += 'bg-green-100 text-green-800';
                    statusText = 'เสร็จสิ้น';
                }
                
                if (statusBadge) statusBadge.textContent = statusText;
                if (modalStatus) modalStatus.textContent = statusText;
                
                // ปุ่ม dropdown ยังคงแสดงข้อความ "เปลี่ยนสถานะ" เสมอ (ไม่เปลี่ยน)
                
                // Update modal select
                if (modalSelect) {
                    modalSelect.value = status;
                }

                // Update data attribute for filtering
                const requestItem = document.querySelector(`[data-id="${id}"]`);
                if (requestItem) {
                    requestItem.setAttribute('data-status', status);
                }

                // Update dropdown menu highlights
                const menuButtons = document.querySelectorAll(`#statusMenu-${id} button`);
                menuButtons.forEach(btn => {
                    btn.classList.remove('bg-blue-50', 'text-blue-700');
                    btn.classList.add('text-gray-700');
                    // Remove check mark
                    const checkIcon = btn.querySelector('.fa-check.float-right');
                    if (checkIcon) {
                        checkIcon.remove();
                    }
                });
                
                // Highlight selected status
                const selectedBtn = document.querySelector(`#statusMenu-${id} button[onclick*="'${status}'"]`);
                if (selectedBtn) {
                    selectedBtn.classList.remove('text-gray-700');
                    selectedBtn.classList.add('bg-blue-50', 'text-blue-700');
                    // Add check mark
                    selectedBtn.innerHTML += '<i class="fas fa-check text-blue-500 ml-auto float-right mt-0.5"></i>';
                }

                // แสดงข้อความสำเร็จ
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ!',
                    text: result.message,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                throw new Error(result.error);
            }
        } catch (error) {
            console.error('Error updating status:', error);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: 'ไม่สามารถอัปเดตสถานะได้',
                confirmButtonText: 'ตกลง'
            });
        }
    }
    
    // Filter Functions
    function filterRequests(status) {
        const cards = document.querySelectorAll('[data-status]');
        const filterButtons = document.querySelectorAll('.filter-btn');
        
        // Reset button styles
        filterButtons.forEach(btn => {
            btn.classList.remove('bg-green-700', 'text-white');
            btn.classList.add('bg-white', 'border-gray-300', 'text-gray-700');
        });
        
        // Set active button
        const activeBtn = document.getElementById(`filter-${status}`);
        if (activeBtn) {
            activeBtn.classList.remove('bg-white', 'border-gray-300', 'text-gray-700');
            activeBtn.classList.add('bg-green-700', 'text-white');
        }
        
        let visibleCount = 0;
        
        // Show/hide cards
        cards.forEach(card => {
            if (status === 'all' || card.dataset.status === status) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Update total count if element exists
        const totalCountElement = document.getElementById('total-count');
        if (totalCountElement) {
            totalCountElement.textContent = `${visibleCount} รายการ`;
        }
    }
    
    // Search Function
    function searchRequests(query) {
        const cards = document.querySelectorAll('[data-search]');
        let visibleCount = 0;
        
        cards.forEach(card => {
            const searchText = card.dataset.search.toLowerCase();
            if (searchText.includes(query.toLowerCase())) {
                // Only show if it also matches current filter
                const currentFilter = document.querySelector('.filter-btn.bg-green-700');
                const status = card.getAttribute('data-status');
                let shouldShow = false;

                if (currentFilter && currentFilter.id === 'filter-all') {
                    shouldShow = true;
                } else if (currentFilter && currentFilter.id === `filter-${status}`) {
                    shouldShow = true;
                }

                if (shouldShow) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            } else {
                card.style.display = 'none';
            }
        });

        // Update total count if element exists
        const totalCountElement = document.getElementById('total-count');
        if (totalCountElement) {
            totalCountElement.textContent = `${visibleCount} รายการ`;
        }
    }

    // Sort Function
    function sortRequests() {
        const sortSelect = document.getElementById('sort-select');
        if (!sortSelect) return;
        
        const sortBy = sortSelect.value;
        const container = document.getElementById('requests-container') || document.querySelector('.grid');
        if (!container) return;
        
        const items = Array.from(container.children);

        items.sort((a, b) => {
            if (sortBy === 'newest') {
                // Sort by creation date (newest first) - using data-id as proxy
                return b.getAttribute('data-id').localeCompare(a.getAttribute('data-id'));
            } else if (sortBy === 'oldest') {
                // Sort by creation date (oldest first)
                return a.getAttribute('data-id').localeCompare(b.getAttribute('data-id'));
            } else if (sortBy === 'status') {
                // Sort by status: pending, in-progress, resolved
                const statusOrder = { 'pending': 0, 'in-progress': 1, 'resolved': 2 };
                const statusA = statusOrder[a.getAttribute('data-status')] || 999;
                const statusB = statusOrder[b.getAttribute('data-status')] || 999;
                return statusA - statusB;
            }
            return 0;
        });

        // Remove existing items and re-add in sorted order
        items.forEach(item => item.remove());
        items.forEach(item => container.appendChild(item));
    }
    
    // Event Listeners
    document.addEventListener('DOMContentLoaded', function() {
        // Filter buttons
        const filterAll = document.getElementById('filter-all');
        const filterPending = document.getElementById('filter-pending');
        const filterInProgress = document.getElementById('filter-in-progress');
        const filterResolved = document.getElementById('filter-resolved');
        
        if (filterAll) filterAll.addEventListener('click', () => filterRequests('all'));
        if (filterPending) filterPending.addEventListener('click', () => filterRequests('pending'));
        if (filterInProgress) filterInProgress.addEventListener('click', () => filterRequests('in-progress'));
        if (filterResolved) filterResolved.addEventListener('click', () => filterRequests('resolved'));
        
        // Search input
        const searchInput = document.getElementById('search-input');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                searchRequests(this.value);
            });
        }

        // Sort select
        const sortSelect = document.getElementById('sort-select');
        if (sortSelect) {
            sortSelect.addEventListener('change', sortRequests);
        }

        // ปิด dropdown เมื่อคลิกนอกบริเวณ
        document.addEventListener('click', function(event) {
            if (!event.target.closest('[id^="statusBtn-"]') && !event.target.closest('[id^="statusMenu-"]')) {
                document.querySelectorAll('[id^="statusMenu-"]').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });
    });
    
    // Close modal when clicking outside
    document.addEventListener('click', function(event) {
        // ปิด Modal
        const modals = document.querySelectorAll('[id^="modal-"]');
        modals.forEach(modal => {
            if (event.target === modal) {
                const id = modal.id.replace('modal-', '');
                closeModal(id);
            }
        });
    });
</script>
</html>