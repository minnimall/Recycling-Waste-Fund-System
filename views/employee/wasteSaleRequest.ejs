<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wasteSaleRequest.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>

    <div class="container mx-auto my-10 p-6 bg-white shadow-lg rounded-xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">🗑️ รายการความประสงค์ขายขยะ</h1>
        
        <div class="space-y-4">
            <% wasteSaleRequests.forEach(request => { %>
                <div class="border border-gray-300 p-4 rounded-lg shadow-sm bg-gray-50 hover:bg-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-semibold text-gray-700"> จาก: นายดุลพาห์ ทวีแสงศิริ</h2>
                            <p class="text-sm text-gray-600"> วันที่: <%= request.date.toISOString().split('T')[0] %></p>
                        </div>
                        <!-- ปุ่มกดเพื่อเปิด Modal -->
                        <button onclick="openModal('<%= request._id %>')" class="bg-green-600 text-white px-4 py-2 rounded-lg">ดูรายละเอียด</button>
                    </div>
                </div>
                
                <!-- Modal -->
                <div id="modal-<%= request._id %>" class="fixed inset-0 hidden z-50 flex items-center justify-center bg-gray-900 bg-opacity-50">
                    <div class="bg-white p-6 rounded-lg shadow-lg w-11/12 md:w-1/3">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-2xl font-semibold text-gray-800">รายละเอียดความประสงค์ขายขยะ</h3>
                            <button onclick="closeModal('<%= request._id %>')" class="text-gray-500">&times;</button>
                        </div>
                        <div>
                            <h3>📅 วันที่: <%= request.date.toISOString().split('T')[0] %></h3>
                            <h3>📍 ตำแหน่ง: <%= request.location %></h3>
                            <h3>⚖️ น้ำหนัก: <%= request.weight %> กก.</h3>
                            <h3 class="font-semibold text-gray-700">♻️ ขยะ:</h3>
                            <ul class="list-disc pl-5 space-y-1">
                                <% request.waste.forEach(w => { %>
                                    <li class="bg-green-100 px-3 py-1 rounded-lg text-green-800">
                                        <span class="font-semibold"><%= w.wasteName %></span> 
                                        - <%= w.category %> 
                                        <span class="text-gray-600">(💰 <%= w.pricePerUnit %> บาท/กก.)</span>
                                    </li>
                                <% }) %>
                            </ul>
                            <h3 class="font-semibold text-gray-700">🖼️ รูปภาพ:</h3>
                            <% if (request.img) { %>
                                <img src="<%= request.img %>" alt="รูปภาพขยะ" class="w-32 h-32 object-cover rounded-lg shadow-md border">
                            <% } else { %>
                                <span class="text-gray-400 italic">ไม่มีรูป</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>   
    
</body>
<script>
    // ฟังก์ชันเปิด Modal
    function openModal(id) {
        const modal = document.getElementById(`modal-${id}`);
        modal.classList.remove('hidden');
    }

    // ฟังก์ชันปิด Modal
    function closeModal(id) {
        const modal = document.getElementById(`modal-${id}`);
        modal.classList.add('hidden');
    }
</script>
</html>
