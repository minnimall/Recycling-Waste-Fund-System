<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/employeePartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_employee/wasteSaleRequest.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>
    <%- include('../partials/employeePartials/empHeader.ejs') %>
    <%- include('../partials/employeePartials/empSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745', // สีเขียวสำหรับความสำเร็จ
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        รายการความประสงค์ขายขยะ
                    </h1>
                    <p class="text-gray-600 mt-2">ระบบจัดการความประสงค์ขายขยะจากสมาชิก</p>
                </div>
            </div>
        </div>

        <!-- Filters and Search -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
                <div class="flex items-center">
                    <span class="text-gray-700 font-medium mr-3">สถานะ:</span>
                    <div class="flex space-x-2">
                        <button class="px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-700 transition-colors">
                            ทั้งหมด (<%= wasteSaleRequests.length %>)
                        </button>
                        <button class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            ใหม่
                        </button>
                        <button class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            กำลังดำเนินการ
                        </button>
                        <button class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
                            เสร็จสิ้น
                        </button>
                    </div>
                </div>
                
                <div class="w-full md:w-auto">
                    <div class="relative">
                        <input type="text" placeholder="ค้นหารายการ..." class="w-full md:w-80 px-4 py-2 pl-10 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Request List -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-200">
                <h2 class="text-base font-semibold text-gray-800">
                    รายการทั้งหมด <span class="text-blue-600 text-base font-normal"><%= wasteSaleRequests.length %> รายการ</span>
                </h2>
                <div class="flex items-center space-x-2">
                    <span class="text-gray-600">เรียงตาม:</span>
                    <select class="px-3 py-2 border border-gray-300 rounded-md text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="newest">ล่าสุด</option>
                        <option value="oldest">เก่าสุด</option>
                        <option value="status">สถานะ</option>
                    </select>
                </div>
            </div>
            <div class="space-y-4">
                <% if (wasteSaleRequests.length > 0) { %>
                    <% wasteSaleRequests.forEach(request => { %>
                        <div class="border border-gray-200 p-4 rounded-lg shadow-sm bg-white hover:bg-gray-50 card-transition relative">
                            <div class="flex flex-col md:flex-row md:items-center justify-between">
                                <div class="mb-3 md:mb-0">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-user-circle text-gray-600 mr-2 text-xl"></i>
                                        <h2 class="text-xl font-semibold text-gray-700">
                                            <%= request.family.familyName %>
                                        </h2>
                                    </div>
                                    
                                    <div class="flex flex-wrap items-center text-sm text-gray-600">
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="far fa-calendar-alt mr-1"></i> 
                                            <span>วันให้เข้ารับซื้อ : <%= request.date.toISOString().split('T')[0] %></span>
                                        </div>
                                        
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="fas fa-map-marker-alt mr-1"></i>
                                            <span>พิกัด : <%= request.location %></span>
                                        </div>
                                    </div>

                                    
                                    <div class="flex flex-wrap items-center text-sm text-gray-600">
                                        <span>รายการขาย : </span>
                                        <% request.waste.forEach(w => { %>
                                            <span><%= w.wasteName %>,</span>
                                        <% }) %>
                                    </div>
                                    
                                </div>
                                
                                <div class="flex items-center">
                                    <button onclick="openModal('<%= request._id %>')" class="btn-primary px-4 py-2 rounded-lg flex items-center">
                                        <i class="fas fa-eye mr-2"></i>
                                        ดูรายละเอียด
                                    </button>
                                </div>
                            </div>
                            
                            <% if (request.status === 'new') { %>
                                <div class="badge bg-green-500 text-white">ใหม่</div>
                            <% } %>
                        </div>
                        
                        <!-- Modal -->
                        <div id="modal-<%= request._id %>" class="fixed inset-0 hidden z-50 flex items-center justify-center bg-gray-900 bg-opacity-50">
                            <div class="bg-white rounded-lg shadow-lg w-11/12 md:w-2/3 lg:w-1/2 xl:w-2/5 modal-transition modal-content">
                                <div class="flex justify-between items-center p-4 border-b border-gray-200">
                                    <h3 class="text-xl font-semibold text-gray-800">
                                        <i class="fas fa-info-circle text-green-600 mr-2"></i>
                                        รายละเอียดความประสงค์ขายขยะ
                                    </h3>
                                    <button onclick="closeModal('<%= request._id %>')" class="text-gray-500 hover:text-gray-700 text-2xl focus:outline-none">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <div class="p-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">ผู้ขาย</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-user-circle text-gray-600 mr-2"></i>
                                                    <%= request.family.familyName %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">วันที่ให้เข้ารับซื้อ</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="far fa-calendar-alt text-green-600 mr-2"></i>
                                                    <%= request.date.toISOString().split('T')[0] %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">ตำแหน่งให้เข้าไปรับซื้อ</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>
                                                    <%= request.location %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">น้ำหนักรวม</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-weight text-blue-500 mr-2"></i>
                                                    <%= request.weight %> กิโลกรัม
                                                </p>
                                            </div>
                                        </div>
                                        
                                        <div>
                                            <h4 class="text-sm text-gray-500 mb-2">รูปภาพ</h4>
                                            <% if (request.img) { %>
                                                <div class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
                                                    <img src="<%= request.img %>" alt="รูปภาพขยะ" class="w-full h-50 object-cover">
                                                </div>
                                            <% } else { %>
                                                <div class="rounded-lg border border-gray-200 bg-gray-50 h-48 flex items-center justify-center">
                                                    <p class="text-gray-400 italic">
                                                        <i class="fas fa-image mr-2"></i>
                                                        ไม่มีรูปภาพ
                                                    </p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-6">
                                        <h4 class="font-semibold text-gray-700 mb-3 flex items-center">
                                            <i class="fas fa-recycle text-green-600 mr-2"></i>
                                            รายการขยะ
                                        </h4>
                                        
                                        <div class="bg-gray-50 rounded-lg p-4">
                                            <table class="w-full">
                                                <thead>
                                                    <tr class="border-b border-gray-200">
                                                        <th class="text-left py-2 text-gray-600">ขยะ</th>
                                                        <th class="text-right py-2 text-gray-600">ราคา/หน่วย</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% request.waste.forEach(w => { %>
                                                        <tr class="border-b border-gray-100">
                                                            <td class="py-3">
                                                                <span class="font-medium"><%= w.wasteName %></span>
                                                            </td>
                                                            <td class="py-3 text-right font-medium text-green-700">
                                                                <%= w.pricePerUnit %> บาท/กก.
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="border-t border-gray-200 p-4 flex justify-end space-x-3">
                                    <button onclick="closeModal('<%= request._id %>')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                                        ปิด
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-clipboard-list text-gray-300 text-5xl mb-4"></i>
                        <h3 class="text-xl font-medium text-gray-500">ไม่พบรายการความประสงค์ขายขยะ</h3>
                        <p class="text-gray-400 mt-2">กรุณาเพิ่มรายการใหม่เพื่อแสดงที่นี่</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <main class="container mx-auto mt-5">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 pb-4 border-b border-gray-200">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        <!-- <i class="fas fa-clipboard-list text-green-600 mr-3"></i> -->
                        รายการความประสงค์ขายขยะ
                    </h2>
                    <p class="text-gray-600 mt-1">ทั้งหมด <%= wasteSaleRequests.length %> รายการ</p>
                </div>
                
                <div class="mt-4 md:mt-0 w-full md:w-auto">
                    <div class="relative">
                        <input type="text" placeholder="ค้นหารายการ..." class="w-full md:w-64 px-4 py-2 pr-10 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <i class="fas fa-search absolute right-3 top-3 text-gray-400"></i>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <% if (wasteSaleRequests.length > 0) { %>
                    <% wasteSaleRequests.forEach(request => { %>
                        <div class="border border-gray-200 p-4 rounded-lg shadow-sm bg-white hover:bg-gray-50 card-transition relative">
                            <div class="flex flex-col md:flex-row md:items-center justify-between">
                                <div class="mb-3 md:mb-0">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-user-circle text-gray-600 mr-2 text-xl"></i>
                                        <h2 class="text-xl font-semibold text-gray-700">
                                            <%= request.family.familyName %>
                                        </h2>
                                    </div>
                                    
                                    <div class="flex flex-wrap items-center text-sm text-gray-600">
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="far fa-calendar-alt mr-1"></i> 
                                            <span>วันให้เข้ารับซื้อ : <%= request.date.toISOString().split('T')[0] %></span>
                                        </div>
                                        
                                        <div class="flex items-center mr-4 mb-2 md:mb-0">
                                            <i class="fas fa-map-marker-alt mr-1"></i>
                                            <span>พิกัด : <%= request.location %></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="flex items-center">
                                    <button onclick="openModal('<%= request._id %>')" class="btn-primary px-4 py-2 rounded-lg flex items-center">
                                        <i class="fas fa-eye mr-2"></i>
                                        ดูรายละเอียด
                                    </button>
                                </div>
                            </div>
                            
                            <% if (request.status === 'new') { %>
                                <div class="badge bg-green-500 text-white">ใหม่</div>
                            <% } %>
                        </div>
                        
                        <!-- Modal -->
                        <div id="modal-<%= request._id %>" class="fixed inset-0 hidden z-50 flex items-center justify-center bg-gray-900 bg-opacity-50">
                            <div class="bg-white rounded-lg shadow-lg w-11/12 md:w-2/3 lg:w-1/2 xl:w-2/5 modal-transition modal-content">
                                <div class="flex justify-between items-center p-4 border-b border-gray-200">
                                    <h3 class="text-xl font-semibold text-gray-800">
                                        <i class="fas fa-info-circle text-green-600 mr-2"></i>
                                        รายละเอียดความประสงค์ขายขยะ
                                    </h3>
                                    <button onclick="closeModal('<%= request._id %>')" class="text-gray-500 hover:text-gray-700 text-2xl focus:outline-none">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <div class="p-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">ผู้ขาย</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-user-circle text-gray-600 mr-2"></i>
                                                    <%= request.family.familyName %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">วันที่ให้เข้ารับซื้อ</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="far fa-calendar-alt text-green-600 mr-2"></i>
                                                    <%= request.date.toISOString().split('T')[0] %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">ตำแหน่งให้เข้าไปรับซื้อ</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>
                                                    <%= request.location %>
                                                </p>
                                            </div>
                                            
                                            <div class="mb-4">
                                                <h4 class="text-sm text-gray-500 mb-1">น้ำหนักรวม</h4>
                                                <p class="text-lg font-semibold flex items-center">
                                                    <i class="fas fa-weight text-blue-500 mr-2"></i>
                                                    <%= request.weight %> กิโลกรัม
                                                </p>
                                            </div>
                                        </div>
                                        
                                        <div>
                                            <h4 class="text-sm text-gray-500 mb-2">รูปภาพ</h4>
                                            <% if (request.img) { %>
                                                <div class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
                                                    <img src="<%= request.img %>" alt="รูปภาพขยะ" class="w-full h-50 object-cover">
                                                </div>
                                            <% } else { %>
                                                <div class="rounded-lg border border-gray-200 bg-gray-50 h-48 flex items-center justify-center">
                                                    <p class="text-gray-400 italic">
                                                        <i class="fas fa-image mr-2"></i>
                                                        ไม่มีรูปภาพ
                                                    </p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-6">
                                        <h4 class="font-semibold text-gray-700 mb-3 flex items-center">
                                            <i class="fas fa-recycle text-green-600 mr-2"></i>
                                            รายการขยะ
                                        </h4>
                                        
                                        <div class="bg-gray-50 rounded-lg p-4">
                                            <table class="w-full">
                                                <thead>
                                                    <tr class="border-b border-gray-200">
                                                        <th class="text-left py-2 text-gray-600">ขยะ</th>
                                                        <th class="text-right py-2 text-gray-600">ราคา/หน่วย</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% request.waste.forEach(w => { %>
                                                        <tr class="border-b border-gray-100">
                                                            <td class="py-3">
                                                                <span class="font-medium"><%= w.wasteName %></span>
                                                            </td>
                                                            <td class="py-3 text-right font-medium text-green-700">
                                                                <%= w.pricePerUnit %> บาท/กก.
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="border-t border-gray-200 p-4 flex justify-end space-x-3">
                                    <button onclick="closeModal('<%= request._id %>')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                                        ปิด
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-clipboard-list text-gray-300 text-5xl mb-4"></i>
                        <h3 class="text-xl font-medium text-gray-500">ไม่พบรายการความประสงค์ขายขยะ</h3>
                        <p class="text-gray-400 mt-2">กรุณาเพิ่มรายการใหม่เพื่อแสดงที่นี่</p>
                    </div>
                <% } %>
            </div>  
            <!-- Pagination -->
            <% if (wasteSaleRequests.length > 0) { %>
                <div class="mt-8 flex justify-center">
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        <a href="#" aria-current="page" class="z-10 bg-blue-50 border-blue-500 text-blue-600 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            1
                        </a>
                        <a href="#" class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            2
                        </a>
                        <a href="#" class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            3
                        </a>
                        <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                            ...
                        </span>
                        <a href="#" class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            8
                        </a>
                        <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </nav>
                </div>
            <% } %>          
        </div>
    </main>  
    
</body>
<script>
    function openModal(id) {
        document.getElementById(`modal-${id}`).classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    
    function closeModal(id) {
        document.getElementById(`modal-${id}`).classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
    
    // Close modal when clicking outside
    document.addEventListener('click', function(event) {
        const modals = document.querySelectorAll('[id^="modal-"]');
        modals.forEach(modal => {
            if (event.target === modal) {
                const id = modal.id.replace('modal-', '');
                closeModal(id);
            }
        });
    });
</script>
</html>
