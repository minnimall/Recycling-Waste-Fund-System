<!-- views/error.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            text-align: center;
            padding: 20px;
        }
        .error-message {
            background-color: #e0e0e0;
            border: 1px solid #e0e0e0;
            padding: 20px;
            border-radius: 5px;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 20px;
        }
        .btn {
            padding: 10px 20px;
            background-color: #707070;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #555555;
            transition: 0.3s;
        }
    </style>
</head>
<body>
    <div class="error-message">
        <h1>คุณไม่มีสิทธิ์ในการเข้าถึงหน้านี้</h1>
        <p><%= errorMessage %></p>
        <button class="btn" onclick="window.history.back()">กลับไป</button>
    </div>
</body>
</html>
