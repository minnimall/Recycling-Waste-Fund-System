<!-- Header -->
<header class="bg-primary-green shadow-lg sticky top-0 z-50">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between py-4">
            <!-- Logo -->
            <div class="flex items-center space-x-3">
                <img src="/img/logo_เปือยน้อย.png" class="w-[75px]">
                <!-- <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center">
                        <span class="text-primary-green font-bold text-xl">
                        </span>
                    </div> -->
                <div class="text-white">
                    <h1 class="text-xl font-bold">กองทุนขยะรีไซเคิล</h1>
                    <p class="text-sm opacity-90">องค์การบริหารส่วนตำบลขามป้อม</p>
                </div>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden lg:flex space-x-8">
                <a href="/"
                    class="text-white hover:text-light-green transition-colors font-medium border-b-2 border-white">หน้าหลัก</a>
                <a href="/user/wastetype"
                    class="text-white hover:text-light-green transition-colors font-medium">ประเภทขยะ</a>
                <a href="/user/knowledge"
                    class="text-white hover:text-light-green transition-colors font-medium">สื่อความรู้</a>
                <a href="/user/complaint"
                    class="text-white hover:text-light-green transition-colors font-medium">คำข้อง/ข้อร้องเรียน</a>
                <a href="/user/wasteSaleRequest"
                    class="text-white hover:text-light-green transition-colors font-medium">แจ้งประสงค์</a>
                <a href="/user/contact"
                    class="text-white hover:text-light-green transition-colors font-medium">ติดต่อสอบถาม</a>
                <% if (locals.session.username) { %>
                    <button id="user-menu-button"
                        class="text-m text-white px-4 py-4 rounded-lg shadow-md bg-gray-800 border border-gray-700 flex items-center">
                        <div class="text-left">
                            <div class="font-semibold">ยินดีต้อนรับ : <%= locals.session.username %> ▾</div>
                        </div>
                    </button>
                    <!-- Dropdown Content -->
                    <div id="user-dropdown"
                        class="hidden absolute right-0 mt-2 w-48 bg-stone-900 border border-stone-700 shadow-md rounded-lg overflow-hidden z-[10]">
                        <div class="text-m text-white px-4 py-2 flex items-center">
                            <img src="../img/admin/logo.png" class="h-10 mr-2">
                            <div class="text-xs">
                                <div class="font-bold">
                                    <%= locals.session.username %>
                                </div>
                            </div>
                        </div>
                        <a href="/user/profile"
                            class="block px-4 py-2 text-green-400 hover:bg-green-800 hover:text-white hover:bg-opacity-30 border-t border-stone-700">
                            <i class="fa-solid fa-user mr-2"></i> โปรไฟล์
                        </a>
                        <a href="#" id="logoutBtn"
                            class="block px-4 py-2 text-red-400 hover:bg-red-800 hover:text-white hover:bg-opacity-30 border-t border-stone-700">
                            <i class="fa-solid fa-right-from-bracket mr-2"></i> ออกจากระบบ
                        </a>
                    </div>
                    <% } else { %>
                        <a href="/login"
                            class="bg-white text-primary-green px-4 py-2 rounded-lg hover:bg-light-green transition-colors font-medium">เข้าสู่ระบบ</a>
                        <% } %>
            </nav>
            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="lg:hidden text-white p-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16">
                    </path>
                </svg>
            </button>
        </div>

        <!-- Mobile Navigation -->
        <nav id="mobile-menu" class="lg:hidden hidden pb-4">
            <div class="flex flex-col space-y-2">
                <a href="/"
                    class="text-white hover:text-light-green transition-colors font-medium py-2 border-b border-green-400">หน้าหลัก</a>
                <a href="/user/wastetype"
                    class="text-white hover:text-light-green transition-colors font-medium py-2">ประเภทขยะ</a>
                <a href="/user/knowledge"
                    class="text-white hover:text-light-green transition-colors font-medium py-2">สื่อความรู้</a>
                <a href="/user/complaint"
                    class="text-white hover:text-light-green transition-colors font-medium py-2">คำข้อง/ข้อร้องเรียน</a>
                <a href="/user/wasteSaleRequest"
                    class="text-white hover:text-light-green transition-colors font-medium py-2">แจ้งประสงค์</a>
                <a href="/user/contact"
                    class="text-white hover:text-light-green transition-colors font-medium py-2">ติดต่อสอบถาม</a>

                <% if (locals.session.username) { %>
                    <a href="/user/profile"
                        class="bg-white text-primary-green px-4 py-2 rounded-lg hover:bg-light-green transition-colors font-medium mt-2 text-center">โปรไฟล์</a>
                    <a href="/logout"
                        class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-500 transition-colors font-medium mt-2 text-center">ออกจากระบบ</a>
                    <% } else { %>
                    <a href="/login"
                        class="bg-white text-primary-green px-4 py-2 rounded-lg hover:bg-light-green transition-colors font-medium text-center">เข้าสู่ระบบ</a>
                <% } %>
            </div>
        </nav>
    </div>
</header>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
        if (!mobileMenuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
            mobileMenu.classList.add('hidden');
        }
    });
</script>
<script>
    document.getElementById("user-menu-button").addEventListener("click", function () {
        document.getElementById("user-dropdown").classList.toggle("hidden");
    });

    document.addEventListener("click", function (event) {
        const dropdown = document.getElementById("user-dropdown");
        const button = document.getElementById("user-menu-button");
        if (!button.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.classList.add("hidden");
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        const logoutBtn = document.getElementById('logoutBtn');

        if (logoutBtn) {
            logoutBtn.addEventListener('click', function (event) {
                event.preventDefault();

                Swal.fire({
                    title: "คุณต้องการออกจากระบบหรือไม่?",
                    text: "หากออกจากระบบ คุณต้องเข้าสู่ระบบใหม่",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "ออกจากระบบ",
                    cancelButtonText: "ยกเลิก"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = "/logout";
                    }
                });
            });
        } else {
            console.error("ไม่พบปุ่มออกจากระบบ (logoutBtn)");
        }
    });
</script>