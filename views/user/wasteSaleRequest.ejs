        //         li.textContent = option.textContent;
        //         selectedList.appendChild(li);
        //     });
        // });
    </script>
    <script>
        $(document).ready(function() {
            $('#waste').select2({
                placeholder: "เลือกขยะที่ต้องการขาย",
                allowClear: true
            });
        });
        </script>
        
</body>
