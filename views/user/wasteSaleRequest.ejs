    function initializeMap() {
        const initialLat = 15.9493;
        const initialLng = 102.8551;

        map = new google.maps.Map(document.getElementById('map'), {
            center: { lat: initialLat, lng: initialLng },
            zoom: 13,
            mapTypeId: 'hybrid',
            streetViewControl: false,
            fullscreenControl: true,
            disableDoubleClickZoom: false
        });

        geocoder = new google.maps.Geocoder();
        autocompleteService = new google.maps.places.AutocompleteService();
        placesService = new google.maps.places.PlacesService(map);

        // วาด Polygon ตำบลขามป้อม
        drawTambolPolygon();

        // คลิกบนแผนที่เพื่อปักหมุด
        map.addListener('click', function(e) {
            const lat = e.latLng.lat();
            const lng = e.latLng.lng();

            if (!isWithinTambol(lat, lng)) {
                Swal.fire({
                    icon: 'error',
                    title: 'อยู่นอกพื้นที่',
                    text: 'กรุณาเลือกตำแหน่งภายในเขตตำบลขามป้อมเท่านั้น',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#EF4444'
                });
                return;
            }

            addMarkerAtLocation(lat, lng);
        });

        setupSearch();
    }

    function drawTambolPolygon() {
        // Polygon แสดงบนแผนที่
