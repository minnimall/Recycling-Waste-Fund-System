            paths: KHAMPO_POLYGON_COORDS,
            strokeColor: '#2563EB',
            strokeOpacity: 0.8,
            strokeWeight: 2.5,
            fillColor: '#3B82F6',
            fillOpacity: 0.08,
            map: map,
            zIndex: 0,
            clickable: false // ไม่ดัก event เพื่อให้คลิกผ่านถึง map ได้
        });

        // Polygon สำหรับเช็คพื้นที่ (ไม่แสดงบนแผนที่)
        checkPolygon = new google.maps.Polygon({
            paths: KHAMPO_POLYGON_COORDS
        });

        // Fit bounds แล้ว set zoom
        const bounds = new google.maps.LatLngBounds();
        KHAMPO_POLYGON_COORDS.forEach(coord => bounds.extend(coord));
        map.fitBounds(bounds);

        google.maps.event.addListenerOnce(map, 'bounds_changed', function() {
            map.setZoom(13);
        });
    }

    function isWithinTambol(lat, lng) {
        if (!checkPolygon) return true;
        const point = new google.maps.LatLng(lat, lng);
        return google.maps.geometry.poly.containsLocation(point, checkPolygon);
    }

    async function addMarkerAtLocation(lat, lng) {
        // ลบ marker เดิม
        if (marker) {
            marker.setMap(null);
        }

        // สร้าง marker ใหม่
        marker = new google.maps.Marker({
            position: { lat, lng },
            map: map,
            animation: google.maps.Animation.DROP
        });

        selectedLat = lat;
        selectedLng = lng;

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;
        document.getElementById('display-lat').textContent = lat.toFixed(6);
        document.getElementById('display-lng').textContent = lng.toFixed(6);
        document.getElementById('coordinates-display').style.display = 'block';

        // ดึงที่อยู่ภาษาไทย
        const address = await reverseGeocode(lat, lng);
        document.getElementById('search-input').value = address;
        document.getElementById('location').value = address;
        document.getElementById('display-location').textContent = address;

        // เปิดปุ่ม submit
        const submitBtn = document.getElementById('submit-btn');
        submitBtn.disabled = false;
        submitBtn.classList.remove('bg-gray-400', 'cursor-not-allowed');
        submitBtn.classList.add('bg-primary-green', 'hover:bg-secondary-green');
    }

    async function reverseGeocode(lat, lng) {
        return new Promise((resolve) => {
            geocoder.geocode({
                location: { lat, lng },
                language: 'th'
            }, (results, status) => {
                if (status === 'OK' && results.length > 0) {
                    // กรองเอาแบบที่ไม่ใช่ Plus Code
                    const filtered = results.find(r =>
                        !r.formatted_address.match(/^[A-Z0-9]{4}\+[A-Z0-9]{2,}/)
                    );
                    resolve(filtered ? filtered.formatted_address : results[0].formatted_address);
                } else {
                    resolve(`${lat.toFixed(6)}, ${lng.toFixed(6)}`);
                }
            });
        });
    }

    // ===== ระบบค้นหา =====
    function setupSearch() {
        const searchInput = document.getElementById('search-input');
        const suggestionsDiv = document.getElementById('search-results');

        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value.trim();

            if (query.length < 2) {
                suggestionsDiv.classList.add('hidden');
                return;
            }

            searchTimeout = setTimeout(() => {
                autocompleteService.getPlacePredictions({
                    input: query,
                    location: new google.maps.LatLng(15.9487, 102.8552),
                    radius: 50000,
                    language: 'th'
                }, (predictions, status) => {
                    if (status !== google.maps.places.PlacesServiceStatus.OK || !predictions) {
                        suggestionsDiv.classList.add('hidden');
                        return;
                    }
                    renderSuggestions(predictions);
                });
            }, 300);
        });

        // ซ่อน dropdown เมื่อคลิกนอก
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#search-input') && !e.target.closest('#search-results')) {
                suggestionsDiv.classList.add('hidden');
            }
        });
    }

    function renderSuggestions(predictions) {
        const suggestionsDiv = document.getElementById('search-results');
        let html = '';

        predictions.forEach(pred => {
            const mainText = pred.structured_formatting?.main_text || pred.description;
            const secondaryText = pred.structured_formatting?.secondary_text || '';

            html += `
                <div class="suggestion-item p-3 hover:bg-gray-100 cursor-pointer border-b border-gray-200 last:border-b-0"
                     data-place-id="${pred.place_id}">
                    <div class="font-medium text-gray-900 text-sm">${mainText}</div>
                    ${secondaryText ? `<div class="text-xs text-gray-500 mt-0.5">${secondaryText}</div>` : ''}
                </div>
            `;
        });

        suggestionsDiv.innerHTML = html;
        suggestionsDiv.classList.remove('hidden');

        suggestionsDiv.querySelectorAll('.suggestion-item').forEach(item => {
            item.addEventListener('click', function() {
                const placeId = this.dataset.placeId;
                placesService.getDetails({
                    placeId: placeId,
                    fields: ['geometry', 'formatted_address', 'name']
                }, (place, status) => {
                    if (status === google.maps.places.PlacesServiceStatus.OK && place.geometry) {
                        const lat = place.geometry.location.lat();
                        const lng = place.geometry.location.lng();

                        if (!isWithinTambol(lat, lng)) {
                            Swal.fire({
                                icon: 'error',
                                title: 'อยู่นอกพื้นที่',
                                text: 'สถานที่นี้อยู่นอกเขตตำบลขามป้อม',
                                confirmButtonText: 'ตกลง',
                                confirmButtonColor: '#EF4444'
                            });
                            return;
                        }

                        map.setCenter({ lat, lng });
                        map.setZoom(16);
                        addMarkerAtLocation(lat, lng);
                        suggestionsDiv.classList.add('hidden');
                    }
                });
            });
        });
    }

    // ===== ตำแหน่งปัจจุบัน =====
    const locBtn = document.getElementById('current-location-btn');
    if (locBtn) {
        locBtn.addEventListener('click', function() {
            const button = this;
            const icon = document.getElementById('location-icon');
            const text = document.getElementById('location-text');

            if (!navigator.geolocation) {
                Swal.fire({ icon: 'error', title: 'ไม่รองรับ', text: 'เบราว์เซอร์ไม่รองรับการระบุตำแหน่ง' });
                return;
            }

            button.disabled = true;
            button.classList.add('opacity-75');
            icon.innerHTML = `<svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>`;
            if (text) text.textContent = 'กำลังค้นหา...';

            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    if (!isWithinTambol(lat, lng)) {
                        resetLocationButton();
                        Swal.fire({
                            icon: 'warning',
                            title: 'อยู่นอกพื้นที่',
                            text: 'ตำแหน่งปัจจุบันของคุณอยู่นอกเขตตำบลขามป้อม',
                            confirmButtonText: 'ตกลง'
                        });
                        return;
                    }

                    map.setCenter({ lat, lng });
                    map.setZoom(16);
                    addMarkerAtLocation(lat, lng);
                    resetLocationButton();

                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: 'ใช้ตำแหน่งปัจจุบันของคุณแล้ว',
                        timer: 2000,
                        showConfirmButton: false
                    });
                },
                function(error) {
                    resetLocationButton();
                    let errorMessage = 'ไม่สามารถระบุตำแหน่งได้';
                    if (error.code === error.PERMISSION_DENIED) errorMessage = 'กรุณาอนุญาตการเข้าถึงตำแหน่งในเบราว์เซอร์';
                    else if (error.code === error.POSITION_UNAVAILABLE) errorMessage = 'ข้อมูลตำแหน่งไม่พร้อมใช้งาน';
                    else if (error.code === error.TIMEOUT) errorMessage = 'หมดเวลาค้นหาตำแหน่ง';
                    Swal.fire({ icon: 'error', title: 'ไม่สามารถระบุตำแหน่งได้', text: errorMessage });
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
            );
        });
    }

    function resetLocationButton() {
        const button = document.getElementById('current-location-btn');
        const icon = document.getElementById('location-icon');
        const text = document.getElementById('location-text');

        button.disabled = false;
        button.classList.remove('opacity-75');
        icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>`;
        if (text) text.textContent = 'ตำแหน่งปัจจุบัน';
    }

    // ===== Form Validation =====
    const wasteForm = document.getElementById('waste-sale-form');
    if (wasteForm) {
        wasteForm.addEventListener('submit', function(e) {
            if (!selectedLat || !selectedLng) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกตำแหน่ง',
                    text: 'กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่งที่ต้องการให้เข้ามารับซื้อ',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#059669'
                });
            }
        });
    }

    document.documentElement.style.setProperty('--primary-green', '#059669');
    document.documentElement.style.setProperty('--secondary-green', '#047857');
</script>
</body>
</html>