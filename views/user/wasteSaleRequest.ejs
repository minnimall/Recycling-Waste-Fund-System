<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/wasteSaleRequest.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
</head>
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="/img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li><a href="/">หน้าหลัก</a></li>
                    <li><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li class="select"><a href="/user/wasteSaleRequest">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user icon"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <div class="mt-5 content-header d-flex justify-content-center align-items-center">
                <h1 class="title">แจ้งความประสงค์ขายขยะ</h1>
            </div>
            <div class="mt-5 mb-5 form-saleRequest border rounded p-4 shadow-sm bg-light">
                <div class="mt-2 d-flex justify-content-between align-items-center">
                    <h2>ฟอร์มกรอกข้อมูลเบื้องต้น</h2>
                    <p id="time" class="show-time">วันที่ <span id="date-time"></span></p>
                </div>
                <div>
                    <form id="waste-sale-form" action="/submit-sale" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="waste-type" class="form-label">ขยะที่ต้องการขาย</label>
                            <select class="form-select" id="waste-type" name="wasteType" required>
                                <option value="">เลือกขยะ</option>
                                <option value="พลาสติก">ขวดใส</option>
                                <option value="กระดาษ">กระดาษ</option>
                                <option value="โลหะ">โลหะ</option>
                                <option value="แก้ว">แก้วน้ำ</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="weight" class="form-label">น้ำหนัก (กิโลกรัม)</label>
                            <input type="number" class="form-control" id="weight" name="weight" step="0.1" required>
                        </div>
                        <div class="mb-3">
                            <label for="image" class="form-label">อัปโหลดรูปภาพขยะ</label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                        </div>
                        <div class="d-flex">
                            <button type="submit" class="btn btn-success ms-auto">ส่งข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        if (error) {
            alert(error);
        }
    </script>

    <!-- JavaScript สำหรับแสดงวันเวลา -->
    <script>
        function updateTime() {
            const currentDate = new Date(); // ดึงวันและเวลาปัจจุบัน
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit', 
                hour12: true 
            };
            // แปลงเวลาให้อยู่ในรูปแบบที่ต้องการ
            const timeString = currentDate.toLocaleString('th-TH', options);
            // แสดงเวลาในส่วนที่มี id="current-time"
            document.getElementById('current-time').textContent = timeString;
            document.getElementById('time').textContent = timeString;
        }

        // เรียกใช้ฟังก์ชัน updateTime ทุกๆ 1 วินาที
        setInterval(updateTime, 1000);

        // เรียกใช้ฟังก์ชัน updateTime ทันทีเมื่อโหลดหน้าเว็บ
        updateTime();
    </script>

    <script>
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>

    
</body>
</html>
