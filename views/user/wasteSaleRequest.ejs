                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <div class="mt-5 content-header d-flex justify-content-center align-items-center">
                <h1 class="title">แจ้งความประสงค์ขายขยะ</h1>
            </div>
            <div class="mt-5 mb-5 form-saleRequest border rounded p-4 shadow-sm bg-light">
                <div class="mt-2 d-flex justify-content-between align-items-center">
                    <h2>ฟอร์มกรอกข้อมูลเบื้องต้น</h2>
                    <p id="time" class="show-time">วันที่ <span id="date-time"></span></p>
                </div>
                <div>
                    <form id="waste-sale-form" action="/user/wasteSaleRequestPost" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="waste-type" class="form-label">ขยะที่ต้องการขาย</label>
                            <select class="form-select " id="waste" name="waste[]" multiple required>
                                <% wasteItems.forEach((waste) => { %>
                                <option value="<%= waste._id %>"><%= waste.wasteName %></option>
                                <% }); %>
                            </select>
                        </div>                        
                        <div class="mb-3">
                            <label for="weight" class="form-label">น้ำหนัก (กิโลกรัม) <small class="text-danger">* สามารถระบุหรือไม่ระบุก็ได้</small></label>
                            <input type="number" class="form-control" id="weight" name="weight" step="0.1">
                        </div>
                        <div class="mb-3">
                            <label for="weight" class="form-label">วันที่ให้เข้ามารับซื้อ</label>
                            <input type="date" class="form-control" id="date" name="date" required>
                        </div>
                        <div class="mb-3">
                            <label for="weight" class="form-label">พิกัดที่จะให้เข้ามารับซื้อ</label>
                            <input type="text" class="form-control" id="location" name="location" required>
                        </div>
                        <div class="mb-5">
                            <label for="image" class="form-label">อัปโหลดรูปภาพขยะ</label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                        </div>
                        <div class="d-flex">
                            <button type="submit" class="btn btn-success ms-auto">ส่งข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        //แสดงวัน
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();

