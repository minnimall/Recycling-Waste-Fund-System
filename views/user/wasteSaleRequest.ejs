                    <script>
                        const requestCreatedAt = new Date("<%= latestRequest?.createdAt %>");
                        const deadline = new Date("<%= latestRequest?.userConfirmDeadline %>");

                        /* ================= ยืนยันภายใน 2 ชม. ================= */
                        const countdownEl = document.getElementById("countdown");
                        const deadlineEl = document.getElementById("deadline");
                        const confirmBtn = document.getElementById("confirmBtn");

                        if (deadlineEl) {
                            deadlineEl.innerText = deadline.toLocaleDateString('th-TH',{  year: "numeric", month: "long", day: "numeric"});
                        }

                        function updateCountdown() {
                            const now = new Date();
                            const diff = deadline - now;

                            if (diff <= 0) {
                                countdownEl.innerText = "หมดเวลา";
                                if (confirmBtn) {
                                    confirmBtn.disabled = true;
                                    confirmBtn.classList.add("opacity-50", "cursor-not-allowed");
                                }
                                return;
                            }

                            const h = Math.floor(diff / (1000 * 60 * 60));
                            const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                            const s = Math.floor((diff % (1000 * 60)) / 1000);

                            countdownEl.innerText = `${h} ชม. ${m} นาที ${s} วินาที`;
                        }

                        if (countdownEl) {
                            updateCountdown();
                            setInterval(updateCountdown, 1000);
