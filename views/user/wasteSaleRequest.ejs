<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- Leaflet CSS -->
    <!-- <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> -->
    <!-- Leaflet JS -->
    <!-- <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script> -->
    
    <%- include('../partials/userPartials/head.ejs') %>

    <style>
        .select2-container--default .select2-selection--multiple {
            border: 1px solid #d1d5db;
            border-radius: 0.5rem;
            padding: 0.5rem;
            min-height: 2.5rem;
        }
        .select2-container--default .select2-selection--multiple:focus {
            border-color: #059669;
            outline: none;
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
        }
        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #059669;
            border: 1px solid #059669;
            border-radius: 0.375rem;
            color: white;
            padding: 0.25rem 0.5rem;
            margin: 0.125rem;
        }
        .select2-dropdown {
            border: 1px solid #d1d5db;
            border-radius: 0.5rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        
        #search-results {
            position: relative;
            z-index: 1000;
        }
        
        /* Map Styles */
        #map {
            height: 400px;
            width: 100%;
            /* border-radius: 0.5rem; */
            border: 1px solid #d1d5db;
        }
        
        .coordinates-display {
            background: linear-gradient(135deg, #059669, #047857);
            color: white;
            padding: 0.75rem;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
        }

        /* Status Timeline Styles */
        .step-line {
            height: 4px;
            background: #E5E7EB;
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            z-index: 0;
        }

        .step-progress {
            height: 100%;
            background: linear-gradient(to right, #10B981, #3B82F6);
            transition: width 0.5s ease-in-out;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 1.5rem;
        }

        .status-pulse {
            position: relative;
        }
        .status-pulse::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            border-radius: 50%;
            background-color: currentColor;
            opacity: 0.4;
            animation: pulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        @keyframes pulse {
            75%, 100% {
                transform: scale(1.5);
                opacity: 0;
            }
        }
    </style>
</head>
<body class="bg-gray-50">
    <script async
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCOj0SmyVA_9XcjvxjELwfzvO8LNN6uJgw&libraries=places,geometry&loading=async&callback=initializeMap">
    </script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>

    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">แจ้งความประสงค์ขายขยะ</h2>
            <p class="text-xl opacity-90">สำหรับเข้าไปรับซื้อขยะที่ขนมาขายไม่ได้</p>
        </div>
    </section>

    <!-- Waste Sale Request -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <% if (session && session.user) { %>
                    
                    <% 
                        let currentStep = 1;
                        if (hasPendingRequest) currentStep = 2;
                        if (hasComfirmed) currentStep = 3;
                        if (hasInprogress) currentStep = 4;
                        
                        let progressWidth = "0%";
                        if (currentStep === 2) progressWidth = "33%";
                        if (currentStep === 3) progressWidth = "66%";
                        if (currentStep === 4) progressWidth = "100%";
                    %>

                    <!-- Status Timeline -->
                    <div class="mb-12 mt-4 px-6 relative">
                        <div class="step-line rounded-full">
                            <div class="step-progress rounded-full" style="width: <%= progressWidth %>"></div>
                        </div>
                        <div class="flex justify-between items-center relative z-10">
                            <!-- Step 1 -->
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 rounded-full border-4 border-white flex items-center justify-center shadow-md transition-all duration-500 <%= currentStep >= 1 ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-500' %>">
                                    <i class="fa-solid fa-paper-plane text-xs"></i>
                                </div>
                                <span class="mt-2 text-[10px] md:text-xs font-bold <%= currentStep >= 1 ? 'text-green-600' : 'text-gray-400' %>">ส่งคำขอแล้ว</span>
                            </div>
                            <!-- Step 2 -->
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 rounded-full border-4 border-white flex items-center justify-center shadow-md transition-all duration-500 <%= currentStep >= 2 ? 'bg-yellow-500 text-white status-pulse' : 'bg-gray-200 text-gray-500' %> <%= currentStep > 2 ? 'bg-green-500' : '' %>">
                                    <i class="fa-solid fa-hourglass-half text-xs"></i>
                                </div>
                                <span class="mt-2 text-[10px] md:text-xs font-bold <%= currentStep >= 2 ? 'text-yellow-600' : 'text-gray-400' %> <%= currentStep > 2 ? 'text-green-600' : '' %>">รอการอนุมัติ</span>
                            </div>
                            <!-- Step 3 -->
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 rounded-full border-4 border-white flex items-center justify-center shadow-md transition-all duration-500 <%= currentStep >= 3 ? 'bg-blue-500 text-white status-pulse' : 'bg-gray-200 text-gray-500' %> <%= currentStep > 3 ? 'bg-green-500' : '' %>">
                                    <i class="fa-solid fa-calendar-check text-xs"></i>
                                </div>
                                <span class="mt-2 text-[10px] md:text-xs font-bold <%= currentStep >= 3 ? 'text-blue-600' : 'text-gray-400' %> <%= currentStep > 3 ? 'text-green-600' : '' %>">นัดหมายแล้ว</span>
                            </div>
                            <!-- Step 4 -->
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 rounded-full border-4 border-white flex items-center justify-center shadow-md transition-all duration-500 <%= currentStep >= 4 ? 'bg-indigo-500 text-white status-pulse' : 'bg-gray-200 text-gray-500' %>">
                                    <i class="fa-solid fa-truck-fast text-xs"></i>
                                </div>
                                <span class="mt-2 text-[10px] md:text-xs font-bold <%= currentStep >= 4 ? 'text-indigo-600' : 'text-gray-400' %>">พนักงานกำลังเข้า</span>
                            </div>
                        </div>
                    </div>

                    


                    <% if (hasPendingRequest) { %>
                    <!-- ================= มีคำขอรอการอนุมัติ ================= -->
                    <div class="mt-8 mb-10 overflow-hidden">
                        <div class="bg-gradient-to-br from-yellow-50 via-white to-orange-50 rounded-3xl border border-yellow-200 p-8 md:p-12 relative overflow-hidden">
                            <!-- Background Decoration -->
                            <!-- <div class="absolute -top-24 -right-24 w-64 h-64 bg-yellow-200 rounded-full opacity-20 blur-3xl"></div> -->
                            
                            <div class="relative z-10 flex flex-col items-center text-center gap-8">
                                <!-- Status Badge -->
                                <div class="bg-yellow-100/80 backdrop-blur px-4 py-1.5 rounded-full border border-yellow-200 flex items-center gap-2">
                                    <span class="w-2 h-2 bg-yellow-500 rounded-full animate-ping"></span>
                                    <span class="text-xs font-bold text-yellow-700 uppercase tracking-wider">กำลังตรวจสอบคำขอ</span>
                                </div>

                                <div class="space-y-3">
                                    <h2 class="text-3xl font-extrabold text-gray-800 tracking-tight">ได้รับคำขอของคุณแล้ว!</h2>
                                    <p class="text-gray-500 max-w-sm mx-auto">พนักงานกำลังตรวจสอบตารางเวลาเข้ารับซื้อ แล้วจะตอบกลับคุณโดยเร็วที่สุด</p>
                                </div>

                                <!-- Info Grid -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                                    <div class="glass-card p-5 text-left flex items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
                                        <div class="w-10 h-10 rounded-xl bg-yellow-100 text-yellow-600 flex items-center justify-center flex-shrink-0">
                                            <i class="fa-solid fa-calendar-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 font-bold uppercase mb-1">วันที่คุณสะดวก</p>
                                            <p class="font-bold text-gray-800 text-lg">
                                                <%= new Date(latestRequest.date).toLocaleDateString('th-TH',{ year: "numeric", month: "long", day: "numeric"}) %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="glass-card p-5 text-left flex items-start gap-4 shadow-sm hover:shadow-md transition-shadow">
                                        <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center flex-shrink-0">
                                            <i class="fa-solid fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 font-bold uppercase mb-1">สถานที่จัดเก็บ</p>
                                            <p class="font-bold text-gray-800 line-clamp-2 leading-snug">
                                                <% if (latestRequest.locationMoreDetail){ %><%= latestRequest.locationMoreDetail %>, <% } %> <%= latestRequest.location %>
                                            </p>
                                            <a href="https://www.google.com/maps?q=<%= latestRequest.latitude %>,<%= latestRequest.longitude %>" 
                                               target="_blank" class="text-xs font-bold text-yellow-600 hover:text-yellow-700 mt-2 inline-flex items-center gap-1">
                                                <i class="fas fa-external-link-alt"></i> ดูในแผนที่
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                                    <button id="cancelRequestBtn"
                                            class="px-8 py-3.5 bg-white border-2 border-red-50 text-red-600 hover:bg-red-50 rounded-2xl font-bold transition-all shadow-sm hover:shadow active:scale-95">
                                        ยกเลิกคำขอ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <script>
                    document.getElementById("cancelRequestBtn").addEventListener("click", function () {
                        Swal.fire({
                            title: 'ยืนยันการยกเลิก?',
                            text: 'กรุณาเลือกเหตุผลในการยกเลิกคำขอ',
                            icon: 'warning',
                            input: 'select',
                            inputOptions: {
                                CHANGE_PLAN: 'เปลี่ยนแผนการขายขยะ',
                                NOT_AVAILABLE_DATE: 'ยังไม่สะดวกในวันที่เลือก',
                                WANT_RESCHEDULE: 'ต้องการเลื่อนวัน',
                                WASTE_NOT_READY: 'ขยะยังไม่พร้อม',
                                LESS_WASTE: 'ปริมาณขยะน้อย',
                                WRONG_WASTE_TYPE: 'ขยะไม่ตรงประเภท',
                                LOCATION_ISSUE: 'ปัญหาสถานที่',
                                NO_ONE_AT_HOME: 'ไม่มีคนอยู่',
                                PRICE_NOT_MATCH: 'ราคาไม่ตรง',
                                WEATHER: 'สภาพอากาศ',
                                EMERGENCY: 'เหตุฉุกเฉิน',
                                OTHER: 'อื่น ๆ'
                            },
                            inputPlaceholder: 'เลือกเหตุผล',
                            showCancelButton: true,
                            confirmButtonText: 'ยืนยันยกเลิก',
                            cancelButtonText: 'ปิด',
                            confirmButtonColor: '#dc2626',
                            cancelButtonColor: '#6b7280',
                            customClass: {
                                popup: 'rounded-3xl',
                                confirmButton: 'rounded-xl px-6 py-2.5 font-bold',
                                cancelButton: 'rounded-xl px-6 py-2.5 font-bold'
                            },
                            inputValidator: (value) => {
                                if (!value) return 'กรุณาเลือกเหตุผลก่อนยืนยัน';
                            }
                        }).then((swalResult) => {
                            if (!swalResult.isConfirmed) return;
                            
                            fetch(`/user/wasteSaleRequestUserReject/WAITING_APPROVAL/<%= latestRequest._id %>`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ reason: swalResult.value })
                            })
                            .then(res => res.json())
                            .then(result => {
                                if (result.success) {
                                    Swal.fire({ icon: 'success', title: 'ยกเลิกสำเร็จ', text: result.message })
                                    .then(() => { window.location.href = '/user/wasteSaleRequest'; });
                                } else {
                                    Swal.fire('ผิดพลาด', result.message, 'error');
                                }
                            });
                        });
                    });
                    </script>


                    <%} else if (hasComfirmed) { %>
                    <!-- ================= ยืนยันแล้วรอดำเนินการ ================= -->
                    <div class="mt-8 mb-10 overflow-hidden">
                        <div class="bg-gradient-to-br from-blue-50 via-white to-green-50 rounded-3xl shadow-xl border border-blue-200 p-8 md:p-12 relative overflow-hidden">
                            <!-- Background Decoration -->
                            <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-200 rounded-full opacity-20 blur-3xl"></div>
                            
                            <div class="relative z-10 flex flex-col items-center text-center gap-8">
                                <!-- Status Badge -->
                                <div class="bg-blue-100/80 backdrop-blur px-4 py-1.5 rounded-full border border-blue-200 flex items-center gap-2">
                                    <span class="w-2 h-2 bg-blue-500 rounded-full animate-ping"></span>
                                    <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">ยืนยันนัดหมายแล้ว</span>
                                </div>

                                <div class="space-y-3">
                                    <h2 class="text-3xl font-extrabold text-gray-800 tracking-tight">เตรียมนัดหมายเข้ารับซื้อ</h2>
                                    <p class="text-gray-500 max-w-sm mx-auto">พนักงานได้ยืนยันวันเข้ารับซื้อขยะของคุณแล้ว กรุณาเตรียมขยะให้พร้อมตามวันเวลาที่กำหนด</p>
                                </div>

                                <!-- Pickup Highlight -->
                                <div class="w-full bg-white/60 backdrop-blur-md rounded-2xl border border-blue-100 p-6 shadow-sm flex flex-col items-center gap-2">
                                    <p class="text-xs font-bold text-blue-500 uppercase tracking-widest">วันที่เจ้าหน้าที่จะเข้าจัดเก็บ</p>
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-4xl font-black text-gray-800">
                                            <%= new Date(latestRequest.approvePickupDate).toLocaleDateString('th-TH',{ day: "numeric", month: "long" }) %>
                                        </span>
                                        <span class="text-xl font-bold text-gray-500">
                                            <%= new Date(latestRequest.approvePickupDate).toLocaleDateString('th-TH',{ year: "numeric" }) %>
                                        </span>
                                    </div>
                                    <div id="progressCountdown" class="mt-2 px-4 py-1 bg-blue-600 text-white rounded-full text-sm font-bold shadow-md">
                                        ---
                                    </div>
                                </div>

                                <!-- Info Grid -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                                    <div class="glass-card p-5 text-left flex items-start gap-4 shadow-sm">
                                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 font-bold uppercase mb-1">ผู้ขาย</p>
                                            <p class="font-bold text-gray-800">
                                                <%= latestRequest.family.familyName %> <span class="text-gray-400 font-normal">#<%= latestRequest.family.username %></span>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="glass-card p-5 text-left flex items-start gap-4 shadow-sm">
                                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 font-bold uppercase mb-1">สถานที่จัดเก็บ</p>
                                            <p class="font-bold text-gray-800 line-clamp-2 leading-snug">
                                                <% if (latestRequest.locationMoreDetail) {%> <%= latestRequest.locationMoreDetail %>, <%}%>  <%= latestRequest.location %>
                                            </p>
                                            <a href="https://www.google.com/maps?q=<%= latestRequest.latitude %>,<%= latestRequest.longitude %>" 
                                               target="_blank" class="text-xs font-bold text-blue-600 hover:text-blue-700 mt-2 inline-flex items-center gap-1">
                                                <i class="fas fa-external-link-alt"></i> เปิด Google Maps
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notice -->
                                <div class="flex items-center gap-3 text-sm text-gray-500 bg-gray-50/50 p-4 rounded-xl w-full justify-center">
                                    <i class="fa-solid fa-circle-info text-blue-400"></i>
                                    <span>เจ้าหน้าที่จะติดต่อคุณล่วงหน้าก่อนถึงสถานที่</span>
                                </div>

                                <!-- Actions -->
                                <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                                    <button id="cancelRequestBtn3"
                                            class="px-8 py-3.5 bg-white border-2 border-red-50 text-red-600 hover:bg-red-50 rounded-2xl font-bold transition-all shadow-sm hover:shadow active:scale-95">
                                        ยกเลิกคำขอ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <script>
                    /* ================= รอการดำเนินการ Countdown ================= */
                    function initCountdown() {
                        const targetDate = new Date("<%= pickupDate %>");
                        const countdownEl = document.getElementById("progressCountdown");

                        function toThaiTime(date) {
                            return new Date(date.toLocaleString("en-US", { timeZone: "Asia/Bangkok" }));
                        }

                        function update() {
                            const nowTH = toThaiTime(new Date());
                            const diff = targetDate - nowTH;

                            if (diff <= 0) {
                                countdownEl.innerText = "ถึงวันเข้ารับซื้อแล้ว";
                                countdownEl.classList.replace('bg-blue-600', 'bg-green-600');
                                return;
                            }

                            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                            const hrs = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                            const secs = Math.floor((diff % (1000 * 60)) / 1000);

                            countdownEl.innerText = `อีก ${days} วัน ${hrs}:${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
                        }

                        update();
                        setInterval(update, 1000);
                    }
                    initCountdown();

                    document.getElementById("cancelRequestBtn3").addEventListener("click", function () {
                        Swal.fire({
                            title: 'ยืนยันการยกเลิก?',
                            text: 'กรุณาเลือกเหตุผลในการยกเลิกคำขอ',
                            icon: 'warning',
                            input: 'select',
                            inputOptions: {
                                CHANGE_PLAN: 'เปลี่ยนแผนการขายขยะ',
                                NOT_AVAILABLE_DATE: 'ยังไม่สะดวกในวันที่เลือก',
                                WANT_RESCHEDULE: 'ต้องการเลื่อนวัน',
                                WASTE_NOT_READY: 'ขยะยังไม่พร้อม',
                                LESS_WASTE: 'ปริมาณขยะน้อย',
                                WRONG_WASTE_TYPE: 'ขยะไม่ตรงประเภท',
                                LOCATION_ISSUE: 'ปัญหาสถานที่',
                                NO_ONE_AT_HOME: 'ไม่มีคนอยู่',
                                PRICE_NOT_MATCH: 'ราคาไม่ตรง',
                                WEATHER: 'สภาพอากาศ',
                                EMERGENCY: 'เหตุฉุกเฉิน',
                                OTHER: 'อื่น ๆ'
                            },
                            inputPlaceholder: 'เลือกเหตุผล',
                            showCancelButton: true,
                            confirmButtonText: 'ยืนยันยกเลิก',
                            cancelButtonText: 'ปิด',
                            confirmButtonColor: '#dc2626',
                            cancelButtonColor: '#6b7280',
                            customClass: {
                                popup: 'rounded-3xl',
                                confirmButton: 'rounded-xl px-6 py-2.5 font-bold',
                                cancelButton: 'rounded-xl px-6 py-2.5 font-bold'
                            },
                            inputValidator: (value) => {
                                if (!value) return 'กรุณาเลือกเหตุผลก่อนยืนยัน';
                            }
                        }).then((swalResult) => {
                            if (!swalResult.isConfirmed) return;
                            fetch(`/user/wasteSaleRequestUserReject/WAITING_APPROVAL/<%= latestRequest._id %>`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ reason: swalResult.value })
                            })
                            .then(res => res.json())
                            .then(result => {
                                if (result.success) {
