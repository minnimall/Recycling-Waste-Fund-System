    <script>
        // แสดงวัน
        function updateTime() {
            const currentDate = new Date();
            const timeString = currentDate.toLocaleString('th-TH', {year: 'numeric', month: 'long', day: 'numeric'});
            document.getElementById('date-time').textContent = timeString;
        }
        updateTime();

        // Initialize Select2
        $(document).ready(function() {
            $('#waste').select2({
                placeholder: "เลือกขยะที่ต้องการขาย",
                allowClear: true
            });
        });

        // Set minimum date to today
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('date').setAttribute('min', today);
        });

        // Initialize Map
        let map;
        let marker;
        let selectedLat = null;
        let selectedLng = null;

        function initializeMap() {
            // set จุดเริ่มหน้าแมพเป็น อบต.ขามป้อม
            const initialLat = 15.9493;
            const initialLng = 102.8551;
            
            // Initialize map centered on อบต.ขามป้อม
            map = L.map('map').setView([initialLat, initialLng], 13);

            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);

            // Add click event to map
            map.on('click', function(e) {
                const lat = e.latlng.lat;
                const lng = e.latlng.lng;
                
                addMarkerAtLocation(lat, lng);
            });

            // Try to get user's current location (optional)
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    // Don't change the map view, just log the user's location
                    console.log('User location:', position.coords.latitude, position.coords.longitude);
                }, function(error) {
                    console.log('Geolocation error:', error);
                });
            }
        }

        // Function to add marker at specific location
        async function addMarkerAtLocation(lat, lng) {
            // Remove existing marker (only one marker allowed)
            if (marker) {
                map.removeLayer(marker);
            }
            
            // Add new marker
            marker = L.marker([lat, lng]).addTo(map);
            
            // Update coordinates
            selectedLat = lat;
            selectedLng = lng;
            
            // Update hidden inputs
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;
            
            // Update display
            document.getElementById('display-lat').textContent = lat.toFixed(6);
            document.getElementById('display-lng').textContent = lng.toFixed(6);
            document.getElementById('coordinates-display').style.display = 'block';

            const address = await getAddressFromLatLng(lat, lng);
            document.getElementById('search-input').value = address;
            document.getElementById('location').value = address;
            document.getElementById("display-location").innerHTML = address;
            
            // Enable submit button
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = false;
            submitBtn.classList.remove('bg-gray-400', 'cursor-not-allowed');
            submitBtn.classList.add('bg-primary-green', 'hover:bg-secondary-green');
        }

        // Search functionality
        let searchTimeout;
        document.getElementById('search-input').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value.trim();
            
            if (query.length < 3) {
                document.getElementById('search-results').classList.add('hidden');
                return;
            }
            
            searchTimeout = setTimeout(() => {
                searchLocation(query);
            }, 500);
        });

        function searchLocation(query) {
            // Using Nominatim API for geocoding
            const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5&countrycodes=th`;
            
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    displaySearchResults(data);
                })
                .catch(error => {
                    console.error('Search error:', error);
                });
        }
        // ฟังก์ชันดึงที่อยู่จาก lat,lng
        async function getAddressFromLatLng(lat, lng) {
            const url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&accept-language=th&limit=5&countrycodes=th`;
            const response = await fetch(url);
            const data = await response.json();
            return data.display_name || `${lat}, ${lng}`;
        }

        function displaySearchResults(results) {
            const resultsContainer = document.getElementById('search-results');
            resultsContainer.innerHTML = '';
            
            if (results.length === 0) {
                resultsContainer.innerHTML = '<div class="p-3 text-gray-500">ไม่พบสถานที่ที่ค้นหา</div>';
                resultsContainer.classList.remove('hidden');
                return;
            }
            
            results.forEach(result => {
                const div = document.createElement('div');
                div.className = 'p-3 hover:bg-gray-100 cursor-pointer border-b border-gray-200 last:border-b-0';
                div.innerHTML = `
                    <div class="font-medium text-gray-900">${result.display_name}</div>
                    <div class="text-sm text-gray-500">ละติจูด: ${parseFloat(result.lat).toFixed(6)}, ลองติจูด: ${parseFloat(result.lon).toFixed(6)}</div>
                `;
                
                div.addEventListener('click',async function() {
                    const lat = parseFloat(result.lat);
                    const lng = parseFloat(result.lon);
                    
                    // Move map to location and add marker
                    map.setView([lat, lng], 16);
                    addMarkerAtLocation(lat, lng);
                    
                    const address = await getAddressFromLatLng(lat, lng);
                    document.getElementById("display-location").innerHTML = address;
                    // Clear search
                    // document.getElementById('search-input').value = result.display_name.split(',')[0];
                    document.getElementById('search-input').value = address;
                    resultsContainer.classList.add('hidden');
                });
                
                resultsContainer.appendChild(div);
            });
            
            resultsContainer.classList.remove('hidden');
        }

        // Current Location functionality
        document.getElementById('current-location-btn').addEventListener('click', function() {
            const button = this;
            const icon = document.getElementById('location-icon');
            const text = document.getElementById('location-text');
            
            // Check if geolocation is supported
            if (!navigator.geolocation) {
                Swal.fire({
                    icon: 'error',
                    title: 'ไม่รองรับ',
                    text: 'เบราว์เซอร์ของคุณไม่รองรับการระบุตำแหน่ง',
                    confirmButtonColor: '#059669'
                });
                return;
            }
            
            // Show loading state
            button.disabled = true;
            button.classList.add('opacity-75');
            icon.innerHTML = `<svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>`;
            text.textContent = 'กำลังค้นหา...';
            
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    
                    // Move map to user location and add marker
                    map.setView([lat, lng], 16);
                    addMarkerAtLocation(lat, lng);
                    
                    // Get address from coordinates
                    reverseGeocode(lat, lng);
                    
                    // Reset button state
                    resetLocationButton();
                    
                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: 'ใช้ตำแหน่งปัจจุบันของคุณแล้ว',
                        timer: 2000,
                        showConfirmButton: false,
                        confirmButtonColor: '#059669'
                    });
                },
                function(error) {
                    resetLocationButton();
                    
                    let errorMessage = 'ไม่สามารถระบุตำแหน่งได้';
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            errorMessage = 'คุณได้ปฏิเสธการเข้าถึงตำแหน่ง กรุณาอนุญาตในเบราว์เซอร์';
                            break;
                        case error.POSITION_UNAVAILABLE:
                            errorMessage = 'ข้อมูลตำแหน่งไม่พร้อมใช้งาน';
                            break;
                        case error.TIMEOUT:
                            errorMessage = 'หมดเวลาในการค้นหาตำแหน่ง';
                            break;
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'ไม่สามารถระบุตำแหน่งได้',
                        text: errorMessage,
                        confirmButtonColor: '#059669'
                    });
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 60000
                }
            );
        });

        function resetLocationButton() {
            const button = document.getElementById('current-location-btn');
            const icon = document.getElementById('location-icon');
            const text = document.getElementById('location-text');
            
            button.disabled = false;
            button.classList.remove('opacity-75');
            icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>`;
            text.textContent = 'ตำแหน่งปัจจุบัน';
        }

        function reverseGeocode(lat, lng) {
            const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1&accept-language=th`;
            
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data && data.display_name) {
                        // Update the search input with the address
                        // document.getElementById('search-input').value = data.display_name.split(',').slice(0, 3).join(', ');
                    }
                })
                .catch(error => {
                    console.error('Reverse geocoding error:', error);
                });
        }

        // Hide search results when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#search-input') && !e.target.closest('#search-results')) {
                document.getElementById('search-results').classList.add('hidden');
            }
        });

        // Initialize map when page loads
        document.addEventListener('DOMContentLoaded', function() {
            initializeMap();
        });

        // Form validation
        document.getElementById('waste-sale-form').addEventListener('submit', function(e) {
            if (!selectedLat || !selectedLng) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกตำแหน่ง',
                    text: 'กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่งที่ต้องการให้เข้ามารับซื้อ',
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#059669'
                });
            }
        });

        // Custom styles for the color scheme
        document.documentElement.style.setProperty('--primary-green', '#059669');
        document.documentElement.style.setProperty('--secondary-green', '#047857');
    </script>
</body>
</html>