            <!-- Tips -->
            <div class="bg-light-green rounded-lg p-8 mt-12">
                <h3 class="text-2xl font-bold text-primary-green mb-6">เคล็ดลับการแยกขยะ</h3>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-semibold text-gray-800 mb-3">✅ ควรทำ</h4>
                        <ul class="space-y-2 text-gray-700">
                            <li>• ล้างภาชนะให้สะอาดก่อนทิ้ง</li>
                            <li>• แยกขยะตั้งแต่ต้นทาง</li>
                            <li>• ใช้ถุงตามสีที่กำหนด</li>
                            <li>• วางขยะตามเวลาที่กำหนด</li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-800 mb-3">❌ ไม่ควรทำ</h4>
                        <ul class="space-y-2 text-gray-700">
                            <li>• ทิ้งขยะปนกัน</li>
                            <li>• ทิ้งขยะเปียกใส่ถุงพลาสติก</li>
                            <li>• วางขยะนอกเวลา</li>
                            <li>• ทิ้งขยะอันตรายรวมกับขยะทั่วไป</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div class="content">
        <div class="container">
            <section class="mt-3">
                <!-- ส่วนข่าวสารกับแสดงราคาขยะ -->
                <form action="/user/wastetype" method="get">
                    <div class="mt-5 title-idea d-flex justify-content-between align-items-center">
                            <p class="mb-3 title">ประเภทขยะทั้งหมด</p>
                            <div class="mb-3 d-flex">
                                <select id="wasteType" name="wasteType" class="form-select">
                                    <option value="" disabled selected>-- กรุณาเลือกประเภทขยะ --</option>
                                    <% wasteTypes.forEach((type) => { %>
                                        <option value="<%= type._id %>" <%= selectedWasteType === type._id ? 'selected' : '' %>><%= type.wasteTypeName %></option>
                                    <% }); %>
                                </select>
                                <button type="submit" class="btn btn-success ms-2">ค้นหา</button>
                            </div>
                    </div>
                </form>
                
                <div class="row">
                    <% if (waste.length > 0) { %>
                        <% waste.forEach((item, index) => { %>
                            <div class="col-3 mt-3">
                                <div class="card">
                                    <img class="d-block w-100 card-img-custom" src="<%= item.img %>" alt="รูป <%= item.img %>">
                                    <div class="card-body d-flex justify-content-between align-items-center">
                                        <p class="card-title text-center "><%= item.wasteName %></p>
                                        <p class="card-title text-center ms-5"><%= item.pricePerUnit %> บาท/กก.</p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="mt-3 no-data-container">
                            <span>ยังไม่มีข้อมูล</span>
                        </div>
                    <% } %>
                </div>
                
                <!-- Pagination Controls -->
                <div class="pagination mt-4">
                    <% if (currentPage > 1) { %>
                        <a href="/user/wastetype?page=<%= currentPage - 1 %>&wasteType=<%= selectedWasteType %>" class="prev">ก่อนหน้า</a>
                    <% } %>
                
                    <span>Page <%= currentPage %> of <%= totalPages %></span>
                
                    <% if (currentPage < totalPages) { %>
                        <a href="/user/wastetype?page=<%= currentPage + 1 %>&wasteType=<%= selectedWasteType %>" class="next">หน้าถัดไป</a>
                    <% } %>
                </div>                                               
            </section>
        </div>
    </div>

    <%- include('../partials/userPartials/footer.ejs') %>

</body>
</html>
