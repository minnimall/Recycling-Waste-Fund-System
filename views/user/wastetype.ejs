<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/style_wastetype.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="/img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li><a href="/">หน้าหลัก</a></li>
                    <li class="select"><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li><a href="./after_learning.html">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <section class="mt-3">

                <!-- ส่วนข่าวสารกับแสดงราคาขยะ -->
                <div class="row">
                    <div class="col-6 mt-5">
                        <p class="mb-3 title">ประเภทขยะทั้งหมด</p>
                    </div>
                    <div class="col-6 mt-5">
                        <select id="wasteType" name="wasteType" class="form-select">
                            <option value="" disabled selected>-- กรุณาเลือกประเภทขยะ --</option>
                            <% wasteTypes.forEach((type) => { %>
                                <option value="<%= type._id %>"><%= type.wasteTypeName %></option>
                            <% }); %>
                        </select>
                    </div>
                    <% if (waste.length > 0) { %>
                        <% waste.forEach((item, index) => { %>
                    <div class="col-3 mt-3">
                        <div class="card">
                            <img class="d-block w-100 card-img-custom" src="<%= item.img %>" alt="รูป <%= item.img %>">
                            <div class="card-body">
                                <p class="card-title"><%= item.wasteName %></p>
                            </div>
                        </div>
                    </div>
                        <% }); %>
                    <% } else { %>
                        <div>
                            <span>ยังไม่มีข้อมูล</span>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>

</body>
</html>
