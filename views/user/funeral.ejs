                deceasedHouseRegistration: 'สำเนาทะเบียนบ้านผู้ตาย',
                applicantIdCard: 'สำเนาบัตรประชาชนผู้ยื่นคำขอ',
                applicantHouseRegistration: 'สำเนาทะเบียนบ้านผู้ยื่นคำขอ'
            };

            // สร้าง HTML สำหรับแสดงไฟล์
            let filesHTML = '';
            if (formData.files && Object.keys(formData.files).length > 0) {
                filesHTML = '<div class="bg-gray-50 rounded-lg p-4 md:col-span-2"><h4 class="font-semibold text-gray-900 mb-3">เอกสารประกอบ</h4><div class="space-y-2">';
                
                Object.entries(formData.files).forEach(([fieldName, fileInfo]) => {
                    const isPDF = fileInfo.type === 'application/pdf';
                    const icon = isPDF 
                        ? '<svg class="w-8 h-8 text-red-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" /></svg>'
                        : '<svg class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>';
                    
                    filesHTML += `
                        <div class="flex items-center space-x-3 p-2 bg-white border border-gray-200 rounded">
                            ${icon}
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-800">${fileLabels[fieldName]}</p>
                                <p class="text-xs text-gray-600">${fileInfo.name} (${fileInfo.size} MB)</p>
                            </div>
                            <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                    `;
                });
                
                filesHTML += '</div></div>';
            }

            container.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-semibold text-gray-900 mb-3">ข้อมูลผู้รับผิดชอบ</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">ชื่อ-นามสกุล:</span> <span class="font-medium">${formData.responsiblePersonName}</span></div>
                            <div><span class="text-gray-600">ความสัมพันธ์:</span> <span class="font-medium">${formData.relationship}</span></div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-semibold text-gray-900 mb-3">ข้อมูลผู้เสียชีวิต</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">ชื่อ-นามสกุล:</span> <span class="font-medium">${formData.deceasedName}</span></div>
                            <div><span class="text-gray-600">อายุ:</span> <span class="font-medium">${formData.deceasedAge} ปี</span></div>
                            <div><span class="text-gray-600">บัตรประชาชน:</span> <span class="font-medium">${formatThaiID(formData.idCard)}</span></div>
                            <div><span class="text-gray-600">วันที่เสียชีวิต:</span> <span class="font-medium">${dateStr}</span></div>
                            <div><span class="text-gray-600">สาเหตุ:</span> <span class="font-medium">${formData.causeOfDeath}</span></div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-50 rounded-lg p-4 md:col-span-2">
                        <h4 class="font-semibold text-gray-900 mb-3">ที่อยู่</h4>
                        <p class="text-sm">
                            ${formData.deceasedAddress} หมู่ ${formData.deceasedVillage} 
                            ต.${formData.subDistrict} อ.${formData.district} 
                            จ.${formData.province} ${formData.postalCode}
                        </p>
                        <div class="mt-2"><span class="text-gray-600">โทรศัพท์:</span> <span class="font-medium">${formData.phone}</span></div>
                    </div>
                    
                    ${filesHTML}
                    
                    ${formData.notes ? `
                        <div class="bg-gray-50 rounded-lg p-4 md:col-span-2">
                            <h4 class="font-semibold text-gray-900 mb-3">หมายเหตุ</h4>
                            <p class="text-sm text-gray-700">${formData.notes}</p>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        async function submitRequest() {
            try {
                const confirmed = await Swal.fire({
                    title: 'ยืนยันการยื่นเรื่อง?',
                    text: 'คุณต้องการยื่นเรื่องขอรับฌาปนกิจหรือไม่?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'ยืนยัน',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6b7280'
                });

                if (!confirmed.isConfirmed) return;

                // ตรวจสอบไฟล์อีกครั้งก่อนส่ง
                const requiredFiles = [
                    'deathCertificate',
                    'deceasedIdCard',
                    'deceasedHouseRegistration',
                    'applicantIdCard',
                    'applicantHouseRegistration'
                ];

                const missingFiles = [];
                requiredFiles.forEach(id => {
                    const input = document.getElementById(id);
                    if (!input.files || input.files.length === 0) {
                        missingFiles.push(id);
                    }
                });

                if (missingFiles.length > 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไม่พบไฟล์เอกสาร',
                        text: 'กรุณากลับไปอัปโหลดเอกสารให้ครบถ้วน',
                        confirmButtonColor: '#ef4444'
                    });
                    return;
                }

                Swal.fire({
                    title: 'กำลังส่งคำขอ...',
                    html: 'กรุณารอสักครู่ ระบบกำลังอัปโหลดเอกสาร',
                    allowOutsideClick: false,
                    didOpen: function() { 
                        Swal.showLoading(); 
                    }
                });

                // สร้าง FormData เพื่อส่งทั้งข้อมูลและไฟล์
                const formDataToSend = new FormData();
                
                // เพิ่มข้อมูลทั่วไป
                formDataToSend.append('responsiblePersonName', formData.responsiblePersonName);
                formDataToSend.append('relationship', formData.relationship);
                formDataToSend.append('deceasedName', formData.deceasedName);
                formDataToSend.append('deceasedAge', formData.deceasedAge);
                formDataToSend.append('idCard', formData.idCard);
                formDataToSend.append('phone', formData.phone);
                formDataToSend.append('dateOfDeath', formData.dateOfDeath);
                formDataToSend.append('causeOfDeath', formData.causeOfDeath);
                formDataToSend.append('deceasedAddress', formData.deceasedAddress);
                formDataToSend.append('deceasedVillage', formData.deceasedVillage);
                formDataToSend.append('subDistrict', formData.subDistrict);
                formDataToSend.append('district', formData.district);
                formDataToSend.append('province', formData.province);
                formDataToSend.append('postalCode', formData.postalCode);
                formDataToSend.append('notes', formData.notes || '');

                // ✅ เพิ่มการส่ง memberID
                if (formData.memberID && formData.memberID !== 'other' && formData.memberID !== '') {
                    formDataToSend.append('memberID', formData.memberID);
                    console.log('✅ Sending memberID:', formData.memberID);
                } else {
                    console.log('⚠️ No memberID to send (user typed manually)');
                }

                // เพิ่มไฟล์ทั้งหมด
                requiredFiles.forEach(fieldName => {
                    const input = document.getElementById(fieldName);
                    if (input.files[0]) {
                        formDataToSend.append(fieldName, input.files[0]);
                    }
                });

                // Debug: แสดงข้อมูลที่จะส่ง
                console.log('📤 FormData contents:');
                for (let pair of formDataToSend.entries()) {
                    if (pair[1] instanceof File) {
                        console.log(pair[0], ':', pair[1].name);
                    } else {
                        console.log(pair[0], ':', pair[1]);
                    }
                }

                // ส่งข้อมูล (ไม่ต้องใส่ Content-Type เพราะ FormData จะจัดการให้เอง)
                const response = await fetch('/user/funeral/request/submit', {
                    method: 'POST',
                    body: formDataToSend
                });

                const result = await response.json();

                if (result.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'ยื่นเรื่องสำเร็จ!',
                        text: result.message,
                        confirmButtonText: 'ดูประวัติคำขอ',
                        confirmButtonColor: '#3b82f6'
                    });
                    window.location.href = '/user/profile';
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถส่งคำขอได้',
                    confirmButtonColor: '#ef4444'
                });
            }
        }

        function updateStepIndicator(step) {
            for (let i = 1; i <= 3; i++) {
                const icon = document.getElementById('step' + i + 'Icon');
                icon.className = 'step-indicator w-12 h-12 rounded-full bg-gray-300 flex items-center justify-center text-white font-bold mb-2';
            }
            document.getElementById('line1').className = 'flex-1 h-1 bg-gray-300 mx-2';
            document.getElementById('line2').className = 'flex-1 h-1 bg-gray-300 mx-2';

            for (let i = 1; i <= step; i++) {
                const icon = document.getElementById('step' + i + 'Icon');
                if (i < step) {
                    icon.className = 'step-indicator completed w-12 h-12 rounded-full flex items-center justify-center text-white font-bold mb-2';
                    icon.innerHTML = '<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
                } else {
                    icon.className = 'step-indicator active w-12 h-12 rounded-full flex items-center justify-center text-white font-bold mb-2';
                    icon.innerHTML = i;
                }
            }

            if (step >= 2) document.getElementById('line1').className = 'flex-1 h-1 bg-green-600 mx-2';
            if (step >= 3) document.getElementById('line2').className = 'flex-1 h-1 bg-green-600 mx-2';
        }
    </script>

    <%- include('../partials/userPartials/footer.ejs') %>
</body>
</html>