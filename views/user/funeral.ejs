        // ฟังก์ชันฟอร์แมตเลขบัตรประชาชนไทย
        function formatThaiID(value) {
            // เอาเฉพาะตัวเลข
            let numbers = value.replace(/\D/g, '').slice(0, 13);

            // ใส่ขีดตามตำแหน่ง 1-4-5-2-1
            let formatted = '';
            if(numbers.length > 0) formatted += numbers.substr(0,1);
            if(numbers.length > 1) formatted += '-' + numbers.substr(1,4);
            if(numbers.length > 5) formatted += '-' + numbers.substr(5,5);
            if(numbers.length > 10) formatted += '-' + numbers.substr(10,2);
            if(numbers.length > 12) formatted += '-' + numbers.substr(12,1);

            return formatted;
        }

        // ตั้งค่าฟอร์แมตเลขบัตรประชาชน
        function setupIDCardFormatter() {
            const idInput = document.getElementById('idCard');
            const idError = document.getElementById('idCardError');

            // ฟอร์แมตแบบ real-time
            idInput.addEventListener('input', (e) => {
                e.target.value = formatThaiID(e.target.value);
                // ซ่อน error message เมื่อกรอกใหม่
                if (idError && !idError.classList.contains('hidden')) {
                    idError.classList.add('hidden');
                    idInput.classList.remove('border-red-500', 'focus:ring-red-300');
                }
            });
        }

        async function checkEligibility() {
            try {
                const response = await fetch('/user/funeral/my-eligibility');
                const result = await response.json();

                document.getElementById('eligibilityLoading').style.display = 'none';
                document.getElementById('eligibilityResult').classList.remove('hidden');
                document.getElementById('eligibilityActions').style.display = 'flex';

                if (result.success) {
                    eligibilityData = result.data;
                    displayEligibilityResult(result.data);
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: error.message || 'ไม่สามารถตรวจสอบคุณสมบัติได้'
                });
            }
        }

