        function proceedToConfirmation() {
            const form = document.getElementById('funeralRequestForm');
            const idInput = document.getElementById('idCard');
            const idError = document.getElementById('idCardError');

            // ✅ ตรวจสอบการเลือกซ้ำก่อน
            if (!validateDuplicateSelection()) {
                Swal.fire({
                    icon: 'error',
                    title: 'กรุณาตรวจสอบข้อมูล',
                    text: 'ผู้รับผิดชอบและผู้เสียชีวิตต้องไม่เป็นบุคคลเดียวกัน',
                    confirmButtonColor: '#ef4444'
                });
                return;
            }
            
            // ตรวจสอบเลขบัตรประชาชน
            const numbersOnly = idInput.value.replace(/\D/g, '');
            if(numbersOnly.length !== 13) {
                idError.classList.remove('hidden');
                idInput.classList.add('border-red-500', 'focus:ring-red-300');
                idInput.focus();
                Swal.fire({
                    icon: 'error',
                    title: 'เลขบัตรประชาชนไม่ถูกต้อง',
                    text: 'กรุณากรอกเลขบัตรประชาชนให้ครบ 13 หลัก',
                    confirmButtonColor: '#ef4444'
                });
                return;
            }

            // ตรวจสอบว่ากรอกข้อมูลครบหรือไม่
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // ตรวจสอบว่ามีการอัปโหลดไฟล์ครบทุกไฟล์
            const requiredFiles = [
                'deathCertificate',
                'deceasedIdCard',
                'deceasedHouseRegistration',
                'applicantIdCard',
                'applicantHouseRegistration'
            ];

            const missingFiles = [];
            requiredFiles.forEach(id => {
                const input = document.getElementById(id);
                if (!input.files || input.files.length === 0) {
                    missingFiles.push(id);
                }
            });

            if (missingFiles.length > 0) {
                const fileLabels = {
                    deathCertificate: 'สำเนาใบมรณะบัตร',
                    deceasedIdCard: 'สำเนาบัตรประชาชนผู้ตาย',
                    deceasedHouseRegistration: 'สำเนาทะเบียนบ้านผู้ตาย',
                    applicantIdCard: 'สำเนาบัตรประชาชนผู้ยื่นคำขอ',
                    applicantHouseRegistration: 'สำเนาทะเบียนบ้านผู้ยื่นคำขอ'
                };
                
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาอัปโหลดเอกสารให้ครบ',
                    html: `<p>ยังขาดเอกสาร:</p><ul class="text-left list-disc list-inside mt-2">${missingFiles.map(id => `<li>${fileLabels[id]}</li>`).join('')}</ul>`,
                    confirmButtonColor: '#f59e0b'
                });
                return;
            }

            // ✅ เพิ่มการเก็บ memberID
            const memberSelect = document.getElementById('memberSelect');
            const selectedMemberID = memberSelect.value;
            
            console.log('🔍 Selected memberID from dropdown:', selectedMemberID);

            formData = {
                responsiblePersonName: form.responsiblePersonName.value,
                relationship: form.relationship.value,
                deceasedName: form.deceasedName.value,
                deceasedAge: form.deceasedAge.value,
                idCard: numbersOnly,
                phone: form.phone.value,
                dateOfDeath: form.dateOfDeath.value,
                causeOfDeath: form.causeOfDeath.value,
                deceasedAddress: form.deceasedAddress.value,
                deceasedVillage: form.deceasedVillage.value,
                subDistrict: form.subDistrict.value,
                district: form.district.value,
                province: form.province.value,
                postalCode: form.postalCode.value,
                notes: form.notes.value,
                memberID: selectedMemberID !== 'other' && selectedMemberID !== '' ? selectedMemberID : null,  // ✅ เพิ่มบรรทัดนี้!
                files: {}
            };

            console.log('✅ formData.memberID:', formData.memberID);

            // เก็บข้อมูลไฟล์ (ชื่อและขนาด) สำหรับแสดงในหน้ายืนยัน
            requiredFiles.forEach(fieldName => {
                const input = document.getElementById(fieldName);
                if (input.files[0]) {
                    formData.files[fieldName] = {
                        name: input.files[0].name,
                        size: (input.files[0].size / 1024 / 1024).toFixed(2),
                        type: input.files[0].type
                    };
                }
            });

            displayConfirmation();
            updateStepIndicator(3);
            document.getElementById('stepForm').classList.remove('active');
            document.getElementById('stepConfirmation').classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

