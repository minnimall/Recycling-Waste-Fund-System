        <!-- Step 3: ยืนยันและส่ง -->
        <div class="form-section" id="stepConfirmation">
            <div class="bg-white rounded-2xl shadow-xl p-8">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">ตรวจสอบข้อมูลและยืนยัน</h2>
                    <p class="text-gray-600">กรุณาตรวจสอบความถูกต้องของข้อมูลก่อนยืนยัน</p>
                </div>

                <div id="confirmationContent" class="space-y-6">
                </div>

                <div class="mt-8 flex justify-between">
                    <button type="button" onclick="goBackToForm()" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition-colors">
                        <svg class="inline w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        แก้ไขข้อมูล
                    </button>
                    <button type="button" onclick="submitRequest()" class="px-8 py-3 bg-green-700 text-white rounded-lg font-semibold hover:shadow-lg transform hover:scale-100 transition-all">
                        ยืนยันและส่งคำขอ
                    </button>
