    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let eligibilityData = null;
        let formData = {};
        // เพิ่มตัวแปรเก็บข้อมูลสมาชิก
        let familyMembers = [];

        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');

            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ!',
                    text: successMessage,
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#28a745',
                    timer: 3000
                });
            }

            if (errorMessage) {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด!',
                    text: errorMessage,
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#d33',
                    timer: 3000
                });
            }

            checkEligibility();
            
            // ตั้งค่าที่อยู่เดิมเมื่อโหลดหน้า
            fillExistingAddress();

            // ตั้งค่าฟอร์แมตเลขบัตรประชาชน
            setupIDCardFormatter();

            // โหลดรายชื่อสมาชิก
            loadFamilyMembers();
            
            // ตั้งค่าที่อยู่เดิมเมื่อโหลดหน้า
            fillExistingAddress();

            // ตั้งค่าฟอร์แมตเลขบัตรประชาชน
            setupIDCardFormatter();

            setupFilePreview(); // เพิ่มบรรทัดนี้
        });

        // ฟังก์ชัน Setup Drag & Drop และ Preview
        function setupFilePreview() {
            const fileInputs = [
                'deathCertificate',
                'deceasedIdCard',
                'deceasedHouseRegistration',
                'applicantIdCard',
                'applicantHouseRegistration'
            ];

            fileInputs.forEach(inputId => {
                const input = document.getElementById(inputId);
                const preview = document.getElementById(inputId + 'Preview');
                const label = input.nextElementSibling;

                // Drag & Drop Events
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    label.addEventListener(eventName, preventDefaults, false);
                });

                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                ['dragenter', 'dragover'].forEach(eventName => {
                    label.addEventListener(eventName, () => {
                        label.classList.add('dragover');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    label.addEventListener(eventName, () => {
                        label.classList.remove('dragover');
                    });
                });

                // Handle Drop
                label.addEventListener('drop', function(e) {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    
                    if (files.length > 0) {
                        input.files = files;
                        handleFileSelect(input, preview);
                    }
                });

                // Handle File Select
                input.addEventListener('change', function(e) {
                    handleFileSelect(input, preview);
                });
            });
        }

        function handleFileSelect(input, preview) {
            const file = input.files[0];
            const label = input.nextElementSibling;
            
            if (file) {
                const fileSize = (file.size / 1024 / 1024).toFixed(2); // MB
                const fileType = file.type;

                // ตรวจสอบขนาดไฟล์
                if (file.size > 10 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไฟล์ใหญ่เกินไป',
                        text: 'ไฟล์มีขนาดใหญ่เกิน 10MB กรุณาเลือกไฟล์ใหม่',
                        confirmButtonColor: '#ef4444'
                    });
                    input.value = '';
                    preview.innerHTML = '';
                    input.classList.remove('has-file');
                    return;
                }

                // เพิ่ม class has-file
                input.classList.add('has-file');

                // อัปเดตข้อความใน label
                const textSpan = label.querySelector('.file-upload-text');
                const subtextSpan = label.querySelector('.file-upload-subtext');
                textSpan.textContent = '✓ เลือกไฟล์แล้ว';
                subtextSpan.textContent = file.name;

                // แสดง Preview
                if (fileType.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.innerHTML = `
                            <div class="flex items-center space-x-2 p-2 bg-green-50 border border-green-200 rounded-lg">
                                <img src="${e.target.result}" class="w-16 h-16 object-cover rounded">
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-green-800">${file.name}</p>
                                    <p class="text-xs text-green-600">${fileSize} MB</p>
                                </div>
                                <button type="button" onclick="removeFile('${input.id}')" class="text-red-600 hover:text-red-800">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        `;
                    };
                    reader.readAsDataURL(file);
                } else if (fileType === 'application/pdf') {
                    preview.innerHTML = `
                        <div class="flex items-center space-x-2 p-2 bg-blue-50 border border-blue-200 rounded-lg">
                            <svg class="w-12 h-12 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-blue-800">${file.name}</p>
                                <p class="text-xs text-blue-600">${fileSize} MB</p>
                            </div>
                            <button type="button" onclick="removeFile('${input.id}')" class="text-red-600 hover:text-red-800">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    `;
                }
            }
        }

        // ฟังก์ชันลบไฟล์
        function removeFile(inputId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(inputId + 'Preview');
            const label = input.nextElementSibling;
            const textSpan = label.querySelector('.file-upload-text');
            const subtextSpan = label.querySelector('.file-upload-subtext');

            input.value = '';
            input.classList.remove('has-file');
            preview.innerHTML = '';
            textSpan.textContent = 'คลิกเพื่อเลือกไฟล์';
            subtextSpan.textContent = 'หรือลากไฟล์มาวางที่นี่';
        }

        // ฟังก์ชันโหลดรายชื่อสมาชิก
        async function loadFamilyMembers() {
            try {
                const response = await fetch('/user/funeral/family-members');
                const result = await response.json();

                if (result.success) {
                    familyMembers = result.data;
                    populateMemberSelect();
                } else {
                    console.error('Error loading members:', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        // ฟังก์ชันเติมข้อมูลใน dropdown
        function populateMemberSelect() {
            const deceasedSelect = document.getElementById('memberSelect');
            const responsibleSelect = document.getElementById('responsiblePersonSelect');
            
            console.log('🔧 populateMemberSelect called');
            console.log('deceasedSelect:', deceasedSelect);
            console.log('responsibleSelect:', responsibleSelect);
            
            // Clear existing options
            deceasedSelect.innerHTML = '<option value="">-- เลือกสมาชิกที่เสียชีวิต --</option>';
            responsibleSelect.innerHTML = '<option value="">-- เลือกผู้รับผิดชอบ --</option>';
            
            // เพิ่มตัวเลือกสมาชิก
            familyMembers.forEach(member => {
                // Dropdown ผู้เสียชีวิต
                const deceasedOption = document.createElement('option');
                deceasedOption.value = member._id;
                deceasedOption.textContent = member.name;
                deceasedOption.dataset.memberData = JSON.stringify(member);
                deceasedOption.dataset.memberId = member._id;
                deceasedSelect.appendChild(deceasedOption);

                // Dropdown ผู้รับผิดชอบ
                const responsibleOption = document.createElement('option');
                responsibleOption.value = member._id;
                responsibleOption.textContent = member.name;
                responsibleOption.dataset.memberData = JSON.stringify(member);
                responsibleOption.dataset.memberId = member._id;
                responsibleSelect.appendChild(responsibleOption);
            });

            // เพิ่มตัวเลือก "อื่นๆ - กรอกเอง"
            const deceasedOtherOption = document.createElement('option');
            deceasedOtherOption.value = 'other';
            deceasedOtherOption.textContent = '-- อื่นๆ (กรอกข้อมูลเอง) --';
            deceasedOtherOption.dataset.memberId = 'other';
            deceasedSelect.appendChild(deceasedOtherOption);

            const responsibleOtherOption = document.createElement('option');
            responsibleOtherOption.value = 'other';
            responsibleOtherOption.textContent = '-- อื่นๆ (กรอกข้อมูลเอง) --';
            responsibleOtherOption.dataset.memberId = 'other';
            responsibleSelect.appendChild(responsibleOtherOption);

            console.log('✅ Options created, attaching event listeners...');

            // ✅ Event listener สำหรับเมื่อเลือกผู้เสียชีวิต
            deceasedSelect.addEventListener('change', function() {
                console.log('💀 Deceased select changed');
                
                const selectedOption = this.options[this.selectedIndex];
                const selectedId = selectedOption?.dataset?.memberId;
                console.log('Selected deceased ID:', selectedId);
                
                // เติมข้อมูล
                handleMemberSelection(this);
                
                // ตรวจสอบการเลือกซ้ำ
                const responsibleOption = responsibleSelect.options[responsibleSelect.selectedIndex];
                const responsibleId = responsibleOption?.dataset?.memberId;
                console.log('Responsible ID:', responsibleId);
                
                if (selectedId && responsibleId && 
                    selectedId !== 'other' && 
                    selectedId !== '' &&
                    responsibleId !== 'other' && 
                    responsibleId !== '' &&
                    selectedId === responsibleId) {
                    
                    console.log('⚠️ DUPLICATE DETECTED!');
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'ไม่สามารถเลือกได้',
                        text: 'ผู้รับผิดชอบและผู้เสียชีวิตต้องไม่เป็นคนเดียวกัน',
                        confirmButtonText: 'ตกลง',
                    });
                    
                    // ล้างค่าผู้เสียชีวิต
                    this.value = '';
                    clearDeceasedFields();
                }
            });

            // ✅ Event listener สำหรับเมื่อเลือกผู้รับผิดชอบ
            responsibleSelect.addEventListener('change', function() {
                console.log('👤 Responsible select changed');
                
                const selectedOption = this.options[this.selectedIndex];
                const selectedId = selectedOption?.dataset?.memberId;
                console.log('Selected responsible ID:', selectedId);
                
                // เติมข้อมูล
                handleResponsibleSelection(this);
                
                // ตรวจสอบการเลือกซ้ำ
                const deceasedOption = deceasedSelect.options[deceasedSelect.selectedIndex];
                const deceasedId = deceasedOption?.dataset?.memberId;
                console.log('Deceased ID:', deceasedId);
                
                if (selectedId && deceasedId && 
                    selectedId !== 'other' && 
                    selectedId !== '' &&
                    deceasedId !== 'other' && 
                    deceasedId !== '' &&
                    selectedId === deceasedId) {
                    
                    console.log('⚠️ DUPLICATE DETECTED!');
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'ไม่สามารถเลือกได้',
                        text: 'ผู้รับผิดชอบและผู้เสียชีวิตต้องไม่เป็นคนเดียวกัน',
                        confirmButtonText: 'ตกลง',
                    });
                    
                    // ล้างค่าผู้รับผิดชอบ
                    this.value = '';
                    clearResponsibleFields();
                }
            });
            
            console.log('✅ Event listeners attached!');
        }

        // ฟังก์ชันล้างค่าฟิลด์ผู้เสียชีวิต
        function clearDeceasedFields() {
            const nameInput = document.getElementById('deceasedName');
            const ageInput = document.getElementById('deceasedAge');
            const idCardInput = document.getElementById('idCard');
            const phoneInput = document.getElementById('phone');
            
            if (nameInput) {
                nameInput.value = '';
                nameInput.readOnly = false;
                nameInput.classList.remove('bg-gray-100');
            }
            
            if (ageInput) {
                ageInput.value = '';
                ageInput.readOnly = false;
                ageInput.classList.remove('bg-gray-100');
            }
            
            if (idCardInput) {
                idCardInput.value = '';
                idCardInput.readOnly = false;
                idCardInput.classList.remove('bg-gray-100');
            }
            
            if (phoneInput) {
                phoneInput.value = '';
                phoneInput.readOnly = false;
                phoneInput.classList.remove('bg-gray-100');
            }
        }

        // ฟังก์ชันล้างค่าฟิลด์ผู้รับผิดชอบ
        function clearResponsibleFields() {
            const nameInput = document.getElementById('responsiblePersonName');
            const relationshipSelect = document.getElementById('relationship');
            
            if (nameInput) {
                nameInput.value = '';
                nameInput.readOnly = false;
                nameInput.classList.remove('bg-gray-100');
            }
            
            if (relationshipSelect) {
                relationshipSelect.value = '';
                relationshipSelect.disabled = false;
            }
        }


        // ฟังก์ชันจัดการเมื่อเลือกผู้รับผิดชอบ
        function handleResponsibleSelection(select) {
            const selectedValue = select.value;
            const nameInput = document.getElementById('responsiblePersonName');
            const relationshipSelect = document.getElementById('relationship');

            // ตรวจสอบว่า elements ทั้งหมดมีอยู่จริง
            if (!nameInput || !relationshipSelect) {
                console.error('❌ Some input elements are missing!');
                return;
            }

            if (selectedValue === '' || selectedValue === 'other') {
                clearResponsibleFields();
            } else {
                // เติมข้อมูลอัตโนมัติ
                const selectedOption = select.options[select.selectedIndex];
                const memberData = JSON.parse(selectedOption.dataset.memberData);

                nameInput.value = memberData.name || '';
                nameInput.readOnly = true;
                nameInput.classList.add('bg-gray-100');

                if (memberData.type === 'beneficiary' && memberData.relation) {
                    // แทนที่จะ disable ให้เติมค่าแต่ยังคงเปิดให้แก้ไขได้
                    const relationOptions = Array.from(relationshipSelect.options);
                    const matchingOption = relationOptions.find(opt => 
                        opt.value.toLowerCase().includes(memberData.relation.toLowerCase()) ||
                        memberData.relation.toLowerCase().includes(opt.value.toLowerCase())
                    );
                    
                    if (matchingOption) {
                        relationshipSelect.value = matchingOption.value;
                        relationshipSelect.disabled = false; // ← เปลี่ยนเป็น false
                    } else {
                        relationshipSelect.value = '';
                        relationshipSelect.disabled = false;
                    }
                } else {
                    relationshipSelect.value = '';
                    relationshipSelect.disabled = false;
                }
            }
        }

        // เพิ่มฟังก์ชันตรวจสอบการเลือกซ้ำ (ใช้ใน proceedToConfirmation)
        function validateDuplicateSelection() {
            const deceasedSelect = document.getElementById('memberSelect');
            const responsibleSelect = document.getElementById('responsiblePersonSelect');
            
            const deceasedOption = deceasedSelect.options[deceasedSelect.selectedIndex];
            const responsibleOption = responsibleSelect.options[responsibleSelect.selectedIndex];
            
            const deceasedId = deceasedOption?.dataset?.memberId;
            const responsibleId = responsibleOption?.dataset?.memberId;
            
            console.log('Validating:', { deceasedId, responsibleId });
            
            if (deceasedId && responsibleId && 
                deceasedId !== 'other' && 
                deceasedId !== '' &&
                responsibleId !== 'other' && 
                responsibleId !== '' &&
                deceasedId === responsibleId) {
                return false;
            }
            
            return true;
        }
        // ฟังก์ชันจัดการเมื่อเลือกสมาชิก
        function handleMemberSelection(select) {
            const selectedValue = select.value;
            const nameInput = document.getElementById('deceasedName');
            const ageInput = document.getElementById('deceasedAge');
            const idCardInput = document.getElementById('idCard');
            const phoneInput = document.getElementById('phone');

            if (!nameInput || !ageInput || !idCardInput || !phoneInput) return;

            if (selectedValue === '' || selectedValue === 'other') {
                clearDeceasedFields();
            } else {
                const selectedOption = select.options[select.selectedIndex];
                const memberData = JSON.parse(selectedOption.dataset.memberData);

                nameInput.value = memberData.name || '';
                nameInput.readOnly = true;
                nameInput.classList.add('bg-gray-100');

                // เปลี่ยนจาก type === 'beneficiary' → type === 'household'
                if (memberData.type === 'household') {
                    ageInput.value = memberData.age || '';
                    ageInput.readOnly = false;
                    ageInput.classList.remove('bg-gray-100');
                    
                    idCardInput.value = memberData.idCardNumber ? formatThaiID(memberData.idCardNumber) : '';
                    idCardInput.readOnly = false;
                    idCardInput.classList.remove('bg-gray-100');
                    
                    phoneInput.value = memberData.phone || '';
                    phoneInput.readOnly = false;
                    phoneInput.classList.remove('bg-gray-100');
                } else {
                    // type === 'main'
                    ageInput.value = memberData.age || '';
                    idCardInput.value = formatThaiID(memberData.idCardNumber || '');
                    phoneInput.value = memberData.phone || '';

                    ageInput.readOnly = !!memberData.age;
                    ageInput.classList.toggle('bg-gray-100', !!memberData.age);

                    idCardInput.readOnly = !!memberData.idCardNumber;
                    idCardInput.classList.toggle('bg-gray-100', !!memberData.idCardNumber);

                    phoneInput.readOnly = !!memberData.phone;
                    phoneInput.classList.toggle('bg-gray-100', !!memberData.phone);
                }
            }
        }

        function selectAddressOption(option) {
            const existingOption = document.getElementById('useExistingAddress');
            const newOption = document.getElementById('useNewAddress');
            const existingRadio = document.querySelector('input[name="addressOption"][value="existing"]');
            const newRadio = document.querySelector('input[name="addressOption"][value="new"]');

            if (option === 'existing') {
                existingOption.classList.add('selected');
                newOption.classList.remove('selected');
                existingRadio.checked = true;
                fillExistingAddress();
            } else {
                newOption.classList.add('selected');
                existingOption.classList.remove('selected');
                newRadio.checked = true;
                clearAddressFields();
            }
        }

        function fillExistingAddress() {
            const form = document.getElementById('funeralRequestForm');
            if (familyAddress.houseNumber) {
                form.deceasedAddress.value = familyAddress.houseNumber;
                form.deceasedVillage.value = familyAddress.moo;
                form.subDistrict.value = familyAddress.subdistrict;
                form.district.value = familyAddress.district;
                form.province.value = familyAddress.province;
                form.postalCode.value = familyAddress.postalCode;
            }
