</head>
<body>
    <%- include('../partials/userPartials/header.ejs') %>
    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">สื่อความรู้การจัดการขยะ</h2>
            <p class="text-xl opacity-90 mb-8">เรียนรู้วิธีการจัดการขยะอย่างถูกต้องและเป็นมิตรต่อสิ่งแวดล้อม</p>
                <div class="flex flex-wrap justify-center gap-4">
                    <div class="bg-white/20 px-4 py-2 rounded-full">
                        <i class="fas fa-recycle mr-2"></i>รีไซเคิล
                    </div>
                    <div class="bg-white/20 px-4 py-2 rounded-full">
                        <i class="fas fa-leaf mr-2"></i>ลดขยะ
                    </div>
                    <div class="bg-white/20 px-4 py-2 rounded-full">
                        <i class="fas fa-seedling mr-2"></i>นำกลับมาใช้
                    </div>
                </div>
        </div>
    </section>
    
    <!-- Content Categories -->
    <section class="py-12">
        <div class="container mx-auto px-4">
            <!-- Category Filter -->
            <div class="flex flex-wrap justify-center gap-4 mb-12">
                <button class="category-btn active bg-primary-green text-white px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors" data-category="all">
                    <i class="fas fa-th-large mr-2"></i>ทั้งหมด
                </button>
                <button class="category-btn bg-white text-gray-700 px-6 py-3 rounded-lg border hover:bg-gray-50 transition-colors" data-category="videos">
                    <i class="fas fa-play-circle mr-2"></i>วิดีโอ
                </button>
                <button class="category-btn bg-white text-gray-700 px-6 py-3 rounded-lg border hover:bg-gray-50 transition-colors" data-category="infographics">
                    <i class="fas fa-image mr-2"></i>อินโฟกราฟิก
                </button>
                <button class="category-btn bg-white text-gray-700 px-6 py-3 rounded-lg border hover:bg-gray-50 transition-colors" data-category="articles">
                    <i class="fas fa-newspaper mr-2"></i>บทความ
                </button>
                <button class="category-btn bg-white text-gray-700 px-6 py-3 rounded-lg border hover:bg-gray-50 transition-colors" data-category="guides">
                    <i class="fas fa-book mr-2"></i>คู่มือ
                </button>
            </div>

            <!-- Content Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Video Content -->
                    <% if (media && media.length > 0) { %>
                        <% media.forEach(amedia => { %>
                <div class="content-item bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow" data-category="videos">
                    <div class="relative">
                        <!-- <img src="/placeholder.svg?height=200&width=400" alt="วิดีโอการแยกขยะ" class="w-full h-48 object-cover"> -->
                        <% if (amedia.youtubeUrl && amedia.youtubeUrl.includes('v=')) { %>
                            <iframe class="d-block w-full h-48 card-img-custom" 
                                src="<%= 'https://www.youtube.com/embed/' + amedia.youtubeUrl.split('v=')[1].split('&')[0] %>" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen>
                            </iframe>
                        <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center">
                            <button class="play-btn bg-white rounded-full w-16 h-16 flex items-center justify-center hover:scale-110 transition-transform"
                            onclick="setFrame('<%= amedia.title %>','<%= 'https://www.youtube.com/embed/' + amedia.youtubeUrl.split('v=')[1].split('&')[0] %>')"
                            >
                                <i class="fas fa-play text-primary text-xl ml-1"></i>
                            </button>
                        </div>
                            <% } else { %>
                                <p>No video available</p>
                        <% } %>
                        <div class="absolute top-4 left-4">
                            <span class="bg-red-500 text-white px-2 py-1 rounded text-sm">วิดีโอ</span>
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2"><%= amedia.title %></h3>
                        <p class="text-gray-600 mb-4">เรียนรู้วิธีการแยกขยะอย่างถูกต้องเพื่อให้ง่ายต่อการรีไซเคิล</p>
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-500">
                                <i class="fas fa-clock mr-1"></i>5 นาที
                            </span>
                            <span class="text-sm text-gray-500">
                                <i class="fas fa-eye mr-1"></i>1,234 ครั้ง
                            </span>
                        </div>
                    </div>
                </div>
                        <% }); %>
                    <% } else { %>
                        <p>ไม่มีสื่อความรู้ที่พร้อมแสดง</p>
                    <% } %>
            <!-- Load More Button -->
            <% if (media && media.length > 3) { %>
            <div class="text-center mt-12">
                <button class="bg-primary text-white px-8 py-3 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-plus mr-2"></i>โหลดเพิ่มเติม
                </button>
            </div>
            
            <% } %>
        </div>
    </section>

    <!-- Video Modal -->
    <div id="video-modal" class="fixed inset-0 bg-black bg-opacity-75 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-lg max-w-4xl w-full overflow-hidden">
                <div class="flex justify-between items-center p-4 border-b">
                    <h3 class="text-lg font-semibold" id="video-title">วิดีโอการจัดการขยะ</h3>
                    <button id="close-video-modal" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <div class="aspect-video bg-gray-900 flex items-center justify-center">
                    <!-- <div class="text-white text-center">
                        <i class="fas fa-play-circle text-6xl mb-4"></i>
                        <p>วิดีโอจะแสดงที่นี่</p>
                    </div> -->
                    <iframe class="d-block w-full h-full card-img-custom"
                        id="iframe" 
                        src="https://www.youtube.com/watch?v=5HI55e0oL_M" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                    </iframe>
                </div>
            </div>
        </div>
    </div>
    <!-- Featured Section -->
    <section class="bg-white py-16">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">เนื้อหาแนะนำ</h2>
                <p class="text-gray-600">เนื้อหาที่ได้รับความนิยมและมีประโยชน์สูง</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Featured Article -->
                <div class="bg-gradient-to-r from-primary-green to-secondary-green rounded-lg p-8 text-white">
                    <div class="flex items-center mb-4">
                        <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
                            <i class="fas fa-star text-yellow-300 text-xl"></i>
                        </div>
                        <div>
                            <span class="text-sm opacity-90">เนื้อหาแนะนำ</span>
                            <h3 class="text-xl font-semibold">Zero Waste Lifestyle</h3>
                        </div>
                    </div>
                    <p class="mb-6 opacity-90">เรียนรู้วิธีการใช้ชีวิตแบบไม่มีขยะ เริ่มต้นง่ายๆ จากในบ้านของคุณ</p>
                    <button class="bg-white text-primary-green px-6 py-2 rounded-lg hover:bg-gray-100 transition-colors">
                        อ่านต่อ <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>

                <!-- Statistics -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-green-50 rounded-lg p-6 text-center">
                        <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-recycle text-white text-xl"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-green-700">85%</h4>
                        <p class="text-green-600 text-sm">ขยะที่รีไซเคิลได้</p>
                    </div>
                    
                    <div class="bg-blue-50 rounded-lg p-6 text-center">
                        <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-leaf text-white text-xl"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-blue-700">60%</h4>
                        <p class="text-blue-600 text-sm">การลดขยะได้</p>
                    </div>
                    
                    <div class="bg-purple-50 rounded-lg p-6 text-center">
                        <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-users text-white text-xl"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-purple-700">1,250</h4>
                        <p class="text-purple-600 text-sm">ครอบครัวที่เข้าร่วม</p>
                    </div>
                    
                    <div class="bg-orange-50 rounded-lg p-6 text-center">
                        <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-seedling text-white text-xl"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-orange-700">2.5</h4>
                        <p class="text-orange-600 text-sm">ตัน CO₂ ที่ลดได้</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/userPartials/footer.ejs') %>

</body>
    <script>
        
        // Category filter functionality
        const categoryBtns = document.querySelectorAll('.category-btn');
        const contentItems = document.querySelectorAll('.content-item');

        categoryBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const category = btn.dataset.category;
                
                // Update active button
                categoryBtns.forEach(b => {
                    b.classList.remove('bg-primary-green', 'text-white');
                    b.classList.add('bg-white', 'text-gray-700', 'border');
                });
                btn.classList.remove('bg-white', 'text-gray-700', 'border');
                btn.classList.add('bg-primary-green', 'text-white');
                
                // Filter content
                contentItems.forEach(item => {
                    if (category === 'all' || item.dataset.category === category) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Video modal functionality
        const playBtns = document.querySelectorAll('.play-btn');
        const videoModal = document.getElementById('video-modal');
        const closeVideoModal = document.getElementById('close-video-modal');

        playBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                videoModal.classList.remove('hidden');
            });
        });

        function setFrame(videoTitle, url) {
                const titleElement = document.getElementById('video-title');
                const iframeElement = document.getElementById('iframe');
                const modal = document.getElementById('video-modal');

                titleElement.innerHTML = videoTitle;
                iframeElement.src = url;
                modal.classList.remove('hidden'); // แสดง modal
        }
        document.getElementById('close-video-modal').addEventListener('click', function () {
            const modal = document.getElementById('video-modal');
            const iframe = document.getElementById('iframe');
            modal.classList.add('hidden');
            iframe.src = ''; // หยุดวิดีโอเมื่อปิด
        });

        videoModal.addEventListener('click', (e) => {
            if (e.target === videoModal) {
                videoModal.classList.add('hidden');
            }
        });
    </script>
</html>
