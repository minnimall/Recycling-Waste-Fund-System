<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/style_knowledge.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="/img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li><a href="/">หน้าหลัก</a></li>
                    <li><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li class="select"><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li><a href="./after_learning.html">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <section class="mt-3">
                <div class="mt-5 title-idea d-flex justify-content-between align-items-center">
                    <p class="title">
                        <i class="fa fa-recycle icon-green"></i> สื่อความรู้การจัดการขยะ
                    </p>
                </div>
                <!-- <div class="mt-5 title-idea d-flex justify-content-center align-items-center">
                    <p class="title2">
                        <i class="fa fa-recycle icon-green"></i> สื่อความรู้การจัดการขยะ
                    </p>
                </div> -->

                <div class="row">
                    <% if (media && media.length > 0) { %>
                        <% media.forEach(amedia => { %>
                            <div class="col-3 mt-3">
                                <div class="card ">
                                    <% if (amedia.youtubeUrl && amedia.youtubeUrl.includes('v=')) { %>
                                    <iframe class="d-block w-100 card-img-custom" 
                                        src="<%= 'https://www.youtube.com/embed/' + amedia.youtubeUrl.split('v=')[1].split('&')[0] %>" 
                                        frameborder="0" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen>
                                    </iframe>
                                    <% } else { %>
                                        <p>No video available</p>
                                    <% } %>
                                    <div class="card-body">
                                        <!-- แสดงชื่อคลิป -->
                                        <p class="card-title"><%= amedia.title %></p>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p>ไม่มีสื่อความรู้ที่พร้อมแสดง</p>
                    <% } %>
                </div>
            </section>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>

</body>
</html>
