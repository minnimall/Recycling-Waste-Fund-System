<!DOCTYPE html>
<html lang="th">

<head>

  <%- include('../partials/userPartials/head.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      // เช็คข้อความที่ส่งมาจาก URL
      const urlParams = new URLSearchParams(window.location.search);
      const successMessage = urlParams.get('message');
      const errorMessage = urlParams.get('error');

      if (successMessage) {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: successMessage,
          showConfirmButton: false,
          timer: 3000
        });
      }

      if (errorMessage) {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'error',
          title: errorMessage,
          showConfirmButton: false,
          timer: 3000
        });
      }

    </script>
</head>

<body class="bg-gray-50">
  <%- include('../partials/userPartials/header.ejs') %>
    <!-- Page Header -->
    <section class="bg-primary-green text-white py-16">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold mb-4">ไอเดียการจัดการขยะ</h1>
        <p class="text-xl opacity-90">แบ่งปันไอเดียและเรียนรู้วิธีการจัดการขยะจากชุมชน</p>
      </div>
    </section>

    <!-- Modal Post -->
    <div id="ideaModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
      <div class="bg-white w-full max-w-2xl mx-4 rounded-lg shadow-lg p-6 relative">
        <!-- ปุ่มปิด -->
        <button id="closeModalBtn"
          class="absolute top-3 right-4 text-gray-600 hover:text-red-600 text-xl">&times;</button>

        <% if (locals.session && locals.session.username) { %>
          <h2 class="text-xl font-semibold text-primary-green mb-4">แบ่งปันไอเดียของคุณ</h2>
          <form id="create-post-form" class="space-y-4" action="/user/ideas/create" method="POST"
            enctype="multipart/form-data">
            <div>
              <input type="text" name="title" placeholder="หัวข้อไอเดีย..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required>
            </div>
            <div>
              <select name="category"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required>
                <option value="">เลือกหมวดหมู่</option>
                <option value="reduce">ลดการใช้</option>
                <option value="reuse">นำกลับมาใช้</option>
                <option value="recycle">รีไซเคิล</option>
                <option value="diy">DIY/ทำเอง</option>
                <option value="community">โครงการชุมชน</option>
                <option value="other">อื่นๆ</option>
              </select>
            </div>
            <div>
              <textarea name="content" rows="4" placeholder="เล่าไอเดียของคุณ..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required></textarea>
            </div>
            <div>
              <div id="img-box" class="hidden w-full my-2 relative">
                <button type="button" onclick="clearImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
                <img id="image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
              </div>
              <input type="file" id="image" name="image" accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
              <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
            </div>
            <script>
              // Preview รูป
              const fileInput = document.querySelector('input[name="image"]');
              const preview = document.getElementById('image-preview');
              const box_img = document.getElementById('img-box');
              const image_input = document.getElementById('image');

              fileInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                  preview.src = URL.createObjectURL(file);
                  preview.classList.remove('hidden');
                  box_img.classList.remove('hidden');
                } else {
                  preview.src = '';
                  preview.classList.add('hidden');
                }
              });

              function clearImg() {
                preview.src = '';
                image_input.value = '';
                box_img.classList.add('hidden');
              }
            </script>

            <div class="flex justify-end">
              <button type="submit"
                class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                <i class="fas fa-paper-plane mr-2"></i>แบ่งปันไอเดีย
              </button>
            </div>
          </form>
          <% } else { %>
            <div class="text-center text-red-600 font-semibold">
              กรุณาเข้าสู่ระบบก่อนเพื่อแบ่งปันไอเดียของคุณ
            </div>
            <% } %>
      </div>
    </div>

    <!-- Edit Model -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
      <div class="bg-white p-6 rounded-lg w-full max-w-lg shadow-lg relative">
        <h2 class="text-lg font-semibold mb-4">แก้ไขโพสต์</h2>
        <form id="editPostForm">
          <input type="hidden" id="editPostId">

          <div class="mb-4">
            <label class="block mb-1 font-medium">หัวข้อ</label>
            <input type="text" id="editTitle" class="w-full border px-3 py-2 rounded" required>
          </div>
          <div class="mb-4">
            <label class="block mb-1 font-medium">หมวดหมู่</label>
            <select id="editCategory" class="w-full border px-3 py-2 rounded">
              <option value="reduce">ลดการใช้</option>
              <option value="reuse">นำกลับมาใช้</option>
              <option value="recycle">รีไซเคิล</option>
              <option value="diy">DIY/ทำเอง</option>
              <option value="community">โครงการชุมชน</option>
              <option value="other">อื่นๆ</option>
            </select>
          </div>
          <div class="mb-4">
            <label class="block mb-1 font-medium">เนื้อหา</label>
            <textarea id="editContent" rows="4" class="w-full border px-3 py-2 rounded" required></textarea>
          </div>


          <div>
            <div id="edit-img-box" class="hidden w-full my-2 relative">
              <button type="button" onclick="clearEditImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
              <img id="edit-image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
            </div>
            <input type="file" id="editImage" name="image" accept="image/*"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
            <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
          </div>

          <div class="flex justify-end space-x-3">
            <button type="button" onclick="closeEditModal()"
              class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">ยกเลิก</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">บันทึก</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Filter Section -->
    <section class="py-4 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="flex flex-wrap justify-center gap-3">
          <button
            class="idea-filter bg-primary-green text-white px-4 py-2 rounded-full hover:bg-secondary-green transition-colors"
            data-category="all">ทั้งหมด</button>
          <button
            class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
            data-category="reduce">ลดการใช้</button>
          <button
            class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
            data-category="reuse">นำกลับมาใช้</button>
          <button
            class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
            data-category="recycle">รีไซเคิล</button>
          <button
            class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
            data-category="diy">DIY/ทำเอง</button>
          <button
            class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
            data-category="community">โครงการชุมชน</button>
          <!-- ปุ่มเปิดโมดอล -->
          <button id="openModalBtn"
            class="bg-primary-green text-white px-4 py-2 rounded hover:bg-primary-dark transition">
            <i class="fas fa-plus mr-2"></i> เพิ่มไอเดียใหม่
          </button>
        </div>
      </div>
    </section>

    <!-- Posts Section -->
    <section class="py-8">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto" id="posts-container">
          <% posts.forEach(post=> { %>
            <article class="idea-post bg-white rounded-lg shadow-lg mb-6 overflow-hidden"
              data-category="<%= post.category %>" data-post-id="<%= post._id %>">
              <div class="p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mr-4">
                    <i class="fas fa-user text-white"></i>
                  </div>
                  <div class="flex-1">
                    <h3 class="font-semibold text-gray-800">
                      <%= post.authorId?.familyName || 'ไม่ระบุชื่อ' %>
                    </h3>


                    <div class="flex items-center text-sm text-gray-500">
                    <span class="post-time text-sm text-gray-500" data-time="<%= post.createdAt.toISOString() %>"></span>

                      <span class="mx-2">•</span>
                      <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">
                        <% const categoryNames={ reduce: 'ลดการใช้' , reuse: 'นำกลับมาใช้' , recycle: 'รีไซเคิล' ,
                          diy: 'DIY/ทำเอง' , community: 'โครงการชุมชน' , other: 'อื่นๆ' }; %>
                          <%= categoryNames[post.category] || post.category %>
                      </span>

                      <% if (user && post.authorId && user._id.toString()===post.authorId._id.toString()) { %>
                        <div class="relative ml-auto">
                          <button type="button"
                            class="text-gray-500 hover:text-gray-700 focus:outline-none dropdown-toggle"
                            data-dropdown-id="dropdown-<%= post._id %>">
                            <i class="fas fa-ellipsis-v"></i>
                          </button>
                          <div id="dropdown-<%= post._id %>"
                            class="absolute right-0 mt-2 w-32 bg-white border rounded shadow-md hidden z-50">
                            <button onclick="openEditModal(
                                '<%= post._id %>',
                                '<%= post.title %>',
                                '<%= post.content %>',
                                '<%= post.category %>',
                                '<%= post.imageUrl %>'
                              )" class="w-full text-left px-4 py-2 text-sm text-blue-600 hover:bg-blue-50">
                              ✏️ แก้ไข
                            </button>
                            <button data-post-id="<%= post._id %>"
                              onclick="deleteIdeas('<%= post._id %>', '<%= post.title %>')"
                              class="delete-post-btn w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">🗑️
                              ลบ</button>
                          </div>
                        </div>
                        <% } %>

                    </div>
                  </div>
                </div>
                <h2 class="text-xl font-semibold text-gray-800 mb-3">
                  <%= post.title %>
                </h2>
                <p class="text-gray-600 mb-4">
                  <%= post.content %>
                </p>

                <% if (post.imageUrl && post.imageUrl !=="no_image" ) { %>
                  <div class="mb-4">
                    <img src="<%= post.imageUrl %>" alt="รูปภาพประกอบ" class="w-full h-64 object-cover rounded-lg">
                  </div>
                  <% } else { %>

                    <% } %>

                      <div class="flex items-center justify-between border-t pt-4">
                        <div class="flex items-center space-x-6">
                          <% let liked=false; if (typeof user !=='undefined' && user && user._id) {
                            liked=post.likes.some(id=> id.toString() === user._id.toString());
                            }
                            %>
                            <button
                              class="like-btn flex items-center text-gray-500 hover:text-red-500 transition-colors"
                              data-post-id="<%= post._id %>" type="button">
                              <i
                                class="<%= liked ? 'fas' : 'far' %> fa-heart mr-2 <%= liked ? 'text-red-500' : '' %>"></i>
                              <span class="like-count">
                                <%= post.likes.length %>
                              </span>
                            </button>
                            <button
                              class="comment-btn flex items-center text-gray-500 hover:text-blue-500 transition-colors"
                              data-post-id="<%= post._id %>" type="button">
                              <i class="far fa-comment mr-2"></i>
                              <span class="comment-count">
                                <%= post.comments.length %>
                              </span>
                            </button>
                        </div>
                      </div>


                      <!-- Comments Section -->
                      <div class="comments-section mt-4 hidden" id="comments-<%= post._id %>">
                        <div class="border-t pt-4">
                          <div class="space-y-3 mb-4">
                            <% post.comments.forEach(comment=> { %>
                              <div class="flex items-start space-x-3">
                                <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                                  <i class="fas fa-user text-gray-600 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                  <div class="bg-gray-100 rounded-lg p-3">
                                    <p class="font-semibold text-sm text-gray-800">
                                      <%= comment.author.familyName || 'ไม่ระบุ' %>
                                    </p>
                                    <p class="text-gray-600 text-sm">
                                      <%= comment.content %>
                                    </p>
                                  </div>
                                  <div class="flex items-center mt-1 text-xs text-gray-500">
                                    <span class="post-time text-sm text-gray-500" data-time="<%= comment.createdAt.toISOString() %>"></span>

                                    <!-- <button class="ml-3 hover:text-blue-500">ตอบกลับ</button> -->
                                  </div>
                                </div>
                              </div>
                              <% }) %>
                          </div>

                          <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center">
                              <i class="fas fa-user text-white text-sm"></i>
                            </div>
                            <div class="flex-1">
                              <input type="text" placeholder="เขียนความคิดเห็น..."
                                class="w-full px-3 py-2 border border-gray-300 rounded-full focus:ring-2 focus:ring-primary focus:border-transparent comment-input"
                                data-post-id="<%= post._id %>">
                            </div>
                            <button
                              class="bg-primary text-white px-4 py-2 rounded-full hover:bg-primary-dark transition-colors submit-comment"
                              data-post-id="<%= post._id %>">
                              <i class="fas fa-paper-plane"></i>
                            </button>
                          </div>
                        </div>
                      </div>

              </div>
            </article>
            <% }); %>
        </div>
      </div>
    </section>
    <%- include('../partials/userPartials/footer.ejs') %>
      <script>
        const modal = document.getElementById('ideaModal');
        const openBtn = document.getElementById('openModalBtn');
        const closeBtn = document.getElementById('closeModalBtn');

        openBtn.addEventListener('click', () => {
          modal.classList.remove('hidden');
        });

        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
        });

        // ปิด modal เมื่อคลิกพื้นหลัง
        window.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
          }
        });


        document.addEventListener('DOMContentLoaded', () => {
          // Toggle comments
          document.querySelectorAll('.comment-btn').forEach(button => {
            button.addEventListener('click', () => {
              const postId = button.dataset.postId;
              const commentsSection = document.getElementById(`comments-${postId}`);
              commentsSection.classList.toggle('hidden');
            });
          });

          // Submit comment function (reusable)
          async function submitComment(postId, content, input) {
            try {
              const res = await fetch(`/user/ideas/${postId}/comment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ comment: content })
              });
              const data = await res.json();
              if (res.ok && data.success) {
                // เพิ่ม comment count
                const commentCountSpan = document.querySelector(`.comment-btn[data-post-id="${postId}"] .comment-count`);
                commentCountSpan.textContent = parseInt(commentCountSpan.textContent) + 1;

                // เพิ่ม comment ใหม่ใน section
                const commentSection = document.querySelector(`#comments-${postId} .space-y-3`);
                if (commentSection) {
                  const comment = data.comment;
                  const div = document.createElement('div');
                  div.className = 'flex items-start space-x-3';
                  div.innerHTML = `
                    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                      <i class="fas fa-user text-gray-600 text-sm"></i>
                    </div>
                    <div class="flex-1">
                      <div class="bg-gray-100 rounded-lg p-3">
                        <p class="font-semibold text-sm text-gray-800">${comment.author.familyName || 'ไม่ระบุ'}</p>
                        <p class="text-gray-600 text-sm">${comment.content}</p>
                      </div>
                      <div class="flex items-center mt-1 text-xs text-gray-500">
                        <span>เมื่อกี้</span>
                      </div>
                    </div>
                  `;
                  commentSection.appendChild(div);
                }

                input.value = '';
                document.getElementById(`comments-${postId}`).classList.remove('hidden');

                Swal.fire('ส่งสำเร็จ!', 'แสดงความคิดเห็นของคุณเรียบร้อยแล้ว', 'success');
              } else {
                Swal.fire('ผิดพลาด', data.error || 'เกิดข้อผิดพลาด', 'error');
              }
            } catch (err) {

              Swal.fire('ล้มเหลว', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
            }
          }

          // Bind submit comment buttons
          document.querySelectorAll('.submit-comment').forEach(button => {
            button.addEventListener('click', () => {
              const postId = button.dataset.postId;
              const input = document.querySelector(`.comment-input[data-post-id="${postId}"]`);
              const content = input.value.trim();

              if (!content) {
                return Swal.fire({
                  icon: 'warning',
                  title: 'กรุณาเขียนความคิดเห็น',
                  confirmButtonText: 'ตกลง'
                });
              }

              Swal.fire({
                title: 'ยืนยันการแสดงความคิดเห็น?',
                text: content,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                cancelButtonText: 'ยกเลิก',
                confirmButtonText: 'ยืนยัน'
              }).then((result) => {
                if (result.isConfirmed) {
                  submitComment(postId, content, input);
                }
              });
            });
          });

          // Submit comment on Enter key
          document.querySelectorAll('.comment-input').forEach(input => {
            input.addEventListener('keypress', (e) => {
              if (e.key === 'Enter') {
                e.preventDefault(); // ป้องกันขึ้นบรรทัดใหม่
                const postId = input.dataset.postId;
                const submitBtn = document.querySelector(`.submit-comment[data-post-id="${postId}"]`);
                if (submitBtn) submitBtn.click();
              }
            });
          });
        });

        // Submit comment on Enter key
        document.querySelectorAll('.comment-input').forEach(input => {
          input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
              const postId = input.dataset.postId;
              const submitBtn = document.querySelector(`.submit-comment[data-post-id="${postId}"]`);
              submitBtn.click();
            }
          });
        });

        document.getElementById('create-post-form').addEventListener('submit', async (e) => {
          e.preventDefault();

          const form = e.target;
          const formData = new FormData(form);

          const title = formData.get('title')?.trim();
          const category = formData.get('category');
          const content = formData.get('content')?.trim();

          if (!title || !category || !content) {
            return Swal.fire({
              icon: 'warning',
              title: 'กรุณากรอกข้อมูลให้ครบถ้วน',
              confirmButtonText: 'ตกลง'
            });
          }

          Swal.fire({
            title: `ยืนยันการส่งไอเดีย "${title}" หรือไม่?`,
            text: "คุณต้องการแบ่งปันไอเดียนี้ใช่หรือไม่",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ยืนยัน"
          }).then(async (result) => {
            if (result.isConfirmed) {
              try {
                const res = await fetch('/user/ideas/create', {
                  method: 'POST',
                  body: formData
                });
                const data = await res.json();

                if (data.success) {
                  Swal.fire('สำเร็จ!', 'เพิ่มไอเดียเรียบร้อยแล้ว', 'success')
                    .then(() => {
                      location.reload();
                    });
                } else {
                  Swal.fire('เกิดข้อผิดพลาด', data.error || 'ไม่สามารถเพิ่มไอเดียได้', 'error');
                }

              } catch (error) {
                Swal.fire('สำเร็จ!', 'เพิ่มไอเดียเรียบร้อยแล้ว', 'success')
                  .then(() => {
                    location.reload();
                  });
              }
            }
          });
        });


        // Filter functionality
        document.querySelectorAll('.idea-filter').forEach(button => {
          button.addEventListener('click', () => {
            const category = button.dataset.category;

            // Update active button
            document.querySelectorAll('.idea-filter').forEach(btn => {
              btn.classList.remove('bg-primary-green', 'hover:bg-secondary-green', 'text-white');
              btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            button.classList.remove('bg-gray-200', 'text-gray-700');
            button.classList.add('bg-primary-green', 'hover:bg-secondary-green', 'text-white');

            // Filter posts
            document.querySelectorAll('.idea-post').forEach(post => {
              if (category === 'all' || post.dataset.category === category) {
                post.style.display = 'block';
              } else {
                post.style.display = 'none';
              }
            });
          });
        });

        document.addEventListener('DOMContentLoaded', () => {
          const likeButtons = document.querySelectorAll('.like-btn');

          likeButtons.forEach(button => {
            button.addEventListener('click', async () => {
              const postId = button.getAttribute('data-post-id');

              try {
                const response = await fetch(`/user/ideas/${postId}/like`, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  }
                });

                const result = await response.json();
                if (result.success) {
                  const likeCountSpan = button.querySelector('.like-count');
                  likeCountSpan.textContent = result.likeCount;

                  // เปลี่ยน icon เมื่อถูกกด
                  const icon = button.querySelector('i');
                  icon.classList.toggle('fas', result.liked);
                  icon.classList.toggle('far', !result.liked);
                  icon.classList.toggle('text-red-500', result.liked);
                } else {
                  Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: 'กรุณาเข้าสู่ระบบ',
                  });
                }
              } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                  icon: 'error',
                  title: 'เกิดข้อผิดพลาด!',
                  text: 'ไม่สามารถกดไลค์ได้ กรุณาลองใหม่ภายหลัง',
                });
              }
            });
          });
        });




        // Load more functionality (demo)
        document.getElementById('load-more').addEventListener('click', () => {
          alert('ฟีเจอร์นี้จะโหลดไอเดียเพิ่มเติมจากฐานข้อมูล');
        });

        // Share functionality
        document.querySelectorAll('.share-btn').forEach(button => {
          button.addEventListener('click', () => {
            if (navigator.share) {
              navigator.share({
                title: 'ไอเดียการจัดการขยะ',
                text: 'มาดูไอเดียดีๆ เกี่ยวกับการจัดการขยะกัน',
                url: window.location.href
              });
            } else {
              // Fallback for browsers that don't support Web Share API
              const url = window.location.href;
              navigator.clipboard.writeText(url).then(() => {
                alert('คัดลอกลิงก์เรียบร้อยแล้ว!');
              });
            }
          });
        });
      </script>
      <!-- Delete Script -->
      <script>
        // Toggle dropdown menu
        document.querySelectorAll('.dropdown-toggle').forEach(button => {
          button.addEventListener('click', () => {
            const dropdownId = button.getAttribute('data-dropdown-id');
            const dropdown = document.getElementById(dropdownId);
            dropdown.classList.toggle('hidden');
          });
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', (event) => {
          document.querySelectorAll('.dropdown-toggle').forEach(button => {
            const dropdownId = button.getAttribute('data-dropdown-id');
            const dropdown = document.getElementById(dropdownId);
            if (!button.contains(event.target) && !dropdown.contains(event.target)) {
              dropdown.classList.add('hidden');
            }
          });
        });
        function deleteIdeas(id, title) {
          Swal.fire({
            title: `ลบ "${title}" หรือไม่?`,
            text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            cancelButtonText: "ยกเลิก",
            confirmButtonText: "ยืนยัน"
          }).then((result) => {
            if (result.isConfirmed) {
              fetch('/user/ideas/delete/' + id, {
                method: 'DELETE',
                headers: {
                  'Content-Type': 'application/json',
                },
              })
                .then(res => res.json())
                .then(data => {
                  if (data.success) {
                    Swal.fire('ลบข้อมูลสำเร็จ', data.message, 'success')
                      .then(() => {
                        const postElement = document.querySelector(`[data-post-id="${id}"]`);
                        if (postElement) {
                          postElement.classList.add('transition-opacity', 'duration-300', 'opacity-0');
                          setTimeout(() => postElement.remove(), 300);
                        }
                      });
                  } else {
                    Swal.fire('ลบข้อมูลไม่สำเร็จ', data.message, 'error');
                  }
                })
                .catch(error => {
                  console.error(error);
                  Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                });
            }
          });
        }
      </script>
      <!-- Edit Script -->
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          // ======= PREVIEW รูป Edit =======
          const editfileInput = document.getElementById('editImage');
          const editPreview = document.getElementById('edit-image-preview');
          const editBox_img = document.getElementById('edit-img-box');
          const editImage_input = document.getElementById('editImage');

        editfileInput.addEventListener('change', function () {
          const file = this.files[0];
          if (file) {
            editPreview.src = URL.createObjectURL(file);
            editBox_img.classList.remove('hidden');
          } else {
            editPreview.src = '';
            editBox_img.classList.add('hidden');
          }
        });

          // ทำให้เรียกใช้จาก HTML ได้
          window.clearEditImg = function () {
            editPreview.src = '';
            editImage_input.value = '';
            editBox_img.classList.add('hidden');
          };

          // ======= Modal Edit =======
          window.openEditModal = function (id, title, content, category, imageUrl = '') {
            document.getElementById('editPostId').value = id;
            document.getElementById('editTitle').value = title;
            document.getElementById('editContent').value = content;
            document.getElementById('editCategory').value = category;

            const editPreview = document.getElementById('edit-image-preview');
            const editBox_img = document.getElementById('edit-img-box');

            if (imageUrl && imageUrl !== '') {
              editPreview.src = imageUrl;
              editBox_img.classList.remove('hidden');
            } else {
              editPreview.src = '';
              editBox_img.classList.add('hidden');
            }

            if (imageUrl == 'no_image') {
              editBox_img.classList.add('hidden');
            }
            document.getElementById('editModal').classList.remove('hidden');
            document.getElementById('editModal').classList.add('flex');
          };

          window.closeEditModal = function () {
            document.getElementById('editModal').classList.remove('flex');
            document.getElementById('editModal').classList.add('hidden');
          };

          // ======= Handle Edit Submit =======
          document.getElementById('editPostForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const id = document.getElementById('editPostId').value;
            const title = document.getElementById('editTitle').value;
            const content = document.getElementById('editContent').value;
            const category = document.getElementById('editCategory').value;
            const image = document.getElementById('editImage').files[0];

            const formData = new FormData();
            formData.append('title', title);
            formData.append('content', content);
            formData.append('category', category);
            if (image) formData.append('image', image);

            try {
              const res = await fetch(`/user/ideas/edit/${id}`, {
                method: 'POST',
                body: formData
              });

              const result = await res.json();
              if (result.success) {
                Swal.fire('สำเร็จ', result.message, 'success').then(() => location.reload());
              } else {
                Swal.fire('ล้มเหลว', result.message || 'เกิดข้อผิดพลาดในการแก้ไขโพสต์', 'error');
              }
            } catch (err) {
              console.error(err);
              Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
            }
          });
        });
      </script>

      <!-- Time Ago Script -->
       <script>
        function timeAgo(dateString) {
          const now = new Date();
          const posted = new Date(dateString);
          const diffInSeconds = Math.floor((now - posted) / 1000);

          if (diffInSeconds < 60) return `${diffInSeconds} วินาทีที่แล้ว`;
          const diffInMinutes = Math.floor(diffInSeconds / 60);
          if (diffInMinutes < 60) return `${diffInMinutes} นาทีที่แล้ว`;
          const diffInHours = Math.floor(diffInMinutes / 60);
          if (diffInHours < 24) return `${diffInHours} ชั่วโมงที่แล้ว`;
          const diffInDays = Math.floor(diffInHours / 24);
          return `${diffInDays} วันที่แล้ว`;
        }

        document.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll('.post-time').forEach(el => {
            const isoTime = el.getAttribute('data-time');
            if (isoTime) el.textContent = timeAgo(isoTime);
          });
        });
      </script>

