<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/allActivity.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-pzjw8f+ua7Kw1TIqO5Cs5mPE65pYvThh+ZvrHE9jT1md/8xObNY7tOfr60RvBwjc" crossorigin="anonymous"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <%- include('../partials/nav.ejs') %>

    <div class="container py-5">
        <!-- หัวเรื่องหลัก -->
        <section>
            <div class="mb-5">
                <h1 class="text-3xl font-bold text-green-700 pb-2">
                    รายละเอียดกิจกรรม
                </h1>
            </div>

            <!-- รูปภาพและรายละเอียดกิจกรรม -->
            <div class="row g-4">
                <div class="col-md-5">
                    <img src="<%= activity.img %>" class="img-fluid rounded shadow-sm" alt="รูปภาพกิจกรรม">
                </div>
                <div class="col-md-7">
                    <!-- หัวข้อ + วันที่ในบรรทัดเดียวกัน -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="text-xl font-semibold text-gray-800 m-0"><%= activity.title %></h2>
                        <p class="text-sm text-gray-800 m-0">
                            <strong>วันที่ลง :</strong> <%= activity.formattedDate %>
                        </p>
                    </div>
                    <p>รายละเอียด : </p>
                    <p class="text-gray-700 mb-2 mt-2"><%= activity.content %></p>
                    <a href="/" class="text-green-600 hover:underline"><i class="fas fa-arrow-left me-1"></i>กลับหน้าหลัก</a>
                </div>
            </div>

            <!-- เพิ่มส่วนกิจกรรมอื่นๆ ที่สามารถคลิกเพื่อดูรายละเอียดเพิ่มเติม -->
            <div class="mt-5">
                <p><strong>กิจกรรมอื่นๆ</strong></p>
                <div class="row">
                    <% if (otherActivities.length=5) {  %>
                        <% otherActivities.forEach(act => { %>
                            <a href="/user/detailActivity/<%= act._id %>" class="card-linkk">
                                <p class="card-title"><%= act.formattedDate %> <%= act.title %></p>
                            </a>
                        <% }) %>
                        <% } else { %>
                            <p>ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                    <% } %>
                </div>
            </div>
        </section>
    </div>


    <%- include('../partials/footer.ejs') %>
</body>
</html>
