<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/allActivity.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-pzjw8f+ua7Kw1TIqO5Cs5mPE65pYvThh+ZvrHE9jT1md/8xObNY7tOfr60RvBwjc" crossorigin="anonymous"></script>
</head>
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="/img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li><a href="/">หน้าหลัก</a></li>
                    <li><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li><a href="/user/wasteSaleRequest">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user icon"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <section class="mt-3">
            <div class="mt-5 title-idea">
                <p class="title">รายละเอียดกิจกรรม</p>
            </div>
    
            <div class="row">
                <div class="col-md-5">
                    <img src="<%= activity.img %>" class="img-fluid" alt="รูปภาพกิจกรรม">
                </div>
                <div class="col-md-7">
                    <h3><%= activity.title %></h3>
                    <p><%= activity.content %></p>
                    <p><strong>วันที่:</strong> <%= activity.formattedDate %></p>
                    <a href="/">กลับหน้าหลัก</a>
                </div>
            </div>

            <!-- เพิ่มส่วนกิจกรรมอื่นๆ ที่สามารถคลิกเพื่อดูรายละเอียดเพิ่มเติม -->
            <div class="mt-5">
                <p><strong>กิจกรรมอื่นๆ</strong></p>
                <div class="row">
                    <% if (otherActivities.length=5) {  %>
                        <% otherActivities.forEach(act => { %>
                            <a href="/user/detailActivity/<%= act._id %>" class="card-linkk">
                                <p class="card-title"><%= act.formattedDate %> <%= act.title %></p>
                            </a>
                        <% }) %>
                        <% } else { %>
                            <p>ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                    <% } %>
                </div>
            </div>

        </section>
    </div>


    <%- include('../partials/footer.ejs') %>
</body>
</html>
