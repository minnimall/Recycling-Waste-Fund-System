</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">รายละเอียดกิจกรรม</h2>
        </div>
    </section>

    <div class="container mx-auto px-4 py-5 mt-5 mb-5">
        <!-- หัวเรื่องหลัก -->
        <section>
            <!-- รูปภาพและรายละเอียดกิจกรรม -->
            <div class="grid md:grid-cols-12 gap-4">
                <div class="md:col-span-5">
                    <% if (activity.img && activity.img.length > 1) { %>
                        <!-- Carousel สำหรับหลายรูป -->
                        <div id="activityCarousel" class="carousel slide rounded-lg shadow-sm overflow-hidden" data-bs-ride="carousel">
                            <div class="carousel-indicators">
                                <% activity.img.forEach((img, index) => { %>
                                    <button 
                                        type="button" 
                                        data-bs-target="#activityCarousel" 
                                        data-bs-slide-to="<%= index %>"
                                        class="<%= index === 0 ? 'active' : '' %>"
                                        aria-label="Slide <%= index + 1 %>"
                                    ></button>
                                <% }) %>
                            </div>

                            <div class="carousel-inner">
                                <% activity.img.forEach((img, index) => { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <img 
                                            src="<%= img %>" 
                                            class="d-block w-100 object-cover"
                                            style="height: 320px; object-fit: cover;"
                                            alt="รูปภาพกิจกรรม <%= index + 1 %>"
                                        >
                                    </div>
                                <% }) %>
                            </div>

                            <button class="carousel-control-prev" type="button" data-bs-target="#activityCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#activityCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                        </div>

                        <!-- Thumbnail ด้านล่าง -->
                        <div class="flex gap-2 mt-2 overflow-x-auto pb-1">
                            <% activity.img.forEach((img, index) => { %>
                                <img 
                                    src="<%= img %>" 
                                    class="rounded cursor-pointer border-2 flex-shrink-0 transition-all duration-200"
                                    style="width: 60px; height: 60px; object-fit: cover;"
                                    alt="thumbnail <%= index + 1 %>"
                                    onclick="goToSlide(<%= index %>)"
                                    id="thumb-<%= index %>"
                                >
                            <% }) %>
                        </div>

                    <% } else if (activity.img && activity.img.length === 1) { %>
                        <!-- รูปเดียว -->
                        <img 
                            src="<%= activity.img[0] %>" 
                            class="w-full h-auto rounded-lg shadow-sm object-cover" 
                            alt="รูปภาพกิจกรรม"
                        >
                    <% } else { %>
                        <!-- ไม่มีรูป -->
                        <div class="w-full rounded-lg shadow-sm bg-gray-100 flex items-center justify-center" style="height: 320px;">
                            <p class="text-gray-400"><i class="fas fa-image mr-2"></i>ไม่มีรูปภาพ</p>
                        </div>
                    <% } %>
                </div>
                
                <div class="md:col-span-7">
                    <!-- หัวข้อ + วันที่ในบรรทัดเดียวกัน -->
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 gap-2">
                        <h2 class="text-xl font-semibold text-gray-800 m-0">
                            <%= activity.title %>
                        </h2>
                        <p class="text-sm text-gray-800 m-0 flex-shrink-0">
                            <strong>วันที่ลง :</strong> <%= activity.formattedDate %>
                        </p>
                    </div>
                    
                    <p class="font-medium text-gray-900 mb-2">รายละเอียด :</p>
                    <p class="text-gray-700 mb-4 mt-2 leading-relaxed">
                        <%= activity.content %>
                    </p>
                    
                    <a 
                        href="/" 
                        class="inline-flex items-center text-green-600 hover:text-green-700 hover:underline transition-colors"
                    >
                        <i class="fas fa-arrow-left mr-1"></i>กลับหน้าหลัก
                    </a>
                </div>
            </div>
            
            <!-- เพิ่มส่วนกิจกรรมอื่นๆ ที่สามารถคลิกเพื่อดูรายละเอียดเพิ่มเติม -->
            <div class="mt-8 pt-6 border-t border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">กิจกรรมอื่นๆ</h3>
                
                <div class="space-y-3">
                    <% if (otherActivities && otherActivities.length > 0) { %>
                        <% otherActivities.forEach(act => { %>
                            <a 
                                href="/user/detailActivity/<%= act._id %>" 
                                class="block p-3 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 transition-all duration-200 group"
                            >
                                <p class="text-gray-800 group-hover:text-green-700 font-medium">
                                    <span class="text-sm text-gray-600 mr-2">
                                        <%= act.formattedDate %>
                                    </span>
                                    <%= act.title %>
                                </p>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-8">
                            <p class="text-gray-500">ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
    </div>


    <%- include('../partials/userPartials/footer.ejs') %>
    <script>
        const carousel = document.getElementById('activityCarousel');
        if (carousel) {
            // Highlight thumbnail ที่ active
            const updateThumbs = (index) => {
                document.querySelectorAll('[id^="thumb-"]').forEach((thumb, i) => {
                    thumb.classList.toggle('border-green-500', i === index);
                    thumb.classList.toggle('border-transparent', i !== index);
                    thumb.classList.toggle('opacity-60', i !== index);
                });
            };

            updateThumbs(0);

            carousel.addEventListener('slid.bs.carousel', (e) => {
                updateThumbs(e.to);
            });
        }

        function goToSlide(index) {
            const carouselEl = document.getElementById('activityCarousel');
            if (carouselEl) {
                bootstrap.Carousel.getInstance(carouselEl)?.to(index);
            }
        }
    </script>
</body>
</html>
