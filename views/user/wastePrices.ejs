<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
</head>

<body>
    <%- include('../partials/userPartials/header.ejs') %>
    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">ข้อมูลราคารับซื้อขยะ</h2>
            <p class="text-xl opacity-90">อัปเดตราคาขยะรีไซเคิล ณ ราคาปัจจุบันในการรับซื้อ</p>
        </div>
    </section>
    <main class="container mx-auto px-4 py-8">
        <!-- Search and Filter -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
            <input type="text" id="searchInput" placeholder="ค้นหาประเภทขยะ..." class="w-full md:max-w-md px-4 py-2 border rounded-lg shadow-sm">
            <select id="itemsPerPage" class="px-3 py-2 border rounded-lg">
                <option value="10">10 รายการ</option>
                <option value="15">15 รายการ</option>
                <option value="20">20 รายการ</option>
            </select>
        </div>

        <!-- Cards -->
        <div id="cardsContainer" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6"></div>

        <!-- Pagination -->
        <div id="pagination" class="flex justify-center items-center mt-10 gap-1"></div>

        <!-- No results -->
        <div id="noResults" class="text-center mt-12 hidden">
            <div class="max-w-md mx-auto bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl shadow-lg border border-gray-200 p-10">
                <div class="mb-6">
                    <div class="w-24 h-24 mx-auto bg-gray-200 rounded-full flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">ไม่พบรายการขยะที่ค้นหา</h3>
                <button 
                    onclick="searchInput.value = ''; searchInput.dispatchEvent(new Event('input'));" 
                    class="inline-flex items-center px-6 py-3 bg-primary-green text-white font-medium rounded-lg hover:bg-secondary-green transform hover:scale-105 transition-all duration-300 shadow-md"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    รีเซ็ตการค้นหา
                </button>
            </div>
        </div>
    </main>

    <%- include('../partials/userPartials/footer.ejs') %>

    <style>
        /* ========== Placeholder Icon ========== */
        .waste-img-wrapper {
            position: relative;
            height: 12rem; /* h-48 */
            background-color: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .waste-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .waste-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            height: 100%;
        }
        .waste-placeholder svg {
            width: 56px;
            height: 56px;
            opacity: 0.55;
        }
        .waste-placeholder span {
            font-size: 11px;
            color: #9ca3af;
            letter-spacing: 0.02em;
        }

        /* ========== Pagination ========== */
        #pagination {
            gap: 4px;
        }
        .pg-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 38px;
            height: 38px;
            padding: 0 10px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            border: 1.5px solid #e5e7eb;
            background: #ffffff;
            color: #374151;
            transition: all 0.18s ease;
            user-select: none;
        }
        .pg-btn:hover:not(.pg-active):not(.pg-disabled) {
            background: #f0fdf4;
            border-color: #86efac;
            color: #15803d;
        }
        .pg-active {
            background: #16a34a;
            border-color: #16a34a;
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(22,163,74,0.25);
            cursor: default;
        }
        .pg-disabled {
            opacity: 0.38;
            cursor: not-allowed;
            pointer-events: none;
        }
        .pg-ellipsis {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 38px;
            color: #9ca3af;
            font-size: 15px;
            letter-spacing: 1px;
        }
        .pg-arrow svg {
            width: 16px;
            height: 16px;
        }
    </style>

    <script>
        const wasteData = <%- JSON.stringify(waste) %>;

        const cardsContainer = document.getElementById('cardsContainer');
        const pagination = document.getElementById('pagination');
        const searchInput = document.getElementById('searchInput');
        const itemsPerPageSelect = document.getElementById('itemsPerPage');
        const noResults = document.getElementById('noResults');

        let currentPage = 1;
        let itemsPerPage = parseInt(itemsPerPageSelect.value);
        let filteredData = [...wasteData];

        /* ---------- Placeholder SVG icons by waste type ---------- */
        function getPlaceholderIcon(wasteTypeName) {
            const name = (wasteTypeName || '').toLowerCase();

            /* กระดาษ */
            if (name.includes('กระดาษ') || name.includes('paper')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="14" y="8" width="32" height="40" rx="3" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <path d="M22 20h20M22 27h20M22 34h14" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                    <path d="M38 8v10h8" stroke="#9ca3af" stroke-width="2.2" stroke-linejoin="round" fill="none"/>
                </svg>`;
            }
            /* พลาสติก / ขวด */
            if (name.includes('พลาสติก') || name.includes('ขวด') || name.includes('plastic') || name.includes('bottle')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 14h16v6l4 8v18a4 4 0 01-4 4H24a4 4 0 01-4-4V28l4-8V14z" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <rect x="26" y="10" width="12" height="6" rx="2" stroke="#9ca3af" stroke-width="2" fill="#d1d5db"/>
                    <path d="M22 32h20M24 40h16" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                </svg>`;
            }
            /* โลหะ / เหล็ก / อะลูมิเนียม */
            if (name.includes('โลหะ') || name.includes('เหล็ก') || name.includes('อะลูมิ') || name.includes('metal') || name.includes('กระป๋อง')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="20" y="16" width="24" height="32" rx="6" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <ellipse cx="32" cy="16" rx="12" ry="4" stroke="#9ca3af" stroke-width="2" fill="#d1d5db"/>
                    <ellipse cx="32" cy="48" rx="12" ry="4" stroke="#9ca3af" stroke-width="2" fill="#d1d5db"/>
                    <path d="M26 28h12M26 34h12" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                </svg>`;
            }
            /* แก้ว */
            if (name.includes('แก้ว') || name.includes('glass')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 12h20l-4 32H26L22 12z" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <path d="M22 12h20" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M24.5 44h15" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M27 20l1 16M31 20v16" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
                </svg>`;
            }
            /* อิเล็กทรอนิกส์ / e-waste */
            if (name.includes('อิเล็ก') || name.includes('electronic') || name.includes('e-waste') || name.includes('คอม') || name.includes('มือถือ')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="14" y="18" width="36" height="24" rx="3" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <rect x="26" y="42" width="12" height="4" fill="#d1d5db"/>
                    <path d="M20 46h24" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="32" cy="30" r="5" stroke="#9ca3af" stroke-width="2" fill="none"/>
                    <path d="M24 26h2M38 26h2M24 34h2M38 34h2" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round"/>
                </svg>`;
            }
            /* ยาง / รถ */
            if (name.includes('ยาง') || name.includes('rubber') || name.includes('tire')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="18" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <circle cx="32" cy="32" r="9" stroke="#9ca3af" stroke-width="2" fill="#d1d5db"/>
                    <path d="M32 14v6M32 44v6M14 32h6M44 32h6M19.5 19.5l4.2 4.2M40.3 40.3l4.2 4.2M44.5 19.5l-4.2 4.2M23.7 40.3l-4.2 4.2" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                </svg>`;
            }
            /* อินทรีย์ / เศษอาหาร / ใบไม้ */
            if (name.includes('อินทรีย์') || name.includes('อาหาร') || name.includes('ใบไม้') || name.includes('organic') || name.includes('food')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M32 52C32 52 14 38 14 26a18 18 0 0136 0c0 12-18 26-18 26z" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb"/>
                    <path d="M32 52V30" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                    <path d="M32 38c0 0-8-6-8-14" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
                    <path d="M32 34c0 0 7-5 7-12" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
                </svg>`;
            }
            /* อันตราย / เคมี */
            if (name.includes('อันตราย') || name.includes('เคมี') || name.includes('hazard') || name.includes('chemical')) {
                return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M32 10L56 52H8L32 10z" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb" stroke-linejoin="round"/>
                    <path d="M32 28v10" stroke="#9ca3af" stroke-width="2.8" stroke-linecap="round"/>
                    <circle cx="32" cy="44" r="2.2" fill="#9ca3af"/>
                </svg>`;
            }
            /* Default: ถุงขยะทั่วไป */
            return `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 20h24l-3 28H23L20 20z" stroke="#9ca3af" stroke-width="2.5" fill="#e5e7eb" stroke-linejoin="round"/>
                <path d="M16 20h32" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M27 14c0-2 2-3 5-3s5 1 5 3" stroke="#9ca3af" stroke-width="2" stroke-linecap="round" fill="none"/>
                <path d="M26 28l1 16M32 28v16M38 28l-1 16" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" opacity="0.5"/>
            </svg>`;
        }

        function createCard(item) {
            const imgSrc = item.img || '';
            const typeName = item.wasteType ? item.wasteType.wasteTypeName : '';
            const colorTheme = item.wasteType ? item.wasteType.colorTheme : 'green';

            const imageSection = imgSrc
                ? `<div class="waste-img-wrapper">
                    <img src="${imgSrc}" alt="${item.wasteName}" onerror="this.closest('.waste-img-wrapper').innerHTML = placeholderHtml('${typeName.replace(/'/g, "\\'")}')">
                    </div>`
                : `<div class="waste-img-wrapper">
                        <div class="waste-placeholder">
                            ${getPlaceholderIcon(typeName)}
                            <span>${typeName || 'ขยะรีไซเคิล'}</span>
                        </div>
                    </div>`;

            return `
                <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                    <div class="bg-${colorTheme}-500 h-2"></div>
                    ${imageSection}
                    <div class="p-4">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1 pr-2">
                                <h3 class="text-sm font-semibold text-gray-800 mb-1 leading-tight">${item.wasteName}</h3>
                                <span class="inline-block px-2 py-0.5 text-xs font-medium text-gray-600 bg-gray-100 rounded-full">
                                    ${typeName}
                                </span>
                            </div>
                            <div class="text-right shrink-0">
                                <div class="text-xl font-bold text-green-600">${item.pricePerUnit}</div>
                                <div class="text-xs text-gray-500">บาท/กก.</div>
                            </div>
                        </div>
                        ${/* 
                        <div class="pt-3 border-t border-gray-100">
                            <div class="flex items-center justify-between text-xs text-gray-500">
                                <span>หน่วย: กิโลกรัม</span>
                                <span class="text-green-600 font-medium"> ${item.pricePerUnit} บาท</span>
                            </div>
                        </div>
                        */''}
                    </div>
                </div>
            `;
        }

        /* helper สำหรับ onerror callback */
        function placeholderHtml(typeName) {
            return `<div class="waste-placeholder">${getPlaceholderIcon(typeName)}<span>${typeName || 'ขยะรีไซเคิล'}</span></div>`;
        }

        function displayData() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const dataToShow = filteredData.slice(start, end);

            if (dataToShow.length === 0) {
                noResults.classList.remove('hidden');
                cardsContainer.innerHTML = '';
                pagination.innerHTML = '';
                return;
            }

            noResults.classList.add('hidden');
            cardsContainer.innerHTML = dataToShow.map(createCard).join('');
            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            if (totalPages <= 1) { pagination.innerHTML = ''; return; }

            const arrowLeft = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4L6 8l4 4"/></svg>`;
            const arrowRight = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4l4 4-4 4"/></svg>`;

            let html = '';

            /* Prev */
            html += `<button class="pg-btn pg-arrow ${currentPage === 1 ? 'pg-disabled' : ''}" onclick="goToPage(${currentPage - 1})" aria-label="หน้าก่อน">${arrowLeft}</button>`;

            /* Page numbers with ellipsis */
            const pages = getPaginationRange(currentPage, totalPages);
            pages.forEach(p => {
                if (p === '...') {
                    html += `<span class="pg-ellipsis">···</span>`;
                } else {
                    html += `<button class="pg-btn ${p === currentPage ? 'pg-active' : ''}" onclick="goToPage(${p})">${p}</button>`;
                }
            });

            /* Next */
            html += `<button class="pg-btn pg-arrow ${currentPage === totalPages ? 'pg-disabled' : ''}" onclick="goToPage(${currentPage + 1})" aria-label="หน้าถัดไป">${arrowRight}</button>`;

            pagination.innerHTML = html;
        }

        /* สร้าง array ของหมายเลขหน้า พร้อม ellipsis */
        function getPaginationRange(current, total) {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            const result = [];
            const delta = 1; /* จำนวนหน้าข้างๆ current */

            const left = Math.max(2, current - delta);
            const right = Math.min(total - 1, current + delta);

            result.push(1);
            if (left > 2) result.push('...');
            for (let i = left; i <= right; i++) result.push(i);
            if (right < total - 1) result.push('...');
            result.push(total);

            return result;
        }

        function goToPage(page) {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            displayData();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        searchInput.addEventListener('input', () => {
            const term = searchInput.value.toLowerCase();
            filteredData = wasteData.filter(w =>
                w.wasteName.toLowerCase().includes(term) ||
                w.wasteType.wasteTypeName.toLowerCase().includes(term)
            );
            currentPage = 1;
            displayData();
        });

        itemsPerPageSelect.addEventListener('change', () => {
            itemsPerPage = parseInt(itemsPerPageSelect.value);
            currentPage = 1;
            displayData();
        });

        displayData();
    </script>
</body>
</html>