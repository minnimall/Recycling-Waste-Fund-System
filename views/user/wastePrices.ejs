<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
</head>

<body>
    <%- include('../partials/userPartials/header.ejs') %>
    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">ข้อมูลราคารับซื้อขยะ</h2>
            <p class="text-xl opacity-90">อัปเดตราคาขยะรีไซเคิลประจำเดือน</p>
        </div>
    </section>
    <main class="container mx-auto px-4 py-8">
        <!-- Search and Filter -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
            <input type="text" id="searchInput" placeholder="ค้นหาประเภทขยะ..." class="w-full md:max-w-md px-4 py-2 border rounded-lg shadow-sm">
            <select id="itemsPerPage" class="px-3 py-2 border rounded-lg">
                <option value="6">6 รายการ</option>
                <option value="12">12 รายการ</option>
                <option value="18">18 รายการ</option>
            </select>
        </div>

        <!-- Cards -->
        <div id="cardsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"></div>

        <!-- Pagination -->
        <div id="pagination" class="flex justify-center mt-8 space-x-2"></div>

        <!-- No results -->
        <div id="noResults" class="text-center mt-12 hidden">
            <div class="max-w-md mx-auto bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl shadow-lg border border-gray-200 p-10">
                <div class="mb-6">
                    <div class="w-24 h-24 mx-auto bg-gray-200 rounded-full flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">ไม่พบรายการขยะที่ค้นหา</h3>
                <button 
                    onclick="searchInput.value = ''; searchInput.dispatchEvent(new Event('input'));" 
                    class="inline-flex items-center px-6 py-3 bg-primary-green text-white font-medium rounded-lg hover:bg-secondary-green transform hover:scale-105 transition-all duration-300 shadow-md"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    รีเซ็ตการค้นหา
                </button>
            </div>
        </div>
    </main>

    <%- include('../partials/userPartials/footer.ejs') %>

    <script>
        const wasteData = <%- JSON.stringify(waste) %>;

        const cardsContainer = document.getElementById('cardsContainer');
        const pagination = document.getElementById('pagination');
        const searchInput = document.getElementById('searchInput');
        const itemsPerPageSelect = document.getElementById('itemsPerPage');
        const noResults = document.getElementById('noResults');

        let currentPage = 1;
        let itemsPerPage = parseInt(itemsPerPageSelect.value);
        let filteredData = [...wasteData];

        function createCard(item) {
            // กำหนดรูปภาพ default ถ้าไม่มีรูป
            const imgSrc = item.img || '/images/default-waste.png';
            
            return `
                <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                    <div class="bg-${item.wasteType.colorTheme}-500 h-2"></div>
                    
                    <!-- รูปภาพขยะ -->
                    <div class="relative h-48 bg-gray-100">
                        <img 
                            src="${imgSrc}" 
                            alt="${item.wasteName}"
                            class="w-full h-full object-cover"
                            onerror="this.src='/images/default-waste.png'"
                        >
                    </div>
                    
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-4">
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold text-gray-800 mb-1">${item.wasteName}</h3>
                                <span class="inline-block px-2 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded-full">
                                    ${item.wasteType.wasteTypeName}
                                </span>
                            </div>
                            <div class="text-right">
                                <div class="text-2xl font-bold text-green-600">${item.pricePerUnit}</div>
                                <div class="text-sm text-gray-500">บาท/กก.</div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <div class="flex items-center justify-between text-sm text-gray-500">
                                <span>หน่วย: กิโลกรัม</span>
                                <span class="text-green-600 font-medium">💰 ${item.pricePerUnit} บาท</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function displayData() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const dataToShow = filteredData.slice(start, end);

            if (dataToShow.length === 0) {
                noResults.classList.remove('hidden');
                cardsContainer.innerHTML = '';
                pagination.innerHTML = '';
                return;
            }

            noResults.classList.add('hidden');
            cardsContainer.innerHTML = dataToShow.map(createCard).join('');
            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            if (totalPages <= 1) return pagination.innerHTML = '';

            let html = '';

            for (let i = 1; i <= totalPages; i++) {
                html += `<button onclick="goToPage(${i})" class="px-3 py-1 border rounded ${i === currentPage ? 'bg-blue-500 text-white' : 'bg-white text-gray-700'}">${i}</button>`;
            }

            pagination.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            displayData();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        searchInput.addEventListener('input', () => {
            const term = searchInput.value.toLowerCase();
            filteredData = wasteData.filter(w => 
                w.wasteName.toLowerCase().includes(term) || 
                w.wasteType.wasteTypeName.toLowerCase().includes(term)
            );
            currentPage = 1;
            displayData();
        });

        itemsPerPageSelect.addEventListener('change', () => {
            itemsPerPage = parseInt(itemsPerPageSelect.value);
            currentPage = 1;
            displayData();
        });

        displayData();
    </script>
</body>
</html>
