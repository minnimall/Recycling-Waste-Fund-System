<!DOCTYPE html>
<html lang="th">
<head>

    <%- include('../partials/userPartials/head.ejs') %>
    
    <style>
        body { font-family: 'Sarabun', sans-serif; background-color: #f8fafc; }
        .glass-header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
        }
        .tab-active {
            border-bottom: 2px solid #059669;
            color: #059669;
            font-weight: 600;
        }
        .tab-inactive {
            border-bottom: 2px solid transparent;
            color: #64748b;
        }
        .tab-inactive:hover {
            color: #334155;
            border-bottom: 2px solid #cbd5e1;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800">

    <%- include('../partials/userPartials/header.ejs') %>

    <main class="flex-grow container mx-auto px-4 py-8 mt-20 max-w-5xl">
        
        <!-- Header Section -->
        <div class="mb-8 text-center md:text-left">
            <h1 class="text-3xl font-bold text-slate-800 mb-2">
                <i class="fa-solid fa-clock-rotate-left mr-2 text-primary"></i>ประวัติการทำรายการ
            </h1>
            <p class="text-slate-500">ตรวจสอบประวัติการขายขยะและติดตามสถานะคำร้อง</p>
        </div>

        <!-- Summary Cards -->
        <% 
            let totalSoldAmount = 0;
            let totalSoldWeight = 0;
            if (transactions) {
                transactions.forEach(t => {
                    totalSoldAmount += t.totalAmount;
                    if (t.wasteItems) {
                        t.wasteItems.forEach(item => totalSoldWeight += item.quantity);
                    }
                });
            }
        %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-100 rounded-2xl p-6 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center text-emerald-600 shadow-sm text-2xl">
                    <i class="fa-solid fa-coins"></i>
                </div>
                <div>
                    <p class="text-sm text-emerald-600 font-semibold uppercase tracking-wide">ยอดขายสะสมรวม</p>
                    <p class="text-3xl font-bold text-slate-800"><%= totalSoldAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) %> <span class="text-lg text-slate-500 font-medium">บาท</span></p>
                </div>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-2xl p-6 shadow-sm flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center text-blue-600 shadow-sm text-2xl">
                    <i class="fa-solid fa-weight-hanging"></i>
                </div>
                <div>
                    <p class="text-sm text-blue-600 font-semibold uppercase tracking-wide">น้ำหนักขยะรวม</p>
                    <p class="text-3xl font-bold text-slate-800"><%= totalSoldWeight.toLocaleString('th-TH', {minimumFractionDigits: 2}) %> <span class="text-lg text-slate-500 font-medium">กก.</span></p>
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="bg-white rounded-t-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="flex border-b border-slate-200">
                <button onclick="switchTab('transactions')" id="tab-transactions" class="flex-1 py-4 text-center transition-all duration-200 tab-active">
                    <i class="fa-solid fa-hand-holding-dollar mr-2"></i>ประวัติการขายสำเร็จ
                </button>
                <button onclick="switchTab('requests')" id="tab-requests" class="flex-1 py-4 text-center transition-all duration-200 tab-inactive">
                    <i class="fa-solid fa-file-invoice mr-2"></i>ประวัติคำร้องแจ้งขาย
                </button>
            </div>
        </div>

        <!-- Tab Content: Transactions -->
        <div id="content-transactions" class="bg-white rounded-b-2xl shadow-sm border border-t-0 border-slate-200 p-6 min-h-[400px]">
            <% if (transactions && transactions.length > 0) { %>
                <div class="space-y-4">
                    <% transactions.forEach(t => { %>
                        <div class="border border-slate-100 rounded-xl p-4 hover:shadow-md transition-shadow duration-200 bg-slate-50/50">
                            <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                                <div class="flex items-start gap-4">
                                    <div class="w-12 h-12 rounded-lg bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0 text-xl">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <p class="font-bold text-slate-800 text-lg">รายการขายขยะ</p>
                                            <span class="px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-700">สำเร็จ</span>
                                        </div>
                                        <p class="text-sm text-slate-500 mb-2">
                                            <i class="fa-regular fa-calendar mr-1"></i>    <%= moment(t.purchaseDate).format('D MMMM YYYY, HH:mm น.') %>
                                        </p>
                                        <!-- Waste Items List -->
                                        <div class="text-sm text-slate-600 space-y-1">
                                            <% if (t.wasteItems && t.wasteItems.length > 0) { %>
                                                <% t.wasteItems.forEach(item => { %>
                                                    <div class="flex items-center gap-2">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
                                                        <span><%= item.name %></span>
                                                        <span class="text-slate-400">x <%= item.quantity.toLocaleString() %> กก.</span>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <span class="text-slate-400 italic">ไม่พบรายละเอียดรายการ</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right border-t md:border-t-0 pt-3 md:pt-0 mt-2 md:mt-0 flex flex-row md:flex-col justify-between items-center md:items-end">
                                    <p class="text-sm text-slate-500">ยอดเงินที่ได้</p>
                                    <p class="text-2xl font-bold text-emerald-600">+<%= t.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) %></p>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                    <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-3xl">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <p class="text-lg font-medium">ยังไม่มีประวัติการขายขยะสำเร็จ</p>
                    <p class="text-sm">เมื่อเจ้าหน้าที่เข้าทำการรับซื้อ รายการจะปรากฏที่นี่</p>
                </div>
            <% } %>
        </div>

        <!-- Tab Content: Requests -->
        <div id="content-requests" class="hidden bg-white rounded-b-2xl shadow-sm border border-t-0 border-slate-200 p-6 min-h-[400px]">
            <% if (requests && requests.length > 0) { %>
                <div class="space-y-4">
                    <% requests.forEach(r => { %>
                        <div class="border border-slate-100 rounded-xl p-4 hover:shadow-md transition-shadow duration-200 bg-white">
                            <div class="flex flex-col md:flex-row justify-between gap-4">
                                <div class="flex items-start gap-4">
                                    <!-- Status Icon Logic -->
                                    <% 
                                        let statusClass = "bg-gray-100 text-gray-500";
                                        let statusIcon = "fa-spinner";
                                        let statusText = "รอดำเนินการ";

                                        if (r.status === 'pending') {
                                            statusClass = "bg-yellow-100 text-yellow-600";
                                            statusIcon = "fa-hourglass-half";
                                            statusText = "รออนุมัติ";
                                        } else if (r.status === 'confirmed') {
                                            statusClass = "bg-blue-100 text-blue-600";
                                            statusIcon = "fa-calendar-check";
                                            statusText = "รอรถเข้ามารับ";
                                        } else if (r.status === 'in-progress') {
                                            statusClass = "bg-indigo-100 text-indigo-600";
                                            statusIcon = "fa-truck-fast";
                                            statusText = "กำลังดำเนินการ";
                                        } else if (r.status === 'completed' || r.status === 'complete') {
                                            statusClass = "bg-green-100 text-green-600";
                                            statusIcon = "fa-check-circle";
                                            statusText = "เสร็จสิ้น";
                                        } else if (r.status === 'rejected' || r.status.includes('CANCEL')) {
                                            statusClass = "bg-red-100 text-red-600";
                                            statusIcon = "fa-circle-xmark";
                                            statusText = "ยกเลิก/ปฏิเสธ";
                                        }
                                    %>
                                    <div class="w-12 h-12 rounded-lg <%= statusClass %> flex items-center justify-center flex-shrink-0 text-xl">
                                        <i class="fa-solid <%= statusIcon %>"></i>
                                    </div>
                                    
                                    <div>
                                        <div class="flex items-center flex-wrap gap-2 mb-1">
                                            <p class="font-bold text-slate-800 text-lg">คำร้องขายขยะ</p>
                                            <span class="px-2 py-0.5 rounded text-xs font-bold <%= statusClass %> bg-opacity-20"><%= statusText %></span>
                                        </div>
                                        <p class="text-sm text-slate-500 mb-2">
                                            <i class="fa-regular fa-clock mr-1"></i> แจ้งเมื่อ <%= moment(r.createdAt).format('D MMM YYYY, HH:mm') %>
                                        </p>

                                        <!-- Waste List -->
                                        <% if (r.waste && r.waste.length > 0) { %>
                                            <div class="flex flex-wrap gap-2 mt-2">
                                                <% r.waste.forEach(w => { %>
                                                    <span class="inline-flex items-center px-2 py-1 rounded bg-slate-100 text-slate-600 text-xs font-medium border border-slate-200">
                                                        <%= w.wasteName %>
                                                    </span>
                                                <% }); %>
                                            </div>
                                        <% } %>

                                        <!-- Message/Remark -->
                                        <% if (r.responseMessage) { %>
                                            <div class="mt-3 p-2 bg-slate-50 rounded text-sm text-slate-600 border border-slate-100">
                                                <span class="font-semibold text-slate-700">ข้อความจากเจ้าหน้าที่:</span> <%= r.responseMessage %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Action / Date Info -->
                                <div class="text-right border-t md:border-t-0 pt-3 md:pt-0 mt-2 md:mt-0 flex flex-col justify-center items-end text-sm text-slate-500 gap-1">
                                    <% if (r.approvePickupDate) { %>
                                        <p class="text-blue-600 font-medium bg-blue-50 px-3 py-1 rounded-full">
                                            <i class="fa-solid fa-calendar-day mr-1"></i> นัดรับ: <%= moment(r.approvePickupDate).format('D MMM YYYY') %>
                                        </p>
                                    <% } %>
                                    <p>สถานที่: <span class="text-slate-700"><%= r.locationMoreDetail || 'ตามพิกัดแผนที่' %></span></p>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                    <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-3xl">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <p class="text-lg font-medium">ไม่พบประวัติคำร้อง</p>
                    <a href="/user/wasteSaleRequest" class="mt-4 px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors shadow-sm font-medium">
                        <i class="fa-solid fa-plus mr-2"></i>แจ้งความประสงค์
                    </a>
                </div>
            <% } %>
        </div>

    </main>

    <%- include('../partials/userPartials/footer.ejs') %>

    <script>
        function switchTab(tabName) {
            const contentTransactions = document.getElementById('content-transactions');
            const contentRequests = document.getElementById('content-requests');
            const tabTransactions = document.getElementById('tab-transactions');
            const tabRequests = document.getElementById('tab-requests');

            if (tabName === 'transactions') {
                contentTransactions.classList.remove('hidden');
                contentRequests.classList.add('hidden');
                
                tabTransactions.classList.add('tab-active');
                tabTransactions.classList.remove('tab-inactive');
                
                tabRequests.classList.add('tab-inactive');
                tabRequests.classList.remove('tab-active');
            } else {
                contentTransactions.classList.add('hidden');
                contentRequests.classList.remove('hidden');

                tabRequests.classList.add('tab-active');
                tabRequests.classList.remove('tab-inactive');

                tabTransactions.classList.add('tab-inactive');
                tabTransactions.classList.remove('tab-active');
            }
        }
    </script>
</body>
</html>