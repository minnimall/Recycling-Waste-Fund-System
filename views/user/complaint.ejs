<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
    <!-- Ionicons CDN -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- อันใหม่ที่อยากเพิ่ม -->
    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">คำร้อง/ข้อร้องเรียน</h2>
            <p class="text-xl opacity-90">เสียงของประชาชนคือสิ่งสำคัญสำหรับเรา</p>
        </div>
    </section>
    <!-- Complaint Form -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="mt-5 mb-5 bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
                    <!-- Header Section -->
                    <div class="bg-gradient-to-r from-primary-green to-secondary-green text-white p-6">
                        <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                            <h2 class="text-2xl font-bold">ฟอร์มกรอกข้อมูลเบื้องต้น</h2>
                            <div class="flex items-center gap-2">
                                <!-- <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a1 1 0 011-1h6a1 1 0 011 1v4m-6 0h6m-6 0V7a1 1 0 00-1 1v12a1 1 0 001 1h6a1 1 0 001-1V8a1 1 0 00-1-1H8z"></path>
                                </svg> -->
                                <p id="time" class="block text-white text-sm mb-2">วันที่ <span id="date-time"></span></p>
                            </div>
                        </div>
                    </div>

                <!-- Complaint Form -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <form id="complaint-form" action="/user/complaintPost" method="POST" enctype="multipart/form-data" class="space-y-6">
                        <input type="hidden" name="username" value="<%= session.username %>">

                        <!-- Category -->
                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">ประเภทข้อร้องเรียน <span class="text-red-500">*</span></label>
                            <select name="category" required 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent">
                                <option value="">เลือกประเภทข้อร้องเรียน</option>
                                <option value="waste">การจัดการขยะ</option>
                                <option value="service">การบริการของเจ้าหน้าที่</option>
                                <option value="noise">เสียงรบกวน</option>
                                <option value="sale">การขายขยะ</option>
                                <option value="other">อื่นๆ</option>
                            </select>
                        </div>

                        <!-- Message -->
                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">รายละเอียดข้อร้องเรียน <span class="text-red-500">*</span></label>
                            <textarea name="complaintMessage" required rows="6" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent"
                                placeholder="กรอกรายละเอียดปัญหาให้ชัดเจน เช่น สถานที่เกิดเหตุ วันเวลา และสาเหตุ"></textarea>
                        </div>

                        <!-- Image Upload -->
                        <div class="mb-6">
                            <label for="image" class="block text-gray-700 font-semibold mb-2">
                                <span class="flex items-center gap-2">
                                    อัปโหลดรูปภาพ
                                </span>
                            </label>
                            <div class="relative">
                                <input type="file" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-primary-green transition-colors file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary-green file:text-white hover:file:bg-green-600 cursor-pointer" id="image" name="image" accept="image/*">
                            </div>
                        </div>

                        <!-- Submit -->
                        <div class="flex flex-col sm:flex-row gap-4">
                            <button type="submit" 
                                class="flex-1 bg-primary-green text-white py-3 px-6 rounded-lg font-semibold hover:bg-secondary-green transition-colors">
                                ส่งข้อร้องเรียน
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/userPartials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        //แสดงวัน

        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>
    <script>
        // preview รูป
        const imageInput = document.getElementById('image');
        const imagePreview = document.getElementById('imagePreview');
        const previewImage = document.getElementById('previewImage');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                imagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>
