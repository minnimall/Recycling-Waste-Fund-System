<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">คำร้อง/ข้อร้องเรียน</h2>
            <p class="text-xl opacity-90">เสียงของประชาชนคือสิ่งสำคัญสำหรับเรา</p>
        </div>
    </section>

    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <div class="mt-5 mb-5 bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-primary-green to-secondary-green text-white p-6">
                        <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                            <h2 class="text-2xl font-bold">ฟอร์มกรอกข้อมูลเบื้องต้น</h2>
                            <div class="flex items-center gap-2">
                                <p id="time" class="block text-white text-sm mb-2">วันที่ <span id="date-time"></span></p>
                            </div>
                        </div>
                    </div>

                <div class="bg-white rounded-lg shadow-md p-6">
                    <form id="complaint-form" action="/user/complaintPost" method="POST" enctype="multipart/form-data" class="space-y-6">
                        <input type="hidden" name="username" value="<%= session.username %>">

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">ประเภทข้อร้องเรียน <span class="text-red-500">*</span></label>
                            <select name="category" required 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent">
                                <option value="">เลือกประเภทข้อร้องเรียน</option>
                                <option value="waste">การจัดการขยะ</option>
                                <option value="service">การบริการของเจ้าหน้าที่</option>
                                <option value="noise">เสียงรบกวน</option>
                                <option value="sale">การขายขยะ</option>
                                <option value="other">อื่นๆ</option>
                            </select>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">รายละเอียดข้อร้องเรียน <span class="text-red-500">*</span></label>
                            <textarea name="complaintMessage" required rows="6" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent"
                                placeholder="กรอกรายละเอียดปัญหาให้ชัดเจน เช่น สถานที่เกิดเหตุ วันเวลา และสาเหตุ"></textarea>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">อัปโหลดรูปภาพ</label>
                            
                            <input type="file" id="image" name="image" accept="image/*" class="hidden">

                            <!-- Upload Zone -->
                            <div id="uploadZone"
                                class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                                <i class="fas fa-cloud-upload-alt text-gray-400 text-4xl mb-3"></i>
                                <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG (ไม่เกิน 5MB)</p>
                            </div>

                            <!-- Image Preview -->
                            <div id="imagePreview" class="hidden">
                                <!-- ปุ่มเปลี่ยนรูป -->
                                <button type="button" id="changeImgBtn"
                                    class="w-full mb-2 py-2 border-2 border-dashed border-gray-300 rounded-lg text-gray-500 hover:border-green-400 hover:text-green-500 transition flex items-center justify-center gap-2">
                                    <i class="fas fa-sync-alt text-sm"></i>
                                    <span class="text-sm">เปลี่ยนรูปภาพ</span>
                                </button>
                                <!-- Preview รูป -->
                                <div id="previewGrid" class="grid grid-cols-1 gap-2"></div>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4">
                            <button type="submit" 
                                class="flex-1 bg-primary-green text-white py-3 px-6 rounded-lg font-semibold hover:bg-secondary-green transition-colors">
                                ส่งข้อร้องเรียน
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/userPartials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        //แสดงวัน
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>
    <script>
        const imageInput  = document.getElementById('image');
        const uploadZone  = document.getElementById('uploadZone');
        const imgPreview  = document.getElementById('imagePreview');
        const previewGrid = document.getElementById('previewGrid');
        const changeBtn   = document.getElementById('changeImgBtn');

        // คลิก zone หรือปุ่มเปลี่ยน → เปิด file picker
        uploadZone.addEventListener('click', () => imageInput.click());
        changeBtn.addEventListener('click', () => imageInput.click());

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            // ตรวจขนาด
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({ icon: 'error', title: 'ไฟล์ใหญ่เกินไป', text: 'ขนาดไฟล์ต้องไม่เกิน 5MB' });
                return;
            }

            // ตรวจประเภท
            if (!['image/png', 'image/jpeg', 'image/gif'].includes(file.type)) {
                Swal.fire({ icon: 'error', title: 'ประเภทไฟล์ไม่ถูกต้อง', text: 'รองรับเฉพาะ PNG, JPG, GIF' });
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                // ล้าง grid เก่าก่อน (รูปเดียว)
                previewGrid.innerHTML = '';

                const wrapper = document.createElement('div');
                wrapper.className = 'relative group';

                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = file.name;
                img.className = 'w-full h-96 object-cover rounded-lg border-2 border-gray-300';

                // ป้ายชื่อไฟล์
                const label = document.createElement('div');
                label.className = 'mt-1 text-xs text-gray-500 truncate px-1';
                label.textContent = file.name;

                // ปุ่มลบ
                const deleteBtn = document.createElement('button');
                deleteBtn.type = 'button';
                deleteBtn.className = 'absolute top-2 right-2 bg-red-500 text-white rounded-full w-7 h-7 text-xs opacity-0 group-hover:opacity-100 transition flex items-center justify-center shadow';
                deleteBtn.innerHTML = '✕';
                deleteBtn.addEventListener('click', () => {
                    imageInput.value = '';
                    imgPreview.classList.add('hidden');
                    uploadZone.classList.remove('hidden');
                    previewGrid.innerHTML = '';
                });

                wrapper.appendChild(img);
                wrapper.appendChild(deleteBtn);
                previewGrid.appendChild(wrapper);
                previewGrid.appendChild(label);

                uploadZone.classList.add('hidden');
                imgPreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });
    </script>
</body>
</html>
