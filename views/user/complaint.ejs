<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">คำข้อง/ข้อร้องเรียน</h2>
            <p class="text-xl opacity-90">เสียงของประชาชนคือสิ่งสำคัญสำหรับเรา</p>
        </div>
    </section>
    <!-- Complaint Form -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <!-- Form Instructions -->
                <div class="bg-light-green rounded-lg p-6 mb-8">
                    <h3 class="text-xl font-semibold text-primary-green mb-4">คำแนะนำในการส่งข้อร้องเรียน</h3>
                    <ul class="text-gray-700 space-y-2">
                        <li>• กรุณากรอกข้อมูลให้ครบถ้วนและถูกต้อง</li>
                        <li>• ระบุรายละเอียดปัญหาให้ชัดเจน</li>
                        <li>• แนบหลักฐานประกอบ (ถ้ามี)</li>
                        <li>• ระบุที่อยู่ติดต่อกลับให้ถูกต้อง</li>
                        <li>• เจ้าหนาที่จะติดต่อกลับภายใน 7 วันทำการ</li>
                    </ul>
                </div>

                <!-- Complaint Form -->
                <div class="bg-white rounded-lg shadow-md p-8">
                    <form id="complaint-form">
                        <div class="grid md:grid-cols-2 gap-6 mb-6">
                            <!-- Personal Information -->
                            <div>
                                <label class="block text-gray-700 font-semibold mb-2">ชื่อ-นามสกุล *</label>
                                <input type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกชื่อ-นามสกุล">
                            </div>
                            <div>
                                <label class="block text-gray-700 font-semibold mb-2">เบอร์โทรศัพท์ *</label>
                                <input type="tel" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกเบอร์โทรศัพท์">
                            </div>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">อีเมล</label>
                            <input type="email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกอีเมล (ไม่บังคับ)">
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">ที่อยู่ *</label>
                            <textarea required rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกที่อยู่ที่สามารถติดต่อกลับได้"></textarea>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">ประเภทข้อร้องเรียน *</label>
                            <select required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent">
                                <option value="">เลือกประเภทข้อร้องเรียน</option>
                                <option value="waste">การจัดการขยะ</option>
                                <option value="road">ถนน/ทางเดิน</option>
                                <option value="water">น้ำประปา/ระบายน้ำ</option>
                                <option value="electricity">ไฟฟ้าสาธารณะ</option>
                                <option value="noise">เสียงรบกวน</option>
                                <option value="environment">สิ่งแวดล้อม</option>
                                <option value="service">การบริการของเจ้าหน้าที่</option>
                                <option value="other">อื่นๆ</option>
                            </select>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">หัวข้อเรื่อง *</label>
                            <input type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกหัวข้อเรื่องที่ต้องการร้องเรียน">
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">รายละเอียดข้อร้องเรียน *</label>
                            <textarea required rows="6" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="กรอกรายละเอียดปัญหาให้ชัดเจน เช่น สถานที่เกิดเหตุ วันเวลา และสาเหตุ"></textarea>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">สถานที่เกิดเหตุ *</label>
                            <input type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent" placeholder="ระบุสถานที่เกิดเหตุให้ชัดเจน">
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">แนบไฟล์หลักฐาน</label>
                            <input type="file" multiple accept="image/*,.pdf,.doc,.docx" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent">
                            <p class="text-sm text-gray-500 mt-2">รองรับไฟล์: รูปภาพ, PDF, Word (ขนาดไม่เกิน 10MB ต่อไฟล์)</p>
                        </div>

                        <div class="mb-6">
                            <label class="block text-gray-700 font-semibold mb-2">ความเร่งด่วน</label>
                            <div class="flex flex-wrap gap-4">
                                <label class="flex items-center">
                                    <input type="radio" name="urgency" value="low" class="text-primary-green focus:ring-primary-green" checked>
                                    <span class="ml-2">ปกติ</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="urgency" value="medium" class="text-primary-green focus:ring-primary-green">
                                    <span class="ml-2">ด่วน</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="urgency" value="high" class="text-primary-green focus:ring-primary-green">
                                    <span class="ml-2">ด่วนมาก</span>
                                </label>
                            </div>
                        </div>

                        <div class="mb-8">
                            <label class="flex items-center">
                                <input type="checkbox" required class="text-primary-green focus:ring-primary-green">
                                <span class="ml-2 text-gray-700">ข้าพเจ้ายืนยันว่าข้อมูลที่กรอกเป็นความจริง และยินยอมให้ อบต. ใช้ข้อมูลเพื่อการติดต่อกลับ</span>
                            </label>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4">
                            <button type="submit" class="flex-1 bg-primary-green text-white py-3 px-6 rounded-lg font-semibold hover:bg-secondary-green transition-colors">
                                ส่งข้อร้องเรียน
                            </button>
                            <button type="reset" class="flex-1 bg-gray-500 text-white py-3 px-6 rounded-lg font-semibold hover:bg-gray-600 transition-colors">
                                ล้างข้อมูล
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Status Check -->
                <div class="bg-white rounded-lg shadow-md p-8 mt-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">ตรวจสอบสถานะข้อร้องเรียน</h3>
                    <p class="text-gray-600 mb-4">กรอกหมายเลขอ้างอิงเพื่อตรวจสอบสถานะการดำเนินการ</p>
                    <div class="flex gap-4">
                        <input type="text" placeholder="กรอกหมายเลขอ้างอิง" class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-green focus:border-transparent">
                        <button class="bg-primary-green text-white px-6 py-3 rounded-lg font-semibold hover:bg-secondary-green transition-colors">
                            ตรวจสอบ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <div class="content">
        <div class="container">
            <div class="mt-5 content-header d-flex justify-content-center align-items-center">
                <h1 class="title">รับคำร้องหรือข้อร้องเรียน</h1>
            </div>
            <div class="mt-5 mb-5 form-saleRequest border rounded p-4 shadow-sm bg-light">
                <div class="mt-2 d-flex justify-content-between align-items-center">
                    <h2>ฟอร์มกรอกข้อมูลเบื้องต้น</h2>
                    <p id="time" class="show-time">วันที่ <span id="date-time"></span></p>
                </div>
                <div>
                    <form id="complaint-form" action="/user/complaintPost" method="POST">
                        <input type="hidden" name="username" value="<%= session.username %>">
                        <div class="mb-3">
                            <label for="complaintMessage" class="form-label">รายละเอียดข้อมูล</label>
                            <textarea class="form-control" id="complaintMessage" name="complaintMessage" placeholder="กรุณากรอกข้อร้องเรียนหรือข้อเสนอแนะของคุณที่นี่..." required rows="10"></textarea>
                        </div>
                        <div class="d-flex">
                            <button type="submit" class="btn btn-success ms-auto">ส่งข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <%- include('../partials/userPartials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        //แสดงวัน
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>
    <script>
        $(document).ready(function() {
            $('#waste').select2({
                placeholder: "เลือกขยะที่ต้องการขาย",
                allowClear: true
            });
        });
        </script>
        
</body>
</html>
