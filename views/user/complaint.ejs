    <script>
        //แสดงวัน
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('date-time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();

