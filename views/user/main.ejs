<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="./img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/style_main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
</head>
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="./img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li class="select"><a href="/">หน้าหลัก</a></li>
                    <li><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li><a href="./after_learning.html">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <section class="mt-3">
                <!-- ส่วนรูปของหน้าหลัก -->
                <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <a href="https://www.khampom.go.th/" target="_blank"><img class="d-block w-100" src="./img/bg_kp.png" alt="พื้นหลัง"></a>
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" src="./img/วิสัยทัศน์.png" alt="พื้นหลัง">
                        </div>
                        <div class="carousel-item">
                            <img class="d-block w-100" src="./img/เก็บภาษีที่ดิน68.png" alt="พื้นหลัง">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev" aria-label="Previous">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next" aria-label="Next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    </button>
                </div>

                <!-- ส่วนข่าวกิจกรรมกับแสดงราคาขยะ -->
                <div class="row">
                    <div class="col-8 mt-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-3 title">ข่าวกิจกรรม</p>
                            </div>
                            <div class="d-flex justify-content-end">
                                <b><a href="/user/allActivity">ดูข่าวกิจกรรมทั้งหมด</a></b>
                            </div>
                        </div>
                        
                        <div class="row">
                            <% if (activity.length=3) {  %>
                                <% activity.forEach(act => { %>
                            <div class="col-4">
                                <a href="/user/detailActivity/<%= act._id %>" class="card-link">
                                <div class="card border-0">
                                    <img class="d-block w-100" src="<%= act.img %>" alt="รูปภาพกิจกรรม">
                                    <div class="card-body">
                                        <p class="card-title"><%= act.title %></p>
                                    </div>
                                </div>
                                </a>
                            </div>
                                <% }) %>
                            <% } else { %>
                                <p>ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                            <% } %>
                        </div>
                    </div>                    
                    <div class="col-4 mt-5">
                        <p class="mb-3 title">ราคากลางรับซื้อขยะ</p>
                        <div class="title-waste d-flex justify-content-between align-items-center">
                            <p>รายการ</p>
                            <p>ราคา/กก.</p>
                        </div>
                        <div class="price-list-container">
                            <% if (waste.length > 0) { %>
                                <% waste.forEach((item, index) => { %>
                            <div class="price-waste d-flex justify-content-between align-items-center">
                                <p class="mt-2"><%= item.wasteName %></p>
                                <p class="mt-2"><%= item.pricePerUnit %></p>
                            </div>
                                <% }); %>
                            <% } else { %>
                                <div>
                                    <span>ยังไม่มีข้อมูล</span>
                                </div>
                            <% } %>
                        </div>
                    </div>

                <!-- ส่วนไอเดียการจัดการขยะ -->
                <div class="row">
                    <div class="col-12 mt-5">
                        <div class="idea">
                            <div class="mb-3 title-idea d-flex justify-content-between align-items-center">
                                <p class="title">ไอเดียการจัดการขยะ</p>
                                <button type="button" class="btn btn-success">เพิ่มไอเดีย</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card border-0">
                            <img class="d-block w-100 card-img-custom" src="/img/shoe_bin.png" alt="พื้นหลัง">
                            <div class="card-body">
                                <p class="card-title">นำขยะมาทำเป็นรองเท้า</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card border-0">
                            <img class="d-block w-100 card-img-custom" src="/img/idea-recycle.png" alt="พื้นหลัง">
                            <div class="card-body">
                                <p class="card-title">กล่องขยะ DIY</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card border-0">
                            <img class="d-block w-100 card-img-custom" src="/img/eco-bricks.png" alt="พื้นหลัง">
                            <div class="card-body">
                                <p class="card-title">อิฐจากขยะพลาสติก</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ส่วนแสดงรอบการรับซื้อ -->
                <div class="row">
                    <div class="col-12 mt-5 mb-3">
                        <div class="round">
                            <div class="mb-3 title-idea d-flex justify-content-between align-items-center">
                                <p class="title">รอบการรับซื้อขยะ</p>
                                <p id="current-time" class="show-time"></p>
                            </div>
                        </div>
                    </div>
                    <div class="col">หมู่ที่ 1</div>
                    <div class="col">หมู่ที่ 2</div>
                    <div class="col">หมู่ที่ 3</div>
                    <div class="col">หมู่ที่ 4</div>
                    <div class="col">หมู่ที่ 5</div>
                    <div class="col">หมู่ที่ 6</div>
                    <div class="col">หมู่ที่ 7</div>
                    <div class="col">หมู่ที่ 8</div>
                    <div class="col">หมู่ที่ 9</div>
                    <div class="col">หมู่ที่ 10</div>
                </div>
                
            </section>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ตรวจสอบ query string ว่ามี error หรือไม่
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');

        // หากมี error ให้แสดง alert
        if (error) {
            alert(error);
        }
    </script>

    <!-- JavaScript สำหรับแสดงวันเวลา -->
    <script>
        function updateTime() {
            const currentDate = new Date(); // ดึงวันและเวลาปัจจุบัน
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit', 
                hour12: true 
            };
            // แปลงเวลาให้อยู่ในรูปแบบที่ต้องการ
            const timeString = currentDate.toLocaleString('th-TH', options);
            // แสดงเวลาในส่วนที่มี id="current-time"
            document.getElementById('current-time').textContent = timeString;
        }

        // เรียกใช้ฟังก์ชัน updateTime ทุกๆ 1 วินาที
        setInterval(updateTime, 1000);

        // เรียกใช้ฟังก์ชัน updateTime ทันทีเมื่อโหลดหน้าเว็บ
        updateTime();
    </script>

    
</body>
</html>
