    const locationItem = document.querySelector(`.location-item[data-id="${locationId}"]`);
    if (locationItem) {
        locationItem.click();
        // Scroll to map on mobile
        if (window.innerWidth < 1024) {
            document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
}
    // เพิ่มในส่วนท้ายของ script ในหน้าแผนที่
    document.addEventListener('DOMContentLoaded', function() {
        // ตรวจสอบว่ามี query parameter wastePoint หรือไม่
        const urlParams = new URLSearchParams(window.location.search);
        const wastePointId = urlParams.get('wastePoint');
        
        if (wastePointId) {
            // หา marker ที่ตรงกับ wastePointId
            const markerData = markers.find(m => m.location._id === wastePointId);
            
            if (markerData) {
                // เลื่อนแผนที่ไปยังตำแหน่งนั้น
                map.setView([markerData.location.latitude, markerData.location.longitude], 16);
                
                // เปิด popup
                setTimeout(() => {
                    markerData.marker.openPopup();
                }, 500);
                
                // Highlight รายการใน sidebar
                const locationItem = document.querySelector(`.location-item[data-id="${wastePointId}"]`);
                if (locationItem) {
                    document.querySelectorAll('.location-item').forEach(i => {
                        i.classList.remove('active', 'border-blue-500', 'bg-blue-50');
                    });
                    locationItem.classList.add('active', 'border-blue-500', 'bg-blue-50');
                    locationItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }
        }
    });

    function focusOnWastePoint(wastePointId) {
        const markerData = markers.find(m => m.location._id === wastePointId);
        
        if (markerData) {
            const mapSection = document.getElementById('mapFocusZone').closest('section');
            
            if (mapSection) {
                const headerHeight = 80;
                const targetPosition = mapSection.offsetTop - headerHeight;
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }
            
            setTimeout(() => {
                map.flyTo([markerData.location.latitude, markerData.location.longitude], 17, {
                    animate: true,
                    duration: 1.5,
                    easeLinearity: 0.25
                });
                
                setTimeout(() => {
                    markerData.marker.openPopup();
                }, 1600);
                
                const locationItem = document.querySelector(`.location-item[data-id="${wastePointId}"]`);
                if (locationItem) {
                    document.querySelectorAll('.location-item').forEach(i => {
                        i.classList.remove('active', 'border-blue-500', 'bg-blue-50');
                    });
                    locationItem.classList.add('active', 'border-blue-500', 'bg-blue-50');
                    
                    const locationList = document.getElementById('location-list');
                    if (locationList) {
                        setTimeout(() => {
                            const listScrollTop = locationList.scrollTop;
                            const itemOffsetTop = locationItem.offsetTop;
                            const listHeight = locationList.clientHeight;
                            const itemHeight = locationItem.clientHeight;
                            
                            const targetScroll = itemOffsetTop - (listHeight / 2) + (itemHeight / 2);
                            
                            locationList.scrollTo({
                                top: targetScroll,
                                behavior: 'smooth'
                            });
                        }, 500);
                    }
                }
            }, 600);
            
        } else {
            console.warn('ไม่พบจุดรับซื้อขยะที่ระบุ');
            alert('ไม่พบตำแหน่งจุดรับซื้อขยะบนแผนที่');
        }
    }
</script>

<script>
    function openFileViewerUser(url, title) {
        const isPDF = url.toLowerCase().includes('raw/upload');
        if (isPDF) {
            openPDFModal(url, title);
        } else {
            openImageModal(url, title);
        }
    }

    function openFileViewerUser(url, title) {
        const isPDF = url.toLowerCase().includes('.pdf') || url.includes('/raw/');
        if (isPDF) {
            openPDFModal(url, title);
        } else {
            openImageModal(url, title);
        }
    }

    function openPDFModal(url, title) {
        const modal = document.getElementById('pdfViewerModal');
        const iframe = document.getElementById('pdfFrame');
        document.getElementById('pdfTitle').textContent = title;

        // ✅ ผูกปุ่มดาวน์โหลดกับ url และ title
        document.getElementById('pdfDownloadBtn').onclick = () => downloadPDF(url, title);

        const pdfViewerUrl = `https://mozilla.github.io/pdf.js/web/viewer.html?file=${encodeURIComponent(url)}`;
        iframe.src = pdfViewerUrl;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closePDFModal() {
        document.getElementById('pdfViewerModal').classList.add('hidden');
        document.getElementById('pdfFrame').src = '';
        document.body.style.overflow = 'auto';
    }

    function openImageModal(url, title) {
        const modal = document.getElementById('imageViewerModal');
        document.getElementById('imageTitle').textContent = title;
        document.getElementById('imageViewerContent').src = url;
        currentImageUrl = url;
        currentImageTitle = title;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeImageViewerModal() {
        document.getElementById('imageViewerModal').classList.add('hidden');
        document.getElementById('imageViewerContent').src = '';
        document.body.style.overflow = 'auto';
        currentImageUrl = '';
        currentImageTitle = '';
    }

    let currentImageUrl = '';
    let currentImageTitle = '';

    async function downloadCurrentImage() {
        if (!currentImageUrl) return;
        try {
            Swal.fire({ title: 'กำลังดาวน์โหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            const response = await fetch(currentImageUrl);
            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = downloadUrl;
            const ext = currentImageUrl.split('.').pop().split('?')[0];
            link.download = (currentImageTitle || 'document') + '.' + ext;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(downloadUrl);
            Swal.close();
            Swal.fire({ icon: 'success', title: 'สำเร็จ', text: 'ดาวน์โหลดเรียบร้อย', timer: 2000, showConfirmButton: false });
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถดาวน์โหลดได้', 'error');
        }
    }

    async function downloadPDF(url, filename) {
        try {
            Swal.fire({ title: 'กำลังดาวน์โหลด...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            const response = await fetch(url);
            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = filename + '.pdf';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(downloadUrl);
            Swal.close();
            Swal.fire({ icon: 'success', title: 'สำเร็จ', text: 'ดาวน์โหลดไฟล์เรียบร้อย', timer: 2000, showConfirmButton: false });
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถดาวน์โหลดไฟล์ได้', 'error');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('pdfViewerModal')?.addEventListener('click', function(e) {
            if (e.target === this) closePDFModal();
        });
        document.getElementById('imageViewerModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeImageViewerModal();
        });
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (!document.getElementById('pdfViewerModal')?.classList.contains('hidden')) closePDFModal();
            if (!document.getElementById('imageViewerModal')?.classList.contains('hidden')) closeImageViewerModal();
        }
    });
</script>

</body>
</html>
