                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div> -->
            </section>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        if (error) {
            alert(error);
        }
    </script>

    <!-- JavaScript สำหรับแสดงวันเวลา -->
    <script>
        function updateTime() {
            const currentDate = new Date(); // ดึงวันและเวลาปัจจุบัน
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit', 
                hour12: true 
            };
            // แปลงเวลาให้อยู่ในรูปแบบที่ต้องการ
            const timeString = currentDate.toLocaleString('th-TH', options);
            // แสดงเวลาในส่วนที่มี id="current-time"
            document.getElementById('current-time').textContent = timeString;
            document.getElementById('time').textContent = timeString;
        }

        // เรียกใช้ฟังก์ชัน updateTime ทุกๆ 1 วินาที
        setInterval(updateTime, 1000);

        // เรียกใช้ฟังก์ชัน updateTime ทันทีเมื่อโหลดหน้าเว็บ
        updateTime();
    </script>

    <script>
        function updateTime() {
            const currentDate = new Date();
            const options = { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour12: true 
            };
            const timeString = currentDate.toLocaleString('th-TH', options);
            document.getElementById('time').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();
    </script>

    
</body>
</html>
