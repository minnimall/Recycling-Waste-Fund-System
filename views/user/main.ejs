    <div id="pdf-modal" class="fixed inset-0 bg-black bg-opacity-75 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-lg max-w-4xl w-full h-[90vh] overflow-hidden">
                <div class="flex justify-between items-center p-4 border-b">
                    <div class="w-full max-w-[650px]">
                        <h3 id="pdf-title" class="text-lg font-semibold truncate">เอกสาร PDF</h3>
                    </div>
                    <div class="flex items-center space-x-3">
                        <button id="download-pdf" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                            <i class="fas fa-download mr-2"></i>ดาวน์โหลด
                        </button>
                        <button id="close-pdf-modal" class="text-gray-500 hover:text-gray-700">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                </div>
                <div class="h-full bg-gray-100 flex items-center justify-center">
                    <iframe id="frame" class="w-full h-full" frameborder="0"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // PDF Modal functionality
        function openPDF(title, fileUrl) {
            const pdfModal = document.getElementById('pdf-modal');
            const pdfTitle = document.getElementById('pdf-title');
            const downloadBtn = document.getElementById('download-pdf');
            const iframe = document.getElementById('frame');

            // ตั้งชื่อหัวเรื่อง
            pdfTitle.textContent = title;

            // แสดง PDF ใน iframe
            iframe.src = `${fileUrl}`; // หรือใช้ fileUrl ตรง ๆ ถ้าเป็น path เต็ม

            // แสดง modal
            pdfModal.classList.remove('hidden');

            // ฟังก์ชันดาวน์โหลด
            downloadBtn.onclick = function () {
                const a = document.createElement('a');
                a.href = `${fileUrl}`; // หรือใช้ fileUrl ตรง ๆ เช่น https://...
                a.download = fileUrl;
                a.style.display = 'none';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            };
        }

        // Close PDF modal
        document.getElementById('close-pdf-modal').addEventListener('click', () => {
            document.getElementById('pdf-modal').classList.add('hidden');
        });

        // Close modal when clicking outside
        document.getElementById('pdf-modal').addEventListener('click', (e) => {
            if (e.target.id === 'pdf-modal') {
                document.getElementById('pdf-modal').classList.add('hidden');
            }
        });
    </script>

