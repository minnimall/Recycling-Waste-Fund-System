    <!-- Waste Price Section -->
    <section class="py-16 bg-primary-green">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h3 class="text-3xl font-bold text-white mb-4">ราคากลางรับซื้อขยะรีไซเคิล</h3>
                <p class="text-white opacity-90 max-w-2xl mx-auto">
                    ราคาอัปเดตล่าสุด <%= moment(latestPriceUpdateDate).locale('th').format('D MMMM YYYY') %>
                </p>
                <div class="inline-flex items-center bg-white bg-opacity-20 rounded-full px-4 py-2 mt-4">
                    <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse mr-2"></div>
                    <span class="text-white text-sm">อัปเดตแบบเรียลไทม์</span>
                </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 px-4">
                <% if (waste.length >= 4) { %>
                    <% waste.slice(0, 4).forEach((item) => { %>
                        <div class="bg-white rounded-lg p-6 shadow-lg hover:shadow-xl transition-shadow">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center">
                                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4 class="font-semibold text-gray-800"><%= item.wasteName %></h4>
                                        <p class="text-sm text-gray-500"><%= item.wasteType.wasteTypeName %></p>
                                    </div>
                                </div>

                                <!-- ไอคอนขึ้นลง -->
                                <div class="flex items-center px-2 py-1 rounded-full text-xs font-semibold
                                    <% if (item.changeDirection === 'up') { %> bg-green-100 text-green-800
                                    <% } else if (item.changeDirection === 'down') { %> bg-red-100 text-red-800
                                    <% } else { %> bg-gray-100 text-gray-800 <% } %>">

                                    <% if (item.changeDirection === 'up') { %>
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M5 10l7-7m0 0l7 7m-7-7v18" />
                                        </svg>
                                    <% } else if (item.changeDirection === 'down') { %>
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                                        </svg>
                                    <% } %>

                                    <% if (item.priceChange !== null && item.percentChange !== null) { %>
                                        <%= item.priceChange > 0 ? '+' : '' %> (<%= item.percentChange.toFixed(2) %>%)
                                    <% } else { %>
                                        -
                                    <% } %>
                                </div>
                            </div>

                            <div class="text-center">
                                <div class="text-3xl font-bold text-primary-green mb-1"><%= item.pricePerUnit %></div>
                                <div class="text-sm text-gray-500">บาท/กิโลกรัม</div>
                                <div class="text-xs mt-2
                                    <% if (item.changeDirection === 'up') { %> text-green-600
                                    <% } else if (item.changeDirection === 'down') { %> text-red-600
                                    <% } else { %> text-gray-400 <% } %>">
                                    <% if (item.percentChange !== null) { %>
                                        <%= item.changeDirection === 'up' ? 'เพิ่มขึ้น' : 'ลดลง' %> <%= item.percentChange.toFixed(2) %>%
                                    <% } else { %> ไม่มีการเปลี่ยนแปลง <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                    <% } else { %>
                    <div>
                        <span>ยังไม่มีข้อมูล</span>
                    </div>
                <% } %>
            </div>

            <!-- Additional Waste Types -->
            <div class="grid md:grid-cols-3 lg:grid-cols-6 gap-4 mt-8 px-4">
                <% if (waste.length >= 11) { %>
                    <% waste.slice(5, 11).forEach((item) => { %>
                        <div class="bg-white bg-opacity-10 rounded-lg p-4 text-center">
                            <h5 class="text-white font-semibold mb-1"><%= item.wasteName %></h5>
                            <div class="text-2xl font-bold text-white"><%= item.pricePerUnit %></div>

                            <% if (item.percentChange !== null) { %>
                                <div class="text-xs
                                    <% if (item.changeDirection === 'up') { %> text-green-300
                                    <% } else if (item.changeDirection === 'down') { %> text-red-300
                                    <% } else { %> text-gray-300 <% } %>">
                                    <%= item.changeDirection === 'up' ? '+' : '' %><%= item.priceChange.toFixed(2) %>
                                    (<%= item.percentChange.toFixed(2) %>%)
                                </div>
                            <% } else { %>
                                <div class="text-xs text-gray-300">-</div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div>
                        <span class="text-white">ยังไม่มีข้อมูล</span>
                    </div>
                <% } %>
            </div>

            <!-- Price Update Info -->
            <div class="mt-12 bg-white bg-opacity-10 rounded-lg p-6 px-4">
                <div class="flex flex-col md:flex-row items-center justify-between">
                    <div class="text-white mb-4 md:mb-0">
                        <h4 class="font-semibold mb-2">หมายเหตุ</h4>
                        <p class="text-sm opacity-90">• ราคารับซื้อวัสดุรีไซเคิลอาจมีการเปลี่ยนแปลงไปตามผู้ประกอบการแจ้ง</p>
                        <!-- <p class="text-sm opacity-90">• ราคาอาจแตกต่างกันตามคุณภาพและปริมาณ</p> -->
                        <p class="text-sm opacity-90">• สอบถามข้อมูลเพิ่มเติม อบต.ขามป้อม โทร 0-4330-6526 ต่อ 1</p>
                    </div>
                    <div class="flex flex-col items-center">
                        <a href="/user/wastePrices" class="bg-white text-primary-green px-6 py-3 rounded-lg font-semibold mb-2">
                            ดูราคาขยะเพิ่มเติม
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

