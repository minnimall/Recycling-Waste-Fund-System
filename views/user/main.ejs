    <!-- News & Announcements Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">ข่าวประชาสัมพันธ์</h2>
                <p class="text-gray-600">ข่าวสารและประกาศสำคัญจากองค์การบริหารส่วนตำบลขามป้อม</p>
            </div>

            <div class="grid lg:grid-cols-3 gap-8">
                <!-- Latest News -->
                <div class="lg:col-span-2">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-semibold text-gray-800">ข่าวล่าสุด</h3>
                        <a href="news.html" class="text-primary hover:text-primary-dark transition-colors">
                            ดูทั้งหมด <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>

                    <div class="space-y-6">
                        <!-- News Item 1 -->
                        <% if (news.length = 4) { %>
                            <% news.forEach((item, index) => { %>
                        <div class="bg-gray-50 rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow">
                            <div class="flex items-start space-x-4">
                                <img src="/placeholder.svg?height=80&width=120" alt="ข่าวประชาสัมพันธ์" class="w-20 h-20 object-cover rounded-lg flex-shrink-0">
                                <div class="flex-1">
                                    <div class="flex items-center space-x-2 mb-2">
                                        <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">ข้อมูล</span>
                                        <span class="text-sm text-gray-500">วันที่: <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('th-TH') : 'ไม่ระบุ' %></span>
                                    </div>
                                    <h4 class="font-semibold text-gray-800 mb-2 hover:text-primary cursor-pointer">
                                        <%= item.newsTitle %>
                                    </h4>
                                    <p class="text-gray-600 text-sm mb-3">
                                        <%= item.newsDescription %>
                                    </p>
                                    <!-- <div class="flex items-center space-x-4 text-sm text-gray-500">
                                        <span><i class="fas fa-eye mr-1"></i>234 ครั้ง</span>
                                        <span><i class="fas fa-comment mr-1"></i>12 ความคิดเห็น</span>
                                    </div> -->
                                </div>
                            </div>
                        </div>

                            <% }); %>
                        <% } else { %>
                            <div class="empty-state p-4 text-center">
                                <div class="empty-icon mb-3">
                                    <i class="fas fa-inbox fa-3x text-muted"></i>
                                </div>
                                <h6 class="text-muted"><%= item.newsTitle %></h6>
                                <p class="small text-muted mb-0"><%= item.newsDescription %></p>
                            </div>
                        <% } %>

                    </div>
                </div>

                <!-- Documents & PDFs -->
                <div class="lg:col-span-1">
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-xl font-semibold text-gray-800">เอกสารสำคัญ</h3>
                            <i class="fas fa-file-pdf text-red-500 text-xl"></i>
                        </div>

                        <div class="space-y-4">
                        <!-- PDF Document 1 -->
                        <% if (news.length = 5) { %>
                            <% news.forEach((item, index) => { %>
