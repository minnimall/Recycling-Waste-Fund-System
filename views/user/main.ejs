                            </div>
                        </div> -->
                        
                        <!-- Location List -->
                        <div id="location-list" class="space-y-3 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
                            <% if (wastePoints.length > 0) { %>
                                <% wastePoints.forEach((wastePoint, index) => { %>
                                    <div class="location-item border-2 border-gray-200 rounded-lg p-4 hover:shadow-md hover:border-blue-400 transition-all cursor-pointer group" 
                                        data-id="<%= wastePoint._id %>">
                                        <div class="flex items-start space-x-3">
                                            <!-- Icon -->
                                            <div class="flex-shrink-0">
                                                <div class="w-12 h-12 rounded-full flex items-center justify-center text-white shadow-md
                                                    <% if (wastePoint.type === 'bank') { %> bg-blue-500
                                                    <% } else if (wastePoint.type === 'center') { %> bg-green-500
                                                    <% } else if (wastePoint.type === 'community') { %> bg-purple-500
                                                    <% } else if (wastePoint.type === 'mobile') { %> bg-orange-500
                                                    <% } else { %> bg-gray-500
                                                    <% } %> group-hover:scale-110 transition-transform">
                                                    
                                                    <% if (wastePoint.type === 'bank') { %>
                                                        <i class="fas fa-piggy-bank"></i>
                                                    <% } else if (wastePoint.type === 'center') { %>
                                                        <i class="fas fa-building"></i>
                                                    <% } else if (wastePoint.type === 'community') { %>
                                                        <i class="fas fa-users"></i>
                                                    <% } else if (wastePoint.type === 'mobile') { %>
                                                        <i class="fas fa-truck"></i>
                                                    <% } else { %>
                                                        <i class="fas fa-map-marker-alt"></i>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <!-- Content -->
                                            <div class="flex-1 min-w-0">
                                                <!-- Title -->
                                                <h4 class="font-semibold text-gray-800 group-hover:text-blue-600 transition-colors truncate mb-1">
                                                    <%= wastePoint.wastePointName %>
                                                </h4>

                                                <!-- Type & Status Badges -->
                                                <div class="flex items-center gap-2 mb-2 flex-wrap">
                                                    <span class="text-xs px-2 py-1 rounded-full font-medium
                                                        <% if (wastePoint.type === 'bank') { %> bg-blue-100 text-blue-700
                                                        <% } else if (wastePoint.type === 'center') { %> bg-green-100 text-green-700
                                                        <% } else if (wastePoint.type === 'community') { %> bg-purple-100 text-purple-700
                                                        <% } else if (wastePoint.type === 'mobile') { %> bg-orange-100 text-orange-700
                                                        <% } else { %> bg-gray-100 text-gray-700
                                                        <% } %>">
                                                        <% if (wastePoint.type === 'bank') { %>
                                                            ธนาคารขยะ
                                                        <% } else if (wastePoint.type === 'center') { %>
                                                            ศูนย์รับซื้อ
                                                        <% } else if (wastePoint.type === 'community') { %>
                                                            จุดชุมชน
                                                        <% } else if (wastePoint.type === 'mobile') { %>
                                                            รถเคลื่อนที่
                                                        <% } else { %>
                                                            อื่นๆ
                                                        <% } %>
                                                    </span>

                                                    <!-- <span class="text-xs px-2 py-1 rounded-full font-medium flex items-center gap-1
                                                        <%= wastePoint.isOpen ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                                        <span class="w-1.5 h-1.5 rounded-full <%= wastePoint.isOpen ? 'bg-green-500' : 'bg-red-500' %>"></span>
                                                        <%= wastePoint.isOpen ? 'เปิด' : 'ปิด' %>
                                                    </span> -->
                                                </div>

                                                <!-- Details - แสดงเฉพาะข้อมูลพื้นฐาน -->
                                                <div class="space-y-1 text-sm text-gray-600">
                                                    <!-- Village (ถ้ามี) -->
                                                    <% if (wastePoint.village) { %>
                                                    <div class="flex items-center gap-2">
                                                        <i class="fas fa-home w-4 text-gray-400"></i>
                                                        <span class="truncate"><%= wastePoint.village.villageName %></span>
                                                    </div>
                                                    <% } %>

                                                    <!-- Location -->
                                                    <div class="flex items-center gap-2">
                                                        <i class="fas fa-map-marker-alt w-4 text-gray-400"></i>
                                                        <span class="truncate text-xs"><%= wastePoint.location %></span>
                                                    </div>

                                                    <!-- Note (ถ้ามี) -->
                                                    <% if (wastePoint.note) { %>
                                                    <div class="flex items-start gap-2 mt-2 pt-2 border-t border-gray-100">
                                                        <i class="fas fa-info-circle w-4 text-blue-400 mt-0.5"></i>
                                                        <span class="text-xs text-gray-600 line-clamp-2"><%= wastePoint.note %></span>
                                                    </div>
                                                    <% } %>
                                                </div>

                                                <!-- Action Button -->
                                                <div class="mt-3 pt-3 border-t border-gray-100">
                                                    <button onclick="viewOnMap('<%= wastePoint._id %>'); event.stopPropagation();" 
                                                            class="w-full bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-3 py-2 rounded-lg text-sm font-medium transition shadow-sm hover:shadow-md">
                                                        <i class="fas fa-map-marker-alt mr-2"></i>ดูบนแผนที่
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <!-- Empty State -->
                                <div class="text-center py-12">
                                    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <i class="fas fa-map-marked-alt text-gray-400 text-3xl"></i>
                                    </div>
                                    <h4 class="text-gray-600 font-semibold mb-2">ยังไม่มีจุดรับซื้อขยะ</h4>
                                    <p class="text-gray-500 text-sm">กรุณาติดต่อเจ้าหน้าที่เพื่อเพิ่มจุดรับซื้อขยะ</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Legend -->
                        <% if (wastePoints.length > 0) { %>
                        <div class="mt-4 pt-4 border-t border-gray-200">
                            <h4 class="text-xs font-semibold text-gray-600 mb-3">สัญลักษณ์บนแผนที่</h4>
                            <div class="grid grid-cols-2 gap-2">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center shadow">
                                        <i class="fas fa-piggy-bank text-white text-xs"></i>
                                    </div>
                                    <span class="text-xs text-gray-600">ธนาคารขยะ</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center shadow">
                                        <i class="fas fa-building text-white text-xs"></i>
                                    </div>
                                    <span class="text-xs text-gray-600">ศูนย์รับซื้อ</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center shadow">
                                        <i class="fas fa-users text-white text-xs"></i>
                                    </div>
                                    <span class="text-xs text-gray-600">จุดชุมชน</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 bg-orange-500 rounded-full flex items-center justify-center shadow">
                                        <i class="fas fa-truck text-white text-xs"></i>
                                    </div>
                                    <span class="text-xs text-gray-600">รถเคลื่อนที่</span>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Map Container -->
                <div class="lg:col-span-3">
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                        <div class="p-4 border-b border-gray-200">
                            <div class="flex justify-between items-center">
                                <h3 class="text-lg font-semibold text-gray-800">
                                    <!-- <i class="fas fa-map-marked-alt mr-2 text-green-600"></i> -->
                                    แผนที่จุดรับซื้อขยะ
                                </h3>
                                <div class="flex space-x-2">
                                    <button id="map-view-btn" class="bg-primary text-white px-3 py-2 rounded-lg text-sm font-medium transition">
                                        <i class="fas fa-map mr-1"></i>แผนที่
                                    </button>
                                    <button id="satellite-view-btn" class="bg-gray-200 text-gray-700 px-3 py-2 rounded-lg text-sm hover:bg-gray-300 transition font-medium">
                                        <i class="fas fa-satellite mr-1"></i>ดาวเทียม
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="map" class="h-96 lg:h-[600px] z-10 relative"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    

    <%- include('../partials/userPartials/footer.ejs') %>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        if (error) {
            alert(error);
        }
        // โหลดข้อมูลจุดรับซื้อขยะจาก Server
        const locations = <%- JSON.stringify(wastePoints) %>;

        console.log('จำนวนจุดรับซื้อขยะ:', locations.length);

        // Initialize map - ตั้งจุดเริ่มต้นที่ อบต.ขามป้อม
        const initialLat = 15.948741697876695;
        const initialLng = 102.85523133360921;

        const map = L.map('map').setView([initialLat, initialLng], 13);

        // Add tile layer (แผนที่)
        let currentTileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // กำหนด Custom icons ตามประเภทจุดรับซื้อ
        const icons = {
            bank: L.divIcon({
                html: '<i class="fas fa-piggy-bank text-white"></i>',
                iconSize: [35, 35],
                className: 'custom-div-icon bg-blue-500 rounded-full flex items-center justify-center shadow-lg'
            }),
            center: L.divIcon({
                html: '<i class="fas fa-building text-white"></i>',
                iconSize: [35, 35],
                className: 'custom-div-icon bg-green-500 rounded-full flex items-center justify-center shadow-lg'
            }),
            community: L.divIcon({
                html: '<i class="fas fa-users text-white"></i>',
                iconSize: [35, 35],
                className: 'custom-div-icon bg-purple-500 rounded-full flex items-center justify-center shadow-lg'
            }),
            mobile: L.divIcon({
                html: '<i class="fas fa-truck text-white"></i>',
                iconSize: [35, 35],
                className: 'custom-div-icon bg-orange-500 rounded-full flex items-center justify-center shadow-lg'
            }),
            user: L.divIcon({
                html: '<i class="fas fa-user text-white"></i>',
                iconSize: [30, 30],
                className: 'custom-div-icon bg-red-500 rounded-full flex items-center justify-center shadow-lg animate-pulse'
            })
        };

        // ฟังก์ชันแปลงประเภทเป็นภาษาไทย
        function getTypeText(type) {
            const types = {
                'bank': 'ธนาคารขยะ',
                'center': 'ศูนย์รับซื้อขยะรีไซเคิล',
                'community': 'จุดรับซื้อชุมชน',
                'mobile': 'รถรับซื้อเคลื่อนที่'
            };
            return types[type] || type;
        }

        // เพิ่ม Markers ลงบนแผนที่
        const markers = [];

        if (locations && locations.length > 0) {
            locations.forEach(location => {
                // ตรวจสอบว่ามี latitude และ longitude
                if (!location.latitude || !location.longitude) {
                    console.warn('ไม่พบพิกัดของ:', location.wastePointName);
                    return;
                }

                // สร้าง marker
                const marker = L.marker([location.latitude, location.longitude], {
                    icon: icons[location.type] || icons.community
                }).addTo(map);

                // สร้าง Popup แบบเรียบง่าย
                const popupContent = `
                    <div class="popup-wrapper" style="min-width: 280px; max-width: 320px;">
                        <!-- Header -->
                        <div class="popup-header" style="
                            background: linear-gradient(135deg, 
                                ${location.type === 'bank' ? '#3b82f6, #2563eb' : 
                                location.type === 'center' ? '#10b981, #059669' :
                                location.type === 'community' ? '#8b5cf6, #7c3aed' :
                                location.type === 'mobile' ? '#f59e0b, #d97706' : '#6b7280, #4b5563'}
                            );
                            padding: 1rem;
                            border-radius: 12px 12px 0 0;
                            color: white;
                        ">
                            <div style="display: flex; align-items: start; gap: 0.75rem;">
                                <div style="
                                    width: 48px;
                                    height: 48px;
                                    background: rgba(255, 255, 255, 0.2);
                                    backdrop-filter: blur(10px);
                                    border-radius: 12px;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    font-size: 1.5rem;
                                    flex-shrink: 0;
                                ">
                                    ${location.type === 'bank' ? '<i class="fas fa-piggy-bank"></i>' :
                                    location.type === 'center' ? '<i class="fas fa-building"></i>' :
                                    location.type === 'community' ? '<i class="fas fa-users"></i>' :
                                    location.type === 'mobile' ? '<i class="fas fa-truck"></i>' :
                                    '<i class="fas fa-map-marker-alt"></i>'}
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <h4 style="font-weight: 700; font-size: 1.125rem; margin: 0 0 0.5rem 0; line-height: 1.3;">
                                        ${location.wastePointName}
                                    </h4>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                        <span style="
                                            background: rgba(255, 255, 255, 0.25);
                                            backdrop-filter: blur(10px);
                                            padding: 0.25rem 0.625rem;
                                            border-radius: 9999px;
                                            font-size: 0.75rem;
                                            font-weight: 600;
                                        ">
                                            ${getTypeText(location.type)}
                                        </span>
                                        <span style="
                                            background: ${location.isOpen ? 'rgba(16, 185, 129, 0.9)' : 'rgba(239, 68, 68, 0.9)'};
                                            padding: 0.25rem 0.625rem;
                                            border-radius: 9999px;
                                            font-size: 0.75rem;
                                            font-weight: 600;
                                            display: flex;
                                            align-items: center;
                                            gap: 0.25rem;
                                        ">
                                            <span style="
                                                width: 6px;
                                                height: 6px;
                                                background: white;
                                                border-radius: 50%;
                                                display: inline-block;
                                            "></span>
                                            ${location.isOpen ? 'เปิดบริการ' : 'ปิดชั่วคราว'}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Body -->
                        <div style="padding: 1rem; background: white;">
                            <div style="display: grid; gap: 0.75rem;">
                                <!-- Village -->
                                ${location.village ? `
                                <div style="display: flex; gap: 0.75rem; align-items: center;">
                                    <div style="
                                        width: 36px;
                                        height: 36px;
                                        background: #f3f4f6;
                                        border-radius: 8px;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        flex-shrink: 0;
                                        color: #6b7280;
                                    ">
                                        <i class="fas fa-home"></i>
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <p style="font-size: 0.75rem; color: #9ca3af; margin: 0 0 0.125rem 0; font-weight: 500;">
                                            หมู่บ้าน
                                        </p>
                                        <p style="font-size: 0.875rem; color: #1f2937; margin: 0; font-weight: 600;">
                                            ${location.village.villageName}
                                        </p>
                                    </div>
                                </div>
                                ` : ''}

                                <!-- Location -->
                                <div style="display: flex; gap: 0.75rem; align-items: center;">
                                    <div style="
                                        width: 36px;
                                        height: 36px;
                                        background: #dbeafe;
                                        border-radius: 8px;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        flex-shrink: 0;
                                        color: #2563eb;
                                    ">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <p style="font-size: 0.75rem; color: #9ca3af; margin: 0 0 0.125rem 0; font-weight: 500;">
                                            ที่อยู่
                                        </p>
                                        <p style="font-size: 0.75rem; color: #1f2937; margin: 0; line-height: 1.4;">
                                            ${location.location}
                                        </p>
                                    </div>
                                </div>

                                <!-- Note -->
                                ${location.note ? `
                                <div style="
                                    background: #fef3c7;
                                    border-left: 4px solid #f59e0b;
                                    padding: 0.75rem;
                                    border-radius: 8px;
                                    margin-top: 0.25rem;
                                ">
                                    <div style="display: flex; gap: 0.5rem; align-items: start;">
                                        <i class="fas fa-info-circle" style="color: #d97706; margin-top: 0.125rem;"></i>
                                        <div style="flex: 1;">
                                            <p style="font-size: 0.75rem; color: #92400e; font-weight: 600; margin: 0 0 0.25rem 0;">
                                                หมายเหตุ
                                            </p>
                                            <p style="font-size: 0.8125rem; color: #78350f; margin: 0; line-height: 1.5;">
                                                ${location.note}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                ` : ''}
                            </div>
                        </div>

                        <!-- Footer Actions -->
                        <div style="
                            padding: 0.875rem;
                            background: #f9fafb;
                            border-radius: 0 0 12px 12px;
                            display: flex;
                            gap: 0.625rem;
                        ">
                            <button onclick="navigateTo(${location.latitude}, ${location.longitude})" style="
                                flex: 1;
                                background: linear-gradient(135deg, #3b82f6, #2563eb);
                                color: white;
                                padding: 0.75rem;
                                border: none;
                                border-radius: 8px;
                                font-size: 0.875rem;
                                font-weight: 600;
                                cursor: pointer;
                                transition: all 0.2s;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                gap: 0.5rem;
                                box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
                            " onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 8px rgba(59, 130, 246, 0.4)'"
                            onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 4px rgba(59, 130, 246, 0.3)'">
                                <i class="fas fa-directions"></i>
                                <span>นำทาง</span>
                            </button>
                        </div>
                    </div>
                `;

                // Bind popup
                marker.bindPopup(popupContent, {
                    maxWidth: 320,
                    className: 'custom-popup'
                });

                // เก็บ marker และข้อมูล
                markers.push({ marker, location });
            });

            // ปรับมุมมองแผนที่ให้เห็น markers ทั้งหมด
            if (markers.length > 0) {
                const group = new L.featureGroup(markers.map(m => m.marker));
                map.fitBounds(group.getBounds().pad(0.1));
            }
        } else {
            console.warn('ไม่พบข้อมูลจุดรับซื้อขยะ');
        }

        // ฟังก์ชันนำทาง
        function navigateTo(lat, lng) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        window.open(`https://www.google.com/maps/dir/${userLat},${userLng}/${lat},${lng}`, '_blank');
                    },
                    () => {
                        window.open(`https://www.google.com/maps/search/?api=1&query=${lat},${lng}`, '_blank');
                    }
                );
            } else {
                window.open(`https://www.google.com/maps/search/?api=1&query=${lat},${lng}`, '_blank');
            }
        }

        // Location Item Click
        document.querySelectorAll('.location-item').forEach(item => {
            item.addEventListener('click', () => {
                const locationId = item.dataset.id;
                const markerData = markers.find(m => m.location._id === locationId);
                
                if (markerData) {
                    map.setView([markerData.location.latitude, markerData.location.longitude], 16);
                    markerData.marker.openPopup();
                    
                    // Highlight item
                    document.querySelectorAll('.location-item').forEach(i => {
                        i.classList.remove('active', 'border-blue-500', 'bg-blue-50');
                    });
                    item.classList.add('active');
                    item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });
        });

        // Locate User
        let userMarker = null;
        document.getElementById('locate-me').addEventListener('click', () => {
            if (navigator.geolocation) {
                const btn = document.getElementById('locate-me');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>กำลังค้นหา...';
                btn.disabled = true;

                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        
                        if (userMarker) {
                            map.removeLayer(userMarker);
                        }
                        
                        userMarker = L.marker([lat, lng], {
                            icon: icons.user
                        }).addTo(map);
                        
                        userMarker.bindPopup(`
                            <div style="padding: 0.75rem; text-align: center;">
                                <h4 style="font-weight: 600; color: #dc2626; margin: 0 0 0.5rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                    <i class="fas fa-map-marker-alt"></i>
                                    ตำแหน่งของคุณ
                                </h4>
                                <p style="font-size: 0.75rem; color: #6b7280; margin: 0;">
                                    ${lat.toFixed(6)}, ${lng.toFixed(6)}
                                </p>
                            </div>
                        `).openPopup();
                        
                        map.setView([lat, lng], 15);
                        
                        btn.innerHTML = '<i class="fas fa-location-arrow mr-2"></i>ตำแหน่งของฉัน';
                        btn.disabled = false;
                    },
                    (error) => {
                        console.error('Error getting location:', error);
                        alert('ไม่สามารถระบุตำแหน่งของคุณได้\nกรุณาเปิดใช้งาน Location Services');
                        btn.innerHTML = '<i class="fas fa-location-arrow mr-2"></i>ตำแหน่งของฉัน';
                        btn.disabled = false;
                    }
                );
            } else {
                alert('เบราว์เซอร์ของคุณไม่รองรับการระบุตำแหน่ง');
            }
        });

        // Map View Toggle
        document.getElementById('satellite-view-btn')?.addEventListener('click', () => {
            map.removeLayer(currentTileLayer);
            currentTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles © Esri',
                maxZoom: 19
            }).addTo(map);
            
            document.getElementById('map-view-btn').classList.remove('bg-primary', 'text-white');
            document.getElementById('map-view-btn').classList.add('bg-gray-200', 'text-gray-700');
            document.getElementById('satellite-view-btn').classList.remove('bg-gray-200', 'text-gray-700');
            document.getElementById('satellite-view-btn').classList.add('bg-primary', 'text-white');
        });

        document.getElementById('map-view-btn')?.addEventListener('click', () => {
            map.removeLayer(currentTileLayer);
            currentTileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);
            
            document.getElementById('satellite-view-btn').classList.remove('bg-primary', 'text-white');
            document.getElementById('satellite-view-btn').classList.add('bg-gray-200', 'text-gray-700');
            document.getElementById('map-view-btn').classList.remove('bg-gray-200', 'text-gray-700');
            document.getElementById('map-view-btn').classList.add('bg-primary', 'text-white');
        });

        // View on Map Function
        function viewOnMap(locationId) {
            const locationItem = document.querySelector(`.location-item[data-id="${locationId}"]`);
            if (locationItem) {
                locationItem.click();
                if (window.innerWidth < 1024) {
                    document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        }

        // Custom Popup Style
        const style = document.createElement('style');
