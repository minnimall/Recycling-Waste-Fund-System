    <!-- News & Announcements Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">ข่าวประชาสัมพันธ์</h2>
                <p class="text-gray-600">ข่าวสารและประกาศสำคัญจากองค์การบริหารส่วนตำบลขามป้อม</p>
            </div>

            <div class="grid lg:grid-cols-1 px-4">
                <!-- Documents & PDFs -->
                <div class="lg:col-span-1">
                    <div class="bg-gray-50 rounded-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-xl font-semibold text-gray-800">เอกสารสำคัญ</h3>
                            <i class="fas fa-file-pdf text-red-500 text-xl"></i>
                        </div>

                        <div class="space-y-4">
                        <!-- PDF Document 1 -->
                        <% if (news.length = 5) { %>
                            <% news.forEach((item, index) => { %>
                            <div class="bg-white rounded-lg p-4 border border-gray-200 hover:shadow-md transition-shadow cursor-pointer" onclick="openPDF('<%= item.newsTitle %>', '<%= item.newsFile %>')">
                                <div class="flex items-start space-x-3">
                                    <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-file-pdf text-red-500"></i>
                                    </div>
                                    <div class="flex-1">
                                        <div class="flex items-center space-x-2 mb-2">
                                            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">ข้อมูล</span>
                                            <span class="text-sm text-gray-500">วันที่: <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('th-TH') : 'ไม่ระบุ' %></span>
                                        </div>
                                        <div class="w-full max-w-[320px]">
                                            <h4 class="font-semibold text-gray-800 text-sm mb-1 truncate"><%= item.newsTitle %></h4>
                                        </div>
                                        <div class="w-full max-w-[320px]">
                                            <p class="text-gray-600 text-xs mb-2"><%= item.newsDescription %></p>
                                        </div>
                                        <!-- <div class="flex items-center justify-between text-xs text-gray-500">
                                            <span>PDF • 2.5 MB</span>
                                            <span><i class="fas fa-download mr-1"></i>234</span>
                                        </div> -->
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
