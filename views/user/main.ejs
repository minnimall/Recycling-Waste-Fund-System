<body>
    <!-- JS AOS -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            once: true,        // ให้ animation เล่นครั้งเดียว (แนะนำสำหรับเว็บไซต์ทั่วไป)
            duration: 800,     // ความเร็วของ animation
            delay: 100         // หน่วงเวลาเริ่มต้นนิดหน่อย
        });
    </script>


    <%- include('../partials/userPartials/header.ejs') %>


    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-20">
        <div data-aos="fade-left" data-aos-delay="300" class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-6xl font-bold mb-6">ยินดีต้อนรับสู่ อบต.</h2>
            <p class="text-xl md:text-2xl mb-8 opacity-90">บริการประชาชนด้วยใจ เพื่อชุมชนที่ยั่งยืน</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center ">
                <a href="/user/wasteSaleRequest" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-primary-green transition-colors">แจ้งประสงค์ขายขยะ</a>
                <a href="/user/complaint" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-primary-green transition-colors">ร้องเรียน</a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center text-primary mb-12">บริการของเรา</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-primary-green rounded-full flex items-center justify-center mb-4 mx-auto">
                        <i class="fas fa-recycle text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-center mb-3">จัดการขยะ</h3>
                    <p class="text-gray-600 text-center">บริการจัดเก็บและแยกประเภทขยะในชุมชน</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-primary-green rounded-full flex items-center justify-center mb-4 mx-auto">
                        <i class="fas fa-comments text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-center mb-3">รับเรื่องร้องเรียน</h3>
                    <p class="text-gray-600 text-center">รับฟังความคิดเห็นและข้อร้องเรียนจากประชาชน</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-primary-green rounded-full flex items-center justify-center mb-4 mx-auto">
                        <i class="fas fa-bell text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-center mb-3">ประกาศข่าวสาร</h3>
                    <p class="text-gray-600 text-center">แจ้งข่าวสารและกิจกรรมต่างๆ ให้ประชาชนทราบ</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-primary-green rounded-full flex items-center justify-center mb-4 mx-auto">
                        <i class="fas fa-phone text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-center mb-3">ติดต่อสอบถาม</h3>
                    <p class="text-gray-600 text-center">ช่องทางติดต่อสอบถามข้อมูลต่างๆ</p>
                </div>
            </div>
        </div>
    </section>

    <!-- News Section -->
    <section class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h3 class="text-3xl font-bold text-center text-gray-800 mb-12">กิจกรรมของ อบต.</h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                
            <% if (activity.length=4) {  %>
                <% activity.forEach(act => { %>
                <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                    <div class="h-48 bg-gradient-to-r from-primary-green to-secondary-green">
                        <img src="<%= act.img %>" class="h-48 w-full" alt="<%= act.img %>">
                    </div>
                    <div class="p-6">
                        <span class="text-sm text-primary-green font-semibold">5 มกราคม 2568</span>
                        <h4 class="text-xl font-semibold text-gray-800 mt-2 mb-3"><%= act.title %></h4>
                        <p class="text-gray-600">แจ้งการเปลี่ยนแปลงตารางเก็บขยะในช่วงวันหยุดยาว...</p>
                        <a href="/user/detailActivity/<%= act._id %>" class="text-primary-green font-semibold hover:underline mt-4 inline-block">อ่านต่อ</a>
                    </div>
                </article>
                <% }) %>
            <% } else { %>
                <p>ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
            <% } %>
            </div>
        </div>
        <!-- Quick Links -->
        <!-- <div class="text-center mt-8">
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="waste-type.html" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-recycle mr-2"></i>ดูประเภทขยะ
                </a>
                <a href="waste-ideas.html" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-600 transition-colors">
