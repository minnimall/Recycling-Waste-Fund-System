    <!-- News Section -->
    <section class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h3 class="text-3xl font-bold text-center text-gray-800 mb-12">กิจกรรมของ อบต.ขามป้อม</h3>
