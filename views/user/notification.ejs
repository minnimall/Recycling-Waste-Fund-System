<script>
    const targetRadios = document.querySelectorAll('input[name="targetType"]');
    const specificUserDiv = document.getElementById('specificUserDiv');

    targetRadios.forEach(radio => {
        radio.addEventListener('change', () => {
            if (radio.value === 'specific' && radio.checked) {
                specificUserDiv.classList.remove('hidden');
            } else {
                specificUserDiv.classList.add('hidden');
            }
        });
    });


document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("notifications-container");
    const searchInput = document.getElementById("search-input");
    const filterButtons = document.querySelectorAll(".filter-btn");

    // ดึงข้อมูลจาก EJS
    const notifications = <%- JSON.stringify(notifications.filter(m => !m.isDeleted)) %>;

    let currentFilter = "all";
    let currentPage = 1;
    const itemsPerPage = 5;

    // Modal elements
    const modal = document.getElementById('notification-modal');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalClose = document.getElementById('close-modal');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    const modalTitle = document.getElementById('modalTitle');
    const modalCreatedDate = document.getElementById('modal-created-date');
    const modalCreatedTime = document.getElementById('modal-created-time');
    const modalReference = document.getElementById('modal-reference');
    const modalStatus = document.getElementById('modal-status');
    const modalStatusIcon = document.getElementById('modal-status-icon');
    const modalContentText = document.getElementById('modal-content-text');
    const modalTypeBadge = document.getElementById('modal-type-badge');

    function renderNotifications() {
        let filtered = notifications.filter(n => {
            const matchesFilter =
                currentFilter === "all" ||
                (currentFilter === "unread" && !n.read) ||
                n.type === currentFilter;

            const matchesSearch = n.title.toLowerCase().includes(searchInput.value.toLowerCase()) ||
                                  n.content.toLowerCase().includes(searchInput.value.toLowerCase());

            return matchesFilter && matchesSearch;
        });

        const totalPages = Math.ceil(filtered.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = totalPages || 1;

        const start = (currentPage - 1) * itemsPerPage;
        const paginated = filtered.slice(start, start + itemsPerPage);

        if (paginated.length === 0) {
            container.innerHTML = `
                <div class="text-center py-16 px-4">
                    <i class="fas fa-bell-slash text-6xl text-gray-300 mb-4"></i>
                    <p class="text-lg font-medium text-gray-600 mb-2">ไม่มีการแจ้งเตือน</p>
                    <p class="text-sm text-gray-500">ไม่พบการแจ้งเตือนที่ตรงกับการค้นหา</p>
                </div>
            `;
            renderPagination(0);
            return;
        }

        container.innerHTML = paginated.map(n => `
            <div class="p-4 md:p-6 rounded-xl mb-3 cursor-pointer ${n.read ? 'border-2 border-gray-300' : 'border-2 border-red-300'} hover:shadow-md transition-all duration-100 hover:-translate-x-1"
                 data-notification-id="${n._id}" data-title="${n.title}" data-content='${n.content}'
                 data-type="${n.type}" data-createdat="${n.createdAt}" data-read="${n.read}">
                <div class="flex items-start gap-3 md:gap-4">
                <div class="w-12 h-12 ${
                    n.type === 'system' ? 'bg-gray-800' :
                    n.type === 'message' ? 'bg-primary-green' :
                    n.type === 'request' ? 'bg-blue-600' :
                    n.type === 'announcements' ? 'bg-orange-500' :
                    n.type === 'purchase' ? 'bg-green-600' :
                    n.type === 'round' ? 'bg-green-400' :
                    n.type === 'price_update' ? 'bg-yellow-600' :
                    'bg-gray-400'
                } rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">
                    <i class="${
                        n.type === 'system' ? 'fas fa-wrench' :
                        n.type === 'message' ? 'fas fa-message' :
                        n.type === 'request' ? 'fas fa-comment' :
                        n.type === 'announcements' ? 'fas fa-bullhorn' :
                        n.type === 'purchase' ? 'fas fa-money-bill' :
                        n.type === 'round' ? 'fas fa-truck' :
                        n.type === 'price_update' ? 'fas fa-tag' :
                        'fas fa-bell'
                    } text-white text-xl"></i>
                </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <h3 class="text-base md:text-lg font-semibold text-gray-800 flex items-center gap-2 flex-wrap">
                                <span class="break-words">${n.title}</span>
                                ${!n.read ? '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-red-500 to-red-600 text-white shadow-sm animate-pulse-slow">ใหม่</span>' :
                                '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-600">อ่านแล้ว</span>'}
                            </h3>
                        </div>
                        <div class="text-sm md:text-base text-gray-600 mb-3 leading-relaxed overflow-hidden max-h-6">${n.content}</div>
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <span class="text-xs md:text-sm text-gray-500 flex items-center">
                                <i class="far fa-clock mr-1"></i>
                                ${new Date(n.createdAt).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        `).join("");

        renderPagination(totalPages);
        attachCardEvents();
    }

    function renderPagination(totalPages) {
        let pagination = document.getElementById("pagination");
        if (!pagination) {
            pagination = document.createElement("div");
            pagination.id = "pagination";
            pagination.className = "flex justify-center mt-4 gap-2";
            container.parentNode.appendChild(pagination);
        }

        if (totalPages <= 1) {
            pagination.innerHTML = "";
            return;
        }

        let html = "";
        for (let i = 1; i <= totalPages; i++) {
            html += `<button class="px-3 py-1 border rounded ${i===currentPage?'bg-primary-green text-white':'bg-white text-gray-700 border-gray-300'}">${i}</button>`;
        }
        pagination.innerHTML = html;

        pagination.querySelectorAll("button").forEach(btn => {
            btn.addEventListener("click", () => {
                currentPage = Number(btn.textContent);
                renderNotifications();
            });
        });
    }

    function attachCardEvents() {
        const notificationCards = container.querySelectorAll('[data-notification-id]');
        notificationCards.forEach(card => {
            card.addEventListener('click', async () => {
                const data = {
                    id: card.dataset.notificationId,
                    title: card.dataset.title,
                    content: card.dataset.content,
                    type: card.dataset.type,
                    createdAt: card.dataset.createdat,
                    read: card.dataset.read === 'true'
                };
                openModal(data);
            });
        });
    }

    async function openModal(data) {
        try {
            modalTitle.textContent = data.title;
            modalContentText.innerHTML = data.content;
            const date = new Date(data.createdAt);
            modalCreatedDate.textContent = date.toLocaleDateString('th-TH', { year:'numeric', month:'long', day:'numeric' });
            modalCreatedTime.textContent = date.toLocaleTimeString('th-TH', { hour:'numeric', minute:'numeric' });
           // modalReference.textContent = data.id || 'N/A';
            modalTypeBadge.textContent = data.type || 'ทั่วไป';

            if (data.read) {
                // modalStatus.textContent = 'อ่านแล้ว';
                // modalStatusIcon.className = 'fas fa-check-circle text-green-500';
            } else {
                // modalStatus.textContent = 'ยังไม่อ่าน';
                // modalStatusIcon.className = 'fas fa-circle-dot text-red-500';

                // อัปเดตสถานะอ่าน
                const response = await fetch(`/user/notification/${data.id}/read`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ read: true })
                });
                if (response.ok) {

                    // อัปเดต badge และ border การ์ด
                    const card = document.querySelector(`[data-notification-id="${data.id}"]`);
                    if (card) {
                        card.classList.remove('border-red-300');
                        card.classList.add('border-gray-300');
                        card.querySelector('.animate-pulse-slow')?.remove();
                        const badge = card.querySelector('span.bg-gray-200');
                        if (!badge) {
                            const readBadge = document.createElement('span');
                            readBadge.className = 'inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-600';
                            readBadge.textContent = 'อ่านแล้ว';
                            card.querySelector('h3').appendChild(readBadge);
                        }
                    }
                }
            }

            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

        } catch (err) {
            console.error('Error loading notification:', err);
            alert('ไม่สามารถโหลดข้อมูลการแจ้งเตือนได้');
        }
    }

    function closeModal() {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    // Event listeners
    searchInput.addEventListener("input", () => { currentPage = 1; renderNotifications(); });
    
    filterButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            filterButtons.forEach(b => {
                // รีเซ็ตปุ่มเป็นสีปกติ
                b.classList.remove('border-primary-green', 'bg-primary-green', 'text-white');
                b.classList.add('border-gray-300', 'bg-white', 'text-gray-700', 'hover:text-primary-green');
            });

            // ตั้งปุ่มที่ถูกคลิกเป็น active
            btn.classList.remove('border-gray-300', 'bg-white', 'text-gray-700', 'hover:text-primary-green');
            btn.classList.add('border-primary-green', 'bg-primary-green', 'text-white');

            currentFilter = btn.dataset.filter;
            currentPage = 1;
            renderNotifications();
        });
    });


    [modalBackdrop, modalClose, modalCloseBtn].forEach(btn => btn.addEventListener('click', closeModal));
    document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });

    renderNotifications();
});
</script>

</html>