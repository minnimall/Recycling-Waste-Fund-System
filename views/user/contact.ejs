<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }
    </script>
    
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">ติดต่อ-สอบถาม</h2>
            <p class="text-xl opacity-90">ข้อมูลติดต่อคณะกรรมการฝ่ายต่างๆ</p>
        </div>
    </section>

    <div class="content mb-5">
        <div class="container mx-auto px-4">
            <section class="mt-3">
                
                <!-- คณะกรรมการฝ่ายอำนวยการ -->
                <% if (boards.executive && boards.executive.length > 0) { %>
                <div class="mt-8">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายอำนวยการ</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.executive.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>
                
                <!-- คณะกรรมการฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล -->
                <% if (boards.pr && boards.pr.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.pr.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>
                
                <!-- คณะกรรมการฝ่ายรับสมัคร -->
                <% if (boards.recruitment && boards.recruitment.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายรับสมัคร</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.recruitment.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายรับซื้อขยะ -->
                <% if (boards.purchase && boards.purchase.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายรับซื้อขยะ</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.purchase.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายการเงินและบัญชี -->
                <% if (boards.finance && boards.finance.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายการเงินและบัญชี</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.finance.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายเบิกถอนเงินฝากธนาคาร -->
                <% if (boards.withdrawal && boards.withdrawal.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายเบิกถอนเงินฝากธนาคาร</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.withdrawal.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายงานทะเบียนและธุรการ -->
                <% if (boards.registry && boards.registry.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายงานทะเบียนและธุรการ</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.registry.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายจัดการทุนและฌาปนกิจ -->
                <% if (boards.fund && boards.fund.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายจัดการทุนและฌาปนกิจ</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.fund.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <!-- คณะกรรมการฝ่ายภาพกิจกรรม -->
                <% if (boards.photo && boards.photo.length > 0) { %>
                <div class="mt-12">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">คณะกรรมการฝ่ายภาพกิจกรรม</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% boards.photo.forEach(member => { %>
                        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                            <div class="flex flex-col items-center text-center">
                                <img src="<%= member.img || '/img/default-avatar.png' %>" 
                                    alt="<%= member.name %>" 
                                    class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-200">
                                <div class="space-y-2">
                                    <p class="text-gray-700"><strong class="text-gray-900">ชื่อ:</strong> <%= member.name %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">ตำแหน่ง:</strong> <%= member.role %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">อีเมล:</strong> <%= member.email || '---' %></p>
                                    <p class="text-gray-700"><strong class="text-gray-900">เบอร์โทรศัพท์:</strong> <%= member.tel || '---' %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

            </section>
        </div>
    </div>

    <%- include('../partials/userPartials/footer.ejs') %>

</body>
</html>