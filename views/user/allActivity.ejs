    <%- include('../partials/userPartials/head.ejs') %>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">กิจกรรมทั้งหมด</h2>
            <p class="text-xl opacity-90">รวบรวมกิจกรรมข่าวสารต่างๆของ อบต.ขามป้อม</p>
        </div>
    </section>

    <div class="content mb-5">
        <div class="container mx-auto px-4">
            <section class="mt-3">
                <div class="mt-6 mb-5 flex justify-between items-center">
                    <div>
                        
                    </div>
                    <div>
                        <form action="/user/allActivity" method="get" class="flex">
                            <input type="hidden" name="page" value="1" />
                            <input type="text" name="search" 
                                class="px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2" 
                                placeholder="ค้นหากิจกรรม" 
                                aria-label="ค้นหากิจกรรม" 
                                value="<%= search || '' %>" />
                            <button type="submit" 
                                class="px-4 py-2 bg-green-700 text-white rounded-r-md hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-700 focus:ring-offset-2 transition-colors">
                                ค้นหา
                            </button>
                        </form>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-5">
                    <% if (activity && activity.length > 0) { %>
                        <% activity.forEach(act => { %>
                        <div class="mt-3 flex"> 
                            <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow flex flex-col h-full w-full">
                                <a href="/user/detailActivity/<%= act._id %>" class="flex flex-col h-full">
                                    <img src="<%= act.img[0] %>" class="h-48 w-full object-cover" alt="<%= act.title %>">

                                    <div class="p-4 flex flex-col justify-between flex-grow">
                                        <p class="font-medium text-gray-900 mb-2 line-clamp-2">
                                            <%= act.title %>
                                        </p>
                                        <p class="text-sm text-gray-500 text-right mt-auto">
                                            วันที่ <%= act.formattedDate %>
                                        </p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full">
                            <p class="text-gray-500 text-center py-8">ไม่พบกิจกรรมที่ค้นหา ....</p>
                        </div>
                    <% } %>
                </div>

                <div>
                    <% if (pagination && pagination.totalItems > 0) { %>
                    <div class="mb-4 text-sm text-gray-600">
                        แสดง <%= ((pagination.currentPage - 1) * pagination.itemsPerPage) + 1 %> 
                        ถึง <%= Math.min(pagination.currentPage * pagination.itemsPerPage, pagination.totalItems) %> 
                        จาก <%= pagination.totalItems %> กิจกรรม
                    </div>
                    <% } %>
                </div>

                <% if (pagination) { %>
                <div class="mt-8 mb-6 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <div class="flex items-center gap-2">
                        <!-- ปุ่มหน้าแรก -->
                        <% if (pagination.currentPage > 1) { %>
                        <a href="?page=1<%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                        class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                        <% } %>

                        <!-- ปุ่มหน้าก่อนหน้า -->
                        <% if (pagination.hasPrevPage) { %>
                        <a href="?page=<%= pagination.currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                        class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                        <% } else { %>
                        <button disabled 
                                class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <% } %>

                        <!-- แสดงเลขหน้า -->
                        <% 
                        const maxPagesToShow = 5;
                        let startPage = Math.max(1, pagination.currentPage - Math.floor(maxPagesToShow / 2));
                        let endPage = Math.min(pagination.totalPages, startPage + maxPagesToShow - 1);
                        
                        if (endPage - startPage < maxPagesToShow - 1) {
                            startPage = Math.max(1, endPage - maxPagesToShow + 1);
                        }
                        
                        if (startPage > 1) { %>
                            <span class="px-2 text-gray-500">...</span>
                        <% } 
                        
                        for (let i = startPage; i <= endPage; i++) { %>
                            <% if (i === pagination.currentPage) { %>
                            <button class="px-4 py-2 rounded-md bg-green-700 text-white text-sm font-medium">
                                <%= i %>
                            </button>
                            <% } else { %>
                            <a href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                            class="px-4 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                                <%= i %>
                            </a>
                            <% } %>
                        <% } 
                        
                        if (endPage < pagination.totalPages) { %>
                            <span class="px-2 text-gray-500">...</span>
                        <% } %>

                        <!-- ปุ่มหน้าถัดไป -->
                        <% if (pagination.hasNextPage) { %>
                        <a href="?page=<%= pagination.currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                        class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        <% } else { %>
                        <button disabled 
                                class="px-3 py-2 rounded-md bg-gray-100 border border-gray-300 text-sm text-gray-400 cursor-not-allowed">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        <% } %>

                        <!-- ปุ่มหน้าสุดท้าย -->
                        <% if (pagination.currentPage < pagination.totalPages) { %>
                        <a href="?page=<%= pagination.totalPages %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                        class="px-3 py-2 rounded-md bg-white border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 transition">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </section>
        </div>
    </div>

    <%- include('../partials/userPartials/footer.ejs') %>
</body>
</html>
