<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด!',
                text: errorMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#d33',
                timer: 3000
            });
        }

    </script>
    <%- include('../partials/userPartials/header.ejs') %>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">กิจกรรมทั้งหมด</h2>
            <p class="text-xl opacity-90">รวบรวมกิจกรรมข่าวสารต่างๆของ อบต.ขามป้อม</p>
        </div>
    </section>

    <div class="content mb-5">
        <div class="container mx-auto px-4">
            <section class="mt-3">
                <div class="mt-5 flex justify-between items-center">
                    <p class="text-xl font-semibold text-gray-800">
                        <!-- <i class="fa fa-flag text-green-500"></i> -->กิจกรรมทั้งหมด
                    </p>
                    <form action="/user/allActivity" method="get" class="flex">
                        <!-- ช่องค้นหาชื่อกิจกรรม -->
                        <input type="text" name="search" class="px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2" 
                            placeholder="ค้นหากิจกรรม" aria-label="ค้นหากิจกรรม" value="<%= search || '' %>" />
                        <button type="submit" class="px-4 py-2 bg-green-700 text-white rounded-r-md hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-700 focus:ring-offset-2 transition-colors">
                            ค้นหา
                        </button>
                    </form>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    <% if (activity && activity.length > 0) { %>
                        <% activity.forEach(act => { %>
                            <div class="mt-3">
                                <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
                                    <a href="/user/detailActivity/<%= act._id %>" class="block">
                                        <img 
                                            class="w-full h-48 object-cover rounded-t-lg" 
                                            src="<%= act.img %>" 
                                            alt="รูปภาพกิจกรรม"
                                        >
                                        <div class="p-4">
                                            <p class="font-medium text-gray-900 mb-2"><%= act.title %></p>
                                            <p class="text-sm text-gray-500 text-right">วันที่ <%= act.formattedDate %></p>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full">
                            <p class="text-gray-500 text-center py-8">ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </div>

    <%- include('../partials/userPartials/footer.ejs') %>
</body>
</html>
