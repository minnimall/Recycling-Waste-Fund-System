<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กองทุนขยะรีไซเคิล องค์การบริหารส่วนตำบลขามป้อม อำเภอเปือยน้อย จังหวัดขอนแก่น</title>
    <link rel="icon" href="/img/logo_เปือยน้อย.png" type="image/png">
    <link rel="stylesheet" href="/style_user/allActivity.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-pzjw8f+ua7Kw1TIqO5Cs5mPE65pYvThh+ZvrHE9jT1md/8xObNY7tOfr60RvBwjc" crossorigin="anonymous"></script>
</head>
<body>
    <nav>
        <div class="container">
            <div class="nav-content">
                <a href="/"><img class="logo" src="/img/logo_เปือยน้อย.png" alt="โลโก้"></a>
                <ul class="menu">
                    <li><a href="/">หน้าหลัก</a></li>
                    <li><a href="/user/wastetype">ประเภทขยะ</a></li>
                    <li><a href="/user/knowledge">สื่อความรู้</a></li>
                    <li><a href="/user/saleHistory">ประวัติการขาย</a></li>
                    <li><a href="./after_learning.html">แจ้งประสงค์ขายขยะ</a></li>
                    <li><a href="/user/contact">ติดต่อ-สอบถาม</a></li>
                    <li>
                        <a href="/login">
                            <i class="fa fa-user"></i> เข้าสู่ระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="content">
        <div class="container">
            <section class="mt-3">
                <div class="mt-5 title-idea d-flex justify-content-between align-items-center">
                    <p class="title">
                        <i class="fa fa-flag icon-green"></i> ข่าวกิจกรรมทั้งหมด
                    </p>
                </div>

                <div class="row">
                    <% if (activity.length>0) {  %>
                        <% activity.forEach(act => { %>
                            <div class="col-3">
                                <div class="card mt-3">
                                    <img class="d-block w-100" src="<%= act.img %>" alt="รูปภาพกิจกรรม">
                                    <div class="card-body">
                                        <p class="card-title"><%= act.title %></p>
                                        <p class="date text-end">วันที่ <%= act.formattedDate %></p>
                                    </div>
                                </div>
                            </div>
                            
                        <% }) %>
                    <% } else { %>
                        <p>ยังไม่มีกิจกรรม ณ ขณะนี้ ....</p>
                    <% } %>
                </div>
            </section>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="activityModal" tabindex="-1" aria-labelledby="activityModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="activityModalLabel">รายละเอียดกิจกรรม</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img id="modal-img" src="" alt="รูปภาพกิจกรรม" class="img-fluid mb-3">
                    <h5 id="modal-title"></h5>
                    <p id="modal-content"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>    
    <%- include('../partials/footer.ejs') %>
</body>
</html>
