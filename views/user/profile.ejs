<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
</head>
<body>
    <%- include('../partials/userPartials/header.ejs') %>
    <!-- Profile Header -->
    <section class="bg-primary-green text-white py-12">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-6">
                <div class="w-24 h-24 flex items-center justify-center">
                <img src="/img/avatar.png" alt="รูปโปรไฟล์" class="profile-img mb-3 w-full">
                </div>
                <div class="text-center md:text-left">
                    <h1 class="text-3xl font-bold"><%= username %></h1>
                    <p class="text-xl opacity-90">เข้าร่วมสมาชิกกองทุนขยะวันที่ <%= createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    <!-- <div class="flex flex-wrap justify-center md:justify-start gap-4 mt-3">
                        <span class="bg-white/20 px-3 py-1 rounded-full text-sm">สมาชิกทอง</span>
                        <span class="bg-white/20 px-3 py-1 rounded-full text-sm">ขายขยะ 24 ครั้ง</span>
                        <span class="bg-white/20 px-3 py-1 rounded-full text-sm">รายได้ 2,450 บาท</span>
                    </div> -->
                </div>
            </div>
        </div>
    </section>
    
        <!-- Modal Post -->
    <div id="ideaModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
      <div class="bg-white w-full max-w-2xl mx-4 rounded-lg shadow-lg p-6 relative">
        <!-- ปุ่มปิด -->
        <button id="closeModalBtn"
          class="absolute top-3 right-4 text-gray-600 hover:text-red-600 text-xl">&times;</button>

        <% if (locals.session && locals.session.username) { %>
          <h2 class="text-xl font-semibold text-primary-green mb-4">แบ่งปันไอเดียของคุณ</h2>
          <form id="create-post-form" class="space-y-4" action="/user/ideas/create" method="POST"
            enctype="multipart/form-data">
            <div>
              <input type="text" name="title" placeholder="หัวข้อไอเดีย..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required>
            </div>
            <div>
              <select name="category"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required>
                <option value="">เลือกหมวดหมู่</option>
                <option value="reduce">ลดการใช้</option>
                <option value="reuse">นำกลับมาใช้</option>
                <option value="recycle">รีไซเคิล</option>
                <option value="diy">DIY/ทำเอง</option>
                <option value="community">โครงการชุมชน</option>
                <option value="other">อื่นๆ</option>
              </select>
            </div>
            <div>
              <textarea name="content" rows="4" placeholder="เล่าไอเดียของคุณ..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                required></textarea>
            </div>
            <div>
              <div id="img-box" class="hidden w-full my-2 relative">
                <button type="button" onclick="clearImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
                <img id="image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
              </div>
              <input type="file" id="image" name="image" accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
              <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
            </div>
            <script>
              // Preview รูป
              const fileInput = document.querySelector('input[name="image"]');
              const preview = document.getElementById('image-preview');
              const box_img = document.getElementById('img-box');
              const image_input = document.getElementById('image');

              fileInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                  preview.src = URL.createObjectURL(file);
                  preview.classList.remove('hidden');
                  box_img.classList.remove('hidden');
                } else {
                  preview.src = '';
                  preview.classList.add('hidden');
                }
              });

              function clearImg() {
                preview.src = '';
                image_input.value = '';
                box_img.classList.add('hidden');
              }
            </script>

            <div class="flex justify-end">
              <button type="submit"
                class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                <i class="fas fa-paper-plane mr-2"></i>แบ่งปันไอเดีย
              </button>
            </div>
          </form>
          <% } else { %>
            <div class="text-center text-red-600 font-semibold">
              กรุณาเข้าสู่ระบบก่อนเพื่อแบ่งปันไอเดียของคุณ
            </div>
            <% } %>
      </div>
    </div>

    <!-- Edit Model -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
      <div class="bg-white p-6 rounded-lg w-full max-w-lg shadow-lg relative">
        <h2 class="text-lg font-semibold mb-4">แก้ไขโพสต์</h2>
        <form id="editPostForm">
          <input type="hidden" id="editPostId">

          <div class="mb-4">
            <label class="block mb-1 font-medium">หัวข้อ</label>
            <input type="text" id="editTitle" class="w-full border px-3 py-2 rounded" required>
          </div>
          <div class="mb-4">
            <label class="block mb-1 font-medium">หมวดหมู่</label>
            <select id="editCategory" class="w-full border px-3 py-2 rounded">
              <option value="reduce">ลดการใช้</option>
              <option value="reuse">นำกลับมาใช้</option>
              <option value="recycle">รีไซเคิล</option>
              <option value="diy">DIY/ทำเอง</option>
              <option value="community">โครงการชุมชน</option>
              <option value="other">อื่นๆ</option>
            </select>
          </div>
          <div class="mb-4">
            <label class="block mb-1 font-medium">เนื้อหา</label>
            <textarea id="editContent" rows="4" class="w-full border px-3 py-2 rounded" required></textarea>
          </div>


          <div>
            <div id="edit-img-box" class="hidden w-full my-2 relative">
              <button type="button" onclick="clearEditImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
              <img id="edit-image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
            </div>
            <input type="file" id="editImage" name="image" accept="image/*"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
            <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
          </div>

          <div class="flex justify-end space-x-3">
            <button type="button" onclick="closeEditModal()"
              class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">ยกเลิก</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">บันทึก</button>
          </div>
        </form>
      </div>
    </div>

        <!-- Profile Content -->
    <section class="py-8">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <!-- Tab Navigation -->
                <div class="bg-white rounded-lg shadow-lg mb-6">
                    <div class="border-b border-gray-200">
                        <nav class="flex flex-wrap">
                            <button class="tab-btn active px-6 py-4 text-primary border-b-2 border-primary font-semibold" data-tab="personal">
                                <i class="fas fa-user mr-2"></i>ข้อมูลส่วนตัว
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="family">
                                <i class="fas fa-users mr-2"></i>สมาชิกครอบครัว
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="requests">
                                <i class="fas fa-clipboard-list mr-2"></i>ประวัติแจ้งความประสงค์
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="complaints">
                                <i class="fas fa-exclamation-triangle mr-2"></i>ประวัติคำร้องเรียน
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="ideas">
                                <i class="fas fa-lightbulb mr-2"></i>ไอเดียของฉัน
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="sales">
                                <i class="fas fa-shopping-cart mr-2"></i>ประวัติการขาย
                            </button>
                            <button class="tab-btn px-6 py-4 text-gray-500 hover:text-primary transition-colors" data-tab="account">
                                <i class="fas fa-book mr-2"></i>สมุดบัญชี
                            </button>
                        </nav>
                    </div>

                    <!-- Tab Content -->
                    <div class="p-6">
                        <!-- Personal Information Tab -->
                        <div id="personal" class="tab-content">
                            <div class="grid md:grid-cols-2 gap-6">
                                <% members.forEach(function(member) { %>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">ชื่อ-นามสกุล</label>
                                        <input type="text" value="นายสมชาย ดีใจ" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">เลขประจำตัวประชาชน</label>
                                        <input type="text" value="<%= member.idCardNumber %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">เบอร์โทรศัพท์</label>
                                        <input type="tel" value="<%= member.phone %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">อีเมล</label>
                                        <input type="email" value="<%= member.email %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                    </div>
                                </div>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">ที่อยู่</label>
                                        <textarea rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">บ้านเลขที่ <%= address.houseNumber %> หมู่ <%= address.moo %> ตำบล <%= address.subdistrict %> อำเภอ <%= address.district %> จังหวัด <%= address.province %> รหัสไปรษณีย์ <%= address.postalCode %>
                                        </textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">หมายเลขบัญชีธนาคาร</label>
                                        <input type="text" value="<%= wasteBankAccount ? wasteBankAccount.AccountNumber : '-' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                    </div>
                                    <!-- <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">ธนาคาร</label>
                                        <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                            <option>ธนาคารกรุงเทพ</option>
                                            <option>ธนาคารกสิกรไทย</option>
                                            <option>ธนาคารไทยพาณิชย์</option>
                                            <option>ธนาคารกรุงไทย</option>
                                        </select>
                                    </div> -->
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">วันที่เข้าร่วมเป็นสมาชิก</label>
                                        <input type="text" value="<%= createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100" readonly>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                            <!-- <div class="mt-6 flex justify-end">
                                <button class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                    <i class="fas fa-save mr-2"></i>บันทึกข้อมูล
                                </button>
                            </div> -->
                        </div>

                        <!-- Family Members Tab -->
                        <div id="family" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">สมาชิกในครอบครัว</h3>
                                <!-- <button class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                    <i class="fas fa-plus mr-2"></i>เพิ่มสมาชิก
                                </button> -->
                            </div>
                            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                                
                            <% members.forEach(function(member) { %>
                                <!-- สมาชิก -->
                                <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                    <div class="flex items-center space-x-3 mb-3">
                                        <div class="w-12 h-12 bg-pink-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-male text-white"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold"><%= member.name %></h4>
                                            <p class="text-sm text-gray-600">ตัวแทนสมาชิกครอบครัว</p>
                                        </div>
                                    </div>
                                    <div class="text-sm text-gray-600 space-y-1">
                                        <p><i class="fas fa-phone mr-2"></i><%= member.phone %></p>
                                        <p><i class="fas fa-birthday-cake mr-2"></i><%= member.age %> ปี</p>
                                    </div>
                                </div>

                                <!-- ผู้รับผลประโยชน์ -->
                                <% if (member.beneficiaries && member.beneficiaries.length > 0) { %>
                                    <% member.beneficiaries.forEach(function(beneficiary) { %>
                                        <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                            <div class="flex items-center space-x-3 mb-3">
                                                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                                                    <i class="fas fa-child text-white"></i>
                                                </div>
                                                <div>
                                                    <h4 class="font-semibold"><%= beneficiary.name %></h4>
                                                    <p class="text-sm text-gray-600"><%= beneficiary.relation %></p>
                                                </div>
                                            </div>
                                            <div class="text-sm text-gray-600 space-y-1">
                                                <p><i class="fas fa-percent mr-2"></i>การแบ่ง: <%= beneficiary.distributionType %></p>
                                                <% if (beneficiary.distributionType === 'other') { %>
                                                    <p><i class="fas fa-info-circle mr-2"></i><%= beneficiary.distributionDetail %></p>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-gray-500 italic">ไม่มีข้อมูลผู้รับผลประโยชน์</p>
                                <% } %>
                            <% }) %>
                            </div>
                        </div>

                        <!-- Waste Sale Requests Tab -->
                        <div id="requests" class="tab-content hidden">
                            <h3 class="text-xl font-semibold text-gray-800 mb-6">ประวัติการแจ้งความประสงค์ขายขยะ</h3>
                            <div class="space-y-4">
                                    
                                <% if (wasteSaleRequests.length > 0) { %>
                                    <% wasteSaleRequests.forEach((request) => { %>
                                    <div class="bg-gray-50 rounded-lg p-4">
                                        <div class="flex justify-between items-start mb-3">
                                            <div>
                                                <h4 class="font-semibold text-gray-800 py-4">แจ้งขายขยะรีไซเคิล</h4>
                                                <p class="text-sm text-gray-600">วันที่ <%= request.createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %> เวลา 14:30</p>
                                            </div>
                                        <% if (request.status === 'สำเร็จ') { %> 
                                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">เสร็จสิ้น</span>
                                        <% } else if (request.status === 'รอดำเนินการ') { %>
                                            <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm">รอดำเนินการ</span>
                                        <% } else { %> 
                                            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm">error</span>
                                        <% } %>
                                        </div>
                                        <div class="grid md:grid-cols-2 gap-4 text-sm">
                                            <div>
                                                <p class="text-gray-600">ประเภทขยะ:</p>
                                                <p class="font-semibold">                                            
                                                <% request.waste.forEach((w, index) => { %>
                                                    <span class="text-semibold">
                                                        <%= w.wasteName %>
                                                        <% if (index < request.waste.length - 1) { %>, <% } %>
                                                    </span>
                                                <% }); %></p>
                                            </div>
                                            <div>
                                                <p class="text-gray-600">น้ำหนักประมาณ:</p>
                                                <p class="font-semibold"><%= request.weight %> กิโลกรัม</p>
                                            </div>
                                            <div>
                                                <p class="text-gray-600">วันที่ต้องการขาย:</p>
                                                <p class="font-semibold">
                                                <% if (request.date) { %>
                                                    <%= new Date(request.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                <% } else { %>
                                                    <span>ไม่ระบุ</span>
                                                <% } %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                <% } else { %>
                                        <div>ยังไม่มีข้อมูลคำร้องขอขายขยะ</div>
                                    <% } %>   
                            </div>
                        </div> 
                        
                        <!-- Complaints Tab -->
                        <div id="complaints" class="tab-content hidden">
                            <h3 class="text-xl font-semibold text-gray-800 mb-6">ประวัติคำร้องเรียน</h3>
                            <div class="space-y-4">
                            <% complaints.forEach((com) => { %>
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-start mb-3">
                                        <div>
                                            <h4 class="font-semibold text-gray-800 py-4">คำร้องเรียน</h4>
                                            <p class="text-sm text-gray-600">วันที่ <%= com.createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %> เวลา</p>
                                        </div>
                                        <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">แก้ไขแล้ว</span>
                                    </div>
                                    <p class="text-gray-700 mb-3">คำอธิบาย : <%= com.complaintMessage %></p>
                                    <div class="text-sm text-gray-600">
                                        <p><strong>การตอบสนอง:</strong> ขออภัยในความไม่สะดวก เนื่องจากรถเสียในระหว่างทาง ได้จัดรถสำรองมารับแล้ว</p>
                                        <p class="mt-1"><strong>วันที่แก้ไข:</strong> 2 มกราคม 2568</p>
                                    </div>
                                </div>
                            <% }); %>
                            </div>
                        </div>

<!-- My Ideas Tab -->
                        <div id="ideas" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">ไอเดียการจัดการขยะของฉัน</h3>
                            </div>
                                <!-- Filter Section -->
                                <section class="py-4">
                                <div class="container mx-auto px-4">
                                    <div class="flex flex-wrap justify-start gap-3">
                                    <button
                                        class="idea-filter bg-primary-green text-white px-4 py-2 rounded-full hover:bg-secondary-green transition-colors"
                                        data-category="all">ทั้งหมด</button>
                                    <button
                                        class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
                                        data-category="reduce">ลดการใช้</button>
                                    <button
                                        class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
                                        data-category="reuse">นำกลับมาใช้</button>
                                    <button
                                        class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
                                        data-category="recycle">รีไซเคิล</button>
                                    <button
                                        class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
                                        data-category="diy">DIY/ทำเอง</button>
                                    <button
                                        class="idea-filter bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors"
                                        data-category="community">โครงการชุมชน</button>
                                    <!-- ปุ่มเปิดโมดอล -->
                                    <button id="openModalBtn"
                                        class="bg-primary-green text-white px-4 py-2 rounded hover:bg-primary-dark transition">
                                        <i class="fas fa-plus mr-2"></i> เพิ่มไอเดียใหม่
                                    </button>
                                    </div>
                                </div>
                                </section>
                            <div class="grid gap-6">
                                      <div class="container mx-auto px-4">
                                        <div class="mx-auto" id="posts-container">
                                        <% posts.forEach(post=> { %>
                                            <article class="idea-post bg-white rounded-lg shadow-lg mb-6 overflow-hidden"
                                            data-category="<%= post.category %>" data-post-id="<%= post._id %>">
                                            <div class="p-6">
                                                <div class="flex items-center mb-4">
                                                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mr-4">
                                                    <i class="fas fa-user text-white"></i>
                                                </div>
                                                <div class="flex-1">
                                                    <h3 class="font-semibold text-gray-800">
                                                    <%= post.authorId?.familyName || 'ไม่ระบุชื่อ' %>
                                                    </h3>


                                                    <div class="flex items-center text-sm text-gray-500">
                                                    <span class="post-time text-sm text-gray-500" data-time="<%= post.createdAt.toISOString() %>"></span>

                                                    <span class="mx-2">•</span>
                                                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">
                                                        <% const categoryNames={ reduce: 'ลดการใช้' , reuse: 'นำกลับมาใช้' , recycle: 'รีไซเคิล' ,
                                                        diy: 'DIY/ทำเอง' , community: 'โครงการชุมชน' , other: 'อื่นๆ' }; %>
                                                        <%= categoryNames[post.category] || post.category %>
                                                    </span>

                                                    <% if (user && post.authorId && user._id.toString()===post.authorId._id.toString()) { %>
                                                        <div class="relative ml-auto">
                                                        <button type="button"
                                                            class="text-gray-500 hover:text-gray-700 focus:outline-none dropdown-toggle"
                                                            data-dropdown-id="dropdown-<%= post._id %>">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <div id="dropdown-<%= post._id %>"
                                                            class="absolute right-0 mt-2 w-32 bg-white border rounded shadow-md hidden z-50">
                                                            <button onclick="openEditModal(
                                                                '<%= post._id %>',
                                                                '<%= post.title %>',
                                                                '<%= post.content %>',
                                                                '<%= post.category %>',
                                                                '<%= post.imageUrl %>'
                                                            )" class="w-full text-left px-4 py-2 text-sm text-blue-600 hover:bg-blue-50">
                                                            ✏️ แก้ไข
                                                            </button>
                                                            <button data-post-id="<%= post._id %>"
                                                            onclick="deleteIdeas('<%= post._id %>', '<%= post.title %>')"
                                                            class="delete-post-btn w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">🗑️
                                                            ลบ</button>
                                                        </div>
                                                        </div>
                                                        <% } %>

                                                    </div>
                                                </div>
                                                </div>
                                                <h2 class="text-xl font-semibold text-gray-800 mb-3">
                                                <%= post.title %>
                                                </h2>
                                                <p class="text-gray-600 mb-4">
                                                <%= post.content %>
                                                </p>

                                                <% if (post.imageUrl && post.imageUrl !=="no_image" ) { %>
                                                <div class="mb-4">
                                                    <img src="<%= post.imageUrl %>" alt="รูปภาพประกอบ" class="w-full h-64 object-cover rounded-lg">
                                                </div>
                                                <% } else { %>

                                                    <% } %>

                                                    <div class="flex items-center justify-between border-t pt-4">
                                                        <div class="flex items-center space-x-6">
                                                        <% let liked=false; if (typeof user !=='undefined' && user && user._id) {
                                                            liked=post.likes.some(id=> id.toString() === user._id.toString());
                                                            }
                                                            %>
                                                            <button
                                                            class="like-btn flex items-center text-gray-500 hover:text-red-500 transition-colors"
                                                            data-post-id="<%= post._id %>" type="button">
                                                            <i
                                                                class="<%= liked ? 'fas' : 'far' %> fa-heart mr-2 <%= liked ? 'text-red-500' : '' %>"></i>
                                                            <span class="like-count">
                                                                <%= post.likes.length %>
                                                            </span>
                                                            </button>
                                                            <button
                                                            class="comment-btn flex items-center text-gray-500 hover:text-blue-500 transition-colors"
                                                            data-post-id="<%= post._id %>" type="button">
                                                            <i class="far fa-comment mr-2"></i>
                                                            <span class="comment-count">
                                                                <%= post.comments.length %>
                                                            </span>
                                                            </button>
                                                        </div>
                                                    </div>


                                                    <!-- Comments Section -->
                                                    <div class="comments-section mt-4 hidden" id="comments-<%= post._id %>">
                                                        <div class="border-t pt-4">
                                                        <div class="space-y-3 mb-4">
                                                            <% post.comments.forEach(comment=> { %>
                                                            <div class="flex items-start space-x-3">
                                                                <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                                                                <i class="fas fa-user text-gray-600 text-sm"></i>
                                                                </div>
                                                                <div class="flex-1">
                                                                <div class="bg-gray-100 rounded-lg p-3">
                                                                    <p class="font-semibold text-sm text-gray-800">
                                                                    <%= comment.author.familyName || 'ไม่ระบุ' %>
                                                                    </p>
                                                                    <p class="text-gray-600 text-sm">
                                                                    <%= comment.content %>
                                                                    </p>
                                                                </div>
                                                                <div class="flex items-center mt-1 text-xs text-gray-500">
                                                                    <span class="post-time text-sm text-gray-500" data-time="<%= comment.createdAt.toISOString() %>"></span>

                                                                    <!-- <button class="ml-3 hover:text-blue-500">ตอบกลับ</button> -->
                                                                </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                        </div>

                                                        <div class="flex items-center space-x-3">
                                                            <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center">
                                                            <i class="fas fa-user text-white text-sm"></i>
                                                            </div>
                                                            <div class="flex-1">
                                                            <input type="text" placeholder="เขียนความคิดเห็น..."
                                                                class="w-full px-3 py-2 border border-gray-300 rounded-full focus:ring-2 focus:ring-primary focus:border-transparent comment-input"
                                                                data-post-id="<%= post._id %>">
                                                            </div>
                                                            <button
                                                            class="bg-primary text-white px-4 py-2 rounded-full hover:bg-primary-dark transition-colors submit-comment"
                                                            data-post-id="<%= post._id %>">
                                                            <i class="fas fa-paper-plane"></i>
                                                            </button>
                                                        </div>
                                                        </div>
                                                    </div>

                                            </div>
                                            </article>
                                            <% }); %>
                                        </div>
                                    </div>
                            </div>
                        </div>


                        <!-- Sales History Tab -->
                        <div id="sales" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800 mb-6">ประวัติการขายขยะ</h3>
                                <div class="flex space-x-2">
                                    <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                        <option>มกราคม 2568</option>
                                        <!-- เพิ่ม filter ตามเดือนในอนาคตได้ -->
                                    </select>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg border overflow-hidden">
                                <div class="overflow-x-auto">
                                    <table class="w-full">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-4 py-3 text-left font-semibold text-gray-700">วันที่</th>
                                                <th class="px-4 py-3 text-left font-semibold text-gray-700">ประเภทขยะ</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">น้ำหนัก (กก.)</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">ราคา/กก.</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">รายได้</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% 
                                                let totalIncome = 0;
                                                if (wastePurchases && wastePurchases.length > 0) {
                                                wastePurchases.forEach(purchase => {
                                                    let items = purchase.wasteItems || [];
                                                    let isFirstRow = true;

                                                    items.forEach((item, index) => {
                                                    const income = (item.quantity || 0) * (item.pricePerUnit || 0);
                                                    totalIncome += income;
                                            %>
                                                <tr class="border-b hover:bg-gray-50">
                                                    <% if (isFirstRow) { %>
                                                    <td class="px-4 py-3" rowspan="<%= items.length %>">
                                                        <%= new Date(purchase.purchaseDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                                    </td>
                                                    <% } %>
                                                    <td class="px-4 py-3"><%= item.name || 'ไม่ระบุ' %></td>
                                                    <td class="px-4 py-3 text-right"><%= item.quantity?.toFixed(2) || '0.00' %></td>
                                                    <td class="px-4 py-3 text-right"><%= item.pricePerUnit?.toFixed(2) || '0.00' %></td>
                                                    <td class="px-4 py-3 text-right font-semibold text-green-600"><%= income.toFixed(2) %></td>
                                                </tr>
                                            <%
                                                    isFirstRow = false;
                                                    });
                                                });
                                                } else {
                                            %>
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-4">ไม่มีประวัติการขายขยะ</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                        <tfoot class="bg-gray-50">
                                            <tr>
                                                <td colspan="4" class="px-4 py-3 font-semibold text-right">รวมทั้งหมด:</td>
                                                <td class="px-4 py-3 font-bold text-right text-green-600"><%= totalIncome.toFixed(2) %> บาท</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>


                        <!-- Account Book Tab -->
                        <div id="account" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">สมุดบัญชี</h3>
                                <div class="flex space-x-2">
                                    <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                        <option>มกราคม 2568</option>
                                        <!-- เพิ่ม filter ตามเดือนในอนาคตได้ -->
                                    </select>
                                </div>
                            </div>

                            <!-- Summary Cards -->
                            <div class="grid md:grid-cols-3 gap-6 mb-6">
                                <div class="bg-green-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-green-600 text-sm font-semibold">ยอดคงเหลือปัจจุบัน</p>
                                            <p class="text-2xl font-bold text-green-700"><%= wasteBankAccount.Balance.toFixed(2) %> บาท</p>
                                        </div>
                                        <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-coins text-white"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-blue-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-blue-600 text-sm font-semibold">จำนวนครั้งที่ขาย</p>
                                            <p class="text-2xl font-bold text-blue-700"><%= wastePurchases.length %> ครั้ง</p>
                                        </div>
                                        <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-chart-line text-white"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-purple-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-purple-600 text-sm font-semibold">น้ำหนักรวม</p>
                                            <p class="text-2xl font-bold text-purple-700"><%= totalWasteItems %> กก.</p>
                                        </div>
                                        <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-weight text-white"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Transaction History -->
                            <div class="bg-white rounded-lg border overflow-hidden">
                                <div class="px-4 py-3 bg-gray-50 border-b">
                                    <h4 class="font-semibold text-gray-800">รายการธุรกรรม</h4>
                                </div>
                                <div class="divide-y">
                                    <% if (statement.length > 0) { %>
                                        <% statement.forEach(item => { %>
                                            <div class="px-4 py-3 flex justify-between items-center">
                                                <div>
                                                    <p class="font-semibold text-gray-800">
                                                        <%= item.source %>
                                                    </p>
                                                    <p class="text-sm text-gray-600">
                                                        <%= new Date(item.date).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' }) %> 
                                                        เวลา <%= new Date(item.date).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %>
                                                    </p>
                                                </div>
                                                <div class="text-right">
                                                    <p class="font-semibold <%= item.type === 'withdraw' ? 'text-red-600' : 'text-green-600' %>">
                                                        <%= item.type === 'withdraw' ? '-' : '+' %><%= item.amount.toFixed(2) %> บาท
                                                    </p>
                                                    <p class="text-sm text-gray-600">
                                                        <%= item.type === 'withdraw' ? 'ถอนจากบัญชี' : 'โอนเข้าบัญชี' %>
                                                    </p>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="px-4 py-6 text-center text-gray-500">
                                            ยังไม่มีรายการธุรกรรม
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <div class="content container py-5">
        <!-- Profile Header -->
        <div class="profile-header row align-items-center">
            <div class="col-md-3 text-center">
                <img src="/img/avatar.png" alt="รูปโปรไฟล์" class="profile-img mb-3">
                <h4 class="mb-0"><%= username %></h4>
                <p class="text-muted">สมาชิกกองทุนขยะรีไซเคิล</p>
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-6">
                        <p><i class="fas fa-home me-2"></i><strong>ที่อยู่:</strong> <%= address.houseNumber %> หมู่ <%= address.moo %> ต.<%= address.subdistrict %> อ.<%= address.district %> จ.<%= address.province %> <%= address.postalCode %></p>
                        <p><i class="fas fa-phone me-2"></i><strong>เบอร์โทร:</strong> </p>
                        <p><i class="fas fa-envelope me-2"></i><strong>อีเมล:</strong> </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>หมายเลขบัญชี:</strong> <%= wasteBankAccount ? wasteBankAccount.AccountNumber : '-' %></p>
                        <p><i class="fas fa-calendar me-2"></i><strong>วันที่เข้าร่วมเป็นสมาชิก:</strong> <%= createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %> </p>
                        <!-- <p><i class="fas fa-recycle me-2"></i><strong>จำนวนครั้งที่ขายขยะ:</strong> 24 ครั้ง</p> -->
                        <div class="d-flex mt-3">
                            <button class="btn btn-success action-btn" data-bs-toggle="modal" data-bs-target="#wasteHistoryModal">
                                <i class="fas fa-history me-2"></i>ประวัติการขายขยะ
                            </button>
                            <button class="btn btn-primary action-btn" data-bs-toggle="modal" data-bs-target="#accountBookModal">
                                <i class="fas fa-book me-2"></i>สมุดบัญชี
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content Tabs -->
        <ul class="nav nav-tabs mt-5" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="family-tab" data-bs-toggle="tab" data-bs-target="#family" type="button" role="tab" aria-controls="family" aria-selected="true">
                    <i class="fas fa-users me-2"></i>สมาชิกในครอบครัว
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requests" type="button" role="tab" aria-controls="requests" aria-selected="false">
                    <i class="fas fa-clipboard-list me-2"></i>ประวัติการแจ้งความประสงค์
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="complaints-tab" data-bs-toggle="tab" data-bs-target="#complaints" type="button" role="tab" aria-controls="complaints" aria-selected="false">
                    <i class="fas fa-exclamation-circle me-2"></i>ประวัติคำร้องเรียน
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="ideas-tab" data-bs-toggle="tab" data-bs-target="#ideas" type="button" role="tab" aria-controls="ideas" aria-selected="false">
                    <i class="fas fa-lightbulb me-2"></i>ไอเดียการจัดการขยะ
                </button>
            </li>
        </ul>
        
        <div class="tab-content" id="profileTabsContent">
            <!-- Family Members Tab -->
            <div class="tab-pane fade show active" id="family" role="tabpanel" aria-labelledby="family-tab">
                <h4 class="section-title">สมาชิกในครอบครัว</h4>
                <div class="row">
                    <% members.forEach(function(member) { %>
                        <div class="col-md-4">
                            <div class="card family-card">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <img src="/img/avatar2.png" alt="รูปสมาชิก" class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                        <div>
                                            <h5 class="card-title mb-0"><%= member.name %></h5>
                                            <span class="badge bg-info badge-status">ตัวแทนสมาชิกในครัวเรือน</span>
                                        </div>
                                    </div>
                                    <p class="card-text"><i class="fas fa-phone me-2"></i><%= member.phone %></p>
                                    <p class="card-text"><i class="fas fa-calendar me-2"></i>อายุ: <%= member.age %></p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <!-- <div class="text-center mt-3">
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addFamilyModal">
                        <i class="fas fa-plus me-2"></i>เพิ่มสมาชิกในครอบครัว
                    </button>
                </div> -->
            </div>

            
            <!-- Complaints Tab -->
            <div class="tab-pane fade" id="complaints" role="tabpanel" aria-labelledby="complaints-tab">
                <h4 class="section-title">ประวัติคำร้องเรียน</h4>
                <div class="row">
                    <% complaints.forEach((com) => { %>
                    <div class="col-md-6">
                        <div class="card history-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <!-- <span><i class="fas fa-exclamation-circle me-2 text-warning"></i>เลขที่คำร้อง: CM20230001</span> -->
                                <span class="badge bg-warning">รอดำเนินการ</span>
                            </div>
                            <div class="card-body">
                                <p class="card-text"><%= com.complaintMessage %></p>
                                <p class="text-muted"><i class="fas fa-calendar me-2"></i>วันที่แจ้ง: <%= com.createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                <!-- <button class="btn btn-sm btn-outline-info">ดูรายละเอียด</button> -->
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <div class="text-center mt-3">
                    <a href="/user/complaint"><button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newComplaintModalyy">
                        <i class="fas fa-plus me-2"></i>แจ้งคำร้องเรียนใหม่
                    </button></a>
                </div>
            </div>
            
            <!-- Ideas Tab -->
            <div class="tab-pane fade" id="ideas" role="tabpanel" aria-labelledby="ideas-tab">
                <h4 class="section-title">ไอเดียการจัดการขยะของคุณ</h4>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card idea-card">
                            <img src="/img/shoe_bin.png" class="card-img-top" alt="ไอเดียรีไซเคิล" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">การทำกระถางต้นไม้จากขวดพลาสติก</h5>
                                <p class="card-text">วิธีการนำขวดพลาสติกมาทำเป็นกระถางปลูกต้นไม้แบบแขวน ช่วยประหยัดพื้นที่และสวยงาม</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted"><i class="fas fa-calendar me-1"></i>15 ม.ค. 2566</small>
                                    <div>
                                        <span class="me-2"><i class="fas fa-heart text-danger"></i> 24</span>
                                        <span><i class="fas fa-comment text-primary"></i> 8</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent">
                                <button class="btn btn-sm btn-outline-primary w-100">อ่านเพิ่มเติม</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card idea-card">
                            <img src="/img/idea-recycle.png" class="card-img-top" alt="ไอเดียรีไซเคิล" style="height: 200px; object-fit: cover;">
