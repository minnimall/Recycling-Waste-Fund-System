<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/userPartials/head.ejs') %>
    <style>
        /* Custom animations */
        @keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
            }
            50% {
                box-shadow: 0 0 30px rgba(255, 255, 255, 0.5);
            }
        }

        .bg-gradient-to-br {
            animation: pulse-glow 3s ease-in-out infinite;
        }

        /* Progress bar animation */
        @keyframes fill-progress {
            from {
                width: 0%;
            }
        }

        .bg-gradient-to-r.from-yellow-300 {
            animation: fill-progress 1.5s ease-out;
        }

        /* Hover effects */
        .group:hover i {
            transform: scale(1.1);
            transition: transform 0.3s ease;
        }
    </style>
</head>
<body>
    <%- include('../partials/userPartials/header.ejs') %>
    <!-- Profile Header -->
    <section class="bg-gradient-to-r from-primary-green to-secondary-green text-white py-16">
        <div class="container mx-auto px-4">
            <!-- Main Profile Card -->
            <div class="bg-white/10 backdrop-blur-md rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
                <div class="p-6 md:p-8">
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
                        <!-- Avatar -->
                        <div class="relative">
                            <div class="w-28 h-28 md:w-32 md:h-32 rounded-full border-4 border-white/30 shadow-xl overflow-hidden bg-white/20 backdrop-blur-sm">
                                <img src="/img/avatar.png" alt="รูปโปรไฟล์" class="w-full h-full object-cover">
                            </div>
                            <!-- <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-green-400 rounded-full border-4 border-white flex items-center justify-center shadow-lg">
                                <i class="fas fa-check text-white text-sm"></i>
                            </div> -->
                        </div>

                        <!-- Profile Info -->
                        <div class="flex-1 text-center md:text-left">
                            <h1 class="text-3xl md:text-4xl font-bold mb-2 text-white drop-shadow-lg">
                                <%= familyName %>
                            </h1>
                            <!-- <p class="text-white/80 text-sm md:text-base mb-4 flex items-center justify-center md:justify-start gap-2">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>สมาชิกกองทุนขยะรีไซเคิล</span>
                            </p> -->

                            <!-- Membership Status Cards -->
                            <div class="mt-6">
                                <% if (wasteBankAccount.MembershipDate && wasteBankAccount.IsMember) { %>
                                    <!-- สมาชิกเต็มสิทธิ์ -->
                                    <div class="">  <!-- bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl p-5 shadow-lg border border-green-400/50 -->
                                        <div class="flex items-center gap-4">
                                            <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                                                <i class="fas fa-award text-white text-2xl"></i>
                                            </div>
                                            <div class="flex-1 text-left">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <h3 class="font-bold text-white text-lg">สมาชิกกองทุนขยะรีไซเคิล</h3>
                                                    <!-- <span class="px-2 py-0.5 bg-white/30 rounded-full text-xs font-semibold">
                                                        <i class="fas fa-shield-check mr-1"></i>ยืนยันแล้ว
                                                    </span> -->
                                                </div>
                                                <!-- <p class="text-white/90 text-sm">
                                                    <i class="far fa-calendar-alt mr-1"></i>
                                                    เป็นสมาชิกกองุทนขยะรีไซเคิลตั้งแต่: <%= new Date(wasteBankAccount.MembershipDate).toLocaleDateString('th-TH', { 
                                                        day: 'numeric', 
                                                        month: 'short', 
                                                        year: 'numeric' 
                                                    }) %>
                                                </p> -->
                                                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                                                    <span class="px-3 py-1 bg-white/20 rounded-full">
                                                        <i class="fas fa-check-circle mr-1"></i>สิทธิ์ฌาปนกิจ
                                                    </span>
                                                    <span class="px-3 py-1 bg-white/20 rounded-full">
                                                        <i class="fas fa-coins mr-1"></i>สิทธิ์ถอนเงิน
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                <% } else if (wasteBankAccount.MembershipDate && !wasteBankAccount.IsMember) { %>
                                    <!-- พักสิทธิ์ชั่วคราว -->
                                    <div class="bg-red-500 rounded-xl p-5 shadow-lg border border-orange-400/50">
                                        <div class="flex items-center gap-4">
                                            <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                                                <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
                                            </div>
                                            <div class="flex-1 text-left">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <h3 class="font-bold text-white text-lg">พักสิทธิ์ชั่วคราว</h3>
                                                    <span class="px-2 py-0.5 bg-white/30 rounded-full text-xs font-semibold">
                                                        <i class="fas fa-pause-circle mr-1"></i>รอดำเนินการ
                                                    </span>
                                                </div>
                                                <!-- <p class="text-white/90 text-sm mb-2">
                                                    <i class="far fa-calendar-alt mr-1"></i>
                                                    สมาชิกตั้งแต่: <%= new Date(wasteBankAccount.MembershipDate).toLocaleDateString('th-TH', { 
                                                        day: 'numeric', 
                                                        month: 'short', 
                                                        year: 'numeric' 
                                                    }) %>
                                                </p> -->
                                                <div class="bg-white/20 rounded-lg p-3 backdrop-blur-sm">
                                                    <p class="text-white text-sm font-medium mb-1">
                                                        <i class="fas fa-info-circle mr-1"></i>วิธีกลับมาเป็นสมาชิก
                                                    </p>
                                                    <p class="text-white/80 text-xs">
                                                        ขายขยะให้ยอดคงเหลือเกิน 300 บาท สิทธิ์จะกลับมาอัตโนมัติ
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                <% } else { %>
                                    <!-- ยังไม่เป็นสมาชิก -->
                                    <% 
                                        const salesTarget = 300;
                                        const currentSales = wasteBankAccount.TotalSalesAmount || 0;
                                        const remaining = salesTarget - currentSales;
                                        const progress = Math.min((currentSales / salesTarget) * 100, 100);
                                    %>
                                    <div class="bg-gradient-to-r from-gray-500 to-slate-600 rounded-xl p-5 shadow-lg border border-gray-400/50">
                                        <div class="flex items-center gap-4">
                                            <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                                                <i class="fas fa-hourglass-half text-white text-2xl"></i>
                                            </div>
                                            <div class="flex-1 text-left">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <h3 class="font-bold text-white text-lg">กำลังสะสมเป็นสมาชิก</h3>
                                                    <span class="px-2 py-0.5 bg-white/30 rounded-full text-xs font-semibold">
                                                        <i class="fas fa-chart-line mr-1"></i><%= progress.toFixed(0) %>%
                                                    </span>
                                                </div>
                                                <p class="text-white/90 text-sm mb-3">
                                                    ขายขยะสะสม: <span class="font-bold"><%= currentSales.toFixed(2) %></span> / <%= salesTarget %> บาท
                                                </p>
                                                
                                                <!-- Progress Bar -->
                                                <div class="relative">
                                                    <div class="w-full bg-white/30 rounded-full h-3 overflow-hidden shadow-inner">
                                                        <div class="bg-gradient-to-r from-yellow-300 to-yellow-400 h-full rounded-full transition-all duration-500 shadow-lg" 
                                                            style="width: <%= progress %>%">
                                                        </div>
                                                    </div>
                                                    <div class="absolute -top-8 left-0 right-0 flex justify-between text-xs text-white/70">
                                                        <!-- <span>0</span>
                                                        <span><%= salesTarget %> บาท</span> -->
                                                    </div>
                                                </div>

                                                <div class="mt-3 bg-white/20 rounded-lg p-3 backdrop-blur-sm">
                                                    <% if (remaining > 0) { %>
                                                        <p class="text-white text-sm font-medium">
                                                            <!-- <i class="fas fa-bullseye mr-2"></i> -->
                                                            อีกเพียง <span class="text-yellow-300 font-bold"><%= remaining.toFixed(2) %></span> บาท
                                                        </p>
                                                        <p class="text-white/80 text-xs mt-1">
                                                            คุณจะได้รับสิทธิ์เป็นสมาชิกกองทุนขยะรีไซเคิล
                                                        </p>
                                                    <% } else { %>
                                                        <p class="text-white text-sm font-medium">
                                                            <i class="fas fa-check-circle text-yellow-300 mr-2"></i>
                                                            ยินดีด้วย! คุณครบเงื่อนไขแล้ว
                                                        </p>
                                                        <p class="text-white/80 text-xs mt-1">
                                                            ระบบกำลังอัพเดทสถานะของคุณ
                                                        </p>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Bar -->
                <div class="bg-white/5 border-t border-white/10 px-6 md:px-8 py-4">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                        <div class="group hover:bg-white/10 rounded-lg p-2 transition-all">
                            <i class="fas fa-wallet text-2xl text-white/70 mb-1 group-hover:text-white transition-colors"></i>
                            <p class="text-white/60 text-xs mb-1">ยอดคงเหลือ</p>
                            <p class="text-white font-bold text-lg"><%= wasteBankAccount.Balance.toFixed(2) %> ฿</p>
                        </div>
                        <div class="group hover:bg-white/10 rounded-lg p-2 transition-all">
                            <i class="fas fa-chart-line text-2xl text-white/70 mb-1 group-hover:text-white transition-colors"></i>
                            <p class="text-white/60 text-xs mb-1">ยอดขายสะสม</p>
                            <p class="text-white font-bold text-lg"><%= (wasteBankAccount.TotalSalesAmount || 0).toFixed(2) %> ฿</p>
                        </div>
                        <div class="group hover:bg-white/10 rounded-lg p-2 transition-all">
                            <i class="fas fa-users text-2xl text-white/70 mb-1 group-hover:text-white transition-colors"></i>
                            <p class="text-white/60 text-xs mb-1">สมาชิกในครอบครัว</p>
                            <p class="text-white font-bold text-lg"><%= numFamilyMembers %> คน</p>
                        </div>
                        <div class="group hover:bg-white/10 rounded-lg p-2 transition-all">
                            <i class="fas fa-calendar-check text-2xl text-white/70 mb-1 group-hover:text-white transition-colors"></i>
                            <p class="text-white/60 text-xs mb-1">เป็นสมาชิกกองทุนเมื่อ</p>
                            <% if (wasteBankAccount.MembershipDate) { %>
                                <% 
                                    const membershipDate = new Date(wasteBankAccount.MembershipDate);
                                    const today = new Date();
                                    const diffTime = Math.abs(today - membershipDate);
                                    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                                    const diffMonths = Math.floor(diffDays / 30);
                                    const isEligible = diffDays >= 180;
                                %>
                                <p class="text-white font-bold text-base mb-1">
                                    <%= membershipDate.toLocaleDateString('th-TH', { 
                                        day: 'numeric', 
                                        month: 'short', 
                                        year: 'numeric' 
                                    }) %>
                                </p>
                                <div class="mt-1">
                                    <p class="text-xs <%= isEligible ? 'text-green-300' : 'text-yellow-300' %> font-semibold">
                                        <i class="fas <%= isEligible ? 'fa-check-circle' : 'fa-clock' %> mr-1"></i>
                                        <%= diffDays %> วัน (<%= diffMonths %> เดือน)
                                    </p>
                                    <% if (isEligible) { %>
                                        <p class="text-[10px] text-green-200 mt-0.5">
                                            ✓ มีสิทธิ์ยื่นฌาปนกิจ
                                        </p>
                                    <% } else { %>
                                        <% const remainingDays = 180 - diffDays; %>
                                        <p class="text-[10px] text-yellow-200 mt-0.5">
                                            อีก <%= remainingDays %> วัน
                                            มีสิทธิ์ยื่นฌาปนกิจ
                                        </p>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <p class="text-white/50 text-sm">ยังไม่เป็นสมาชิก</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Modal Post -->
    <div id="ideaModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden">
        <div class="bg-white w-full max-w-2xl mx-4 rounded-lg shadow-lg p-6 relative">
            <!-- ปุ่มปิด -->
            <button id="closeModalBtn"
            class="absolute top-3 right-4 text-gray-600 hover:text-red-600 text-xl">&times;</button>

            <% if (locals.session && locals.session.username) { %>
            <h2 class="text-xl font-semibold text-primary-green mb-4">แบ่งปันไอเดียของคุณ</h2>
            <form id="create-post-form" class="space-y-4" action="/user/ideas/create" method="POST"
                enctype="multipart/form-data">
                <div>
                <input type="text" name="title" placeholder="หัวข้อไอเดีย..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                    required>
                </div>
                <div>
                <select name="category"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                    required>
                    <option value="">เลือกหมวดหมู่</option>
                    <option value="reduce">ลดการใช้</option>
                    <option value="reuse">นำกลับมาใช้</option>
                    <option value="recycle">รีไซเคิล</option>
                    <option value="diy">DIY/ทำเอง</option>
                    <option value="community">โครงการชุมชน</option>
                    <option value="other">อื่นๆ</option>
                </select>
                </div>
                <div>
                <textarea name="content" rows="4" placeholder="เล่าไอเดียของคุณ..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                    required></textarea>
                </div>
                <div>
                <div id="img-box" class="hidden w-full my-2 relative">
                    <button type="button" onclick="clearImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
                    <img id="image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
                </div>
                <input type="file" id="image" name="image" accept="image/*"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
                </div>
                <script>
                // Preview รูป
                const fileInput = document.querySelector('input[name="image"]');
                const preview = document.getElementById('image-preview');
                const box_img = document.getElementById('img-box');
                const image_input = document.getElementById('image');

                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                    preview.src = URL.createObjectURL(file);
                    preview.classList.remove('hidden');
                    box_img.classList.remove('hidden');
                    } else {
                    preview.src = '';
                    preview.classList.add('hidden');
                    }
                });

                function clearImg() {
                    preview.src = '';
                    image_input.value = '';
                    box_img.classList.add('hidden');
                }
                </script>

                <div class="flex justify-end">
                <button type="submit"
                    class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                    <i class="fas fa-paper-plane mr-2"></i>แบ่งปันไอเดีย
                </button>
                </div>
            </form>
            <% } else { %>
                <div class="text-center text-red-600 font-semibold">
                กรุณาเข้าสู่ระบบก่อนเพื่อแบ่งปันไอเดียของคุณ
                </div>
                <% } %>
        </div>
    </div>

    <!-- Edit Model -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
        <div class="bg-white p-6 rounded-lg w-full max-w-lg shadow-lg relative">
            <h2 class="text-lg font-semibold mb-4">แก้ไขโพสต์</h2>
            <form id="editPostForm">
            <input type="hidden" id="editPostId">

            <div class="mb-4">
                <label class="block mb-1 font-medium">หัวข้อ</label>
                <input type="text" id="editTitle" class="w-full border px-3 py-2 rounded" required>
            </div>
            <div class="mb-4">
                <label class="block mb-1 font-medium">หมวดหมู่</label>
                <select id="editCategory" class="w-full border px-3 py-2 rounded">
                <option value="reduce">ลดการใช้</option>
                <option value="reuse">นำกลับมาใช้</option>
                <option value="recycle">รีไซเคิล</option>
                <option value="diy">DIY/ทำเอง</option>
                <option value="community">โครงการชุมชน</option>
                <option value="other">อื่นๆ</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block mb-1 font-medium">เนื้อหา</label>
                <textarea id="editContent" rows="4" class="w-full border px-3 py-2 rounded" required></textarea>
            </div>


            <div>
                <div id="edit-img-box" class="hidden w-full my-2 relative">
                <button type="button" onclick="clearEditImg()" class="absolute right-0 text-red-600 pt-2 pr-4">X</button>
                <img id="edit-image-preview" class="w-full rounded-lg border h-64 object-cover border-gray-300" />
                </div>
                <input type="file" id="editImage" name="image" accept="image/*"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                <p class="text-sm text-gray-500 mt-1">เพิ่มรูปภาพประกอบ (ไม่บังคับ)</p>
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="closeEditModal()"
                class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">ยกเลิก</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">บันทึก</button>
            </div>
            </form>
        </div>
    </div>

    <!-- Profile Content -->
    <section class="py-8">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <!-- Tab Navigation -->
                <div class="bg-white rounded-lg shadow-lg mb-6">
                    <!-- <div class="border-b border-gray-200 overflow-x-auto">
                        <nav class="flex flex-nowrap min-w-max">
                            <button class="tab-btn active px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-primary border-b-2 border-primary font-semibold whitespace-nowrap" data-tab="personal">
                                <i class="fas fa-user mr-1 md:mr-2"></i>ข้อมูลส่วนตัว
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="family">
                                <i class="fas fa-users mr-1 md:mr-2"></i>สมาชิกครอบครัว
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="requests">
                                <i class="fas fa-clipboard-list mr-1 md:mr-2"></i>ประวัติแจ้งความประสงค์
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="complaints">
                                <i class="fas fa-exclamation-triangle mr-1 md:mr-2"></i>ประวัติคำร้องเรียน
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="ideas">
                                <i class="fas fa-lightbulb mr-1 md:mr-2"></i>ไอเดียของฉัน
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="sales">
                                <i class="fas fa-shopping-cart mr-1 md:mr-2"></i>ประวัติการขาย
                            </button>
                            <button class="tab-btn px-4 md:px-6 py-3 md:py-4 text-sm md:text-base text-gray-500 hover:text-primary transition-colors whitespace-nowrap" data-tab="account">
                                <i class="fas fa-book mr-1 md:mr-2"></i>สมุดบัญชี
                            </button>
                        </nav>
                    </div> -->
                    <div class="border-b border-gray-200">
                        <nav class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8">
                            
                            <!-- ข้อมูลส่วนตัว -->
                            <button
                                class="tab-btn active
                                    px-2 py-3
                                    text-[10px] md:text-xs
                                    text-primary font-semibold
                                    border-b-2 border-primary
                                    flex flex-col items-center gap-1 text-center
                                    transition"
                                data-tab="personal">
                                <i class="fas fa-user text-base md:text-lg"></i>
                                <span class="leading-tight">ข้อมูลส่วนตัว</span>
                            </button>

                            <!-- สมาชิกครอบครัว -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="family">
                                <i class="fas fa-users text-base md:text-lg"></i>
                                <span class="leading-tight">สมาชิกครอบครัว</span>
                            </button>

                            <!-- ประสงค์ขายขยะ -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="requests">
                                <i class="fas fa-clipboard-list text-base md:text-lg"></i>
                                <span class="leading-tight">ประสงค์ขายขยะ</span>
                            </button>

                            <!-- คำร้องเรียน -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="complaints">
                                <i class="fas fa-exclamation-triangle text-base md:text-lg"></i>
                                <span class="leading-tight">คำร้องเรียน</span>
                            </button>

                            <!-- ไอเดียของฉัน -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="ideas">
                                <i class="fas fa-lightbulb text-base md:text-lg"></i>
                                <span class="leading-tight">ไอเดียของฉัน</span>
                            </button>

                            <!-- ประวัติการขายขยะ -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="sales">
                                <i class="fas fa-shopping-cart text-base md:text-lg"></i>
                                <span class="leading-tight">ประวัติการขายขยะ</span>
                            </button>

                            <!-- สมุดบัญชี -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="account">
                                <i class="fas fa-book text-base md:text-lg"></i>
                                <span class="leading-tight">สมุดบัญชี</span>
                            </button>

                            <!-- คำขอฌาปนกิจ -->
                            <button
                                class="tab-btn px-2 py-3
                                    text-[10px] md:text-xs
                                    text-gray-500 hover:text-primary
                                    border-b-2 border-transparent hover:border-primary transition
                                    flex flex-col items-center gap-1 text-center"
                                data-tab="funeral">
                                <i class="fa-solid fa-ribbon text-base md:text-lg"></i>
                                <span class="leading-tight">คำขอฌาปนกิจ</span>
                            </button>
                        </nav>
                    </div>

                    <!-- Tab Content -->
                    <div class="p-6">
                        <!-- Personal Information Tab -->
                        <div id="personal" class="tab-content">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">ข้อมูลส่วนตัว</h3>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6">
                                <% members.forEach(function(member) { %>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">ชื่อ-นามสกุล</label>
                                        <input type="text" value="<%= member.name %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">เลขประจำตัวประชาชน</label>
                                        <div class="relative">
                                            <input type="text" 
                                                class="idCardInput w-full px-4 py-2 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" 
                                                data-original="<%= member.idCardNumber %>"
                                                value="<%= member.idCardNumber %>"
                                                readonly>
                                            <button type="button" 
                                                    onclick="toggleIdCardVisibility(this)" 
                                                    class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-gray-500 hover:text-gray-700 transition-colors rounded-lg hover:bg-gray-100">
                                                <i class="eyeIcon fas fa-eye-slash text-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">เบอร์โทรศัพท์</label>
                                        <input type="tel" value="<%= member.phone %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">อีเมล</label>
                                        <input type="email" value="<%= member.email %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                </div>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">ที่อยู่</label>
                                        <textarea rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent resize-none" readonly>บ้านเลขที่ <%= address.houseNumber %> หมู่ <%= village.villageNumber %> (<%= village.villageName %>) ตำบล <%= address.subdistrict %> อำเภอ <%= address.district %> จังหวัด <%= address.province %> รหัสไปรษณีย์ <%= address.postalCode %>
                                        </textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">เลขบัญชี</label>
                                        <input type="text" value="<%= wasteBankAccount ? wasteBankAccount.AccountNumber : '-' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">วันที่เข้าร่วมกองทุน</label>
                                        <input type="text" value="<%= createdAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" readonly>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                            <!-- <div class="mt-6 flex justify-end">
                                <button class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                    <i class="fas fa-save mr-2"></i>บันทึกข้อมูล
                                </button>
                            </div> -->
                        </div>

                        <!-- Family Members Tab -->
                        <div id="family" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">สมาชิกในครอบครัว</h3>
                                <!-- <button class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                                    <i class="fas fa-plus mr-2"></i>เพิ่มสมาชิก
                                </button> -->
                            </div>
                            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                                
                            <% members.forEach(function(member) { %>
                                <!-- สมาชิก -->
                                <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                    <div class="flex items-center space-x-3 mb-3">
                                        <div class="w-12 h-12 bg-green-700 rounded-full flex items-center justify-center">
                                            <i class="fas fa-female text-white"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold"><%= member.name %></h4>
                                            <p class="text-sm text-gray-600">ตัวแทนสมาชิกครอบครัว</p>
                                        </div>
                                    </div>
                                    <div class="text-sm text-gray-600 space-y-1">
                                        <!-- <p><i class="fas fa-phone mr-2"></i> -->เบอร์โทรศัพท์ : <%= member.phone %></p>
                                        <!-- <p>อายุ : <%= member.age %> ปี</p> -->
                                    </div>
                                </div>

                                <% 
                                    function translateDistribution(type) {
                                        switch(type) {
                                            case 'full': return 'รับเต็มจำนวน';
                                            case 'equal': return 'แบ่งเท่ากัน';
                                            case 'other': return 'อื่นๆ';
                                            default: return type;
                                        }
                                    }
                                %>

                                <!-- ผู้รับผลประโยชน์ -->
                                <% if (member.beneficiaries && member.beneficiaries.length > 0) { %>
                                    <% member.beneficiaries.forEach(function(beneficiary) { %>
                                        <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                            <div class="flex items-center space-x-3 mb-3">
                                                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                                                    <i class="fas fa-child text-white"></i>
                                                </div>
                                                <div>
                                                    <h4 class="font-semibold"><%= beneficiary.name %></h4>
                                                    <p class="text-sm text-gray-600"><%= beneficiary.relation %></p>
                                                </div>
                                            </div>
                                            <div class="mt-2 flex items-center">
                                                <% 
                                                    const isDeceased = beneficiary.status === 'deceased';
                                                    // กำหนดสีและไอคอนตามสถานะ
                                                    const badgeColor = isDeceased 
                                                        ? 'bg-gray-100 text-gray-500 border-gray-200' // สีเทาสำหรับผู้เสียชีวิต
                                                        : 'bg-green-100 text-green-700 border-green-200'; // สีเขียวสำหรับผู้มีชีวิต
                                                        
                                                    const iconClass = isDeceased 
                                                        ? 'fa-user-xmark' // ไอคอนริบบิ้นไว้อาลัย
                                                        : 'fa-user-check'; // ไอคอนชีพจรหัวใจ
                                                        
                                                    const textLabel = isDeceased ? 'เสียชีวิตแล้ว' : 'มีชีวิตอยู่';
                                                %>
                                                
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border <%= badgeColor %>">
                                                    <i class="fas <%= iconClass %> mr-1.5"></i>
                                                    <%= textLabel %>
                                                </span>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-gray-500 italic">ไม่มีข้อมูลผู้รับผลประโยชน์</p>
                                <% } %>
                            <% }) %>
                            </div>
                        </div>

                        <!-- Waste Sale Requests Tab -->
                        <div id="requests" class="tab-content hidden">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-5">
                                <h3 class="text-lg md:text-xl font-semibold text-gray-800">ประวัติการแจ้งความประสงค์ขายขยะ</h3>
                                <a href="/user/wasteSaleRequest" class="w-full sm:w-auto">
                                    <button class="w-full sm:w-auto px-3 md:px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 text-sm md:text-base whitespace-nowrap" data-bs-toggle="modal" data-bs-target="#newComplaintModalyy">
                                        <i class="fas fa-plus mr-1 md:mr-2"></i>แจ้งประสงค์ขายขยะใหม่
                                    </button>
                                </a>
                            </div>
                            
                            <div class="space-y-4">
                                <% if (wasteSaleRequests.length > 0) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <% wasteSaleRequests.forEach((request) => { %>
                                        <div class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
                                            <!-- Validating Status -->
                                            <% 
                                                let statusColor = "gray";
                                                let statusText = "ไม่ทราบสถานะ";
                                                let icon = "fa-question-circle";
                                                
                                                if (request.status === 'pending') {
                                                    statusColor = "yellow";
                                                    statusText = "รอการอนุมัติ";
                                                    icon = "fa-hourglass-start";
                                                } else if (request.status === 'confirmed') {
                                                    statusColor = "blue";
                                                    statusText = "รอรถเข้ารับ";
                                                    icon = "fa-truck-pickup";
                                                } else if (request.status === 'in-progress') {
                                                    statusColor = "indigo";
                                                    statusText = "กำลังดำเนินการ";
                                                    icon = "fa-spinner fa-spin";
                                                } else if (request.status === 'completed' || request.status === 'complete') {
                                                    statusColor = "green";
                                                    statusText = "เสร็จสิ้น";
                                                    icon = "fa-check-circle";
                                                } else if (request.status === 'rejected' || request.status.includes('CANCEL')) {
                                                    statusColor = "red";
                                                    statusText = "ยกเลิก/ปฏิเสธ";
                                                    icon = "fa-times-circle";
                                                }
                                            %>
                                            
                                            <!-- Card Header -->
                                            <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex justify-between items-center">
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <i class="far fa-calendar-alt"></i>
                                                    <%= request.createdAt.toLocaleDateString('th-TH', { year: '2-digit', month: 'short', day: 'numeric' }) %>
                                                    <span class="text-xs">• <%= request.createdAt.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.</span>
                                                </div>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= statusColor %>-100 text-<%= statusColor %>-800 border border-<%= statusColor %>-200">
                                                    <i class="fas <%= icon %> mr-1.5"></i><%= statusText %>
                                                </span>
                                            </div>

                                            <!-- Card Body -->
                                            <div class="p-4">
                                                <div class="flex gap-4">
                                                    <!-- Image Thumbnail -->
                                                    <div class="flex-shrink-0">
                                                        <% if (request.img) { %>
                                                            <div class="relative w-20 h-20 rounded-lg overflow-hidden border border-gray-200 group-hover:border-primary/50 transition-colors cursor-pointer" onclick="showImageModal('<%= request.img %>')">
                                                                <img src="<%= request.img %>" alt="ขยะ" class="w-full h-full object-cover">
                                                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                                                    <i class="fas fa-search-plus text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-md"></i>
                                                                </div>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="w-20 h-20 rounded-lg bg-gray-100 flex items-center justify-center text-gray-400 border border-gray-200">
                                                                <i class="fas fa-image text-2xl"></i>
                                                            </div>
                                                        <% } %>
                                                    </div>

                                                    <!-- Content -->
                                                    <div class="flex-1 min-w-0">
                                                        <h5 class="text-sm font-bold text-gray-800 mb-1 truncate">รายการขยะที่แจ้งขาย</h5>
                                                        <div class="flex flex-wrap gap-1 mb-2">
                                                            <% request.waste.forEach((w) => { %>
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
                                                                    <%= w.wasteName %>
                                                                </span>
                                                            <% }); %>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Officer Response / Pickup Info -->
                                                <div class="mt-4 pt-3 border-t border-gray-100 text-xs">
                                                    <% if (request.approvePickupDate) { %>
                                                        <div class="flex items-center gap-2 mb-1.5 text-blue-600 font-medium">
                                                            <i class="fas fa-truck border p-1 rounded bg-blue-50"></i>
                                                            <span>นัดรับ: <%= new Date(request.approvePickupDate).toLocaleDateString('th-TH', { year: '2-digit', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %> น.</span>
                                                        </div>
                                                    <% } %>
                                                    
                                                    <% if (request.responseMessage) { %>
                                                        <div class="bg-gray-50 rounded p-2 text-gray-600 flex gap-2">
                                                            <i class="fas fa-comment-dots mt-0.5 text-gray-400"></i>
                                                            <span>"<%= request.responseMessage %>"</span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                    </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div class="text-center py-10 bg-white rounded-xl border border-dashed border-gray-300">
                                        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                                            <i class="fas fa-inbox text-gray-400 text-2xl"></i>
                                        </div>
                                        <h3 class="text-gray-900 font-medium">ยังไม่มีรายการแจ้งขาย</h3>
                                        <p class="text-gray-500 text-sm mt-1 mb-4">คุณสามารถแจ้งขายขยะได้ที่เมนู "แจ้งความประสงค์"</p>
                                        <a href="/user/wasteSaleRequest" class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
                                            <i class="fas fa-plus mr-2"></i>แจ้งขายขยะ
                                        </a>
                                    </div>
                                <% } %>   
                            </div>
                        </div> 
                        
                        <!-- Complaints Tab -->
                        <div id="complaints" class="tab-content hidden">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-5">
                                <h3 class="text-lg md:text-xl font-semibold text-gray-800">ประวัติคำร้องเรียน</h3>
                                <a href="/user/complaint" class="w-full sm:w-auto">
                                    <button class="w-full sm:w-auto px-3 md:px-4 py-2 bg-green-700 text-white rounded-md hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 text-sm md:text-base whitespace-nowrap">
                                        <i class="fas fa-plus mr-1 md:mr-2"></i>แจ้งคำร้องเรียนใหม่
                                    </button>
                                </a>
                            </div>

                            <div class="space-y-4">
                                <% if (complaints && complaints.length > 0) { %>
                                    <div class="grid grid-cols-1 gap-4">
                                    <% complaints.forEach((com) => { %>
                                        <div class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
                                            <div class="p-5">
                                                <!-- Header: Status & Date -->
                                                <div class="flex justify-between items-start mb-4">
                                                    <div class="flex items-center gap-3">
                                                        <% 
                                                            let iconClass = 'fa-circle-info';
                                                            let bgClass = 'bg-gray-100';
                                                            let textClass = 'text-gray-600';
                                                            let label = 'อื่นๆ';

                                                            if (com.category === 'waste') {
                                                                iconClass = 'fa-recycle';
                                                                bgClass = 'bg-green-100';
                                                                textClass = 'text-green-700';
                                                                label = 'การจัดการขยะ';
                                                            } else if (com.category === 'service') {
                                                                iconClass = 'fa-user-nurse';
                                                                bgClass = 'bg-blue-100';
                                                                textClass = 'text-blue-700';
                                                                label = 'การบริการ';
                                                            } else if (com.category === 'noise') {
                                                                iconClass = 'fa-volume-high';
                                                                bgClass = 'bg-orange-100';
                                                                textClass = 'text-orange-700';
                                                                label = 'เสียงรบกวน';
                                                            } else if (com.category === 'sale') {
                                                                iconClass = 'fa-hand-holding-dollar';
                                                                bgClass = 'bg-purple-100';
                                                                textClass = 'text-purple-700';
                                                                label = 'การขายขยะ';
                                                            }
                                                        %>
                                                        <div class="w-10 h-10 rounded-full <%= bgClass %> flex items-center justify-center flex-shrink-0">
                                                            <i class="fas <%= iconClass %> <%= textClass %>"></i>
                                                        </div>
                                                        <div>
                                                            <h4 class="font-bold text-gray-800 text-base"><%= label %></h4>
                                                            <span class="text-xs text-gray-400">
                                                                <i class="far fa-calendar-alt mr-1"></i>
                                                                <%= com.createdAt.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' }) %>
                                                                <%= com.createdAt.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %> น.
                                                            </span>
                                                        </div>
                                                    </div>
                                                    
                                                    <% if (com.status === 'pending') { %>
                                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-700 border border-yellow-200 flex items-center gap-1">
                                                            <span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>
                                                            รอดำเนินการ
                                                        </span>
                                                    <% } else if (com.status === 'in-progress') { %>
                                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1">
                                                            <i class="fas fa-spinner fa-spin text-xs"></i>
                                                            กำลังดำเนินการ
                                                        </span>
                                                    <% } else if (com.status === 'resolved') { %>
                                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200 flex items-center gap-1">
                                                            <i class="fas fa-check-circle text-xs"></i>
                                                            เสร็จสิ้น
                                                        </span>
                                                    <% } else { %>
                                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                                            <%= com.status %>
                                                        </span>
                                                    <% } %>
                                                </div>

                                                <!-- Content -->
                                                <div class="bg-gray-50 rounded-lg p-4 mb-4 border border-gray-100">
                                                    <p class="text-gray-700 text-sm whitespace-pre-line leading-relaxed"><%= com.complaintMessage %></p>
                                                </div>

                                                <!-- Image -->
                                                <% if (com.image) { %>
                                                    <div class="mb-4">
                                                        <div class="relative group cursor-pointer overflow-hidden rounded-lg border border-gray-200 w-fit" onclick="showImageModal('<%= com.image %>')">
                                                            <img src="<%= com.image %>" alt="หลักฐานประกอบ" class="h-24 w-auto object-cover transition-transform duration-500 group-hover:scale-105">
                                                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                                                <i class="fas fa-search-plus text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-md"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } %>

                                                <!-- Agent Reply -->
                                                <% if (com.reply && com.reply.length > 0) { %>
                                                    <div class="mt-4 pt-4 border-t border-gray-100">
                                                        <div class="flex items-start gap-3">
                                                            <div class="w-8 h-8 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                                <i class="fas fa-user-headset text-indigo-600 text-sm"></i>
                                                            </div>
                                                            <div class="flex-1">
                                                                <div class="flex justify-between items-center mb-1">
                                                                    <span class="text-sm font-bold text-gray-800">เจ้าหน้าที่ตอบกลับ</span>
                                                                    <span class="text-[10px] text-gray-400">
                                                                        <%= new Date(com.reply[com.reply.length - 1].createdAt).toLocaleDateString('th-TH') %>
                                                                    </span>
                                                                </div>
                                                                <div class="text-sm text-gray-600 bg-indigo-50/50 p-3 rounded-tr-xl rounded-br-xl rounded-bl-xl border border-indigo-50">
                                                                    <%= com.reply[com.reply.length - 1].replyMessage %>
                                                                </div>
                                                                <% if (com.reply.length > 1) { %>
                                                                    <button onclick="toggleReplies('<%= com._id %>')" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium mt-2 flex items-center gap-1 transition-colors">
                                                                        <span>ดูการตอบกลับทั้งหมด (<%= com.reply.length %>)</span>
                                                                        <i class="fas fa-chevron-down text-[10px]"></i>
                                                                    </button>
                                                                    
                                                                    <!-- Hidden Replies -->
                                                                    <div id="more-replies-<%= com._id %>" class="hidden mt-3 space-y-3 pl-4 border-l-2 border-indigo-100">
                                                                        <% com.reply.slice(0, com.reply.length - 1).forEach(r => { %>
                                                                            <div class="relative">
                                                                                <div class="flex justify-between items-center mb-1">
                                                                                    <span class="text-xs font-semibold text-gray-700">
                                                                                        <%= r.employee ? r.employee.firstname : 'เจ้าหน้าที่' %>
                                                                                    </span>
                                                                                    <span class="text-[10px] text-gray-400">
                                                                                        <%= new Date(r.createdAt).toLocaleDateString('th-TH') %>
                                                                                    </span>
                                                                                </div>
                                                                                <p class="text-xs text-gray-600"><%= r.replyMessage %></p>
                                                                            </div>
                                                                        <% }) %>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <div class="mt-3 flex items-center gap-2 text-xs text-gray-400 bg-gray-50/50 p-2 rounded-lg">
                                                        <i class="fas fa-hourglass-start"></i>
                                                        <span>รอเจ้าหน้าที่รับเรื่องและตรวจสอบ</span>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                    </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div class="text-center py-12">
                                        <div class="mx-auto h-24 w-24 text-gray-300 mb-4">
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </div>
                                        <h3 class="text-lg font-medium text-gray-700 mb-2">ยังไม่มีคำร้องเรียน</h3>
                                        <p class="text-gray-500 mb-6">คุณยังไม่เคยแจ้งคำร้องเรียนในระบบ</p>
                                        <!-- <a href="/user/complaint">
                                            <button class="px-6 py-3 bg-green-700 text-white rounded-md hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                                <i class="fas fa-plus mr-2"></i>แจ้งคำร้องเรียนแรก
                                            </button>
                                        </a> -->
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Image Modal -->
                        <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 hidden">
                            <div class="relative max-w-4xl max-h-full p-4">
                                <button onclick="closeImageModal()" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10">
                                    <i class="fas fa-times text-2xl"></i>
                                </button>
                                <img id="modalImage" src="" alt="รูปภาพขยาย" class="max-w-full max-h-full object-contain rounded-lg">
                            </div>
                        </div>

                        <!-- My Ideas Tab -->
                        <div id="ideas" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-4 md:mb-6">
                                <h3 class="text-lg md:text-xl font-semibold text-gray-800">ไอเดียการจัดการขยะของฉัน</h3>
                            </div>
                            
                            <!-- Filter Section -->
                            <section class="py-2 md:py-4">
                                <div class="container mx-auto px-0">
                                    <div class="flex flex-wrap gap-2 md:gap-3">
                                        <button
                                            class="idea-filter bg-primary-green text-white px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-secondary-green transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="all">ทั้งหมด</button>
                                        <button
                                            class="idea-filter bg-gray-200 text-gray-700 px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-gray-300 transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="reduce">ลดการใช้</button>
                                        <button
                                            class="idea-filter bg-gray-200 text-gray-700 px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-gray-300 transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="reuse">นำกลับมาใช้</button>
                                        <button
                                            class="idea-filter bg-gray-200 text-gray-700 px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-gray-300 transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="recycle">รีไซเคิล</button>
                                        <button
                                            class="idea-filter bg-gray-200 text-gray-700 px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-gray-300 transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="diy">DIY/ทำเอง</button>
                                        <button
                                            class="idea-filter bg-gray-200 text-gray-700 px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-gray-300 transition-colors text-sm md:text-base whitespace-nowrap"
                                            data-category="community">โครงการชุมชน</button>
                                        <button id="openModalBtn"
                                            class="bg-primary-green text-white px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-primary-dark transition text-sm md:text-base whitespace-nowrap">
                                            <i class="fas fa-plus mr-1 md:mr-2"></i> เพิ่มไอเดียใหม่
                                        </button>
                                    </div>
                                </div>
                            </section>
                            
                            <div class="grid gap-4 md:gap-6">
                                <div class="container mx-auto px-0">
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="posts-container">
                                <% posts.forEach(post => { %>
                                <article class="idea-post bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col h-full group"
                                    data-category="<%= post.category %>" data-post-id="<%= post._id %>">
                                    
                                    <!-- Card Header -->
                                    <div class="p-5 border-b border-gray-100 flex justify-between items-start">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-teal-500 rounded-full flex items-center justify-center flex-shrink-0 shadow-sm text-white font-bold text-sm">
                                                <%= post.authorId?.familyName ? post.authorId.familyName.charAt(0).toUpperCase() : 'U' %>
                                            </div>
                                            <div>
                                                <h3 class="font-bold text-gray-800 text-sm leading-tight">
                                                    <%= post.authorId?.familyName || 'ไม่ระบุชื่อ' %>
                                                </h3>
                                                <div class="flex items-center gap-2 text-xs text-gray-500 mt-0.5">
                                                    <span class="post-time" data-time="<%= post.createdAt.toISOString() %>"></span>
                                                    <span>•</span>
                                                    <% 
                                                        const categories = { 
                                                            reduce: { label: 'ลดการใช้', color: 'bg-red-100 text-red-700' },
                                                            reuse: { label: 'นำกลับมาใช้', color: 'bg-yellow-100 text-yellow-700' },
                                                            recycle: { label: 'รีไซเคิล', color: 'bg-green-100 text-green-700' },
                                                            diy: { label: 'DIY/ทำเอง', color: 'bg-purple-100 text-purple-700' },
                                                            community: { label: 'โครงการชุมชน', color: 'bg-blue-100 text-blue-700' },
                                                            other: { label: 'อื่นๆ', color: 'bg-gray-100 text-gray-700' }
                                                        };
                                                        const cat = categories[post.category] || categories['other'];
                                                    %>
                                                    <span class="px-2 py-0.5 rounded-full font-medium <%= cat.color %>">
                                                        <%= cat.label %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <% if (user && post.authorId && user._id.toString() === post.authorId._id.toString()) { %>
                                            <div class="relative ml-2">
                                                <button type="button"
                                                    class="text-gray-400 hover:text-gray-600 focus:outline-none dropdown-toggle p-1 rounded-full hover:bg-gray-100 transition-colors"
                                                    data-dropdown-id="dropdown-<%= post._id %>">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <!-- Dropdown Menu -->
                                                <div id="dropdown-<%= post._id %>"
                                                    class="absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-xl shadow-lg hidden z-50 overflow-hidden">
                                                    <button onclick="openEditModal(
                                                        '<%= post._id %>',
                                                        '<%= post.title %>',
                                                        '<%= post.content %>',
                                                        '<%= post.category %>',
                                                        '<%= post.imageUrl %>'
                                                    )" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition-colors flex items-center gap-2">
                                                        <i class="fas fa-pen text-xs"></i> แก้ไขโพสต์
                                                    </button>
                                                    <button data-post-id="<%= post._id %>"
                                                        onclick="deleteIdeas('<%= post._id %>', '<%= post.title %>')"
                                                        class="delete-post-btn w-full text-left px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center gap-2">
                                                        <i class="fas fa-trash-alt text-xs"></i> ลบโพสต์
                                                    </button>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Card Content -->
                                    <div class="p-5 flex-1">
                                        <h2 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 hover:text-primary transition-colors cursor-pointer">
                                            <%= post.title %>
                                        </h2>
                                        <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                                            <%= post.content %>
                                        </p>

                                        <% if (post.imageUrl && post.imageUrl !== "no_image") { %>
                                            <div class="relative rounded-lg overflow-hidden border border-gray-100 group cursor-pointer" onclick="showImageModal('<%= post.imageUrl %>')">
                                                <img src="<%= post.imageUrl %>" alt="รูปภาพประกอบ" 
                                                    class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105">
                                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                                    <i class="fas fa-search-plus text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-md text-xl"></i>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Card Footer (Actions) -->
                                    <div class="p-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                                        <div class="flex items-center gap-4">
                                            <% let liked = false; 
                                            if (typeof user !== 'undefined' && user && user._id) {
                                                liked = post.likes.some(id => id.toString() === user._id.toString());
                                            } %>
                                            <button
                                                class="like-btn flex items-center gap-1.5 text-gray-500 hover:text-red-500 transition-all active:scale-95 group/like"
                                                data-post-id="<%= post._id %>" type="button">
                                                <div class="p-1.5 rounded-full group-hover/like:bg-red-50 transition-colors">
                                                    <i class="<%= liked ? 'fas text-red-500' : 'far' %> fa-heart text-lg transition-transform group-active/like:scale-125"></i>
                                                </div>
                                                <span class="like-count text-sm font-medium <%= liked ? 'text-red-500' : '' %>">
                                                    <%= post.likes.length %>
                                                </span>
                                            </button>
                                            
                                            <button
                                                class="comment-btn flex items-center gap-1.5 text-gray-500 hover:text-blue-500 transition-all active:scale-95 group/comment"
                                                data-post-id="<%= post._id %>" type="button">
                                                <div class="p-1.5 rounded-full group-hover/comment:bg-blue-50 transition-colors">
                                                    <i class="far fa-comment-alt text-lg"></i>
                                                </div>
                                                <span class="comment-count text-sm font-medium">
                                                    <%= post.comments.length %>
                                                </span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Comments Section (Hidden by default) -->
                                    <div class="comments-section bg-gray-50 border-t border-gray-200 hidden" id="comments-<%= post._id %>">
                                        <div class="p-4 space-y-4">
                                            <!-- Comment List -->
                                            <div class="space-y-3 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
                                                <% if (post.comments.length > 0) { %>
                                                    <% post.comments.forEach(comment => { %>
                                                        <div class="flex gap-3">
                                                            <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0 text-gray-500 text-xs">
                                                                <%= comment.author.familyName ? comment.author.familyName.charAt(0).toUpperCase() : 'U' %>
                                                            </div>
                                                            <div class="flex-1 bg-white p-3 rounded-lg rounded-tl-none border border-gray-100 shadow-sm">
                                                                <div class="flex justify-between items-center mb-1">
                                                                    <span class="font-bold text-xs text-gray-800"><%= comment.author.familyName || 'ไม่ระบุ' %></span>
                                                                    <span class="text-[10px] text-gray-400 post-time" data-time="<%= comment.createdAt.toISOString() %>"></span>
                                                                </div>
                                                                <p class="text-sm text-gray-600"><%= comment.content %></p>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                <% } else { %>
                                                    <div class="text-center py-4 text-gray-400 text-sm">ยังไม่มีความคิดเห็น</div>
                                                <% } %>
                                            </div>

                                            <!-- Comment Input -->
                                            <div class="flex items-center gap-2 pt-2 border-t border-gray-200">
                                                <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center flex-shrink-0 text-white text-xs shadow-sm">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div class="flex-1 relative">
                                                    <input type="text" placeholder="แสดงความคิดเห็น..."
                                                        class="w-full pl-4 pr-10 py-2 bg-white border border-gray-300 rounded-full focus:ring-2 focus:ring-primary focus:border-transparent text-sm transition-shadow comment-input"
                                                        data-post-id="<%= post._id %>">
                                                    <button
                                                        class="submit-comment absolute right-1 top-1 w-8 h-8 bg-primary text-white rounded-full hover:bg-primary-dark transition-all flex items-center justify-center active:scale-90"
                                                        data-post-id="<%= post._id %>">
                                                        <i class="fas fa-paper-plane text-xs"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                                <% }); %>
                            </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sales History Tab -->
                        <div id="sales" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800 mb-6">ประวัติการขายขยะ</h3>
                                <div class="flex space-x-2">
                                    <select id="salesMonthFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                    </select>
                                </div>
                            </div>    
                            <!-- Summary Cards -->
                            <div class="grid md:grid-cols-2 gap-6 mb-6">

                                <div class="bg-blue-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-blue-600 text-sm font-semibold">จำนวนครั้งที่ขาย</p>
                                            <p class="text-2xl font-bold text-blue-700" id="wasteSaleCount">0 ครั้ง</p>
                                        </div>
                                        <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-chart-line text-white"></i>
                                        </div>
                                    </div>
                                </div>

                            <div class="bg-purple-50 rounded-lg p-4">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-purple-600 text-sm font-semibold">น้ำหนักรวม</p>
                                        <p class="text-2xl font-bold text-purple-700" id="totalWeightSales">0 กก.</p>
                                    </div>
                                    <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center">
                                        <i class="fas fa-weight text-white"></i>
                                    </div>
                                </div>
                            </div>
                            </div>
                            <div class="bg-white rounded-lg border overflow-hidden">
                                <div class="overflow-x-auto">
                                    <table class="w-full">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-4 py-3 text-left font-semibold text-gray-700">วันที่</th>
                                                <th class="px-4 py-3 text-left font-semibold text-gray-700">ประเภทขยะ</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">น้ำหนัก (กก.)</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">ราคา/กก.</th>
                                                <th class="px-4 py-3 text-right font-semibold text-gray-700">รายได้</th>
                                            </tr>
                                        </thead>
                                        <tbody id="salesTableBody">
                                            <!-- JS จะเติมข้อมูลตรงนี้ -->
                                        </tbody>
                                        <tfoot class="bg-gray-50">
                                            <tr>
                                                <td colspan="4" class="px-4 py-3 font-semibold text-right">รวมทั้งหมด:</td>
                                                <td id="totalIncomeCell" class="px-4 py-3 font-bold text-right text-green-600">0.00 บาท</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>


                        <!-- Account Book Tab -->
                        <div id="account" class="tab-content hidden">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-semibold text-gray-800">สมุดบัญชี</h3>
                                <div class="flex space-x-2">
                                    <select id="accountMonthFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                                    </select>
                                </div>
                            </div>

                            <!-- Summary Cards -->
                            <div class="grid md:grid-cols-3 gap-6 mb-6">
                                <div class="bg-emerald-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-emerald-600 text-sm font-semibold">เลขบัญชี</p>
                                            <p class="text-2xl font-bold text-green-700"><%= wasteBankAccount.AccountNumber %></p>
                                        </div>
                                        <div class="w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-users text-white"></i>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="bg-green-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-green-600 text-sm font-semibold">ยอดคงเหลือ (บาท)</p>
                                            <p class="text-2xl font-bold <%= wasteBankAccount.Balance < 0 ? 'text-red-700' : 'text-green-700' %>" id="balanceCell">
                                                <%= wasteBankAccount.Balance.toFixed(2) %> บาท
                                            </p>
                                            <% if (wasteBankAccount.PendingDeductions > 0) { %>
                                                <p class="text-xs text-orange-600 mt-1">
                                                    <i class="fas fa-exclamation-triangle"></i> 
                                                    ค้างชำระ: <%= wasteBankAccount.PendingDeductions.toFixed(2) %> บาท
                                                </p>
                                            <% } %>
                                        </div>
                                        <div class="w-12 h-12 <%= wasteBankAccount.Balance < 0 ? 'bg-red-500' : 'bg-green-500' %> rounded-full flex items-center justify-center">
                                            <i class="fas fa-coins text-white"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-blue-50 rounded-lg p-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-blue-600 text-sm font-semibold">จำนวนรายการธุรกรรม</p>
                                            <p class="text-2xl font-bold text-blue-700" id="transactionCount">0 รายการ</p>
                                        </div>
                                        <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                                            <i class="fas fa-chart-line text-white"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Transaction History -->
                            <div class="bg-white rounded-lg border overflow-hidden shadow-sm">
                                <div class="px-4 py-3 bg-gradient-to-r from-gray-50 to-gray-100 border-b">
                                    <h4 class="font-semibold text-gray-800 flex items-center">
                                        <i class="fas fa-history mr-2 text-gray-600"></i>
                                        รายการธุรกรรม
