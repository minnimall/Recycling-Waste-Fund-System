                                                                class="bg-primary text-white px-3 md:px-4 py-1.5 md:py-2 rounded-full hover:bg-primary-dark transition-colors flex-shrink-0"
                                                                data-post-id="<%= post._id %>">
                                                                <i class="fas fa-paper-plane text-sm md:text-base"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </article>
                                        <% }); %>
