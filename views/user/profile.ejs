            // ======= Modal Edit =======
            window.openEditModal = function (id, title, content, category, imageUrl = '') {
                document.getElementById('editPostId').value = id;
                document.getElementById('editTitle').value = title;
                document.getElementById('editContent').value = content;
                document.getElementById('editCategory').value = category;

                const editPreview = document.getElementById('edit-image-preview');
                const editBox_img = document.getElementById('edit-img-box');

                if (imageUrl && imageUrl !== '') {
                editPreview.src = imageUrl;
                editBox_img.classList.remove('hidden');
                } else {
                editPreview.src = '';
                editBox_img.classList.add('hidden');
                }

                if (imageUrl == 'no_image') {
                editBox_img.classList.add('hidden');
                }
                document.getElementById('editModal').classList.remove('hidden');
                document.getElementById('editModal').classList.add('flex');
            };

            window.closeEditModal = function () {
                document.getElementById('editModal').classList.remove('flex');
                document.getElementById('editModal').classList.add('hidden');
            };

