    <script>
        const modal = document.getElementById('ideaModal');
        const openBtn = document.getElementById('openModalBtn');
        const closeBtn = document.getElementById('closeModalBtn');

        openBtn.addEventListener('click', () => {
            modal.classList.remove('hidden');
        });

        closeBtn.addEventListener('click', () => {
            modal.classList.add('hidden');
        });

        // ปิด modal เมื่อคลิกพื้นหลัง
        window.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.add('hidden');
            }
        });


        document.addEventListener('DOMContentLoaded', () => {
            // Toggle comments
            document.querySelectorAll('.comment-btn').forEach(button => {
                button.addEventListener('click', () => {
                const postId = button.dataset.postId;
                const commentsSection = document.getElementById(`comments-${postId}`);
                commentsSection.classList.toggle('hidden');
                });
            });

            // Submit comment function (reusable)
            async function submitComment(postId, content, input) {
                try {
                const res = await fetch(`/user/ideas/${postId}/comment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ comment: content })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    // เพิ่ม comment count
                    const commentCountSpan = document.querySelector(`.comment-btn[data-post-id="${postId}"] .comment-count`);
                    commentCountSpan.textContent = parseInt(commentCountSpan.textContent) + 1;

                    // เพิ่ม comment ใหม่ใน section
                    const commentSection = document.querySelector(`#comments-${postId} .space-y-3`);
                    if (commentSection) {
                    const comment = data.comment;
                    const div = document.createElement('div');
                    div.className = 'flex items-start space-x-3';
                    div.innerHTML = `
                        <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                        <i class="fas fa-user text-gray-600 text-sm"></i>
                        </div>
                        <div class="flex-1">
                        <div class="bg-gray-100 rounded-lg p-3">
                            <p class="font-semibold text-sm text-gray-800">${comment.author.familyName || 'ไม่ระบุ'}</p>
                            <p class="text-gray-600 text-sm">${comment.content}</p>
                        </div>
                        <div class="flex items-center mt-1 text-xs text-gray-500">
                            <span>เมื่อกี้</span>
                        </div>
                        </div>
                    `;
                    commentSection.appendChild(div);
                    }

                    input.value = '';
                    document.getElementById(`comments-${postId}`).classList.remove('hidden');

                    Swal.fire('ส่งสำเร็จ!', 'แสดงความคิดเห็นของคุณเรียบร้อยแล้ว', 'success');
                } else {
                    Swal.fire('ผิดพลาด', data.error || 'เกิดข้อผิดพลาด', 'error');
                }
                } catch (err) {

                Swal.fire('ล้มเหลว', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                }
            }

            // Bind submit comment buttons
            document.querySelectorAll('.submit-comment').forEach(button => {
                button.addEventListener('click', () => {
                const postId = button.dataset.postId;
                const input = document.querySelector(`.comment-input[data-post-id="${postId}"]`);
                const content = input.value.trim();

                if (!content) {
                    return Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเขียนความคิดเห็น',
                    confirmButtonText: 'ตกลง'
                    });
                }

                Swal.fire({
                    title: 'ยืนยันการแสดงความคิดเห็น?',
                    text: content,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonText: 'ยืนยัน'
                }).then((result) => {
                    if (result.isConfirmed) {
                    submitComment(postId, content, input);
                    }
                });
                });
            });

            // Submit comment on Enter key
            document.querySelectorAll('.comment-input').forEach(input => {
                input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault(); // ป้องกันขึ้นบรรทัดใหม่
                    const postId = input.dataset.postId;
                    const submitBtn = document.querySelector(`.submit-comment[data-post-id="${postId}"]`);
                    if (submitBtn) submitBtn.click();
                }
                });
            });
            });

            // Submit comment on Enter key
            document.querySelectorAll('.comment-input').forEach(input => {
            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                const postId = input.dataset.postId;
                const submitBtn = document.querySelector(`.submit-comment[data-post-id="${postId}"]`);
                submitBtn.click();
                }
            });
            });

        document.getElementById('create-post-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);

            const title = formData.get('title')?.trim();
            const category = formData.get('category');
            const content = formData.get('content')?.trim();

            if (!title || !category || !content) {
                return Swal.fire({
                icon: 'warning',
                title: 'กรุณากรอกข้อมูลให้ครบถ้วน',
                confirmButtonText: 'ตกลง'
                });
            }

            Swal.fire({
                title: `ยืนยันการส่งไอเดีย "${title}" หรือไม่?`,
                text: "คุณต้องการแบ่งปันไอเดียนี้ใช่หรือไม่",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then(async (result) => {
                if (result.isConfirmed) {
                try {
                    const res = await fetch('/user/ideas/create', {
                    method: 'POST',
                    body: formData
                    });
                    const data = await res.json();

                    if (data.success) {
                    Swal.fire('สำเร็จ!', 'เพิ่มไอเดียเรียบร้อยแล้ว', 'success')
                        .then(() => {
                        location.reload();
                        });
                    } else {
                    Swal.fire('เกิดข้อผิดพลาด', data.error || 'ไม่สามารถเพิ่มไอเดียได้', 'error');
                    }

                } catch (error) {
                    Swal.fire('สำเร็จ!', 'เพิ่มไอเดียเรียบร้อยแล้ว', 'success')
                    .then(() => {
                        location.reload();
                    });
                }
                }
            });
        });

        // Filter functionality
        document.querySelectorAll('.idea-filter').forEach(button => {
            button.addEventListener('click', () => {
                const category = button.dataset.category;

                // Update active button
                document.querySelectorAll('.idea-filter').forEach(btn => {
                btn.classList.remove('bg-primary-green', 'hover:bg-secondary-green', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
                });
                button.classList.remove('bg-gray-200', 'text-gray-700');
                button.classList.add('bg-primary-green', 'hover:bg-secondary-green', 'text-white');

                // Filter posts
                document.querySelectorAll('.idea-post').forEach(post => {
                if (category === 'all' || post.dataset.category === category) {
                    post.style.display = 'block';
                } else {
                    post.style.display = 'none';
                }
                });
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const likeButtons = document.querySelectorAll('.like-btn');

            likeButtons.forEach(button => {
                button.addEventListener('click', async () => {
                const postId = button.getAttribute('data-post-id');

                try {
                    const response = await fetch(`/user/ideas/${postId}/like`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                    });

                    const result = await response.json();
                    if (result.success) {
                    const likeCountSpan = button.querySelector('.like-count');
                    likeCountSpan.textContent = result.likeCount;

                    // เปลี่ยน icon เมื่อถูกกด
                    const icon = button.querySelector('i');
                    icon.classList.toggle('fas', result.liked);
                    icon.classList.toggle('far', !result.liked);
                    icon.classList.toggle('text-red-500', result.liked);
                    } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'กรุณาเข้าสู่ระบบ',
                    });
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด!',
                    text: 'ไม่สามารถกดไลค์ได้ กรุณาลองใหม่ภายหลัง',
                    });
                }
                });
            });
        });
    </script>

    <!-- Delete Script -->
    <script>
        // Toggle dropdown menu
        document.querySelectorAll('.dropdown-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const dropdownId = button.getAttribute('data-dropdown-id');
                const dropdown = document.getElementById(dropdownId);
                dropdown.classList.toggle('hidden');
            });
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', (event) => {
            document.querySelectorAll('.dropdown-toggle').forEach(button => {
                const dropdownId = button.getAttribute('data-dropdown-id');
                const dropdown = document.getElementById(dropdownId);
                if (!button.contains(event.target) && !dropdown.contains(event.target)) {
                dropdown.classList.add('hidden');
                }
            });
        });

        function deleteIdeas(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then((result) => {
                if (result.isConfirmed) {
                fetch('/user/ideas/delete/' + id, {
                    method: 'DELETE',
                    headers: {
                    'Content-Type': 'application/json',
                    },
                })
                    .then(res => res.json())
                    .then(data => {
                    if (data.success) {
                        Swal.fire('ลบข้อมูลสำเร็จ', data.message, 'success')
                        .then(() => {
                            const postElement = document.querySelector(`[data-post-id="${id}"]`);
                            if (postElement) {
                            postElement.classList.add('transition-opacity', 'duration-300', 'opacity-0');
                            setTimeout(() => postElement.remove(), 300);
                            }
                        });
                    } else {
                        Swal.fire('ลบข้อมูลไม่สำเร็จ', data.message, 'error');
                    }
                    })
                    .catch(error => {
                    console.error(error);
                    Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }
    </script>

    <!-- Edit Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          // ======= PREVIEW รูป Edit =======
            const editfileInput = document.getElementById('editImage');
            const editPreview = document.getElementById('edit-image-preview');
            const editBox_img = document.getElementById('edit-img-box');
            const editImage_input = document.getElementById('editImage');

            editfileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                editPreview.src = URL.createObjectURL(file);
                editBox_img.classList.remove('hidden');
            } else {
                editPreview.src = '';
                editBox_img.classList.add('hidden');
            }
            });

            // ทำให้เรียกใช้จาก HTML ได้
            window.clearEditImg = function () {
                editPreview.src = '';
                editImage_input.value = '';
                editBox_img.classList.add('hidden');
            };

            // ======= Modal Edit =======
            window.openEditModal = function (id, title, content, category, imageUrl = '') {
                document.getElementById('editPostId').value = id;
                document.getElementById('editTitle').value = title;
                document.getElementById('editContent').value = content;
                document.getElementById('editCategory').value = category;

                const editPreview = document.getElementById('edit-image-preview');
                const editBox_img = document.getElementById('edit-img-box');

                if (imageUrl && imageUrl !== '') {
                editPreview.src = imageUrl;
                editBox_img.classList.remove('hidden');
                } else {
                editPreview.src = '';
                editBox_img.classList.add('hidden');
                }

                if (imageUrl == 'no_image') {
                editBox_img.classList.add('hidden');
                }
                document.getElementById('editModal').classList.remove('hidden');
                document.getElementById('editModal').classList.add('flex');
            };

            window.closeEditModal = function () {
                document.getElementById('editModal').classList.remove('flex');
                document.getElementById('editModal').classList.add('hidden');
            };

        // ======= Handle Edit Submit =======
        document.getElementById('editPostForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const id = document.getElementById('editPostId').value;
            const title = document.getElementById('editTitle').value;
            const content = document.getElementById('editContent').value;
            const category = document.getElementById('editCategory').value;
            const image = document.getElementById('editImage').files[0];

            const formData = new FormData();
            formData.append('title', title);
            formData.append('content', content);
            formData.append('category', category);
            if (image) formData.append('image', image);

            try {
                const res = await fetch(`/user/ideas/edit/${id}`, {
                    method: 'POST',
                    body: formData
                });

                const result = await res.json();
                if (result.success) {
                    Swal.fire('สำเร็จ', result.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('ล้มเหลว', result.message || 'เกิดข้อผิดพลาดในการแก้ไขโพสต์', 'error');
                }
                } catch (err) {
                console.error(err);
                Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                }
            });
        });
    </script>

    <script>
    /* ==================== Time Ago ==================== */
    function timeAgo(dateString) {
    const now = new Date();
    const posted = new Date(dateString);
    const diffInSeconds = Math.floor((now - posted) / 1000);

    if (diffInSeconds < 60) return `${diffInSeconds} วินาทีที่แล้ว`;
    const diffInMinutes = Math.floor(diffInSeconds / 60);
    if (diffInMinutes < 60) return `${diffInMinutes} นาทีที่แล้ว`;
    const diffInHours = Math.floor(diffInMinutes / 60);
    if (diffInHours < 24) return `${diffInHours} ชั่วโมงที่แล้ว`;
    const diffInDays = Math.floor(diffInHours / 24);
    return `${diffInDays} วันที่แล้ว`;
    }

    document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('.post-time').forEach(el => {
        const isoTime = el.getAttribute('data-time');
        if (isoTime) el.textContent = timeAgo(isoTime);
    });
    });

    /* ==================== Variables ==================== */
    const wastePurchases = <%- JSON.stringify(wastePurchases) %>;
    const statement = <%- JSON.stringify(statement) %>;
    let balance = <%= wasteBankAccount.Balance.toFixed(2) %>;
    const now = new Date();
    const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

    /* ==================== Create Month Options ==================== */
    function createMonthOptions(selectElement) {
        const allOption = document.createElement('option');
        allOption.value = 'all';
        allOption.textContent = 'ทุกเดือน';
        selectElement.appendChild(allOption);

        for(let i=0; i<12; i++){
            const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
            const value = `${d.getMonth()+1}-${d.getFullYear()}`; // "เดือน-ปี"
            const name = `${monthNames[d.getMonth()]} ${d.getFullYear()+543}`; // ปีไทย
            const opt = document.createElement('option');
            opt.value = value;
            opt.textContent = name;
            selectElement.appendChild(opt);
        }
    }

    /* ==================== Sales Table ==================== */
    const salesMonthFilter = document.getElementById('salesMonthFilter');
    createMonthOptions(salesMonthFilter);

    function renderSalesTable(filterMonth = '') {
        const tbody = document.getElementById('salesTableBody');
        tbody.innerHTML = '';
        let totalIncome = 0;
        let totalTransactions = 0;
        let totalWeight = 0;

        // กรองข้อมูลตามเดือน
        const filtered = wastePurchases.filter(purchase => {
            if (!filterMonth) return true;
            const date = new Date(purchase.purchaseDate);
            return `${date.getMonth()+1}-${date.getFullYear()}` === filterMonth;
        });

        if(filtered.length === 0){
            tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-6 text-center text-gray-500">ไม่มีประวัติการขายขยะ</td></tr>`;
            document.getElementById('totalIncomeCell').textContent = '0.00 บาท';
            document.getElementById('wasteSaleCount').textContent = '0 ครั้ง';
            document.getElementById('totalWeightSales').textContent = '0 กก.';
            return;
        }

        filtered.forEach(purchase => {
            const items = purchase.wasteItems || [];
            totalTransactions++; // ✅ นับตามจำนวนวันที่ขาย (purchase)
            items.forEach((item, index) => {
                const quantity = item.quantity || 0;
                const price = item.pricePerUnit || 0;
                const income = quantity * price;
                totalIncome += income;
                totalWeight += quantity;

                tbody.innerHTML += `
                    <tr class="border-b hover:bg-gray-50">
                        ${index === 0 ? `<td class="px-4 py-3" rowspan="${items.length}">${new Date(purchase.purchaseDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}</td>` : ''}
                        <td class="px-4 py-3">${item.name || 'ไม่ระบุ'}</td>
                        <td class="px-4 py-3 text-right">${quantity.toFixed(2)}</td>
                        <td class="px-4 py-3 text-right">${price.toFixed(2)}</td>
                        <td class="px-4 py-3 text-right font-semibold text-green-600">${income.toFixed(2)}</td>
                    </tr>
                `;
            });
        });

        // อัพเดต summary cards
        document.getElementById('totalIncomeCell').textContent = totalIncome.toFixed(2) + ' บาท';
        document.getElementById('wasteSaleCount').textContent = totalTransactions + ' ครั้ง';
        document.getElementById('totalWeightSales').textContent = totalWeight.toFixed(2) + ' กก.';
    }


    salesMonthFilter.addEventListener('change', e => {
        renderSalesTable(e.target.value === 'all' ? '' : e.target.value);
    });

    renderSalesTable();

    /* ==================== Account Book ==================== */
    const accountMonthFilter = document.getElementById('accountMonthFilter');
    createMonthOptions(accountMonthFilter);

    function renderAccountTable(filterMonth = '') {
        const container = document.getElementById('accountTransactions');
        container.innerHTML = '';
        let transactionCount = 0;
        let weightSum = 0;

        const filteredStatement = statement.filter(item => {
            if (!filterMonth) return true;
            const date = new Date(item.date);
            return `${date.getMonth()+1}-${date.getFullYear()}` === filterMonth;
        });

        if(filteredStatement.length === 0){
            container.innerHTML = `<div class="px-4 py-6 text-center text-gray-500">ไม่มีรายการธุรกรรม${filterMonth ? 'ในเดือนที่เลือก' : ''}</div>`;
        } else {
            filteredStatement.forEach(item => {
                transactionCount++;
                if(item.wasteWeight) weightSum += item.wasteWeight;

                // กำหนด icon และสีตาม type
                let iconClass = '';
                let colorClass = '';
                let signText = '';
                let statusBadge = '';

                if (item.type === 'withdraw') {
                    iconClass = 'fas fa-minus';
                    colorClass = 'text-red-600';
                    signText = '-';
                } else if (item.type === 'deposit') {
                    iconClass = 'fas fa-plus';
                    colorClass = 'text-green-600';
                    signText = '+';
                } else if (item.type === 'funeral_deduction') {
                    iconClass = 'fas fa-hand-holding-heart';
                    colorClass = 'text-purple-600';
                    signText = '-';
                    // แสดง badge ถ้าเงินไม่พอ
                    if (item.status === 'insufficient_but_deducted') {
                        statusBadge = '<span class="ml-2 px-2 py-1 text-xs bg-orange-100 text-orange-800 rounded-full">เงินไม่พอ</span>';
                    }
                }

                container.innerHTML += `
                    <div class="px-4 py-3 flex justify-between items-center hover:bg-gray-50 transition-colors">
                        <div class="flex items-start space-x-3">
                            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0 mt-1">
                                <i class="${iconClass} ${colorClass}"></i>
                            </div>
                            <div>
                                <div class="flex items-center">
                                    <p class="font-semibold text-gray-800">${item.source}</p>
                                    ${statusBadge}
                                </div>
                                <p class="text-sm text-gray-600">
                                    ${new Date(item.date).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' })} 
                                    เวลา ${new Date(item.date).toLocaleTimeString('th-TH', { hour:'2-digit', minute:'2-digit' })} น.
                                </p>
                                ${item.details ? `<p class="text-xs text-gray-500 mt-1">${item.details}</p>` : ''}
                                ${item.pendingAmount && item.pendingAmount > 0 ? 
                                    `<p class="text-xs text-orange-600 mt-1">
                                        <i class="fas fa-exclamation-circle"></i> ค้างชำระ: ${item.pendingAmount.toFixed(2)} บาท
                                    </p>` : ''}
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold ${colorClass} text-lg">
                                ${signText}${item.amount.toFixed(2)} <span class="text-sm">บาท</span>
                            </p>
                            <p class="text-xs text-gray-500 mt-1">
                                ${item.type === 'withdraw' ? 'ถอนจากบัญชี' : 
                                item.type === 'deposit' ? 'โอนเข้าบัญชี' : 
                                'หักจากบัญชี'}
                            </p>
                            ${item.balanceAfter !== undefined ? 
                                `<p class="text-xs ${item.balanceAfter < 0 ? 'text-red-500' : 'text-gray-400'} mt-1">
                                    คงเหลือ: ${item.balanceAfter.toFixed(2)} บาท
                                </p>` : ''}
                        </div>
                    </div>
                `;
            });
        }

        // update summary cards
        document.getElementById('balanceCell').textContent = balance.toFixed(2) + ' บาท';
        document.getElementById('transactionCount').textContent = transactionCount + ' รายการ';
        
        // อัพเดท card สำหรับน้ำหนักถ้ามี
        if (document.getElementById('totalWeight')) {
            document.getElementById('totalWeight').textContent = weightSum.toFixed(2) + ' กก.';
        }
    }

    accountMonthFilter.addEventListener('change', e => {
        renderAccountTable(e.target.value === 'all' ? '' : e.target.value);
    });

    renderAccountTable();

    function toggleReplies(id) {
        const moreReplies = document.getElementById(`more-replies-${id}`);
        const btn = document.getElementById(`toggle-btn-${id}`);

        if (moreReplies.classList.contains('hidden')) {
            moreReplies.classList.remove('hidden');
            btn.textContent = 'ซ่อนคำตอบ';
        } else {
            moreReplies.classList.add('hidden');
            btn.textContent = `ดูเพิ่มเติม (${moreReplies.children.length} รายการ)`;
        }
    }
    // ซ่อนเลขบัตรทั้งหมดตั้งแต่เริ่มต้น
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.idCardInput').forEach(function(input) {
                maskIdCard(input);
            });
        });

        // ฟังก์ชันจัดรูปแบบเลขบัตรประชาชนให้มีขีด (Format: X-XXXX-XXXXX-XX-X)
        function formatIdCard(idCard) {
            const cleaned = idCard.replace(/-/g, '');
            
            if (cleaned.length !== 13) {
                return idCard;
            }
            
            return cleaned.charAt(0) + '-' + 
                cleaned.substring(1, 5) + '-' + 
                cleaned.substring(5, 10) + '-' + 
                cleaned.substring(10, 12) + '-' + 
                cleaned.charAt(12);
        }

        function maskIdCard(input) {
            const original = input.dataset.original;
            if (!original) return;
            
            const cleaned = original.replace(/-/g, '');
            
            if (cleaned.length === 13) {
                const masked = 'X-XXXX-XXXXX-' + 
                            cleaned.substring(10, 12) + '-' + 
                            cleaned.charAt(12);
                input.value = masked;
                input.dataset.masked = masked;
                input.dataset.formatted = formatIdCard(original);
            } else {
                const masked = '*'.repeat(Math.max(0, cleaned.length - 4)) + cleaned.slice(-4);
                input.value = masked;
                input.dataset.masked = masked;
                input.dataset.formatted = original;
            }
        }

        function toggleIdCardVisibility(button) {
            try {
                const input = button.parentElement.querySelector('.idCardInput');
                const eyeIcon = button.querySelector('.eyeIcon');
                
                if (!input) {
                    console.error('ไม่พบ input element');
                    return;
                }
                
                const isCurrentlyMasked = input.value === input.dataset.masked;
                
                if (isCurrentlyMasked) {
                    // แสดงเลขจริง
                    input.value = input.dataset.formatted || input.dataset.original;
                    eyeIcon.className = 'eyeIcon fas fa-eye text-lg';
                } else {
                    // ซ่อนเลข
                    maskIdCard(input);
                    eyeIcon.className = 'eyeIcon fas fa-eye-slash text-lg';
                }
            } catch (error) {
                console.error('เกิดข้อผิดพลาด:', error);
            }
        }
    </script>

    <script>
    // ==================== Funeral Requests ==================== 
    let allFuneralRequests = [];
    let currentFuneralFilter = 'all';

    async function loadFuneralRequests() {
        try {
            const response = await fetch('/user/api/funeral/my-requests');
            const result = await response.json();

            document.getElementById('funeralLoadingState').classList.add('hidden');

            if (result.success && result.data.length > 0) {
                allFuneralRequests = result.data;
                document.getElementById('funeralRequestsList').classList.remove('hidden');
                displayFuneralRequests(allFuneralRequests);
            } else {
                document.getElementById('funeralEmptyState').classList.remove('hidden');
            }
        } catch (error) {
            console.error('Error loading funeral requests:', error);
            document.getElementById('funeralLoadingState').classList.add('hidden');
            document.getElementById('funeralEmptyState').classList.remove('hidden');
        }
    }

    function displayFuneralRequests(requests) {
        const container = document.getElementById('funeralRequestsList');
        
        if (requests.length === 0) {
            container.innerHTML = `
                <div class="text-center py-8 bg-gray-50 rounded-lg">
                    <p class="text-gray-500">ไม่พบคำขอในหมวดนี้</p>
                </div>
            `;
            return;
        }

        container.innerHTML = requests.map(req => createFuneralRequestCard(req)).join('');
    }

    function createFuneralRequestCard(request) {
        const statusInfo = getFuneralStatusInfo(request.status);
        const date = new Date(request.createdAt).toLocaleDateString('th-TH', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        const canCancel = request.status === 'pending';

        return `
            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-4 border border-gray-100">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="flex-1">
                        <div class="flex items-start gap-3 mb-3">
                            <div class="w-10 h-10 rounded-full ${statusInfo.bgColor} flex items-center justify-center flex-shrink-0">
                                <i class="${statusInfo.icon} ${statusInfo.iconColor}"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-gray-800">${request.deceasedInfo.name}</h4>
                                <p class="text-sm text-gray-600">ยื่นเรื่อง: ${date}</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 mb-3 text-sm">
                            <div>
                                <span class="text-gray-600">ผู้รับผิดชอบ:</span>
                                <span class="font-medium ml-1">${request.responsiblePerson.name}</span>
                            </div>
                            <div>
                                <span class="text-gray-600">จำนวนเงิน:</span>
                                <span class="font-medium ml-1 text-green-600">${request.financialInfo.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 rounded-full text-xs font-medium ${statusInfo.badgeClass}">
                                ${statusInfo.text}
                            </span>
                            ${request.status === 'rejected' && request.rejectionReason ? `
                                <span class="text-xs text-red-600 bg-red-50 px-2 py-1 rounded">
                                    ${request.rejectionReason}
                                </span>
                            ` : ''}
                        </div>
                    </div>

                    <div class="flex md:flex-col gap-2">
                        <button onclick="viewFuneralDetail('${request._id}')" class="flex-1 md:flex-none px-4 py-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700">
                            ดูรายละเอียด
                        </button>
                        ${canCancel ? `
                            <button onclick="cancelFuneralRequest('${request._id}')" class="flex-1 md:flex-none px-4 py-2 border border-red-300 text-red-600 rounded-lg text-sm hover:bg-red-50">
                                ยกเลิก
                            </button>
                        ` : ''}
                    </div>
                </div>
            </div>
        `;
    }

    function getFuneralStatusInfo(status) {
        const statusMap = {
            pending: {
                text: 'รอตรวจสอบ',
                bgColor: 'bg-amber-100',
                iconColor: 'text-amber-600',
                icon: 'fas fa-clock',
                badgeClass: 'bg-yellow-100 text-yellow-800'
            },
            approved: {
                text: 'อนุมัติแล้ว',
                bgColor: 'bg-green-100',
                iconColor: 'text-green-600',
                icon: 'fas fa-check-circle',
                badgeClass: 'bg-green-100 text-green-800'
            },
            rejected: {
                text: 'ไม่อนุมัติ',
                bgColor: 'bg-red-100',
                iconColor: 'text-red-600',
                icon: 'fas fa-times-circle',
                badgeClass: 'bg-red-100 text-red-800'
            },
            completed: {
                text: 'เสร็จสิ้น',
                bgColor: 'bg-green-100',
                iconColor: 'text-green-600',
                icon: 'fas fa-check-double',
                badgeClass: 'bg-green-100 text-green-800'
            },
            cancelled: {
                text: 'ยกเลิก',
                bgColor: 'bg-gray-100',
                iconColor: 'text-gray-600',
                icon: 'fas fa-ban',
                badgeClass: 'bg-gray-100 text-gray-800'
            }
        };
        return statusMap[status] || statusMap.pending;
    }

    function filterFuneralRequests(status) {
        currentFuneralFilter = status;
        
        document.querySelectorAll('.funeral-filter-btn').forEach(btn => {
            btn.classList.remove('bg-green-700', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
        });
        
        event.target.classList.remove('bg-gray-200', 'text-gray-700');
        event.target.classList.add('bg-green-700', 'text-white');

        const filtered = status === 'all' 
            ? allFuneralRequests 
            : allFuneralRequests.filter(req => req.status === status);
            
        displayFuneralRequests(filtered);
    }

    async function viewFuneralDetail(requestId) {
        try {
            const response = await fetch(`/user/api/funeral/my-requests/${requestId}`);
            const result = await response.json();

            if (result.success) {
                displayFuneralDetailModal(result.data);
            } else {
                Swal.fire('เกิดข้อผิดพลาด', result.message, 'error');
            }
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถโหลดรายละเอียดได้', 'error');
        }
    }

