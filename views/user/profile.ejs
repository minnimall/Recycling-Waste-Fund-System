                                            <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            ลองดู
                                        </button>
                                        <!-- ปุ่มดาวน์โหลด -->
                                        <a href="${url}" download="${documentLabels[key]}.pdf" class="flex-1 px-4 py-2 bg-green-50 text-green-600 border border-green-200 rounded-lg hover:bg-green-100 transition-colors text-sm font-medium text-center">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                            </svg>
                                            ดาวน์โหลด
                                        </a>
                                    ` : `
                                        <!-- รูปภาพ - เปิดในแท็บใหม่ -->
                                        <a href="${url}" target="_blank" rel="noopener noreferrer" class="w-full px-4 py-2 bg-blue-50 text-blue-600 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors text-sm font-medium text-center">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                            เปิดดู
                                        </a>
                                    `}
                                </div>
                            </div>
                        `;
                    });

                    documentsHTML += '</div></div>';
                }
            }
        }

        modalContent.innerHTML = `
            <div class="space-y-6">
                <div class="flex items-start gap-4 pb-4 border-b-2">
                    <div class="flex-1">
                        <h3 class="text-xl font-bold text-gray-800 mb-1">ผู้เสียชีวิต: ${request.deceasedInfo.name}</h3>
                        <p class="text-sm text-gray-500">
                            ยื่นเรื่อง: ${new Date(request.createdAt).toLocaleDateString('th-TH', {year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'})}
                        </p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-sm font-medium ${statusInfo.badgeClass}">
                        ${statusInfo.text}
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-bold text-gray-800 mb-3">ข้อมูลผู้รับผิดชอบ</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">ชื่อ:</span> <span class="font-semibold">${request.responsiblePerson.name}</span></div>
                            <div><span class="text-gray-600">ความสัมพันธ์:</span> <span class="font-semibold">${request.responsiblePerson.relationshipToDeceased}</span></div>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-bold text-gray-800 mb-3">ข้อมูลผู้เสียชีวิต</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">อายุ:</span> <span class="font-semibold">${request.deceasedInfo.age} ปี</span></div>
                            <div><span class="text-gray-600">วันที่เสียชีวิต:</span> <span class="font-semibold">${new Date(request.deceasedInfo.dateOfDeath).toLocaleDateString('th-TH')}</span></div>
                            <div><span class="text-gray-600">สาเหตุ:</span> <span class="font-semibold">${request.deceasedInfo.causeOfDeath}</span></div>
                        </div>
                    </div>

                    <!-- เอกสารประกอบ -->
                    ${documentsHTML}

                    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg p-4 text-white md:col-span-2">
                        <h4 class="text-lg font-semibold mb-3">ข้อมูลการเงิน</h4>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                <p class="text-xs opacity-90">จำนวนเงินทั้งหมด</p>
                                <p class="text-lg font-bold">${request.financialInfo.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</p>
                            </div>
                            ${request.status === 'approved' || request.status === 'completed' ? `
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">หักต่อบัญชี</p>
                                    <p class="text-lg font-bold">${request.financialInfo.perAccountAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</p>
                                </div>
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">จำนวนบัญชี</p>
                                    <p class="text-lg font-bold">${request.financialInfo.totalMemberAccounts}</p>
                                </div>
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">บัญชีที่หักแล้ว</p>
                                    <p class="text-lg font-bold">${request.financialInfo.totalDeductedAccounts}</p>
                                </div>
                            ` : ''}
                        </div>
                    </div>

                    ${request.status === 'rejected' && request.rejectionReason ? `
                        <div class="bg-red-50 rounded-lg p-4 md:col-span-2">
                            <h4 class="font-bold text-gray-800 mb-2">เหตุผลที่ไม่อนุมัติ</h4>
                            <p class="text-sm text-red-700">${request.rejectionReason}</p>
                        </div>
                    ` : ''}
                </div>
            </div>
        `;

        document.getElementById('funeralDetailModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeFuneralDetailModal() {
        document.getElementById('funeralDetailModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    async function cancelFuneralRequest(requestId) {
        const confirmed = await Swal.fire({
            title: 'ยืนยันการยกเลิก?',
            text: 'คุณต้องการยกเลิกคำขอนี้หรือไม่?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'ใช่, ยกเลิก',
            cancelButtonText: 'ไม่',
            confirmButtonColor: '#dc2626'
        });

        if (!confirmed.isConfirmed) return;

        try {
            const response = await fetch(`/user/api/funeral/my-requests/${requestId}/cancel`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const result = await response.json();

            if (result.success) {
                await Swal.fire('ยกเลิกสำเร็จ', result.message, 'success');
                loadFuneralRequests();
            } else {
                throw new Error(result.message);
            }
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', error.message || 'ไม่สามารถยกเลิกคำขอได้', 'error');
        }
    }

    function openPDFModal(url, title) {
        const modal = document.getElementById('pdfViewerModal');
        const iframe = document.getElementById('pdfFrame');
        const titleElement = document.getElementById('pdfTitle');
        
        titleElement.textContent = title;
        
        // ⭐ ใช้ PDF.js viewer จาก Mozilla
        const pdfViewerUrl = `https://mozilla.github.io/pdf.js/web/viewer.html?file=${encodeURIComponent(url)}`;
        iframe.src = pdfViewerUrl;
        
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closePDFModal() {
        const modal = document.getElementById('pdfViewerModal');
        const iframe = document.getElementById('pdfFrame');
        
        modal.classList.add('hidden');
        iframe.src = '';
        document.body.style.overflow = 'auto';
    }

    // ปิด modal เมื่อคลิกนอกพื้นที่
    document.addEventListener('DOMContentLoaded', function() {
        const pdfModal = document.getElementById('pdfViewerModal');
        if (pdfModal) {
            pdfModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closePDFModal();
                }
            });
        }
    });

    // โหลดข้อมูลเมื่อคลิก tab funeral
    document.addEventListener('DOMContentLoaded', function() {
        const funeralTab = document.querySelector('[data-tab="funeral"]');
        if (funeralTab) {
            funeralTab.addEventListener('click', function() {
                if (allFuneralRequests.length === 0) {
                    loadFuneralRequests();
                }
            });
        }
    });

    const tabButtons = document.querySelectorAll('.tab-btn');

    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            // ลบ active ทุกปุ่ม
            tabButtons.forEach(b => {
                b.classList.remove(
                    'active',
                    'text-primary',
                    'border-primary',
                    'font-semibold'
                );
                b.classList.add(
                    'text-gray-500',
                    'border-transparent'
                );
            });

            // ใส่ active ให้ปุ่มที่คลิก
            btn.classList.add(
                'active',
                'text-primary',
                'border-primary',
                'font-semibold'
            );
            btn.classList.remove(
                'text-gray-500',
                'border-transparent'
            );
        });
    });
    </script>
</body>
</html>