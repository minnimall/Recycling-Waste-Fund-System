                console.error(err);
                Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                }
            });
        });
    </script>

    <script>
    /* ==================== Time Ago ==================== */
    function timeAgo(dateString) {
    const now = new Date();
    const posted = new Date(dateString);
    const diffInSeconds = Math.floor((now - posted) / 1000);

    if (diffInSeconds < 60) return `${diffInSeconds} วินาทีที่แล้ว`;
    const diffInMinutes = Math.floor(diffInSeconds / 60);
    if (diffInMinutes < 60) return `${diffInMinutes} นาทีที่แล้ว`;
    const diffInHours = Math.floor(diffInMinutes / 60);
    if (diffInHours < 24) return `${diffInHours} ชั่วโมงที่แล้ว`;
    const diffInDays = Math.floor(diffInHours / 24);
    return `${diffInDays} วันที่แล้ว`;
    }

    document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('.post-time').forEach(el => {
        const isoTime = el.getAttribute('data-time');
        if (isoTime) el.textContent = timeAgo(isoTime);
    });
    });

    /* ==================== Variables ==================== */
    const wastePurchases = <%- JSON.stringify(wastePurchases) %>;
    const statement = <%- JSON.stringify(statement) %>;
    let balance = <%= wasteBankAccount.Balance.toFixed(2) %>;
    const now = new Date();
    const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

    /* ==================== Create Month Options ==================== */
    function createMonthOptions(selectElement) {
        const allOption = document.createElement('option');
        allOption.value = 'all';
        allOption.textContent = 'ทุกเดือน';
        selectElement.appendChild(allOption);

        for(let i=0; i<12; i++){
            const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
            const value = `${d.getMonth()+1}-${d.getFullYear()}`; // "เดือน-ปี"
            const name = `${monthNames[d.getMonth()]} ${d.getFullYear()+543}`; // ปีไทย
            const opt = document.createElement('option');
            opt.value = value;
            opt.textContent = name;
            selectElement.appendChild(opt);
        }
    }

    /* ==================== Sales Table ==================== */
    const salesMonthFilter = document.getElementById('salesMonthFilter');
    createMonthOptions(salesMonthFilter);

    function renderSalesTable(filterMonth = '') {
        const tbody = document.getElementById('salesTableBody');
        tbody.innerHTML = '';
        let totalIncome = 0;
        let totalTransactions = 0;
        let totalWeight = 0;

        // กรองข้อมูลตามเดือน
        const filtered = wastePurchases.filter(purchase => {
            if (!filterMonth) return true;
            const date = new Date(purchase.purchaseDate);
            return `${date.getMonth()+1}-${date.getFullYear()}` === filterMonth;
        });

        if(filtered.length === 0){
            tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-6 text-center text-gray-500">ไม่มีประวัติการขายขยะ</td></tr>`;
            document.getElementById('totalIncomeCell').textContent = '0.00 บาท';
            document.getElementById('wasteSaleCount').textContent = '0 ครั้ง';
            document.getElementById('totalWeightSales').textContent = '0 กก.';
            return;
        }

        filtered.forEach(purchase => {
            const items = purchase.wasteItems || [];
            totalTransactions++; // ✅ นับตามจำนวนวันที่ขาย (purchase)
            items.forEach((item, index) => {
                const quantity = item.quantity || 0;
                const price = item.pricePerUnit || 0;
                const income = quantity * price;
                totalIncome += income;
                totalWeight += quantity;

                tbody.innerHTML += `
                    <tr class="border-b hover:bg-gray-50">
                        ${index === 0 ? `<td class="px-4 py-3" rowspan="${items.length}">${new Date(purchase.purchaseDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}</td>` : ''}
                        <td class="px-4 py-3">${item.name || 'ไม่ระบุ'}</td>
                        <td class="px-4 py-3 text-right">${quantity.toFixed(2)}</td>
                        <td class="px-4 py-3 text-right">${price.toFixed(2)}</td>
                        <td class="px-4 py-3 text-right font-semibold text-green-600">${income.toFixed(2)}</td>
                    </tr>
                `;
            });
        });

        // อัพเดต summary cards
        document.getElementById('totalIncomeCell').textContent = totalIncome.toFixed(2) + ' บาท';
        document.getElementById('wasteSaleCount').textContent = totalTransactions + ' ครั้ง';
        document.getElementById('totalWeightSales').textContent = totalWeight.toFixed(2) + ' กก.';
    }


    salesMonthFilter.addEventListener('change', e => {
        renderSalesTable(e.target.value === 'all' ? '' : e.target.value);
    });

    renderSalesTable();

    /* ==================== Account Book ==================== */
    const accountMonthFilter = document.getElementById('accountMonthFilter');
    createMonthOptions(accountMonthFilter);

    function renderAccountTable(filterMonth = '') {
        const container = document.getElementById('accountTransactions');
        container.innerHTML = '';
        let transactionCount = 0;
        let weightSum = 0;

        const filteredStatement = statement.filter(item => {
            if (!filterMonth) return true;
            const date = new Date(item.date);
            return `${date.getMonth()+1}-${date.getFullYear()}` === filterMonth;
        });

        if(filteredStatement.length === 0){
            container.innerHTML = `<div class="px-4 py-6 text-center text-gray-500">ไม่มีรายการธุรกรรม${filterMonth ? 'ในเดือนที่เลือก' : ''}</div>`;
        } else {
            filteredStatement.forEach(item => {
                transactionCount++;
                if(item.wasteWeight) weightSum += item.wasteWeight;

                // กำหนด icon และสีตาม type
                let iconClass = '';
                let colorClass = '';
                let signText = '';
                let statusBadge = '';

                if (item.type === 'withdraw') {
                    iconClass = 'fas fa-minus';
                    colorClass = 'text-red-600';
                    signText = '-';
                } else if (item.type === 'deposit') {
                    iconClass = 'fas fa-plus';
                    colorClass = 'text-green-600';
                    signText = '+';
                } else if (item.type === 'funeral_deduction') {
                    iconClass = 'fas fa-hand-holding-heart';
                    colorClass = 'text-purple-600';
                    signText = '-';
                    // แสดง badge ถ้าเงินไม่พอ
                    if (item.status === 'insufficient_but_deducted') {
                        statusBadge = '<span class="ml-2 px-2 py-1 text-xs bg-orange-100 text-orange-800 rounded-full">เงินไม่พอ</span>';
                    }
                }

                container.innerHTML += `
                    <div class="px-4 py-3 flex justify-between items-center hover:bg-gray-50 transition-colors">
                        <div class="flex items-start space-x-3">
                            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0 mt-1">
                                <i class="${iconClass} ${colorClass}"></i>
                            </div>
                            <div>
                                <div class="flex items-center">
                                    <p class="font-semibold text-gray-800">${item.source}</p>
                                    ${statusBadge}
                                </div>
                                <p class="text-sm text-gray-600">
                                    ${new Date(item.date).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' })} 
                                    เวลา ${new Date(item.date).toLocaleTimeString('th-TH', { hour:'2-digit', minute:'2-digit' })} น.
                                </p>
                                ${item.details ? `<p class="text-xs text-gray-500 mt-1">${item.details}</p>` : ''}
                                ${item.pendingAmount && item.pendingAmount > 0 ? 
                                    `<p class="text-xs text-orange-600 mt-1">
                                        <i class="fas fa-exclamation-circle"></i> ค้างชำระ: ${item.pendingAmount.toFixed(2)} บาท
                                    </p>` : ''}
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold ${colorClass} text-lg">
                                ${signText}${item.amount.toFixed(2)} <span class="text-sm">บาท</span>
                            </p>
                            <p class="text-xs text-gray-500 mt-1">
                                ${item.type === 'withdraw' ? 'ถอนจากบัญชี' : 
                                item.type === 'deposit' ? 'โอนเข้าบัญชี' : 
                                'หักจากบัญชี'}
                            </p>
                            ${item.balanceAfter !== undefined ? 
                                `<p class="text-xs ${item.balanceAfter < 0 ? 'text-red-500' : 'text-gray-400'} mt-1">
                                    คงเหลือ: ${item.balanceAfter.toFixed(2)} บาท
                                </p>` : ''}
                        </div>
                    </div>
                `;
            });
        }

        // update summary cards
        document.getElementById('balanceCell').textContent = balance.toFixed(2) + ' บาท';
        document.getElementById('transactionCount').textContent = transactionCount + ' รายการ';
        
        // อัพเดท card สำหรับน้ำหนักถ้ามี
        if (document.getElementById('totalWeight')) {
            document.getElementById('totalWeight').textContent = weightSum.toFixed(2) + ' กก.';
        }
    }

    accountMonthFilter.addEventListener('change', e => {
        renderAccountTable(e.target.value === 'all' ? '' : e.target.value);
    });

    renderAccountTable();

    function toggleReplies(id) {
        const moreReplies = document.getElementById(`more-replies-${id}`);
        const btn = document.getElementById(`toggle-btn-${id}`);

        if (moreReplies.classList.contains('hidden')) {
            moreReplies.classList.remove('hidden');
            btn.textContent = 'ซ่อนคำตอบ';
        } else {
            moreReplies.classList.add('hidden');
            btn.textContent = `ดูเพิ่มเติม (${moreReplies.children.length} รายการ)`;
        }
    }
    // ซ่อนเลขบัตรทั้งหมดตั้งแต่เริ่มต้น
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.idCardInput').forEach(function(input) {
                maskIdCard(input);
            });
        });

        // ฟังก์ชันจัดรูปแบบเลขบัตรประชาชนให้มีขีด (Format: X-XXXX-XXXXX-XX-X)
        function formatIdCard(idCard) {
            const cleaned = idCard.replace(/-/g, '');
            
            if (cleaned.length !== 13) {
                return idCard;
            }
            
            return cleaned.charAt(0) + '-' + 
                cleaned.substring(1, 5) + '-' + 
                cleaned.substring(5, 10) + '-' + 
                cleaned.substring(10, 12) + '-' + 
                cleaned.charAt(12);
        }

        function maskIdCard(input) {
            const original = input.dataset.original;
            if (!original) return;
            
            const cleaned = original.replace(/-/g, '');
            
            if (cleaned.length === 13) {
                const masked = 'X-XXXX-XXXXX-' + 
                            cleaned.substring(10, 12) + '-' + 
                            cleaned.charAt(12);
                input.value = masked;
                input.dataset.masked = masked;
                input.dataset.formatted = formatIdCard(original);
            } else {
                const masked = '*'.repeat(Math.max(0, cleaned.length - 4)) + cleaned.slice(-4);
                input.value = masked;
                input.dataset.masked = masked;
                input.dataset.formatted = original;
            }
        }

        function toggleIdCardVisibility(button) {
            try {
                const input = button.parentElement.querySelector('.idCardInput');
                const eyeIcon = button.querySelector('.eyeIcon');
                
                if (!input) {
                    console.error('ไม่พบ input element');
                    return;
                }
                
                const isCurrentlyMasked = input.value === input.dataset.masked;
                
                if (isCurrentlyMasked) {
                    // แสดงเลขจริง
                    input.value = input.dataset.formatted || input.dataset.original;
                    eyeIcon.className = 'eyeIcon fas fa-eye text-lg';
                } else {
                    // ซ่อนเลข
                    maskIdCard(input);
                    eyeIcon.className = 'eyeIcon fas fa-eye-slash text-lg';
                }
            } catch (error) {
                console.error('เกิดข้อผิดพลาด:', error);
            }
        }
    </script>

    <script>
    // ==================== Funeral Requests ==================== 
    let allFuneralRequests = [];
    let currentFuneralFilter = 'all';

    async function loadFuneralRequests() {
        try {
            const response = await fetch('/user/api/funeral/my-requests');
            const result = await response.json();

            document.getElementById('funeralLoadingState').classList.add('hidden');

            if (result.success && result.data.length > 0) {
                allFuneralRequests = result.data;
                document.getElementById('funeralRequestsList').classList.remove('hidden');
                displayFuneralRequests(allFuneralRequests);
            } else {
                document.getElementById('funeralEmptyState').classList.remove('hidden');
            }
        } catch (error) {
            console.error('Error loading funeral requests:', error);
            document.getElementById('funeralLoadingState').classList.add('hidden');
            document.getElementById('funeralEmptyState').classList.remove('hidden');
        }
    }

    function displayFuneralRequests(requests) {
        const container = document.getElementById('funeralRequestsList');
        
        if (requests.length === 0) {
            container.innerHTML = `
                <div class="text-center py-8 bg-gray-50 rounded-lg">
                    <p class="text-gray-500">ไม่พบคำขอในหมวดนี้</p>
                </div>
            `;
            return;
        }

        container.innerHTML = requests.map(req => createFuneralRequestCard(req)).join('');
    }

    function createFuneralRequestCard(request) {
        const statusInfo = getFuneralStatusInfo(request.status);
        const date = new Date(request.createdAt).toLocaleDateString('th-TH', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        const canCancel = request.status === 'pending';

        return `
            <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow p-4 border border-gray-100">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div class="flex-1">
                        <div class="flex items-start gap-3 mb-3">
                            <div class="w-10 h-10 rounded-full ${statusInfo.bgColor} flex items-center justify-center flex-shrink-0">
                                <i class="${statusInfo.icon} ${statusInfo.iconColor}"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-gray-800">${request.deceasedInfo.name}</h4>
                                <p class="text-sm text-gray-600">ยื่นเรื่อง: ${date}</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 mb-3 text-sm">
                            <div>
                                <span class="text-gray-600">ผู้รับผิดชอบ:</span>
                                <span class="font-medium ml-1">${request.responsiblePerson.name}</span>
                            </div>
                            <div>
                                <span class="text-gray-600">จำนวนเงิน:</span>
                                <span class="font-medium ml-1 text-green-600">${request.financialInfo.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 rounded-full text-xs font-medium ${statusInfo.badgeClass}">
                                ${statusInfo.text}
                            </span>
                            ${request.status === 'rejected' && request.rejectionReason ? `
                                <span class="text-xs text-red-600 bg-red-50 px-2 py-1 rounded">
                                    ${request.rejectionReason}
                                </span>
                            ` : ''}
                        </div>
                    </div>

                    <div class="flex md:flex-col gap-2">
                        <button onclick="viewFuneralDetail('${request._id}')" class="flex-1 md:flex-none px-4 py-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700">
                            ดูรายละเอียด
                        </button>
                        ${canCancel ? `
                            <button onclick="cancelFuneralRequest('${request._id}')" class="flex-1 md:flex-none px-4 py-2 border border-red-300 text-red-600 rounded-lg text-sm hover:bg-red-50">
                                ยกเลิก
                            </button>
                        ` : ''}
                    </div>
                </div>
            </div>
        `;
    }

    function getFuneralStatusInfo(status) {
        const statusMap = {
            pending: {
                text: 'รอตรวจสอบ',
                bgColor: 'bg-amber-100',
                iconColor: 'text-amber-600',
                icon: 'fas fa-clock',
                badgeClass: 'bg-yellow-100 text-yellow-800'
            },
            approved: {
                text: 'อนุมัติแล้ว',
                bgColor: 'bg-green-100',
                iconColor: 'text-green-600',
                icon: 'fas fa-check-circle',
                badgeClass: 'bg-green-100 text-green-800'
            },
            rejected: {
                text: 'ไม่อนุมัติ',
                bgColor: 'bg-red-100',
                iconColor: 'text-red-600',
                icon: 'fas fa-times-circle',
                badgeClass: 'bg-red-100 text-red-800'
            },
            completed: {
                text: 'เสร็จสิ้น',
                bgColor: 'bg-green-100',
                iconColor: 'text-green-600',
                icon: 'fas fa-check-double',
                badgeClass: 'bg-green-100 text-green-800'
            },
            cancelled: {
                text: 'ยกเลิก',
                bgColor: 'bg-gray-100',
                iconColor: 'text-gray-600',
                icon: 'fas fa-ban',
                badgeClass: 'bg-gray-100 text-gray-800'
            }
        };
        return statusMap[status] || statusMap.pending;
    }

    function filterFuneralRequests(status) {
        currentFuneralFilter = status;
        
        document.querySelectorAll('.funeral-filter-btn').forEach(btn => {
            btn.classList.remove('bg-green-700', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
        });
        
        event.target.classList.remove('bg-gray-200', 'text-gray-700');
        event.target.classList.add('bg-green-700', 'text-white');

        const filtered = status === 'all' 
            ? allFuneralRequests 
            : allFuneralRequests.filter(req => req.status === status);
            
        displayFuneralRequests(filtered);
    }

    async function viewFuneralDetail(requestId) {
        try {
            const response = await fetch(`/user/api/funeral/my-requests/${requestId}`);
            const result = await response.json();

            if (result.success) {
                displayFuneralDetailModal(result.data);
            } else {
                Swal.fire('เกิดข้อผิดพลาด', result.message, 'error');
            }
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถโหลดรายละเอียดได้', 'error');
        }
    }

    function displayFuneralDetailModal(request) {
        const statusInfo = getFuneralStatusInfo(request.status);
        const modalContent = document.getElementById('funeralModalContent');

        // แปลงชื่อเอกสาร
        const documentLabels = {
            deathCertificate: 'สำเนาใบมรณะบัตร',
            deceasedIdCard: 'สำเนาบัตรประชาชนผู้ตาย',
            deceasedHouseRegistration: 'สำเนาทะเบียนบ้านผู้ตาย',
            applicantIdCard: 'สำเนาบัตรประชาชนผู้ยื่นคำขอ',
            applicantHouseRegistration: 'สำเนาทะเบียนบ้านผู้ยื่นคำขอ'
        };

        let documentsHTML = '';
            
        if (request.documents) {
            console.log('✓ Documents field exists');
                
            const validDocs = Object.entries(request.documents).filter(([key, url]) => {
                const isValid = url && typeof url === 'string' && url.trim() !== '';
                console.log(`  ${key}: ${isValid ? '✓' : '✗'} (${url})`);
                return isValid;
            });
                
            console.log(`Found ${validDocs.length} valid documents`);
                
            if (request.documents) {
                const validDocs = Object.entries(request.documents).filter(([key, url]) => {
                    return url && typeof url === 'string' && url.trim() !== '';
                });
                
                if (validDocs.length > 0) {
                    documentsHTML = `
                        <div class="bg-gray-50 rounded-lg p-6 md:col-span-2">
                            <h4 class="font-bold text-gray-800 mb-4 flex items-center text-base">
                                เอกสารประกอบ (${validDocs.length} ไฟล์)
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    `;

                    validDocs.forEach(([key, url]) => {
                        const isPDF = url.toLowerCase().includes('.pdf') || url.includes('/raw/');
                        
                        const icon = isPDF
                                ? `
                                <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-red-100">
                                    <i class="fa-solid fa-file-pdf text-red-600 text-xl"></i>
                                </div>
                                `
                                : `
                                <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-blue-100">
                                    <i class="fa-solid fa-file-image text-blue-600 text-xl"></i>
                                </div>
                                `;
                        
                        documentsHTML += `
                            <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-all">
                                <div class="flex items-center gap-3 mb-3">
                                    ${icon}
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-800 truncate">
                                            ${documentLabels[key]}
                                        </p>
                                        <p class="text-xs text-gray-500">
                                            ${isPDF ? 'ไฟล์ PDF' : 'ไฟล์รูปภาพ'}
                                        </p>
                                    </div>
                                </div>
                                
                                <div class="flex gap-2">
                                    ${isPDF ? `
                                        <!-- ปุ่มลองดู PDF -->
                                        <button onclick="openPDFModal('${url}', '${documentLabels[key]}')" class="flex-1 px-4 py-2 bg-blue-50 text-blue-600 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors text-sm font-medium">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            เปิดดู
                                        </button>
                                        <!-- ปุ่มดาวน์โหลด -->
                                        <button onclick="downloadPDF('${url}', '${documentLabels[key]}')" class="flex-1 px-4 py-2 bg-green-50 text-green-600 border border-green-200 rounded-lg hover:bg-green-100 transition-colors text-sm font-medium text-center">
                                            <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                            </svg>
                                            ดาวน์โหลด
                                        </button>
                                    ` : `
                                        <!-- รูปภาพ -->
                                        <div class="flex gap-2 w-full">
                                            <!-- เปิดดู -->
                                            <button onclick="openImageModal('${url}', '${documentLabels[key]}')"
                                            class="flex-1 px-4 py-2 bg-blue-50 text-blue-600 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors text-sm font-medium text-center">
                                                <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                เปิดดู
                                            </button>

                                            <!-- ดาวน์โหลด -->
                                            <button
                                                onclick="downloadImage('${url}', '${documentLabels[key]}')"
                                                class="flex-1 px-4 py-2 bg-green-50 text-green-600 border border-green-200 rounded-lg hover:bg-green-100 transition-colors text-sm font-medium text-center">
                                                <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                                </svg>
                                                ดาวน์โหลด
                                            </button>
                                        </div>
                                    `}
                                </div>
                            </div>
                        `;
                    });

                    documentsHTML += '</div></div>';
                }
            }
        }

        modalContent.innerHTML = `
            <div class="space-y-6">
                <div class="flex items-start gap-4 pb-4 border-b-2">
                    <div class="flex-1">
                        <h3 class="text-xl font-bold text-gray-800 mb-1">ผู้เสียชีวิต: ${request.deceasedInfo.name}</h3>
                        <p class="text-sm text-gray-500">
                            ยื่นเรื่อง: ${new Date(request.createdAt).toLocaleDateString('th-TH', {year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'})}
                        </p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-sm font-medium ${statusInfo.badgeClass}">
                        ${statusInfo.text}
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-bold text-gray-800 mb-3">ข้อมูลผู้รับผิดชอบ</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">ชื่อ:</span> <span class="font-semibold">${request.responsiblePerson.name}</span></div>
                            <div><span class="text-gray-600">ความสัมพันธ์:</span> <span class="font-semibold">${request.responsiblePerson.relationshipToDeceased}</span></div>
                        </div>
                    </div>

                    <div class="bg-gray-50 rounded-lg p-4">
                        <h4 class="font-bold text-gray-800 mb-3">ข้อมูลผู้เสียชีวิต</h4>
                        <div class="space-y-2 text-sm">
                            <div><span class="text-gray-600">อายุ:</span> <span class="font-semibold">${request.deceasedInfo.age} ปี</span></div>
                            <div><span class="text-gray-600">วันที่เสียชีวิต:</span> <span class="font-semibold">${new Date(request.deceasedInfo.dateOfDeath).toLocaleDateString('th-TH')}</span></div>
                            <div><span class="text-gray-600">สาเหตุ:</span> <span class="font-semibold">${request.deceasedInfo.causeOfDeath}</span></div>
                        </div>
                    </div>

                    <!-- เอกสารประกอบ -->
                    ${documentsHTML}

                    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg p-4 text-white md:col-span-2">
                        <h4 class="text-lg font-semibold mb-3">ข้อมูลการเงิน</h4>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                <p class="text-xs opacity-90">จำนวนเงินทั้งหมด</p>
                                <p class="text-lg font-bold">${request.financialInfo.totalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</p>
                            </div>
                            ${request.status === 'approved' || request.status === 'completed' ? `
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">หักต่อบัญชี</p>
                                    <p class="text-lg font-bold">${request.financialInfo.perAccountAmount.toLocaleString('th-TH', {minimumFractionDigits: 2})} บาท</p>
                                </div>
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">จำนวนบัญชี</p>
                                    <p class="text-lg font-bold">${request.financialInfo.totalMemberAccounts}</p>
                                </div>
                                <div class="bg-white bg-opacity-20 rounded-lg p-3">
                                    <p class="text-xs opacity-90">บัญชีที่หักแล้ว</p>
                                    <p class="text-lg font-bold">${request.financialInfo.totalDeductedAccounts}</p>
                                </div>
                            ` : ''}
                        </div>
                    </div>

                    ${request.status === 'rejected' && request.rejectionReason ? `
                        <div class="bg-red-50 rounded-lg p-4 md:col-span-2">
                            <h4 class="font-bold text-gray-800 mb-2">เหตุผลที่ไม่อนุมัติ</h4>
                            <p class="text-sm text-red-700">${request.rejectionReason}</p>
                        </div>
                    ` : ''}
                </div>
            </div>
        `;

        document.getElementById('funeralDetailModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeFuneralDetailModal() {
        document.getElementById('funeralDetailModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    async function cancelFuneralRequest(requestId) {
        const confirmed = await Swal.fire({
            title: 'ยืนยันการยกเลิก?',
            text: 'คุณต้องการยกเลิกคำขอนี้หรือไม่?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'ใช่, ยกเลิก',
            cancelButtonText: 'ไม่',
            confirmButtonColor: '#dc2626'
        });

        if (!confirmed.isConfirmed) return;

        try {
            const response = await fetch(`/user/api/funeral/my-requests/${requestId}/cancel`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const result = await response.json();

            if (result.success) {
                await Swal.fire('ยกเลิกสำเร็จ', result.message, 'success');
                loadFuneralRequests();
            } else {
                throw new Error(result.message);
            }
        } catch (error) {
            Swal.fire('เกิดข้อผิดพลาด', error.message || 'ไม่สามารถยกเลิกคำขอได้', 'error');
        }
    }

    function openPDFModal(url, title) {
        const modal = document.getElementById('pdfViewerModal');
        const iframe = document.getElementById('pdfFrame');
        const titleElement = document.getElementById('pdfTitle');
        
        titleElement.textContent = title;
        
        // ⭐ ใช้ PDF.js viewer จาก Mozilla
        const pdfViewerUrl = `https://mozilla.github.io/pdf.js/web/viewer.html?file=${encodeURIComponent(url)}`;
        iframe.src = pdfViewerUrl;
        
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closePDFModal() {
        const modal = document.getElementById('pdfViewerModal');
        const iframe = document.getElementById('pdfFrame');
        
        modal.classList.add('hidden');
        iframe.src = '';
        document.body.style.overflow = 'auto';
    }

    // ปิด modal เมื่อคลิกนอกพื้นที่
    document.addEventListener('DOMContentLoaded', function() {
        const pdfModal = document.getElementById('pdfViewerModal');
        if (pdfModal) {
            pdfModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closePDFModal();
                }
            });
        }
    });

    // ฟังก์ชันดาวน์โหลด PDF
    async function downloadPDF(url, filename) {
        try {
            Swal.fire({
                title: 'กำลังดาวน์โหลด...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const response = await fetch(url);
            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = filename + '.pdf';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(downloadUrl);

            Swal.close();
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ',
                text: 'ดาวน์โหลดไฟล์เรียบร้อย',
                timer: 2000,
                showConfirmButton: false
            });
        } catch (error) {
            console.error('Download error:', error);
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถดาวน์โหลดไฟล์ได้', 'error');
        }
    }

    // ==================== Image Viewer Modal Functions ====================

    let currentImageUrl = '';
    let currentImageTitle = '';

    function openImageModal(url, title) {
        const modal = document.getElementById('imageViewerModal');
        const imageElement = document.getElementById('imageViewerContent');
        const titleElement = document.getElementById('imageTitle');
        
        titleElement.textContent = title;
        imageElement.src = url;
        currentImageUrl = url;
        currentImageTitle = title;
        
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeImageViewerModal() {
        const modal = document.getElementById('imageViewerModal');
        const imageElement = document.getElementById('imageViewerContent');
        
        modal.classList.add('hidden');
        imageElement.src = '';
        document.body.style.overflow = 'auto';
        currentImageUrl = '';
        currentImageTitle = '';
    }

    async function downloadCurrentImage() {
        if (!currentImageUrl) {
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่มีรูปภาพให้ดาวน์โหลด', 'error');
            return;
        }

        try {
            Swal.fire({
                title: 'กำลังดาวน์โหลด...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const response = await fetch(currentImageUrl);
            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);

            const link = document.createElement('a');
            link.href = downloadUrl;
            
            const fileExtension = currentImageUrl.split('.').pop().split('?')[0];
            link.download = (currentImageTitle || 'document') + '.' + fileExtension;
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(downloadUrl);

            Swal.close();
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ',
                text: 'ดาวน์โหลดรูปภาพเรียบร้อย',
                timer: 2000,
                showConfirmButton: false
            });

        } catch (error) {
            console.error('Download error:', error);
            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถดาวน์โหลดรูปภาพได้', 'error');
        }
    }

    // ปิด modal เมื่อคลิกพื้นที่นอก
    document.addEventListener('DOMContentLoaded', function() {
        const imageModal = document.getElementById('imageViewerModal');
        if (imageModal) {
            imageModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeImageViewerModal();
                }
            });
        }
    });

    // ปิด modal ด้วย Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('imageViewerModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeImageViewerModal();
            }
        }
    });

    // โหลดข้อมูลเมื่อคลิก tab funeral
    document.addEventListener('DOMContentLoaded', function() {
        const funeralTab = document.querySelector('[data-tab="funeral"]');
        if (funeralTab) {
            funeralTab.addEventListener('click', function() {
                if (allFuneralRequests.length === 0) {
                    loadFuneralRequests();
                }
            });
        }
    });

    const tabButtons = document.querySelectorAll('.tab-btn');

    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            // ลบ active ทุกปุ่ม
            tabButtons.forEach(b => {
                b.classList.remove(
                    'active',
                    'text-primary',
                    'border-primary',
                    'font-semibold'
                );
                b.classList.add(
                    'text-gray-500',
                    'border-transparent'
                );
            });

            // ใส่ active ให้ปุ่มที่คลิก
            btn.classList.add(
                'active',
                'text-primary',
                'border-primary',
                'font-semibold'
            );
            btn.classList.remove(
                'text-gray-500',
                'border-transparent'
            );
        });
    });
    </script>
</body>
</html>