                                                            <span class="like-count text-sm md:text-base">
                                                                <%= post.likes.length %>
                                                            </span>
                                                        </button>
                                                        <button
                                                            class="comment-btn flex items-center text-gray-500 hover:text-blue-500 transition-colors"
                                                            data-post-id="<%= post._id %>" type="button">
                                                            <i class="far fa-comment mr-1 md:mr-2 text-sm md:text-base"></i>
                                                            <span class="comment-count text-sm md:text-base">
                                                                <%= post.comments.length %>
                                                            </span>
                                                        </button>
                                                    </div>
                                                </div>

