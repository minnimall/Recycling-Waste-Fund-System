    <!-- Waste History Modal -->
    <div class="modal fade" id="wasteHistoryModal" tabindex="-1" aria-labelledby="wasteHistoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="wasteHistoryModalLabel"><i class="fas fa-history me-2"></i>ประวัติการขายขยะ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" id="wasteSearchInput" placeholder="ค้นหาประวัติการขาย...">
                            <button class="btn btn-outline-secondary" type="button" onclick="searchWasteHistory()">ค้นหา</button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>วันที่</th>
                                    <th>รายละเอียด</th>
                                    <th>จำนวนเงิน (บาท)</th>
                                    <th>ผู้รับซื้อ</th>
                                </tr>
                            </thead>
                            <tbody id="wasteHistoryTableBody">
                                <% if (wastePurchases && wastePurchases.length > 0) { %>
                                    <% wastePurchases.forEach(purchase => { %>
                                        <tr>
                                            <td><%= new Date(purchase.purchaseDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                            <td>
                                                <% if (purchase.wasteItems && purchase.wasteItems.length > 0) { %>
                                                    <%= purchase.wasteItems.map(item => item.name || 'ไม่ระบุ').join(', ') %>
                                                <% } else { %>
                                                    ขายขยะ
                                                <% } %>
                                            </td>
                                            <td class="transaction-in">฿<%= purchase.totalAmount.toLocaleString() %></td>
                                            <td><%= purchase.addBy || '-' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">ไม่มีประวัติการขายขยะ</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <span class="text-muted">แสดง <%= wastePurchases ? wastePurchases.length : 0 %> รายการ</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    <button type="button" class="btn btn-success" onclick="exportWasteData()">
                        <i class="fas fa-file-excel me-2"></i>ส่งออกข้อมูล
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Account Book Modal -->
    <div class="modal fade" id="accountBookModal" tabindex="-1" aria-labelledby="accountBookModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="accountBookModalLabel"><i class="fas fa-book me-2"></i>สมุดบัญชี</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="card mb-4">
                        <div class="card-body text-center">
                            <h6 class="text-muted mb-2">ยอดเงินคงเหลือ</h6>
                            <div class="account-balance">฿<%= wasteBankAccount ? wasteBankAccount.Balance.toLocaleString() : '0' %></div>
                            <!-- <div class="mt-3">
                                <button class="btn btn-success me-2" onclick="showDepositForm()">
                                    <i class="fas fa-plus-circle me-2"></i>ฝากเงิน
                                </button>
                                <button class="btn btn-danger" onclick="showWithdrawForm()">
                                    <i class="fas fa-minus-circle me-2"></i>ถอนเงิน
                                </button>
                            </div> -->
                        </div>
                    </div>
                    
                    <h6 class="mb-3">รายการธุรกรรมย้อนหลัง</h6>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>วันที่</th>
                                    <th>รายการ</th>
                                    <th>เงินเข้า</th>
                                    <th>เงินออก</th>
                                    <th>คงเหลือ</th>
                                    <th>หมายเหตุ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (wastePurchases && wastePurchases.length > 0) { %>
                                    <% let runningBalance = wasteBankAccount ? wasteBankAccount.Balance : 0; %>
                                    <% wastePurchases.slice().reverse().forEach((purchase, index) => { %>
                                        <tr>
                                            <td><%= new Date(purchase.purchaseDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                            <td>ขายขยะ</td>
                                            <td class="transaction-in">+฿<%= purchase.totalAmount.toLocaleString() %></td>
                                            <td>-</td>
                                            <td>฿<%= runningBalance.toLocaleString() %></td>
                                            <td>
                                                <% if (purchase.wasteItems && purchase.wasteItems.length > 0) { %>
                                                    <%= purchase.wasteItems.map(item => item.name || 'ขยะ').join(', ') %>
                                                <% } else { %>
                                                    ขายขยะรีไซเคิล
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% runningBalance -= purchase.totalAmount; %>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">ไม่มีรายการธุรกรรม</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <span class="text-muted">แสดง <%= wastePurchases ? wastePurchases.length : 0 %> รายการ</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>




    <!-- พวก modal -->
    
