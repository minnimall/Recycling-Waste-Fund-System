                                                            <span class="bg-blue-100 text-blue-800 px-2 py-0.5 md:py-1 rounded-full text-[10px] md:text-xs whitespace-nowrap">
                                                                <% const categoryNames = { 
                                                                    reduce: 'ลดการใช้', 
                                                                    reuse: 'นำกลับมาใช้', 
                                                                    recycle: 'รีไซเคิล',
                                                                    diy: 'DIY/ทำเอง', 
                                                                    community: 'โครงการชุมชน', 
