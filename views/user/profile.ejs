    <script>
      // Image modal functions
      function showImageModal(imageSrc) {
          const modal = document.getElementById('imageModal');
          const modalImage = document.getElementById('modalImage');
          modalImage.src = imageSrc;
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
      }

      function closeImageModal() {
          const modal = document.getElementById('imageModal');
          modal.classList.add('hidden');
          document.body.style.overflow = 'auto';
      }

      // Close modal when clicking outside the image
      document.getElementById('imageModal').addEventListener('click', function(e) {
          if (e.target === this) {
              closeImageModal();
          }
      });

      // Track complaint function
      function trackComplaint(complaintId) {
          Swal.fire({
              title: 'ติดตามสถานะคำร้อง',
              html: `
                  <div class="text-left">
                      <p class="mb-3">รหัสคำร้อง: <strong>#${complaintId.slice(-6).toUpperCase()}</strong></p>
                      <p class="text-sm text-gray-600">
                          คุณสามารถติดตามความคืบหน้าของคำร้องได้ในหน้านี้ หรือติดต่อสอบถามได้ที่เจ้าหน้าที่
                      </p>
                  </div>
              `,
              icon: 'info',
              confirmButtonText: 'รับทราบ',
              confirmButtonColor: '#16a34a'
          });
      }

