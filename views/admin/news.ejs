<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/style_admin/news.css">
</head>

<body>
        <%- include('../partials/adminPartials/adminHeader.ejs') %>
        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
        
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // เช็คข้อความที่ส่งมาจาก URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');
    
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
        </script>

        <div class="content bg-gray-50 min-screen">
            <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">ข่าวสาร <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= news.length %> รายการ)</span></h1>
                    <p class="text-gray-600">ข่าวสารทั้งหมดของกองทุนขยะรีไซเคิล</p>
                </div>
                
                <div>
                    <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="openModal()">เพิ่มข่าวสาร</button>
                </div>
            </div>

            <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                <!-- ค้นหา + เลือกจำนวน -->
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="relative flex-1">
                    <input type="text" id="searchInput" placeholder="ค้นหาข่าวสาร" 
                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
                        oninput="renderNews()" />
                    <div class="absolute left-3 top-2.5 text-gray-400">
                        <i class="fas fa-search"></i>
                    </div>
                    </div>

                    <div class="flex items-center space-x-2">
                    <label for="perPage" class="text-sm text-gray-600">แสดง</label>
                    <select id="perPage" onchange="renderNews()" 
                        class="px-2 py-1 border rounded-lg">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                    </select>
                    <span class="text-sm text-gray-600">รายการ</span>
                    </div>
                </div>
            </div>

            <div id="newsTableContainer" class="mx-4 mb-6 bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                
                <!-- Header Section -->
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="bg-blue-100 p-2.5 rounded-xl">
                                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-800">รายการข่าวสาร</h2>
                                <p class="text-sm text-gray-500">จัดการข่าวสารและกิจกรรมทั้งหมด</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-medium">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                            </svg>
                            <span id="totalItems">0 รายการ</span>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-[8%]">
                                    <div class="flex items-center justify-center gap-1">
                                        <span>#</span>
                                    </div>
                                </th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-left w-[25%]">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                                        </svg>
                                        <span>หัวข้อ</span>
                                    </div>
                                </th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-left w-[27%]">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                                        </svg>
                                        <span>คำอธิบาย</span>
                                    </div>
                                </th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-[15%]">
                                    <div class="flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>วันที่โพสต์</span>
                                    </div>
                                </th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-[12%]">
                                    <div class="flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        <span>ผู้โพส</span>
                                    </div>
                                </th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-[13%]">
                                    จัดการ
                                </th>
                            </tr>
                        </thead>
                        <tbody id="newsTable" class="divide-y divide-gray-100">
                            <!-- แสดงข้อมูลด้วย JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Section -->
                <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
                    <div id="pagination" class="flex justify-center items-center space-x-2"></div>
                </div>
            </div>
        </div>
                    <!-- Modal -->
                    <div id="modal" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
                        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                            <form action="/admin/newsPost" method="POST" enctype="multipart/form-data"
                                class="bg-white rounded-xl shadow-lg p-6 space-y-5" id="newsForm">

                                <!-- หัวฟอร์ม -->
                                <div class="flex items-center space-x-3 border-b pb-3">
                                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                                    <span class="text-xl font-semibold text-gray-800">เพิ่มกิจกรรม/ข่าวสาร</span>
                                </div>

                                <!-- หัวข้อกิจกรรม -->
                                <div>
                                    <label for="newsTitle" class="block text-sm font-medium text-gray-700 mb-1">หัวข้อข่าวสาร <span class="text-red-500">*</span></label>
                                    <input type="text" name="newsTitle" id="newsTitle" required placeholder="ระบุหัวข้อข่าวสาร"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                                </div>

                                <!-- คำอธิบาย -->
                                <div>
                                    <label for="newsDescription" class="block text-sm font-medium text-gray-700 mb-1">คำอธิบาย <span class="text-red-500">*</span></label>
                                    <textarea rows="6" type="text" name="newsDescription" id="newsDescription" required placeholder="คำอธิบาย"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" ></textarea>
                                </div>

                                <!-- ผู้เขียน -->
                                <input type="hidden" name="newsAuthor" id="newsAuthor" value="<%= username %>" />

                                <!-- อัปโหลด PDF -->
                                <div>
                                    <label for="newsFile" class="block text-sm font-medium text-gray-700 mb-1">รายละเอียดข่าวสาร (ไฟล์
                                        PDF) <span class="text-red-500">*</span></label>
                                    <input type="file" name="newsFile" id="newsFile" accept=".pdf,image/*" required
                                        class="block w-full text-sm text-slate-500 border border-gray-300 rounded-lg px-4 py-2 bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100" />
                                </div>

                                <!-- ปุ่ม -->
                                <div class="flex justify-end space-x-3 pt-2">
                                    <button type="button" onclick="closeModal()"
                                        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                                    <button type="submit"
                                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">ยืนยัน</button>
                                </div>
                            </form>
                        </div>
                    </div>
        

                    <!-- Modal -->
                    <div id="modalEdit" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
                        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                            <form action="/admin/newsEdit" id="newsEditForm" method="POST" enctype="multipart/form-data""
                                class="bg-white rounded-xl shadow-lg p-6 space-y-5" id="newsEditForm">
                    
                                <!-- หัวฟอร์ม -->
                                <div class="flex items-center space-x-3 border-b pb-3">
                                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                                    <span class="text-xl font-semibold text-gray-800">แก้ไขกิจกรรม/ข่าวสาร</span>
                                </div>
                    
                                <!-- หัวข้อกิจกรรม -->
                                <div>
                                    <label for="newsTitle" class="block text-sm font-medium text-gray-700 mb-1">หัวข้อกิจกรรม</label>
                                    <input type="text" name="newsEditTitle" id="newsEditTitle" required placeholder="ระบุหัวข้อกิจกรรม"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                                </div>
                    
                                <!-- คำอธิบาย -->
                                <div>
                                    <label for="newsEditDescription" class="block text-sm font-medium text-gray-700 mb-1">คำอธิบาย</label>
                                    <textarea rows="6" type="text" name="newsEditDescription" id="newsEditDescription" required placeholder="คำอธิบาย"
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" ></textarea>
                                </div>
                    
                                <!-- อัปโหลด PDF -->
                                <div>
                                    <label for="newsEditFile" class="block text-sm font-medium text-gray-700 mb-1">รายละเอียดกิจกรรม (ไฟล์
                                        PDF)</label>
                                    <input type="file" name="newsEditFile" id="newsEditFile" accept=".pdf"
                                        class="block w-full text-sm text-slate-500 border border-gray-300 rounded-lg px-4 py-2 bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100" />
                                </div>
                    
                                <!-- ปุ่ม -->
                                <div class="flex justify-end space-x-3 pt-2">
                                    <button type="button" onclick="closeModal()"
                                        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                                    <button type="submit"
                                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">ยืนยัน</button>
                                </div>
                            </form>
                        </div>
                    </div>
    </div>
</body>
    <%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
        // ✅ แปลงวันที่เป็นรูปแบบไทย
        function formatDateToThai(date) {
            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
                'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
            const thaiYears = date.getFullYear() + 543;
            const day = date.getDate();
            const month = monthNames[date.getMonth()];
            return `${day} ${month} ${thaiYears}`;
        }

        const modal = document.getElementById('modal');
        const modalEdit = document.getElementById('modalEdit');

        // ✅ เปิด Modal แบบใหม่
        function openModal() {
            modal.classList.remove('hidden');
            // ล้างค่า input ถ้าต้องการ
            document.getElementById('newsForm')?.reset();
        }
        function openEditModal(id, title, description) {
            modalEdit.classList.remove('hidden');
            document.getElementById('newsEditForm')?.reset();

            document.getElementById('newsEditTitle').value = title;
            document.getElementById('newsEditDescription').value = description;

            // ตั้ง action ใหม่ให้ส่งไปที่ newsPostEdit/:id
            document.getElementById('newsEditForm').action = `/admin/newsPostEdit/${id}`;
        }

        // ✅ ปิด Modal แบบใหม่
        function closeModal() {
            modal.classList.add('hidden');
            modalEdit.classList.add('hidden');
            document.getElementById('newsForm')?.reset();
            document.getElementById('newsEditForm')?.reset();
        }

        // ✅ ฟังก์ชันลบข่าว/กิจกรรม
        function deleteNews(id, title) {
            Swal.fire({
                title: `ลบข้อมูล "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/deleteNews/${id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(response => response.json()) // เซิร์ฟเวอร์ควรส่ง `{ success: true }`
                    .then(data => {
                        if (data.success) {
                            Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                            .then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ไม่สามารถลบข้อมูลได้', 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }
        
        const news = <%- JSON.stringify(news.filter(m => !m.isDeleted)) %>

        let currentPage = 1;
        function formatDate(isoString) {
            const d = new Date(isoString);
            return d.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
        }
        function renderNews() {
        const search = document.getElementById("searchInput").value.toLowerCase();
        const perPage = parseInt(document.getElementById("perPage").value);

        // filter
        const filtered = news.filter(item =>
            item.newsTitle.toLowerCase().includes(search) ||
            item.newsDescription.toLowerCase().includes(search) ||
            (item.newsAuthor && item.newsAuthor.toLowerCase().includes(search))
        );

        // จำนวนทั้งหมด
        document.getElementById("totalItems").innerText = `${filtered.length} รายการ`;

        // pagination
        const totalPages = Math.ceil(filtered.length / perPage);
        if (currentPage > totalPages) currentPage = 1;
        const start = (currentPage - 1) * perPage;
        const paginated = filtered.slice(start, start + perPage);

        // render table
        const tbody = document.getElementById("newsTable");
        tbody.innerHTML = paginated.length ? paginated.map((item, index) => `
            <tr class="hover:bg-blue-50/50 transition-colors group">
                <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-600 text-sm font-medium group-hover:bg-blue-100 group-hover:text-blue-700 transition-colors">${start + index + 1}</span>
                </td>
                <td class="px-6 py-4">
                    <p class="font-medium text-gray-800">${item.newsTitle}</p>
                </td>
                <td class="px-6 py-4">
                    <p class="text-gray-600 text-sm line-clamp-2">${item.newsDescription}</p>
                </td>
                <td class="px-6 py-4 text-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium">
                        ${formatDate(item.createdAt)}
                    </span>
                </td>
                <td class="px-6 py-4 text-center">
                    <span class="text-gray-700 text-sm font-medium">${item.newsAuthor}</span>
                </td>
                <td class="px-6 py-4 text-center">
                    <div class="flex items-center justify-center gap-2 opacity-70 group-hover:opacity-100 transition-opacity">
                        <button onclick="openEditModal('${item._id}','${item.newsTitle}','${item.newsDescription}')"
                            class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors" title="แก้ไข">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                        </button>
                        <button onclick="deleteNews('${item._id}', '${item.newsTitle}')" 
                            class="p-2 text-red-600 hover:bg-red-100 rounded-lg transition-colors" title="ลบ">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        `).join("") : `
            <tr>
                <td colspan="6" class="px-6 py-16 text-center">
                    <div class="flex flex-col items-center text-gray-400">
                        <svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                        </svg>
                        <span class="font-medium">ไม่พบข้อมูลข่าวสาร</span>
                    </div>
                </td>
            </tr>
        `;

        // render pagination
        const paginationEl = document.getElementById("pagination");
        paginationEl.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
            paginationEl.innerHTML += `
            <button onclick="goToPage(${i})" 
                class="px-4 py-2 rounded-lg text-sm font-medium transition-colors ${i === currentPage ? "bg-blue-600 text-white shadow-md" : "bg-white text-gray-600 hover:bg-gray-100 border border-gray-200"}">
                ${i}
            </button>
            `;
        }
        }

        function goToPage(page) {
        currentPage = page;
        renderNews();
        }

        // render ครั้งแรก
        renderNews();
    </script>

</html>