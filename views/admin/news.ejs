<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
        <link rel="stylesheet" href="/style_admin/news.css">
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // เช็คข้อความที่ส่งมาจาก URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');
    
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
        </script>
            <!-- Main content -->
            <div class="screen" id="modal">
                <form class="new-form" action="/admin/newsPost" method="POST"
                    enctype="application/x-www-form-urlencoded">
                    <h1>เพิ่มกิจกรรม/ข่าวสาร</h1>
                    <div class="new-form-content">
                        <label for="activityTitle">หัวข้อกิจกรรม</label> <br>
                        <input type="text" name="activityTitle" id="activityTitle" required
                            placeholder="ระบุหัวข้อกิจกรรม">
                        <label for="activityDescription">คำอธิบาย</label> <br>
                        <input type="text" name="activityDescription" id="activityDescription" required
                            placeholder="คำอธิบาย">
    
                        <label for="editor">รายละเอียดกิจกรรม</label> <br>
                        <div id="editor"></div><br><br>
                        <input type="hidden" name="activityDetails" id="activityDetails">
                    </div>

                    <div class="new-form-action">
                        <button class="submit" type="submit">โพสต์กิจกรรม</button>
                        <span class="cancel" onclick="closeModal()">ปิด</span>
                    </div>
                </form>
            </div>
            <div class="content">
                <div class="content-header">
                    <h1>การจัดการข่าวสาร (2 รายการ)</h1>
                    <div class="add-media" onclick="openModal()">เพิ่มสื่อ</div>
                </div>
                <div class="news-container">
                    <div class="news-header">
                        <div>ข่าวสารล่าสุด</div>
                        <form action="">
                            <input type="text" placeholder="ค้นหา">
                            <button>ค้นหา</button>
                        </form>
                    </div>
                    <div class="news-content">

                        <% if (news && news.length > 0) { %>
                            <% news.forEach((newsItem, index) => { %>
                                <!-- card 1 -->
                                <div class="news-card">
                                    <div class="news-detail">
                                        <h3><%= newsItem.activityTitle %> <span>by Sittichai</span></h3>
                                        <p><%= newsItem.activityDescription %></p>
                                        <div class="news-date"><%= newsItem.updatedAt %></div>
                                    </div>
                                    <div class="news-action">
                                        <span class="edit-icon" ><ion-icon name="create"></ion-icon></span>
                                        <span class="delete-icon" onclick="deleteNews(['1','2'])"><ion-icon name="trash"></ion-icon></span>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p>There are no media to display ....</p>
                        <% } %>
                        
                    </div>
                </div>
            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
        function formatDateToThai(date) {
            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
                                'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
            const thaiYears = date.getFullYear() + 543;
            const day = date.getDate();
            const month = monthNames[date.getMonth()];

            return `${day} ${month} ${thaiYears}`;
        }
        var quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, 4, 5] }],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    ['link', 'image'],
                    [{ 'color': [] }, { 'background': [] }],
                    ['blockquote', 'code-block']
                ],
                history: {
                    delay: 2000,
                    maxStack: 500,
                    userOnly: true
                },
            }
        });
        // Add custom image handler for uploading large images
        var toolbar = quill.getModule('toolbar');
        toolbar.addHandler('image', function() {
            var fileInput = document.createElement('input');
            fileInput.setAttribute('type', 'file');
            fileInput.setAttribute('accept', 'image/*');
            fileInput.click();

            fileInput.onchange = function() {
                var file = fileInput.files[0];
                if (file && file.size < 10000000) { // Limit file size (e.g. 10MB)
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        var range = quill.getSelection();
                        quill.insertEmbed(range.index, 'image', e.target.result);
                    };
                    reader.readAsDataURL(file);
                } else {
                    alert('กรุณาอัพโหลดรูปภาพที่มีขนาดไม่เกิน 10MB');
                }
            };
        });
        document.querySelector('form').onsubmit = function () {
            var activityDetails = document.querySelector('#activityDetails');
            if (!quill.root.innerHTML.trim()) {
                alert('กรุณากรอกรายละเอียดกิจกรรม');
                return false;
            }
            activityDetails.value = quill.root.innerHTML;
        };

        const modal = document.getElementById('modal');
        function openModal() {
            modal.style.display = 'block';
        }
        function closeModal() {
            modal.style.display = 'none';
        }

        function deleteNews(data) {
            Swal.fire({
                title: `ลบข้อมูลลำดับที่ ${data[0]} หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/employeeDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>

</html>