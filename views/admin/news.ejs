<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/style_admin/news.css">
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // เช็คข้อความที่ส่งมาจาก URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');
    
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
        </script>
            <!-- Main content -->
            <div class="screen" id="modal">
                <form class="new-form" action="/admin/newsPost" method="POST" enctype="multipart/form-data">
                    <h1>เพิ่มกิจกรรม/ข่าวสาร</h1>
                    <div class="new-form-content">
                        <label for="activityTitle">หัวข้อกิจกรรม</label> <br>
                        <input type="text" name="newsTitle" id="newsTitle" required placeholder="ระบุหัวข้อกิจกรรม">
                        <label for="newsDescription">คำอธิบาย</label> <br>
                        <input type="text" name="newsDescription" id="newsDescription" required placeholder="คำอธิบาย">
                        <label for="newsFile">รายละเอียดกิจกรรม (ไฟล์ PDF)</label> <br>
                        <input type="file" name="newsFile" id="newsFile" accept=".pdf" required>
                    </div>
                    <div class="new-form-action">
                        <button class="submit" type="submit">โพสต์กิจกรรม</button>
                        <span class="cancel" onclick="closeModal()">ปิด</span>
                    </div>
                </form>
            </div>
            <div class="content">
                <div class="content-header">
                    <h1 class="font-bold">การจัดการข่าวสาร (2 รายการ)</h1>
                    <div class="add-media" onclick="openModal()">เพิ่มสื่อ</div>
                </div>
                <div class="news-container">
                    <div class="news-header">
                        <div></div>
                        <form action="">
                            <input type="text" placeholder="ค้นหา">
                            <button>ค้นหา</button>
                        </form>
                    </div>
                    <% if (news && news.length > 0) { %>
                        <% news.forEach((newsItem, index) => { %>
                    <div>
                        <div class="w-full h-24 flex items-center bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform mt-2">
                            <i class="fa-solid fa-file text-3xl mr-3 ml-1"></i>
                            <div>
                                <div class="text-xl"><%= newsItem.newsTitle %></div>
                                <div class="text-stone-400"><%= newsItem.newsDescription %></div>
                                <div class="text-stone-400"><%= newsItem.formattedDate %></div>
                            </div>
                            
                        </div>
                    </div>
                        <% }) %>
                    <% } else { %>
                        <p>There are no media to display ....</p>
                    <% } %>
                </div>
            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
    function formatDateToThai(date) {
        const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
            'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
        const thaiYears = date.getFullYear() + 543;
        const day = date.getDate();
        const month = monthNames[date.getMonth()];
        return `${day} ${month} ${thaiYears}`;
    }

    const modal = document.getElementById('modal');
    function openModal() {
        modal.style.display = 'block';
    }
    function closeModal() {
        modal.style.display = 'none';
    }

    function deleteNews(data) {
            Swal.fire({
                title: `ลบข้อมูลลำดับที่ ${data[0]} หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/employeeDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>

</html>