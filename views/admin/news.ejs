<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/style_admin/news.css">
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // เช็คข้อความที่ส่งมาจาก URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');
    
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
        </script>
            <!-- Main content -->
            <div class="screen z-[10]" id="modal">
                <form class="mx-auto mt-[13em] w-1/2 bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform relative " action="/admin/newsPost" method="POST" enctype="multipart/form-data">
                    <h1 class="text-bold text-gray-600 text-2xl">เพิ่มกิจกรรม/ข่าวสาร</h1>
                    <hr class="my-2">
                    <label for="activityTitle" class="text-bold text-gray-500 text-lg">หัวข้อกิจกรรม</label> <br>
                    <input type="text" name="newsTitle" id="newsTitle" class="w-full p-2 border border-gray-200 rounded-lg" required placeholder="ระบุหัวข้อกิจกรรม">
                    <label for="newsDescription" class="text-bold text-gray-500 text-lg">คำอธิบาย</label> <br>
                    <input type="text" name="newsDescription" class="w-full p-2 border border-gray-200 rounded-lg" id="newsDescription" required placeholder="คำอธิบาย">
                    <label for="newsAuthor" class="text-bold text-gray-500 text-lg">ผู้เขียน</label> <br>
                    <input type="hidden" name="newsAuthor" id="newsAuthor" class="w-full p-2 border border-gray-200 rounded-lg" required placeholder="ระบุชื่อผู้เขียน" value="<%= username %>">
                    <label for="newsFile" class="text-bold text-gray-500 text-lg">รายละเอียดกิจกรรม (ไฟล์ PDF)</label> <br>
                    <label class="block w-full p-2 border border-gray-200 rounded-lg">
                        <span class="sr-only">Choose profile photo</span>
                        <input type="file" name="newsFile" id="newsFile" accept=".pdf" class="block w-full text-sm text-slate-500
                            file:mr-4 file:py-2 file:px-4
                            file:rounded-full file:border-0
                            file:text-sm file:font-semibold
                            file:bg-violet-50 file:text-violet-700
                            hover:file:bg-violet-100
                        " required>
                    </label>
                    <hr class="my-5">
                    <div class="mt-2 flex justify-end gap-2">
                        <button class="submit px-2 py-1 text-white rounded" type="submit">โพสต์กิจกรรม</button>
                        <span class="cancel px-2 py-1 text-white rounded mr-2" onclick="closeModal()">ปิด</span>
                    </div>
                </form>
            </div>
            <div class="content">
                <div class="content-header">
                    <h1 class="font-bold">การจัดการข่าวสาร (2 รายการ)</h1>
                    <div class="add-media" onclick="openModal()">เพิ่มสื่อ</div>
                </div>
                <div class="news-container">
                    <div class="news-header">
                        <div></div>
                        <form action="">
                            <input type="text" placeholder="ค้นหา">
                            <button>ค้นหา</button>
                        </form>
                    </div>

                    <table class="min-w-full divide-y divide-gray-200 mt-4">
                        <thead class="bg-gray-50">
                            <tr class="bg-green-700 text-white">
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-center uppercase">ลำดับที่</th>
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-left uppercase">หัวข้อ</th>
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-left uppercase">คำอธิบาย</th>
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-center uppercase">วันที่โพส</th>
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-left uppercase">ผู้ที่โพส</th>
                                <th class="px-6 py-3 text-lg font-medium tracking-wider text-center uppercase">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="modalHeaderInfo" class="bg-white divide-y divide-gray-200">
                            <% if (news && news.length > 0) { %>
                                <% news.forEach((newsItem, index) => { %>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-center">1</td>
                                <td class="px-6 py-4 whitespace-nowrap text-left"><%= newsItem.newsTitle %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-left"><%= newsItem.newsDescription %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-center"><%= newsItem.formattedDate %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-left"><%= newsItem.newsAuthor%></td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <a href="">แก้ไข</a>
                                    <a href="">ลบ</a>
                                </td>
                            </tr>
                                <% }) %>
                            <% } else { %>
                                <td colspan="6" class="p-3 text-center">There are no news to display ....</td>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
    function formatDateToThai(date) {
        const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
            'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
        const thaiYears = date.getFullYear() + 543;
        const day = date.getDate();
        const month = monthNames[date.getMonth()];
        return `${day} ${month} ${thaiYears}`;
    }

    const modal = document.getElementById('modal');
    function openModal() {
        modal.style.display = 'block';
    }
    function closeModal() {
        modal.style.display = 'none';
    }

    function deleteNews(data) {
            Swal.fire({
                title: `ลบข้อมูลลำดับที่ ${data[0]} หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/employeeDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>

</html>