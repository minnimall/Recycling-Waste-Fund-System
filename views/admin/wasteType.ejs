<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>


    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">ประเภทขยะ</h1>
                <p class="text-gray-600">ขยะทั้งหมดที่รับซื้อของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="wasFormToggle()">เพิ่มประเภทขยะ</button>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <form action="" method="GET">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <input type="text" name="search" value="<%= search %>" placeholder="ค้นหาประเภทขยะ" 
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                            <div class="absolute left-3 top-2.5 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                            <i class="fas fa-search mr-2"></i>ค้นหา
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    จำนวนประเภทขยะทั้งหมด <span class="text-blue-600 text-base font-normal"> <%= wastetype.length %> รายการ</span>
                </h2>
            </div>
        
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-lef text-gray-700 uppercase">ลำดับ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อประเภทขยะ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (wastetype && wastetype.length > 0) { %>
                            <% wastetype.forEach((wastetypee, index) => { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-sm whitespace-nowrap text-center"><%= (currentPage - 1) * 5 + index + 1 %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= wastetypee.wasteTypeName %></td>
                                    <td class="px-4 py-3 whitespace-nowrap text-center">
                                        <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                            onclick="setWasteTypeForm('<%= index + 1 %>', '<%= wastetypee._id %>', '<%= wastetypee.wasteTypeName %>')">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button 
                                            onclick="deleteWasteType(['<%= (currentPage - 1) * 5 + index + 1 %>', '<%= wastetypee._id %>','<%= wastetypee.wasteTypeName %>'])" 
                                                    class="delete-btn">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-2 px-4">- ไม่พบข้อมูลประเภทขยะ -</td>
                            </tr>
                        <% } %>
                    </tbody>                    
                </table>
            </div>
        </div>

        <div class="was-form" id="edit_Form" style="display: none;">
            <form action="/admin/wasteTypeEdit" method="POST" enctype="application/x-www-form-urlencoded">
                <div class="form-head">
                    <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                        <span>แก้ไขประเภทขยะ</span>
                </div>
                <div class="input-group">
                    <!-- ส่งค่า _id -->
                    <input type="hidden" name="_id" id="hiddenWasteTypeId" value="">

                    <!-- ฟิลด์สำหรับชื่อประเภทขยะ -->
                    <label for="editWasteTypeName">ชื่อประเภท</label>
                    <input type="text" name="wasteTypeName" id="editWasteTypeName" placeholder="โลหะ พลาสติก etc." required>

                    <div class="submit-btn flex justify-end">
                        <button type="button" class="cancel" onclick="cancelForm()">ยกเลิก</button>
                        <button type="submit" class="submit">บันทึก</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="was-form" id="add_Form" style="display: none;">
            <form action="/admin/wasteTypePost" method="POST" enctype="application/x-www-form-urlencoded">
                <div class="form-head">
                    <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                    <span>รายละเอียดประเภทขยะ</span>
                </div>
                <div class="input-group">
                    <label for="wasteTypeName">ชื่อประเภท</label>
                    <input type="text" name="wasteTypeName" id="wasteTypeName" placeholder="โลหะ พลาสติก etc." required>
                    <div class="submit-btn flex justify-end">
                        <button type="button" class="cancel" onclick="cancelForm()">ยกเลิก</button>
                        <button type="submit" class="submit">บันทึก</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Pagination -->
        <div class="pagination flex justify-center items-center mt-4 space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ก่อนหน้า
                </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md 
                                <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                                <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ถัดไป
                </a>
            <% } %>
        </div>

    </div>

</body>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        let lastClickedRow = null;

        function setWasteTypeForm(Index, Id, Name) {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            const InputWasteTypeId = document.getElementById('hiddenWasteTypeId');
            InputWasteTypeId.value = Id;

            console.log("ID:", Id); // Debug
            const InputWasteTypeName = document.getElementById('editWasteTypeName');
            InputWasteTypeName.value = Name;

            addForm.style.display = 'none';
            const selectedRow = document.querySelector(`.was-row-${Index}`);

            if (lastClickedRow === selectedRow) {
                selectedRow.style.backgroundColor = '';
                lastClickedRow = null;
                editForm.style.display = 'none';
            } else {
                if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
                selectedRow.style.backgroundColor = '#8EDBA4';
                editForm.style.display = 'block';
                lastClickedRow = selectedRow;
            }
        }
        function wasFormToggle() {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            editForm.style.display = 'none';
            if (add_Form.style.display === 'block') {
                add_Form.style.display = 'none';
            }
            else {
                add_Form.style.display = 'block';
            }
        }
        function deleteWasteType(data) {
            Swal.fire({
                title: `ลบ "${data[2]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/deletewasteType/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลประเภทขยะถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลประเภทขยะถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
        function cancelForm() {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            // Hide both forms when cancel is clicked
            editForm.style.display = 'none';
            addForm.style.display = 'none';

            // Optionally reset the forms
            editForm.reset();
            addForm.reset();
        }
    </script>
</html>