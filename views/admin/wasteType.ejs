<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
            <!-- Main content -->
            <div class="content">
                <div class="content-header">
                    <h1>ประเภทขยะ (2 รายการ)</h1>
                    <div class="add-media">เพิ่มประเภทขยะ</div>
                </div>
                <div class="was-container">
                    <table class="table-auto">
                        <thead>
                            <tr>
                                <th class="table-was-index">ลำดับ</th>
                                <th class="table-was-id">รหัสประเภท</th>
                                <th class="table-was-id">ชื่อประเภท</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (wastetype && wastetype.length > 0) { %>
                                <% wastetype.forEach((wastetypee, index) => { %>
                            <tr class="was-row-<%= index+1 %> row-active" onclick="setWasteTypeForm('<%= index + 1%>','<%= wastetypee.wasteTypeId %>','<%= wastetypee.wasteTypeName %>')">
                                <td class="table-was-index"><%= index + 1%></td>
                                <td class="table-was-id"><%= wastetypee.wasteTypeId %></td>
                                <td class="table-was-name"><%= wastetypee.wasteTypeName %></td>
                            </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6">ไม่พบข้อมูลพนักงาน</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <div class="was-form" id="edit_Form">
                        <form  action="/admin/wasteTypePost" method="POST" enctype="application/x-www-form-urlencoded">
                            <div class="form-head">
                                <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                                <span>รายละเอียดประเภทขยะ</span>
                            </div>        
                            <div class="input-group">
                                <label for="wasteTypeId">รหัสประเภท</label>
                                <input type="text" name="wasteTypeId" id="wasteTypeId" placeholder="TXXXX" required>
                                
                                <label for="wasteTypeName">ชื่อประเภท</label>
                                <input type="text" name="wasteTypeName" id="wasteTypeName" placeholder="โลหะ พลาสติก etc." required>
                                
                                <div class="submit-btn">
                                    <button type="submit" class="submit">บันทึก</button>
                                    <button type="button" class="cancel" onclick="closeMenu()">ยกเลิก</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

<script>
    let lastClickedRow = null;

    function setWasteTypeForm(Index, Id, Name) {

        const InputWasteTypeId = document.getElementById('wasteTypeId');
        const InputWasteTypeName = document.getElementById('wasteTypeName');

        const edieForm = document.getElementById('edit_Form');

        InputWasteTypeId.value = Id;
        InputWasteTypeName.value = Name;       
        edieForm.style.display = 'block';

        const selectedRow = document.querySelector(`.was-row-${Index}`);

        if (lastClickedRow === selectedRow) {
            selectedRow.style.backgroundColor = '';
            
            lastClickedRow = null;
        } else {
            if (lastClickedRow) {
                lastClickedRow.style.backgroundColor = '';
            }
            selectedRow.style.backgroundColor = '#8EDBA4';
            lastClickedRow = selectedRow;
        }
    }
</script>
</html>