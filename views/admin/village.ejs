<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/village.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>

<body>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>


    <%- include('../partials/adminPartials/adminHeader.ejs') %>

    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">หมู่บ้าน</h1>
                <p class="text-gray-600">ข้อมูลหมู่บ้านของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="wasFormToggle()">เพิ่มหมู่บ้าน</button>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    จำนวนหมู่บ้านทั้งหมด <span class="text-blue-600 text-base font-normal"> <%= villages.length %> รายการ</span>
                </h2>
            </div>
        
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">หมู่ที่</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อหมู่บ้าน</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ตำแหน่งรับซื้อ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (villages.length > 0) { %>
                            <% villages.forEach((village, index) => { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-sm whitespace-nowrap text-center"><%= village.villageNumber %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= village.villageName %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= village.location %></td>
                                    <td class="px-4 py-3 whitespace-nowrap text-left">
                                        <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                            onclick="setVillageForm('<%= index + 1 %>', '<%= village._id %>', '<%= village.villageNumber %>', '<%= village.villageName %>', '<%= village.location %>')"> 
                                                <i class="fa fa-edit"></i>
                                        </button>
                                        <button type="button" class="delete-btn" 
                                            onclick="deleteVillage(['<%= index + 1 %>', '<%= village._id %>', '<%= village.villageNumber %>', '<%= village.villageName %>', '<%= village.location %>'])">
                                                <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-gray-500">- ไม่พบข้อมูลหมู่บ้าน -</td>
                            </tr>
                        <% } %>
                    </tbody>                    
                </table>
            </div>
        </div>

        <!-- เพิ่มหมู่บ้าน -->
                    <div id="add_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
                        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                            <form action="/admin/villagePost" method="POST" enctype="application/x-www-form-urlencoded" class="bg-white rounded-xl shadow-lg w-full p-6 space-y-5">
                                <!-- หัวฟอร์ม -->
                                <div class="flex items-center space-x-3 border-b pb-3">
                                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                                    <span class="text-xl font-semibold text-gray-800">เพิ่มหมู่บ้าน</span>
                                </div>

                                <div class="input-group">
                                    <label for="villageNumber" class="block text-sm font-medium text-gray-700 mb-1">หมู่ที่ <span class="text-red-500">*</span></label>
                                    <input type="text" name="villageNumber" id="villageNumber" placeholder="เช่น 1, 2, 3, ..." required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">
                        
                                    <label for="villageName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหมู่บ้าน <span class="text-red-500">*</span></label>
                                    <input type="text" name="villageName" id="villageName" placeholder="เช่น บ้านหนองแวง" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">
                        
                                    <label for="location" class="block text-sm font-medium text-gray-700 mb-1">ตำแหน่งรับซื้อ <span class="text-red-500">*</span></label>
                                    <input type="text" name="location" id="location" placeholder="เช่น ตำบล xxx อำเภอ xxx" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">
                        
                                    <!-- ปุ่ม -->
                                    <div class="flex justify-end space-x-3 pt-2">
                                        <button type="button" onclick="cancelForm()"
                                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                                        <button type="submit"
                                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    
        <!-- แก้ไขหมู่บ้าน -->
                    <div id="edit_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
                        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                            <form action="/admin/villageEdit" method="POST" enctype="application/x-www-form-urlencoded" class="bg-white rounded-xl shadow-lg w-full p-6 space-y-5">
                                <!-- หัวฟอร์ม -->
                                <div class="flex items-center space-x-3 border-b pb-3">
                                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                                    <span class="text-xl font-semibold text-gray-800">แก้ไขหมู่บ้าน</span>
                                </div>
                                <div class="input-group">
                                    <!-- ส่งค่า _id -->
                                    <input type="hidden" name="_id" id="hiddenVillageId" value="">

                                    <label for="editvillageNumber" class="block text-sm font-medium text-gray-700 mb-1">หมู่ที่</label>
                                    <input type="text" name="villageNumber" id="editvillageNumber" placeholder="เช่น 1, 2, 3, ..." required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">

                                    <label for="editvillageName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหมู่บ้าน</label>
                                    <input type="text" name="villageName" id="editvillageName" placeholder="เช่น บ้านหนองแวง" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">

                                    <label for="editlocation" class="block text-sm font-medium text-gray-700 mb-1">ตำแหน่งรับซื้อ</label>
                                    <input type="text" name="location" id="editlocation" placeholder="เช่น ตำบล xxx อำเภอ xxx" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500 mb-3">

                                    <!-- ปุ่ม -->
                                    <div class="flex justify-end space-x-3 pt-2">
                                        <button type="button" onclick="cancelForm()"
                                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                                        <button type="submit"
                                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

        <div class="pagination flex justify-center items-center mt-4 space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                        ก่อนหน้า
                </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>"
                    class="px-3 py-1 border border-gray-300 rounded-md 
                            <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                        <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                        ถัดไป
                </a>
            <% } %>
        </div>
    </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        let lastClickedRow = null;

        function setVillageForm(Index, Id, Number, Name, location) {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            const InputVillageId = document.getElementById('hiddenVillageId');
            InputVillageId.value = Id;

            const InputVillageNumber = document.getElementById('editvillageNumber');
            InputVillageNumber.value = Number;

            const InputVillageName = document.getElementById('editvillageName');
            InputVillageName.value = Name;

            const InputVillagelocation = document.getElementById('editlocation');
            InputVillagelocation.value = location;

            addForm.style.display = 'none';
            const selectedRow = document.querySelector(`.was-row-${Index}`);
            if (lastClickedRow === selectedRow) {
                selectedRow.style.backgroundColor = '';
                lastClickedRow = null;
                editForm.style.display = 'none';
            } else {
                if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
                selectedRow.style.backgroundColor = '#8EDBA4';
                editForm.style.display = 'block';
                lastClickedRow = selectedRow;
            }
        }
        function wasFormToggle() {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            editForm.style.display = 'none';
            if (addForm.style.display === 'block') {
                addForm.style.display = 'none';
            }
            else {
                addForm.style.display = 'block';
            }
        }
        function deleteVillage(data) {
            Swal.fire({
                title: `ลบ "${data[3]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/villageDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลหมู่บ้านถูกลบเรียบร้อยแล้ว', 'success')
                            .then(() => {
                                location.reload();
                            });
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
        function cancelForm() {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            // Hide both forms when cancel is clicked
            editForm.style.display = 'none';
            addForm.style.display = 'none';

            // Reset ฟอร์ม
            editForm.querySelector('form').reset();
            addForm.querySelector('form')?.reset();

            // ยกเลิกแรเงาแถว
            if (lastClickedRow) {
                lastClickedRow.style.backgroundColor = '';
                lastClickedRow = null;
            }
        }
    </script>
</html>