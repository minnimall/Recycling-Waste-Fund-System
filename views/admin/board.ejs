<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <!-- <link rel="stylesheet" href="/style_admin/activity.css"> -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .delete-btn {
        background-color: #f44336; /* สีแดง */
        color: white;
        border: none;
        margin-top: 10px;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        transition: background-color 0.3s ease;
    }

    .delete-btn:hover {
        background-color: #d32f2f; /* สีแดงเข้ม */
    }

    .edit-btn {
        background-color: #007bff; /* สีฟ้าสำหรับแก้ไข */
        color: white;
        border: none;
        margin-top: 10px;
        margin-right: 4px;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        transition: background-color 0.3s ease;
    }

    .edit-btn:hover {
        background-color: #0155ad;
    }
    </style>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">คณะกรรมการ</h1>
                <p class="text-gray-600">คณะกรรมการฝ่ายทั้งหมดของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="openAddForm()">
                    <i class="fas fa-plus mr-2"></i>เพิ่มคณะกรรมการ
                </button>
            </div>
        </div>

        <!-- Modal Add -->
        <div id="add_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/boardPost" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5 max-h-[90vh] overflow-y-auto">
                    
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">เพิ่มคณะกรรมการ</span>
                    </div>
                    
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">ชื่อคณะกรรมการ <span class="text-red-500">*</span></label>
                        <input type="text" name="name" id="name" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>

                    <div>
                        <label for="role" class="block text-sm font-medium text-gray-700 mb-1">ตำแหน่ง <span class="text-red-500">*</span></label>
                        <input type="text" name="role" id="role" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <div>
                        <label for="department" class="block text-sm font-medium text-gray-700 mb-1">ฝ่าย <span class="text-red-500">*</span></label>
                        <select name="department" id="department" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled selected>เลือกฝ่าย</option>
                            <option value="ฝ่ายอำนวยการ">ฝ่ายอำนวยการ</option>
                            <option value="ฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล">ฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล</option>
                            <option value="ฝ่ายรับสมัคร">ฝ่ายรับสมัคร</option>
                            <option value="ฝ่ายรับซื้อขยะ">ฝ่ายรับซื้อขยะ</option>
                            <option value="ฝ่ายการเงินและบัญชี">ฝ่ายการเงินและบัญชี</option>
                            <option value="ฝ่ายเบิกถอนเงินฝากธนาคาร">ฝ่ายเบิกถอนเงินฝากธนาคาร</option>
                            <option value="ฝ่ายงานทะเบียนและธุรการ">ฝ่ายงานทะเบียนและธุรการ</option>
                            <option value="ฝ่ายจัดการทุนและฌาปนกิจ">ฝ่ายจัดการทุนและฌาปนกิจ</option>
                            <option value="ฝ่ายภาพกิจกรรม">ฝ่ายภาพกิจกรรม</option>
                        </select>
                    </div>
                    
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">อีเมล <span class="text-red-500">*</span></label>
                        <input type="email" name="email" id="email" placeholder="example@email.com" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>

                    <div>
                        <label for="tel" class="block text-sm font-medium text-gray-700 mb-1">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
                        <input type="tel" name="tel" id="tel" placeholder="081-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}" maxlength="11" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพ (ใน Modal Add) -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพ</label>
                        
                        <!-- Preview Area -->
                        <div class="relative">
                            <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" class="hidden">
                            
                            <!-- Upload Zone (แสดงเมื่อยังไม่มีรูป) -->
                            <div id="addUploadZone" 
                                class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG (ไม่เกิน 10 MB)</p>
                            </div>
                            
                            <!-- Image Preview (แสดงเมื่อมีรูป) -->
                            <div id="addImagePreview" class="hidden">
                                <div class="relative group">
                                    <img id="addPreviewImg" src="/placeholder.svg" alt="Preview" 
                                        class="w-full h-64 object-contain rounded-lg border-2 border-gray-300 bg-gray-50">
                                    
                                    <!-- Overlay with Change Button -->
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                        <button type="button" id="addChangeImageBtn"
                                            class="opacity-0 group-hover:opacity-100 transition-opacity bg-white text-gray-700 px-4 py-2 rounded-lg font-medium shadow-lg hover:bg-gray-100 flex items-center gap-2">
                                            <ion-icon name="camera-outline"></ion-icon>
                                            <span>เปลี่ยนรูปภาพ</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Modal Edit -->
        <div id="edit_Form" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/boardEdit" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5 max-h-[90vh] overflow-y-auto">

                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">แก้ไขข้อมูลคณะกรรมการ</span>
                    </div>
                    
                    <!-- ส่งค่า _id -->
                    <input type="hidden" name="_id" id="hiddenBoardId" value="">
                    
                    <div>
                        <label for="editName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อคณะกรรมการ <span class="text-red-500">*</span></label>
                        <input type="text" name="name" id="editName" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <div>
                        <label for="editRole" class="block text-sm font-medium text-gray-700 mb-1">ตำแหน่ง <span class="text-red-500">*</span></label>
                        <input type="text" name="role" id="editRole" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>

                    <div>
                        <label for="editDepartment" class="block text-sm font-medium text-gray-700 mb-1">ฝ่าย <span class="text-red-500">*</span></label>
                        <select name="department" id="editDepartment" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled>เลือกฝ่าย</option>
                            <option value="ฝ่ายอำนวยการ">ฝ่ายอำนวยการ</option>
                            <option value="ฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล">ฝ่ายประชาสัมพันธ์/วางแผนดำเนินและติดตามผล</option>
                            <option value="ฝ่ายรับสมัคร">ฝ่ายรับสมัคร</option>
                            <option value="ฝ่ายรับซื้อขยะ">ฝ่ายรับซื้อขยะ</option>
                            <option value="ฝ่ายการเงินและบัญชี">ฝ่ายการเงินและบัญชี</option>
                            <option value="ฝ่ายเบิกถอนเงินฝากธนาคาร">ฝ่ายเบิกถอนเงินฝากธนาคาร</option>
                            <option value="ฝ่ายงานทะเบียนและธุรการ">ฝ่ายงานทะเบียนและธุรการ</option>
                            <option value="ฝ่ายจัดการทุนและฌาปนกิจ">ฝ่ายจัดการทุนและฌาปนกิจ</option>
                            <option value="ฝ่ายภาพกิจกรรม">ฝ่ายภาพกิจกรรม</option>
                        </select>
                    </div>

                    <div>
                        <label for="editEmail" class="block text-sm font-medium text-gray-700 mb-1">อีเมล <span class="text-red-500">*</span></label>
                        <input type="email" name="email" id="editEmail" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <div>
                        <label for="editTel" class="block text-sm font-medium text-gray-700 mb-1">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
                        <input type="text" name="tel" id="editTel" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพ (ใน Modal Edit) -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพ</label>
                        
                        <!-- Preview Area -->
                        <div class="relative">
                            <input type="file" name="img" id="editImg" accept="image/png, image/gif, image/jpeg" class="hidden">
                            
                            <!-- Upload Zone (แสดงเมื่อยังไม่มีรูป) -->
                            <div id="editUploadZone" 
                                class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer hidden">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG (ไม่เกิน 10 MB)</p>
                            </div>
                            
                            <!-- Image Preview (แสดงเมื่อมีรูป) -->
                            <div id="editImagePreview">
                                <div class="relative group">
                                    <img id="editPreviewImg" src="/placeholder.svg" alt="Preview" 
                                        class="w-full h-64 object-contain rounded-lg border-2 border-gray-300 bg-gray-50">
                                    
                                    <!-- Overlay with Change Button -->
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                        <button type="button" id="editChangeImageBtn"
                                            class="opacity-0 group-hover:opacity-100 transition-opacity bg-white text-gray-700 px-4 py-2 rounded-lg font-medium shadow-lg hover:bg-gray-100 flex items-center gap-2">
                                            <ion-icon name="camera-outline"></ion-icon>
                                            <span>เปลี่ยนรูปภาพ</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    คณะกรรมการ <span id="totalItems" class="text-blue-600 text-base font-normal"><%= board.length %> รายการ</span> 
                </h2>
            </div>
            
            <!-- ตารางแสดงข้อมูล -->
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ลำดับ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ตำแหน่ง</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ฝ่าย</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">อีเมล</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">เบอร์โทรศัพท์</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">รูป</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (board.length > 0) { %>
                            <% board.forEach((item, index) => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3 text-sm text-center text-gray-900"><%= index + 1 %></td>
                                    <td class="px-4 py-3 text-sm text-gray-900"><%= item.name %></td>
                                    <td class="px-4 py-3 text-sm text-gray-900"><%= item.role %></td>
                                    <td class="px-4 py-3 text-sm text-center text-gray-900">
                                        <span class="px-4 py-3 text-sm text-center text-gray-900">
                                            <%= item.department %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-900"><%= item.email %></td>
                                    <td class="px-4 py-3 text-sm text-gray-900"><%= item.tel %></td>
                                    <td class="px-4 py-3 text-sm text-gray-900">
                                        <% if (item.img) { %>
                                            <img src="<%= item.img %>" alt="<%= item.name %>" class="w-12 h-12 object-cover rounded-full border-2 border-gray-200">
                                        <% } else { %>
                                            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
                                                <ion-icon name="person-outline" class="text-2xl text-gray-400"></ion-icon>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-center">
                                        <div class="flex justify-center space-x-2">
                                            <!-- ปุ่มแก้ไข -->
                                            <button onclick="openEditForm('<%= item._id %>', '<%= item.name %>', '<%= item.role %>', '<%= item.department %>', '<%= item.email %>', '<%= item.tel %>', '<%= item.img || '' %>')" 
                                                    class="edit-btn"
                                                    title="แก้ไข">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <!-- ปุ่มลบ -->
                                            <button onclick="deleteBoard('<%= item._id %>')" 
                                                    class="delete-btn"
                                                    title="ลบ">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="px-4 py-8 text-center text-gray-500">
                                    <div class="flex flex-col items-center">
                                        <ion-icon name="people-outline" class="text-6xl text-gray-300 mb-2"></ion-icon>
                                        <p>ไม่มีข้อมูลคณะกรรมการ</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        // ฟังก์ชันเปิดฟอร์มเพิ่ม
        function openAddForm() {
            document.getElementById('edit_Form').classList.add('hidden');
            document.getElementById('add_Form').classList.remove('hidden');
            
            // รีเซ็ตฟอร์ม
            document.getElementById('name').value = '';
            document.getElementById('role').value = '';
            document.getElementById('department').value = '';
            document.getElementById('email').value = '';
            document.getElementById('tel').value = '';
            addFileInput.value = '';

            // รีเซ็ตการแสดงรูปภาพ
            addUploadZone.classList.remove('hidden');
            addImagePreview.classList.add('hidden');
            addPreviewImg.src = '/placeholder.svg';
        }

        // ฟังก์ชันเปิดฟอร์มแก้ไข
        function openEditForm(id, name, role, department, email, tel, img) {
            const editForm = document.getElementById('edit_Form');
            const addForm = document.getElementById('add_Form');

            // ซ่อนฟอร์มเพิ่ม
            addForm.classList.add('hidden');
            
            // กรอกข้อมูลลงในฟอร์ม
            document.getElementById('hiddenBoardId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editRole').value = role;
            document.getElementById('editDepartment').value = department;
            document.getElementById('editEmail').value = email;
            document.getElementById('editTel').value = tel;
            
            // รีเซ็ต input file
            editFileInput.value = '';
            
            // ตั้งค่ารูปภาพเดิม
            setExistingEditImage(img);
            
            // แสดงฟอร์ม
            editForm.classList.remove('hidden');
        }

        // ฟังก์ชันลบ
        function deleteBoard(id) {
            Swal.fire({
                title: 'ยืนยันการลบ?',
                text: "คุณต้องการลบคณะกรรมการนี้ใช่หรือไม่",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/boardDelete/${id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message,
                                showConfirmButton: false,
                                timer: 3000
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('เกิดข้อผิดพลาด!', data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('เกิดข้อผิดพลาด!', 'ไม่สามารถลบข้อมูลได้', 'error');
                    });
                }
            });
        }

        // ฟังก์ชันยกเลิก
        function cancelForm() {
            const addForm = document.getElementById('add_Form');
            const editForm = document.getElementById('edit_Form');
            
            addForm.classList.add('hidden');
            editForm.classList.add('hidden');
            
            // รีเซ็ตฟอร์ม Add
            document.getElementById('name').value = '';
            document.getElementById('role').value = '';
            document.getElementById('department').value = '';
            document.getElementById('email').value = '';
            document.getElementById('tel').value = '';
            addFileInput.value = '';
            
            // รีเซ็ตการแสดงรูปภาพ Add Form
            addUploadZone.classList.remove('hidden');
            addImagePreview.classList.add('hidden');
            addPreviewImg.src = '/placeholder.svg';
            
            // รีเซ็ตฟอร์ม Edit
            editFileInput.value = '';
            editPreviewImg.src = '/placeholder.svg';
            editUploadZone.classList.add('hidden');
            editImagePreview.classList.add('hidden');
        }

        // ปิด modal เมื่อคลิกพื้นหลัง
        document.getElementById('add_Form').addEventListener('click', function(e) {
            if (e.target === this) {
                cancelForm();
            }
        });

        document.getElementById('edit_Form').addEventListener('click', function(e) {
            if (e.target === this) {
                cancelForm();
            }
        });

        // ป้องกัน modal ปิดเมื่อคลิกภายในฟอร์ม
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

        // ==================== Add Form Image Preview ====================
        const addFileInput = document.getElementById('img');
        const addUploadZone = document.getElementById('addUploadZone');
        const addImagePreview = document.getElementById('addImagePreview');
        const addPreviewImg = document.getElementById('addPreviewImg');
        const addChangeImageBtn = document.getElementById('addChangeImageBtn');

        // คลิกที่ Upload Zone เพื่อเลือกไฟล์
        if (addUploadZone) {
            addUploadZone.addEventListener('click', () => {
                addFileInput.click();
            });
        }

        // คลิกปุ่ม "เปลี่ยนรูปภาพ" เพื่อเลือกไฟล์ใหม่
        if (addChangeImageBtn) {
            addChangeImageBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                addFileInput.click();
            });
        }

        // เมื่อเลือกไฟล์ใหม่ (Add Form)
        addFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            
            if (file) {
                // ตรวจสอบขนาดไฟล์ (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไฟล์ใหญ่เกินไป',
                        text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                        confirmButtonColor: '#3085d6'
                    });
                    addFileInput.value = '';
                    return;
                }
                
                // ตรวจสอบประเภทไฟล์
                const validTypes = ['image/png', 'image/jpeg', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ประเภทไฟล์ไม่ถูกต้อง',
                        text: 'กรุณาเลือกไฟล์ PNG, JPG หรือ GIF เท่านั้น',
                        confirmButtonColor: '#3085d6'
                    });
                    addFileInput.value = '';
                    return;
                }
                
                // อ่านไฟล์และแสดงรูป
                const reader = new FileReader();
                reader.onload = function(event) {
                    addPreviewImg.src = event.target.result;
                    addUploadZone.classList.add('hidden');
                    addImagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        // ==================== Edit Form Image Preview ====================
        const editFileInput = document.getElementById('editImg');
        const editUploadZone = document.getElementById('editUploadZone');
        const editImagePreview = document.getElementById('editImagePreview');
        const editPreviewImg = document.getElementById('editPreviewImg');
        const editChangeImageBtn = document.getElementById('editChangeImageBtn');

        // คลิกที่ Upload Zone เพื่อเลือกไฟล์
        if (editUploadZone) {
            editUploadZone.addEventListener('click', () => {
                editFileInput.click();
            });
        }

        // คลิกปุ่ม "เปลี่ยนรูปภาพ" เพื่อเลือกไฟล์ใหม่
        if (editChangeImageBtn) {
            editChangeImageBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                editFileInput.click();
            });
        }

        // เมื่อเลือกไฟล์ใหม่ (Edit Form)
        editFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            
            if (file) {
                // ตรวจสอบขนาดไฟล์ (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไฟล์ใหญ่เกินไป',
                        text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                        confirmButtonColor: '#3085d6'
                    });
                    editFileInput.value = '';
                    return;
                }
                
                // ตรวจสอบประเภทไฟล์
                const validTypes = ['image/png', 'image/jpeg', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ประเภทไฟล์ไม่ถูกต้อง',
                        text: 'กรุณาเลือกไฟล์ PNG, JPG หรือ GIF เท่านั้น',
                        confirmButtonColor: '#3085d6'
                    });
                    editFileInput.value = '';
                    return;
                }
                
                // อ่านไฟล์และแสดงรูป
                const reader = new FileReader();
                reader.onload = function(event) {
                    editPreviewImg.src = event.target.result;
                    editUploadZone.classList.add('hidden');
                    editImagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        // ฟังก์ชันสำหรับตั้งค่ารูปภาพ Edit Form
        function setExistingEditImage(imageUrl) {
            if (imageUrl && imageUrl !== '' && imageUrl !== '/placeholder.svg') {
                editPreviewImg.src = imageUrl;
                editUploadZone.classList.add('hidden');
                editImagePreview.classList.remove('hidden');
            } else {
                editPreviewImg.src = '/placeholder.svg';
                editUploadZone.classList.remove('hidden');
                editImagePreview.classList.add('hidden');
            }
        }

        // Auto format เบอร์โทร xxx-xxxxxxx
        document.getElementById('tel').addEventListener('input', function (e) {
            // เอาเฉพาะตัวเลข
            let digits = this.value.replace(/\D/g, '');

            // จำกัดไม่เกิน 10 หลัก
            if (digits.length > 10) digits = digits.slice(0, 10);

            // ใส่ - หลังตัวที่ 3
            if (digits.length > 3) {
                this.value = digits.slice(0, 3) + '-' + digits.slice(3);
            } else {
                this.value = digits;
            }
        });
    </script>
</body>
</html>