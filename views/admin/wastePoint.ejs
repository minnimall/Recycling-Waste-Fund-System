    <script>
        let map;
        let markers = [];
        let currentFilter = 'all';
        
        // Sample data - replace with actual data from server
        const wastePoints = <%- JSON.stringify(wastePoints) %>; 

        function initMap() {
            map = L.map("map").setView([13.7563, 100.5018], 15);
            L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                attribution: '© Google',
                maxZoom: 20
            }).addTo(map);
            
            updateStatistics();
        }

        function getMarkerIcon(type, isOpen) {
            const colors = {
                'bank': '#3B82F6',
                'center': '#10B981',
                'community': '#8B5CF6',
                'mobile': '#F97316'
            };
            
            const icons = {
                'bank': 'university',
                'center': 'recycle',
                'community': 'users',
                'mobile': 'truck'
            };

            const color = colors[type] || '#6B7280';
            const icon = icons[type] || 'map-marker-alt';
            const opacity = isOpen ? '1' : '0.5';

            return L.divIcon({
                html: `
                    <div style="background-color: ${color}; opacity: ${opacity};" 
                        class="w-10 h-10 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                        <i class="fas fa-${icon} text-white text-sm"></i>
                    </div>
                `,
                className: 'custom-marker',
                iconSize: [40, 40],
                iconAnchor: [20, 20]
            });
        }

        function getTypeLabel(type) {
            const labels = {
                'bank': 'ธนาคารขยะ',
                'center': 'ศูนย์รับซื้อขยะ',
                'community': 'จุดรับซื้อชุมชน',
                'mobile': 'รถรับซื้อเคลื่อนที่'
            };
            return labels[type] || 'ไม่ระบุ';
        }

        // ใน <script> ส่วน updateMap()
        function updateMap() {
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            const filteredPoints = currentFilter === 'all' 
                ? wastePoints 
                : wastePoints.filter(p => p.type === currentFilter);

            filteredPoints.forEach((point) => {
                if (!point.latitude || !point.longitude) return;
                
                const marker = L.marker([point.latitude, point.longitude], {
                    icon: getMarkerIcon(point.type, point.isOpen)
                })
                .addTo(map)
                .bindPopup(`
                    <div class="p-3 min-w-[250px]">
                        <h3 class="font-bold text-lg text-gray-800 mb-2 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-green-600"></i>
                            ${point.wastePointName}
                        </h3>
                        <div class="space-y-2 text-sm">
                            <p class="flex items-center gap-2 text-gray-600">
                                <i class="fas fa-tag text-gray-400 w-4"></i>
                                <span class="font-medium">${getTypeLabel(point.type)}</span>
                            </p>
                            ${point.village ? `
                            <p class="flex items-center gap-2 text-gray-600">
                                <i class="fas fa-home text-gray-400 w-4"></i>
                                ${point.village.villageName}
                            </p>` : ''}
                            <p class="flex items-center gap-2 text-gray-600">
                                <i class="fas fa-map-pin text-gray-400 w-4"></i>
                                ${point.location}
                            </p>
                            ${point.note ? `
                            <p class="flex items-center gap-2 text-gray-600 pt-2 border-t">
                                <i class="fas fa-info-circle text-blue-400 w-4"></i>
                                ${point.note}
                            </p>` : ''}
                            <div class="pt-2 border-t">
                                <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full ${
                                    point.isOpen ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
                                }">
                                    <i class="fas fa-${point.isOpen ? 'check' : 'times'}-circle"></i>
                                    ${point.isOpen ? "เปิดบริการ" : "ปิดชั่วคราว"}
                                </span>
                            </div>
                        </div>
                    </div>
                `);
                markers.push(marker);
            });

            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.1));
            }

            document.getElementById('visible-markers').textContent = markers.length;
        }

        function updatePointsList() {
            const tbody = document.getElementById("points-table-body");
            const totalPoints = document.getElementById("total-points");
            tbody.innerHTML = "";
            totalPoints.textContent = wastePoints.length;

            wastePoints.forEach((point) => {
                const row = document.createElement("tr");
                row.className = "hover:bg-gray-50 transition duration-150";
                row.innerHTML = `
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center ${
                                point.type === 'bank' ? 'bg-blue-100' :
                                point.type === 'center' ? 'bg-green-100' :
                                point.type === 'community' ? 'bg-purple-100' : 'bg-orange-100'
                            }">
                                <i class="fas fa-${
                                    point.type === 'bank' ? 'university' :
                                    point.type === 'center' ? 'recycle' :
                                    point.type === 'community' ? 'users' : 'truck'
                                } ${
                                    point.type === 'bank' ? 'text-blue-600' :
                                    point.type === 'center' ? 'text-green-600' :
                                    point.type === 'community' ? 'text-purple-600' : 'text-orange-600'
                                }"></i>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-gray-900">${point.wastePointName}</div>
                                <div class="text-xs text-gray-500">${point.location}</div>
                            </div>
                        </div>
                    </td>

                    <td class="px-6 py-4 hidden md:table-cell">
                        ${point.village ? `
                            <div class="text-sm text-gray-900">${point.village.villageName}</div>
                        ` : '<span class="text-xs text-gray-400">ไม่ระบุ</span>'}
                    </td>
                    
                    <td class="px-6 py-4">
                        <span class="px-3 py-1 text-xs font-medium rounded-full ${
                            point.type === 'bank' ? 'bg-blue-100 text-blue-700' :
                            point.type === 'center' ? 'bg-green-100 text-green-700' :
                            point.type === 'community' ? 'bg-purple-100 text-purple-700' : 'bg-orange-100 text-orange-700'
                        }">
                            ${getTypeLabel(point.type)}
                        </span>
                    </td>

                    <td class="px-6 py-4">
                        <span class="px-3 py-1 inline-flex items-center gap-1 text-xs font-semibold rounded-full ${
                            point.isOpen ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
                        }">
                            <i class="fas fa-${point.isOpen ? 'check' : 'times'}-circle"></i>
                            ${point.isOpen ? "เปิดบริการ" : "ปิดชั่วคราว"}
                        </span>
                    </td>

                    <td class="px-6 py-4">
                        <div class="flex gap-2">
                            <button onclick="toggleStatus('${point._id}', ${!point.isOpen})" 
                                    class="min-w-[70px] px-3 py-1.5 rounded-lg text-xs font-medium text-white transition duration-200 ${
                                        point.isOpen ? 'bg-red-500 hover:bg-red-600' : 'bg-green-500 hover:bg-green-600'
                                    }">
                                <i class="fas fa-${point.isOpen ? 'times' : 'check'}-circle mr-1"></i>
                                ${point.isOpen ? 'ปิด' : 'เปิด'}
                            </button>
                            <button onclick="editPoint('${point._id}')" 
                                    class="px-3 py-1.5 rounded-lg bg-blue-500 hover:bg-blue-600 text-white text-xs font-medium transition duration-200">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deletePoint('${point._id}')" 
                                    class="px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-xs font-medium transition duration-200">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function updateStatistics() {
            const totalAll = wastePoints.length;
            const totalOpen = wastePoints.filter(p => p.isOpen).length;
            const totalClosed = wastePoints.filter(p => !p.isOpen).length;

            document.getElementById('total-all').textContent = totalAll;
            document.getElementById('total-open').textContent = totalOpen;
            document.getElementById('total-closed').textContent = totalClosed;
        }

        function filterByType(type) {
            currentFilter = type;
            
            // Update active button
            document.querySelectorAll('.filter-badge').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            updateMap();
        }

        function centerMap() {
            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.1));
            }
        }

        function refreshMap() {
            updateMap();
            Swal.fire({
                icon: 'success',
                title: 'รีเฟรชแล้ว',
                text: 'อัพเดทข้อมูลบนแผนที่เรียบร้อย',
                timer: 1500,
                showConfirmButton: false
            });
        }

        async function toggleStatus(id, newStatus) {
            const result = await Swal.fire({
                title: "ยืนยันการเปลี่ยนสถานะ?",
                text: newStatus ? "เปิดให้บริการอีกครั้ง" : "ปิดให้บริการชั่วคราว",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-check mr-2"></i>ยืนยัน',
                cancelButtonText: '<i class="fas fa-times mr-2"></i>ยกเลิก',
                confirmButtonColor: '#16A34A',
                cancelButtonColor: '#6B7280'
            });

            if (result.isConfirmed) {
                // Simulate API call
                Swal.fire({
                    title: 'กำลังประมวลผล...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                setTimeout(() => {
                    window.location.href = `/admin/wastePoint/toggle/${id}?isOpen=${newStatus}`;
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: 'เปลี่ยนสถานะเรียบร้อยแล้ว',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }, 1000);
            }
        }

        function editPoint(id) {
            window.location.href = `/admin/wastePoint/edit/${id}`;
            Swal.fire({
                icon: 'info',
                title: 'แก้ไขจุดรับซื้อ',
                text: `กำลังไปยังหน้าแก้ไข ID: ${id}`,
                timer: 1500,
                showConfirmButton: false
            });
        }

        async function deletePoint(id) {
            const result = await Swal.fire({
                title: "ยืนยันการลบ?",
                text: "คุณต้องการลบจุดรับซื้อขยะนี้หรือไม่ การดำเนินการนี้ไม่สามารถย้อนกลับได้",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DC2626",
                cancelButtonColor: "#6B7280",
                confirmButtonText: '<i class="fas fa-trash mr-2"></i>ลบ',
                cancelButtonText: '<i class="fas fa-times mr-2"></i>ยกเลิก',
            });

            if (result.isConfirmed) {
                Swal.fire({
                    title: 'กำลังลบ...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                setTimeout(() => {
                    window.location.href = `/admin/wastePoint/delete/${id}`;
                    Swal.fire({
                        icon: 'success',
                        title: 'ลบสำเร็จ!',
                        text: 'ลบจุดรับซื้อขยะเรียบร้อยแล้ว',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }, 1000);
            }
        }

        // Initialize
        window.addEventListener('DOMContentLoaded', () => {
            initMap();
            updatePointsList();
            updateMap();

            // Check for messages in URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');

            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'สำเร็จ!',
                    text: successMessage,
                    confirmButtonText: 'ตกลง',
                    confirmButtonColor: '#16A34A',
                    timer: 3000
                });
            }

            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });
    </script>

</html>