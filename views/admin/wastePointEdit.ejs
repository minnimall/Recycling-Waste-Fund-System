<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/funeral-assistance.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <!-- Leaflet -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <style>
        .leaflet-container {
            height: 400px;
            border-radius: 0.5rem;
        }
        
        @media (min-width: 768px) {
            .leaflet-container {
                height: 500px;
            }
        }
    </style>
</head>

<body class="bg-gray-50">
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <!-- Page Header -->
        <div class="mx-4 mb-3 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                        แก้ไขจุดรับซื้อขยะ
                    </h1>
                    <p class="text-gray-600 mt-2">แก้ไขข้อมูลจุดรับซื้อขยะในชุมชน</p>
                </div>
                <a href="/admin/wastePoint" class="bg-red-700 text-white px-4 py-2 rounded-md hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200 flex items-center">
                    <i class="fa-solid fa-arrow-left mr-2"></i>ย้อนกลับ
                </a>
            </div>
        </div>

        <!-- Map Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6 mx-4">
            <h2 class="text-xl font-bold text-gray-800 mb-4">📍 เลือกตำแหน่งจุดรับซื้อขยะ</h2>
            
            <!-- Search and Current Location -->
            <div class="flex gap-2 mb-4 flex-wrap">
                <div class="flex-1 min-w-[200px]">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="ค้นหาสถานที่... (เช่น ตลาดสด, โรงเรียน, วัด)" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    />
                </div>
                <button 
                    id="searchBtn" 
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold transition whitespace-nowrap">
                    <i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา
                </button>
                <button 
                    id="currentLocationBtn" 
                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg font-semibold transition whitespace-nowrap">
                    <i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน
                </button>
            </div>

            <!-- Map -->
            <div id="map" class="rounded-lg border-2 border-gray-200 mb-4"></div>

            <!-- Coordinates Display -->
            <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-lg p-4 border border-green-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-semibold text-gray-600 flex items-center gap-1">
                            <i class="fas fa-map-marker-alt text-green-600"></i>
                            ละติจูด (Latitude)
                        </label>
                        <p id="latDisplay" class="text-lg font-mono text-gray-800 mt-1">-</p>
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-gray-600 flex items-center gap-1">
                            <i class="fas fa-map-marker-alt text-blue-600"></i>
                            ลองจิจูด (Longitude)
                        </label>
                        <p id="lngDisplay" class="text-lg font-mono text-gray-800 mt-1">-</p>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-t border-gray-300">
                    <label class="text-sm font-semibold text-gray-600 flex items-center gap-1">
                        <i class="fas fa-location-dot text-red-600"></i>
                        ชื่อสถานที่
                    </label>
                    <p id="locationName" class="text-base text-gray-800 mt-1">กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่ง</p>
                </div>
            </div>
        </div>

        <!-- Form Section -->
        <form id="wasteForm" action="/admin/wastePointUpdate/<%= wastePoint._id %>" method="POST" class="bg-white rounded-lg shadow-md p-6 mx-4">
            <h2 class="text-xl font-bold text-gray-800 mb-6">📝 ข้อมูลจุดรับซื้อขยะ</h2>

            <!-- ผู้แก้ไขข้อมูล -->
            <input type="hidden" id="updateBy" name="updateBy" value="<%= username %>">
            <input type="hidden" id="location" name="location" value="<%= wastePoint.location %>">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- ชื่อจุดรับซื้อ -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        ชื่อจุดรับซื้อขยะ <span class="text-red-500">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="wastePointName" 
                        name="wastePointName"
                        value="<%= wastePoint.wastePointName %>"
                        required
                        placeholder="เช่น จุดรับซื้อขยะชุมชนบ้านใหม่"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    />
                </div>

                <!-- หมู่บ้าน -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        หมู่บ้าน <span class="text-red-500">*</span>
                    </label>
                    <select 
                        id="village" 
                        name="village"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <option value="">ไม่ระบุหมู่บ้าน</option>
                        <% villages.forEach(village => { %>
                            <option value="<%= village._id %>" 
                                <%= wastePoint.village && wastePoint.village._id.toString() === village._id.toString() ? 'selected' : '' %>>
                                <%= village.villageName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- ประเภทจุดรับซื้อ -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        ประเภทจุดรับซื้อ <span class="text-red-500">*</span>
                    </label>
                    <select id="type" name="type" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <option value="">เลือกประเภท</option>
                        <option value="bank" <%= wastePoint.type === 'bank' ? 'selected' : '' %>>ธนาคารขยะ</option>
                        <option value="center" <%= wastePoint.type === 'center' ? 'selected' : '' %>>ศูนย์รับซื้อขยะรีไซเคิล</option>
                        <option value="community" <%= wastePoint.type === 'community' ? 'selected' : '' %>>จุดรับซื้อชุมชน</option>
                        <option value="mobile" <%= wastePoint.type === 'mobile' ? 'selected' : '' %>>รถรับซื้อเคลื่อนที่</option>
                    </select>
                </div>

                <!-- สถานะเปิด-ปิด -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        สถานะการเปิดบริการ
                    </label>
                    <div class="flex gap-4">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input 
                                type="radio" 
                                name="isOpen" 
                                value="true" 
                                <%= wastePoint.isOpen === true ? 'checked' : '' %>
                                class="w-4 h-4 text-green-600 focus:ring-green-500"
                            />
                            <span class="text-gray-700 flex items-center gap-2">
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">
                                    <i class="fas fa-check-circle"></i> เปิดบริการ
                                </span>
                            </span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input 
                                type="radio" 
                                name="isOpen" 
                                value="false"
                                <%= wastePoint.isOpen === false ? 'checked' : '' %>
                                class="w-4 h-4 text-red-600 focus:ring-red-500"
                            />
                            <span class="text-gray-700 flex items-center gap-2">
                                <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-medium">
                                    <i class="fas fa-times-circle"></i> ปิดชั่วคราว
                                </span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- หมายเหตุ -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        หมายเหตุ / รายละเอียดเพิ่มเติม
                    </label>
                    <textarea 
                        id="note" 
                        name="note"
                        rows="3"
                        placeholder="เช่น เปิดทุกวันจันทร์-ศุกร์, รับเฉพาะขยะพลาสติก"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    ><%= wastePoint.note || '' %></textarea>
                </div>
            </div>

            <!-- Hidden fields for coordinates -->
            <input type="hidden" id="latitude" name="latitude" value="<%= wastePoint.latitude %>" />
            <input type="hidden" id="longitude" name="longitude" value="<%= wastePoint.longitude %>" />

            <!-- Submit Button -->
            <div class="mt-8 flex gap-4">
                <button 
                    type="submit" 
                    class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition shadow-md hover:shadow-lg">
                    <i class="fa-solid fa-save mr-2"></i>บันทึกการแก้ไข
                </button>
                <a 
                    href="/admin/wastePoint"
                    class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-3 px-6 rounded-lg transition text-center hover:shadow-lg">
                    <i class="fa-solid fa-times mr-2"></i>ยกเลิก
                </a>
            </div>
        </form>
    </div>

</body>
<script>
    // Initialize map with existing coordinates
    const existingLat = <%= wastePoint.latitude || 16.4322 %>;
    const existingLng = <%= wastePoint.longitude || 102.8236 %>;
    
    const map = L.map('map').setView([existingLat, existingLng], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
    }).addTo(map);

    let marker = null;
    let selectedLat = existingLat;
    let selectedLng = existingLng;

    // Initialize marker with existing location
    function initializeMarker() {
        marker = L.marker([existingLat, existingLng]).addTo(map);
        document.getElementById('latDisplay').textContent = existingLat.toFixed(6);
        document.getElementById('lngDisplay').textContent = existingLng.toFixed(6);
        
        // Get location name
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${existingLat}&lon=${existingLng}&accept-language=th`)
            .then(response => response.json())
            .then(data => {
                const locationName = data.display_name || 'ไม่พบชื่อสถานที่';
                document.getElementById('locationName').textContent = locationName;
                document.getElementById('searchInput').value = locationName;
                marker.bindPopup(`<b>${locationName}</b><br>Lat: ${existingLat.toFixed(6)}<br>Lng: ${existingLng.toFixed(6)}`);
            });
    }

    initializeMarker();

    function updateMarker(lat, lng) {
        selectedLat = lat;
        selectedLng = lng;

        if (marker) {
            map.removeLayer(marker);
        }

        marker = L.marker([lat, lng]).addTo(map);

        document.getElementById('latDisplay').textContent = lat.toFixed(6);
        document.getElementById('lngDisplay').textContent = lng.toFixed(6);
        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        document.getElementById('locationName').textContent = '🔄 กำลังค้นหาชื่อสถานที่...';
        document.getElementById('searchInput').value = '🔄 กำลังค้นหาชื่อสถานที่...';
        
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=th`)
            .then(response => response.json())
            .then(data => {
                const locationName = data.display_name || 'ไม่พบชื่อสถานที่';
                document.getElementById('locationName').textContent = locationName;
                document.getElementById('location').value = locationName;
                document.getElementById('searchInput').value = locationName;
                marker.bindPopup(`<b>${locationName}</b><br>Lat: ${lat.toFixed(6)}<br>Lng: ${lng.toFixed(6)}`).openPopup();
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('locationName').textContent = 'ไม่สามารถค้นหาชื่อสถานที่ได้';
            });
    }

    map.on('click', function(e) {
        updateMarker(e.latlng.lat, e.latlng.lng);
    });

    document.getElementById('currentLocationBtn').addEventListener('click', function() {
        if (navigator.geolocation) {
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> กำลังค้นหา...';
            this.disabled = true;
            
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    map.setView([lat, lng], 16);
                    updateMarker(lat, lng);
                    this.innerHTML = '<i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน';
                    this.disabled = false;
                },
                (error) => {
                    Swal.fire({
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถเข้าถึงตำแหน่งปัจจุบันได้: ' + error.message,
                        icon: 'error',
                        confirmButtonColor: '#DC2626'
                    });
                    this.innerHTML = '<i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน';
                    this.disabled = false;
                }
            );
        } else {
            Swal.fire({
                title: 'ไม่รองรับ',
                text: 'เบราว์เซอร์ของคุณไม่รองรับการระบุตำแหน่ง',
                icon: "warning",
                confirmButtonColor: "#3085d6"
            });
        }
    });

    document.getElementById('searchBtn').addEventListener('click', function() {
        const query = document.getElementById('searchInput').value.trim();
        if (!query) {
            Swal.fire({
                title: 'กรุณากรอกข้อมูล',
                text: 'กรุณาพิมพ์ชื่อสถานที่ที่ต้องการค้นหา',
                icon: "warning",
                confirmButtonColor: "#3085d6"
            });
            return;
        }

        this.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> กำลังค้นหา...';
        this.disabled = true;

        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1&accept-language=th`)
            .then(response => response.json())
            .then(data => {
                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat);
                    const lng = parseFloat(data[0].lon);
                    map.setView([lat, lng], 16);
                    updateMarker(lat, lng);
                } else {
                    Swal.fire({
                        title: 'ไม่พบข้อมูล',
                        text: 'ไม่พบสถานที่ที่ค้นหา กรุณาลองใหม่อีกครั้ง',
                        icon: "warning",
                        confirmButtonColor: "#3085d6"
                    });
                }
                this.innerHTML = '<i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา';
                this.disabled = false;
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    title: 'เกิดข้อผิดพลาด',
                    text: 'เกิดข้อผิดพลาดในการค้นหา',
                    icon: "error",
                    confirmButtonColor: "#DC2626"
                });
                this.innerHTML = '<i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา';
                this.disabled = false;
            });
    });

    document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('searchBtn').click();
        }
    });

    // Form validation before submit
    document.getElementById('wasteForm').addEventListener('submit', function(e) {
        const lat = document.getElementById('latitude').value;
        const lng = document.getElementById('longitude').value;
        
        if (!lat || !lng) {
            e.preventDefault();
            Swal.fire({
                title: 'กรุณาเลือกตำแหน่ง',
                text: 'กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่งจุดรับซื้อขยะ',
                icon: 'warning',
                confirmButtonColor: '#F59E0B'
            });
        }
    });
</script>
</html>