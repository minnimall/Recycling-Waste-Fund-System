<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/employee.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // เช็คข้อความที่ส่งมาจาก URL
            const urlParams = new URLSearchParams(window.location.search);
            const successMessage = urlParams.get('message');
            const errorMessage = urlParams.get('error');
    
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
    
        </script>
            <!-- Main content -->
            <div class="content">
                <div class="xtop-container">
                    <div class="count-con">
                        <div class="box user-box"><span><%= emp.length %></span>จำนวนผู้ใช้งาน</div>
                        <div class="box employee-box"><span><%= emp.filter(employee => employee.role === 'employee').length %></span>จำนวนพนักงาน</div>
                        <div class="box admin-box"><span><%= emp.filter(employee => employee.role === 'admin').length %></span>จำนวนผู้ดูแลระบบ</div>
                    </div>
                    <div class="content-header2">
                        <!-- <h1>พนักงาน (<%= emp.length %> รายการ)</h1> -->
                        <div class="add-media" onclick="empFormToggle()">เพิ่มพนักงาน</div>
                    </div>
                </div>
                <div class="emp-container">
                    <div class="table-con">
                        <div class="search">
                            <form action="" method="get">
                                <select name="role" id="role">
                                    <option value="">All</option>
                                    <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                                    <option value="employee" <%= role === 'employee' ? 'selected' : '' %>>Employee</option>
                                    <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
                                </select>
                                <!-- ช่องค้นหาข้อมูล -->
                                <input type="text" placeholder="ค้นหา" name="search" value="<%= search || '' %>">
                                <button>ค้นหา</button>
                            </form>
                        </div>
                        <table class="table-auto">
                            <thead>
                                <tr>
                                    <th class="table-emp-index">ลำดับ</th>
                                    <th class="table-emp-username">ชื่อผู้ใช้</th>
                                    <th class="table-emp-email">อีเมล</th>
                                    <th class="table-emp-tel">เบอร์โทร</th>
                                    <th class="table-emp-role">บทบาท</th>
                                    <th class="table-emp-delete">จัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (emp && emp.length > 0) { %>
                                    <% emp.forEach((employee, index) => { %>
                                        <tr>
                                            <td class="table-emp-index"><%= index + 1 %></td>
                                            <td class="table-emp-username"><%= employee.username %></td>
                                            <td class="table-emp-email"><%= employee.email %></td>
                                            <td class="table-emp-tel"><%= employee.tel %></td>
                                            <td class="table-emp-role">
                                                <div class="role-tag <%= employee.role === 'admin' ? 'admin-role-bg' : 'employee-role-bg' %>">
                                                    <%= employee.role %>
                                                </div>
                                            </td>
                                            <td class="table-emp-delete">
                                                <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                                    onclick="setEmpEditForm('<%= index + 1 %>', '<%= employee._id %>', '<%= employee.username %>',
                                                                '<%= employee.firstname %>', '<%= employee.lastname %>', '<%= employee.tel %>',
                                                                '<%= employee.email %>','<%= employee.role %>')">
                                                    <i class="fa fa-edit"></i>
                                                </button>
                                                <button
                                                    onclick="deleteEmp(['<%= index + 1 %>', '<%= employee._id %>','<%= employee.username %>'])"
                                                    class="delete-btn">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6">ไม่พบข้อมูลพนักงาน</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>                    
                    

                    <div class="emp-form" id="add_emp" style="display: none;">
                        <form action="/admin/employeeRegister" method="POST">
                            <div class="form-head">
                                <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                                <span>เพิ่มบัญชีผู้ใช้</span>
                            </div>
                            <div class="input-group">
                                <!-- Username -->
                                <label>ชื่อผู้ใช้</label>
                                <input type="text" name="username" placeholder="ชื่อผู้ใช้" required>

                                <!-- Password -->
                                <label>รหัสผ่าน</label>
                                <input type="password" name="password" placeholder="รหัสผ่าน" required>

                                <!-- ConfirmPassword -->
                                <label>ยืนยันรหัสผ่าน</label>
                                <input type="password" name="confirmPassword" placeholder="ยืนยันรหัสผ่าน" required>

                                <!-- ชื่อจริง -->
                                <label>ชื่อจริง</label>
                                <input type="text" name="firstname" placeholder="ชื่อจริง" required>

                                <!-- นามสกุล -->
                                <label>นามสกุล</label>
                                <input type="text" name="lastname" placeholder="นามสกุล" required>

                                <!-- เบอร์ -->
                                <label>เบอร์โทร</label>
                                <input type="tel" name="tel" placeholder="094-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}"
                                    required>

                                <!-- Email -->
                                <label>อีเมล</label>
                                <input type="email" name="email" placeholder="emp@mail.com" required>

                                <!-- Role -->
                                <label>บทบาท</label>
                                <select name="role" required>
                                    <option value="" disabled selected>เลือกบทบาท</option>
                                    <option value="admin">Admin</option>
                                    <option value="employee">Employee</option>
                                </select>

                                <!-- Submit and Cancel Buttons -->
                                <div class="submit-btn">
                                    <button type="submit" class="submit">บันทึก</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="emp-form" id="edit_emp" style="display: block;">
                        <form action="/admin/employeeEdit" method="POST">
                            <div class="form-head">
                                <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                                <span>แก้ไขบัญชีผู้ใช้</span>
                            </div>
                            <div class="input-group">
                                <input type="hidden" name="_id" id="hiddenEmpId" value="">
                                <!-- Username -->
                                <label>ชื่อผู้ใช้</label>
                                <input type="text" name="username" id="empUsername" placeholder="username"  required>

                                <!-- ชื่อจริง -->
                                <label>ชื่อจริง</label>
                                <input type="text" name="firstname" id="empFirstname" placeholder="ชื่อจริง" required>

                                <!-- นามสกุล -->
                                <label>นามสกุล</label>
                                <input type="text" name="lastname" id="empLastname" placeholder="นามสกุล" required>

                                <!-- Tel -->
                                <label>เบอร์โทร</label>
                                <input type="tel" name="tel" id="empTel"  placeholder="094-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}" id="empTel"
                                    required>

                                <!-- Email -->
                                <label>อีเมล</label>
                                <input type="email" name="email" id="empEmail" placeholder="emp@mail.com" required id="emailEmp">

                                <!-- Role -->
                                <label>บทบาท</label>
                                <select name="role" id="empRole" required>
                                    <option value="" disabled selected>เลือกบทบาท</option>
                                    <option value="admin">Admin</option>
                                    <option value="employee">Employee</option>
                                </select>

                                <!-- Submit and Cancel Buttons -->
                                <div class="submit-btn">
                                    <button type="submit" class="submit">บันทึก</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
        let lastClickedRow = null;

        function setEmpEditForm(Index, Id, Username, Firstname, Lastname, Tel, Email, Role) {
            const editForm = document.getElementById('edit_emp');
            const addForm = document.getElementById('add_emp');

            const InputEmpTypeId = document.getElementById('hiddenEmpId');
            InputEmpTypeId.value = Id;
            console.log("ID:", Id); // Debug

            const InputUsername = document.getElementById('empUsername');
            InputUsername.value = Username;

            const InputFirstname = document.getElementById('empFirstname');
            InputFirstname.value = Firstname;

            const InputLastname = document.getElementById('empLastname');
            InputLastname.value = Lastname;

            const InputTel = document.getElementById('empTel');
            InputTel.value = Tel;

            const InputEmail = document.getElementById('empEmail');
            InputEmail.value = Email;

            const InputRole = document.getElementById('empRole');
            InputRole.value = Role;

            addForm.style.display = 'none';
            
            const selectedRow = document.querySelector(`.was-row-${Index}`);
            if (lastClickedRow === selectedRow) {
                selectedRow.style.backgroundColor = '';
                lastClickedRow = null;
                editForm.style.display = 'none';
            } else {
                if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
                selectedRow.style.backgroundColor = '#8EDBA4';
                editForm.style.display = 'block';
                lastClickedRow = selectedRow;
            }
        }
        //ปุ่มแสดงฟอร์มเพิ่มพนักงาน
        function empFormToggle() {
            const addForm = document.getElementById('add_emp');
            const editForm = document.getElementById('edit_emp');

            editForm.style.display = 'none';

            if (addForm.style.display === 'block') {
                addForm.style.display = 'none';
            }
            else {
                addForm.style.display = 'block';
            }
        }
        //ลบหนักงาน
        function deleteEmp(data) {
            Swal.fire({
                title: `ลบพนักงาน "${data[2]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/employeeDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>
</html>