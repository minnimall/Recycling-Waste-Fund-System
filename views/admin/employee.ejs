<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="style_admin/employee.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
            <!-- Main content -->
            <div class="content">
                <div class="content-header">
                    <h1>พนักงาน (<%= emp.length %> รายการ)</h1>
                    <div class="add-media">เพิ่มพนักงาน</div>
                </div>
                <div class="emp-container">
                    <table class="table-auto"> 
                        <thead>
                            <tr>
                                <th class="table-emp-index">ลำดับ</th>
                                <!-- <th class="table-emp-img">รูป</th> -->
                                <th class="table-emp-username">ชื่อ</th>
                                <th class="table-emp-email">อีเมล</th>
                                <th class="table-emp-tel">เบอร์โทร</th>
                                <th class="table-emp-role">บทบาท</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (emp && emp.length > 0) { %>
                                <% emp.forEach((employee, index) => { %>
                                    <tr>
                                        <td class="table-emp-index"><%= index + 1 %></td>
                                        <!-- <td class="table-emp-img"><img src="../img/admin/logo.png" alt="Employee Image"></td>  -->
                                        <td class="table-emp-name"><%= employee.username %></td>
                                        <td class="table-emp-email"><%= employee.email %></td>
                                        <td class="table-emp-tel"><%= employee.tel %></td>
                                        <td class="table-emp-tel"><%= employee.role %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6">ไม่พบข้อมูลพนักงาน</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>                    
                    
                    <div class="emp-form">
                        <form action="/register" method="POST">
                            <div class="form-head">
                                <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                                <span>รายละเอียดบัญชีผู้ใช้</span>
                            </div>
                            <div class="input-group">
                                <!-- Username -->
                                <label>ชื่อผู้ใช้</label>
                                <input type="text" name="username" placeholder="username" required>
                    
                                <!-- Password -->
                                <label>รหัสผ่าน</label>
                                <input type="password" name="password" placeholder="password" required>

                                <!-- ConfirmPassword -->
                                <label>ยืนยันรหัสผ่าน</label>
                                <input type="password" name="confirmPassword" placeholder="confirmPassword" required>
                    
                                <!-- Tel -->
                                <label>เบอร์โทร</label>
                                <input type="tel" name="tel" placeholder="094-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}" required>
                    
                                <!-- Email -->
                                <label>อีเมล</label>
                                <input type="email" name="email" placeholder="emp@mail.com" required>
                    
                                <!-- Role -->
                                <label>บทบาท</label>
                                <select name="role" required>
                                    <option value="admin">Admin</option>
                                    <option value="employee">Employee</option>
                                </select>
                    
                                <!-- Submit and Cancel Buttons -->
                                <div class="submit-btn">
                                    <button type="submit" class="submit">บันทึก</button>
                                    <button type="button" class="cancel">ยกเลิก</button>
                                </div>
                            </div>
                        </form>
                    </div>                    
                </div>
            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

</html>