<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/employee.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');
    
        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    
        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    
    </script>

    <!-- Main content -->
    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">พนักงาน</h1>
                <p class="text-gray-600">จำนวนพนักงานทั้งหมดในระบบกองทุนขยะรีไซเคิล</p>
            </div>

            <div>
                <button type="button" class="add-media bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="empFormToggle()">เพิ่มพนักงาน</button>
            </div>
        </div>

        <!-- Stats cards -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-blue-50 rounded-lg p-6 shadow-sm border border-blue-100 transition-transform hover:scale-105">
                <div class="text-3xl font-bold text-blue-700 mb-2"><%= emp.length %></div>
                <div class="text-gray-600">จำนวนผู้ใช้งานทั้งหมด</div>
            </div>
            <div class="bg-green-50 rounded-lg p-6 shadow-sm border border-green-100 transition-transform hover:scale-105">
                <div class="text-3xl font-bold text-green-700 mb-2"><%= emp.filter(employee => employee.role === 'employee').length %></div>
                <div class="text-gray-600">จำนวนพนักงาน</div>
            </div>
            <div class="bg-red-50 rounded-lg p-6 shadow-sm border border-red-100 transition-transform hover:scale-105">
                <div class="text-3xl font-bold text-red-700 mb-2"><%= emp.filter(employee => employee.role === 'admin').length %></div>
                <div class="text-gray-600">จำนวนผู้ดูแลระบบ</div>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <form action="" method="GET">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <input type="text" id="search" name="search" value="<%= search || '' %>" placeholder="ค้นหาพนักงาน" 
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                            <div class="absolute left-3 top-2.5 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-64">
                        <select name="role" id="role" class="w-full py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                            <option value="">All</option>
                            <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                            <option value="employee" <%= role === 'employee' ? 'selected' : '' %>>Employee</option>
                            <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
                        </select>
                    </div>
                    <div>
                        <button class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                            <i class="fas fa-search mr-2"></i>ค้นหา
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    จำนวนสมาชิกทั้งหมด <span class="text-blue-600 text-base font-normal"><%= emp.length %> รายการ</span>
                </h2>
            </div>
        
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ลำดับที่</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อผู้ใช้</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">อีเมล</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">เบอร์โทร</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">บทบาท</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (emp && emp.length > 0) { %>
                            <% emp.forEach((employee, index) => { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-sm whitespace-nowrap text-center"><%= (currentPage - 1) * 10 + index + 1 %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= employee.firstname %> <%= employee.lastname %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= employee.email %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= employee.tel %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap">
                                        <div class="role-tag <%= employee.role === 'admin' ? 'admin-role-bg' : 'employee-role-bg' %>">
                                            <%= employee.role %>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-center">
                                        <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                            onclick="setEmpEditForm('<%= index + 1 %>', '<%= employee._id %>', '<%= employee.username %>',
                                                                    '<%= employee.firstname %>', '<%= employee.lastname %>', '<%= employee.tel %>',
                                                                    '<%= employee.email %>','<%= employee.role %>')">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button
                                            onclick="deleteEmp(['<%= index + 1 %>', '<%= employee._id %>','<%= employee.username %>','<%= employee.firstname %>','<%= employee.lastname %>'])"
                                            class="delete-btn">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-gray-500">- ไม่พบข้อมูล -</td>
                            </tr>
                        <% } %>
                    </tbody>                    
                </table>
            </div>
        </div>

        <!-- Add Employee Form -->
        <div id="add_emp" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/employeeRegister" method="POST" class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5">
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">เพิ่มบัญชีผู้ใช้</span>
                    </div>

                    <div class="input-group">
                        <div class="flex justify-around">
                            <div class="mr-5">
                                <!-- Username -->
                                <div class="mb-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อผู้ใช้</label>
                                    <input type="text" name="username" placeholder="ชื่อผู้ใช้" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500"> 
                                </div>

                                <!-- Password -->
                                <div class="mb-3">
                                    <label>รหัสผ่าน</label>
                                    <input type="password" name="password" placeholder="รหัสผ่าน" required>
                                </div>

                                <!-- ConfirmPassword -->
                                <div class="mb-3">
                                    <label>ยืนยันรหัสผ่าน</label>
                                    <input type="password" name="confirmPassword" placeholder="ยืนยันรหัสผ่าน" required>
                                </div>
                                
                            </div>
                            <div>
                                <!-- ชื่อจริง -->
                                <div class="mb-3">
                                    <label>ชื่อจริง</label>
                                    <input type="text" name="firstname" placeholder="ชื่อจริง" required>
                                </div>
                                
                                <!-- นามสกุล -->
                                <div class="mb-3">
                                    <label>นามสกุล</label>
                                    <input type="text" name="lastname" placeholder="นามสกุล" required>
                                </div>
                                
                                <!-- เบอร์ -->
                                <div class="mb-3">
                                    <label>เบอร์โทร</label>
                                    <input type="tel" name="tel" placeholder="094-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}" required>
                                </div>

                                <!-- Email -->
                                <div class="mb-3">
                                    <label>อีเมล</label>
                                    <input type="email" name="email" placeholder="emp@mail.com" required>
                                </div>

                                <!-- Role -->
                                <div class="mb-3">
                                    <label>บทบาท</label>
                                    <select name="role" required>
                                        <option value="" disabled selected>เลือกบทบาท</option>
                                        <option value="admin">Admin</option>
                                        <option value="employee">Employee</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-2">
                            <button type="button" onclick="cancelForm()"
                                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                            <button type="submit"
                                class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Employee Form - ย้ายออกมาแยกจาก add form -->
        <div id="edit_emp" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                <form action="/admin/employeeEdit" method="POST" class="bg-white rounded-xl shadow-lg w-full p-6 space-y-5">
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">แก้ไขบัญชีผู้ใช้</span>
                    </div>

                    <div class="input-group space-y-4">
                        <input type="hidden" name="_id" id="hiddenEmpId" value="">
                        
                        <!-- Username -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อผู้ใช้</label>
                            <input type="text" name="username" id="empUsername" placeholder="username" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- ชื่อจริง -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อจริง</label>
                            <input type="text" name="firstname" id="empFirstname" placeholder="ชื่อจริง" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- นามสกุล -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">นามสกุล</label>
                            <input type="text" name="lastname" id="empLastname" placeholder="นามสกุล" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- Tel -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">เบอร์โทร</label>
                            <input type="tel" name="tel" id="empTel" placeholder="094-XXXXXXX" pattern="[0-9]{3}-[0-9]{7}" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- Email -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">อีเมล</label>
                            <input type="email" name="email" id="empEmail" placeholder="emp@mail.com" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- Role -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">บทบาท</label>
                            <select name="role" id="empRole" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                                <option value="" disabled selected>เลือกบทบาท</option>
                                <option value="admin">Admin</option>
                                <option value="employee">Employee</option>
                            </select>
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-2">
                            <button type="button" onclick="cancelForm()"
                                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                            <button type="submit"
                                class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>


        <div class="pagination flex justify-center items-center mt-4 space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&role=<%= role %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ก่อนหน้า
                </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>&role=<%= role %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md 
                            <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                            <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&role=<%= role %>&search=<%= search %>"
                        class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ถัดไป
                </a>
            <% } %>
        </div>
    </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
    <script>
        let lastClickedRow = null;

        function setEmpEditForm(Index, Id, Username, Firstname, Lastname, Tel, Email, Role) {
            const editForm = document.getElementById('edit_emp');
            const addForm = document.getElementById('add_emp');

            const InputEmpTypeId = document.getElementById('hiddenEmpId');
            InputEmpTypeId.value = Id;
            console.log("ID:", Id); // Debug

            const InputUsername = document.getElementById('empUsername');
            InputUsername.value = Username;

            const InputFirstname = document.getElementById('empFirstname');
            InputFirstname.value = Firstname;

            const InputLastname = document.getElementById('empLastname');
            InputLastname.value = Lastname;

            const InputTel = document.getElementById('empTel');
            InputTel.value = Tel;

            const InputEmail = document.getElementById('empEmail');
            InputEmail.value = Email;

            const InputRole = document.getElementById('empRole');
            InputRole.value = Role;

            addForm.style.display = 'none';
            
            const selectedRow = document.querySelector(`.was-row-${Index}`);
            if (lastClickedRow === selectedRow) {
                selectedRow.style.backgroundColor = '';
                lastClickedRow = null;
                editForm.style.display = 'none';
            } else {
                if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
                selectedRow.style.backgroundColor = '#8EDBA4';
                editForm.style.display = 'block';
                lastClickedRow = selectedRow;
            }
        }
        //ปุ่มแสดงฟอร์มเพิ่มพนักงาน
        function empFormToggle() {
            const addForm = document.getElementById('add_emp');
            const editForm = document.getElementById('edit_emp');

            editForm.style.display = 'none';

            if (addForm.style.display === 'block') {
                addForm.style.display = 'none';
            }
            else {
                addForm.style.display = 'block';
            }
        }
        //ลบหนักงาน
        function deleteEmp(data) {
            Swal.fire({
                title: `ลบพนักงาน "${data[3]} ${data[4]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/employeeDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
        function cancelForm() {
            const addForm = document.getElementById('add_emp');
            const editForm = document.getElementById('edit_emp');

            addForm.style.display = 'none';
            editForm.style.display = 'none';

            if (editForm.style.display === 'block') {
                editForm.reset();
            }

            // ยกเลิกแรเงาแถว
            if (lastClickedRow) {
                lastClickedRow.style.backgroundColor = '';
                lastClickedRow = null;
            }
        }
    </script>
</html>