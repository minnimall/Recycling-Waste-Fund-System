<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

        <%- include('../partials/adminPartials/adminSidebar.ejs') %>
            <!-- Main content -->
            <div class="content">
                <div class="content-header">
                    <h1 class="title">ขยะ</h1>
                    <div class="add-media">เพิ่มรายการขยะ</div>
                </div>
                <div class="was-container">
                    <table class="table-auto">
                        <thead>
                            <tr>
                                <th class="table-was-index">ลำดับ</th>
                                <th class="table-was-name">ชื่อรายการขยะ</th>
                                <th class="table-was-price">ราคา (ราคา/กก.)</th>
                                <th class="table-was-type">ประเภทขยะ</th>
                                <th class="table-was-img">รูป</th>
                            </tr>
                        </thead>
                        <tbody>

                        </tbody>
                    </table>
                    <div class="was-form" id="edit_Form">
                        <form action="/admin/wastePost" method="POST" enctype="multipart/form-data">
                            <div class="form-head">
                                <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                                <span>รายละเอียดขยะ</span>
                            </div>        
                            <div class="input-group">
                                <!-- ชื่อขยะ -->
                                <label for="wasteName">ชื่อขยะ</label>
                                <input type="text" name="wasteName" id="wasteName" placeholder="ขวด PET ใส, โลหะ ฯลฯ" required>
                                
                                <!-- ราคาขยะ -->
                                <label for="pricePerUnit">ราคาขยะ (ราคา/กก.)</label>
                                <input type="text" name="pricePerUnit" id="pricePerUnit" placeholder="เช่น 6 บาท/กิโลกรัม" required>
                    
                                <!-- ประเภทขยะ -->
                                <label for="wasteType">ประเภทขยะ</label>
                                <select name="wasteType" id="wasteType" required>
                                    <option value="" disabled selected>เลือกประเภทขยะ</option>
                                    <% wasteTypes.forEach((type) => { %>
                                        <option value="<%= type._id %>"><%= type.wasteTypeName %></option> <!-- Assuming wasteType has 'name' field -->
                                    <% }); %>
                                </select>

                                <!-- รูปภาพขยะ -->
                                <div class="mt-3">
                                    <label class="title-img" for="img">รูปภาพขยะ</label>
                                </div>
                                <div class="img-input">
                                    <label class="block">
                                        <span class="sr-only">Choose profile photo</span>
                                        <input type="file" class="block w-full text-sm text-slate-500
                                            file:mr-4 file:py-2 file:px-4
                                            file:rounded-full file:border-0
                                            file:text-sm file:font-semibold
                                            file:bg-violet-50 file:text-violet-700
                                            hover:file:bg-violet-100
                                        "/>
                                    </label>
                                </div>
                    
                                <div class="submit-btn">
                                    <button type="submit" class="submit">บันทึก</button>
                                </div>
                            </div>
                        </form>
                    </div>                    
                </div>

            </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

</html>