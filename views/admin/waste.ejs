<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');
        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    
    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">ขยะ <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= waste.length %> รายการ)</span></h1>
                <p class="text-gray-600">รายการขยะทั้งหมดที่รับซื้อของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <!-- แทนที่ปุ่ม "เพิ่มรายการขยะ" เดิม -->
            <div class="flex gap-2">
                <button type="button" 
                    id="bulkPriceBtn"
                    class="hidden bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300"
                    onclick="openBulkPriceModal()">
                    <i class="fas fa-tags mr-1"></i>
                    ปรับราคายกกลุ่ม (<span id="selectedCount">0</span> รายการ)
                </button>
                <button type="button" 
                    class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" 
                    onclick="wasFormToggle()">เพิ่มรายการขยะ</button>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    ขยะ <span id="totalItems" class="text-blue-600 text-base font-normal"> 0 รายการ</span> 

                </h2>
            </div>
            <!-- Search + ItemsPerPage -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 mx-4 mb-4">
                <div class="flex-1 relative w-full">
                    <input type="text" id="searchInput" placeholder="ค้นหาขยะ..." 
                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                    <div class="absolute left-3 top-2.5 text-gray-400">
                        <i class="fas fa-search"></i>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label for="itemsPerPage" class="text-sm text-gray-600">แสดง:</label>
                    <select id="itemsPerPage" class="border rounded-lg px-2 py-1 focus:ring-2 focus:ring-green-500">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto mx-4 mb-6 bg-white">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">
                                <input type="checkbox" id="selectAll" class="w-4 h-4 cursor-pointer">
                            </th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ลำดับ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อรายการขยะ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ประเภทขยะ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ราคา (ราคา/กก.)</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">รูป</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" id="tableBody"></tbody>
                </table>

                <div id="noResults" class="text-center py-4 text-gray-500 hidden">- ไม่มีข้อมูลขยะ -</div>
                <div id="pagination" class="flex justify-center mt-4 gap-2"></div>
            </div>
        </div>

        <!-- Modal เพิ่มรายการขยะ -->
        <div id="add_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/wastePost" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5">
                    
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">เพิ่มรายการขยะ</span>
                    </div>
                    
                    <!-- ชื่อขยะ -->
                    <div>
                        <label for="wasteName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อขยะ <span class="text-red-500">*</span></label>
                        <input type="text" name="wasteName" id="wasteName" placeholder="ขวด PET ใส, โลหะ ฯลฯ" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- ประเภทขยะ -->
                    <div>
                        <label for="wasteType" class="block text-sm font-medium text-gray-700 mb-1">ประเภทขยะ <span class="text-red-500">*</span></label>
                        <select name="wasteType" id="wasteType" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled selected>เลือกประเภทขยะ</option>
                            <% wasteTypes.forEach((type) => { %>
                                <option value="<%= type._id %>"><%= type.wasteTypeName %></option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- ราคาขยะ -->
                    <div>
                        <label for="pricePerUnit" class="block text-sm font-medium text-gray-700 mb-1">ราคาขยะ (ราคา/กก.) <span class="text-red-500">*</span></label>
                        <input type="text" name="pricePerUnit" id="pricePerUnit" placeholder="เช่น 6 บาท/กิโลกรัม" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพขยะ -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพขยะ</label>
                        
                        <!-- Preview Area -->
                        <div class="relative">
                            <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" class="hidden">
                            
                            <!-- Upload Zone (แสดงเมื่อยังไม่มีรูป) -->
                            <div id="addUploadZone" 
                                class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG (ไม่เกิน 10 MB)</p>
                            </div>
                            
                            <!-- Image Preview (แสดงเมื่อมีรูป) -->
                            <div id="addImagePreview" class="hidden">
                                <div class="relative group">
                                    <img id="addPreviewImg" src="/placeholder-waste.svg" alt="Preview" 
                                        class="w-full h-64 object-contain rounded-lg border-2 border-gray-300 bg-gray-50">
                                    
                                    <!-- Overlay with Change Button -->
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                        <button type="button" id="addChangeImageBtn"
                                            class="opacity-0 group-hover:opacity-100 transition-opacity bg-white text-gray-700 px-4 py-2 rounded-lg font-medium shadow-lg hover:bg-gray-100 flex items-center gap-2">
                                            <ion-icon name="camera-outline"></ion-icon>
                                            <span>เปลี่ยนรูปภาพ</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Modal แก้ไข -->
        <div id="edit_Form" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/wasteEdit" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5 max-h-[90vh] overflow-y-auto">

                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">แก้ไขขยะ</span>
                    </div>
                    
                    <!-- ส่งค่า _id -->
                    <input type="hidden" name="_id" id="hiddenWasteId" value="">
                    
                    <!-- ชื่อขยะ -->
                    <div>
                        <label for="editWasteName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อขยะ</label>
                        <input type="text" name="wasteName" id="editWasteName" placeholder="ขวด PET ใส, โลหะ ฯลฯ" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- ประเภทขยะ -->
                    <div>
                        <label for="editWasteType" class="block text-sm font-medium text-gray-700 mb-1">ประเภทขยะ</label>
                        <select name="wasteType" id="editWasteType" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled selected>เลือกประเภทขยะ</option>
                            <% wasteTypes.forEach((type) => { %>
                                <option value="<%= type._id %>"><%= type.wasteTypeName %></option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- ราคาขยะ -->
                    <div>
                        <label for="editPricePerUnit" class="block text-sm font-medium text-gray-700 mb-1">ราคาขยะ (ราคา/กก.)</label>
                        <input type="text" name="pricePerUnit" id="editPricePerUnit" placeholder="เช่น 6 บาท/กิโลกรัม" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพขยะ (ใน Edit Form) -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพขยะ</label>
                        
                        <!-- Preview Area -->
                        <div class="relative">
                            <input type="file" name="img" id="editWasteImg" accept="image/png, image/gif, image/jpeg" class="hidden">
                            
                            <!-- Upload Zone (แสดงเมื่อยังไม่มีรูป) -->
                            <div id="editUploadZone" 
                                class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer hidden">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG, GIF (ไม่เกิน 5MB)</p>
                            </div>
                            
                            <!-- Image Preview (แสดงเมื่อมีรูป) -->
                            <div id="editImagePreview">
                                <div class="relative group">
                                    <img id="editPreviewImg" src="/placeholder-waste.svg" alt="Preview" 
                                        class="w-full h-64 object-contain rounded-lg border-2 border-gray-300 bg-gray-50">
                                    
                                    <!-- Overlay with Change Button -->
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                        <button type="button" id="editChangeImageBtn"
                                            class="opacity-0 group-hover:opacity-100 transition-opacity bg-white text-gray-700 px-4 py-2 rounded-lg font-medium shadow-lg hover:bg-gray-100 flex items-center gap-2">
                                            <ion-icon name="camera-outline"></ion-icon>
                                            <span>เปลี่ยนรูปภาพ</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal ปรับราคายกกลุ่ม -->
        <div id="bulkPriceModal" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-lg p-6 space-y-5 mx-4">
                
                <div class="flex items-center justify-between border-b pb-3">
                    <div class="flex items-center space-x-2">
                        <ion-icon name="pricetags-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">ปรับราคายกกลุ่ม</span>
                    </div>
                    <button onclick="closeBulkPriceModal()" class="text-gray-400 hover:text-gray-600">
                        <ion-icon name="close-outline" class="text-2xl"></ion-icon>
                    </button>
                </div>

                <!-- รายการที่เลือก -->
                <div>
                    <p class="text-sm font-medium text-gray-700 mb-2">รายการขยะที่เลือก:</p>
                    <div id="selectedWasteList" class="bg-gray-50 rounded-lg p-3 max-h-40 overflow-y-auto space-y-1">
                        <!-- จะถูก render ด้วย JS -->
                    </div>
                </div>

                <!-- วิธีปรับราคา -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">วิธีปรับราคา</label>
                    <div class="flex gap-3">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="adjustType" value="add" checked class="w-4 h-4 text-green-500">
                            <span class="text-sm">บวกเพิ่ม / ลดลง (บาท)</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="adjustType" value="set" class="w-4 h-4 text-green-500">
                            <span class="text-sm">กำหนดราคาใหม่</span>
                        </label>
                    </div>
                </div>

                <!-- ช่องกรอกค่า -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        <span id="adjustLabel">จำนวนที่ปรับ (บาท)</span>
                        <span class="text-xs text-gray-500 ml-1">— ใส่ค่าลบเพื่อลดราคา เช่น -0.5</span>
                    </label>
                    <input type="number" id="adjustValue" step="0.01" placeholder="เช่น 0.5 หรือ -1"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                </div>

                <!-- Preview ราคา -->
                <div id="pricePreview" class="hidden">
                    <p class="text-sm font-medium text-gray-700 mb-2">ตัวอย่างราคาหลังปรับ:</p>
                    <div id="pricePreviewList" class="bg-blue-50 rounded-lg p-3 max-h-36 overflow-y-auto space-y-1 text-sm">
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button onclick="closeBulkPriceModal()"
                        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                    <button onclick="confirmBulkPrice()"
                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">ยืนยันปรับราคา</button>
                </div>
            </div>
        </div>
    </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
<script>
    let lastClickedRow = null;

    function setWasteForm(Index, Id, Name, Price, Type, Img) {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        const InputWasteId = document.getElementById('hiddenWasteId');
        InputWasteId.value = Id;

        const InputWasteName = document.getElementById('editWasteName');
        InputWasteName.value = Name;

        const InputWasteType = document.getElementById('editWasteType');
        InputWasteType.value = Type;

        const InputPricePerUnit = document.getElementById('editPricePerUnit');
        InputPricePerUnit.value = Price;

        // ตั้งค่ารูปภาพเดิม
        setExistingEditImage(Img);

        // รีเซ็ต input file
        editFileInput.value = '';

        // Hide add form and show edit form
        addForm.style.display = 'none';

        const selectedRow = document.querySelector(`.was-row-${Index}`);
        if (lastClickedRow === selectedRow) {
            lastClickedRow = null;
            editForm.style.display = 'none';
        } else {
            if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
            editForm.style.display = 'block';
            lastClickedRow = selectedRow;
        }
    }


    function wasFormToggle() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        
        if (addForm.style.display === 'block') {
            addForm.style.display = 'none';
        } else {
            addForm.style.display = 'block';
            // รีเซ็ตการแสดงรูปภาพเมื่อเปิด Add Form
            addFileInput.value = '';
            addUploadZone.classList.remove('hidden');
            addImagePreview.classList.add('hidden');
            addPreviewImg.src = '/placeholder-waste.svg';
        }
    }
    
    function deleteEmp(data) {
            Swal.fire({
                title: `ลบ "${data[2]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/wasteDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
            }
        });
    }
    function cancelForm() {
        const addForm = document.getElementById('add_Form');
        const editForm = document.getElementById('edit_Form');
        
        addForm.style.display = 'none';
        editForm.style.display = 'none';
        
        // รีเซ็ตฟอร์ม Add
        document.getElementById('wasteName').value = '';
        document.getElementById('pricePerUnit').value = '';
        document.getElementById('wasteType').value = '';
        addFileInput.value = '';
        
        // รีเซ็ตการแสดงรูปภาพ Add Form
        addUploadZone.classList.remove('hidden');
        addImagePreview.classList.add('hidden');
        addPreviewImg.src = '/placeholder-waste.svg';
        
        // รีเซ็ตฟอร์ม Edit
        document.getElementById('editWasteName').value = '';
        document.getElementById('editPricePerUnit').value = '';
        document.getElementById('editWasteType').value = '';
        editFileInput.value = '';
        
        // รีเซ็ตการแสดงรูปภาพ Edit Form
        editPreviewImg.src = '/placeholder-waste.svg';
        editUploadZone.classList.add('hidden');
        editImagePreview.classList.add('hidden');
        
        if (lastClickedRow) {
            lastClickedRow.style.backgroundColor = '';
            lastClickedRow = null;
        }
    }

    // เพิ่ม JavaScript สำหรับ preview รูปภาพ
    document.getElementById('editWasteImg').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const currentImage = document.getElementById('currentWasteImage');
        const placeholder = document.getElementById('imagePlaceholder');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                currentImage.src = e.target.result;
                currentImage.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            // ถ้าไม่มีไฟล์ (เช่น user กด cancel ใน file dialog)
            currentImage.classList.add('hidden');
            placeholder.classList.remove('hidden');
            currentImage.src = '/placeholder-waste.svg';
        }
    });

    // ฟังก์ชันสำหรับแสดง Add Form
    function showAddForm() {
        const addForm = document.getElementById('add_Form');
        addForm.classList.remove('hidden');
        addForm.style.display = 'flex';
    }

    // เพิ่ม JavaScript สำหรับ preview รูปภาพใน Add Form
    document.getElementById('img').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const imagePreview = document.getElementById('imagePreview');
        const previewImage = document.getElementById('previewImage');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                imagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            imagePreview.classList.add('hidden');
            previewImage.src = '';
        }
    });

    const wasteData = <%- JSON.stringify(waste) %>; // ดึงข้อมูลจาก server
    const searchInput = document.getElementById("searchInput");
    const itemsPerPageSelect = document.getElementById("itemsPerPage");
    const tableBody = document.getElementById("tableBody");
    const pagination = document.getElementById("pagination");
    const noResults = document.getElementById("noResults");

    document.getElementById("totalItems").textContent = `${wasteData.length} รายการ`

    let currentPage = 1;
    let itemsPerPage = parseInt(itemsPerPageSelect.value);
    let filteredData = [...wasteData];

    function createRow(item, index) {
        return `
            <tr class="hover:bg-gray-50 transition-colors" data-id="${item._id}">
                <td class="px-4 py-3 text-center">
                    <input type="checkbox" class="row-checkbox w-4 h-4 cursor-pointer" 
                        data-id="${item._id}" 
                        data-name="${item.wasteName}" 
                        data-price="${item.pricePerUnit}"
                        onchange="updateSelection()">
                </td>
                <td class="px-4 py-3 text-sm whitespace-nowrap text-center">${index + 1}</td>
                <td class="px-4 py-3 text-sm whitespace-nowrap">${item.wasteName}</td>
                <td class="px-4 py-3 text-sm whitespace-nowrap">${item.wasteType.wasteTypeName}</td>
                <td class="px-4 py-3 text-sm whitespace-nowrap text-center">${item.pricePerUnit}</td>
                <td class="px-4 py-3 text-sm whitespace-nowrap">
                    ${item.img 
                        ? `<img src="${item.img}" alt="รูป" 
                                class="waste-img w-12 h-12 object-cover rounded shadow-sm border border-gray-100"
                                onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex'">
                        <div style="display:none" class="w-12 h-12 rounded border border-gray-100 bg-gray-100 items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                            </svg>
                        </div>`
                        : `<div class="w-12 h-12 rounded border border-gray-100 bg-gray-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                            </svg>
                        </div>`
                    }
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-left">
                    <button type="button" class="was-row-${index + 1} row-active edit-btn" 
                        onclick="setWasteForm('${index + 1}', '${item._id}', '${item.wasteName}',
                                            '${item.pricePerUnit}', '${item.wasteType._id}', '${item.img}')">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button onclick="deleteEmp(['${index + 1}', '${item._id}','${item.wasteName}'])" class="delete-btn">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }
    function displayData() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const dataToShow = filteredData.slice(start, end);

        if (dataToShow.length === 0) {
            noResults.classList.remove("hidden");
            tableBody.innerHTML = "";
            pagination.innerHTML = "";
            // ✅ เพิ่มตรงนี้
            document.getElementById('selectAll').checked = false;
            updateSelection();
            return;
        }

        noResults.classList.add("hidden");
        tableBody.innerHTML = dataToShow.map((item, i) => createRow(item, start + i)).join("");
        renderPagination();

        // ✅ เพิ่มตรงนี้
        document.getElementById('selectAll').checked = false;
        updateSelection();
    }

    function renderPagination() {
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        if (totalPages <= 1) {
            pagination.innerHTML = "";
            return;
        }
        let html = "";
        for (let i = 1; i <= totalPages; i++) {
            html += `<button onclick="goToPage(${i})" class="px-3 py-1 border rounded ${i === currentPage ? 'bg-green-600 text-white' : 'bg-white text-gray-700'}">${i}</button>`;
        }
        pagination.innerHTML = html;
    }

    function goToPage(page) {
        currentPage = page;
        displayData();
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    searchInput.addEventListener("input", () => {
        const term = searchInput.value.toLowerCase();
        filteredData = wasteData.filter(w => 
            w.wasteName.toLowerCase().includes(term) || 
            w.wasteType.wasteTypeName.toLowerCase().includes(term)
        );
        document.getElementById("totalItems").textContent = `${filteredData.length} รายการ`
        currentPage = 1;
        displayData();
    });

    itemsPerPageSelect.addEventListener("change", () => {
        itemsPerPage = parseInt(itemsPerPageSelect.value);
        currentPage = 1;
        displayData();
    });

    // Init
    displayData();

    // ==================== Add Form Image Preview ====================
    const addFileInput = document.getElementById('img');
    const addUploadZone = document.getElementById('addUploadZone');
    const addImagePreview = document.getElementById('addImagePreview');
    const addPreviewImg = document.getElementById('addPreviewImg');
    const addChangeImageBtn = document.getElementById('addChangeImageBtn');

    // คลิกที่ Upload Zone เพื่อเลือกไฟล์
    if (addUploadZone) {
        addUploadZone.addEventListener('click', () => {
            addFileInput.click();
        });
    }

    // คลิกปุ่ม "เปลี่ยนรูปภาพ" เพื่อเลือกไฟล์ใหม่
    if (addChangeImageBtn) {
        addChangeImageBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addFileInput.click();
        });
    }

    // เมื่อเลือกไฟล์ใหม่
    addFileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        
        if (file) {
            // ตรวจสอบขนาดไฟล์ (5MB)
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'ไฟล์ใหญ่เกินไป',
                    text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                    confirmButtonColor: '#3085d6'
                });
                addFileInput.value = '';
                return;
            }
            
            // ตรวจสอบประเภทไฟล์
            const validTypes = ['image/png', 'image/jpeg', 'image/gif'];
            if (!validTypes.includes(file.type)) {
                Swal.fire({
                    icon: 'error',
                    title: 'ประเภทไฟล์ไม่ถูกต้อง',
                    text: 'กรุณาเลือกไฟล์ PNG, JPG หรือ GIF เท่านั้น',
                    confirmButtonColor: '#3085d6'
                });
                addFileInput.value = '';
                return;
            }
            
            // อ่านไฟล์และแสดงรูป
            const reader = new FileReader();
            reader.onload = function(event) {
                addPreviewImg.src = event.target.result;
                addUploadZone.classList.add('hidden');
                addImagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });

    // ==================== Edit Form Image Preview ====================
    const editFileInput = document.getElementById('editWasteImg');
    const editUploadZone = document.getElementById('editUploadZone');
    const editImagePreview = document.getElementById('editImagePreview');
    const editPreviewImg = document.getElementById('editPreviewImg');
    const editChangeImageBtn = document.getElementById('editChangeImageBtn');

    // คลิกที่ Upload Zone เพื่อเลือกไฟล์
    if (editUploadZone) {
        editUploadZone.addEventListener('click', () => {
            editFileInput.click();
        });
    }

    // คลิกปุ่ม "เปลี่ยนรูปภาพ" เพื่อเลือกไฟล์ใหม่
    if (editChangeImageBtn) {
        editChangeImageBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            editFileInput.click();
        });
    }

    // เมื่อเลือกไฟล์ใหม่
    editFileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        
        if (file) {
            // ตรวจสอบขนาดไฟล์ (5MB)
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'ไฟล์ใหญ่เกินไป',
                    text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                    confirmButtonColor: '#3085d6'
                });
                editFileInput.value = '';
                return;
            }
            
            // ตรวจสอบประเภทไฟล์
            const validTypes = ['image/png', 'image/jpeg', 'image/gif'];
            if (!validTypes.includes(file.type)) {
                Swal.fire({
                    icon: 'error',
                    title: 'ประเภทไฟล์ไม่ถูกต้อง',
                    text: 'กรุณาเลือกไฟล์ PNG, JPG หรือ GIF เท่านั้น',
                    confirmButtonColor: '#3085d6'
                });
                editFileInput.value = '';
                return;
            }
            
            // อ่านไฟล์และแสดงรูป
            const reader = new FileReader();
            reader.onload = function(event) {
                editPreviewImg.src = event.target.result;
                editUploadZone.classList.add('hidden');
                editImagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });

    // ฟังก์ชันสำหรับตั้งค่ารูปภาพเดิมใน Edit Form
    function setExistingEditImage(imageUrl) {
        if (imageUrl && imageUrl !== '' && imageUrl !== 'undefined') {
            editPreviewImg.src = imageUrl;
            editPreviewImg.onerror = function() {
                // โหลดรูปไม่สำเร็จ → แสดง Upload Zone แทน
                this.onerror = null;
                editUploadZone.classList.remove('hidden');
                editImagePreview.classList.add('hidden');
            };
            editUploadZone.classList.add('hidden');
            editImagePreview.classList.remove('hidden');
        } else {
            // ไม่มีรูป → แสดง Upload Zone
            editUploadZone.classList.remove('hidden');
            editImagePreview.classList.add('hidden');
        }
    }

    // ============================================
    // Bulk Price Update Functions
    // ============================================

    function updateSelection() {
        const checkboxes = document.querySelectorAll('.row-checkbox:checked');
        const count = checkboxes.length;
        const bulkBtn = document.getElementById('bulkPriceBtn');
        const countSpan = document.getElementById('selectedCount');

        countSpan.textContent = count;

        if (count > 0) {
            bulkBtn.classList.remove('hidden');
        } else {
            bulkBtn.classList.add('hidden');
        }
    }

    // Select All
    document.getElementById('selectAll')?.addEventListener('change', function() {
        const checkboxes = document.querySelectorAll('.row-checkbox');
        checkboxes.forEach(cb => cb.checked = this.checked);
        updateSelection();
    });

    // เพิ่ม listener ให้ selectAll ทำงานหลัง render ด้วย
    // const origDisplayData = displayData;
    // function displayData() {
    //     origDisplayData();
    //     document.getElementById('selectAll').checked = false;
    //     updateSelection();
    // }

    function getSelectedItems() {
        const checkboxes = document.querySelectorAll('.row-checkbox:checked');
        return Array.from(checkboxes).map(cb => ({
            id: cb.dataset.id,
            name: cb.dataset.name,
            price: parseFloat(cb.dataset.price)
        }));
    }

    function openBulkPriceModal() {
        const selected = getSelectedItems();
        if (selected.length === 0) return;

        // แสดงรายการที่เลือก
        const listEl = document.getElementById('selectedWasteList');
        listEl.innerHTML = selected.map(item => `
            <div class="flex justify-between text-sm text-gray-700">
                <span>• ${item.name}</span>
                <span class="text-gray-500">${item.price.toFixed(2)} บาท/กก.</span>
            </div>
        `).join('');

        // ซ่อน preview
        document.getElementById('pricePreview').classList.add('hidden');
        document.getElementById('adjustValue').value = '';

        document.getElementById('bulkPriceModal').classList.remove('hidden');
    }

    function closeBulkPriceModal() {
        document.getElementById('bulkPriceModal').classList.add('hidden');
        document.getElementById('pricePreview').classList.add('hidden');
    }

    // เปลี่ยน label ตาม radio
    document.querySelectorAll('input[name="adjustType"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const label = document.getElementById('adjustLabel');
            const hint = document.querySelector('#adjustLabel + span') || document.querySelector('.text-xs.text-gray-500');
            if (this.value === 'add') {
                label.textContent = 'จำนวนที่ปรับ (บาท)';
            } else {
                label.textContent = 'ราคาใหม่ (บาท)';
            }
            document.getElementById('pricePreview').classList.add('hidden');
        });
    });

    function previewBulkPrice() {
        const selected = getSelectedItems();
        const adjustType = document.querySelector('input[name="adjustType"]:checked').value;
        const adjustValue = parseFloat(document.getElementById('adjustValue').value);

        // ถ้ายังไม่กรอกค่า ให้ซ่อน preview เฉยๆ ไม่ต้อง alert
        if (isNaN(adjustValue)) {
            document.getElementById('pricePreview').classList.add('hidden');
            return;
        }

        const previewList = document.getElementById('pricePreviewList');
        previewList.innerHTML = selected.map(item => {
            const newPrice = adjustType === 'add'
                ? Math.max(0, item.price + adjustValue)
                : Math.max(0, adjustValue);

            const diff = newPrice - item.price;
            const diffText = diff > 0
                ? `<span class="text-green-600">+${diff.toFixed(2)}</span>`
                : diff < 0
                ? `<span class="text-red-600">${diff.toFixed(2)}</span>`
                : `<span class="text-gray-500">ไม่เปลี่ยน</span>`;

            return `
                <div class="flex justify-between">
                    <span class="text-gray-700">• ${item.name}</span>
                    <span>${item.price.toFixed(2)} → <strong>${newPrice.toFixed(2)}</strong> บาท ( ${diffText} )</span>
                </div>
            `;
        }).join('');

        document.getElementById('pricePreview').classList.remove('hidden');
    }

    async function confirmBulkPrice() {
        const selected = getSelectedItems();
        const adjustType = document.querySelector('input[name="adjustType"]:checked').value;
        const adjustValue = parseFloat(document.getElementById('adjustValue').value);

        if (isNaN(adjustValue)) {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกจำนวนที่ต้องการปรับ', confirmButtonColor: '#3085d6' });
            return;
        }

        const confirm = await Swal.fire({
            title: `ยืนยันปรับราคา ${selected.length} รายการ?`,
            text: adjustType === 'add'
                ? `ปรับราคา ${adjustValue >= 0 ? '+' : ''}${adjustValue} บาท ทุกรายการที่เลือก`
                : `กำหนดราคาใหม่เป็น ${adjustValue} บาท ทุกรายการที่เลือก`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก',
            reverseButtons: true
        });

        if (!confirm.isConfirmed) return;

        Swal.fire({ title: 'กำลังอัปเดต...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        try {
            const response = await fetch('/admin/wasteBulkPriceUpdate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: selected.map(item => ({ id: item.id, currentPrice: item.price })),
                    adjustType,
                    adjustValue
                })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'ปรับราคาสำเร็จ',
                    text: `อัปเดต ${selected.length} รายการเรียบร้อยแล้ว`,
                    confirmButtonColor: '#28a745',
                    timer: 2000
                }).then(() => window.location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: data.message, confirmButtonColor: '#d33' });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'เชื่อมต่อไม่ได้', confirmButtonColor: '#d33' });
        }
    }

    // Auto-preview เมื่อกรอกค่าหรือเปลี่ยน radio
    document.getElementById('adjustValue').addEventListener('input', previewBulkPrice);
    document.querySelectorAll('input[name="adjustType"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const label = document.getElementById('adjustLabel');
            if (this.value === 'add') {
                label.textContent = 'จำนวนที่ปรับ (บาท)';
            } else {
                label.textContent = 'ราคาใหม่ (บาท)';
            }
            // auto-preview เมื่อเปลี่ยน mode ด้วย
            previewBulkPrice();
        });
    });

</script>

</html>