<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title><%= mytitle %></title>
        <link rel="stylesheet" href="/style_admin/waste.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');
        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    
    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">ขยะ</h1>
                <p class="text-gray-600">รายการขยะทั้งหมดที่รับซื้อของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="wasFormToggle()">เพิ่มรายการขยะ</button>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    จำนวนขยะทั้งหมด <span class="text-blue-600 text-base font-normal"> <%= waste.length %> รายการ</span>
                </h2>
            </div>
        
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ลำดับ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ชื่อรายการขยะ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">ประเภทขยะ</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-center text-gray-700 uppercase">ราคา (ราคา/กก.)</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">รูป</th>
                            <th class="px-4 py-3 text-sm font-medium tracking-wider text-left text-gray-700 uppercase">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (waste.length > 0) { %>
                            <% waste.forEach((wastes, index) => { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-sm whitespace-nowrap text-center"><%= (currentPage - 1) * 10 + index + 1 %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= wastes.wasteName %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap"><%= wastes.wasteType.wasteTypeName %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap text-center"><%= wastes.pricePerUnit %></td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap">
                                        <% if (wastes.img) { %>
                                                <img src="<%= wastes.img %>" alt="รูป <%= wastes.img %>" class="waste-img">
                                            <% } else { %>
                                                <span>ไม่มีรูปภาพ</span>
                                            <% } %>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-left">
                                        <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                            onclick="setWasteForm('<%= index + 1 %>', '<%= wastes._id %>', '<%= wastes.wasteName %>',
                                                                '<%= wastes.pricePerUnit %>', '<%= wastes.wasteType._id %>', '<%= wastes.img %>')">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button onclick="deleteEmp(['<%= index + 1 %>', '<%= wastes._id %>','<%= wastes.wasteName %>'])" class="delete-btn">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-2 px-4">- ไม่มีข้อมูลขยะ -</td>
                            </tr>
                        <% } %>
                    </tbody>                    
                </table>
            </div>
        </div>

        <!-- Modal Add -->
        <div id="add_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/wastePost" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5">
                    
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">รายละเอียดขยะ</span>
                    </div>
                    
                    <!-- ชื่อขยะ -->
                    <div>
                        <label for="wasteName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อขยะ</label>
                        <input type="text" name="wasteName" id="wasteName" placeholder="ขวด PET ใส, โลหะ ฯลฯ" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- ประเภทขยะ -->
                    <div>
                        <label for="wasteType" class="block text-sm font-medium text-gray-700 mb-1">ประเภทขยะ</label>
                        <select name="wasteType" id="wasteType" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled selected>เลือกประเภทขยะ</option>
                            <% wasteTypes.forEach((type) => { %>
                                <option value="<%= type._id %>"><%= type.wasteTypeName %></option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- ราคาขยะ -->
                    <div>
                        <label for="pricePerUnit" class="block text-sm font-medium text-gray-700 mb-1">ราคาขยะ (ราคา/กก.)</label>
                        <input type="text" name="pricePerUnit" id="pricePerUnit" placeholder="เช่น 6 บาท/กิโลกรัม" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพขยะ -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพขยะ</label>
                        
                        <!-- อัปโหลดรูปภาพ -->
                        <div class="relative">
                            <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" 
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                            <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:bg-gray-100 transition-colors">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-2xl mb-2"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1">คลิกเพื่อเลือกรูปภาพ</p>
                                <p class="text-xs text-gray-500">PNG, JPG, GIF (ไม่เกิน 5MB)</p>
                            </div>
                        </div>
                        
                        <!-- แสดงตัวอย่างรูปภาพที่เลือก -->
                        <div id="imagePreview" class="mt-3 hidden">
                            <div class="w-full h-32 bg-gray-100 rounded-lg border-2 border-gray-300 flex items-center justify-center overflow-hidden">
                                <img id="previewImage" src="/placeholder.svg" alt="Preview" class="max-w-full max-h-full object-cover rounded-lg">
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Modal Edit -->
        <div id="edit_Form" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl px-4">
                <form action="/admin/wasteEdit" method="POST" enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-lg w-full max-w-3xl p-6 space-y-5">

                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">แก้ไขขยะ</span>
                    </div>
                    
                    <!-- ส่งค่า _id -->
                    <input type="hidden" name="_id" id="hiddenWasteId" value="">
                    
                    <!-- ชื่อขยะ -->
                    <div>
                        <label for="editWasteName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อขยะ</label>
                        <input type="text" name="wasteName" id="editWasteName" placeholder="ขวด PET ใส, โลหะ ฯลฯ" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- ประเภทขยะ -->
                    <div>
                        <label for="editWasteType" class="block text-sm font-medium text-gray-700 mb-1">ประเภทขยะ</label>
                        <select name="wasteType" id="editWasteType" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                            <option value="" disabled selected>เลือกประเภทขยะ</option>
                            <% wasteTypes.forEach((type) => { %>
                                <option value="<%= type._id %>"><%= type.wasteTypeName %></option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- ราคาขยะ -->
                    <div>
                        <label for="editPricePerUnit" class="block text-sm font-medium text-gray-700 mb-1">ราคาขยะ (ราคา/กก.)</label>
                        <input type="text" name="pricePerUnit" id="editPricePerUnit" placeholder="เช่น 6 บาท/กิโลกรัม" required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                    </div>
                    
                    <!-- รูปภาพขยะ -->
                    <div class="mt-3">
                        <label class="title-img" for="img">รูปภาพขยะ</label>
                    </div>
                    <div class="img-input mt-3">
                        <div class="current-img">
                            <img src="" alt="Current Waste Image" class="img-edit">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพขยะที่ต้องการจะแก้ไข</label>
                        
                        <!-- แสดงรูปภาพปัจจุบัน -->
                        <div class="mb-3">
                            <div class="w-full h-32 bg-gray-100 rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden">
                                <img src="/placeholder.svg" alt="Current Waste Image" id="currentWasteImage" 
                                    class="max-w-full max-h-full object-cover rounded-lg hidden">
                                <div id="imagePlaceholder" class="text-gray-400 text-center">
                                    <ion-icon name="image-outline" class="text-3xl mb-2"></ion-icon>
                                    <p class="text-sm">รูปภาพปัจจุบัน</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- อัปโหลดรูปภาพใหม่ -->
                        <div class="relative">
                            <input type="file" name="img" id="editWasteImg" accept="image/png, image/gif, image/jpeg" 
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                            <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:bg-gray-100 transition-colors">
                                <ion-icon name="cloud-upload-outline" class="text-gray-400 text-2xl mb-2"></ion-icon>
                                <p class="text-sm text-gray-600 mb-1">คลิกเพื่อเลือกรูปภาพใหม่</p>
                                <p class="text-xs text-gray-500">PNG, JPG, GIF (ไม่เกิน 5MB)</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ปุ่ม -->
                    <div class="flex justify-end space-x-3 pt-2">
                        <button type="button" onclick="cancelForm()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                        <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="pagination flex justify-center items-center mt-4 space-x-2">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>"
                            class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ก่อนหน้า
                        </a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>"
                            class="px-3 py-1 border border-gray-300 rounded-md 
                                <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                            <%= i %>
                        </a>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>"
                            class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                            ถัดไป
                        </a>
                    <% } %>
        </div>
    </div>
</body>
<%- include('../partials/adminPartials/adminFooter.ejs') %>
<script>
    let lastClickedRow = null;

    function setWasteForm(Index, Id, Name, Price, Type, Img) {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        const InputWasteId = document.getElementById('hiddenWasteId');
        InputWasteId.value = Id;

        const InputWasteName = document.getElementById('editWasteName');
        InputWasteName.value = Name;

        const InputWasteType = document.getElementById('editWasteType');
        InputWasteType.value = Type;

        const InputPricePerUnit = document.getElementById('editPricePerUnit');
        InputPricePerUnit.value = Price;

        // Update the image preview
        const currentImg = document.querySelector('.current-img img');
        if (currentImg) {
            currentImg.src = Img;
        }

        // Hide add form and show edit form
        addForm.style.display = 'none';

        const selectedRow = document.querySelector(`.was-row-${Index}`);
        if (lastClickedRow === selectedRow) {
            selectedRow.style.backgroundColor = '';
            lastClickedRow = null;
            editForm.style.display = 'none';
        } else {
            if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
            selectedRow.style.backgroundColor = '#8EDBA4';
            editForm.style.display = 'block';
            lastClickedRow = selectedRow;
        }
    }


    function wasFormToggle() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        if (add_Form.style.display === 'block') {
            add_Form.style.display = 'none';
        }
        else {
            add_Form.style.display = 'block';
        }
    }
    
    function deleteEmp(data) {
            Swal.fire({
                title: `ลบ "${data[2]}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/wasteDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
            }
        });
    }
    function cancelForm() {
        const addForm = document.getElementById('add_Form');
        const editForm = document.getElementById('edit_Form');
        
        // ซ่อนฟอร์มทั้งสองเมื่อกดปุ่มยกเลิก
        addForm.style.display = 'none';
        editForm.style.display = 'none';
        
        // รีเซ็ตค่าในฟอร์ม Add
        document.getElementById('wasteName').value = '';
        document.getElementById('pricePerUnit').value = '';
        document.getElementById('wasteType').value = '';
        document.getElementById('img').value = '';  // ลบรูปภาพที่เลือก
        
        // รีเซ็ตค่าในฟอร์ม Edit
        document.getElementById('editWasteName').value = '';
        document.getElementById('editPricePerUnit').value = '';
        document.getElementById('editWasteType').value = '';
        document.getElementById('editWasteImg').value = '';  // ลบรูปภาพที่เลือกใหม่
        
        // รีเซ็ตการแสดงรูปภาพใน Edit Form
        const currentImage = document.getElementById('currentWasteImage');
        const placeholder = document.getElementById('imagePlaceholder');
        
        // ซ่อนรูปภาพที่เลือกใหม่และแสดง placeholder
        currentImage.classList.add('hidden');
        placeholder.classList.remove('hidden');
        
        // รีเซ็ต src ของรูปภาพ
        currentImage.src = '/placeholder.svg';
        
        // ยกเลิกแรเงาแถว
        if (lastClickedRow) {
            lastClickedRow.style.backgroundColor = '';
            lastClickedRow = null;
        }
    }

    // เพิ่ม JavaScript สำหรับ preview รูปภาพ
    document.getElementById('editWasteImg').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const currentImage = document.getElementById('currentWasteImage');
        const placeholder = document.getElementById('imagePlaceholder');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                currentImage.src = e.target.result;
                currentImage.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            // ถ้าไม่มีไฟล์ (เช่น user กด cancel ใน file dialog)
            currentImage.classList.add('hidden');
            placeholder.classList.remove('hidden');
            currentImage.src = '/placeholder.svg';
        }
    });

    // ฟังก์ชันสำหรับแสดง Add Form
    function showAddForm() {
        const addForm = document.getElementById('add_Form');
        addForm.classList.remove('hidden');
        addForm.style.display = 'flex';
    }

    // เพิ่ม JavaScript สำหรับ preview รูปภาพใน Add Form
    document.getElementById('img').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const imagePreview = document.getElementById('imagePreview');
        const previewImage = document.getElementById('previewImage');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                imagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            imagePreview.classList.add('hidden');
            previewImage.src = '';
        }
    });

</script>

</html>