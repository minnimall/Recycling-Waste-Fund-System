</body>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // กำหนด flatpickr พร้อม validation
            const startTimeInputs = document.querySelectorAll(".startTime");
            const endTimeInputs = document.querySelectorAll(".endTime");

            startTimeInputs.forEach(input => {
                flatpickr(input, {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "H:i",
                    time_24hr: true,
                    minuteIncrement: 30,
                    allowInput: true,
                    onClose: function(selectedDates, dateStr, instance) {
                        // ตรวจสอบว่ามีค่าหรือไม่
                        if (!dateStr || dateStr.trim() === '') {
                            instance.input.setCustomValidity('กรุณาเลือกเวลาเริ่มต้น');
                        } else {
                            instance.input.setCustomValidity('');
                        }
                        instance.input.reportValidity();
                    }
                });
            });

            endTimeInputs.forEach(input => {
                flatpickr(input, {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "H:i",
                    time_24hr: true,
                    minuteIncrement: 30,
                    allowInput: true,
                    onClose: function(selectedDates, dateStr, instance) {
                        if (!dateStr || dateStr.trim() === '') {
                            instance.input.setCustomValidity('กรุณาเลือกเวลาสิ้นสุด');
                        } else {
                            instance.input.setCustomValidity('');
                        }
                        instance.input.reportValidity();
                    }
                });
            });

            // Validation เมื่อ submit form
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const startTimeInput = this.querySelector('[name="startTime"]');
                    const endTimeInput = this.querySelector('[name="endTime"]');
                    
                    let isValid = true;

                    if (!startTimeInput.value || startTimeInput.value.trim() === '') {
                        startTimeInput.setCustomValidity('กรุณาเลือกเวลาเริ่มต้น');
                        startTimeInput.reportValidity();
                        isValid = false;
                    } else {
                        startTimeInput.setCustomValidity('');
                    }

                    if (!endTimeInput.value || endTimeInput.value.trim() === '') {
                        endTimeInput.setCustomValidity('กรุณาเลือกเวลาสิ้นสุด');
                        endTimeInput.reportValidity();
                        isValid = false;
                    } else {
                        endTimeInput.setCustomValidity('');
                    }

                    // เช็คว่าเวลาสิ้นสุดมากกว่าเวลาเริ่มต้นหรือไม่
                    if (isValid && startTimeInput.value && endTimeInput.value) {
                        const [startHour, startMin] = startTimeInput.value.split(':').map(Number);
                        const [endHour, endMin] = endTimeInput.value.split(':').map(Number);
                        
                        const startMinutes = startHour * 60 + startMin;
                        const endMinutes = endHour * 60 + endMin;

                        if (endMinutes <= startMinutes) {
                            endTimeInput.setCustomValidity('เวลาสิ้นสุดต้องมากกว่าเวลาเริ่มต้น');
                            endTimeInput.reportValidity();
                            isValid = false;
                        } else {
                            endTimeInput.setCustomValidity('');
                        }
                    }

                    if (!isValid) {
                        e.preventDefault();
                    }
                });
            });
        });
        </script>
<script>
    // function showLoading() {
    // document.getElementById('loadingIndicator').classList.remove('hidden');
    // }

    // function hideLoading() {
    //     document.getElementById('loadingIndicator').classList.add('hidden');
    // }

    // // ดักจับการกดปุ่ม Submit ใน Form
    // document.querySelectorAll("form").forEach(form => {
    //     form.addEventListener("submit", function() {
    //         showLoading();
    //     });
    // });

    // เพิ่มตรงนี้
    const wastePointsData = <%- JSON.stringify(wastePoints) %>;

    function filterWastePointsByVillage(formType) {
        const villageSelect = document.getElementById(formType === 'add' ? 'add_village' : 'village');
        const wastePointSelect = document.getElementById(formType === 'add' ? 'add_wastePoint' : 'edit_wastePoint');
        const selectedVillageId = villageSelect.value;

        wastePointSelect.innerHTML = '<option value="">ไม่ระบุจุดรับซื้อ</option>';

        if (!selectedVillageId) return;

        const filteredPoints = wastePointsData.filter(wp => {
            return wp.village && wp.village._id === selectedVillageId;
        });

        filteredPoints.forEach(wp => {
            const option = document.createElement('option');
            option.value = wp._id;
            
            const typeIcon = {
                'bank': '',
                'center': '', 
                'community': '',
                'mobile': ''
            }[wp.type] || '';
            
            const statusText = wp.isOpen ? '' : '';
            option.textContent = `${typeIcon} ${wp.wastePointName} ${statusText}`;
            wastePointSelect.appendChild(option);
        });

        if (filteredPoints.length === 0) {
            const option = document.createElement('option');
            option.value = '';
            option.textContent = 'ไม่มีจุดรับซื้อในหมู่บ้านนี้';
            option.disabled = true;
            wastePointSelect.appendChild(option);
        }
    }

    let lastClickedRow = null;
    function setRoundForm(Index, Id, Name, Village, WastePoint, Date, Start, End) {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        const InputRoundId = document.getElementById('_id');
        InputRoundId.value = Id;

        const InputRoundName = document.getElementById('roundName');
        InputRoundName.value = Name;

        const InputVillage = document.getElementById('village');
        InputVillage.value = Village;

        // เพิ่มส่วนนี้
        filterWastePointsByVillage('edit');
        setTimeout(() => {
            const InputWastePoint = document.getElementById('edit_wastePoint');
            InputWastePoint.value = WastePoint || '';
        }, 100);

        const InputDate = document.getElementById('date');
        InputDate.value = Date;

        const InputStartTime = document.getElementById('startTime');
        InputStartTime.value = Start;

        const InputEndTime = document.getElementById('endTime');
        InputEndTime.value = End;
        
        addForm.style.display = 'none';
        const selectedRow = document.querySelector(`.was-row-${Index}`);
        if (lastClickedRow === selectedRow) {
            lastClickedRow = null;
            editForm.style.display = 'none';
        } else {
            if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
            editForm.style.display = 'block';
            lastClickedRow = selectedRow;
        }
    }
    function wasFormToggle() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        if (addForm.style.display === 'block') {
            addForm.style.display = 'none';
        }
        else {
            addForm.style.display = 'block';
        }
    }
    function deleteRound(data) {
        Swal.fire({
            title: `ลบ "${data[2]}" หรือไม่?`,
            text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/admin/roundDelete/' + data[1], {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                .then(result => {
                    Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลหมู่บ้านถูกลบเรียบร้อยแล้ว', 'success')
                    .then(() => {
                        location.reload();
                    });
                })
                .catch(error => {
                    Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                });
            }
        });
    }
    function cancelForm() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        addForm.style.display = 'none';

        // Reset ฟอร์ม
        editForm.querySelector('form').reset();
        addForm.querySelector('form')?.reset();

        // ยกเลิกแรเงาแถว
        if (lastClickedRow) {
            lastClickedRow.style.backgroundColor = '';
            lastClickedRow = null;
        }
    }

    const roundsData = <%- JSON.stringify(rounds) %>;
    const tableBody = document.getElementById('tableBody');
    const searchInput = document.getElementById('searchInput');
    const totalItemsEl = document.getElementById('totalItems');
    const totalResultsEl = document.getElementById('totalResults');
    const paginationEl = document.getElementById('pagination');
    const itemsPerPageSelect = document.getElementById('itemsPerPageSelect');
    const monthFilter = document.getElementById('monthFilter');

  let filteredData = [...roundsData];
  let currentPage = 1;
    let itemsPerPage = parseInt(itemsPerPageSelect.value);

    // สร้างตัวเลือกเดือนย้อนหลัง 12 เดือน
    const now = new Date();
        for (let i = 0; i < 12; i++) {
        const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const monthValue = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`; // YYYY-MM
        const monthName = date.toLocaleString('th-TH', { month: 'long', year: 'numeric' });
        monthFilter.innerHTML += `<option value="${monthValue}">${monthName}</option>`;
    }
    function getWastePointDisplay(round) {
        if (!round.wastePoint) {
            return '<span class="text-gray-400 text-xs">ไม่ระบุ</span>';
        }
        
        const typeIcon = {
            'bank': '',
            'center': '',
            'community': '',
            'mobile': ''
        }[round.wastePoint.type] || '';
        
        const statusBadge = round.wastePoint.isOpen 
            ? '<span class="ml-1 text-xs text-green-600">●</span>' 
            : '<span class="ml-1 text-xs text-red-600">●</span>';
        
        return `
            <div class="flex items-center gap-2">
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate">${round.wastePoint.wastePointName}</div>
                </div>
            </div>
        `;
    }

    function createRow(round, index){
        const wastePointId = round.wastePoint ? round.wastePoint._id : '';
        const wastePointDisplay = getWastePointDisplay(round);
    
    return `
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-sm text-center">${(currentPage-1)*itemsPerPage + index + 1}</td>
            <td class="px-4 py-3 text-sm">${round.roundName}</td>
            <td class="px-4 py-3 text-sm">${round.village.villageNumber}</td>
            <td class="px-4 py-3 text-sm">${round.village.villageName}</td>
            <td class="px-4 py-3 text-sm">${wastePointDisplay}</td>
            <td class="px-4 py-3 text-sm">${round.formattedDateThai}</td>
            <td class="px-4 py-3 text-sm">${round.startTime} น.</td>
            <td class="px-4 py-3 text-sm">${round.endTime} น.</td>
            <td class="px-4 py-3 text-sm text-left">
            <button type="button" class="was-row-${(currentPage-1)*itemsPerPage + index + 1} row-active edit-btn" 
                onclick="setRoundForm('${(currentPage-1)*itemsPerPage + index + 1}', '${round._id}', '${round.roundName}', '${round.village._id}', '${wastePointId}', '${round.formattedDateYYMMDD}', '${round.startTime}', '${round.endTime}')"> 
                <i class="fa fa-edit"></i>
            </button>
            <button type="button" class="delete-btn" 
                onclick="deleteRound(['${(currentPage-1)*itemsPerPage + index + 1}', '${round._id}', '${round.roundName}', '${round.village._id}', '${round.formattedDateYYMMDD}', '${round.startTime}', '${round.endTime}'])">
                <i class="fa fa-trash"></i>
            </button>
            </td>
        </tr>
        `;
    }

    function applyFilter() {
        const searchTerm = searchInput.value.toLowerCase();
        const monthValue = monthFilter.value;

        filteredData = roundsData.filter(round => {
            const wastePointName = round.wastePoint ? round.wastePoint.wastePointName.toLowerCase() : '';
            const matchesSearch = round.roundName.toLowerCase().includes(searchTerm) ||
                                round.village.villageName.toLowerCase().includes(searchTerm) ||
                                wastePointName.includes(searchTerm);

            let matchesMonth = true;
            if (monthValue) {
                const d = new Date(round.date); 
                const roundMonth = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
                matchesMonth = roundMonth === monthValue;
            }

            return matchesSearch && matchesMonth;
        });

        currentPage = 1;
        displayData();
    }

    function displayData(){
        const start = (currentPage-1)*itemsPerPage;
        const end = start + itemsPerPage;
        const dataToShow = filteredData.slice(start, end);

        // totalItemsEl.textContent = roundsData.length;
        totalResultsEl.textContent = `${filteredData.length} รายการ`;

        if(dataToShow.length === 0){
        tableBody.innerHTML = '<tr><td colspan="9" class="text-center py-4">- ไม่พบข้อมูล -</td></tr>';
        paginationEl.innerHTML = '';
        return;
        }

        tableBody.innerHTML = dataToShow.map(createRow).join('');
        renderPagination();
    }

    function renderPagination(){
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        if(totalPages <= 1) { paginationEl.innerHTML = ''; return; }

        let html = '';
        for(let i=1; i<=totalPages; i++){
        html += `<button onclick="goToPage(${i})" class="px-3 py-1 border rounded ${i===currentPage?'bg-green-600 text-white':'bg-white text-gray-700'}">${i}</button>`;
        }
        paginationEl.innerHTML = html;
    }

    function goToPage(page){
        currentPage = page;
        displayData();
    }

    searchInput.addEventListener('input', applyFilter);
    monthFilter.addEventListener('change', applyFilter);
    itemsPerPageSelect.addEventListener('change', () => {
        itemsPerPage = parseInt(itemsPerPageSelect.value);
        currentPage = 1;
        displayData();
    });

    displayData();
</script>

</html>