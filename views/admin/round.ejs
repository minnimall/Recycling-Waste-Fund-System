                            <input type="text" id="endTime" name="endTime" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500"
                                placeholder="เช่น 11:30" 
                                required>
