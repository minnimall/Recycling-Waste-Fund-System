<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/round.css">
        <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <!-- Main content -->
    <div class="content">
        <div id="loadingIndicator" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex justify-center items-center">
            <div class="loader"></div>
        </div>
        
        <div class="content-header">
            <h1 class="">รอบการรับซื้อขยะ</h1>
            <div class="add-media" onclick="wasFormToggle()">เพิ่มรอบรับซื้อ</div>
        </div>

        <div class="">
            <h2 class="text-2xl font-bold text-gray-800 bg-green-200 py-2 px-4 rounded-lg inline-block shadow-md">
                ประวัติรอบรับซื้อขยะ
            </h2>
        </div>
        
        <div class="was-container">
            <div class="table-con">
                <table class="table-auto">
                    <thead>
                        <tr>
                            <th class="table-was-index">ลำดับ</th>
                            <th class="table-was-name">ชื่อรอบ</th>
                            <th class="table-was-villageNum">หมู่ที่</th>
                            <th class="table-was-village">หมู่บ้าน</th>
                            <th class="table-was-date">รอบวันที่</th>
                            <th class="table-was-start">เวลาเริ่มต้น</th>
                            <th class="table-was-end">เวลาสิ้นสุด</th>
                            <th class="table-was-delete">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rounds.length > 0) { %>
                            <% rounds.forEach((round, index) => { %>
                            <tr>
                                <td class="table-was-index"><%= index + 1 %></td>
                                <td class="table-was-name"><%= round.roundName %></td>
                                <td class="table-was-village"><%= round.village.villageNumber %></td>
                                <td class="table-was-village"><%= round.village.villageName %></td>
                                <td class="table-was-date"><%= round.formattedDateThai %></td>
                                <td class="table-was-start"><%= round.startTime %> น.</td>
                                <td class="table-was-delete"><%= round.endTime %> น.</td>
                                <td class="table-was-delete">
                                    <button type="button" class="was-row-<%= index + 1 %> row-active edit-btn" 
                                        onclick="setRoundForm('<%= index + 1 %>', '<%= round._id %>', '<%= round.roundName %>', '<%= round.village._id %>', '<%= round.date %>', '<%= round.startTime %>', '<%= round.endTime %>')">                                                
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button type="button" class="delete-btn" 
                                        onclick="deleteRound(['<%= index + 1 %>', '<%= round._id %>', '<%= round.roundName %>', '<%= round.village._id %>', '<%= round.date %>', '<%= round.startTime %>', '<%= round.endTime %>'])">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-2 px-4">ไม่พบข้อมูลหมู่บ้าน</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- เพิ่มรอบรับซื้อ -->
            <div class="was-form" id="add_Form" style="display: none;">
                <form action="/admin/roundPost" method="POST" enctype="application/x-www-form-urlencoded">
                    <div class="form-head">
                        <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                        <span>เพิ่มรอบการรับซื้อขยะ</span>
                    </div>
                    <div class="input-group">
                        <label for="roundName">ชื่อรอบ</label>
                        <input type="text" name="roundName" placeholder="ชื่อรอบการรับซื้อขยะ" required>

                        <label for="village">หมู่บ้าน</label>
                        <select name="village" required>
                            <option value="">เลือกหมู่บ้าน</option>
                            <% village.forEach(v => { %>
                                <option value="<%= v._id %>"><%= v.villageName %></option>
                            <% }) %>
                        </select>

                        <label for="date">วันที่</label>
                        <input type="date" name="date" required>

                        <label for="startTime">เวลาเริ่มต้น</label>
                        <input type="time" name="startTime" required>

                        <label for="endTime" >เวลาสิ้นสุด</label>
                        <input type="time" name="endTime" required>
            
                        <div class="submit-btn flex justify-end">
                            <button type="button" class="cancel" onclick="cancelForm()">ยกเลิก</button>
                            <button type="submit" class="submit">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- แก้ไขรอบรับซื้อ -->
            <div class="was-form" id="edit_Form" style="display: none;">
                <form action="/admin/roundEdit" method="POST" enctype="application/x-www-form-urlencoded">
                    <div class="form-head">
                        <ion-icon class="head-logo" name="information-circle-outline"></ion-icon>
                        <span>แก้ไขรอบการรับซื้อขยะ</span>
                    </div>
                    <div class="input-group">
                        <input type="hidden" name="_id" id="_id" value="">

                        <label for="roundName">ชื่อรอบ</label>
                        <input type="text" id="roundName" name="roundName" placeholder="ชื่อรอบการรับซื้อขยะ" required>

                        <label for="village">หมู่บ้าน</label>
                        <select id="village" name="village" required>
                            <option value="">เลือกหมู่บ้าน</option>
                            <% village.forEach(v => { %>
                                <option value="<%= v._id %>"><%= v.villageName %></option>
                            <% }) %>
                        </select>

                        <label for="date">วันที่</label>
                        <input type="date" id="date" name="date" required>

                        <label for="startTime">เวลาเริ่มต้น</label>
                        <input type="time" id="startTime" name="startTime" required>

                        <label for="endTime" >เวลาสิ้นสุด</label>
                        <input type="time" id="endTime" name="endTime" required>
            
                        <div class="submit-btn flex justify-end">
                            <button type="button" class="cancel" onclick="cancelForm()">ยกเลิก</button>
                            <button type="submit" class="submit">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
<script>
    // function showLoading() {
    // document.getElementById('loadingIndicator').classList.remove('hidden');
    // }

    // function hideLoading() {
    //     document.getElementById('loadingIndicator').classList.add('hidden');
    // }

    // // ดักจับการกดปุ่ม Submit ใน Form
    // document.querySelectorAll("form").forEach(form => {
    //     form.addEventListener("submit", function() {
    //         showLoading();
    //     });
    // });

    let lastClickedRow = null;
    function setRoundForm(Index, Id, Name, Village, Date, Start, End) {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        const InputRoundId = document.getElementById('_id');
        InputRoundId.value = Id;

        const InputRoundName = document.getElementById('roundName');
        InputRoundName.value = Name;

        const InputVillage = document.getElementById('village');
        InputVillage.value = Village;

        const InputDate = document.getElementById('date');
        InputDate.value = Date;

        const InputStartTime = document.getElementById('startTime');
        InputStartTime.value = Start;

        const InputEndTime = document.getElementById('endTime');
        InputEndTime.value = End;
        
        addForm.style.display = 'none';
        const selectedRow = document.querySelector(`.was-row-${Index}`);
        if (lastClickedRow === selectedRow) {
            selectedRow.style.backgroundColor = '';
            lastClickedRow = null;
            editForm.style.display = 'none';
        } else {
            if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
            selectedRow.style.backgroundColor = '#8EDBA4';
            editForm.style.display = 'block';
            lastClickedRow = selectedRow;
        }
    }
    function wasFormToggle() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        if (addForm.style.display === 'block') {
            addForm.style.display = 'none';
        }
        else {
            addForm.style.display = 'block';
        }
    }
    function deleteRound(data) {
        Swal.fire({
            title: `ลบ "${data[2]}" หรือไม่?`,
            text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/admin/roundDelete/' + data[1], {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                .then(result => {
                    Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลหมู่บ้านถูกลบเรียบร้อยแล้ว', 'success')
                    .then(() => {
                        location.reload();
                    });
                })
                .catch(error => {
                    Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                });
            }
        });
    }
    function cancelForm() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        addForm.style.display = 'none';

        editForm.reset();
        addForm.reset();
    }
</script>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

</html>