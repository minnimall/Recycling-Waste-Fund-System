<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/round.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">รอบการรับซื้อขยะ <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= rounds.length %> รายการ)</span></h1>
                <p class="text-gray-600">รอบการรับซื้อขยะทั้งหมดของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="wasFormToggle()">เพิ่มรอบรับซื้อ</button>
            </div>
        </div>
            <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
                <!-- Search + Filter + Items per page -->
                <div class="flex flex-col md:flex-row items-center gap-4">
                    <!-- <input type="text" id="searchInput" placeholder="ค้นหารอบการรับซื้อ" 
                            class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"> -->
                                        <div class="relative flex-1">
                    <input type="text" id="searchInput" placeholder="ค้นหารอบการรับซื้อ" 
                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"" />
                    <div class="absolute left-3 top-2.5 text-gray-400">
                        <i class="fas fa-search"></i>
                    </div>
                    </div>
                    
                    <label for="perPage" class="text-sm text-gray-600">เดือน:</label>
                    <select id="monthFilter" class="w-48 py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500">
                        <option value="">ทุกเดือน</option>
                    </select>

                    <label for="perPage" class="text-sm text-gray-600">แสดง:</label>
                    <select id="itemsPerPageSelect" class="w-32 py-2 px-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>


        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
        <div class="mb-4 border-b border-gray-200 pb-4">
            <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
            ผลลัพท์รอบการรับซื้อขยะ: <span id="totalResults" class="text-blue-600 text-base font-normal">0 รายการ</span>
            </h2>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-100">
                <tr>
                <th class="px-4 py-3 text-sm text-center">ลำดับ</th>
                <th class="px-4 py-3 text-sm text-left">ชื่อรอบ</th>
                <th class="px-4 py-3 text-sm text-left">หมู่ที่</th>
                <th class="px-4 py-3 text-sm text-left">หมู่บ้าน</th>
                <th class="px-4 py-3 text-sm text-left">รอบวันที่</th>
                <th class="px-4 py-3 text-sm text-left">เวลาเริ่มต้น</th>
                <th class="px-4 py-3 text-sm text-left">เวลาสิ้นสุด</th>
                <th class="px-4 py-3 text-sm text-left">จัดการ</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="bg-white divide-y divide-gray-200"></tbody>
            </table>
        </div>

        <div class="mt-4 flex justify-center items-center">
            <div id="pagination" class="flex gap-2"></div>
        </div>
        </div>



        <!-- เพิ่มรอบรับซื้อ -->
        <div id="add_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                <form action="/admin/roundPost" method="POST" enctype="application/x-www-form-urlencoded" class="bg-white rounded-xl shadow-lg w-full p-6 space-y-5">
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">เพิ่มรอบการรับซื้อขยะ</span>
                    </div>

                    <div class="space-y-4">
                        <!-- ชื่อรอบ -->
                        <div>
                            <label for="roundName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อรอบ</label>
                            <input type="text" name="roundName" placeholder="ชื่อรอบการรับซื้อขยะ" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500">
                        </div>

                        <!-- หมู่บ้าน -->
                        <div>
                            <label for="village" class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                            <select name="village" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500">
                                <option value="">เลือกหมู่บ้าน</option>
                                <% village.forEach(v => { %>
                                    <option value="<%= v._id %>"><%= v.villageName %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- วันที่ -->
                        <div>
                            <label for="date" class="block text-sm font-medium text-gray-700 mb-1">วันที่</label>
                            <input type="date" name="date" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500">
                        </div>

                        <!-- เวลาเริ่มต้น -->
                        <div>
                            <label for="startTime" class="block text-sm font-medium text-gray-700 mb-1">เวลาเริ่มต้น</label>
                            <input type="text" name="startTime" class="startTime" required
                                placeholder="เช่น 08:00"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500">
                        </div>

                        <!-- เวลาสิ้นสุด -->
                        <div>
                            <label for="endTime" class="block text-sm font-medium text-gray-700 mb-1">เวลาสิ้นสุด</label>
                            <input type="text" name="endTime" class="endTime" required
                                placeholder="เช่น 11:30"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-500">
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-2">
                            <button type="button" onclick="cancelForm()"
                                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                            <button type="submit"
                                class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- แก้ไขรอบรับซื้อ -->
        <div id="edit_Form" class="fixed inset-0 z-50 bg-black bg-opacity-30 flex items-center justify-center hidden">
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
                <form action="/admin/roundEdit" method="POST" enctype="application/x-www-form-urlencoded"
                    class="bg-white rounded-xl shadow-lg w-full p-6 space-y-5">
                    
                    <!-- หัวฟอร์ม -->
                    <div class="flex items-center space-x-3 border-b pb-3">
                        <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                        <span class="text-xl font-semibold text-gray-800">แก้ไขรอบการรับซื้อขยะ</span>
                    </div>

                    <div class="space-y-4">
                        <!-- Hidden ID -->
                        <input type="hidden" name="_id" id="_id" value="">

                        <!-- ชื่อรอบ -->
                        <div>
                            <label for="roundName" class="block text-sm font-medium text-gray-700 mb-1">ชื่อรอบ</label>
                            <input type="text" id="roundName" name="roundName" placeholder="ชื่อรอบการรับซื้อขยะ" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- หมู่บ้าน -->
                        <div>
                            <label for="village" class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                            <select id="village" name="village" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                                <option value="">เลือกหมู่บ้าน</option>
                                <% village.forEach(v => { %>
                                    <option value="<%= v._id %>"><%= v.villageName %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- วันที่ -->
                        <div>
                            <label for="date" class="block text-sm font-medium text-gray-700 mb-1">วันที่</label>
                            <input type="date" id="date" name="date" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- เวลาเริ่มต้น -->
                        <div>
                            <label for="startTime" class="block text-sm font-medium text-gray-700 mb-1">เวลาเริ่มต้น</label>
                            <input type="text" id="startTime" name="startTime" placeholder="เช่น 08:00" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- เวลาสิ้นสุด -->
                        <div>
                            <label for="endTime" class="block text-sm font-medium text-gray-700 mb-1">เวลาสิ้นสุด</label>
                            <input type="text" id="endTime" name="endTime" placeholder="เช่น 11:30" required
                                class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-yellow-500">
                        </div>

                        <!-- ปุ่ม -->
                        <div class="flex justify-end space-x-3 pt-2">
                            <button type="button" onclick="cancelForm()"
                                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                            <button type="submit"
                                class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึก</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            flatpickr(".startTime", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                time_24hr: true,
                minuteIncrement: 30
            });

            flatpickr(".endTime", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                time_24hr: true,
                minuteIncrement: 30
            });
        });
    </script>
<script>
    // function showLoading() {
    // document.getElementById('loadingIndicator').classList.remove('hidden');
    // }

    // function hideLoading() {
    //     document.getElementById('loadingIndicator').classList.add('hidden');
    // }

    // // ดักจับการกดปุ่ม Submit ใน Form
    // document.querySelectorAll("form").forEach(form => {
    //     form.addEventListener("submit", function() {
    //         showLoading();
    //     });
    // });

    let lastClickedRow = null;
    function setRoundForm(Index, Id, Name, Village, Date, Start, End) {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        const InputRoundId = document.getElementById('_id');
        InputRoundId.value = Id;

        const InputRoundName = document.getElementById('roundName');
        InputRoundName.value = Name;

        const InputVillage = document.getElementById('village');
        InputVillage.value = Village;

        const InputDate = document.getElementById('date');
        InputDate.value = Date;

        const InputStartTime = document.getElementById('startTime');
        InputStartTime.value = Start;

        const InputEndTime = document.getElementById('endTime');
        InputEndTime.value = End;
        
        addForm.style.display = 'none';
        const selectedRow = document.querySelector(`.was-row-${Index}`);
        if (lastClickedRow === selectedRow) {
            lastClickedRow = null;
            editForm.style.display = 'none';
        } else {
            if (lastClickedRow) lastClickedRow.style.backgroundColor = '';
            editForm.style.display = 'block';
            lastClickedRow = selectedRow;
        }
    }
    function wasFormToggle() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        if (addForm.style.display === 'block') {
            addForm.style.display = 'none';
        }
        else {
            addForm.style.display = 'block';
        }
    }
    function deleteRound(data) {
        Swal.fire({
            title: `ลบ "${data[2]}" หรือไม่?`,
            text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "ยืนยัน",
            cancelButtonText: "ยกเลิก"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/admin/roundDelete/' + data[1], {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                .then(result => {
                    Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลหมู่บ้านถูกลบเรียบร้อยแล้ว', 'success')
                    .then(() => {
                        location.reload();
                    });
                })
                .catch(error => {
                    Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                });
            }
        });
    }
    function cancelForm() {
        const editForm = document.getElementById('edit_Form');
        const addForm = document.getElementById('add_Form');

        editForm.style.display = 'none';
        addForm.style.display = 'none';

        // Reset ฟอร์ม
        editForm.querySelector('form').reset();
        addForm.querySelector('form')?.reset();

        // ยกเลิกแรเงาแถว
        if (lastClickedRow) {
            lastClickedRow.style.backgroundColor = '';
            lastClickedRow = null;
        }
    }

  const roundsData = <%- JSON.stringify(rounds) %>;
  const tableBody = document.getElementById('tableBody');
  const searchInput = document.getElementById('searchInput');
  const totalItemsEl = document.getElementById('totalItems');
  const totalResultsEl = document.getElementById('totalResults');
  const paginationEl = document.getElementById('pagination');
  const itemsPerPageSelect = document.getElementById('itemsPerPageSelect');
  const monthFilter = document.getElementById('monthFilter');

  let filteredData = [...roundsData];
  let currentPage = 1;
  let itemsPerPage = parseInt(itemsPerPageSelect.value);

  // สร้างตัวเลือกเดือนย้อนหลัง 12 เดือน
  const now = new Date();
  for (let i = 0; i < 12; i++) {
    const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
    const monthValue = date.toISOString().slice(0,7); // YYYY-MM
    const monthName = date.toLocaleString('th-TH', { month: 'long', year: 'numeric' });
    monthFilter.innerHTML += `<option value="${monthValue}">${monthName}</option>`;
  }

  function createRow(round, index){
    return `
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="px-4 py-3 text-center">${(currentPage-1)*itemsPerPage + index + 1}</td>
        <td class="px-4 py-3">${round.roundName}</td>
        <td class="px-4 py-3">${round.village.villageNumber}</td>
        <td class="px-4 py-3">${round.village.villageName}</td>
        <td class="px-4 py-3">${round.formattedDateThai}</td>
        <td class="px-4 py-3">${round.startTime} น.</td>
        <td class="px-4 py-3">${round.endTime} น.</td>
        <td class="px-4 py-3 text-left">
          <button type="button" class="was-row-${(currentPage-1)*itemsPerPage + index + 1} row-active edit-btn" 
              onclick="setRoundForm('${(currentPage-1)*itemsPerPage + index + 1}', '${round._id}', '${round.roundName}', '${round.village._id}', '${round.formattedDateThai}', '${round.startTime}', '${round.endTime}')"> 
              <i class="fa fa-edit"></i>
          </button>
          <button type="button" class="delete-btn" 
              onclick="deleteRound(['${(currentPage-1)*itemsPerPage + index + 1}', '${round._id}', '${round.roundName}', '${round.village._id}', '${round.formattedDateThai}', '${round.startTime}', '${round.endTime}'])">
              <i class="fa fa-trash"></i>
          </button>
        </td>
      </tr>
    `;
  }

  function applyFilter() {
    const searchTerm = searchInput.value.toLowerCase();
    const monthValue = monthFilter.value;

    filteredData = roundsData.filter(round => {
      const matchesSearch = round.roundName.toLowerCase().includes(searchTerm) ||
                            round.village.villageName.toLowerCase().includes(searchTerm);

      let matchesMonth = true;
      if(monthValue){
        const roundMonth = round.date.slice(0,7); // YYYY-MM
        matchesMonth = roundMonth === monthValue;
      }

      return matchesSearch && matchesMonth;
    });

    currentPage = 1;
    displayData();
  }

  function displayData(){
    const start = (currentPage-1)*itemsPerPage;
    const end = start + itemsPerPage;
    const dataToShow = filteredData.slice(start, end);

    // totalItemsEl.textContent = roundsData.length;
    totalResultsEl.textContent = `${filteredData.length} รายการ`;

    if(dataToShow.length === 0){
      tableBody.innerHTML = '<tr><td colspan="8" class="text-center py-4">- ไม่พบข้อมูล -</td></tr>';
      paginationEl.innerHTML = '';
      return;
    }

    tableBody.innerHTML = dataToShow.map(createRow).join('');
    renderPagination();
  }

  function renderPagination(){
    const totalPages = Math.ceil(filteredData.length / itemsPerPage);
    if(totalPages <= 1) { paginationEl.innerHTML = ''; return; }

    let html = '';
    for(let i=1; i<=totalPages; i++){
      html += `<button onclick="goToPage(${i})" class="px-3 py-1 border rounded ${i===currentPage?'bg-green-600 text-white':'bg-white text-gray-700'}">${i}</button>`;
    }
    paginationEl.innerHTML = html;
  }

  function goToPage(page){
    currentPage = page;
    displayData();
  }

  searchInput.addEventListener('input', applyFilter);
  monthFilter.addEventListener('change', applyFilter);
  itemsPerPageSelect.addEventListener('change', () => {
    itemsPerPage = parseInt(itemsPerPageSelect.value);
    currentPage = 1;
    displayData();
  });

  displayData();
</script>
<%- include('../partials/adminPartials/adminFooter.ejs') %>

</html>