<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/dashboard.css">
    <link rel="stylesheet" href="/style_admin/res_req.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chart.js plugins -->
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: 'สำเร็จ!',
                text: successMessage,
                confirmButtonText: 'ตกลง',
                confirmButtonColor: '#28a745',
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>

    <!-- Main content -->
    <div class="content bg-gray-50 min-h-screen">
        <!-- Header with Filters -->
        <div class="mt-4 mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h1 class="text-2xl font-semibold text-gray-800">แดชบอร์ด</h1>
                    <p class="text-gray-500">ข้อมูลสรุปภาพรวมของกองทุนขยะรีไซเคิล</p>
                </div>
            </div>

            <!-- Filter Form -->
            <form method="GET" action="/admin" class="bg-gray-50 p-4 rounded-lg">
                <div class="flex flex-wrap items-end gap-3">
                    <!-- Filter วันที่ -->
                    <div class="flex-1 min-w-[150px]">
                        <label for="searchDate" class="block text-sm font-medium text-gray-700 mb-1">วันที่</label>
                        <input type="date" name="searchDate" id="searchDate" value="<%= searchDate %>" 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                    </div>

                    <!-- Filter เดือน -->
                    <div class="flex-1 min-w-[150px]">
                        <label for="searchMonth" class="block text-sm font-medium text-gray-700 mb-1">เดือน</label>
                        <select name="searchMonth" id="searchMonth" 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                            <option value="">ทั้งหมด</option>
                            <option value="01" <%= searchMonth === '01' ? 'selected' : '' %>>มกราคม</option>
                            <option value="02" <%= searchMonth === '02' ? 'selected' : '' %>>กุมภาพันธ์</option>
                            <option value="03" <%= searchMonth === '03' ? 'selected' : '' %>>มีนาคม</option>
                            <option value="04" <%= searchMonth === '04' ? 'selected' : '' %>>เมษายน</option>
                            <option value="05" <%= searchMonth === '05' ? 'selected' : '' %>>พฤษภาคม</option>
                            <option value="06" <%= searchMonth === '06' ? 'selected' : '' %>>มิถุนายน</option>
                            <option value="07" <%= searchMonth === '07' ? 'selected' : '' %>>กรกฎาคม</option>
                            <option value="08" <%= searchMonth === '08' ? 'selected' : '' %>>สิงหาคม</option>
                            <option value="09" <%= searchMonth === '09' ? 'selected' : '' %>>กันยายน</option>
                            <option value="10" <%= searchMonth === '10' ? 'selected' : '' %>>ตุลาคม</option>
                            <option value="11" <%= searchMonth === '11' ? 'selected' : '' %>>พฤศจิกายน</option>
                            <option value="12" <%= searchMonth === '12' ? 'selected' : '' %>>ธันวาคม</option>
                        </select>
                    </div>

                    <!-- Filter ปี -->
                    <div class="flex-1 min-w-[120px]">
                        <label for="searchYear" class="block text-sm font-medium text-gray-700 mb-1">ปี</label>
                        <select name="searchYear" id="searchYear" 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                            <option value="">ทั้งหมด</option>
                            <% 
                                const currentYear = new Date().getFullYear();
                                for (let i = 0; i <= 5; i++) {
                                    const year = currentYear - i;
                                    const buddhistYear = year + 543;
                            %>
                                <option value="<%= year %>" <%= searchYear == year.toString() ? 'selected' : '' %>>
                                    <%= buddhistYear %>
                                </option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Village Filter -->
                    <div class="flex-1 min-w-[180px]">
                        <label for="village" class="block text-sm font-medium text-gray-700 mb-1">หมู่บ้าน</label>
                        <select name="village" id="village" 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                            <option value="">ทุกหมู่บ้าน</option>
                            <% if (allVillages && allVillages.length > 0) { %>
                                <% allVillages.forEach(village => { %>
                                    <option value="<%= village._id %>" <%= villageId === village._id.toString() ? 'selected' : '' %>>
                                        <%= village.villageName || `หมู่บ้านที่ ${village.villageNumber}` %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <div>
                        <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 whitespace-nowrap">
                            <i class="fas fa-search mr-2"></i>ค้นหา
                        </button>
                    </div>
                </div>

                <!-- Current Filter Display -->
                <% if (filterInfo && (filterInfo.searchDate || filterInfo.searchMonth || filterInfo.searchYear || filterInfo.village)) { %>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <span class="text-sm text-gray-600">ตัวกรองปัจจุบัน:</span>
                        
                        <!-- แสดงวันที่ที่เลือก -->
                        <% if (filterInfo.searchDate) { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                <i class="fas fa-calendar-day mr-1"></i>วันที่ 
                                <% 
                                    const dateObj = new Date(filterInfo.searchDate);
                                    const thaiDate = dateObj.toLocaleDateString('th-TH', { 
                                        year: 'numeric', 
                                        month: 'long', 
                                        day: 'numeric' 
                                    });
                                %>
                                <%= thaiDate %>
                            </span>
                        <% } %>

                        <!-- แสดงเดือนที่เลือก -->
                        <% if (filterInfo.searchMonth) { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                <i class="fas fa-calendar mr-1"></i>
                                <% 
                                    const monthNames = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
                                                        'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
                                    const monthName = monthNames[parseInt(filterInfo.searchMonth) - 1];
                                %>
                                <%= monthName %>
                            </span>
                        <% } %>

                        <!-- แสดงปีที่เลือก -->
                        <% if (filterInfo.searchYear) { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                                <i class="fas fa-calendar-alt mr-1"></i>ปี <%= parseInt(filterInfo.searchYear) + 543 %>
                            </span>
                        <% } %>
                        
                        <!-- แสดงหมู่บ้านที่เลือก -->
                        <% if (filterInfo.village && filterInfo.villageName) { %>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <i class="fas fa-map-marker-alt mr-1"></i><%= filterInfo.villageName %>
                            </span>
                        <% } %>

                        <!-- ปุ่มล้างตัวกรอง -->
                        <a href="/admin" class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
                            <i class="fas fa-times mr-1"></i>ล้างตัวกรอง
                        </a>
                    </div>
                <% } %>
            </form>
        </div>

        <!-- Stats cards -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <!-- Card 1: ปริมาณขยะทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-blue-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ปริมาณขยะทั้งหมด</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            <%= totalQuantity.toLocaleString() %> <span class="text-sm font-normal">กก.</span>
                        </h2>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <i class="fas fa-weight-hanging text-blue-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">ปริมาณขยะที่รับซื้อทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 2: ยอดเงินทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-green-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">ยอดเงินทั้งหมด</p>
                        <h2 class="text-3xl font-bold text-gray-800">
                            ฿<%= totalAmount.toLocaleString() %>
                        </h2>
                    </div>
                    <div class="p-3 bg-green-100 rounded-full">
                        <i class="fas fa-money-bill-wave text-green-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">มูลค่าการรับซื้อขยะทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 3: จำนวนธุรกรรมทั้งหมด -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-purple-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">จำนวนธุรกรรม</p>
                        <h2 class="text-3xl font-bold text-gray-800"><%= totalTransactions.toLocaleString() %></h2>
                    </div>
                    <div class="p-3 bg-purple-100 rounded-full">
                        <i class="fas fa-exchange-alt text-purple-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">ธุรกรรมการรับซื้อขยะทั้งหมด</span>
                </div>
            </div>
            
            <!-- Card 4: ยอดรับซื้อวันนี้ -->
            <div class="bg-white rounded-lg p-6 shadow-sm border-l-4 border-yellow-500 transition-transform hover:scale-105">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 mb-1">
                            <% if (filterInfo.searchDate || filterInfo.searchMonth || filterInfo.searchYear) { %>
                                ยอดรับซื้อตามช่วงที่เลือก
                            <% } else { %>
                                ยอดรับซื้อวันนี้
                            <% } %>
                        </p>
                        <h2 class="text-2xl font-bold text-gray-800">
                            ฿<%= selectedDateTotal.toLocaleString() %>
                        </h2>
                        <!-- <% if (filterInfo.searchDate || filterInfo.searchMonth || filterInfo.searchYear) { %>
                            <p class="text-xs text-gray-400 mt-1">
                                วันนี้: ฿<%= todayTotal.toLocaleString() %>
                            </p>
                        <% } %> -->
                    </div>
                    <div class="p-3 bg-yellow-100 rounded-full">
                        <i class="fas fa-chart-line text-yellow-500 text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <span class="text-gray-500 text-sm">ยอดรับซื้อรวมในแต่ละวัน</span>
                </div>
            </div>
        </div>

        <!-- Main dashboard sections -->
        <div class="mx-4 grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Section 1: Village Data Chart -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">ข้อมูลแต่ละหมู่บ้าน</h2>
                    <div class="text-sm text-gray-500">
                        <!-- <i class="fas fa-chart-pie mr-1"></i>ตามตัวกรอง -->
                    </div>
                </div>
                <div class="h-80 flex items-center justify-center">
                    <% if (villageData && villageData.length > 0) { %>
                        <canvas id="villageWasteChart"></canvas>
                    <% } else { %>
                        <div class="text-center text-gray-500">
                            <i class="fas fa-chart-pie text-6xl mb-4"></i>
                            <p>ไม่มีข้อมูลหมู่บ้าน</p>
                        </div>
                    <% } %>
                </div>
                <% if (villageData && villageData.length > 0) { %>
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <% const maxQuantityVillage = villageData.reduce((max, village) => village.totalQuantity > max.totalQuantity ? village : max); %>
                        <% const maxAmountVillage = villageData.reduce((max, village) => village.totalAmount > max.totalAmount ? village : max); %>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีปริมาณขยะมากที่สุด</p>
                            <p class="font-semibold text-blue-600">
                                <%= maxQuantityVillage.villageName || `หมู่บ้านที่ ${maxQuantityVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600"><%= maxQuantityVillage.totalQuantity.toLocaleString() %> กก.</p>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-lg">
                            <p class="text-gray-500 text-sm">หมู่บ้านที่มีมูลค่าขยะมากที่สุด</p>
                            <p class="font-semibold text-green-600">
                                <%= maxAmountVillage.villageName || `หมู่บ้านที่ ${maxAmountVillage.villageNumber}` %>
                            </p>
                            <p class="text-sm text-gray-600">฿<%= maxAmountVillage.totalAmount.toLocaleString() %></p>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Section 2: Waste Type Summary -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">สรุปตามประเภทขยะ</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ประเภทขยะ</th>
                                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ปริมาณ (กก.)</th>
                                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">มูลค่ารวม</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% if (wasteSummary && wasteSummary.length > 0) { %>
                                <% const colors = ['blue', 'green', 'yellow', 'red', 'purple', 'indigo', 'pink', 'gray', 'orange', 'teal']; %>
                                <% wasteSummary.forEach((waste, index) => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="h-3 w-3 rounded-full bg-<%= colors[index % colors.length] %>-500 mr-2"></div>
                                                <div class="text-sm font-medium text-gray-900"><%= waste._id %></div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                                            <%= waste.totalQuantity.toLocaleString() %>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            ฿<%= waste.totalAmount.toLocaleString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="px-4 py-8 text-center text-gray-500">
                                        <i class="fas fa-inbox text-4xl mb-2"></i>
                                        <p>ไม่มีข้อมูลการรับซื้อ</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Additional Stats Section -->
        <div class="mx-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-orange-100 rounded-full">
                        <i class="fas fa-crown text-orange-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">ขยะมูลค่าสูงสุด</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= highestWaste && highestWaste._id ? highestWaste._id.wasteName : 'ไม่มีข้อมูล' %>
                        </p>
                        <p class="text-sm text-orange-600">฿<%= highestWaste ? highestWaste.pricePerUnit : 0 %> / กก.</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-teal-100 rounded-full">
                        <i class="fas fa-calendar-day text-teal-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">ธุรกรรมวันนี้</p>
                        <p class="text-lg font-semibold text-gray-800"><%= transactionToday %></p>
                        <!-- <p class="text-sm text-teal-600">
                            <% if (transactionPercentChange >= 0) { %>
                                <i class="fas fa-arrow-up"></i> <%= transactionPercentChange %>%
                            <% } else { %>
                                <i class="fas fa-arrow-down"></i> <%= Math.abs(transactionPercentChange) %>%
                            <% } %>
                            จากเมื่อวาน
                        </p> -->
                    </div>
                </div>
            </div>

            <!-- <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-pink-100 rounded-full">
                        <i class="fas fa-balance-scale text-pink-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">เดือนที่แล้ว</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= lastMonthQuantity.toLocaleString() %> กก.
                        </p>
                        <p class="text-sm text-pink-600">฿<%= lastMonthTotal.toLocaleString() %></p>
                    </div>
                </div>
            </div> -->

            <div class="bg-white rounded-lg shadow p-4">
                <div class="flex items-center">
                    <div class="p-3 bg-indigo-100 rounded-full">
                        <i class="fas fa-home text-indigo-500"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">จำนวนหมู่บ้าน</p>
                        <p class="text-lg font-semibold text-gray-800">
                            <%= villageData ? villageData.length : 0 %> หมู่บ้าน
                        </p>
                        <p class="text-sm text-indigo-600">ที่มีการรับซื้อขยะ</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Top 5 Families Section -->
        <div class="mx-4 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                            <i class="fas fa-trophy text-yellow-500 mr-2"></i>
                            5 อันดับครัวเรือนที่มียอดขายขยะสูงสุด
                        </h2>
                        <p class="text-sm text-gray-500 mt-1">อันดับครัวเรือนที่นำขยะมาขายได้มูลค่ามากที่สุด</p>
                    </div>
                </div>

                <% if (topFamilies && topFamilies.length > 0) { %>
                    <!-- Desktop View -->
                    <div class="hidden md:block overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-4 text-center text-xs font-semibold text-gray-700 uppercase">อันดับ</th>
                                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase">ชื่อครอบครัว</th>
                                    <th class="px-6 py-4 text-center text-xs font-semibold text-gray-700 uppercase">เลขที่บัญชี</th>
                                    <th class="px-6 py-4 text-center text-xs font-semibold text-gray-700 uppercase">ประเภท</th>
                                    <th class="px-6 py-4 text-right text-xs font-semibold text-gray-700 uppercase">ปริมาณ (กก.)</th>
                                    <th class="px-6 py-4 text-right text-xs font-semibold text-gray-700 uppercase">มูลค่ารวม (บาท)</th>
                                    <th class="px-6 py-4 text-center text-xs font-semibold text-gray-700 uppercase">จำนวนธุรกรรม</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% 
                                const rankColors = [
                                    'bg-gradient-to-br from-yellow-400 to-yellow-500 text-white',    
                                    'bg-gradient-to-br from-gray-300 to-gray-400 text-white',       
                                    'bg-gradient-to-br from-orange-600 to-red-600 text-white',    
                                    'bg-gradient-to-br from-sky-400 to-blue-500 text-white',    
                                    'bg-gradient-to-br from-indigo-400 to-purple-500 text-white' 
                                ];
                                const familyTypeLabels = {
                                    'household': 'ครัวเรือน',
                                    'school': 'โรงเรียน',
                                    'municipality': 'เทศบาล',
                                    'community': 'ชุมชน',
                                    'temple': 'วัด'
                                };
                                %>
                                <% topFamilies.forEach((family, index) => { %>
                                    <tr class="hover:bg-gray-50 transition-all">
                                        <td class="px-6 py-4 text-center">
                                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full <%= rankColors[index] %> font-bold text-lg shadow-md">
                                                <%= index + 1 %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center">
                                                <!-- <div class="h-10 w-10 bg-gray-100 rounded-full flex items-center justify-center">
                                                    <i class="fas fa-home text-gray-600"></i>
                                                </div> -->
                                                <div class="ml-4 text-sm font-semibold text-gray-900">
                                                    <%= family.familyName %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="px-3 py-1.5 rounded-md text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                <!-- <i class="fas fa-hashtag text-[10px] mr-1"></i> -->
                                                <%= family.accountNumber %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">
                                                <%= familyTypeLabels[family.familyType] || family.familyType %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right font-semibold">
                                            <%= family.totalQuantity.toLocaleString() %>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="inline-flex items-center px-3 py-1.5 rounded-md font-bold text-sm bg-green-50 text-green-700 border border-green-200">
                                                <!-- <span class="text-xs mr-0.5">฿</span> -->
                                                <%= family.totalAmount.toLocaleString() %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-violet-50 text-violet-700">
                                                <%= family.transactionCount %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Stats -->
                    <!-- <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                        <% 
                        const totalTopAmount = topFamilies.reduce((sum, f) => sum + f.totalAmount, 0);
                        const totalTopQuantity = topFamilies.reduce((sum, f) => sum + f.totalQuantity, 0);
                        const totalTopTransactions = topFamilies.reduce((sum, f) => sum + f.transactionCount, 0);
                        %>
                        
                        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-4">
                            <p class="text-xs text-green-600 font-medium">รวมมูลค่า Top 5</p>
                            <p class="text-lg font-bold text-green-700">฿<%= totalTopAmount.toLocaleString() %></p>
                        </div>
                        
                        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-4">
                            <p class="text-xs text-blue-600 font-medium">รวมปริมาณ Top 5</p>
                            <p class="text-lg font-bold text-blue-700"><%= totalTopQuantity.toLocaleString() %> กก.</p>
                        </div>
                        
                        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-4">
                            <p class="text-xs text-purple-600 font-medium">รวมธุรกรรม Top 5</p>
                            <p class="text-lg font-bold text-purple-700"><%= totalTopTransactions.toLocaleString() %> ครั้ง</p>
                        </div>
                    </div> -->

                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-trophy text-6xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500">ไม่มีข้อมูลครอบครัว</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ข้อมูลจากเซิร์ฟเวอร์
            const villageData   = JSON.parse('<%- JSON.stringify(villageData || []) %>');
            const wasteSummary  = JSON.parse('<%- JSON.stringify(wasteSummary || []) %>');
            const priceTrends   = JSON.parse('<%- JSON.stringify(priceTrends || []) %>');

            console.log('Village Data:', villageData);
            console.log('Waste Summary:', wasteSummary);
            console.log('Price Trends:', priceTrends);

            // 3D Village Waste Chart
            const villageCtx = document.getElementById('villageWasteChart');
            if (villageCtx && villageData.length > 0) {
                const villageLabels = villageData.map(village => 
                    village.villageName || `หมู่บ้านที่ ${village.villageNumber}`
                );
                const villageQuantities = villageData.map(village => village.totalQuantity); // เอา Math.round() ออก
                const villageColors = [
                    'rgba(255, 99, 132, 0.8)', 'rgba(54, 162, 235, 0.8)', 'rgba(255, 206, 86, 0.8)',
                    'rgba(75, 192, 192, 0.8)', 'rgba(153, 102, 255, 0.8)', 'rgba(255, 159, 64, 0.8)',
                    'rgba(199, 199, 199, 0.8)', 'rgba(83, 102, 255, 0.8)', 'rgba(40, 159, 64, 0.8)',
                    'rgba(210, 99, 132, 0.8)', 'rgba(127, 255, 212, 0.8)', 'rgba(255, 20, 147, 0.8)'
                ];

                // Custom 3D effect plugin
                const threeDPiePlugin = {
                    id: 'threeDPie',
                    beforeDraw: function(chart) {
                        const ctx = chart.ctx;
                        const chartArea = chart.chartArea;
                        const centerX = (chartArea.left + chartArea.right) / 2;
                        const centerY = (chartArea.top + chartArea.bottom) / 2;
                        const radius = Math.min(chartArea.right - chartArea.left, chartArea.bottom - chartArea.top) / 2 * 0.8;
                        const depth = 20; // ความลึกของ 3D effect
                        
                        // วาดเงาด้านล่าง
                        ctx.save();
                        ctx.shadowColor = 'rgba(0, 0, 0, 0.3)';
                        ctx.shadowBlur = 15;
                        ctx.shadowOffsetX = 5;
                        ctx.shadowOffsetY = 5;
                        
                        let currentAngle = -Math.PI / 2;
                        const data = chart.data.datasets[0].data;
                        const total = data.reduce((sum, value) => sum + value, 0);
                        
                        // วาดส่วน 3D ด้านข้าง
                        for (let i = 0; i < data.length; i++) {
                            const sliceAngle = (data[i] / total) * 2 * Math.PI;
                            const color = villageColors[i % villageColors.length];
                            const darkerColor = color.replace('0.8)', '0.6)').replace('rgba', 'rgba').replace(/,\s*0\.6\)/, ', 0.6)');
                            
                            // วาดด้านข้างของแต่ละส่วน
                            ctx.fillStyle = darkerColor;
                            ctx.beginPath();
                            ctx.moveTo(centerX, centerY);
                            ctx.arc(centerX, centerY, radius, currentAngle, currentAngle + sliceAngle);
                            ctx.lineTo(centerX, centerY + depth);
                            ctx.arc(centerX, centerY + depth, radius, currentAngle + sliceAngle, currentAngle, true);
                            ctx.closePath();
                            ctx.fill();
                            
                            // วาดขอบด้านข้าง
                            ctx.strokeStyle = darkerColor.replace('0.6)', '1)');
                            ctx.lineWidth = 1;
                            ctx.stroke();
                            
                            currentAngle += sliceAngle;
                        }
                        
                        ctx.restore();
                    }
                };

                // ลงทะเบียน plugin
                Chart.register(threeDPiePlugin);

                const villageWasteChart = new Chart(villageCtx, {
                    type: 'pie',
                    data: {
                        labels: villageLabels,
                        datasets: [{
                            data: villageQuantities,
                            backgroundColor: villageColors.slice(0, villageData.length),
                            borderColor: '#ffffff',
                            borderWidth: 3,
                            hoverOffset: 15,
                            hoverBorderWidth: 4,
                            // เพิ่ม gradient effect
                            backgroundColorHover: villageColors.slice(0, villageData.length).map(color => 
                                color.replace('0.8)', '1)')
                            )
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: {
                            padding: {
                                top: 20,
                                bottom: 30,
                                left: 20,
                                right: 20
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    boxWidth: 16,
                                    boxHeight: 16,
                                    padding: 15,
                                    font: { 
                                        size: 12,
                                        family: 'Arial, sans-serif'
                                    },
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    generateLabels: function(chart) {
                                        const data = chart.data;
                                        if (data.labels.length && data.datasets.length) {
                                            return data.labels.map((label, i) => {
                                                const dataset = data.datasets[0];
                                                const value = dataset.data[i];
                                                const total = dataset.data.reduce((sum, val) => sum + val, 0);
                                                const percentage = ((value / total) * 100).toFixed(1); // เปลี่ยนจาก Math.round เป็น toFixed(1)
                                                
                                                return {
                                                    text: `${label} (${percentage}%)`,
                                                    fillStyle: dataset.backgroundColor[i],
                                                    strokeStyle: dataset.borderColor,
                                                    lineWidth: dataset.borderWidth,
                                                    hidden: false,
                                                    index: i,
                                                    pointStyle: 'circle'
                                                };
                                            });
                                        }
                                        return [];
                                    }
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#ffffff',
                                bodyColor: '#ffffff',
                                borderColor: 'rgba(255, 255, 255, 0.2)',
                                borderWidth: 1,
                                cornerRadius: 10,
                                displayColors: true,
                                boxWidth: 15,
                                boxHeight: 15,
                                callbacks: {
                                    title: function(context) {
                                        return context[0].label || '';
                                    },
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0; // เปลี่ยนจาก Math.round เป็น toFixed(1)
                                        const villageInfo = villageData[context.dataIndex];
                                        const amount = villageInfo ? villageInfo.totalAmount : 0; // เอา Math.round() ออก
                                        const transactions = villageInfo ? villageInfo.transactionCount : 0;
                                        
                                        return [
                                            `ปริมาณ: ${value.toLocaleString()} กก. (${percentage}%)`,
                                            `มูลค่า: ฿${amount.toLocaleString()}`,
                                            `ธุรกรรม: ${transactions.toLocaleString()} ครั้ง`
                                        ];
                                    },
                                    labelColor: function(context) {
                                        return {
                                            borderColor: context.dataset.backgroundColor[context.dataIndex],
                                            backgroundColor: context.dataset.backgroundColor[context.dataIndex]
                                        };
                                    }
                                }
                            }
                        },
                        animation: {
                            animateRotate: true,
                            animateScale: true,
                            duration: 2000,
                            easing: 'easeOutBounce'
                        },
                        interaction: {
                            intersect: false,
                            mode: 'point'
                        },
                        onHover: (event, activeElements, chart) => {
                            event.native.target.style.cursor = activeElements.length > 0 ? 'pointer' : 'default';
                        },
                        onClick: (event, activeElements, chart) => {
                            if (activeElements.length > 0) {
                                const dataIndex = activeElements[0].index;
                                const villageInfo = villageData[dataIndex];
                                
                                // แสดง modal หรือ alert ข้อมูลเพิ่มเติม
                                Swal.fire({
                                    title: villageInfo.villageName || `หมู่บ้านที่ ${villageInfo.villageNumber}`,
                                    html: `
                                        <div class="text-left">
                                            <p><strong>ปริมาณขยะ:</strong> ${villageInfo.totalQuantity.toLocaleString()} กิโลกรัม</p>
                                            <p><strong>มูลค่ารวม:</strong> ฿${villageInfo.totalAmount.toLocaleString()}</p>
                                            <p><strong>จำนวนธุรกรรม:</strong> ${villageInfo.transactionCount.toLocaleString()} ครั้ง</p>
                                            <p><strong>ราคาเฉลี่ย:</strong> ฿${(villageInfo.totalAmount / villageInfo.totalQuantity).toFixed(2)} ต่อกก.</p>
                                        </div>
                                    `,
                                    icon: 'info',
                                    confirmButtonText: 'ตกลง',
                                    confirmButtonColor: villageColors[dataIndex].replace('0.8)', '1)')
                                });
                            }
                        }
                    },
                    plugins: [threeDPiePlugin]
                });

                // เพิ่ม animation เมื่อ hover
                villageCtx.addEventListener('mousemove', function(event) {
                    const points = villageWasteChart.getElementsAtEventForMode(event, 'nearest', { intersect: true }, true);
                    if (points.length) {
                        villageCtx.style.cursor = 'pointer';
                    } else {
                        villageCtx.style.cursor = 'default';
                    }
                });
            }

            // Price Trend Chart (ใช้โค้ดเดิม)
            const priceTrendCtx = document.getElementById('priceTrendChart');
            if (priceTrendCtx && priceTrends.length > 0) {
                const months = [];
                const datasets = [];
                
                // สร้างรายการเดือนที่ไม่ซ้ำ
                priceTrends.forEach(trend => {
                    trend.monthlyData.forEach(data => {
                        if (!months.includes(data.month)) {
                            months.push(data.month);
                        }
                    });
                });
                months.sort();

                // สร้าง datasets สำหรับแต่ละประเภทขยะ
                const trendColors = [
                    'rgba(54, 162, 235, 1)', 'rgba(75, 192, 192, 1)', 'rgba(255, 206, 86, 1)',
                    'rgba(255, 99, 132, 1)', 'rgba(153, 102, 255, 1)', 'rgba(255, 159, 64, 1)',
                    'rgba(199, 199, 199, 1)'
                ];

                priceTrends.slice(0, 5).forEach((trend, index) => {
                    const data = months.map(month => {
                        const monthData = trend.monthlyData.find(d => d.month === month);
                        return monthData ? Math.round(monthData.avgPrice * 100) / 100 : null;
                    });

                    datasets.push({
                        label: trend._id,
                        data: data,
                        borderColor: trendColors[index],
                        backgroundColor: trendColors[index].replace('1)', '0.1)'),
                        tension: 0.4,
                        fill: false,
                        pointBackgroundColor: trendColors[index],
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    });
                });

                new Chart(priceTrendCtx, {
                    type: 'line',
                    data: {
                        labels: months.map(month => {
                            const [year, monthNum] = month.split('-');
                            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
                                                'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                            return monthNames[parseInt(monthNum) - 1] + ' ' + year.slice(-2);
                        }),
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            y: {
                                beginAtZero: false,
                                title: {
                                    display: true,
                                    text: 'ราคา (บาท/กก.)',
                                    font: { size: 12 }
                                },
                                grid: { color: 'rgba(0, 0, 0, 0.1)' }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'เดือน',
                                    font: { size: 12 }
                                },
                                grid: { color: 'rgba(0, 0, 0, 0.1)' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 15,
                                    padding: 15,
                                    font: { size: 12 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.dataset.label || '';
                                        const value = context.raw || 0;
                                        return `${label}: ฿${value} ต่อกิโลกรัม`;
                                    }
                                },
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff'
                            }
                        },
                        animation: { duration: 2000, easing: 'easeOutQuart' }
                    }
                });
            }

            // Event listeners สำหรับ form filters
            const dateRangeSelect = document.getElementById('dateRange');
            const selectedDateInput = document.getElementById('selectedDate');

            // ฟังก์ชันสำหรับจัดการการเปลี่ยนแปลง filter
            function handleFilterChange() {
                selectedDateInput.addEventListener('change', function() {
                    if (this.value) {
                        dateRangeSelect.value = 'all';
                        dateRangeSelect.disabled = true;
                    } else {
                        dateRangeSelect.disabled = false;
                    }
                });

                dateRangeSelect.addEventListener('change', function() {
                    if (this.value !== 'all') {
                        selectedDateInput.value = '';
                        selectedDateInput.disabled = true;
                    } else {
                        selectedDateInput.disabled = false;
                    }
                });
            }

            handleFilterChange();

            // ตั้งค่าเริ่มต้นของ form
            const currentSelectedDate = selectedDateInput.value;
            const currentDateRange = dateRangeSelect.value;
            
            if (currentSelectedDate) {
                dateRangeSelect.disabled = true;
            } else if (currentDateRange !== 'all') {
                selectedDateInput.disabled = true;
            }

            // Animation สำหรับ cards เมื่อโหลดหน้า
            const cards = document.querySelectorAll('.hover\\:scale-105');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 150);
            });

            console.log('Dashboard with 3D charts initialized successfully');
        });

        // Utility functions
        function formatNumber(num) {
            return new Intl.NumberFormat('th-TH').format(num);
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('th-TH', { 
                style: 'currency', 
                currency: 'THB' 
            }).format(amount);
        }

        window.dashboardUtils = {
            formatNumber,
            formatCurrency
        };
    </script>

    <style>
            /* Custom CSS สำหรับ 3D Dashboard */
            .content {
                transition: margin-left 0.3s ease;
            }
            
            .hover\:scale-105:hover {
                transform: scale(1.05);
            }
            
            .animate-pulse {
                animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
            }
            
            @keyframes pulse {
                0%, 100% { opacity: 1; }
                50% { opacity: .5; }
            }
            
            /* 3D Chart container enhancement */
            canvas {
                max-height: 100% !important;
                transition: transform 0.3s ease;
            }
            
            canvas:hover {
                transform: perspective(1000px) rotateX(2deg) rotateY(2deg);
            }
            
            /* Chart container with shadow */
            .chart-container {
                position: relative;
                background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
                border-radius: 12px;
                box-shadow: 
                    0 10px 25px rgba(0, 0, 0, 0.1),
                    0 4px 10px rgba(0, 0, 0, 0.05),
                    inset 0 1px 0 rgba(255, 255, 255, 0.9);
                overflow: hidden;
            }
            
            .chart-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
                z-index: 1;
            }
            
            /* Enhanced card styling */
            .stat-card {
                position: relative;
                background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
                border-radius: 16px;
                box-shadow: 
                    0 8px 32px rgba(0, 0, 0, 0.1),
                    0 4px 16px rgba(0, 0, 0, 0.05);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                overflow: hidden;
            }
            
            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: var(--accent-color, linear-gradient(90deg, #667eea 0%, #764ba2 100%));
            }
            
            .stat-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 
                    0 20px 40px rgba(0, 0, 0, 0.15),
                    0 8px 24px rgba(0, 0, 0, 0.1);
            }
            
            /* Custom scrollbar */
            .overflow-x-auto::-webkit-scrollbar {
                height: 8px;
            }
            
            .overflow-x-auto::-webkit-scrollbar-track {
                background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 100%);
                border-radius: 4px;
            }
            
            .overflow-x-auto::-webkit-scrollbar-thumb {
                background: linear-gradient(90deg, #cbd5e1 0%, #94a3b8 100%);
                border-radius: 4px;
                transition: background 0.3s ease;
            }
            
            .overflow-x-auto::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(90deg, #94a3b8 0%, #64748b 100%);
            }
            
            /* Loading animation enhancement */
            .fa-spinner {
                animation: fa-spin 1s infinite linear;
            }
            
            @keyframes fa-spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            
            /* Filter form styling */
            .filter-form {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 12px;
                box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
            }
            
            /* Disabled input styling */
            input:disabled, select:disabled {
                background: linear-gradient(145deg, #f1f5f9 0%, #e2e8f0 100%);
                cursor: not-allowed;
                opacity: 0.7;
            }
            
            /* Filter badges with animation */
            .filter-badge {
                animation: slideInDown 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                background: linear-gradient(145deg, var(--badge-color, #3b82f6) 0%, var(--badge-color-dark, #1d4ed8) 100%);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            }
            
            @keyframes slideInDown {
                0% { 
                    opacity: 0; 
                    transform: translateY(-20px) scale(0.8);
                }
                100% { 
                    opacity: 1; 
                    transform: translateY(0) scale(1);
                }
            }
            
            /* Enhanced table hover effect */
            tbody tr {
                transition: all 0.3s ease;
            }
            
            tbody tr:hover {
                background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%);
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
                transform: translateX(4px);
            }
            
            /* Chart loading placeholder enhancement */
            .chart-placeholder {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                height: 320px;
                background: linear-gradient(145deg, #f9fafb 0%, #f1f5f9 100%);
                border-radius: 12px;
                border: 2px dashed #cbd5e1;
                animation: breathe 3s ease-in-out infinite;
            }
            
            @keyframes breathe {
                0%, 100% { opacity: 0.7; }
                50% { opacity: 1; }
            }
            
            /* Tooltip enhancement */
            .swal2-popup {
                border-radius: 16px !important;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2) !important;
            }
            
            /* Responsive enhancements */
            @media (max-width: 768px) {
                .stat-card:hover {
                    transform: scale(1.01);
                }
                
                canvas:hover {
                    transform: none;
                }
                
                .chart-container {
                    margin: 0 8px;
                }
            }
            
            @media (max-width: 640px) {
                .content {
                    padding: 0 12px;
                }
                
                .mx-4 {
                    margin-left: 0;
                    margin-right: 0;
                }
            }
            
            /* Progress bar animation */
            @keyframes progressBar {
                0% { width: 0%; }
                100% { width: 100%; }
            }
            
            .progress-bar {
                animation: progressBar 2s ease-out;
            }
    </style>
</body>
</html>