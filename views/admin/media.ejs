<!DOCTYPE html> 
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="style_admin/media.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <div class="screen" id="modal">
        <form class="add-media-form" action="/admin/mediaPost" method="POST">
            <div class="media-form-head">
                <h1>เพิ่มสื่อเนื้อหา</h1>
            </div>
            <div class="media-form-content">
                <div>ชื่อหัวข้อ</div>
                <input type="text" name="title" placeholder="ใส่ชื่อหัวข้อ ..." required>
                
                <div>URL คลิป YouTube</div>
                <input type="url" name="youtubeUrl" placeholder="ใส่ URL คลิป YouTube ..." required>
            </div>
            <div class="media-form-action">
                <button type="submit" class="submit">โพส</button>
                <span class="cancel" onclick="closeModal()">ปิด</span>
            </div>
        </form>
    </div>        

    <!-- Main content -->
    <div class="content">
        <div class="content-header">
            <h1>สื่อความรู้ (<%= media.length %> รายการ)</h1>
            <div class="add-media" onclick="openModal()">เพิ่มสื่อ</div>
        </div>
        <div class="card-container">
            <% if (media.length > 0) { %>
                <% media.forEach(amedia => { %>
                <!-- Card -->
                <div class="card">
                    <!-- ตรวจสอบว่ามี youtubeUrl แล้วแสดงคลิป -->
                    <% if (amedia.youtubeUrl) { %>
                        <div class="video-container">
                            <iframe src="https://www.youtube.com/embed/<%= amedia.youtubeUrl %>" 
                                frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>
                        </div>
                    <% } else { %>
                        <p>No video available</p>
                    <% } %>
                    <div class="card-content">
                        <p class="card-title"><%= amedia.title %></p>
                        <div class="flex justify-end">
                            <form action="/admin/mediaDelete/<%= amedia._id %>" method="POST" class="delete-form" onsubmit="return confirm('ยืนยันการลบสื่อความรู้นี้?')">
                                <div>
                                    <button type="button" class="edit-btn">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button type="submit" class="delete-btn">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                        
                    </div>
                </div>
                <% }) %>
                <% } else { %>
                    <p>There are no media to display ....</p>
                <% } %>
        </div>
    </div>
</body>

<%- include('../partials/adminPartials/adminFooter.ejs') %>
<script>
    const modal = document.getElementById('modal');

    function openModal() {
        modal.style.display = 'block';
    }

    function closeModal() {
        modal.style.display = 'none';
    }
</script>
</html>
