<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="style_admin/media.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>
    <!-- Modal for Adding/Editing Media -->
    <div class="screen z-[10]" id="modal" style="display: none;">
        <!-- <form class="add-media-form" action="/admin/mediaPost" method="POST" id="mediaForm"> -->
        <form class="mx-auto mt-[13em] w-1/2 bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform relative " action="/admin/mediaPost" method="POST" id="mediaForm">
                <h1 class="text-bold text-gray-600 text-2xl">เพิ่มสื่อเนื้อหา</h1>
                <hr class="my-2">
                <div class="text-bold text-gray-500 text-lg">ชื่อหัวข้อ</div>
                <input class="w-full p-2 border border-gray-200 rounded-lg" type="text" name="title" id="title" placeholder="ใส่ชื่อหัวข้อ ..." required>
                
                <div class="text-bold text-gray-500 text-lg mt-2">URL คลิป YouTube</div>
                <input class="w-full p-2 border border-gray-200 rounded-lg" type="url" name="youtubeUrl" id="youtubeUrl" placeholder="ใส่ URL คลิป YouTube ..." required>                
                <hr class="my-5">
            <div class="mt-2 flex justify-end">
                <span class="cancel px-2 py-1 text-white rounded mr-2" onclick="closeModal()">ยกเลิก</span>
                <button type="submit" class="submit px-2 py-1 text-white rounded">ยืนยัน</button>
            </div> 
        </form>
    </div>

    <!-- Main content -->
    <div class="content">
        <div class="flex items-center justfy-between">
            <h1 class="w-full">สื่อความรู้ (<%= media.length %>)</h1>
            <div class="search-container">
                <form action="/admin" method="GET" class="search-form">
                    <input type="text" name="search" value="<%= searchQuery %>" placeholder="ค้นหาสื่อ" class="search-input">
                    <button type="submit" class="main-bg-color search-button">ค้นหา</button>
                </form>
                <button class="main-bg-color px-3 py-2 ml-2 text-white rounded" onclick="openModal()">เพิ่มสื่อ</button>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 mt-6">
            <% if (media.length > 0) { %>
                <% media.forEach((amedia ,index)=> { %>
            <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform hover:scale-105 relative">
                <% if (amedia.youtubeUrl && amedia.youtubeUrl.includes('v=')) { %>
                    <iframe class="w-full h-[200px]"
                        src="<%= 'https://www.youtube.com/embed/' + amedia.youtubeUrl.split('v=')[1].split('&')[0] %>"
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                    </iframe>
                <% } else { %>
                    <p>No video available</p>
                <% } %>
                <h2 class="text-lg font-medium mt-2 h-[100px] overflow-hidden"><%= amedia.title %></h2>
                <p class="text-gray-400 text-xs mt-1">วันที่ <%= amedia.formattedDate %></p>
                <div class="flex flex-auto items-center justify-end">
                    <button type="button" class="edit-btn" onclick="openEditModal('<%= amedia._id %>', '<%= amedia.title %>', '<%= amedia.youtubeUrl %>')">
                        <i class="fa fa-edit"></i>
                    </button>  
                    <button onclick="deleteMedia('<%= amedia._id %>', '<%= amedia.title %>')" class="delete-btn">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </div>
                <% }) %>
            <% } else { %>
                <div class="mt-3 no-data-container">
                    <span>- ยังไม่มีข้อมูล -</span>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = '/admin/mediaPost';

        // สำหรับเพิ่มสื่อ
        function openModal() {
            modal.style.display = 'block';
            formAction = '/admin/mediaPost'
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = '';
            document.getElementById('youtubeUrl').value = '';
        }

        // สำหรับแก้ไขสื่อ
        function openEditModal(id, title, youtubeUrl) {
            modal.style.display = 'block';
            formAction = '/admin/mediaEdit/' + id;
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('youtubeUrl').value = youtubeUrl;
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        function deleteMedia(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/mediaDelete/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }
    </script>
</body>
