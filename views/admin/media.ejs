<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="style_admin/media.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">สื่อความรู้ <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= media.length %> รายการ)</span></h1>
                <p class="text-gray-600">สื่อความรู้ทั้งหมดของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="openModal()">เพิ่มสื่อความรู้</button>
            </div>
        </div>

        <!-- Input ค้นหา -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                <div class="relative">
                    <input type="text" id="searchInput" placeholder="ค้นหาสื่อความรู้" 
                    class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                    <div class="absolute left-3 top-2.5 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    </div>
                </div>
                </div>
            </div>
        </div>
        <!-- Container แสดงรายการ -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
        <h2 class="text-base font-semibold text-gray-800 mb-4">
            สื่อความรู้ <span class="text-blue-600 text-base font-normal" id="totalItems"></span>
        </h2>

        <div id="mediaContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        <div id="noResults" class="hidden text-center py-10 text-gray-500">ไม่พบสื่อที่ค้นหา</div>
        </div>

        <!-- Pagination -->
        <div class="flex justify-center space-x-2 mt-4" id="pagination"></div>

    </div>


    
    <!-- Modal for Adding/Editing Media -->
    <div id="modal" class="fixed top-0 left-0 w-full h-full z-50 bg-black bg-opacity-30 hidden">
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
            <form action="/admin/mediaPost" method="POST"
                class="bg-white rounded-xl shadow-lg p-6 space-y-5" id="mediaForm">

                <!-- หัวฟอร์ม -->
                <div class="flex items-center space-x-3 border-b pb-3">
                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                    <span class="text-xl font-semibold text-gray-800">เพิ่มสื่อเนื้อหา</span>
                </div>

                <!-- ชื่อหัวข้อ -->
                <div>
                    <label for="title" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหัวข้อ</label>
                    <input type="text" name="title" id="title" placeholder="ใส่ชื่อหัวข้อ ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                </div>

                <!-- YouTube URL -->
                <div>
                    <label for="youtubeUrl" class="block text-sm font-medium text-gray-700 mb-1">URL คลิป YouTube</label>
                    <input type="url" name="youtubeUrl" id="youtubeUrl" placeholder="ใส่ URL คลิป YouTube ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500" />
                </div>

                <!-- ปุ่ม -->
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeModal()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                    <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">ยืนยัน</button>
                </div>

            </form>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = '/admin/mediaPost';

        // ✅ ฟังก์ชันเปิด Modal สำหรับ "เพิ่ม" สื่อ
        function openModal() {
            modal.classList.remove('hidden');
            formAction = '/admin/mediaPost';
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = '';
            document.getElementById('youtubeUrl').value = '';
        }

        // ✅ ฟังก์ชันเปิด Modal สำหรับ "แก้ไข" สื่อ
        function openEditModal(id, title, youtubeUrl) {
            modal.classList.remove('hidden');
            formAction = '/admin/mediaEdit/' + id;
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('youtubeUrl').value = youtubeUrl;
        }

        // ✅ ฟังก์ชันปิด Modal
        function closeModal() {
            modal.classList.add('hidden');
            document.getElementById('mediaForm').reset();
        }

        function deleteMedia(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/mediaDelete/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }
        const mediaData = <%- JSON.stringify(media.filter(m => !m.isDeleted)) %>;

        const mediaContainer = document.getElementById('mediaContainer');
        const pagination = document.getElementById('pagination');
        const searchInput = document.getElementById('searchInput');
        const totalItems = document.getElementById('totalItems');
        const noResults = document.getElementById('noResults');

        let currentPage = 1;
        let itemsPerPage = 6; 
        let filteredData = [...mediaData];

        // ฟังก์ชัน format วันที่
        function formatDate(isoString) {
            const d = new Date(isoString);
            return d.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        // Template card
        function createCard(item) {
            const youtubeId = item.youtubeUrl && item.youtubeUrl.includes('v=') 
            ? item.youtubeUrl.split('v=')[1].split('&')[0]
            : null;

            return `
            <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group">
                <div class="relative overflow-hidden">
                ${youtubeId ? `
                    <div class="aspect-video bg-gray-900">
                    <iframe class="w-full h-full" src="https://www.youtube.com/embed/${youtubeId}" 
                        frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen>
                    </iframe>
                    </div>
                ` : `
                    <div class="aspect-video bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                    <p class="text-sm text-gray-500">ไม่มีวิดีโอ</p>
                    </div>
                `}
                </div>
                <div class="p-5">
                <h3 class="text-lg font-semibold text-gray-800 mb-3 line-clamp-2 leading-tight">${item.title}</h3>
                <p class="text-xs text-gray-400">วันที่เพิ่ม ${formatDate(item.createdAt)}</p>
                <div class="flex items-center space-x-1 text-red-600">
                    <button type="button" class="edit-btn" onclick="openEditModal('${item._id}', '${item.title}', '${item.youtubeUrl || ''}')">
                        <i class="fa fa-edit"></i>
                    </button> 
                    <button class="delete-btn" onclick="deleteMedia('${item._id}', '${item.title}')">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
                </div>
            </div>
            `;
        }

        // แสดงข้อมูลตามหน้า
        function displayData() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const dataToShow = filteredData.slice(start, end);

            totalItems.textContent = `${filteredData.length} รายการ`;

            if (dataToShow.length === 0) {
            mediaContainer.innerHTML = '';
            noResults.classList.remove('hidden');
            pagination.innerHTML = '';
            return;
            }

            noResults.classList.add('hidden');
            mediaContainer.innerHTML = dataToShow.map(createCard).join('');
            renderPagination();
        }
        
        // Pagination
        function renderPagination() {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            if (totalPages <= 1) return pagination.innerHTML = '';

            let html = '';
            for (let i = 1; i <= totalPages; i++) {
            html += `<button onclick="goToPage(${i})" 
                class="px-3 py-1 border rounded ${i === currentPage ? 'bg-green-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'}">${i}</button>`;
            }
            pagination.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            displayData();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ค้นหา
        searchInput.addEventListener('input', () => {
            const term = searchInput.value.toLowerCase();
            filteredData = mediaData.filter(m => 
            m.title.toLowerCase().includes(term) ||
            (m.createdAt && formatDate(m.createdAt).toLowerCase().includes(term))
            );
            currentPage = 1;
            displayData();
        });

        displayData();
    </script>
</body>
