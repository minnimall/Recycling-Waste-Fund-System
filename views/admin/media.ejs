<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="style_admin/media.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>
    <!-- Modal for Adding/Editing Media -->
    <div class="screen" id="modal" style="display: none;">
        <form class="add-media-form" action="/admin/mediaPost" method="POST" id="mediaForm">
            <div class="media-form-head">
                <h1>เพิ่มสื่อเนื้อหา</h1>
            </div>
            <div class="media-form-content">
                <div>ชื่อหัวข้อ</div>
                <input type="text" name="title" id="title" placeholder="ใส่ชื่อหัวข้อ ..." required>
                
                <div>URL คลิป YouTube</div>
                <input type="url" name="youtubeUrl" id="youtubeUrl" placeholder="ใส่ URL คลิป YouTube ..." required>
            </div>
            <div class="media-form-action">
                <span class="cancel" onclick="closeModal()">ปิด</span>
                <button type="submit" class="submit">โพส</button>
            </div>
        </form>
    </div>

    <!-- Main content -->
    <div class="content">
        <div class="content-header">
            <h1>สื่อความรู้ (<%= media.length %> รายการ)</h1>
            <div class="add-media" onclick="openModal()">เพิ่มสื่อ</div>
        </div>
        <div class="card-container">
            <% if (media.length > 0) { %>
                <% media.forEach((amedia ,index)=> { %>
                <!-- Card -->
                <div class="card">
                    <!-- ตรวจสอบว่ามี youtubeUrl แล้วแสดงคลิป -->
                    <div class="video-container">
                        <% if (amedia.youtubeUrl && amedia.youtubeUrl.includes('v=')) { %>
                            <iframe 
                                src="<%= 'https://www.youtube.com/embed/' + amedia.youtubeUrl.split('v=')[1].split('&')[0] %>"
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen>
                            </iframe>
                        <% } else { %>
                            <p>No video available</p>
                        <% } %>
                    </div>
                    <div class="card-content">
                        <p class="card-title"><%= amedia.title %></p>
                        <div class="flex justify-end">
                            <button type="button" class="edit-btn" onclick="openEditModal('<%= amedia._id %>', '<%= amedia.title %>', '<%= amedia.youtubeUrl %>')">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button
                                onclick="deleteMedia(['<%= index + 1 %>', '<%= amedia._id %>'])"
                                class="delete-btn">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <p>There are no media to display ....</p>
            <% } %>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = '/admin/mediaPost';

        // สำหรับเพิ่มสื่อ
        function openModal() {
            modal.style.display = 'block';
            formAction = '/admin/mediaPost'
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = '';
            document.getElementById('youtubeUrl').value = '';
        }

        // สำหรับแก้ไขสื่อ
        function openEditModal(id, title, youtubeUrl) {
            modal.style.display = 'block';
            formAction = '/admin/mediaEdit/' + id;
            document.getElementById('mediaForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('youtubeUrl').value = youtubeUrl;
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        function deleteMedia(data) {
            Swal.fire({
                title: `ลบข้อมูลลำดับที่ ${data[0]} หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/mediaDelete/' + data[1], {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลสื่อความรู้ถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>
</body>
</html>
