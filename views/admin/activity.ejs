<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/activity.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: successMessage, showConfirmButton: false, timer: 3000 });
        }
        if (errorMessage) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: errorMessage, showConfirmButton: false, timer: 3000 });
        }
    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                    กิจกรรม <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= activity.length %> รายการ)</span>
                </h1>
                <p class="text-gray-600">กิจกรรมของกองทุนขยะรีไซเคิล</p>
            </div>
            <div>
                <button type="button"
                    class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300"
                    onclick="openAddModal()">เพิ่มกิจกรรม</button>
            </div>
        </div>

        <!-- Search + ItemsPerPage -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex-1 relative w-full">
                <input type="text" id="searchInput" placeholder="ค้นหากิจกรรม..."
                    class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                <div class="absolute left-3 top-2.5 text-gray-400">
                    <i class="fas fa-search"></i>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <label for="itemsPerPage" class="text-sm text-gray-600">แสดง:</label>
                <select id="itemsPerPage" class="border rounded-lg px-2 py-1 focus:ring-2 focus:ring-green-500">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>

        <!-- Container -->
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800">
                    กิจกรรม <span id="totalItems" class="text-blue-600 text-base font-normal"></span>
                </h2>
            </div>
            <div id="cardsContainer" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6"></div>
            <div id="noResults" class="hidden text-center py-8 text-gray-500">- ไม่พบข้อมูล -</div>
            <div id="pagination" class="flex justify-center mt-6 gap-2"></div>
        </div>
    </div>


    <!-- modal เพิ่มกิจกรรม -->
    <div id="addModal" class="fixed inset-0 z-50 bg-black bg-opacity-30 hidden overflow-y-auto">
        <div class="min-h-screen flex items-center justify-center px-4 py-8">
            <form id="addActivityForm" action="/admin/activityPost" method="POST" enctype="multipart/form-data"
                class="bg-white rounded-xl shadow-lg p-6 space-y-5 w-full max-w-2xl">

                <!-- หัวฟอร์ม -->
                <div class="flex items-center space-x-3 border-b pb-3">
                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                    <span class="text-xl font-semibold text-gray-800">เพิ่มกิจกรรม</span>
                </div>

                <!-- ชื่อหัวข้อ -->
                <div>
                    <label for="addTitle" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหัวข้อ <span class="text-red-500">*</span></label>
                    <input type="text" name="title" id="addTitle" placeholder="ใส่ชื่อหัวข้อ ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                </div>

                <!-- เนื้อหา -->
                <div>
                    <label for="addContent" class="block text-sm font-medium text-gray-700 mb-1">เนื้อหา <span class="text-red-500">*</span></label>
                    <textarea name="content" id="addContent" rows="6" placeholder="ใส่เนื้อหา ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500"></textarea>
                </div>

                <!-- รูปภาพ -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพกิจกรรม</label>
                    <input type="file" name="img" id="addImg" accept="image/png, image/gif, image/jpeg" class="hidden" multiple>

                    <!-- Upload Zone -->
                    <div id="addUploadZone"
                        class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                        <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                        <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                        <p class="text-xs text-gray-500">PNG, JPG, GIF (ไม่เกิน 5MB ต่อรูป)</p>
                    </div>

                    <!-- Image Preview -->
                    <div id="addImagePreview" class="hidden">
                        <!-- ปุ่มเพิ่มรูป -->
                        <button type="button" id="addMoreBtn"
                            class="w-full mb-2 py-2 border-2 border-dashed border-gray-300 rounded-lg text-gray-500 hover:border-blue-400 hover:text-blue-500 transition flex items-center justify-center gap-2">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>เพิ่มรูปภาพ</span>
                        </button>
                        <!-- Grid รูป -->
                        <div id="addPreviewGrid" class="grid grid-cols-3 gap-2"></div>
                    </div>
                </div>

                <!-- ปุ่ม -->
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeAddModal()"
                        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                    <button type="submit"
                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">เพิ่มกิจกรรม</button>
                </div>
            </form>
        </div>
    </div>


    <!-- ==================== MODAL แก้ไขกิจกรรม ==================== -->
    <div id="editModal" class="fixed inset-0 z-50 bg-black bg-opacity-30 hidden overflow-y-auto">
        <div class="min-h-screen flex items-center justify-center px-4 py-8">
            <form id="editActivityForm" action="" method="POST" enctype="multipart/form-data"
                class="bg-white rounded-xl shadow-lg p-6 space-y-5 w-full max-w-2xl">

                <!-- หัวฟอร์ม -->
                <div class="flex items-center space-x-3 border-b pb-3">
                    <ion-icon name="create-outline" class="text-blue-500 text-2xl"></ion-icon>
                    <span class="text-xl font-semibold text-gray-800">แก้ไขกิจกรรม</span>
                </div>

                <!-- ชื่อหัวข้อ -->
                <div>
                    <label for="editTitle" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหัวข้อ <span class="text-red-500">*</span></label>
                    <input type="text" name="title" id="editTitle" placeholder="ใส่ชื่อหัวข้อ ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                </div>

                <!-- เนื้อหา -->
                <div>
                    <label for="editContent" class="block text-sm font-medium text-gray-700 mb-1">เนื้อหา <span class="text-red-500">*</span></label>
                    <textarea name="content" id="editContent" rows="6" placeholder="ใส่เนื้อหา ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500"></textarea>
                </div>

                <!-- รูปภาพ -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพกิจกรรม</label>
                    <p class="text-xs text-gray-400 mb-2">* หากเลือกรูปใหม่จะแทนที่รูปเดิมทั้งหมด</p>
                    <input type="file" name="img" id="editImg" accept="image/png, image/gif, image/jpeg" class="hidden" multiple>

                    <!-- Upload Zone -->
                    <div id="editUploadZone"
                        class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                        <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                        <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพใหม่</p>
                        <p class="text-xs text-gray-500">PNG, JPG, GIF (ไม่เกิน 5MB ต่อรูป)</p>
                    </div>

                    <!-- Image Preview -->
                    <div id="editImagePreview" class="hidden">
                        <!-- ปุ่มเพิ่มรูป -->
                        <button type="button" id="editAddMoreBtn"
                            class="w-full mb-2 py-2 border-2 border-dashed border-gray-300 rounded-lg text-gray-500 hover:border-blue-400 hover:text-blue-500 transition flex items-center justify-center gap-2">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>เพิ่มรูปภาพ</span>
                        </button>
                        <!-- Grid รูป -->
                        <div id="editPreviewGrid" class="grid grid-cols-3 gap-2"></div>
                    </div>
                </div>

                <!-- ปุ่ม -->
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeEditModal()"
                        class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                    <button type="submit"
                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">บันทึกการแก้ไข</button>
                </div>
            </form>
        </div>
    </div>


    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        // ==================== ADD MODAL ====================
        const addModal       = document.getElementById('addModal');
        const addFileInput   = document.getElementById('addImg');
        const addUploadZone  = document.getElementById('addUploadZone');
        const addImgPreview  = document.getElementById('addImagePreview');
        const addPreviewGrid = document.getElementById('addPreviewGrid');
        const addMoreBtn     = document.getElementById('addMoreBtn');

        addUploadZone.addEventListener('click', () => addFileInput.click());
        addMoreBtn.addEventListener('click', () => addFileInput.click());

        addFileInput.addEventListener('change', function(e) {
            handleFileSelect(e.target.files, addPreviewGrid, addUploadZone, addImgPreview, addFileInput, addFileStore);
        });

        function openAddModal() {
            resetImageArea(addFileInput, addUploadZone, addImgPreview, addPreviewGrid, addFileStore);
            document.getElementById('addActivityForm').reset();
            addModal.classList.remove('hidden');
        }

        function closeAddModal() {
            addModal.classList.add('hidden');
            document.getElementById('addActivityForm').reset();
            resetImageArea(addFileInput, addUploadZone, addImgPreview, addPreviewGrid, addFileStore);
        }


        // ==================== EDIT MODAL ====================
        const editModal       = document.getElementById('editModal');
        const editFileInput   = document.getElementById('editImg');
        const editUploadZone  = document.getElementById('editUploadZone');
        const editImgPreview  = document.getElementById('editImagePreview');
        const editPreviewGrid = document.getElementById('editPreviewGrid');
        const editAddMoreBtn  = document.getElementById('editAddMoreBtn');

        editUploadZone.addEventListener('click', () => editFileInput.click());
        editAddMoreBtn.addEventListener('click', () => editFileInput.click());

        editFileInput.addEventListener('change', function(e) {
            handleFileSelect(e.target.files, editPreviewGrid, editUploadZone, editImgPreview, editFileInput, editFileStore);
        });

        function openEditModal(id, title, content, imgs) {
            document.getElementById('editActivityForm').setAttribute('action', '/admin/activityEdit/' + id);
            document.getElementById('editTitle').value = title;
            document.getElementById('editContent').value = content;

            // แสดงรูปเดิม
            resetImageArea(editFileInput, editUploadZone, editImgPreview, editPreviewGrid, editFileStore);
            const imgArray = Array.isArray(imgs) ? imgs : (imgs ? [imgs] : []);
            if (imgArray.length > 0) {
                imgArray.forEach(url => {
                    if (url && url !== 'null' && url !== '') {
                        appendExistingImage(url, editPreviewGrid, editUploadZone, editImgPreview);
                    }
                });
            }

            editModal.classList.remove('hidden');
        }

        function closeEditModal() {
            editModal.classList.add('hidden');
            document.getElementById('editActivityForm').reset();
            resetImageArea(editFileInput, editUploadZone, editImgPreview, editPreviewGrid, editFileStore);
        }


        // ==================== SHARED FUNCTIONS ====================

        // เพิ่มตัวแปร DataTransfer สำหรับแต่ละ modal
        const addFileStore  = { current: new DataTransfer() };
        const editFileStore = { current: new DataTransfer() };

        // ตรวจสอบและแสดง preview ไฟล์ที่เลือก
        function handleFileSelect(fileList, previewGrid, uploadZone, imgPreview, fileInput, fileStore) {
            const files = Array.from(fileList);
            if (files.length === 0) return;

            const validTypes = ['image/png', 'image/jpeg', 'image/gif'];

            for (const file of files) {
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({ icon: 'error', title: 'ไฟล์ใหญ่เกินไป', text: `"${file.name}" มีขนาดเกิน 5MB` });
                    return;
                }
                if (!validTypes.includes(file.type)) {
                    Swal.fire({ icon: 'error', title: 'ประเภทไฟล์ไม่ถูกต้อง', text: `"${file.name}" ไม่ใช่ PNG, JPG หรือ GIF` });
                    return;
                }
            }

            files.forEach(file => {
                fileStore.current.items.add(file);

                const reader = new FileReader();
                reader.onload = function(event) {
                    appendPreviewImage(event.target.result, file.name, previewGrid, uploadZone, imgPreview, fileStore, fileInput);
                };
                reader.readAsDataURL(file);
            });

            fileInput.files = fileStore.current.files;

            uploadZone.classList.add('hidden');
            imgPreview.classList.remove('hidden');
        }

        // สร้าง element รูป preview (จากไฟล์ที่เลือก)
        function appendPreviewImage(src, altText, previewGrid, uploadZone, imgPreview, fileStore, fileInput) {
            const wrapper = document.createElement('div');
            wrapper.className = 'relative group';

            const img = document.createElement('img');
            img.src = src;
            img.alt = altText || 'preview';
            img.className = 'w-full h-32 object-cover rounded-lg border-2 border-gray-300 bg-gray-50';

            const deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 text-xs opacity-0 group-hover:opacity-100 transition flex items-center justify-center';
            deleteBtn.innerHTML = '✕';
            deleteBtn.addEventListener('click', () => {
                const newStore = new DataTransfer();
                Array.from(fileStore.current.files).forEach(f => {
                    if (f.name !== altText) newStore.items.add(f);
                });
                fileStore.current = newStore;
                fileInput.files = fileStore.current.files;

                wrapper.remove();
                if (previewGrid.children.length === 0) {
                    imgPreview.classList.add('hidden');
                    uploadZone.classList.remove('hidden');
                }
            });

            wrapper.appendChild(img);
            wrapper.appendChild(deleteBtn);
            previewGrid.appendChild(wrapper);
        }

        // แสดงรูปเดิม (จาก URL Cloudinary) ใน edit modal
        function appendExistingImage(url, previewGrid, uploadZone, imgPreview) {
            const wrapper = document.createElement('div');
            wrapper.className = 'relative group';

            const img = document.createElement('img');
            img.src = url;
            img.alt = 'existing image';
            img.className = 'w-full h-32 object-cover rounded-lg border-2 border-blue-300 bg-gray-50';

            // badge "รูปเดิม"
            const badge = document.createElement('span');
            badge.className = 'absolute bottom-1 left-1 bg-blue-500 text-white text-xs px-1.5 py-0.5 rounded';
            badge.textContent = 'รูปเดิม';

            wrapper.appendChild(img);
            wrapper.appendChild(badge);
            previewGrid.appendChild(wrapper);

            uploadZone.classList.add('hidden');
            imgPreview.classList.remove('hidden');
        }

        // รีเซ็ต image area
        function resetImageArea(fileInput, uploadZone, imgPreview, previewGrid, fileStore) {
            fileStore.current = new DataTransfer();
            fileInput.files = fileStore.current.files;
            previewGrid.innerHTML = '';
            uploadZone.classList.remove('hidden');
            imgPreview.classList.add('hidden');
        }
        // อัปเดตทุกที่ที่เรียก resetImageArea
        resetImageArea(addFileInput, addUploadZone, addImgPreview, addPreviewGrid, addFileStore);
        resetImageArea(editFileInput, editUploadZone, editImgPreview, editPreviewGrid, editFileStore);


        // ==================== DELETE ====================
        function deleteActivity(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/deleteActivity/' + id, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                    })
                    .then(res => {
                        if (res.ok) {
                            Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('ลบข้อมูลไม่สำเร็จ', 'กรุณาลองใหม่อีกครั้ง', 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }


        // ==================== CARDS + PAGINATION ====================
        const allActivity       = <%- JSON.stringify(activity) %>;
        const searchInput       = document.getElementById("searchInput");
        const itemsPerPageSelect= document.getElementById("itemsPerPage");
        const cardsContainer    = document.getElementById("cardsContainer");
        const pagination        = document.getElementById("pagination");
        const noResults         = document.getElementById("noResults");
        const totalItems        = document.getElementById("totalItems");

        let currentPage  = 1;
        let itemsPerPage = parseInt(itemsPerPageSelect.value);
        let filteredData = [...allActivity];

        function createCard(act) {
            const images = Array.isArray(act.img) ? act.img : (act.img ? [act.img] : []);
            const imgHtml = images.length > 0
                ? images.map(url => `<img src="${url}" class="w-full h-[150px] object-cover rounded mb-1">`).join('')
                : `<div class="w-full h-[150px] bg-gray-200 rounded mb-1 flex items-center justify-center text-gray-400 text-sm">ไม่มีรูปภาพ</div>`;

            // ส่ง array imgs ไปให้ openEditModal
            const imgsJson = JSON.stringify(images).replace(/'/g, "\\'").replace(/"/g, '&quot;');

            return `
                <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform hover:scale-105 relative">
                    ${imgHtml}
                    <h2 class="text-lg font-medium mt-2 h-[100px] overflow-hidden">${act.title}</h2>
                    <p class="text-gray-400 text-xs mt-1">วันที่เพิ่ม ${formatDate(act.createdAt)}</p>
                    <div class="flex flex-auto items-center justify-end">
                        <button class="edit-btn" onclick='openEditModal("${act._id}", "${act.title.replace(/"/g,"&quot;")}", "${act.content.replace(/"/g,"&quot;")}", ${JSON.stringify(images)})'>
                            <i class="fa fa-edit"></i>
                        </button>
                        <button onclick="deleteActivity('${act._id}', '${act.title.replace(/'/g, "\\'")}')" class="delete-btn">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        function formatDate(dateStr) {
            const d = new Date(dateStr);
            return d.toLocaleDateString("th-TH", { year: "numeric", month: "short", day: "numeric" });
        }

        function displayData() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const dataToShow = filteredData.slice(start, end);
            totalItems.textContent = `${filteredData.length} รายการ`;

            if (dataToShow.length === 0) {
                noResults.classList.remove("hidden");
                cardsContainer.innerHTML = "";
                pagination.innerHTML = "";
                return;
            }
            noResults.classList.add("hidden");
            cardsContainer.innerHTML = dataToShow.map(createCard).join("");
            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredData.length / itemsPerPage);
            if (totalPages <= 1) { pagination.innerHTML = ""; return; }
            let html = "";
            for (let i = 1; i <= totalPages; i++) {
                html += `<button onclick="goToPage(${i})" 
                            class="px-3 py-1 border rounded ${i === currentPage ? 'bg-green-600 text-white' : 'bg-white text-gray-700'}">
                            ${i}
                        </button>`;
            }
            pagination.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            displayData();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        searchInput.addEventListener("input", () => {
            const term = searchInput.value.toLowerCase();
            filteredData = allActivity.filter(act =>
                act.title.toLowerCase().includes(term) ||
                (act.content && act.content.toLowerCase().includes(term))
            );
            currentPage = 1;
            displayData();
        });

        itemsPerPageSelect.addEventListener("change", () => {
            itemsPerPage = parseInt(itemsPerPageSelect.value);
            currentPage = 1;
            displayData();
        });

        displayData();
    </script>
</body>
</html>
