<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/activity.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">กิจกรรม <span class="text-blue-600 text-xl ml-2 font-normal">(ทั้งหมด <%= activity.length %> รายการ)</span></h1>
                <p class="text-gray-600">กิจกรรมของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="openModal()">เพิ่มกิจกรรม</button>
            </div>
        </div>

    <!-- Search + ItemsPerPage -->
    <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex-1 relative w-full">
            <input type="text" id="searchInput" placeholder="ค้นหากิจกรรม..." 
                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
            <div class="absolute left-3 top-2.5 text-gray-400">
                <i class="fas fa-search"></i>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <label for="itemsPerPage" class="text-sm text-gray-600">แสดง:</label>
            <select id="itemsPerPage" class="border rounded-lg px-2 py-1 focus:ring-2 focus:ring-green-500">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
            </select>
        </div>
    </div>

    <!-- Container -->
    <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
        <div class="mb-4 border-b border-gray-200 pb-4">
            <h2 class="text-base font-semibold text-gray-800">
                สื่อความรู้ <span id="totalItems" class="text-blue-600 text-base font-normal"></span>
            </h2>
        </div>

        <div id="cardsContainer" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6"></div>

        <!-- No results -->
        <div id="noResults" class="hidden text-center py-8 text-gray-500">
            - ไม่พบข้อมูล -
        </div>

        <!-- Pagination -->
        <div id="pagination" class="flex justify-center mt-6 gap-2"></div>
    </div>

    </div>

    <!-- Modal สำหรับแก้ไขกิจกรรม -->
    <div id="modal" class="fixed inset-0 z-50 bg-black bg-opacity-30 hidden">
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl px-4">
            <form id="activityForm" action="/admin/activityPost" method="POST" enctype="multipart/form-data"
                class="bg-white rounded-xl shadow-lg p-6 space-y-5">

                <!-- หัวฟอร์ม -->
                <div class="flex items-center space-x-3 border-b pb-3">
                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl"></ion-icon>
                    <span class="text-xl font-semibold text-gray-800">จัดการกิจกรรม</span>
                </div>

                <!-- ชื่อหัวข้อ -->
                <div>
                    <label for="title" class="block text-sm font-medium text-gray-700 mb-1">ชื่อหัวข้อ</label>
                    <input type="text" name="title" id="title" placeholder="ใส่ชื่อหัวข้อ ..." required
                        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500">
                </div>

                <!-- เนื้อหา -->
                <div>
                    <label for="content" class="block text-sm font-medium text-gray-700 mb-1">เนื้อหา</label>
                    <textarea name="content" id="content" rows="6" placeholder="ใส่เนื้อหา ..." required
                            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-blue-500"></textarea>
                </div>

                <!-- รูปภาพ -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">รูปภาพกิจกรรม</label>
                    
                    <!-- Preview Area -->
                    <div class="relative">
                        <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" class="hidden">
                        
                        <!-- Upload Zone (แสดงเมื่อยังไม่มีรูป) -->
                        <div id="uploadZone" 
                            class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:bg-gray-100 hover:border-gray-400 transition-all cursor-pointer">
                            <ion-icon name="cloud-upload-outline" class="text-gray-400 text-4xl mb-3"></ion-icon>
                            <p class="text-sm text-gray-600 mb-1 font-medium">คลิกเพื่อเลือกรูปภาพ</p>
                            <p class="text-xs text-gray-500">PNG, JPG (ไม่เกิน 10 MB)</p>
                        </div>
                        
                        <!-- Image Preview (แสดงเมื่อมีรูป) -->
                        <div id="imagePreview" class="hidden">
                            <div class="relative group">
                                <img id="previewImg" src="/placeholder.svg" alt="Preview" 
                                    class="w-full h-64 object-contain rounded-lg border-2 border-gray-300 bg-gray-50">
                                
                                <!-- Overlay with Change Button -->
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                    <button type="button" id="changeImageBtn"
                                        class="opacity-0 group-hover:opacity-100 transition-opacity bg-white text-gray-700 px-4 py-2 rounded-lg font-medium shadow-lg hover:bg-gray-100 flex items-center gap-2">
                                        <ion-icon name="camera-outline"></ion-icon>
                                        <span>เปลี่ยนรูปภาพ</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ปุ่ม -->
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeModal()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">ยกเลิก</button>
                    <button type="submit"
                            class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">ยืนยัน</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = "/admin/activityPost";

        // ==================== Image Preview System ====================
        const fileInput = document.getElementById('img');
        const uploadZone = document.getElementById('uploadZone');
        const imagePreview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const changeImageBtn = document.getElementById('changeImageBtn');

        // คลิกที่ Upload Zone เพื่อเลือกไฟล์
        uploadZone.addEventListener('click', () => {
            fileInput.click();
        });

        // คลิกปุ่ม "เปลี่ยนรูปภาพ" เพื่อเลือกไฟล์ใหม่
        changeImageBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.click();
        });

        // เมื่อเลือกไฟล์
        fileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            
            if (file) {
                // ตรวจสอบขนาดไฟล์ (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ไฟล์ใหญ่เกินไป',
                        text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                        confirmButtonColor: '#3085d6'
                    });
                    fileInput.value = '';
                    return;
                }
                
                // ตรวจสอบประเภทไฟล์
                const validTypes = ['image/png', 'image/jpeg', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ประเภทไฟล์ไม่ถูกต้อง',
                        text: 'กรุณาเลือกไฟล์ PNG, JPG หรือ GIF เท่านั้น',
                        confirmButtonColor: '#3085d6'
                    });
                    fileInput.value = '';
                    return;
                }
                
                // อ่านไฟล์และแสดงรูป
                const reader = new FileReader();
                reader.onload = function(event) {
                    previewImg.src = event.target.result;
                    uploadZone.classList.add('hidden');
                    imagePreview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        // ฟังก์ชันสำหรับตั้งค่ารูปภาพ
        function setExistingImage(imageUrl) {
            if (imageUrl && imageUrl !== '' && imageUrl !== '/placeholder.svg') {
                previewImg.src = imageUrl;
                uploadZone.classList.add('hidden');
                imagePreview.classList.remove('hidden');
            } else {
                previewImg.src = '/placeholder.svg';
                uploadZone.classList.remove('hidden');
                imagePreview.classList.add('hidden');
            }
        }

        function openModal() {
            modal.classList.remove('hidden');
            formAction = "/admin/activityPost";
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('activityForm').reset();

            // รีเซ็ตการแสดงรูปภาพ
            fileInput.value = '';
            uploadZone.classList.remove('hidden');
            imagePreview.classList.add('hidden');
            previewImg.src = '/placeholder.svg';
        }

        function openEditModal(id, title, content, img) {
            modal.classList.remove('hidden');
            formAction = '/admin/activityEdit/' + id;
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('content').value = content;
            // ตั้งค่ารูปภาพเดิม
            fileInput.value = '';
            setExistingImage(img);
        }

        function closeModal() {
            modal.classList.add('hidden');
            document.getElementById('activityForm').reset();

            // รีเซ็ตการแสดงรูปภาพ
            fileInput.value = '';
            uploadZone.classList.remove('hidden');
            imagePreview.classList.add('hidden');
            previewImg.src = '/placeholder.svg';
        }

        function deleteActivity(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                cancelButtonText: "ยกเลิก",
                confirmButtonText: "ยืนยัน"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/deleteActivity/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                    });
                }
            });
        }
            const allActivity = <%- JSON.stringify(activity) %>;
            const searchInput = document.getElementById("searchInput");
            const itemsPerPageSelect = document.getElementById("itemsPerPage");
            const cardsContainer = document.getElementById("cardsContainer");
            const pagination = document.getElementById("pagination");
            const noResults = document.getElementById("noResults");
            const totalItems = document.getElementById("totalItems");

            let currentPage = 1;
            let itemsPerPage = parseInt(itemsPerPageSelect.value);
            let filteredData = [...allActivity];

            // Template card
            function createCard(act) {
                return `
                    <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform hover:scale-105 relative">
                        <img src="${act.img}" alt="Item" class="w-full h-[150px] object-cover rounded">
                        <h2 class="text-lg font-medium mt-2 h-[100px] overflow-hidden">${act.title}</h2>
                        <p class="text-gray-400 text-xs mt-1">วันที่เพิ่ม ${formatDate(act.createdAt)}</p>
                        <div class="flex flex-auto items-center justify-end">
                            <button class="edit-btn" onclick="openEditModal('${act._id}', '${act.title}', '${act.content}', '${act.img}')">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button onclick="deleteActivity('${act._id}', '${act.title}')" class="delete-btn">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }

            // ฟอร์แมทวันที่
            function formatDate(dateStr) {
                const d = new Date(dateStr);
                return d.toLocaleDateString("th-TH", { year: "numeric", month: "short", day: "numeric" });
            }

            // แสดงผล
            function displayData() {
                const start = (currentPage - 1) * itemsPerPage;
                const end = start + itemsPerPage;
                const dataToShow = filteredData.slice(start, end);

                totalItems.textContent = `${filteredData.length} รายการ`;

                if (dataToShow.length === 0) {
                    noResults.classList.remove("hidden");
                    cardsContainer.innerHTML = "";
                    pagination.innerHTML = "";
                    return;
                }

                noResults.classList.add("hidden");
                cardsContainer.innerHTML = dataToShow.map(createCard).join("");
                renderPagination();
            }

            // Pagination
            function renderPagination() {
                const totalPages = Math.ceil(filteredData.length / itemsPerPage);
                if (totalPages <= 1) {
                    pagination.innerHTML = "";
                    return;
                }
                let html = "";
                for (let i = 1; i <= totalPages; i++) {
                    html += `<button onclick="goToPage(${i})" 
                                class="px-3 py-1 border rounded ${i === currentPage ? 'bg-green-600 text-white' : 'bg-white text-gray-700'}">
                                ${i}
                            </button>`;
                }
                pagination.innerHTML = html;
            }

            function goToPage(page) {
                currentPage = page;
                displayData();
                window.scrollTo({ top: 0, behavior: "smooth" });
            }

            // Search
            searchInput.addEventListener("input", () => {
                const term = searchInput.value.toLowerCase();
                filteredData = allActivity.filter(act =>
                    act.title.toLowerCase().includes(term) || 
                    (act.content && act.content.toLowerCase().includes(term))
                );
                currentPage = 1;
                displayData();
            });

            // Change items per page
            itemsPerPageSelect.addEventListener("change", () => {
                itemsPerPage = parseInt(itemsPerPageSelect.value);
                currentPage = 1;
                displayData();
            });

            // Init
            displayData();
        </script>
</body>
</html>
