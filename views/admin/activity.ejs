<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/activity.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <!-- สำหรับแก้ไขกิจกรรม -->
    <div class="screen" id="modal">
        <form class="add-media-form" action="/admin/activityPost" method="POST" id="activityForm" enctype="multipart/form-data">
            <div class="media-form-head">
                <h1>แก้ไขกิจกรรม</h1>
            </div>
            <div class="media-form-content">
                <div class="mt-3">ชื่อหัวข้อ</div>
                <input type="text" name="title" id="title" placeholder="ใส่ชื่อหัวข้อ ..." required>
                <div>เนื้อหา</div>
                <textarea name="content" id="content" placeholder="ใส่เนื้อหา ..." required></textarea>
                <div>รูปภาพกิจกรรม</div>
                <div class="img-input">
                    <label class="block">
                        <span class="sr-only">Choose profile photo</span>
                        <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" class="block w-full text-sm text-slate-500
                            file:mr-4 file:py-2 file:px-4
                            file:rounded-full file:border-0
                            file:text-sm file:font-semibold
                            file:bg-violet-50 file:text-violet-700
                            hover:file:bg-violet-100
                        "/>
                    </label>
                </div>
            </div>
            <div class="media-form-action">
                <button type="submit" class="submit">โพส</button>
                <span class="cancel" onclick="closeModal()">ปิด</span>
            </div>
        </form>
    </div>

    <!-- Main content -->
    <div class="content">
        <div class="content-header">
            <h1>กิจกรรม (<%= activity.length %>)</h1>

            <div class="add-media" onclick="openModal()">เพิ่มกิจกรรม</div>
        </div>
        <div class="search-container">
            <!-- ช่องค้นหากิจกรรม -->
            <form action="/admin/activity" method="GET" class="search-form">
                <input type="text" name="search" value="<%= searchQuery %>" placeholder="ค้นหากิจกรรม..." class="search-input">
                <button type="submit" class="search-button">ค้นหา</button>
            </form>
        </div>
        
        <div class="card-container">
            <% if (activity.length > 0) { %>
                <% activity.forEach((act, index) => { %>
                    <div class="card">
                        <img src="<%= act.img %>" alt="รูปภาพกิจกรรม">
                        <div class="card-content">
                            <p class="card-title"><%= act.title %></p>
                            <p class="date">วันที่ <%= act.formattedDate %></p>
                            <div class="flex justify-end">
                                <button class="edit-btn" onclick="openEditModal('<%= act._id %>', '<%= act.title %>', '<%= act.content %>', '<%= act.img %>')">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button onclick="deleteActivity('<%= act._id %>', '<%= act.title %>')" class="delete-btn">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>There are no activities to display...</p>
            <% } %>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = "/admin/activityPost";

        function openModal() {
            modal.style.display = 'block';
            formAction =  "/admin/activityPost"
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('title').value = '';
            document.getElementById('content').value = '';
            document.getElementById('img').value = '';
        }

        function openEditModal(id, title, content, img) {
            modal.style.display = 'block';
            formAction = '/admin/activityEdit/' + id;
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('content').value = content;
            document.getElementById('img').value = img;
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        function deleteActivity(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/deleteActivity/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>

</body>
</html>
