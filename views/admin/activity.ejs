<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
    <title><%= mytitle %></title>
    <link rel="stylesheet" href="/style_admin/activity.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <%- include('../partials/adminPartials/adminHeader.ejs') %>

    <%- include('../partials/adminPartials/adminSidebar.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // เช็คข้อความที่ส่งมาจาก URL
        const urlParams = new URLSearchParams(window.location.search);
        const successMessage = urlParams.get('message');
        const errorMessage = urlParams.get('error');

        if (successMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

        if (errorMessage) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMessage,
                showConfirmButton: false,
                timer: 3000
            });
        }

    </script>

    <div class="content bg-gray-50 min-screen">
        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">กิจกรรม</h1>
                <p class="text-gray-600">กิจกรรมของกองทุนขยะรีไซเคิล</p>
            </div>
            
            <div>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition duration-300" onclick="openModal()">เพิ่มกิจกรรม</button>
            </div>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <form action="" method="GET">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <div class="relative">
                            <input type="text" name="search" value="<%= searchQuery %>" placeholder="ค้นหากิจกรรม" 
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
                            <div class="absolute left-3 top-2.5 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                            <i class="fas fa-search mr-2"></i>ค้นหา
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="mx-4 mb-6 bg-white rounded-lg shadow p-4">
            <div class="mb-4 border-b border-gray-200 border-b border-gray-200 pb-4">
                <h2 class="text-base font-semibold text-gray-800 mb-4 md:mb-0">
                    สื่อความรู้ทั้งหมด <span class="text-blue-600 text-base font-normal"> <%= totalItems %> รายการ</span>
                </h2>
            </div>

            <!-- ส่วนแสดงชื่อและวิดีโอ -->
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
                <% if (activity.length > 0) { %>
                    <% activity.forEach((act, index) => { %>
                            <% if (index < 10) { %>
                            <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform hover:scale-105 relative">
                                <img src="<%= act.img %>" alt="Item" class="w-full h-[150px] object-cover rounded">
                                <h2 class="text-lg font-medium mt-2 h-[100px] overflow-hidden"><%= act.title %></h2>
                                <p class="text-gray-400 text-xs mt-1">วันที่ <%= act.formattedDate %></p>
                                <div class="flex flex-auto items-center justify-end">
                                    <button class="edit-btn" onclick="openEditModal('<%= act._id %>', '<%= act.title %>', '<%= act.content %>', '<%= act.img %>')">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button onclick="deleteActivity('<%= act._id %>', '<%= act.title %>')" class="delete-btn">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full">
                        <div class="text-center py-16 bg-white rounded-xl shadow-sm">
                            <div class="mx-auto w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                                <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                            <h3 class="text-lg font-medium text-gray-900 mb-2">ยังไม่มีสื่อความรู้</h3>
                            <p class="text-gray-500 mb-6">เริ่มต้นสร้างสื่อความรู้แรกของคุณ</p>
                            <button type="button" 
                                class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors duration-200"
                                onclick="openModal()">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                เพิ่มสื่อความรู้
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="pagination flex justify-center items-center mt-4 space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                    ก่อนหน้า
                </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md 
                        <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                    <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                    ถัดไป
                </a>
            <% } %>
        </div>
    </div>

    <!-- สำหรับแก้ไขกิจกรรม -->
    <div class="screen z-[10] h-full" id="modal">
        <form class="mx-auto mt-[13em] w-1/2 bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform relative " action="/admin/activityPost" method="POST" id="activityForm" enctype="multipart/form-data">
                <h1 class="text-bold text-gray-600 text-2xl">แก้ไขกิจกรรม</h1>
                <hr class="my-2">
                <div class="text-bold text-gray-500 text-lg">ชื่อหัวข้อ</div>
                <input type="text" name="title" id="title" class="w-full p-2 border border-gray-200 rounded-lg" placeholder="ใส่ชื่อหัวข้อ ..." required>
                <div class="text-bold text-gray-500 text-lg">เนื้อหา</div>
                <textarea class="w-full p-2 border border-gray-200 rounded-lg h-48" name="content" id="content" placeholder="ใส่เนื้อหา ..." required></textarea>
                <div class="text-bold text-gray-500 text-lg">รูปภาพกิจกรรม</div>
                <div class="img-input">
                    <label class="block w-full p-2 border border-gray-200 rounded-lg">
                        <span class="sr-only">Choose profile photo</span>
                        <input type="file" name="img" id="img" accept="image/png, image/gif, image/jpeg" class="block w-full text-sm text-slate-500
                            file:mr-4 file:py-2 file:px-4
                            file:rounded-full file:border-0
                            file:text-sm file:font-semibold
                            file:bg-violet-50 file:text-violet-700
                            hover:file:bg-violet-100
                        "/>
                    </label>
                </div>
                <hr class="my-5">
            <div class="mt-2 flex justify-end">
                <span class="cancel px-2 py-1 text-white rounded mr-2" onclick="closeModal()">ปิด</span>
                <button type="submit" class="submit px-2 py-1 text-white rounded">โพสต์</button>
            </div>
        </form>
    </div>

    <!-- Main content -->
    <div class="content">
        <div class="flex items-center justfy-between">
            <h1 class="w-full">กิจกรรม (<%= totalItems %> รายการ)</h1>
            <div class="search-container flex items-center">
                <!-- ช่องค้นหากิจกรรม -->
                <form action="/admin/activity" method="GET" class="search-form">
                    <input type="text" name="search" value="<%= searchQuery %>" placeholder="ค้นหากิจกรรม" class="search-input">
                    <button type="submit" class="main-bg-color search-button">ค้นหา</button>
                </form>
                <button class="main-bg-color px-3 py-2 ml-2 text-white rounded" onclick="openModal()">เพิ่มกิจกรรม</button>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 mt-6">
            <% if (activity.length > 0) { %>
                <% activity.forEach((act, index) => { %>
                    <% if (index < 10) { %> <div class="bg-gray-100 border border-gray-300 p-4 rounded-lg shadow-md transition-transform transform hover:scale-105 relative">
                            <img src="<%= act.img %>" alt="Item" class="w-full h-[150px] object-cover rounded">
                            <h2 class="text-lg font-medium mt-2 h-[100px] overflow-hidden"><%= act.title %></h2>
                            <p class="text-gray-400 text-xs mt-1">วันที่ <%= act.formattedDate %></p>
                            <div class="flex flex-auto items-center justify-end">
                                <button class="edit-btn" onclick="openEditModal('<%= act._id %>', '<%= act.title %>', '<%= act.content %>', '<%= act.img %>')">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button onclick="deleteActivity('<%= act._id %>', '<%= act.title %>')" class="delete-btn">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            <% } else { %>
                <p>- ไม่พบข้อมูลประเภทขยะ -</p>
            <% } %>
        </div>
        <!-- Pagination -->
        <div class="pagination w-full flex justify-center items-center mt-4 space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                    ก่อนหน้า
                </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md 
                        <%= currentPage === i ? 'page-current text-white' : 'text-gray-700 hover:bg-gray-100' %>">
                    <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>"
                    class="px-3 py-1 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-100">
                    ถัดไป
                </a>
            <% } %>
        </div>
    </div>

    <%- include('../partials/adminPartials/adminFooter.ejs') %>

    <script>
        const modal = document.getElementById('modal');
        let formAction = "/admin/activityPost";

        function openModal() {
            modal.style.display = 'block';
            formAction =  "/admin/activityPost"
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('title').value = '';
            document.getElementById('content').value = '';
            document.getElementById('img').value = '';
        }

        function openEditModal(id, title, content, img) {
            modal.style.display = 'block';
            formAction = '/admin/activityEdit/' + id;
            document.getElementById('activityForm').setAttribute('action', formAction);
            document.getElementById('title').value = title;
            document.getElementById('content').value = content;
            document.getElementById('img').value = img;
        }

        function closeModal() {
            modal.style.display = 'none';
        }

        function deleteActivity(id, title) {
            Swal.fire({
                title: `ลบ "${title}" หรือไม่?`,
                text: "หากคุณลบแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/admin/deleteActivity/' + id, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    })
                        .then(result => {
                            if (result.isConfirmed) {
                                Swal.fire('ลบข้อมูลไม่สำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'error')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('ลบข้อมูลสำเร็จ', 'ข้อมูลกิจกรรมถูกลบเรียบร้อยแล้ว', 'success')
                                .then(() => {
                                        location.reload();
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire('เกิดข้อผิดพลาด', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้', 'error');
                        });
                }
            });
        }
    </script>

</body>
</html>
