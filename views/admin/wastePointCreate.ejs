<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/adminPartials/doctype.ejs') %>
        <title>
            <%= mytitle %>
        </title>
        <link rel="stylesheet" href="/style_admin/funeral-assistance.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
        <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
        <!-- Leaflet -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

        <!-- Leaflet Control Geocoder -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
        <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

        <style>
            .leaflet-container {
                height: 400px;
                border-radius: 0.5rem;
            }
            
            @media (min-width: 768px) {
                .leaflet-container {
                    height: 500px;
                }
            }
        </style>
</head>

<body class="bg-gray-50">
    <%- include('../partials/adminPartials/adminHeader.ejs') %>
        <%- include('../partials/adminPartials/adminSidebar.ejs') %>

            <script>
                // แสดง popup message จาก query string
                const urlParams = new URLSearchParams(window.location.search);
                const successMessage = urlParams.get('message');
                const errorMessage = urlParams.get('error');

                if (successMessage) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ!',
                        text: successMessage,
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });
                }

                if (errorMessage) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: errorMessage,
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            </script>

            <div class="content bg-gray-50 min-screen">
                <!-- Page Header -->
                <div class="mx-4 mb-3 bg-white rounded-lg shadow p-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center">
                                เพิ่มจุดรับซื้อขยะ
                            </h1>
                            <p class="text-gray-600 mt-2">ระบบจัดการจุดรับซื้อขยะสำหรับครัวเรือนในชุมชน</p>
                        </div>
                        <a href="/admin/wastePoint" class="bg-red-700 text-white px-4 py-2 rounded-md hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition duration-200 flex items-center">
                            <i class="fa-solid fa-arrow-left mr-2"></i>ย้อนกลับ
                        </a>
                    </div>
                </div>

                <!-- Map Section -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6 mx-4">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">เลือกตำแหน่งจุดรับซื้อขยะ</h2>
                    
                    <!-- Search and Current Location -->
                    <div class="flex gap-2 mb-4">
                        <div class="flex-1">
                            <input 
                                type="text" 
                                id="searchInput" 
                                placeholder="ค้นหาสถานที่... (เช่น ตลาดสด, โรงเรียน, วัด)" 
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                            />
                        </div>
                        <button 
                            id="searchBtn" 
                            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold transition">
                            <i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา
                        </button>
                        <button 
                            id="currentLocationBtn" 
                            class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg font-semibold transition">
                            <i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน
                        </button>
                    </div>

                    <!-- Map -->
                    <div id="map" class="rounded-lg border-2 border-gray-200 mb-4"></div>

                    <!-- Coordinates Display -->
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-sm font-semibold text-gray-600">ละติจูด (Latitude)</label>
                                <p id="latDisplay" class="text-lg font-mono text-gray-800">-</p>
                            </div>
                            <div>
                                <label class="text-sm font-semibold text-gray-600">ลองจิจูด (Longitude)</label>
                                <p id="lngDisplay" class="text-lg font-mono text-gray-800">-</p>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="text-sm font-semibold text-gray-600">ชื่อสถานที่</label>
                            <p id="locationName" class="text-lg text-gray-800">กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่ง</p>
                        </div>
                    </div>
                </div>

        <!-- Form Section -->
        <form id="wasteForm" action="/admin/wastePointPost" method="POST" class="bg-white rounded-lg shadow-md p-6 mx-4">
            <h2 class="text-xl font-bold text-gray-800 mb-6">ข้อมูลจุดรับซื้อขยะ</h2>

            <!-- ผู้เพิ่มข้อมูล -->
            <input type="hidden" id="addBy" name="addBy" value="<%= username %>">
            <input type="hidden" id="location" name="location">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- ชื่อจุดรับซื้อ -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        ชื่อจุดรับซื้อขยะ <span class="text-red-500">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="wastePointName" 
                        name="wastePointName"
                        required
                        placeholder="เช่น จุดรับซื้อขยะชุมชนบ้านใหม่"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    />
                </div>

                <!-- หมู่บ้าน -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        หมู่บ้าน <span class="text-red-500">*</span>
                    </label>
                    <select id="village" name="village" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <option value="">เลือกหมู่บ้าน</option>
                        <% villages.forEach(village => { %>
                            <option value="<%= village._id %>"><%= village.villageName %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- ประเภทจุดรับซื้อ -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        ประเภทจุดรับซื้อ <span class="text-red-500">*</span>
                    </label>
                    <select id="type" name="type" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <option value="">เลือกประเภท</option>
                        <option value="bank">ธนาคารขยะ</option>
                        <option value="center">ศูนย์รับซื้อขยะรีไซเคิล</option>
                        <option value="community">จุดรับซื้อชุมชน</option>
                        <option value="mobile">รถรับซื้อเคลื่อนที่</option>
                    </select>
                </div>

                <!-- สถานะเปิด-ปิด -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        สถานะการเปิดบริการ
                    </label>
                    <select id="isOpen" name="isOpen"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        <option value="true">เปิดบริการ</option>
                        <option value="false">ปิดชั่วคราว</option>
                    </select>
                </div>

                <!-- หมายเหตุ -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        หมายเหตุ / รายละเอียดเพิ่มเติม
                    </label>
                    <textarea 
                        id="note" 
                        name="note"
                        rows="3"
                        placeholder="ข้อมูลเพิ่มเติม..."
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    ></textarea>
                </div>
            </div>

            <!-- Hidden fields for coordinates -->
            <input type="hidden" id="latitude" name="latitude" />
            <input type="hidden" id="longitude" name="longitude" />

            <!-- Submit Button -->
            <div class="mt-8 flex gap-4">
                <button 
                    type="submit" 
                    class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition shadow-md">
                    บันทึกข้อมูล
                </button>
                <button 
                    type="reset" 
                    class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-3 px-6 rounded-lg transition">
                    ล้างข้อมูล
                </button>
            </div>
        </form>

            </div>

</body>
    <script>
        // ขอบเขตของตำบลขามป้อม
        const KHAMPO_POLYGON_COORDS = [
            { lat: 15.9917406, lng: 102.9022698 },
            { lat: 15.9847685, lng: 102.9053383 },
            { lat: 15.9805724, lng: 102.905049 },
            { lat: 15.9736823, lng: 102.9033324 },
            { lat: 15.9674935, lng: 102.9031393 },
            { lat: 15.9622328, lng: 102.9013798 },
            { lat: 15.9578798, lng: 102.8959725 },
            { lat: 15.9531553, lng: 102.897217 },
            { lat: 15.9505557, lng: 102.8983757 },
            { lat: 15.9452121, lng: 102.8965089 },
            { lat: 15.9417871, lng: 102.8927109 },
            { lat: 15.9387954, lng: 102.8906724 },
            { lat: 15.9372067, lng: 102.890651 },
            { lat: 15.9362163, lng: 102.891874 },
            { lat: 15.934318, lng: 102.8916165 },
            { lat: 15.9333483, lng: 102.8911874 },
            { lat: 15.9316151, lng: 102.8925607 },
            { lat: 15.9268487, lng: 102.8976032 },
            { lat: 15.9231964, lng: 102.8980538 },
            { lat: 15.9195854, lng: 102.8975174 },
            { lat: 15.9167997, lng: 102.9001138 },
            { lat: 15.9117028, lng: 102.9021308 },
            { lat: 15.9087312, lng: 102.9032895 },
            { lat: 15.9058009, lng: 102.9032895 },
            { lat: 15.902788, lng: 102.9043195 },
            { lat: 15.9017149, lng: 102.9014012 },
            { lat: 15.8994036, lng: 102.8953073 },
            { lat: 15.8968034, lng: 102.8912732 },
            { lat: 15.8967621, lng: 102.8874967 },
            { lat: 15.8978352, lng: 102.8839776 },
            { lat: 15.9017562, lng: 102.8802869 },
            { lat: 15.9028293, lng: 102.8745792 },
            { lat: 15.9033659, lng: 102.8739354 },
            { lat: 15.9024166, lng: 102.8714892 },
            { lat: 15.8993211, lng: 102.8696439 },
            { lat: 15.89961, lng: 102.8648803 },
            { lat: 15.9010133, lng: 102.862477 },
            { lat: 15.9043564, lng: 102.862992 },
            { lat: 15.9225968, lng: 102.8317473 },
            { lat: 15.9290346, lng: 102.8333781 },
            { lat: 15.938691, lng: 102.8343222 },
            { lat: 15.953381, lng: 102.8323481 },
            { lat: 15.9575806, lng: 102.8497956 },
            { lat: 15.9756524, lng: 102.8656742 },
            { lat: 15.9906697, lng: 102.8862736 },
            { lat: 15.9917406, lng: 102.9022698 }
        ];

        // Ray casting algorithm ตรวจสอบจุดอยู่ใน polygon หรือไม่
        function isPointInPolygon(lat, lng, polygon) {
            let inside = false;
            const x = lng, y = lat;
            for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
                const xi = polygon[i].lng, yi = polygon[i].lat;
                const xj = polygon[j].lng, yj = polygon[j].lat;
                const intersect = ((yi > y) !== (yj > y)) &&
                    (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
                if (intersect) inside = !inside;
            }
            return inside;
        }

        // คำนวณ center ของ polygon สำหรับ default view
        const centerLat = KHAMPO_POLYGON_COORDS.reduce((sum, c) => sum + c.lat, 0) / KHAMPO_POLYGON_COORDS.length;
        const centerLng = KHAMPO_POLYGON_COORDS.reduce((sum, c) => sum + c.lng, 0) / KHAMPO_POLYGON_COORDS.length;

        const map = L.map('map').setView([centerLat, centerLng], 13);

        L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
            attribution: '© Google',
            maxZoom: 20  // เปลี่ยนจาก 15 → 20
        }).addTo(map);

        // วาด polygon ขอบเขตตำบลขามป้อม
        const polygonLatLngs = KHAMPO_POLYGON_COORDS.map(c => [c.lat, c.lng]);
        const khampoPolygon = L.polygon(polygonLatLngs, {
            color: '#2563EB',
            weight: 2.5,
            opacity: 0.85,
            fillColor: '#3B82F6',
            fillOpacity: 0.08,
            dashArray: '6, 4'
        }).addTo(map);

        khampoPolygon.bindTooltip('ขอบเขตตำบลขามป้อม', {
            permanent: false,
            direction: 'center',
            className: 'polygon-label-tooltip'
        });

        // Fit map ให้พอดีกับ polygon
        map.fitBounds(khampoPolygon.getBounds().pad(0.05));

        let marker = null;
        let selectedLat = null;
        let selectedLng = null;

        // แสดง badge แจ้งเตือนตำแหน่งนอก/ใน polygon
        function showLocationBadge(inBounds) {
            // ลบ badge เก่า
            const old = document.getElementById('location-badge');
            if (old) old.remove();

            const coordsBox = document.querySelector('.bg-gray-50.rounded-lg.p-4');
            const badge = document.createElement('div');
            badge.id = 'location-badge';
            badge.className = `mt-3 flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium ${
                inBounds 
                    ? 'bg-green-50 text-green-700 border border-green-200' 
                    : 'bg-orange-50 text-orange-700 border border-orange-200'
            }`;
            badge.innerHTML = inBounds
                ? `<i class="fas fa-check-circle"></i> ตำแหน่งอยู่ในขอบเขตตำบลขามป้อม`
                : `<i class="fas fa-exclamation-triangle"></i> ⚠️ ตำแหน่งอยู่<strong class="mx-1">นอกขอบเขต</strong>ตำบลขามป้อม — กรุณาตรวจสอบ`;
            coordsBox.appendChild(badge);
        }

        // Function to update marker and get location name
        function updateMarker(lat, lng) {
            selectedLat = lat;
            selectedLng = lng;

            if (marker) {
                map.removeLayer(marker);
            }

            // ตรวจสอบว่าอยู่ในขอบเขตหรือไม่
            const inBounds = isPointInPolygon(lat, lng, KHAMPO_POLYGON_COORDS);

            // สร้าง marker icon ตามสถานะ
            const markerIcon = L.divIcon({
                html: `
                    <div style="background-color: ${inBounds ? '#16A34A' : '#EA580C'};" 
                        class="w-10 h-10 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                        <i class="fas fa-map-marker-alt text-white text-sm"></i>
                    </div>
                `,
                className: 'custom-marker',
                iconSize: [40, 40],
                iconAnchor: [20, 40]
            });

            marker = L.marker([lat, lng], { icon: markerIcon }).addTo(map);

            // Update display
            document.getElementById('latDisplay').textContent = lat.toFixed(6);
            document.getElementById('lngDisplay').textContent = lng.toFixed(6);
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;

            // แสดง badge สถานะ
            showLocationBadge(inBounds);

            // Reverse geocoding
            document.getElementById('locationName').textContent = '🔄 กำลังค้นหาชื่อสถานที่...';
            document.getElementById('searchInput').value = '🔄 กำลังค้นหาชื่อสถานที่...';

            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=th`)
                .then(response => response.json())
                .then(data => {
                    const locationName = data.display_name || 'ไม่พบชื่อสถานที่';
                    document.getElementById('locationName').textContent = locationName;
                    document.getElementById('location').value = locationName;
                    document.getElementById('searchInput').value = locationName;

                    const popupColor = inBounds ? '#16A34A' : '#EA580C';
                    const popupStatus = inBounds
                        ? `<span style="color:#16A34A;font-size:11px;"><i class="fas fa-check-circle"></i> ในขอบเขตตำบล</span>`
                        : `<span style="color:#EA580C;font-size:11px;"><i class="fas fa-exclamation-triangle"></i> นอกขอบเขตตำบล</span>`;

                    marker.bindPopup(`
                        <div style="min-width:200px;">
                            <b style="color:${popupColor};">${locationName}</b><br>
                            <small>Lat: ${lat.toFixed(6)} | Lng: ${lng.toFixed(6)}</small><br>
                            ${popupStatus}
                        </div>
                    `).openPopup();
                })
                .catch(() => {
                    document.getElementById('locationName').textContent = 'ไม่สามารถค้นหาชื่อสถานที่ได้';
                });
        }

        // Click on map
        map.on('click', function(e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;
            const inBounds = isPointInPolygon(lat, lng, KHAMPO_POLYGON_COORDS);

            if (!inBounds) {
                Swal.fire({
                        icon: 'error',
                        title: 'จุดอยู่นอกพื้นที่',
                        text: 'สามารถปักหมุดได้เฉพาะในเขตตำบลขามป้อมเท่านั้น',
                        confirmButtonText: 'ตกลง',
                        confirmButtonColor: '#EF4444'
                    });
                return; // ไม่ปักหมุด ไม่ทำอะไรต่อ
            }

            updateMarker(lat, lng);
        });

        // Current location button
        document.getElementById('currentLocationBtn').addEventListener('click', function() {
            if (navigator.geolocation) {
                this.innerHTML = '<i class="fa-solid fa-hourglass-start mr-1"></i> กำลังค้นหา...';
                this.disabled = true;

                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        map.setView([lat, lng], 16);
                        updateMarker(lat, lng);
                        this.innerHTML = '<i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน';
                        this.disabled = false;
                    },
                    (error) => {
                        Swal.fire({
                            title: 'ไม่สามารถเข้าถึงตำแหน่งได้',
                            text: error.message,
                            icon: 'error',
                            confirmButtonColor: '#16A34A',
                            confirmButtonText: 'ตกลง'
                        });
                        this.innerHTML = '<i class="fa-solid fa-map-pin mr-1"></i> ตำแหน่งปัจจุบัน';
                        this.disabled = false;
                    }
                );
            } else {
                Swal.fire({
                    title: 'เบราว์เซอร์ไม่รองรับการระบุตำแหน่ง',
                    icon: 'warning',
                    confirmButtonColor: '#16A34A',
                    confirmButtonText: 'ตกลง'
                });
            }
        });

        // Search location
        document.getElementById('searchBtn').addEventListener('click', function() {
            const query = document.getElementById('searchInput').value.trim();
            if (!query) {
                Swal.fire({
                    title: 'กรุณาพิมพ์ชื่อสถานที่ที่ต้องการค้นหา',
                    icon: 'warning',
                    confirmButtonColor: '#16A34A',
                    confirmButtonText: 'ตกลง'
                });
                return;
            }

            this.innerHTML = '<i class="fa-solid fa-hourglass-start mr-1"></i> กำลังค้นหา...';
            this.disabled = true;

            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1&accept-language=th`)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lng = parseFloat(data[0].lon);
                        map.setView([lat, lng], 16);
                        updateMarker(lat, lng);
                    } else {
                        Swal.fire({
                            title: 'ไม่พบสถานที่ที่ค้นหา',
                            text: 'กรุณาลองใหม่อีกครั้ง',
                            icon: 'warning',
                            confirmButtonColor: '#16A34A',
                            confirmButtonText: 'ตกลง'
                        });
                    }
                    this.innerHTML = '<i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา';
                    this.disabled = false;
                })
                .catch(() => {
                    Swal.fire({
                        title: 'เกิดข้อผิดพลาดในการค้นหา',
                        icon: 'error',
                        confirmButtonColor: '#16A34A',
                        confirmButtonText: 'ตกลง'
                    });
                    this.innerHTML = '<i class="fa-solid fa-magnifying-glass mr-1"></i> ค้นหา';
                    this.disabled = false;
                });
        });

        // Enter key to search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('searchBtn').click();
            }
        });

        // ===== FORM SUBMIT VALIDATION =====
        document.getElementById('wasteForm').addEventListener('submit', function(e) {
            // ตรวจสอบว่าปักหมุดหรือยัง
            if (!selectedLat || !selectedLng) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาปักหมุดตำแหน่งบนแผนที่',
                    html: `
                        <div class="text-gray-600 text-sm">
                            <p class="mb-3">ระบุตำแหน่งจุดรับซื้อขยะบนแผนที่ก่อนบันทึก</p>
                            <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 text-left text-gray-800">
                                <p class="font-semibold mb-1"> วิธีปักหมุด</p>
                                <ul class="text-xs space-y-1">
                                    <li>• <strong>คลิกบนแผนที่</strong> เพื่อเลือกตำแหน่ง</li>
                                    <li>• ใช้ <strong>"ค้นหา"</strong> เพื่อค้นหาสถานที่</li>
                                    <li>• กด <strong>"ตำแหน่งปัจจุบัน"</strong> เพื่อใช้พิกัดของคุณ</li>
                                </ul>
                            </div>
                        </div>
                    `,
                    confirmButtonText: 'ไปปักหมุด',
                    confirmButtonColor: '#16A34A',
                    showCancelButton: true,
                    cancelButtonText: 'ปิด',
                    cancelButtonColor: '#6B7280',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Scroll ขึ้นไปที่แผนที่
                        document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Pulse effect บน map
                        document.getElementById('map').style.boxShadow = '0 0 0 4px rgba(22,163,74,0.4)';
                        setTimeout(() => {
                            document.getElementById('map').style.boxShadow = '';
                        }, 2000);
                    }
                });
                return;
            }

            // แจ้งเตือนถ้าอยู่นอกขอบเขต (แต่ยังให้บันทึกได้)
            const inBounds = isPointInPolygon(selectedLat, selectedLng, KHAMPO_POLYGON_COORDS);
            if (!inBounds) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'ตำแหน่งอยู่นอกขอบเขตตำบล!',
                    html: `
                        <div class="text-sm text-gray-600">
                            <p>ตำแหน่งที่เลือกอยู่<strong class="text-orange-600">นอกขอบเขตตำบลขามป้อม</strong></p>
                            <p class="mt-2">คุณต้องการบันทึกข้อมูลนี้ต่อไปหรือไม่?</p>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: '<i class="fas fa-save mr-2"></i>บันทึกต่อไป',
                    cancelButtonText: '<i class="fas fa-map-marker-alt mr-2"></i>เปลี่ยนตำแหน่ง',
                    confirmButtonColor: '#EA580C',
                    cancelButtonColor: '#16A34A',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Submit จริง
                        document.getElementById('wasteForm').submit();
                    } else {
                        // Scroll กลับไปที่แผนที่
                        document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
                return;
            }

            // ถ้าผ่านทุก validation → submit ปกติ
        });

        // Reset form
        document.querySelector('button[type="reset"]').addEventListener('click', function() {
            if (marker) {
                map.removeLayer(marker);
                marker = null;
            }
            selectedLat = null;
            selectedLng = null;
            document.getElementById('latDisplay').textContent = '-';
            document.getElementById('lngDisplay').textContent = '-';
            document.getElementById('locationName').textContent = 'กรุณาคลิกบนแผนที่เพื่อเลือกตำแหน่ง';
            document.getElementById('searchInput').value = '';
            const badge = document.getElementById('location-badge');
            if (badge) badge.remove();
        });
    </script>
</html>